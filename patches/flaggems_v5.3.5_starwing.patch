+#define K5H_ISSUE(kx, st)                                                                    \
+  do {                                                                                       \
+    unsigned char* sa_ = k5_smem + (st) * STAGE;                                             \
+    unsigned char* sb_ = sa_ + BM * 64;                                                      \
+    _Pragma("unroll") for (int j = 0; j < 2; ++j)                                            \
+      K5_BSM128(sa_ + (wave + 8 * j) * 1024, A + aoff[j] + (kx) * 32);                       \
+    _Pragma("unroll") for (int j = 0; j < NJB; ++j) {                                        \
+      if (wave + 8 * j < NQB) K5_BSM128(sb_ + (wave + 8 * j) * 1024, W + boff[j] + (kx) * 32); \
+    }                                                                                        \
+  } while (0)
+
+  K5H_ISSUE(0, 0);
+  for (int kt = 0; kt < KT; ++kt) {
+    const int st = kt & 1;
+    K5_WAIT_GVM(0);
+    K5_BARRIER();
+    if (kt + 1 < KT) K5H_ISSUE(kt + 1, st ^ 1);
+    const unsigned char* sa_ = k5_smem + st * STAGE;
+    const unsigned char* sb_ = sa_ + BM * 64;
+    k5_v4u fa[4][2], fb[NTW];
+#pragma unroll
+    for (int sa = 0; sa < 4; ++sa)
+#pragma unroll
+      for (int i = 0; i < 2; ++i)
+        fa[sa][i] = *(const k5_v4u*)(sa_ + (64 * sa + 32 * wm + 16 * i) * 64 + lo);
+#pragma unroll
+    for (int sb = 0; sb < NTW; ++sb) fb[sb] = *(const k5_v4u*)(sb_ + (64 * sb + 16 * wn) * 64 + lo);
+#pragma unroll
+    for (int sa = 0; sa < 4; ++sa)
+#pragma unroll
+      for (int i = 0; i < 2; ++i)
+#pragma unroll
+        for (int sb = 0; sb < NTW; ++sb) {
+          K5_MMA(acc[sa][i][sb], fb[sb].xy, fa[sa][i].xy);
+          K5_MMA(acc[sa][i][sb], fb[sb].zw, fa[sa][i].zw);
+        }
+  }
+#undef K5H_ISSUE
+  k5_epilogue<NTW, EPI>(acc, C, M, ldc, m0, n0, n_end, tid, wm, wn);
+}
+#endif  // K5_BUILD_H
+
+// ---------------------------------------------------------------------------
+// probes (layout facts the kernels rely on)
+// ---------------------------------------------------------------------------
+__global__ void k5_probe_mma_kernel(const uint32_t* x, const uint32_t* y, float* out) {
+  const int lane = threadIdx.x & 63;
+  k5_v2u a, b;
+  a.x = x[2 * lane];
+  a.y = x[2 * lane + 1];
+  b.x = y[2 * lane];
+  b.y = y[2 * lane + 1];
+  k5_v4f c = {0.f, 0.f, 0.f, 0.f};
+  K5_MMA_RAW(c, a, b);
+  out[4 * lane + 0] = c.x;
+  out[4 * lane + 1] = c.y;
+  out[4 * lane + 2] = c.z;
+  out[4 * lane + 3] = c.w;
+}
+
+__global__ void k5_probe_bsm_kernel(const k5_v4i* src, k5_v4i* out) {
+  const int lane = threadIdx.x & 63;
+  const int wave = K5_UNIFORM((int)(threadIdx.x >> 6));
+  K5_BSM128(k5_smem + wave * 1024, src + threadIdx.x);
+  K5_WAIT_GVM(0);
+  K5_BARRIER();
+  // read back in a different lane order so a lane cannot see its own write
+  const int j = (threadIdx.x + 64) % blockDim.x;
+  out[threadIdx.x] = ((const k5_v4i*)k5_smem)[j];
+  (void)lane;
+}
+
+// ---------------------------------------------------------------------------
+// host side (C ABI for ctypes)
+// ---------------------------------------------------------------------------
+#define K5_VARIANT(design, ntw, epi) ((design) * 100 + (ntw) * 10 + (epi))
+
+static int k5_attrs_of(const void* kernel, int* out) {
+#if defined(K5_NO_ATTRS)
+  (void)kernel;
+  for (int i = 0; i < 5; ++i) out[i] = -1;
+  return 0;
+#else
+  mcFuncAttributes a;
+  mcError_t e = mcFuncGetAttributes(&a, kernel);
+  out[0] = a.numRegs;
+  out[1] = (int)a.localSizeBytes;
+  out[2] = (int)a.sharedSizeBytes;
+  out[3] = a.maxThreadsPerBlock;
+  out[4] = a.maxDynamicSharedSizeBytes;
+  return (int)e;
+#endif
+}
+
+// one case per compiled variant: argument checks, attribute query or launch
+// (direct triple-chevron launch of the template instance; the dynamic shared
+// memory limit is raised to 64 KiB once, its error state cleared)
+#define K5_CASE(design, KER, ntw, epi, BKv)                                                    \
+  case K5_VARIANT(design, ntw, epi): {                                                         \
+    if (attrs) return k5_attrs_of((const void*)KER<ntw, epi>, attrs);                          \
+    if (K % (BKv)) return -2;                                                                  \
+    static bool smem_attr_set = false;                                                         \
+    if (!smem_attr_set) {                                                                      \
+      (void)mcFuncSetAttribute((const void*)KER<ntw, epi>,                                     \
+                               mcFuncAttributeMaxDynamicSharedMemorySize, 65536);              \
+      (void)mcGetLastError();                                                                  \
+      smem_attr_set = true;                                                                    \
+    }                                                                                          \
+    const int grid = ((M + 255) / 256) * ((n_end - col0 + 64 * (ntw) - 1) / (64 * (ntw)));   \
+    K5_LAUNCH(grid, 512, 65536, (mcStream_t)stream, KER<ntw, epi>)(                            \
+        (const k5_bf16*)A, (const k5_bf16*)W, (k5_bf16*)C, M, K, lda, ldw, ldc, col0, n_end,   \
+        group_m);                                                                              \
+    return (int)mcGetLastError();                                                              \
+  }
+
+static const int k5_variant_list[] = {
+#if defined(K5_BUILD_T)
+    K5_VARIANT(1, 4, 0), K5_VARIANT(1, 4, 1), K5_VARIANT(1, 3, 0), K5_VARIANT(1, 3, 1),
+    K5_VARIANT(1, 2, 0), K5_VARIANT(1, 2, 1),
+#endif
+#if defined(K5_BUILD_H)
+    K5_VARIANT(2, 4, 0), K5_VARIANT(2, 4, 1), K5_VARIANT(2, 3, 1), K5_VARIANT(2, 2, 1),
+#endif
+    -1};
+
+static int k5_dispatch(int variant, const void* A, const void* W, void* C, int M, int K, int lda,
+                       int ldw, int ldc, int col0, int n_end, int group_m, void* stream,
+                       int* attrs) {
+  if (M <= 0 || K <= 0 || n_end <= col0) return -3;
+  switch (variant) {
+#if defined(K5_BUILD_T)
+    K5_CASE(1, k5t_kernel, 4, 0, 64)
+    K5_CASE(1, k5t_kernel, 4, 1, 64)
+    K5_CASE(1, k5t_kernel, 3, 0, 64)
+    K5_CASE(1, k5t_kernel, 3, 1, 64)
+    K5_CASE(1, k5t_kernel, 2, 0, 64)
+    K5_CASE(1, k5t_kernel, 2, 1, 64)
+#endif
+#if defined(K5_BUILD_H)
+    K5_CASE(2, k5h_kernel, 4, 0, 32)
+    K5_CASE(2, k5h_kernel, 4, 1, 32)
+    K5_CASE(2, k5h_kernel, 3, 1, 32)
+    K5_CASE(2, k5h_kernel, 2, 1, 32)
+#endif
+    default:
+      return -1;
+  }
+}
+
+extern "C" {
+
+// C[:, col0:n_end] of C[M, ldc] = A[M, K] (row stride lda) @ W[n_end, K]^T
+// (W row stride ldw).  Returns 0 or an mcError_t / negative argument code.
+int k5_gemm(int variant, const void* A, const void* W, void* C, int M, int K, int lda, int ldw,
+            int ldc, int col0, int n_end, int group_m, void* stream) {
+  return k5_dispatch(variant, A, W, C, M, K, lda, ldw, ldc, col0, n_end, group_m, stream,
+                     nullptr);
+}
+
+// out[5] = numRegs, localSizeBytes (spill), sharedSizeBytes, maxThreadsPerBlock,
+// maxDynamicSharedSizeBytes of the variant's kernel
+int k5_attrs(int variant, int* out) {
+  return k5_dispatch(variant, nullptr, nullptr, nullptr, 256, 64, 64, 64, 64, 0, 64, 8, nullptr,
+                     out);
+}
+
+// compiled variant ids, -1 terminated; returns the count
+int k5_variants(int* out, int cap) {
+  int n = 0;
+  for (; k5_variant_list[n] >= 0 && n < cap; ++n) out[n] = k5_variant_list[n];
+  if (n < cap) out[n] = -1;
+  return n;
+}
+
+int k5_plain(void) { return K5_PLAIN; }
+
+int k5_mma_swap(void) { return K5_MMA_SWAP; }
+
+// x, y: 64 lanes x 2 u32 (4 bf16) each; out: 64 lanes x 4 fp32
+int k5_probe_mma(const void* x, const void* y, void* out, void* stream) {
+  K5_LAUNCH(1, 64, 0, (mcStream_t)stream, k5_probe_mma_kernel)((const uint32_t*)x, (const uint32_t*)y,
+                                                                (float*)out);
+  return (int)mcGetLastError();
+}
+
+// src, out: 128 x 16 bytes; 2 waves copy through shared memory with the async copy
+int k5_probe_bsm(const void* src, void* out, void* stream) {
+  K5_LAUNCH(1, 128, 2048, (mcStream_t)stream, k5_probe_bsm_kernel)((const k5_v4i*)src, (k5_v4i*)out);
+  return (int)mcGetLastError();
+}
+
+}  // extern "C"
