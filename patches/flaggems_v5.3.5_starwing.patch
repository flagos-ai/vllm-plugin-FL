+def _mm_tune_m_bucket(m):
+    """Bucket the GEMM M dimension for the libtuner config-cache key.
+
+    vLLM runs chunked-prefill (mixed) steps above the largest cudagraph
+    capture size eagerly with the exact scheduled token count as M, so an
+    exact-M key starts a full autotune sweep for almost every new step size.
+    M only changes the number of row tiles, so a config tuned for the upper
+    end of a bucket is reused for the whole bucket.
+
+    Buckets: powers of two up to 16, then four buckets per octave rounded up
