+def _mm_tune_m_bucket(m):
+    """Bucket the GEMM M dimension for the libtuner config-cache key.
+
+    Under FULL_DECODE_ONLY every mixed (chunked-prefill) step runs eagerly
+    with the exact scheduled token count as M (1..max_num_batched_tokens), so
+    an exact-M key starts a new autotune sweep for almost every new step
+    size.  M only changes the number of row tiles, so a config tuned for the
+    upper end of a bucket is reused for the whole bucket.
+
+    Buckets: powers of two up to 16, then four buckets per octave rounded up
+    (16, 20, 24, 28, 32, 40, ..., 1792, 2048, 2560, ...).  Each bucket value
+    maps to itself, so tuning at the bucket value fills the cache row that
+    the whole bucket uses (decode M=64 and full-budget M=2048 keep their
+    exact-M configs).
+
+    Only the config-cache key and the perf-model pruning see the bucket.  The
+    launch grid uses the exact M, A rows are loaded with ``rm % M`` and C is
+    always stored with the ``rm < M`` mask, so any config is correct for any
+    M.  The autotune space keeps split_k == 1 (tune_configs.yaml), so the
+    atomic_add path is not reachable.
+    """
+    m = int(m)
+    if m <= 16:
+        return m if m <= 1 else 1 << (m - 1).bit_length()
+    step = 1 << ((m - 1).bit_length() - 3)
+    return -(-m // step) * step
+
+
+def _estimate_matmul_time_m_bucket(*args, **kwargs):
+    # Rank candidates for the bucket, not for the first M that reached it, so
+    # every M of a bucket benchmarks the same top_k configs.
+    if "M" in kwargs:
+        kwargs["M"] = _mm_tune_m_bucket(kwargs["M"])
+    return estimate_matmul_time(*args, **kwargs)
+
