+# --------------------------------------------------------------------------- #
+# Large-M NT GEMMs on MetaX C500: pinned launch configs per (N, K, M bucket)
+# --------------------------------------------------------------------------- #
+# Large-M NT GEMMs are the chunked-prefill (mixed) steps that run outside CUDA
+# graphs.  On the autotuned path they are tuned inside served requests and the
+# shipped candidate list tops out at 128x128 tiles: for MiniCPM5-2B at M=2048
+# the four projections took 1.93 ms per layer autotuned, 1.49 ms with 256x256 /
+# 128x128x64 tiles and the mxcc flags below.  For known (N, K) weight shapes a
+# fixed launch config per M bucket is used instead: the unmodified mm_kernel_nt
+# body or mm_kernel_nt_subdot, with MACA compiler options.  The table at the
+# end of this section is chosen per bucket from timings of every candidate at
+# the top, the bottom and ragged M of the bucket.
+
+
+@triton.jit
+def _subdot_index(off, SIZE: tl.constexpr, LIMIT, EVEN: tl.constexpr):
+    # Row (or column) indices of one sub-tile.  Out-of-range indices wrap with
+    # ``% LIMIT`` so the K loop needs no row/column mask (as in mm_kernel_nt);
+    # the epilogue masks the store.
+    r = off + tl.arange(0, SIZE)
+    if EVEN:
+        idx = tl.max_contiguous(tl.multiple_of(r, SIZE), SIZE)
+    else:
+        idx = tl.max_contiguous(tl.multiple_of(r % LIMIT, SIZE), SIZE)
+    return idx
+
+
+@triton.jit
+def _subdot_a_ptrs(A, off_m, rk, M, K, SIZE: tl.constexpr, EVEN_M: tl.constexpr):
+    ram = _subdot_index(off_m, SIZE, M, EVEN_M)
+    return A + ram[:, None] * K + rk[None, :]
+
+
+@triton.jit
+def _subdot_b_ptrs(B, off_n, rk, N, K, SIZE: tl.constexpr, EVEN_N: tl.constexpr):
+    # B is W.T with stride (1, K): element (k, n) is W[n, k] = B + n * K + k.
+    rbn = _subdot_index(off_n, SIZE, N, EVEN_N)
+    return B + rk[:, None] + rbn[None, :] * K
+
+
+@triton.jit
+def _subdot_load_a(ptrs, rk, k_remaining, EVEN_K: tl.constexpr):
+    if EVEN_K:
+        x = tl.load(ptrs)
+    else:
+        x = tl.load(ptrs, mask=rk[None, :] < k_remaining, other=0.0)
+    return x
+
+
+@triton.jit
+def _subdot_load_b(ptrs, rk, k_remaining, EVEN_K: tl.constexpr):
+    if EVEN_K:
+        x = tl.load(ptrs)
+    else:
+        x = tl.load(ptrs, mask=rk[:, None] < k_remaining, other=0.0)
+    return x
+
+
+@triton.jit
+def _subdot_store(
+    C,
+    acc,
+    off_m,
+    off_n,
+    M,
+    N,
+    SUB_M: tl.constexpr,
+    SUB_N: tl.constexpr,
+    EVEN_M: tl.constexpr,
+    EVEN_N: tl.constexpr,
+):
+    rm = off_m + tl.arange(0, SUB_M)
+    rn = off_n + tl.arange(0, SUB_N)
+    c_ptrs = C + rm[:, None] * N + rn[None, :]
+    result = acc.to(C.dtype.element_ty)
+    if EVEN_M and EVEN_N:
+        tl.store(c_ptrs, result)
+    else:
+        tl.store(c_ptrs, result, mask=(rm < M)[:, None] & (rn < N)[None, :])
+
+
+# NT GEMM (A [M, K] row-major, B = W.T with stride (1, K), C [M, N] row-major)
+# whose BLOCK_M x BLOCK_N output tile is computed as NSUB (1-3) same-shape
+# sub-dots that share one operand per k-step:
+#   SPLIT_N=True:  SUB_M = BLOCK_M, BLOCK_N = NSUB * SUB_N; the A tile is loaded
+#                  once and multiplied with NSUB column slabs of B.
+#   SPLIT_N=False: BLOCK_M = NSUB * SUB_M, SUB_N = BLOCK_N; the B tile is loaded
+#                  once and multiplied with NSUB row slabs of A.
+# All sub-dots have the same shape, so the shared operand's dot-operand
+# fragment stays in registers across them, and NSUB=3 gives the
+# non-power-of-two tiles (256x192, 384x128) that fill the 104 APs of the C500
+# better than 256x256 / 128x128 at the N=2048 projections.  Same GROUP_M
+# swizzle, wrap-around loads and masked epilogue as mm_kernel_nt.
+@triton.heuristics(runtime.get_heuristic_config("mm"))
+@triton.heuristics(
+    {
+        "EVEN_M": lambda args: args["M"] % args["BLOCK_M"] == 0,
+        "EVEN_N": lambda args: args["N"] % args["BLOCK_N"] == 0,
+    }
+)
+@triton.jit
+def mm_kernel_nt_subdot(
+    A,
+    B,
+    C,
+    M,
+    N,
+    K,
+    BLOCK_M: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    SUB_M: tl.constexpr,
+    SUB_N: tl.constexpr,
+    NSUB: tl.constexpr,
+    SPLIT_N: tl.constexpr,
+    GROUP_M: tl.constexpr,
+    EVEN_M: tl.constexpr,
+    EVEN_N: tl.constexpr,
+    EVEN_K: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    grid_m = tl.cdiv(M, BLOCK_M)
+    grid_n = tl.cdiv(N, BLOCK_N)
+
+    width = GROUP_M * grid_n
+    group_id = pid // width
+    group_size = min(grid_m - group_id * GROUP_M, GROUP_M)
+    pid_m = group_id * GROUP_M + pid % group_size
+    pid_n = pid % width // group_size
+    off_m = pid_m * BLOCK_M
+    off_n = pid_n * BLOCK_N
+
+    rk = tl.arange(0, BLOCK_K)
+    # s_ptrs: the shared operand; p*_ptrs: the NSUB split slabs.
+    if SPLIT_N:
+        s_ptrs = _subdot_a_ptrs(A, off_m, rk, M, K, SUB_M, EVEN_M)
+        p0_ptrs = _subdot_b_ptrs(B, off_n, rk, N, K, SUB_N, EVEN_N)
+        if NSUB > 1:
+            p1_ptrs = _subdot_b_ptrs(B, off_n + SUB_N, rk, N, K, SUB_N, EVEN_N)
+        if NSUB > 2:
+            p2_ptrs = _subdot_b_ptrs(B, off_n + 2 * SUB_N, rk, N, K, SUB_N, EVEN_N)
+    else:
+        s_ptrs = _subdot_b_ptrs(B, off_n, rk, N, K, SUB_N, EVEN_N)
+        p0_ptrs = _subdot_a_ptrs(A, off_m, rk, M, K, SUB_M, EVEN_M)
+        if NSUB > 1:
+            p1_ptrs = _subdot_a_ptrs(A, off_m + SUB_M, rk, M, K, SUB_M, EVEN_M)
+        if NSUB > 2:
+            p2_ptrs = _subdot_a_ptrs(A, off_m + 2 * SUB_M, rk, M, K, SUB_M, EVEN_M)
+
+    acc0 = tl.zeros((SUB_M, SUB_N), dtype=tl.float32)
+    if NSUB > 1:
+        acc1 = tl.zeros((SUB_M, SUB_N), dtype=tl.float32)
+    if NSUB > 2:
+        acc2 = tl.zeros((SUB_M, SUB_N), dtype=tl.float32)
+
+    for k in range(0, tl.cdiv(K, BLOCK_K)):
+        k_remaining = K - k * BLOCK_K
+        if SPLIT_N:
+            s = _subdot_load_a(s_ptrs, rk, k_remaining, EVEN_K)
+            p0 = _subdot_load_b(p0_ptrs, rk, k_remaining, EVEN_K)
+            acc0 = tl.dot(s, p0, acc0, out_dtype=tl.float32)
+            if NSUB > 1:
+                p1 = _subdot_load_b(p1_ptrs, rk, k_remaining, EVEN_K)
+                acc1 = tl.dot(s, p1, acc1, out_dtype=tl.float32)
+            if NSUB > 2:
+                p2 = _subdot_load_b(p2_ptrs, rk, k_remaining, EVEN_K)
+                acc2 = tl.dot(s, p2, acc2, out_dtype=tl.float32)
+        else:
+            s = _subdot_load_b(s_ptrs, rk, k_remaining, EVEN_K)
+            p0 = _subdot_load_a(p0_ptrs, rk, k_remaining, EVEN_K)
+            acc0 = tl.dot(p0, s, acc0, out_dtype=tl.float32)
+            if NSUB > 1:
+                p1 = _subdot_load_a(p1_ptrs, rk, k_remaining, EVEN_K)
+                acc1 = tl.dot(p1, s, acc1, out_dtype=tl.float32)
+            if NSUB > 2:
+                p2 = _subdot_load_a(p2_ptrs, rk, k_remaining, EVEN_K)
+                acc2 = tl.dot(p2, s, acc2, out_dtype=tl.float32)
+        # both operands are contiguous along K
+        s_ptrs += BLOCK_K
+        p0_ptrs += BLOCK_K
+        if NSUB > 1:
+            p1_ptrs += BLOCK_K
+        if NSUB > 2:
+            p2_ptrs += BLOCK_K
+
+    if SPLIT_N:
+        _subdot_store(C, acc0, off_m, off_n, M, N, SUB_M, SUB_N, EVEN_M, EVEN_N)
+        if NSUB > 1:
+            _subdot_store(
+                C, acc1, off_m, off_n + SUB_N, M, N, SUB_M, SUB_N, EVEN_M, EVEN_N
+            )
+        if NSUB > 2:
+            _subdot_store(
+                C, acc2, off_m, off_n + 2 * SUB_N, M, N, SUB_M, SUB_N, EVEN_M, EVEN_N
+            )
+    else:
+        _subdot_store(C, acc0, off_m, off_n, M, N, SUB_M, SUB_N, EVEN_M, EVEN_N)
+        if NSUB > 1:
+            _subdot_store(
+                C, acc1, off_m + SUB_M, off_n, M, N, SUB_M, SUB_N, EVEN_M, EVEN_N
+            )
+        if NSUB > 2:
+            _subdot_store(
+                C, acc2, off_m + 2 * SUB_M, off_n, M, N, SUB_M, SUB_N, EVEN_M, EVEN_N
+            )
+
+
+# mxcc flag strings passed as the MACAOptions ``extra_options`` launch kwarg,
+# which replaces the backend's default -mllvm string for that compile
+# (triton/backends/metax/compiler.py).  For pipeline="basic" the default is
+# regpressure=false, vectorize-slp, sched-mma-maxnum=3, mma-unroll-count=stages.
+#   regp:    that default with register-pressure-aware scheduling turned on.
+#   cpsched: the scheduler flags the backend uses for its cp.async pipeline
+#            (register-pressure-aware scheduling, no load sinking, post-RA
+#            scheduling) applied to the register-buffered basic pipeline.
+# Both get -metaxgpu-mma-unroll-count=<num_stages> appended, as the default does.
+_MXCC_FLAGS = {
+    "default": None,
+    "regp": (
+        " -mllvm -metaxgpu-sched-regpressure=true -mllvm -metaxgpu-vectorize-slp=true "
+        "-mllvm -metaxgpu-sched-mma-maxnum=3 "
+    ),
+    "cpsched": (
+        " -mllvm -metaxgpu-sched-regpressure=true -mllvm -metaxgpu-sinkload=false "
+        "-mllvm -metaxgpu-vectorize-slp=true -mllvm -metaxgpu-igroup "
+        "-mllvm -metaxgpu-aggressive-4g-addr-opt=true "
+        "-mllvm -metaxgpu-shl-add-combine=false "
+        "-mllvm -misched-postra=true -mllvm -enable-post-misched=true "
+    ),
+}
