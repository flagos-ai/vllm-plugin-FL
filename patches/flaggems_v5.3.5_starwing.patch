@@ -0,0 +1,543 @@
+# Copyright 2026 FlagOS Contributors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# Fused temperature + top-p + random sampling, without sorting, without a
+# top-p mask and without materialising fp32 logits or probabilities.
+#
+# The native sampler path (vLLM forward_native with top_p_mask_) is
+#
+#     x = logits.float() / T                      to_copy, div_
+#     x[outside the nucleus] = -inf               top-p mask
+#     probs = softmax(x)                          softmax
+#     q ~ Exp(1) iid;  token = argmax(probs / q)  exponential_, div_, argmax
+#
+# and streams the [B, V] fp32 logits ~15 times.  Since softmax normalisation
+# does not move an argmax, the token is the argmax over the nucleus of the
+# score  s_i = x_i - ln(q_i).  The nucleus rule is the one of top_p_mask_
+# (the sort/cumsum reference restated per element):
+#
+#     keep i  <=>  sum_{j: x_j > x_i} exp(x_j - max) < p * sum_j exp(x_j - max)
+#
+# Here the token is sampled first and nucleus membership is checked after:
+#
+#   1. _scan_kernel  (B x SPLIT, one read): per-chunk max / sum exp, greedy
+#      argmax, and per lane the best and second-best score (Philox noise is
+#      generated in registers, never stored).  Each program reports its KL
+#      best lane winners and a bound U on every other score of its chunk.
+#   2. _merge_kernel (B): row max and sum, the row's KR best candidates and
+#      U_row = max(all chunk bounds, best dropped candidate).  Candidates that
+#      score above U_row are "certified": they are exactly the row's best
+#      scores, in order (ties broken towards the smaller column, like argmax).
+#   3. _mass_kernel  (B x SPLIT, one read): for each certified candidate c the
+#      mass sum_{x_j > x_c} exp(x_j - max).
+#   4. _final_kernel (B): the first certified candidate inside the nucleus is
+#      the answer (every higher score belongs to a token outside it).  If no
+#      certified candidate is inside (probability <= (1 - p)^depth, depth is
+#      typically KR = 8, i.e. ~4e-11 at p = 0.95), the row's program runs the
+#      exact top_p_mask_ search over its row and takes the argmax of the score
+#      over the nucleus, regenerating the same noise.  Rows with T < eps return
+#      the greedy argmax of the raw logits, like Sampler.sample.
+#
+# The output is the same function of (logits, T, p, q) as the reference; only
+# the source of q differs: counter-based Philox seeded from the default
+# generator (as exponential_ does), so the result is equal in distribution.
+# The noise for column j of row r comes from the 64-bit counter offset +
+# (r * n_tiles + j // TILE) * LANES + j % LANES, word (j % TILE) // LANES.
+#
+# Only for/where/sum/max/min/philox are used (no sort, scan, atomics or
+# intra-kernel global-memory round trips), as in top_p_mask_.
+
+import torch
+import triton
+import triton.language as tl
+
+from flag_gems.runtime import torch_device_fn
+from flag_gems.utils.random_utils import (
+    philox_backend_seed_offset,
+    uint_to_uniform_float,
+)
+
+_LANES = 256  # lanes per program; one Philox call yields 4 words per lane
+_TILE = 4 * _LANES  # columns per Philox call
+_KL = 4  # candidates reported per chunk
+_KR = 8  # candidates kept per row (certified prefix taken from these)
+_NC = 16  # thresholds per pass of the exact fallback search
+_NPASS = 9  # ceil(32 / log2(16)) + 1 passes resolve any 32-bit key interval
+_NUM_WARPS = 4
+_SAMPLING_EPS = 1e-5  # vllm.v1.sample.sampler._SAMPLING_EPS
+_INT_MAX = tl.constexpr(2147483647)
+_NEG_INF_KEY = tl.constexpr(-2139095041)  # _key(-inf)
+
+
+@triton.jit
+def _key(x):
+    # Monotone map fp32 -> int32: integer order equals float order.
+    bits = x.to(tl.int32, bitcast=True)
+    return tl.where(bits >= 0, bits, bits ^ 0x7FFFFFFF)
+
+
+@triton.jit
+def _philox_offset(offset_lo, offset_hi):
+    # The 64-bit Philox offset from its two 32-bit halves (int32 views; see
+    # _offset_halves): passed as one Python int, the offset would be typed i64
+    # instead of i32 once it passes 2^31 and recompile the kernels mid-serving.
+    lo = offset_lo.to(tl.int64) & 0xFFFFFFFF
+    return (offset_hi.to(tl.int64) << 32) | lo
+
+
+@triton.jit
+def _philox_counter(c0_base, c1_base, ctr):
+    # The 64-bit Philox counter (c0, c1) = offset + ctr: the low word carries
+    # into the high word (offset + ctr crosses 2^32 every ~2K steps at batch 64).
+    c0 = c0_base + ctr.to(tl.uint32)
+    c1 = c1_base + (c0 < c0_base).to(tl.uint32)  # unsigned compare: carry out
+    return c0, c1
+
+
+@triton.jit
+def _exp_noise(r):
+    # Exp(1) sample from a Philox word, as FlagGems' fp32 exponential_, except
+    # that the words 0 and 0xFFFFFFFF (u == 0) give u = 2^-32 instead of
+    # q = +inf: the smallest non-zero u is 2^-31, so no other word changes.  An
+    # infinite q would give its token the score -inf and could leave a
+    # one-token nucleus without any finite score.
+    u = tl.maximum(uint_to_uniform_float(r), 2.3283064365386963e-10)
+    log_u = tl.where(
+        u >= 0.9999999403953552,
+        -5.960464477539063e-08,
+        tl.math.log2(u) * 0.6931471805599453,
+    )
+    return -log_u
+
+
+@triton.jit
+def _row_temp(temp_ptr, row, HAS_TEMP: tl.constexpr):
+    if HAS_TEMP:
+        t = tl.load(temp_ptr + row).to(tl.float32)
+        greedy = t < 1e-5
+        t = tl.where(greedy, 1.0, t)
+    else:
+        t = tl.full([], 1.0, tl.float32)
+        greedy = t < 0.0
+    return t, greedy
+
+
+@triton.jit
+def _scan_block(row_ptr, q_row_ptr, col, vocab, t, r, gx, gi, w, w2, wi, wx,
+                NOISE_FROM_PTR: tl.constexpr):
+    valid = col < vocab
+    raw = tl.load(row_ptr + col, mask=valid, other=float("-inf")).to(tl.float32)
+    x = raw / t
+    take = raw > gx  # strict: first occurrence of the max within the lane
+    gx = tl.where(take, raw, gx)
+    gi = tl.where(take, col, gi)
+    if NOISE_FROM_PTR:
+        q = tl.load(q_row_ptr + col, mask=valid, other=1.0)
+    else:
+        q = _exp_noise(r)
+    s = x - tl.log(q)
+    better = s > w
+    w2 = tl.where(better, w, tl.maximum(w2, s))
+    wi = tl.where(better, col, wi)
+    wx = tl.where(better, x, wx)
+    w = tl.where(better, s, w)
+    return x, gx, gi, w, w2, wi, wx
+
+
+@triton.jit(do_not_specialize=["tiles_per_prog", "philox_seed", "offset_lo", "offset_hi"])
+def _scan_kernel(logits_ptr, stride_row, temp_ptr, q_ptr, vocab, n_tiles, tiles_per_prog,
+                 philox_seed, offset_lo, offset_hi, fstat_ptr, istat_ptr, cs_ptr, ci_ptr, cx_ptr,
+                 HAS_TEMP: tl.constexpr, NOISE_FROM_PTR: tl.constexpr,
+                 LANES: tl.constexpr, KL: tl.constexpr):
+    row = tl.program_id(0)
+    sid = tl.program_id(1)
+    nsplit = tl.num_programs(1)
+    row_ptr = logits_ptr + row.to(tl.int64) * stride_row
+    q_row_ptr = q_ptr + row.to(tl.int64) * vocab
+    t, greedy = _row_temp(temp_ptr, row, HAS_TEMP)
+    seed = philox_seed.to(tl.int64)
+    offset = _philox_offset(offset_lo, offset_hi)
+    c0_base = (offset & 0xFFFFFFFF).to(tl.uint32)
+    c1 = ((offset >> 32) & 0xFFFFFFFF).to(tl.uint32)
+
+    lanes = tl.arange(0, LANES)
+    m = tl.full([LANES], float("-inf"), tl.float32)
+    s = tl.zeros([LANES], tl.float32)
+    gx = tl.full([LANES], float("-inf"), tl.float32)
+    gi = tl.full([LANES], _INT_MAX, tl.int32)
+    w = tl.full([LANES], float("-inf"), tl.float32)
+    w2 = tl.full([LANES], float("-inf"), tl.float32)
+    wi = tl.full([LANES], -1, tl.int32)
+    wx = tl.full([LANES], float("-inf"), tl.float32)
+
+    t_begin = sid * tiles_per_prog
+    t_end = tl.minimum(t_begin + tiles_per_prog, n_tiles)
+    for tile in range(t_begin, t_end):
+        ctr = (row * n_tiles + tile) * LANES + lanes
+        c0, c1r = _philox_counter(c0_base, c1, ctr)
+        zero = c0 * 0
+        r0, r1, r2, r3 = tl.philox(seed, c0, c1r, zero, zero)
+        col = tile * (4 * LANES) + lanes
+        x0, gx, gi, w, w2, wi, wx = _scan_block(row_ptr, q_row_ptr, col, vocab, t, r0,
+                                                gx, gi, w, w2, wi, wx, NOISE_FROM_PTR)
+        x1, gx, gi, w, w2, wi, wx = _scan_block(row_ptr, q_row_ptr, col + LANES, vocab, t, r1,
+                                                gx, gi, w, w2, wi, wx, NOISE_FROM_PTR)
+        x2, gx, gi, w, w2, wi, wx = _scan_block(row_ptr, q_row_ptr, col + 2 * LANES, vocab, t, r2,
+                                                gx, gi, w, w2, wi, wx, NOISE_FROM_PTR)
+        x3, gx, gi, w, w2, wi, wx = _scan_block(row_ptr, q_row_ptr, col + 3 * LANES, vocab, t, r3,
+                                                gx, gi, w, w2, wi, wx, NOISE_FROM_PTR)
+        # Online softmax statistics, one rescale per tile.
+        m_new = tl.maximum(m, tl.maximum(tl.maximum(x0, x1), tl.maximum(x2, x3)))
+        m_ref = tl.where(m_new == float("-inf"), 0.0, m_new)
+        s = (s * tl.exp(m - m_ref) + tl.exp(x0 - m_ref) + tl.exp(x1 - m_ref)
+             + tl.exp(x2 - m_ref) + tl.exp(x3 - m_ref))
+        m = m_new
+
+    chunk_max = tl.max(m, axis=0)
+    max_ref = tl.where(chunk_max == float("-inf"), 0.0, chunk_max)
+    chunk_sum = tl.sum(s * tl.exp(m - max_ref), axis=0)
+    g_max = tl.max(gx, axis=0)
+    g_idx = tl.min(tl.where(gx == g_max, gi, _INT_MAX), axis=0)
+
+    # The KL best lane winners, best first; ties go to the smaller column.
+    out = (row * nsplit + sid) * KL
+    picked = lanes < 0
+    rest = w
+    for k in tl.static_range(KL):
+        best = tl.max(rest, axis=0)
+        best_col = tl.min(tl.where(rest == best, wi, _INT_MAX), axis=0)
+        hit = (rest == best) & (wi == best_col)
+        best_x = tl.max(tl.where(hit, wx, float("-inf")), axis=0)
+        tl.store(cs_ptr + out + k, best)
+        tl.store(ci_ptr + out + k, tl.where(best > float("-inf"), best_col, -1))
+        tl.store(cx_ptr + out + k, best_x)
+        picked = picked | hit
+        rest = tl.where(hit, float("-inf"), rest)
+    # Every other score of the chunk is <= its lane's best (lanes not picked)
+    # or <= its lane's second best (picked lanes).
+    bound = tl.max(tl.where(picked, w2, rest), axis=0)
+
+    st = (row * nsplit + sid) * 4
+    tl.store(fstat_ptr + st, chunk_max)
+    tl.store(fstat_ptr + st + 1, chunk_sum)
+    tl.store(fstat_ptr + st + 2, g_max)
+    tl.store(fstat_ptr + st + 3, bound)
+    tl.store(istat_ptr + row * nsplit + sid, g_idx)
+
+
+@triton.jit(do_not_specialize=["nsplit"])
+def _merge_kernel(fstat_ptr, istat_ptr, cs_ptr, ci_ptr, cx_ptr, p_ptr, rowf_ptr, rowi_ptr,
+                  rcs_ptr, rcx_ptr, rci_ptr, nsplit,
+                  HAS_P: tl.constexpr, SPLIT_P2: tl.constexpr, KL: tl.constexpr,
+                  KR: tl.constexpr):
+    row = tl.program_id(0)
+    sp = tl.arange(0, SPLIT_P2)
+    smask = sp < nsplit
+    st = (row * nsplit + sp) * 4
+    pm = tl.load(fstat_ptr + st, mask=smask, other=float("-inf"))
+    ps = tl.load(fstat_ptr + st + 1, mask=smask, other=0.0)
+    pg = tl.load(fstat_ptr + st + 2, mask=smask, other=float("-inf"))
+    pu = tl.load(fstat_ptr + st + 3, mask=smask, other=float("-inf"))
+    pgi = tl.load(istat_ptr + row * nsplit + sp, mask=smask, other=_INT_MAX)
+    row_max = tl.max(pm, axis=0)
+    max_ref = tl.where(row_max == float("-inf"), 0.0, row_max)
+    row_sum = tl.sum(tl.where(pm > float("-inf"), ps * tl.exp(pm - max_ref), 0.0), axis=0)
+    g_max = tl.max(pg, axis=0)
+    g_idx = tl.min(tl.where(pg == g_max, pgi, _INT_MAX), axis=0)
+
+    cand = tl.arange(0, SPLIT_P2 * KL)
+    cmask = cand < nsplit * KL
+    coff = row * nsplit * KL + cand
+    sc = tl.load(cs_ptr + coff, mask=cmask, other=float("-inf"))
+    cc = tl.load(ci_ptr + coff, mask=cmask, other=_INT_MAX)
+    cx = tl.load(cx_ptr + coff, mask=cmask, other=float("-inf"))
+    kk = tl.arange(0, KR)
+    top_s = tl.full([KR], float("-inf"), tl.float32)
+    top_c = tl.full([KR], -1, tl.int32)
+    top_x = tl.full([KR], float("-inf"), tl.float32)
+    for k in tl.static_range(KR):
+        best = tl.max(sc, axis=0)
+        best_col = tl.min(tl.where(sc == best, cc, _INT_MAX), axis=0)
+        hit = (sc == best) & (cc == best_col)
+        best_x = tl.max(tl.where(hit, cx, float("-inf")), axis=0)
+        top_s = tl.where(kk == k, best, top_s)
+        top_c = tl.where(kk == k, best_col, top_c)
+        top_x = tl.where(kk == k, best_x, top_x)
+        sc = tl.where(hit, float("-inf"), sc)
+    bound = tl.maximum(tl.max(pu, axis=0), tl.max(sc, axis=0))
+    certified = (top_s > bound) & (top_c >= 0)  # a prefix: top_s is non-increasing
+    depth = tl.sum(certified.to(tl.int32), axis=0)
+    if HAS_P:
+        p = tl.load(p_ptr + row).to(tl.float32)
+    else:
+        p = 1.0
+    tl.store(rowf_ptr + row * 4, row_max)
+    tl.store(rowf_ptr + row * 4 + 1, row_sum)
+    tl.store(rowf_ptr + row * 4 + 2, p * row_sum)
+    tl.store(rowf_ptr + row * 4 + 3, bound)
+    tl.store(rowi_ptr + row * 2, g_idx)
+    tl.store(rowi_ptr + row * 2 + 1, depth)
+    tl.store(rcs_ptr + row * KR + kk, top_s)
+    tl.store(rcx_ptr + row * KR + kk, tl.where(certified, top_x, float("inf")))
+    tl.store(rci_ptr + row * KR + kk, top_c)
+
+
+@triton.jit(do_not_specialize=["tiles_per_prog"])
+def _mass_kernel(logits_ptr, stride_row, temp_ptr, vocab, n_tiles, tiles_per_prog,
+                 rowf_ptr, rcx_ptr, part_ptr,
+                 HAS_TEMP: tl.constexpr, LANES: tl.constexpr, KR: tl.constexpr):
+    row = tl.program_id(0)
+    sid = tl.program_id(1)
+    nsplit = tl.num_programs(1)
+    row_ptr = logits_ptr + row.to(tl.int64) * stride_row
+    t, greedy = _row_temp(temp_ptr, row, HAS_TEMP)
+    row_max = tl.load(rowf_ptr + row * 4)
+    max_ref = tl.where(row_max == float("-inf"), 0.0, row_max)
+    kk = tl.arange(0, KR)
+    cx = tl.load(rcx_ptr + row * KR + kk)  # +inf for uncertified slots
+    lanes = tl.arange(0, LANES)
+    acc = tl.zeros([LANES, KR], tl.float32)
+    t_begin = sid * tiles_per_prog
+    t_end = tl.minimum(t_begin + tiles_per_prog, n_tiles)
+    for tile in range(t_begin, t_end):
+        for c in tl.static_range(4):
+            col = tile * (4 * LANES) + c * LANES + lanes
+            raw = tl.load(row_ptr + col, mask=col < vocab, other=float("-inf"))
+            x = raw.to(tl.float32) / t
+            e = tl.exp(x - max_ref)
+            acc += tl.where(x[:, None] > cx[None, :], e[:, None], 0.0)
+    tl.store(part_ptr + (row * nsplit + sid) * KR + kk, tl.sum(acc, axis=0))
+
+
+@triton.jit
+def _exact_row(row_ptr, q_row_ptr, row, vocab, n_tiles, t, row_max, target, p, g_idx,
+               seed, c0_base, c1,
+               NOISE_FROM_PTR: tl.constexpr, LANES: tl.constexpr, NC: tl.constexpr,
+               NPASS: tl.constexpr):
+    # top_p_mask_'s search for the smallest qualifying key, on one row, then the
+    # argmax of the score over the nucleus.  Invariant: key lo does not
+    # qualify, key hi does (nothing lies above the row max).  If no nucleus
+    # token has a score above -inf (injected q = +inf), the row's greedy
+    # argmax g_idx -- always inside the nucleus -- is returned, never INT_MAX.
+    lanes = tl.arange(0, LANES)
+    max_ref = tl.where(row_max == float("-inf"), 0.0, row_max)
+    lo = tl.full([], _NEG_INF_KEY, tl.int64)
+    hi = _key(row_max).to(tl.int64)
+    steps = tl.arange(1, NC + 1).to(tl.int64)
+    for _pass in range(0, NPASS):
+        cand = lo + ((hi - lo) * steps) // NC
+        cand32 = cand.to(tl.int32)
+        acc = tl.zeros([LANES, NC], tl.float32)
+        for tile in range(0, n_tiles):
+            for c in tl.static_range(4):
+                col = tile * (4 * LANES) + c * LANES + lanes
+                raw = tl.load(row_ptr + col, mask=col < vocab, other=float("-inf"))
+                x = raw.to(tl.float32) / t
+                e = tl.exp(x - max_ref)
+                acc += tl.where(_key(x)[:, None] > cand32[None, :], e[:, None], 0.0)
+        ok = tl.sum(acc, axis=0) < target
+        hi = tl.minimum(hi, tl.min(tl.where(ok, cand, hi), axis=0))
+        lo = tl.maximum(lo, tl.max(tl.where(ok, lo, cand), axis=0))
+    cutoff = tl.where(p >= 1.0, _NEG_INF_KEY, hi.to(tl.int32))
+
+    best = tl.full([LANES], float("-inf"), tl.float32)
+    best_col = tl.full([LANES], _INT_MAX, tl.int32)
+    for tile in range(0, n_tiles):
+        ctr = (row * n_tiles + tile) * LANES + lanes
+        c0, c1r = _philox_counter(c0_base, c1, ctr)
+        zero = c0 * 0
+        r0, r1, r2, r3 = tl.philox(seed, c0, c1r, zero, zero)
+        for c in tl.static_range(4):
+            if c == 0:
+                r = r0
+            elif c == 1:
+                r = r1
+            elif c == 2:
+                r = r2
+            else:
+                r = r3
+            col = tile * (4 * LANES) + c * LANES + lanes
+            valid = col < vocab
+            raw = tl.load(row_ptr + col, mask=valid, other=float("-inf"))
+            x = raw.to(tl.float32) / t
+            if NOISE_FROM_PTR:
+                q = tl.load(q_row_ptr + col, mask=valid, other=1.0)
+            else:
+                q = _exp_noise(r)
+            s = x - tl.log(q)
+            s = tl.where(valid & (_key(x) >= cutoff), s, float("-inf"))
+            better = s > best
+            best = tl.where(better, s, best)
+            best_col = tl.where(better, col, best_col)
+    top = tl.max(best, axis=0)
+    pick = tl.min(tl.where(best == top, best_col, _INT_MAX), axis=0)
+    return tl.where(pick == _INT_MAX, g_idx, pick)
+
+
+@triton.jit(do_not_specialize=["philox_seed", "offset_lo", "offset_hi", "nsplit"])
+def _final_kernel(logits_ptr, stride_row, temp_ptr, p_ptr, q_ptr, vocab, n_tiles,
+                  philox_seed, offset_lo, offset_hi, rowf_ptr, rowi_ptr, rci_ptr, part_ptr,
+                  out_ptr, flag_ptr, nsplit,
+                  HAS_TEMP: tl.constexpr, HAS_P: tl.constexpr, NOISE_FROM_PTR: tl.constexpr,
+                  SPLIT_P2: tl.constexpr, LANES: tl.constexpr, KR: tl.constexpr,
+                  NC: tl.constexpr, NPASS: tl.constexpr, FORCE_FALLBACK: tl.constexpr):
+    row = tl.program_id(0)
+    t, greedy = _row_temp(temp_ptr, row, HAS_TEMP)
+    if HAS_P:
+        p = tl.load(p_ptr + row).to(tl.float32)
+    else:
+        p = tl.full([], 1.0, tl.float32)
+    row_max = tl.load(rowf_ptr + row * 4)
+    target = tl.load(rowf_ptr + row * 4 + 2)
+    g_idx = tl.load(rowi_ptr + row * 2)
+    depth = tl.load(rowi_ptr + row * 2 + 1)
+
+    sp = tl.arange(0, SPLIT_P2)
+    kk = tl.arange(0, KR)
+    part = tl.load(part_ptr + (row * nsplit + sp)[:, None] * KR + kk[None, :],
+                   mask=(sp < nsplit)[:, None], other=0.0)
+    mass_above = tl.sum(part, axis=0)
+    limit = tl.where(p >= 1.0, float("inf"), target)  # p >= 1: every token is inside
+    inside = (kk < depth) & (mass_above < limit)
+    first = tl.min(tl.where(inside, kk, KR), axis=0)
+    cols = tl.load(rci_ptr + row * KR + kk)
+    pick = tl.max(tl.where(kk == first, cols, -1), axis=0)
+
+    if FORCE_FALLBACK:  # testing: run the exact path on every sampled row
+        need = (first >= 0) & (greedy == 0)
+    else:
+        need = (first >= KR) & (greedy == 0)
+    result = tl.where(greedy, g_idx, pick)
+    seed = philox_seed.to(tl.int64)
+    offset = _philox_offset(offset_lo, offset_hi)
+    c0_base = (offset & 0xFFFFFFFF).to(tl.uint32)
+    c1 = ((offset >> 32) & 0xFFFFFFFF).to(tl.uint32)
+    row_ptr = logits_ptr + row.to(tl.int64) * stride_row
+    q_row_ptr = q_ptr + row.to(tl.int64) * vocab
+    for _once in range(0, need.to(tl.int32)):  # 0/1-trip loop instead of `if need`
+        result = _exact_row(row_ptr, q_row_ptr, row, vocab, n_tiles, t, row_max, target, p,
+                            g_idx, seed, c0_base, c1, NOISE_FROM_PTR, LANES, NC, NPASS)
+    tl.store(out_ptr + row, result)
+    tl.store(flag_ptr + row, need.to(tl.int32))
+
+
+def _offset_halves(offset):
+    # The low and high 32-bit words of a Philox offset as signed int32 values,
+    # so the kernels always see two i32 arguments whatever the offset (a Python
+    # int argument is typed i32 or i64 by value: one more compile at 2^31).
+    def as_i32(word):
+        word &= 0xFFFFFFFF
+        return word - (1 << 32) if word >= (1 << 31) else word
+
+    return as_i32(offset), as_i32(offset >> 32)
+
+
+def _tiles_per_prog(batch, n_tiles):
+    # ~1K programs per streaming kernel, 4 to 16 tiles each.  Measured on MetaX
+    # C500 (V = 130560, 128 tiles per row, GPU us per call):
+    #   B=1 4 (81), B=8 4 (110), B=16 4 (134), B=32 4 (181), B=48 8 (234),
+    #   B=64 8 (278; 354 with 2 tiles), B=128 16 (460)
+    # i.e. the fastest or within 3% of the fastest tiles-per-program at every B.
+    # The result is a runtime argument (do_not_specialize): no extra compiles.
+    want = triton.cdiv(batch * n_tiles, 1024)
+    return min(16, max(4, triton.next_power_of_2(want)))
+
+
+def top_p_sample(logits, temperature=None, top_p=None, *, out=None, generator=None,
+                 noise=None, force_fallback=False, tiles_per_prog=None,
+                 return_fallback_flags=False):
+    """Sample one token per row from softmax(logits / T) restricted to the top-p nucleus.
+
+    Equivalent in distribution to vLLM's native path (logits.float(), div_ by
+    the temperature, top-p mask, softmax, exponential_ noise, argmax).  Rows
+    whose temperature is below 1e-5 return the argmax of the raw logits.
+
+    Args:
+        logits: [batch, vocab] bf16/fp16/fp32, rows contiguous (stride(1) == 1).
+        temperature: [batch] tensor or None (= 1.0).
+        top_p: [batch] tensor of values in (0, 1], or None (= 1.0, no nucleus cut).
+        out: optional int32 [batch] output.
+        generator: torch.Generator for the Philox state (default generator if None).
+        noise: TESTING ONLY. [batch, vocab] fp32 Exp(1) samples used instead of Philox.
+        force_fallback: TESTING ONLY. Run the exact fallback on every sampled row.
+        tiles_per_prog: override of the chunking heuristic (benchmarks).
+        return_fallback_flags: also return the int32 [batch] per-row fallback flags.
+
+    Returns:
+        int32 [batch] token ids (and the flags if requested).
+    """
+    assert logits.dim() == 2 and logits.stride(1) == 1
+    batch, vocab = logits.shape
+    dev = logits.device
+    if out is None:
+        out = torch.empty(batch, device=dev, dtype=torch.int32)
+    flags = torch.empty(batch, device=dev, dtype=torch.int32)
+    if batch == 0:
+        return (out, flags) if return_fallback_flags else out
+    n_tiles = triton.cdiv(vocab, _TILE)
+    assert batch * n_tiles * _LANES < 2**31
+    tpp = tiles_per_prog or _tiles_per_prog(batch, n_tiles)
+    nsplit = triton.cdiv(n_tiles, tpp)
+    # Sized for the vocabulary, not the batch: one compiled variant per vocab size
+    # whatever the batch (chunk counts are runtime, not specialised).
+    split_p2 = triton.next_power_of_2(n_tiles)
+
+    has_temp = temperature is not None
+    has_p = top_p is not None
+    temp = (temperature.to(device=dev, dtype=torch.float32).contiguous()
+            if has_temp else logits)
+    p = top_p.to(device=dev, dtype=torch.float32).contiguous() if has_p else logits
+    from_ptr = noise is not None
+    if from_ptr:
+        assert noise.shape == logits.shape and noise.dtype == torch.float32
+        noise = noise.contiguous()
+        seed, offset = 0, 0
+    else:
+        seed, offset = philox_backend_seed_offset(batch * n_tiles * _LANES, generator=generator)
+    off_lo, off_hi = _offset_halves(offset)
+    q = noise if from_ptr else logits
+
+    n_chunk = batch * nsplit
+    f32 = torch.empty(n_chunk * (4 + 2 * _KL + _KR) + batch * (4 + 2 * _KR),
+                      device=dev, dtype=torch.float32)
+    i32 = torch.empty(n_chunk * (1 + _KL) + batch * (2 + _KR), device=dev, dtype=torch.int32)
+    fstat, f32 = f32[:n_chunk * 4], f32[n_chunk * 4:]
+    cs, f32 = f32[:n_chunk * _KL], f32[n_chunk * _KL:]
+    cx, f32 = f32[:n_chunk * _KL], f32[n_chunk * _KL:]
+    part, f32 = f32[:n_chunk * _KR], f32[n_chunk * _KR:]
+    rowf, f32 = f32[:batch * 4], f32[batch * 4:]
+    rcs, rcx = f32[:batch * _KR], f32[batch * _KR:]
+    istat, i32 = i32[:n_chunk], i32[n_chunk:]
+    ci, i32 = i32[:n_chunk * _KL], i32[n_chunk * _KL:]
+    rowi, rci = i32[:batch * 2], i32[batch * 2:]
+
+    stride = logits.stride(0)
+    grid = (batch, nsplit)
+    with torch_device_fn.device(dev):
+        _scan_kernel[grid](logits, stride, temp, q, vocab, n_tiles, tpp, seed, off_lo, off_hi,
+                           fstat, istat, cs, ci, cx,
+                           HAS_TEMP=has_temp, NOISE_FROM_PTR=from_ptr, LANES=_LANES,
+                           KL=_KL, num_warps=_NUM_WARPS)
+        _merge_kernel[(batch,)](fstat, istat, cs, ci, cx, p, rowf, rowi, rcs, rcx, rci, nsplit,
+                                HAS_P=has_p, SPLIT_P2=split_p2, KL=_KL, KR=_KR,
+                                num_warps=_NUM_WARPS)
+        _mass_kernel[grid](logits, stride, temp, vocab, n_tiles, tpp, rowf, rcx, part,
+                           HAS_TEMP=has_temp, LANES=_LANES, KR=_KR, num_warps=_NUM_WARPS)
+        _final_kernel[(batch,)](logits, stride, temp, p, q, vocab, n_tiles, seed, off_lo, off_hi,
+                                rowf, rowi, rci, part, out, flags, nsplit,
+                                HAS_TEMP=has_temp, HAS_P=has_p, NOISE_FROM_PTR=from_ptr,
+                                SPLIT_P2=split_p2, LANES=_LANES, KR=_KR, NC=_NC,
+                                NPASS=_NPASS, FORCE_FALLBACK=bool(force_fallback),
+                                num_warps=_NUM_WARPS)
+    return (out, flags) if return_fallback_flags else out
