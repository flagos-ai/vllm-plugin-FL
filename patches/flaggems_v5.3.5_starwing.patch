+# MetaX linear: vocabulary projections (lm_head) with a decode-sized batch use
+# the skinny NT GEMM with configs pinned per (N, K) for C500; everything else
+# keeps the generic FlagGems linear kernel.
+
+import logging
+
+import torch
+
+from flag_gems.ops.linear import linear as _generic_linear
+
+from .skinny_mm import lm_head_config, skinny_mm_nt
+
+logger = logging.getLogger(__name__)
+
+
+def linear(input, weight, bias=None):
+    logger.debug("GEMS_METAX LINEAR")
+    if (
+        bias is None
+        and input.dim() >= 2
+        and weight.dim() == 2
+        and input.dtype == weight.dtype
+        and weight.stride(1) == 1
+        and input.shape[-1] == weight.shape[1]
+    ):
+        K = weight.shape[1]
+        N = weight.shape[0]
+        M = input.numel() // K if K else 0
+        cfg = lm_head_config(M, N, K, input.dtype, weight.stride(0)) if M > 0 else None
+        if cfg is not None:
+            x = input.reshape(M, K)
+            # the config assumes row stride K where 32-bit offsets need it
+            if x.stride(1) != 1 or M * x.stride(0) >= 2**31:
+                x = x.contiguous()
+            out = torch.empty((M, N), device=input.device, dtype=input.dtype)
+            skinny_mm_nt(x, weight, out, cfg)
+            return out.view(*input.shape[:-1], N)
+    return _generic_linear(input, weight, bias)
