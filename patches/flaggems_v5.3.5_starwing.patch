+# ---------------------------------------------------------------------------
+# CUDA-graph-safe meta tensors for the runtime-meta kernels
+# ---------------------------------------------------------------------------
+# The generic (arbitrary-rank, arbitrary-stride) kernels below need the output shape and
+# the three stride tuples on the device, and on Triton frontends whose tl.tuple cannot be
+# indexed they have to arrive as a tensor rather than as constexprs. Building that tensor
+# with torch.tensor(..., device=...) once per call is a host->device copy, which is
+# illegal while a CUDA-graph capture is active ("operation would make the legacy stream
+# depend on a capturing blocking stream"), and would be WRONG even where it is legal: the
+# fresh allocation is freed when the call returns, so a captured graph would replay the
+# kernel against memory that has since been handed to something else.
+#
+# So the values are interned: one tensor per (device, dtype, values), built on the first
+# call with that layout and reused -- and kept alive -- for the rest of the process. The
+# values are part of the key, so a cache hit is always bit-identical to a fresh build.
+# Inside a capture a miss cannot be served at all, so it raises a plain Python error
+# BEFORE any device call: a CUDA error raised during capture is sticky and takes the
+# process with it, while this one can be caught and routed to another implementation.
+_META_CACHE = {}
+_META_CACHE_MAX = 4096
+
+
+def _is_capturing(device) -> bool:
+    probe = getattr(torch_device_fn, "is_current_stream_capturing", None)
+    if probe is None:
+        return False
+    try:
+        return bool(probe())
+    except Exception:  # noqa: BLE001
+        return False
+
+
+def _runtime_meta(values, device, dtype=torch.int64):
+    """Device tensor holding `values`, interned per (device, dtype, values)."""
+    values = tuple(int(v) for v in values)
+    key = (device.type, device.index, dtype, values)
+    meta = _META_CACHE.get(key)
+    if meta is not None:
+        return meta
+    if _is_capturing(device):
+        raise RuntimeError(
+            "flag_gems: the generic broadcast kernel needs a new shape/stride meta "
+            f"tensor ({values}) while a CUDA-graph capture is active; building it would "
+            "copy from the host and abort the capture. Run this shape once outside the "
+            "capture (a warm-up iteration), or call an implementation that takes its "
+            "layout as constexprs."
+        )
+    meta = torch.tensor(values, device=device, dtype=dtype)
+    if len(_META_CACHE) < _META_CACHE_MAX:
+        _META_CACHE[key] = meta
+    return meta
+
