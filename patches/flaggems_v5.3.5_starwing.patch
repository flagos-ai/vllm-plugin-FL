+def _plan_variant(main, tail):
+    """A GEMM as two column segments (mm_slab.plan_segments): the columns the
+    ``main`` slab tile covers in whole waves, then the rest with ``tail``."""
+    (main_name, main_cfg), (tail_name, tail_cfg) = main, tail
+    assert "S0" in main_cfg and "S0" in tail_cfg, "plan segments must be slab tiles"
+    return f"plan[{main_name}|{tail_name}]", {"plan": {"main": main_cfg, "tail": tail_cfg}}
+
+
+def _native_variant(main, tail=None, group_m=8, fallback=None):
+    """A GEMM on the native MACA C++ kernels (../native/k5_gemm.py): the
+    ``main`` variant (e.g. "T4e1") on the columns it covers in whole waves,
+    the ``tail`` variant on the rest (k5_gemm.plan_segments).  ``fallback`` is
+    the _NT_VARIANTS name of the Triton config run instead when the native
+    library is unavailable or the operands are not eligible."""
+    name = f"k5[{main}" + (f"|{tail}" if tail else "") + "]" + (f"g{group_m}" if group_m != 8 else "")
+    launch = {
+        "native": {
+            "main": _k5.variant_id(main),
+            "tail": _k5.variant_id(tail) if tail else None,
+            "group_m": group_m,
+        },
+        "fallback": fallback,
+    }
+    if fallback:
+        name += f"/{fallback}"
+    return name, launch
