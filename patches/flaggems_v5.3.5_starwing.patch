+def _slab_variant(
+    other,
+    slabs,
+    block_k,
+    num_warps,
+    num_stages,
+    split_n=True,
+    group_m=8,
+    flags="default",
+    glu=False,
+    scenario=None,
+):
+    """``(name, launch config)`` of one mm_slab_nt_kernel tile (mm_slab.py):
+    a power-of-two side ``other`` times the sum of ``slabs`` (split_n: slabs
+    along N sharing the A tile, else along M sharing the B tile)."""
+    cfg = slab_config(
+        other,
+        slabs,
+        block_k=block_k,
+        split_n=split_n,
+        glu=glu,
+        group_m=group_m,
+        num_warps=num_warps,
+        num_stages=num_stages,
+        pipeline="basic",
+        extra_options=_mxcc_options(flags, num_stages),
+        scenario=scenario,
+    )
+    return slab_name(cfg, flags), cfg
+
