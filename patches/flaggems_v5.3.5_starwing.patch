+def _pick(table, M):
+    for max_m, cfg in table:
+        if M <= max_m:
+            return cfg
+    return None
+
+
+def _offsets_fit(M, N, a_stride, w_stride, c_stride, cfg):
+    # skinny_mm_nt's kernels index A, W, C and the split-K partials with 32-bit
+    # offsets (its asserts); a shape beyond them takes the generic path.
+    return (N * w_stride < 2**31 and M * a_stride < 2**31 and M * c_stride < 2**31
+            and cfg.get("SPLIT_K", 1) * M * N < 2**31)
+
+
+def decode_nt_config(a, b, c, M, N, K):
+    """Pinned config for an NT mm (b = W.t(), stride (1, K)) of a decode-sized M, or None."""
+    table = _DECODE_NT_CONFIGS.get((N, K))
+    if not table or a.dtype not in (torch.bfloat16, torch.float16):
+        return None
+    if b.dtype != a.dtype or c.dtype != a.dtype:
+        return None
+    if a.stride(1) != 1 or b.stride(0) != 1 or b.stride(1) != K or c.stride(1) != 1:
+        return None
+    if tuple(c.shape) != (M, N):  # mm_out with an out of another shape
+        return None
+    cfg = _pick(table, M)
+    if cfg is None or not skinny_config_ok(M, N, K, cfg):
+        return None
+    if not _offsets_fit(M, N, a.stride(0), K, c.stride(0), cfg):
+        return None
+    return cfg
+
+
+def lm_head_config(M, N, K, dtype, w_stride=None):
+    """Pinned config for out[M, N] = x[M, K] @ W[N, K]^T (vocabulary projection), or None.
+
+    The offset checks take x with row stride K (the caller copies x if
+    M * x.stride(0) >= 2^31) and out as a new contiguous [M, N] tensor;
+    w_stride is W.stride(0) (K if None).
+    """
+    table = _LM_HEAD_CONFIGS.get((N, K))
+    if not table or dtype not in (torch.bfloat16, torch.float16):
+        return None
+    cfg = _pick(table, M)
+    if cfg is None or not skinny_config_ok(M, N, K, cfg):
+        return None
+    if not _offsets_fit(M, N, K, K if w_stride is None else w_stride, N, cfg):
+        return None
+    return cfg
