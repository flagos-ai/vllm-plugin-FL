+        if S2 > 0:
+            a2 = _a_ptrs(A, _slab_rows(m2, S2, M, EVEN_M), rk, K)
+            acc2 = tl.zeros((S2, BLOCK_N), dtype=tl.float32)
+        if S3 > 0:
+            a3 = _a_ptrs(A, _slab_rows(m3, S3, M, EVEN_M), rk, K)
+            acc3 = tl.zeros((S3, BLOCK_N), dtype=tl.float32)
+
+        for k in range(0, tl.cdiv(K, BLOCK_K)):
+            k_remaining = K - k * BLOCK_K
+            b = _load_b(bp, rk, k_remaining, EVEN_K)
+            y0 = _load_a(a0, rk, k_remaining, EVEN_K)
+            acc0 = tl.dot(y0, b, acc0, out_dtype=tl.float32)
+            if S1 > 0:
+                y1 = _load_a(a1, rk, k_remaining, EVEN_K)
+                acc1 = tl.dot(y1, b, acc1, out_dtype=tl.float32)
+            if S2 > 0:
+                y2 = _load_a(a2, rk, k_remaining, EVEN_K)
+                acc2 = tl.dot(y2, b, acc2, out_dtype=tl.float32)
+            if S3 > 0:
+                y3 = _load_a(a3, rk, k_remaining, EVEN_K)
+                acc3 = tl.dot(y3, b, acc3, out_dtype=tl.float32)
+            bp = _b_next(bp, BLOCK_K, PBN)
+            a0 += BLOCK_K
+            if S1 > 0:
+                a1 += BLOCK_K
+            if S2 > 0:
+                a2 += BLOCK_K
+            if S3 > 0:
+                a3 += BLOCK_K
+
+        rn = off_n + tl.arange(0, BLOCK_N)
+        _store(C, acc0.to(C.dtype.element_ty), m0 + tl.arange(0, S0), rn, M, N, N_END, EVEN_M, EVEN_N)
+        if S1 > 0:
+            _store(C, acc1.to(C.dtype.element_ty), m1 + tl.arange(0, S1), rn, M, N, N_END, EVEN_M, EVEN_N)
+        if S2 > 0:
+            _store(C, acc2.to(C.dtype.element_ty), m2 + tl.arange(0, S2), rn, M, N, N_END, EVEN_M, EVEN_N)
+        if S3 > 0:
+            _store(C, acc3.to(C.dtype.element_ty), m3 + tl.arange(0, S3), rn, M, N, N_END, EVEN_M, EVEN_N)
+
+
+# --------------------------------------------------------------------------- #
+# host side
+# --------------------------------------------------------------------------- #
+_LAUNCH_KEYS = ("num_warps", "num_stages", "pipeline", "scenario", "extra_options", "pipeline_load_num")
+_TILE_KEYS = ("BLOCK_M", "BLOCK_N", "BLOCK_K", "S0", "S1", "S2", "S3", "SPLIT_N", "GLU", "PBN", "GROUP_M")
+
+
+def _pow2(x):
+    return x > 0 and x & (x - 1) == 0
+
+
+def slab_config(
+    other,
+    slabs,
+    block_k=32,
+    split_n=True,
+    glu=False,
+    pbn=0,
+    group_m=8,
+    num_warps=8,
+    num_stages=2,
+    pipeline="basic",
+    extra_options=None,
+    scenario=None,
+):
+    """Launch config (a dict) of one slab tile.
+
+    ``other`` is the power-of-two side (BLOCK_M for split_n, else BLOCK_N);
+    ``slabs`` are 1-4 power-of-two slab sizes >= 16 along the split side.
+    GLU: slabs = (gate, up) or (gate, up, gate2, up2) with equal pairs; the
+    output tile is BLOCK_M x (S0 + S2).
+    """
+    slabs = tuple(int(s) for s in slabs)
+    assert 1 <= len(slabs) <= 4 and all(_pow2(s) and s >= 16 for s in slabs), slabs
+    assert _pow2(other) and other >= 16 and _pow2(block_k) and block_k >= 16, (other, block_k)
+    s = slabs + (0,) * (4 - len(slabs))
+    if glu:
+        assert split_n and len(slabs) in (2, 4) and s[0] == s[1] and s[2] == s[3], slabs
+        span = s[0] + s[2]
+    else:
+        span = sum(s)
+    bm, bn = (other, span) if split_n else (span, other)
+    cfg = dict(
+        BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=block_k, S0=s[0], S1=s[1], S2=s[2], S3=s[3],
+        SPLIT_N=bool(split_n), GLU=bool(glu), PBN=int(pbn), GROUP_M=group_m,
+        num_warps=num_warps, num_stages=num_stages, pipeline=pipeline,
+    )
+    if extra_options:
+        cfg["extra_options"] = extra_options
+    if scenario:
+        cfg["scenario"] = scenario
+    return cfg
+
+
+def slab_name(cfg, flags=None):
+    sl = "+".join(str(cfg[f"S{i}"]) for i in range(4) if cfg[f"S{i}"])
+    name = f"slab{cfg['BLOCK_M']}x{cfg['BLOCK_N']}x{cfg['BLOCK_K']}_{'N' if cfg['SPLIT_N'] else 'M'}{sl}"
+    name += f"_w{cfg['num_warps']}s{cfg['num_stages']}g{cfg['GROUP_M']}"
+    if cfg.get("pipeline", "basic") != "basic":
+        name += f"_{cfg['pipeline'] or 'none'}"
+    if cfg.get("scenario"):
+        name += "_sc-" + cfg["scenario"].replace(";", "+")
+    if flags and flags != "default":
+        name += f"_{flags}"
+    if cfg["PBN"]:
+        name += f"_p{cfg['PBN']}"
+    if cfg["GLU"]:
+        name += "_glu"
+    return name
+
+
+def acc_regs_per_thread(cfg):
+    return cfg["BLOCK_M"] * cfg["BLOCK_N"] * (2 if cfg["GLU"] else 1) // (64 * cfg["num_warps"])
+
+
+_entries = {}
+
+
+def _entry(cfg):
+    # LibEntry caches by kernel arguments only, not launch options, so each
+    # distinct option set gets its own LibEntry (as _nt_pinned_entry in mm.py).
+    options = tuple(sorted((k, cfg[k]) for k in _LAUNCH_KEYS if k in cfg))
+    e = _entries.get(options)
+    if e is None:
+        e = _entries.setdefault(options, libentry()(mm_slab_nt_kernel))
+    return e
+
+
+def slab_ok(cfg, M, N, K, n_rows=None):
+    """Whether cfg can run this GEMM (packed B needs whole PBN row blocks and
+    BLOCK_K | K; GLU needs an even weight)."""
+    if M < 1 or N < 1 or K < 1:
+        return False
+    if cfg["PBN"]:
+        rows = n_rows if n_rows is not None else (2 * N if cfg["GLU"] else N)
+        if K % cfg["BLOCK_K"] or rows % cfg["PBN"]:
+            return False
+    return True
+
+
+def launch_slab(a, b, c, M, N, K, cfg, col0=0, n_end=None, half=0, return_kernel=False):
+    """c[:, col0:n_end] of c[M, N] = a[M, K] @ W^T (GLU: silu/mul of the gate
+    and up halves, half = I).  ``b`` is any tensor whose data pointer is W
+    (the NT operand b = W.t(), W itself, or a packed W).  return_kernel:
+    return (c, compiled kernel) -- for register/shared-memory reports."""
+    n_end = N if n_end is None else n_end
+    assert 0 <= col0 < n_end <= N, (col0, n_end, N)
+    bm, bn, bk = cfg["BLOCK_M"], cfg["BLOCK_N"], cfg["BLOCK_K"]
+    width = n_end - col0
+    grid = (triton.cdiv(M, bm) * triton.cdiv(width, bn),)
+    tile = {k: cfg[k] for k in _TILE_KEYS}
+    with torch_device_fn.device(a.device):
+        ret = _entry(cfg)[grid](
+            a, b, c, M, N, K, col0, n_end, half,
+            EVEN_M=M % bm == 0, EVEN_N=width % bn == 0, EVEN_K=K % bk == 0,
+            **tile, **{k: cfg[k] for k in _LAUNCH_KEYS if k in cfg},
+        )
+    if return_kernel:
+        return c, (ret[0] if isinstance(ret, tuple) else ret)
+    return c
+
+
+# --------------------------------------------------------------------------- #
+# launch plans: a GEMM as up to two column segments with different tiles
+# --------------------------------------------------------------------------- #
+def plan_segments(M, N, main, tail=None, aps=None):
+    """[(col0, n_end, cfg), ...] for one GEMM.
+
+    With a ``tail`` config: the columns that the main tile covers in whole
+    waves over the APs run with ``main``, the rest with ``tail`` -- only if
+    that rest fits in one wave of the tail tile, else ``main`` alone."""
+    if tail is None:
+        return [(0, N, main)]
+    aps = aps or get_sm_count()
+    mt = triton.cdiv(M, main["BLOCK_M"])
+    total = mt * triton.cdiv(N, main["BLOCK_N"])
+    waves = total // aps
+    if waves == 0 or total % aps == 0:
+        return [(0, N, main)]
+    cols = (waves * aps // mt) * main["BLOCK_N"]
+    if cols <= 0 or cols >= N:
+        return [(0, N, main)]
+    tail_tiles = triton.cdiv(M, tail["BLOCK_M"]) * triton.cdiv(N - cols, tail["BLOCK_N"])
+    if tail_tiles > aps:
+        return [(0, N, main)]
+    return [(0, cols, main), (cols, N, tail)]
+
+
+def launch_plan(a, b, c, M, N, K, plan, half=0):
+    """plan = {"main": cfg, "tail": cfg or None}."""
+    for col0, n_end, cfg in plan_segments(M, N, plan["main"], plan.get("tail")):
+        launch_slab(a, b, c, M, N, K, cfg, col0, n_end, half)
+    return c
+
+
+# --------------------------------------------------------------------------- #
+# packed weights
+# --------------------------------------------------------------------------- #
+def pack_weight(w, pbn, pbk):
+    """W[N, K] -> the same elements stored as [N/pbn][K/pbk][pbn][pbk] (a
+    contiguous [N, K]-shaped tensor; the kernels with PBN=pbn and
+    BLOCK_K=pbk read it).  Returns a new tensor."""
+    n, k = w.shape
+    assert n % pbn == 0 and k % pbk == 0, (n, k, pbn, pbk)
+    return w.reshape(n // pbn, pbn, k // pbk, pbk).permute(0, 2, 1, 3).contiguous().view(n, k)
+
+
+def unpack_weight(wp, pbn, pbk):
+    n, k = wp.shape
+    return wp.reshape(n // pbn, k // pbk, pbn, pbk).permute(0, 2, 1, 3).contiguous().view(n, k)
+
+
+def wave_util(M, N, cfg, aps=None):
+    aps = aps or get_sm_count()
+    t = triton.cdiv(M, cfg["BLOCK_M"]) * triton.cdiv(N, cfg["BLOCK_N"])
+    return t, t / (math.ceil(t / aps) * aps)
