+# limitations under the License.
+
+# Native MACA C++ NT GEMM ("k5") for MetaX C500: C[M, N] = A[M, K] @ W[N, K]^T
+# in bf16 with fp32 accumulation, our own kernels written with the MACA MMA /
+# async-copy builtins (source: k5_src.py, generated from
+# work/R6/K5-mx-gemm4/native).  Two designs, chosen per (N, K, M bucket) by
+# the pinned NT table in ../ops/mm.py:
+#   T: 256 x 64*NTW x 64 tiles, one 64 KiB shared buffer, 4 inner stages
+#   H: 256 x 64*NTW x 32 tiles, two 32 KiB shared buffers
+# Variant names "T4e1" = design T, NTW=4 (BN=256), epilogue 1 (shared-memory
+# staged stores).
+#
+# The source is compiled once per (source hash, mxcc version) with
+# $MACA_PATH/mxgpu_llvm/bin/mxcc into <FlagGems cache>/native and loaded with
+# ctypes; launches go to torch's current stream.  Any problem (no mxcc,
+# compile or load error, FLAGGEMS_METAX_NATIVE_GEMM=0) disables the native path
+# and run_segments() returns False, so the caller keeps its Triton kernels.
+# `python3 <site-packages>/flag_gems/runtime/backend/_metax/native/k5_gemm.py`
+# builds the library ahead of time (CPU only, does not import flag_gems).
+
+import ctypes
+import fcntl
+import hashlib
+import logging
+import os
+import subprocess
+import sys
+import tempfile
+import threading
+
+try:
+    from . import k5_src
+except ImportError:  # run as a script (ahead-of-time build without importing flag_gems)
+    import k5_src
+
+logger = logging.getLogger(__name__)
+
+_DEFINES = ("-DK5_BUILD_T", "-DK5_BUILD_H") + tuple(getattr(k5_src, "EXTRA_DEFINES", ()))
+_ARCH = ("--offload-arch=xcore1000",)
+_DESIGNS = {"T": 1, "H": 2}
+_DESIGN_BK = {1: 64, 2: 32}
+_lock = threading.Lock()
+_state = {"lib": None, "tried": False, "error": None}
+
+
+def variant_id(name):
+    """'T4e1' -> 141"""
+    d, ntw, epi = _DESIGNS[name[0]], int(name[1]), int(name[3])
+    assert name[2] == "e" and len(name) == 4 and ntw in (2, 3, 4) and epi in (0, 1), name
+    return d * 100 + ntw * 10 + epi
+
+
+def variant_bn(v):
+    return 64 * ((v // 10) % 10)
+
+
+def variant_bk(v):
+    return _DESIGN_BK[v // 100]
+
+
+def _mxcc():
+    maca = os.environ.get("MACA_PATH", "/opt/maca")
+    path = os.path.join(maca, "mxgpu_llvm", "bin", "mxcc")
+    return (path, maca) if os.path.exists(path) else (None, maca)
+
+
+def _cache_root():
+    # same root as flag_gems.utils.code_cache.cache_dir(), without importing flag_gems
+    root = os.environ.get("FLAGGEMS_CACHE_DIR") or os.path.join(os.path.expanduser("~"), ".flaggems")
+    d = os.path.join(root, "native")
+    os.makedirs(d, exist_ok=True)
+    return d
+
+
+def library_path():
+    mxcc, _ = _mxcc()
+    if mxcc is None:
+        return None
+    ver = subprocess.run([mxcc, "--version"], capture_output=True, text=True, timeout=60).stdout
+    h = hashlib.sha256(
+        (k5_src.K5_GEMM_CU + k5_src.K5T_SCHEDULE_INC + " ".join(_DEFINES + _ARCH) + ver).encode()
+    ).hexdigest()[:16]
+    return os.path.join(_cache_root(), f"libk5_{h}.so")
+
+
+def build(force=False):
+    """Compile the library if it is not cached (CPU only).  Returns its path."""
+    mxcc, maca = _mxcc()
+    if mxcc is None:
+        raise RuntimeError(f"mxcc not found under {maca}")
+    so = library_path()
+    with open(so + ".lock", "w") as lk:
+        fcntl.flock(lk, fcntl.LOCK_EX)
+        if os.path.exists(so) and not force:
+            return so
+        with tempfile.TemporaryDirectory(dir=os.path.dirname(so)) as tmp:
+            with open(os.path.join(tmp, "k5_gemm.cu"), "w") as f:
+                f.write(k5_src.K5_GEMM_CU)
+            with open(os.path.join(tmp, "k5t_schedule.inc"), "w") as f:
+                f.write(k5_src.K5T_SCHEDULE_INC)
+            out = os.path.join(tmp, "libk5.so")
+            cmd = [mxcc, "-x", "maca", "-O3", "-std=c++17", "-fPIC", "-shared", *_ARCH,
+                   f"-I{tmp}", *_DEFINES, os.path.join(tmp, "k5_gemm.cu"), "-o", out,
+                   f"--maca-path={maca}"]
+            p = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
+            if p.returncode != 0 or not os.path.exists(out):
+                raise RuntimeError(f"mxcc failed ({p.returncode}): {(p.stdout + p.stderr)[-2000:]}")
+            os.replace(out, so)
+    return so
+
+
+class _Lib:
+    def __init__(self, path):
+        lib = ctypes.CDLL(path)
+        c_int, c_vp = ctypes.c_int, ctypes.c_void_p
+        lib.k5_gemm.argtypes = [c_int, c_vp, c_vp, c_vp] + [c_int] * 8 + [c_vp]
+        lib.k5_gemm.restype = c_int
+        lib.k5_variants.argtypes = [ctypes.POINTER(c_int), c_int]
+        lib.k5_variants.restype = c_int
+        buf = (c_int * 64)()
+        n = lib.k5_variants(buf, 64)
+        self.variants = {buf[i] for i in range(n)}
+        self.lib = lib
+        self.path = path
+
+
+def lib():
