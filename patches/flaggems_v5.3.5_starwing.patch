+# Slab NT GEMM for MetaX C500: C[M, N] = A[M, K] @ W[N, K]^T (W given as the
+# B = W.t() view of an NT ``mm`` operand, stride (1, K)).
+#
+# The C500 has 104 APs and room for one 256x256 (or 256x192) bf16 tile per AP
+# (64 KiB shared memory).  At the chunked-prefill size M=2048 the N=2048
+# projections (o_proj, down_proj) give 64 tiles of 256x256 or 88 of 256x192,
+# i.e. 62% / 82% of the APs for the whole kernel; N=2560 (qkv) gives 80
+# tiles; gate_up (N=12288) 384 tiles = 3.69 waves.  Triton tensors are powers
+# of two, so the output tile here is a power-of-two side times a SUM of up to
+# four power-of-two "slabs" (each its own tl.dot sharing the other operand):
+#   SPLIT_N=True:  BLOCK_M x (S0+S1+S2+S3), the A tile is loaded once per k-step
+#   SPLIT_N=False: (S0+S1+S2+S3) x BLOCK_N, the B tile is loaded once per k-step
+# which gives 256x160 (104 tiles for N=2048 at M=2048), 256x208 / 208x256
+# (104 / 100 tiles for qkv), 256x224, 128x160, ...
+#
+# Extra modes of the same kernel:
+#   * column segments (COL0, N_END): the launch covers output columns
+#     [COL0, N_END) only, so one GEMM can run as two launches with different
+#     tiles -- full waves of the big tile, then the remaining columns with a
+#     smaller tile that fills one wave (gate_up: 3 waves of 256x256 + 96 tiles
+#     of 256x192 instead of 4 waves with a 72-tile tail).
+#   * GLU (fused SiLU-and-mul epilogue): W is the merged [gate; up] weight of
+#     shape [2*I, K]; slab pairs (S0 gate, S1 up) and (S2 gate, S3 up) read the
+#     gate rows j and the up rows HALF + j of the same output columns, and the
+#     epilogue writes silu(gate) * up into C[M, I].  gate/up are rounded to the
+#     input dtype first, exactly like the unfused gate_up GEMM output, so only
+#     the GEMM summation order differs from GEMM + silu_and_mul.
+#   * packed B (PBN > 0): W stored tile-major as [N/PBN][K/BLOCK_K][PBN][BLOCK_K]
+#     (see pack_weight), so the PBN rows of one k-step are one contiguous
+#     block and every 16-lane group reads full 128-byte lines (unpacked rows
+#     are BLOCK_K*2 = 64 bytes apart-segments at BLOCK_K=32).
+#
+# Rows/columns past M/N wrap around (``% M`` / ``% N``) so the K loop needs no
+# row masks (as in mm_kernel_nt); the epilogue masks the store.
+
+import math
+
+import triton
+import triton.language as tl
+
+from flag_gems.runtime import torch_device_fn
+from flag_gems.utils import libentry
+from flag_gems.utils.device_info import get_sm_count
+
+
+@triton.jit
+def _slab_rows(off, SIZE: tl.constexpr, LIMIT, EVEN: tl.constexpr):
+    # Row (or column) indices of one slab; past the end they wrap (% LIMIT) so
+    # the K loop needs no mask.  No contiguity hints: these index the strided
+    # dimension of A/W, the vectorised one is K.
+    r = off + tl.arange(0, SIZE)
+    if EVEN:
+        idx = r
+    else:
+        idx = r % LIMIT
+    return idx
+
+
+@triton.jit
+def _a_ptrs(A, rows, rk, K):
+    return A + rows[:, None] * K + rk[None, :]
+
+
+@triton.jit
+def _b_ptrs(B, rows, rk, K, BLOCK_K: tl.constexpr, PBN: tl.constexpr):
+    # B tile [BLOCK_K, SIZE]: element (k, j) is W[rows[j], k]
+    if PBN == 0:
+        p = B + rk[:, None] + rows[None, :] * K
+    else:
+        p = B + rk[:, None] + ((rows // PBN) * (PBN * K) + (rows % PBN) * BLOCK_K)[None, :]
+    return p
+
+
+@triton.jit
+def _b_next(ptrs, BLOCK_K: tl.constexpr, PBN: tl.constexpr):
+    if PBN == 0:
+        ptrs += BLOCK_K
+    else:
+        ptrs += PBN * BLOCK_K
+    return ptrs
+
+
+@triton.jit
+def _load_a(ptrs, rk, k_remaining, EVEN_K: tl.constexpr):
+    if EVEN_K:
+        x = tl.load(ptrs)
+    else:
+        x = tl.load(ptrs, mask=rk[None, :] < k_remaining, other=0.0)
+    return x
+
+
+@triton.jit
+def _load_b(ptrs, rk, k_remaining, EVEN_K: tl.constexpr):
+    if EVEN_K:
+        x = tl.load(ptrs)
+    else:
+        x = tl.load(ptrs, mask=rk[:, None] < k_remaining, other=0.0)
+    return x
+
+
+@triton.jit
+def _store(C, val, rm, rn, M, N_ROW, N_END, EVEN_M: tl.constexpr, EVEN_N: tl.constexpr):
+    c_ptrs = C + rm[:, None] * N_ROW + rn[None, :]
+    if EVEN_M and EVEN_N:
+        tl.store(c_ptrs, val)
+    else:
+        tl.store(c_ptrs, val, mask=(rm < M)[:, None] & (rn < N_END)[None, :])
+
+
+@triton.jit
+def _silu_mul(g_acc, u_acc, C):
+    # gate/up rounded like the unfused GEMM output, SiLU in fp32
+    g = g_acc.to(C.dtype.element_ty).to(tl.float32)
+    u = u_acc.to(C.dtype.element_ty).to(tl.float32)
+    return (g / (1.0 + tl.exp(-g)) * u).to(C.dtype.element_ty)
+
+
