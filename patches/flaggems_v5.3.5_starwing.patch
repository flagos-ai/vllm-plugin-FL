+def _nt_variant(
+    block_m,
+    block_n,
+    block_k,
+    num_warps,
+    num_stages,
+    group_m=8,
+    flags="default",
+    nsub=1,
+    split_n=False,
+):
+    """Return ``(name, launch kwargs)`` of one pinned NT GEMM config.
+
+    ``nsub > 1`` selects mm_kernel_nt_subdot (``split_n``: the sub-dots split
+    BLOCK_N and share the A tile, else they split BLOCK_M and share the B
+    tile); ``nsub == 1`` launches the mm_kernel_nt body.
+    """
+    launch = dict(BLOCK_M=block_m, BLOCK_N=block_n, BLOCK_K=block_k, GROUP_M=group_m)
+    name = f"{block_m}x{block_n}x{block_k}"
+    if nsub > 1:
+        assert nsub <= 3, nsub
+        if split_n:
+            sub_m, sub_n = block_m, block_n // nsub
+        else:
+            sub_m, sub_n = block_m // nsub, block_n
+        assert sub_m * sub_n * nsub == block_m * block_n, (block_m, block_n, nsub)
+        assert sub_m & (sub_m - 1) == 0 and sub_n & (sub_n - 1) == 0, (sub_m, sub_n)
+        launch.update(SUB_M=sub_m, SUB_N=sub_n, NSUB=nsub, SPLIT_N=bool(split_n))
+        name += f"_{nsub}x{'N' if split_n else 'M'}"
+    name += f"_w{num_warps}s{num_stages}g{group_m}"
+    launch.update(num_warps=num_warps, num_stages=num_stages, pipeline="basic")
+    if flags != "default":
+        launch["extra_options"] = _mxcc_options(flags, num_stages)
+        name += f"_{flags}"
+    return name, launch
+
+
+def _mxcc_options(flags, num_stages):
+    if flags == "default":
+        return None
+    return _MXCC_FLAGS[flags] + f" -mllvm -metaxgpu-mma-unroll-count={num_stages} "
+
