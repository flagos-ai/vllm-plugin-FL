+# Sort-free top-p (nucleus) masking.
+#
+# The reference implementation sorts every row of the vocabulary, takes a
+# cumulative softmax and masks the low tail. For large vocabularies the full
+# sort dominates a decode step. Here the cut-off is found without sorting:
+#
+#   keep x  <=>  mass(y > x) < p          (mass = softmax probability)
+#
+# which is the sort/cumsum rule restated per element (the reference keeps a
+# token iff the probability strictly above it in sorted order is < p). The
+# smallest kept value is located by searching over an order-preserving int32
+# encoding of fp32: every pass evaluates NUM_CAND thresholds at once, shrinking
+# the search interval NUM_CAND-fold, so 32 bits are resolved in a fixed number
+# of passes. Only for/where/sum/max are used (no scans, no data-dependent
+# loops), so the kernels also compile on vendor Triton forks.
+#
+# Each row is split over SPLIT programs. Every pass writes per-program partial
+# sums; the next pass first replays the search from all earlier partials (in a
+# fixed order, so every program of a row derives the same interval) instead of
+# needing a grid-wide barrier.
+#
+# The only difference from the sort-based reference is at an exact tie on the
+# boundary value: all tokens equal to the boundary value are kept, while the
+# reference keeps an arbitrary subset of them (sort order of ties is
+# unspecified).
+
+import torch
+import triton
+import triton.language as tl
+
+_NEG_INF_KEY = tl.constexpr(-2139095041)  # _ordered_key(-inf)
+
+
+@triton.jit
+def _ordered_key(x):
+    # Monotone map fp32 -> int32: integer order equals float order.
+    bits = x.to(tl.int32, bitcast=True)
+    return tl.where(bits >= 0, bits, bits ^ 0x7FFFFFFF)
+
+
+@triton.jit
+def _row_stats(stats_ptr, row, SPLIT: tl.constexpr):
+    # Combine per-program (max, sum of exp(x - local max)) into the row's max and sum.
+    split = tl.arange(0, SPLIT)
+    local_max = tl.load(stats_ptr + (row * SPLIT + split) * 2)
+    local_sum = tl.load(stats_ptr + (row * SPLIT + split) * 2 + 1)
+    row_max = tl.max(local_max, axis=0)
+    scale = tl.where(local_max == float("-inf"), 0.0, tl.exp(local_max - row_max))
+    return row_max, tl.sum(local_sum * scale, axis=0)
+
+
+@triton.jit
+def _replay_search(mass_ptr, row, num_rows, row_max, target, num_done,
+                   SPLIT: tl.constexpr, NUM_CAND: tl.constexpr):
+    # Recompute the search interval after `num_done` passes from the stored partial masses.
+    # Invariant: key `lo` does not qualify (mass above -inf is the whole row),
+    # key `hi` qualifies (nothing lies above the row max).
+    lo = tl.full([], _NEG_INF_KEY, tl.int64)
+    hi = _ordered_key(row_max).to(tl.int64)
+    steps = tl.arange(1, NUM_CAND + 1).to(tl.int64)
+    offs = tl.arange(0, SPLIT)[:, None] * NUM_CAND + tl.arange(0, NUM_CAND)[None, :]
+    for k in range(0, num_done):
+        cand = lo + ((hi - lo) * steps) // NUM_CAND
+        part = tl.load(mass_ptr + ((k * num_rows + row) * SPLIT) * NUM_CAND + offs)
+        ok = tl.sum(part, axis=0) < target
+        hi = tl.minimum(hi, tl.min(tl.where(ok, cand, hi), axis=0))
+        lo = tl.maximum(lo, tl.max(tl.where(ok, lo, cand), axis=0))
+    return lo, hi
+
+
+@triton.jit
+def _stats_kernel(logits_ptr, stats_ptr, stride_row, vocab_size, chunk,
+                  SPLIT: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    sid = tl.program_id(1)
+    row_ptr = logits_ptr + row.to(tl.int64) * stride_row
+    begin = sid * chunk
+    end = tl.minimum(begin + chunk, vocab_size)
+    offs = tl.arange(0, BLOCK)
+    max_acc = tl.full([BLOCK], float("-inf"), tl.float32)
+    for start in range(begin, end, BLOCK):
+        idx = start + offs
+        x = tl.load(row_ptr + idx, mask=idx < end, other=float("-inf"))
+        max_acc = tl.maximum(max_acc, x.to(tl.float32))
+    local_max = tl.max(max_acc, axis=0)
+    sum_acc = tl.zeros([BLOCK], tl.float32)
+    for start in range(begin, end, BLOCK):
+        idx = start + offs
+        x = tl.load(row_ptr + idx, mask=idx < end, other=float("-inf")).to(tl.float32)
+        sum_acc += tl.where(x == float("-inf"), 0.0, tl.exp(x - local_max))
+    tl.store(stats_ptr + (row * SPLIT + sid) * 2, local_max)
+    tl.store(stats_ptr + (row * SPLIT + sid) * 2 + 1, tl.sum(sum_acc, axis=0))
+
+
+@triton.jit
+def _search_pass_kernel(logits_ptr, p_ptr, stats_ptr, mass_ptr, stride_row, vocab_size,
+                        chunk, num_rows, pass_idx,
+                        SPLIT: tl.constexpr, NUM_CAND: tl.constexpr, BLOCK: tl.constexpr,
+                        SEARCH_BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    sid = tl.program_id(1)
+    row_ptr = logits_ptr + row.to(tl.int64) * stride_row
+    row_max, row_sum = _row_stats(stats_ptr, row, SPLIT)
+    target = tl.load(p_ptr + row).to(tl.float32) * row_sum
+    lo, hi = _replay_search(mass_ptr, row, num_rows, row_max, target, pass_idx, SPLIT, NUM_CAND)
+    steps = tl.arange(1, NUM_CAND + 1).to(tl.int64)
+    cand = (lo + ((hi - lo) * steps) // NUM_CAND).to(tl.int32)
+
+    begin = sid * chunk
+    end = tl.minimum(begin + chunk, vocab_size)
+    offs = tl.arange(0, SEARCH_BLOCK)
+    # Accumulate element-wise in a register tile and reduce across threads once at the end.
+    acc = tl.zeros([SEARCH_BLOCK, NUM_CAND], tl.float32)
+    for start in range(begin, end, SEARCH_BLOCK):
+        idx = start + offs
+        x = tl.load(row_ptr + idx, mask=idx < end, other=float("-inf")).to(tl.float32)
+        e = tl.where(x == float("-inf"), 0.0, tl.exp(x - row_max))
+        above = _ordered_key(x)[:, None] > cand[None, :]
+        acc += tl.where(above, e[:, None], 0.0)
+    out = mass_ptr + ((pass_idx * num_rows + row) * SPLIT + sid) * NUM_CAND
+    tl.store(out + tl.arange(0, NUM_CAND), tl.sum(acc, axis=0))
+
+
+@triton.jit
+def _apply_mask_kernel(logits_ptr, p_ptr, stats_ptr, mass_ptr, stride_row, vocab_size,
+                       chunk, num_rows, num_passes,
+                       SPLIT: tl.constexpr, NUM_CAND: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    sid = tl.program_id(1)
+    row_ptr = logits_ptr + row.to(tl.int64) * stride_row
+    p = tl.load(p_ptr + row).to(tl.float32)
+    row_max, row_sum = _row_stats(stats_ptr, row, SPLIT)
+    _, hi = _replay_search(mass_ptr, row, num_rows, row_max, p * row_sum, num_passes, SPLIT, NUM_CAND)
+    cutoff = hi.to(tl.int32)
+    apply = p < 1.0  # rows with p >= 1 are left untouched
+
+    begin = sid * chunk
+    end = tl.minimum(begin + chunk, vocab_size)
+    offs = tl.arange(0, BLOCK)
+    for start in range(begin, end, BLOCK):
+        idx = start + offs
+        in_range = idx < end
+        x = tl.load(row_ptr + idx, mask=in_range, other=float("-inf"))
+        drop = (_ordered_key(x.to(tl.float32)) < cutoff) & in_range & apply
+        tl.store(row_ptr + idx, tl.full([BLOCK], float("-inf"), x.dtype), mask=drop)
+
+
+def top_p_mask_(logits: torch.Tensor, p: torch.Tensor) -> torch.Tensor:
+    """In-place top-p mask: set logits outside each row's nucleus to -inf.
+
+    Args:
+        logits: [batch, vocab] floating tensor, rows contiguous.
+        p: [batch] top-p values in (0, 1]; rows with p >= 1 are left unchanged.
+    """
+    assert logits.dim() == 2 and logits.stride(1) == 1
+    batch, vocab_size = logits.shape
+    if batch == 0:
+        return logits
+    split, num_cand, block = 16, 16, 1024
+    num_passes = 9  # ceil(32 bits / log2(16)) + 1: the last pass resolves the remainder exactly
+    chunk = triton.cdiv(triton.cdiv(vocab_size, split), block) * block
+    p = p.to(device=logits.device, dtype=torch.float32).contiguous()
+    stats = torch.empty((batch, split, 2), device=logits.device, dtype=torch.float32)
+    mass = torch.empty((num_passes, batch, split, num_cand), device=logits.device, dtype=torch.float32)
+    grid = (batch, split)
+    common = dict(SPLIT=split, BLOCK=block, num_warps=4)
+    _stats_kernel[grid](logits, stats, logits.stride(0), vocab_size, chunk, **common)
+    for pass_idx in range(num_passes):
+        _search_pass_kernel[grid](logits, p, stats, mass, logits.stride(0), vocab_size, chunk,
+                                  batch, pass_idx, NUM_CAND=num_cand, SEARCH_BLOCK=256, **common)
+    _apply_mask_kernel[grid](logits, p, stats, mass, logits.stride(0), vocab_size, chunk,
+                             batch, num_passes, NUM_CAND=num_cand, **common)
+    return logits
