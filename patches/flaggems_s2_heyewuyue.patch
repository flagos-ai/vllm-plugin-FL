+    scale_bytes = sum(scale.nbytes for codes, scale in resident)
+    logger.info("E436 native W8 prefill GU installed layers=%d scale_bytes=%d", len(layers), scale_bytes)
+    logger.info("E279 prefill GU resident layers=%d bytes=%d", len(layers), resident_bytes)
+    logger.info("E437 native W8 decode GU installed layers=%d packed_bytes=%d seconds=%.3f",
+                len(layers) - narrow, packed_bytes, time.monotonic() - start)
