+def _e5m3_up_ref(s):
+    b = s.to(torch.float16).view(torch.int16).to(torch.int32)
+    return ((b + 127) >> 7).clamp(1, 247)
+
+
+def _e5m3_dec_ref(b):
+    return (b.to(torch.int32) << 7).to(torch.int16).view(torch.float16).float()
+
+
+def quant_k_ref(x):
+    """rotated fp32 K [..., D] -> dequantised values as the write kernel stores them (asym g64, integer zero point)."""
+    xg = x.reshape(*x.shape[:-1], 2, 64)
+    lo00 = xg.amin(-1, keepdim=True).clamp(max=0.0)
+    hi00 = xg.amax(-1, keepdim=True).clamp(min=0.0)
+    best, berr = None, None
+    for k in range(7):
+        r = 1.0 - 0.05 * k
+        hf = (hi00 - lo00) * 0.5 * r
+        lo = ((hi00 + lo00) * 0.5 - hf).clamp(max=0.0)
+        s = _e5m3_dec_ref(_e5m3_up_ref((2.0 * hf / 15.0).clamp_min(1.220703125e-4)))
+        z = torch.floor(-lo / s + 0.5).clamp(0, 15)
+        y = (torch.floor(xg / s + 0.5).add(z).clamp(0, 15) - z) * s
+        e = (y - xg).pow(2).sum(-1, keepdim=True)
+        if best is None:
+            best, berr = y, e
+        else:
+            m = e < berr
+            best, berr = torch.where(m, y, best), torch.where(m, e, berr)
+    return best.reshape(x.shape)
+
+
+def quant_v_ref(x):
+    a = x.abs().amax(-1, keepdim=True)
+    best, berr = None, None
+    for k in range(7):
+        r = 1.0 - 0.05 * k
+        s = _e5m3_dec_ref(_e5m3_up_ref((a * r / 7.0).clamp_min(1.220703125e-4)))
+        y = torch.floor(x / s + 0.5).clamp(-8, 7) * s
+        e = (y - x).pow(2).sum(-1, keepdim=True)
+        if best is None:
+            best, berr = y, e
+        else:
+            m = e < berr
+            best, berr = torch.where(m, y, best), torch.where(m, e, berr)
+    return best
+
+
+def dequant_pages(c8):
+    """uint8 page bytes [nb * 4224] -> K, V [nb, 16, HKV, D] fp32 in rotated space (natural dim order)."""
+    pg = c8.view(-1, PAGE_BYTES).to(torch.int32)
+    nb = pg.shape[0]
+    w = pg[:, 0:4096:2] | (pg[:, 1:4096:2] << 8)
+    hh, tt, ee = torch.meshgrid(torch.arange(HKV_EXP), torch.arange(PAGE), torch.arange(32), indexing="ij")
+    c = ee & 15
+    gg = ee >> 4
+    ik = 512 * hh + 256 * gg + 128 * (tt >> 3) + 2 * (c + 16 * ((tt >> 1) & 3)) + (tt & 1)
+    kk = ((tt >> 2) & 1) | ((tt & 1) << 1) | (((tt >> 1) & 1) << 2) | (((tt >> 3) & 1) << 3)
+    iv = 1024 + 512 * hh + 256 * gg + 128 * (c >> 3) + 2 * (kk + 16 * ((c >> 1) & 3)) + (c & 1)
+    sh = 4 * torch.arange(4)
+
+    def nib(x):                                                                   # [..., 32] halfwords -> [..., 128] codes, dim 4e + p
+        return ((x[..., None] >> sh) & 15).flatten(-2).float()
+    kc, vc = nib(w[:, ik.flatten()].view(nb, HKV_EXP, PAGE, 32)), nib(w[:, iv.flatten()].view(nb, HKV_EXP, PAGE, 32))
+    rec = pg[:, 4096:].view(nb, HKV_EXP, PAGE, 4)
+    ks = _e5m3_dec_ref(rec[..., :2])
+    kz = rec[..., 2]
+    vs = _e5m3_dec_ref(rec[..., 3])
+    zz = torch.stack([kz & 15, kz >> 4], -1).float()
+    k = ((kc.view(nb, HKV_EXP, PAGE, 2, 64) - zz[..., None]) * ks[..., None]).view(nb, HKV_EXP, PAGE, D)
+    v = (vc - 8.0) * vs[..., None]
+    return k.transpose(1, 2), v.transpose(1, 2)
+
+
+def _fill_seqs(lens, slots, device, gen, kv_cache, c8, c16, win):
+    """Write every token of each sequence through the write kernel as one chunk per sequence (the newest WIN tokens of rows
+    with a slot land in the window). Returns rotated fp32 K / V per sequence and the block table."""
+    pages = [-(-n // PAGE) for n in lens]
+    nb = kv_cache.shape[0]
+    perm = torch.randperm(nb - 1, generator=gen)[:sum(pages)] + 1
+    table = torch.zeros((len(lens), max(max(pages), 1)), dtype=torch.int32)
+    ks, vs, sm = [], [], []
+    o = 0
+    for i, n in enumerate(lens):
+        table[i, :pages[i]] = perm[o:o + pages[i]]
+        o += pages[i]
+        k = torch.randn((n, HKV_EXP, D), generator=gen) * 2
+        k[:, :, 5] += 9.0                                                       # one large one-signed channel (pre-rotation habit of K)
+        ks.append(k)
+        vs.append(torch.randn((n, HKV_EXP, D), generator=gen))
+        pos = torch.arange(n)
+        sm.append(table[i, pos // PAGE].long() * PAGE + pos % PAGE)
+    kr = torch.cat(ks).to(device)
+    vr = torch.cat(vs).to(device)
+    cu = torch.tensor([0] + lens).cumsum(0).to(torch.int32).to(device)
+    seq = torch.tensor(lens, dtype=torch.int32, device=device)
+    set_rows(torch.tensor(slots, dtype=torch.int32), [s for s in slots if s >= 0])
+    write(kr, vr, torch.cat(sm).to(device), c8, c16, win, cu, seq)
+    return ks, vs, table.to(device)
+
+
+def _ref_attn(q, k, v, scale):
+    """q [HQ, D], k / v [n, HKV, D] fp32 -> [HQ, D]"""
+    kk = k.repeat_interleave(QPK, 1)
+    vv = v.repeat_interleave(QPK, 1)
+    sc = torch.einsum("hd,nhd->hn", q, kk) * scale
+    return torch.einsum("hn,nhd->hd", sc.softmax(-1), vv)
+
+
+def _win_ref(x):
+    s = (x.abs().amax(-1, keepdim=True) / 127.0).clamp_min(1e-8)
+    return torch.floor(x / s + 0.5).clamp(-127, 127) * s
+
+
+def self_check(device) -> dict:
+    """Errors of the int4 path vs torch references (write codes, rotation, decode with / without window, prefill)."""
+    from types import SimpleNamespace
