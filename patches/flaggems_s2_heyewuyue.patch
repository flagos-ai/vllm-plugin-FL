+def native_window(device):
+    """E111 production factory; explicit Window(False) remains the control."""
+    global _NATIVE_WINDOW_LOGGED
+    win=Window(device,native=True,split_meta=True)
+    win.native_layout='token'
+    win.native_write_style='inline'
+    win.native_fast_window=True
+    win.native_cta_fusion=True
+    win.native_skip_empty=True
+    if not _NATIVE_WINDOW_LOGGED:
+        _NATIVE_WINDOW_LOGGED=True
+        logger.warning('E111 token-contiguous native window active: same4325376B in4MiB+128KiB, inline writer, swizzled CTA cold/hot merge+inverse, quarter-CTA fallback')
+    return win
