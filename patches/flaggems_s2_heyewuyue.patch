@@ -0,0 +1,621 @@
+"""3-stage observation-window pyramid page pruning for long prefill (E466).
+
+Stages aligned with crosslayer.py anchors (0,1,2,3,4,11,20,28,40,41):
+  Stage 0: layers  0..10 (100% pages)
+  Stage 1: layers 11..19 ( 50% pages, min 28 pages)
+  Stage 2: layers 20..27 ( 25% pages, min 28 pages)
+  Stage 3: layers 28..41 (12.5% pages, min 28 pages — moves dense L28 into 12.5% stage)
+
+Triggers purely on physical preconditions (history_pages == 0, whole prompt, qlen >= 1024),
+independent of enable_prefix_caching.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Optional
+
+import os
+import torch
+_THROUGHPUT_PROFILE = os.environ.get('FLAGOS_CARD_A_PROFILE', 'balanced').strip().lower() == 'throughput'
+import triton
+import triton.language as tl
+
+from .logging_utils import get_logger
+
+logger = get_logger(__name__)
+
+PAGE = 16
+SINK_PAGES = 4       # 64 tokens
+TAIL_PAGES = 16      # 256 tokens (covers observation window + prompt tail)
+OBS_WINDOW = 256     # last 256 tokens cover full abstract + question
+MIN_KEPT_PAGES = SINK_PAGES + TAIL_PAGES + 8  # 28 pages = 448 tokens
+MIN_PROMPT_TOKENS = 1024
+
+STAGES = (
+    (10, 0.35),
+    (19, 0.18),
+    (27, 0.09),
+) if _THROUGHPUT_PROFILE else (
+    (10, 0.50),
+    (19, 0.25),
+    (27, 0.125),
+)
+PRUNE_LAYERS = {layer: (idx + 1, frac) for idx, (layer, frac) in enumerate(STAGES)}
+NUM_PRUNE_STAGES = len(STAGES)  # 3 pruned stages (1..3)
+NUM_STAGES = NUM_PRUNE_STAGES + 1  # 4 total stages (0..3)
+
+_LOGGED: set[str] = set()
+
+
+def _once(key: str, msg: str, *args) -> None:
+    if key not in _LOGGED:
+        _LOGGED.add(key)
+        logger.warning(msg, *args)
+
+
+def stage_of_layer(li: Optional[int]) -> int:
+    if li is None or li <= 10:
+        return 0
+    if li <= 19:
+        return 1
+    if li <= 27:
+        return 2
+    return 3
+
+
+@triton.jit
+def _build_stage_tables_kernel(
+    SEQ_IN,
+    TBL_IN,
+    DROP_PAGES,
+    KEPT_FULL,
+    SEQ_OUT,
+    TBL_OUT,
+    n_rows,
+    n_cols,
+    s_in,
+    s_out,
+    s_meta,
+    BLOCK_C: tl.constexpr,
+):
+    stage = tl.program_id(0)   # 0, 1, 2 -> stages 1, 2, 3
+    row = tl.program_id(1)
+    col_blk = tl.program_id(2)
+    if row >= n_rows:
+        return
+    meta_off = stage * s_meta + row
+    drop = tl.load(DROP_PAGES + meta_off)
+    kf = tl.load(KEPT_FULL + meta_off)
+    if col_blk == 0:
+        orig_seq = tl.load(SEQ_IN + row)
+        new_seq = tl.maximum(orig_seq - drop * 16, 0)
+        tl.store(SEQ_OUT + stage * s_meta + row, new_seq)
+    cols = col_blk * BLOCK_C + tl.arange(0, BLOCK_C)
+    mask = cols < n_cols
+    src_cols = tl.where((drop == 0) | (cols < kf), cols, cols + drop)
+    in_mask = mask & (src_cols < s_in)
+    vals = tl.load(TBL_IN + row.to(tl.int64) * s_in + src_cols, mask=in_mask, other=0)
+    tl.store(
+        TBL_OUT + (stage.to(tl.int64) * s_meta + row.to(tl.int64)) * s_out + cols,
+        vals,
+        mask=mask,
+    )
+
+
+class PyramidDecodeState:
+    """Static GPU buffers for stage 1..3 decode seq_lens and block_tables (CUDA Graph safe)."""
+
+    def __init__(self, device: torch.device, max_reqs: int, max_blocks: int):
+        self.device = device
+        self.max_reqs = int(max_reqs)
+        self.max_blocks = int(max_blocks)
+        self.seq_lens = torch.zeros(
+            (NUM_PRUNE_STAGES, self.max_reqs), dtype=torch.int32, device=device
+        )
+        self.block_tables = torch.zeros(
+            (NUM_PRUNE_STAGES, self.max_reqs, self.max_blocks), dtype=torch.int32, device=device
+        )
+        self.drop_gpu = torch.zeros(
+            (NUM_PRUNE_STAGES, self.max_reqs), dtype=torch.int32, device=device
+        )
+        self.kept_gpu = torch.zeros(
+            (NUM_PRUNE_STAGES, self.max_reqs), dtype=torch.int32, device=device
+        )
+        self.drop_cpu = torch.zeros(
+            (NUM_PRUNE_STAGES, self.max_reqs), dtype=torch.int32, pin_memory=True
+        )
+        self.kept_cpu = torch.zeros(
+            (NUM_PRUNE_STAGES, self.max_reqs), dtype=torch.int32, pin_memory=True
+        )
+        self._drop_np = self.drop_cpu.numpy()
+        self._kept_np = self.kept_cpu.numpy()
+        self._last_sig = None
+        self._last_has_pruned = False
+        self.active = False
+
+    def sync(
+        self,
+        seq_in: torch.Tensor,
+        tbl_in: torch.Tensor,
+        drop_rows: list[tuple[int, int, int]],
+        kept_rows: list[tuple[int, int, int]],
+        max_copy_cols: int,
+        sig=None,
+    ) -> None:
+        n_rows = int(seq_in.shape[0])
+        if n_rows == 0 or n_rows > self.max_reqs:
+            return
+        n_cols = min(int(tbl_in.shape[1]), self.max_blocks, max(1, int(max_copy_cols)))
+        if sig is None or sig != self._last_sig:
+            has_pruned = False
+            d_np = self._drop_np
+            k_np = self._kept_np
+            d_np[:, :n_rows] = 0
+            k_np[:, :n_rows] = 0
+            n_fill = min(n_rows, len(drop_rows))
+            for r in range(n_fill):
+                dr = drop_rows[r]
+                if dr[0] or dr[1] or dr[2]:
+                    has_pruned = True
+                    kr = kept_rows[r]
+                    d_np[0, r] = dr[0]
+                    d_np[1, r] = dr[1]
+                    d_np[2, r] = dr[2]
+                    k_np[0, r] = kr[0]
+                    k_np[1, r] = kr[1]
+                    k_np[2, r] = kr[2]
+            self.drop_gpu[:, :n_rows].copy_(self.drop_cpu[:, :n_rows], non_blocking=True)
+            self.kept_gpu[:, :n_rows].copy_(self.kept_cpu[:, :n_rows], non_blocking=True)
+            self._last_sig = sig
+            self._last_has_pruned = has_pruned
+        else:
+            has_pruned = self._last_has_pruned
+        grid = (NUM_PRUNE_STAGES, n_rows, triton.cdiv(n_cols, 128))
+        _build_stage_tables_kernel[grid](
+            seq_in,
+            tbl_in,
+            self.drop_gpu,
+            self.kept_gpu,
+            self.seq_lens,
+            self.block_tables,
+            n_rows,
+            n_cols,
+            tbl_in.stride(0),
+            self.max_blocks,
+            self.max_reqs,
+            BLOCK_C=128,
+            num_warps=4,
+        )
+        self.active = True
+        if has_pruned:
+            _once(
+                "decode_tables",
+                "E470 pyramid3 decode tables active stages=%d rows=%d cols=%d",
+                NUM_PRUNE_STAGES,
+                n_rows,
+                n_cols,
+            )
+
+    def get_stage_views(
+        self, stage: int, n_rows: int, n_cols: int
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        s = stage - 1
+        return self.seq_lens[s, :n_rows], self.block_tables[s, :n_rows, :n_cols]
+
+
+_DECODE_STATE: Optional[PyramidDecodeState] = None
+
+
+def get_decode_state() -> Optional[PyramidDecodeState]:
+    return _DECODE_STATE
+
+
+def ensure_decode_state(
+    device: torch.device, max_reqs: int, max_blocks: int
+) -> PyramidDecodeState:
+    global _DECODE_STATE
+    if (
+        _DECODE_STATE is None
+        or _DECODE_STATE.device != device
+        or _DECODE_STATE.max_reqs < max_reqs
+        or _DECODE_STATE.max_blocks < max_blocks
+    ):
+        _DECODE_STATE = PyramidDecodeState(device, max_reqs, max_blocks)
+    return _DECODE_STATE
+
+
+@dataclass
+class PrefillCapture:
+    target_layer: int
+    cu_q_cpu: list[int]
+    orig_full_pages: list[int]
+    orig_rem: list[int]
+    target_frac: float
+    vote_layers: tuple[int, ...] = ()
+    accum_scores: Optional[list[Optional[torch.Tensor]]] = None
+    kept_token_idx: Optional[torch.Tensor] = None
+    new_qlen: Optional[list[int]] = None
+    new_full_pages: Optional[list[int]] = None
+    drop_pages: Optional[list[int]] = None
+
+
+_ACTIVE_CAPTURE: Optional[PrefillCapture] = None
+
+
+def set_active_capture(cap: Optional[PrefillCapture]) -> None:
+    global _ACTIVE_CAPTURE
+    _ACTIVE_CAPTURE = cap
+
+
+def get_active_capture() -> Optional[PrefillCapture]:
+    return _ACTIVE_CAPTURE
+
+
+_LOG2E_OBS = 1.4426950408889634
+
+
+@triton.jit
+def _obs_from_lse_kernel(
+    Q, KW, LSE, PARTIAL,
+    s0, qlen, off, lse_seq,
+    sq_t, sq_h, sk_h, sp_h, sp_b,
+    scale_log2,
+    QPK: tl.constexpr, OBS_WIN: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, D: tl.constexpr,
+):
+    """1-pass OBS scorer reusing LSE exported by _dense_tail_lse_kernel + direct [D, BN] KW load (zero Pass 1, zero Q copy!)."""
+    hq = tl.program_id(0)
+    pm = tl.program_id(1)
+    hkv = hq // QPK
+    obs_start = qlen - OBS_WIN
+    rm = pm * BM + tl.arange(0, BM)
+    q_pos = obs_start + rm
+    rd = tl.arange(0, D)
+    q = tl.load(Q + (s0 + q_pos[:, None]) * sq_t + hq * sq_h + rd[None, :])
+    lse = tl.load(LSE + (lse_seq * 16 + hq) * OBS_WIN + rm)
+
+    k_base = KW + hkv.to(tl.int64) * sk_h + off.to(tl.int64) * D
+    out_base = PARTIAL + hq.to(tl.int64) * sp_h + pm.to(tl.int64) * sp_b
+    rn0 = tl.arange(0, BN)
+    for n0 in range(0, qlen, BN):
+        rn = n0 + rn0
+        n_mask = rn < qlen
+        k = tl.load(k_base + rn[None, :] * D + rd[:, None], mask=n_mask[None, :], other=0)
+        sc = tl.dot(q, k) * scale_log2
+        valid = n_mask[None, :] & (rn[None, :] <= q_pos[:, None])
+        p = tl.where(valid, tl.exp2(sc - lse[:, None]), 0.0)
+        col_sum = tl.sum(p, axis=0)
+        tl.store(out_base + rn.to(tl.int64), col_sum, mask=n_mask)
+
+
+@triton.jit
+def _obs_fused_score_kernel(
+    Q, K, PARTIAL,
+    N,
+    sq_h, sq_m, sq_d,
+    sk_h, sk_n, sk_d,
+    sp_h, sp_b, sp_n,
+    scale,
+    QPK: tl.constexpr,
+    OBS_WIN: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    D: tl.constexpr,
+):
+    hq = tl.program_id(0)
+    pm = tl.program_id(1)
+    hkv = hq // QPK
+    rm = pm * BM + tl.arange(0, BM)
+    rd = tl.arange(0, D)
+    q = tl.load(Q + hq * sq_h + rm[:, None].to(tl.int64) * sq_m + rd[None, :] * sq_d).to(tl.bfloat16)
+    q_pos = (N - OBS_WIN) + rm
+
+    m_i = tl.full((BM,), -1e9, dtype=tl.float32)
+    l_i = tl.zeros((BM,), dtype=tl.float32)
+    for n0 in range(0, N, BN):
+        rn = n0 + tl.arange(0, BN)
+        n_mask = rn < N
+        k = tl.load(
+            K + hkv * sk_h + rn[None, :].to(tl.int64) * sk_n + rd[:, None] * sk_d,
+            mask=n_mask[None, :],
+            other=0.0,
+        ).to(tl.bfloat16)
+        s = tl.dot(q, k, out_dtype=tl.float32) * scale
+        valid = n_mask[None, :] & (rn[None, :] <= q_pos[:, None])
+        s = tl.where(valid, s, -1e9)
+        m_ij = tl.max(s, axis=1)
+        m_new = tl.maximum(m_i, m_ij)
+        alpha = tl.exp(m_i - m_new)
+        p = tl.where(valid, tl.exp(s - m_new[:, None]), 0.0)
+        l_i = l_i * alpha + tl.sum(p, axis=1)
+        m_i = m_new
+
+    inv_l = 1.0 / tl.maximum(l_i, 1e-12)
+    out_base = PARTIAL + hq.to(tl.int64) * sp_h + pm.to(tl.int64) * sp_b
+    for n0 in range(0, N, BN):
+        rn = n0 + tl.arange(0, BN)
+        n_mask = rn < N
+        k = tl.load(
+            K + hkv * sk_h + rn[None, :].to(tl.int64) * sk_n + rd[:, None] * sk_d,
+            mask=n_mask[None, :],
+            other=0.0,
+        ).to(tl.bfloat16)
+        s = tl.dot(q, k, out_dtype=tl.float32) * scale
+        valid = n_mask[None, :] & (rn[None, :] <= q_pos[:, None])
+        p = tl.where(valid, tl.exp(s - m_i[:, None]) * inv_l[:, None], 0.0)
+        col_sum = tl.sum(p, axis=0)
+        tl.store(out_base + rn.to(tl.int64) * sp_n, col_sum, mask=n_mask)
+
+
+@triton.jit
+def _gather_2x_bf16_kernel(
+    H, R, POS, IDX,
+    HO, RO, PO,
+    M_out, D: tl.constexpr,
+    sh_in, sr_in, sh_out, sr_out,
+):
+    row = tl.program_id(0)
+    if row >= M_out:
+        return
+    src = tl.load(IDX + row).to(tl.int64)
+    tl.store(PO + row, tl.load(POS + src))
+    offs = tl.arange(0, D)
+    h = tl.load(H + src * sh_in + offs)
+    r = tl.load(R + src * sr_in + offs)
+    tl.store(HO + row.to(tl.int64) * sh_out + offs, h)
+    tl.store(RO + row.to(tl.int64) * sr_out + offs, r)
+
+
+def fast_gather_2x_bf16(
+    h: torch.Tensor, r: torch.Tensor, pos: torch.Tensor, idx: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    M_out = int(idx.shape[0])
+    D = int(h.shape[1])
+    h_out = torch.empty((M_out, D), dtype=h.dtype, device=h.device)
+    r_out = torch.empty((M_out, D), dtype=r.dtype, device=r.device)
+    p_out = torch.empty((M_out,), dtype=pos.dtype, device=pos.device)
+    _gather_2x_bf16_kernel[(M_out,)](
+        h, r, pos, idx, h_out, r_out, p_out,
+        M_out, D=D,
+        sh_in=h.stride(0), sr_in=r.stride(0),
+        sh_out=h_out.stride(0), sr_out=r_out.stride(0),
+        num_warps=4,
+    )
+    return h_out, r_out, p_out
+
+
+@torch.inference_mode()
+def capture_and_select(
+    cap: PrefillCapture,
+    qr: torch.Tensor,
+    kr: torch.Tensor,
+    scale: float,
+    plan=None,
+    commit: bool = True,
+    layer: int | None = None,
+) -> None:
+    """Smart page scoring: 1-pass LSE-reusing OBS scorer + OBS=256 + per-head norm sum + multi-layer voting + [0.5,1,0.5] smoothing."""
+    device = qr.device
+    d = 128
+    qr_3d = qr.reshape(qr.shape[0], -1, d)
+    kr_3d = kr.reshape(kr.shape[0], -1, d)
+    hq = qr_3d.shape[1]
+    hkv = kr_3d.shape[1]
+    qpk = hq // hkv
+    n_seq = len(cap.cu_q_cpu) - 1
+    if cap.accum_scores is None:
+        cap.accum_scores = [None] * n_seq
+
+    kept_chunks: list[torch.Tensor] = []
+    new_qlen: list[int] = []
+    new_full_pages: list[int] = []
+    drop_pages: list[int] = []
+
+    cp_lse = getattr(plan, "cp_lse", None) if plan is not None else None
+    lse_valid = cp_lse is not None and layer is not None and cp_lse[0] == layer and plan.kw.dtype == torch.bfloat16
+    if lse_valid:
+        _, lse_buf, seq_map, wso_map = cp_lse
+    else:
+        lse_buf, seq_map, wso_map = None, {}, {}
+
+    use_kw = (
+        plan is not None
+        and getattr(plan, "direct_rows", 0) >= cap.cu_q_cpu[-1]
+        and plan.kw.dtype == torch.bfloat16
+    )
+
+    for i in range(n_seq):
+        s0 = cap.cu_q_cpu[i]
+        s1 = cap.cu_q_cpu[i + 1]
+        cur_len = s1 - s0
+        rem = cap.orig_rem[i]
+        cur_full_pages = (cur_len - rem) // PAGE
+        assert cur_full_pages * PAGE + rem == cur_len, (cur_len, rem)
+
+        orig_fp = cap.orig_full_pages[i]
+        target_fp = max(MIN_KEPT_PAGES, int(round(orig_fp * cap.target_frac)))
+        if target_fp >= cur_full_pages:
+            if commit:
+                kept_chunks.append(torch.arange(s0, s1, dtype=torch.long, device=device))
+                new_qlen.append(cur_len)
+                new_full_pages.append(cur_full_pages)
+                drop_pages.append(orig_fp - cur_full_pages)
+            continue
+
+        obs_w = OBS_WINDOW if cur_len >= OBS_WINDOW else 128
+        if (
+            lse_valid
+            and obs_w == OBS_WINDOW
+            and i in seq_map
+            and wso_map[i][0] == s0
+            and wso_map[i][1] == cur_len
+        ):
+            bm = 64
+            n_pm = obs_w // bm
+            partial = torch.empty((hq, n_pm, cur_len), dtype=torch.float32, device=device)
+            _obs_from_lse_kernel[(hq, n_pm)](
+                qr_3d, plan.kw, lse_buf, partial,
+                s0, cur_len, wso_map[i][2], seq_map[i],
+                qr_3d.stride(0), qr_3d.stride(1), plan.kw.stride(0),
+                partial.stride(0), partial.stride(1),
+                scale * _LOG2E_OBS, QPK=qpk, OBS_WIN=obs_w, BM=bm, BN=64, D=128,
+                num_warps=4, num_stages=1,
+            )
+            head_tok_scores = partial.sum(dim=1)
+            _once("obs_1pass_lse", "E489 1-pass LSE-reusing OBS scorer active (BM=64, BN=64, zero Q copy)")
+        else:
+            bm = 32
+            n_pm = obs_w // bm
+            q_obs = qr_3d[s1 - obs_w : s1].transpose(0, 1).contiguous()
+            if use_kw:
+                k_seq = plan.kw[:, s0:s1, :]
+            else:
+                k_seq = kr_3d[s0:s1].to(torch.bfloat16).transpose(0, 1).contiguous()
+            partial = torch.empty((hq, n_pm, cur_len), dtype=torch.float32, device=device)
+            _obs_fused_score_kernel[(hq, n_pm)](
+                q_obs, k_seq, partial,
+                cur_len,
+                q_obs.stride(0), q_obs.stride(1), q_obs.stride(2),
+                k_seq.stride(0), k_seq.stride(1), k_seq.stride(2),
+                partial.stride(0), partial.stride(1), partial.stride(2),
+                scale, QPK=qpk, OBS_WIN=obs_w, BM=bm, BN=64, D=128,
+                num_warps=4, num_stages=1,
+            )
+            head_tok_scores = partial.sum(dim=1)
+            _once("obs_fallback", "E488 2-pass fallback OBS scorer active")
+        _once("obs_smart", "E489 smart page pruning active (obs=%d, norm_head_sum, multi_layer_vote, neighbor_smooth)", obs_w)
+
+        tail_full_start = cur_full_pages - TAIL_PAGES
+        h_pg = head_tok_scores[:, : cur_full_pages * PAGE].view(hq, cur_full_pages, PAGE).amax(dim=2)
+        h_mid_max = h_pg[:, SINK_PAGES:tail_full_start].amax(dim=1, keepdim=True).clamp(min=1e-6)
+        _norm = h_pg / h_mid_max
+        pg_sc = _norm.sum(dim=0) if _THROUGHPUT_PROFILE else (_norm.sum(dim=0) + 1.0 * _norm.amax(dim=0))
+
+        if cap.accum_scores[i] is None:
+            cap.accum_scores[i] = pg_sc
+        else:
+            cap.accum_scores[i] = cap.accum_scores[i] + pg_sc
+
+        if not commit:
+            continue
+
+        full_scores = cap.accum_scores[i]
+        k_mid = target_fp - SINK_PAGES - TAIL_PAGES
+        assert tail_full_start > SINK_PAGES and k_mid > 0
+        mid_raw = full_scores[SINK_PAGES:tail_full_start]
+        if mid_raw.numel() >= 3:
+            mid_scores = mid_raw.clone()
+            mid_scores[1:] += 0.5 * mid_raw[:-1]
+            mid_scores[:-1] += 0.5 * mid_raw[1:]
+        else:
+            mid_scores = mid_raw
+        top_rel = torch.argsort(mid_scores, descending=True)[:k_mid]
+        top_mid = (top_rel + SINK_PAGES).sort().values
+
+        kept_pages = torch.cat(
+            [
+                torch.arange(0, SINK_PAGES, device=device),
+                top_mid,
+                torch.arange(tail_full_start, cur_full_pages, device=device),
+            ]
+        )
+        offsets = torch.arange(PAGE, device=device)
+        tok_idx = (kept_pages[:, None] * PAGE + offsets[None, :]).reshape(-1) + s0
+        if rem > 0:
+            rem_idx = torch.arange(s1 - rem, s1, dtype=torch.long, device=device)
+            tok_idx = torch.cat([tok_idx, rem_idx], dim=0)
+
+        kept_chunks.append(tok_idx)
+        new_qlen.append(int(tok_idx.numel()))
+        new_full_pages.append(int(kept_pages.numel()))
+        drop_pages.append(orig_fp - int(kept_pages.numel()))
+
+    if plan is not None and hasattr(plan, "cp_lse"):
+        plan.cp_lse = None
+
+    if commit:
+        cap.kept_token_idx = torch.cat(kept_chunks, dim=0)
+        cap.new_qlen = new_qlen
+        cap.new_full_pages = new_full_pages
+        cap.drop_pages = drop_pages
+
+def build_stage_slot_mapping(
+    block_table_gpu: torch.Tensor,
+    req_indices: list[int],
+    new_full_pages: list[int],
+    orig_full_pages: list[int],
+    orig_rem: list[int],
+) -> torch.Tensor:
+    device = block_table_gpu.device
+    offsets = torch.arange(PAGE, dtype=torch.int64, device=device)
+    chunks: list[torch.Tensor] = []
+    for req_idx, kf, orig_fp, rem in zip(
+        req_indices, new_full_pages, orig_full_pages, orig_rem
+    ):
+        blks = block_table_gpu[req_idx, :kf].to(torch.int64)
+        slots = (blks[:, None] * PAGE + offsets[None, :]).reshape(-1)
+        chunks.append(slots)
+        if rem > 0:
+            last_blk = block_table_gpu[req_idx, orig_fp].to(torch.int64)
+            chunks.append(last_blk * PAGE + torch.arange(rem, dtype=torch.int64, device=device))
+    return torch.cat(chunks, dim=0)
+
+
+def build_stage_plan(
+    base_plan,
+    cu_gpu: torch.Tensor,
+    qlen_list: list[int],
+    stage_idx: int,
+    device: torch.device,
+):
+    from . import attention as A
+
+    n_p = len(qlen_list)
+    pidx, cb, wso = [], [], []
+    blocks = tok = max_pages = 0
+    cu_vals = [0]
+    for i, ql in enumerate(qlen_list):
+        pidx.append(i)
+        cb.append(blocks)
+        wso.append(tok)
+        blocks += -(-ql // A._PF_BLOCK_Q)
+        pages = -(-ql // PAGE)
+        tok += pages * PAGE
+        max_pages = max(max_pages, pages)
+        cu_vals.append(cu_vals[-1] + ql)
+
+    prefill_t = 128 if max(qlen_list, default=0) >= 2048 else 256
+    kw = base_plan.kw
+    vw = base_plan.vw
+    A._zero_tail_kernel[(kw.shape[0],)](
+        kw, vw, kw, tok, kw.stride(0), 0, N=2 * A._PF_T, D=kw.shape[2], HAS_KS=False, num_warps=4
+    )
+    idx = torch.tensor([pidx, cb, wso], dtype=torch.int32).to(device, non_blocking=True)
+    prefill_desc = tuple((i, qlen_list[i], wso[i]) for i in range(n_p))
+    causal_shapes = []
+    for i, ql, off in prefill_desc:
+        if ql >= 2048:
+            causal_shapes.append((i, (cu_vals[i], ql, 0, off)))
+    direct_rows = 0
+    if all(cu_vals[i] == wso[i] for i in range(n_p)):
+        direct_rows = sum(qlen_list)
+
+    return A.StepPlan(
+        history_pages=0,
+        direct_rows=direct_rows,
+        cu=cu_gpu,
+        n_decode=0,
+        n_p=n_p,
+        pidx=idx[0],
+        cb=idx[1],
+        wso=idx[2],
+        total_blocks=blocks,
+        max_pages=max_pages,
+        kw=kw,
+        vw=vw,
+        ksw=None,
+        pair_shapes=(),
+        causal_shapes=tuple(causal_shapes),
+        pair_capacity=0,
+        prefill_desc=prefill_desc,
+        prefill_t=prefill_t,
+    )
