+    wpg=(WPG+z).to(tl.uint64);wtab=(WTAB+row*8+z).to(tl.uint64)
+    qp=(Q+row*16*128+z).to(tl.uint64)
+    qk=(z.to(tl.float32)+128**-.5*1.4426950408889634*16777216.).to(tl.int32,bitcast=True)
+    code:tl.constexpr=_REG2_ASM if V2 else _REG_ASM
+    values_out=tl.inline_asm_elementwise(code,_CTA_CONS,
+        [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+lo,z+hi,z+16,z+count,z,z,z,z,z,z,qk,lane,
+         _lo32(qp),_hi32(qp),(lane&15)*256,_lo32(wpg),_hi32(wpg),_lo32(wtab),_hi32(wtab),z+sp*2,z+(sp+1)*2],
+        dtype=(tl.float32,)*140+(tl.int32,)*54,is_pure=False,pack=1)
+    m=tl.max(tl.reshape(values_out[105],(4,4,16)),axis=1)
+    l=tl.max(tl.reshape(values_out[104],(4,4,16)),axis=1)
+    mx=tl.max(m,axis=0);mx=tl.where(mx>float('-inf'),mx,0.)
+    weights=tl.exp2(m-mx[None,:]);denom=tl.sum(l*weights,axis=0)
+    denom=tl.where(denom>0.,denom,1.)
+    # Quarter-buffer native word planes: contiguous lane words, not head-major
+    # rows. Reuse8KiB across four phases, keeping all finalized O in registers.
+    buf=tleg.alloc((2048,),tl.float32,scope=tleg.smem,nv_mma_shared_layout=False)
+    ptr=tleg.local_ptr(buf,(0,))
+    ds=tl.arange(0,32);hs=tl.arange(0,16);ss=tl.arange(0,4)
+    reg=2*(ds%4)+ds//16
+    native_lane=hs[:,None]+16*((ds[None,:]//4)%4)
+    read_offset=ss[:,None,None]*512+reg[None,None,:]*64+native_lane[None,:,:]
+    x0=_quarter_merge(values_out,ptr,sp,lane,read_offset,weights,denom,QUARTER=0)
+    x1=_quarter_merge(values_out,ptr,sp,lane,read_offset,weights,denom,QUARTER=1)
+    x2=_quarter_merge(values_out,ptr,sp,lane,read_offset,weights,denom,QUARTER=2)
+    x3=_quarter_merge(values_out,ptr,sp,lane,read_offset,weights,denom,QUARTER=3)
+    a=x0+x1;b=x0-x1
+    c=x2+x3;d=x2-x3
+    final=(a+c,b+d,a-c,b-d)
+    for quarter in tl.static_range(4):
+        dim=quarter*32+ds
+        y=final[quarter]*(128**-.5)*tl.load(SIGN+dim)[None,:]
+        tl.store(O+row*16*128+hs[:,None]*128+dim[None,:],y.to(tl.bfloat16))
+
+
+@triton.jit
+def cta_recipient(Q,PG,TAB,COUNTS,WPG,WTAB,O,SIGN,B:tl.constexpr,S:tl.constexpr,STRIDE:tl.constexpr,V2:tl.constexpr=False):
+    row=tl.program_id(0)
+    tid=tl.arange(0,256);sp=tid//64;lane=tid%64;z=tid*0
+    count=tl.load(COUNTS+row)
+    per=tl.cdiv(count,S);lo=sp*per;hi=tl.minimum(lo+per,count)
+    buf=tleg.alloc((4,16,128),tl.float32,scope=tleg.smem,nv_mma_shared_layout=False)
+    ptr=tleg.local_ptr(buf,(0,0,0))
+    tl.store(ptr,0.)
+    tl.debug_barrier()
+    po=(ptr.to(tl.uint64)+sp.to(tl.uint64)*8192)
+    pg=(PG+z).to(tl.uint64);tab=(TAB+row*STRIDE+z).to(tl.uint64)
+    wpg=(WPG+z).to(tl.uint64);wtab=(WTAB+row*8+z).to(tl.uint64)
+    qp=(Q+row*16*128+z).to(tl.uint64)
+    qk=(z.to(tl.float32)+128**-.5*1.4426950408889634*16777216.).to(tl.int32,bitcast=True)
+    code:tl.constexpr=_CTA2_ASM if V2 else _CTA_ASM
+    values_out=tl.inline_asm_elementwise(code,_CTA_CONS,
+        [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+lo,z+hi,z+16,z+count,
+         _lo32(po),_hi32(po),z,z,z,z,qk,lane,_lo32(qp),_hi32(qp),(lane&15)*256,
+         _lo32(wpg),_hi32(wpg),_lo32(wtab),_hi32(wtab),z+sp*2,z+(sp+1)*2],
+        dtype=(tl.float32,)*140+(tl.int32,)*54,is_pure=False,pack=1)
+    mm=values_out[105]
+    ll=values_out[104]
+    tl.debug_barrier()
+    m=tl.max(tl.reshape(mm,(4,4,16)),axis=1)
+    l=tl.max(tl.reshape(ll,(4,4,16)),axis=1)
+    mx=tl.max(m,axis=0)
+    weights=tl.exp2(m-mx[None,:])
+    denom=tl.sum(l*weights,axis=0)
+    values=tl.load(tleg.local_ptr(buf))
+    x=tl.sum(values*weights[:,:,None],axis=0)/denom[:,None]
+    d=tl.arange(0,128)
+    for bit in tl.static_range(7):
+        index=tl.broadcast_to((d^(1<<bit))[None,:],(16,128))
+        partner=tl.gather(x,index,axis=1)
+        x=tl.where((d[None,:]&(1<<bit))==0,x+partner,partner-x)
+    y=x*(128**-.5)*tl.load(SIGN+d)[None,:]
+    head=tl.arange(0,16)
+    tl.store(O+row*16*128+head[:,None]*128+d[None,:],y.to(tl.bfloat16))
+
+
+@triton.jit
+def fused_recipient(Q,PG,TAB,COUNTS,WPG,WTAB,PO,PM,PL,B:tl.constexpr,S:tl.constexpr,STRIDE:tl.constexpr,V2:tl.constexpr=False):
+    row=tl.program_id(0)
+    sp=tl.program_id(1)
+    count=tl.load(COUNTS+row)
+    per=tl.cdiv(count,S)
+    lo=sp*per
+    hi=tl.minimum(lo+per,count)
+    lane=tl.arange(0,64);z=lane*0
+    pg=(PG+z).to(tl.uint64);tab=(TAB+row*STRIDE+z).to(tl.uint64)
+    wpg=(WPG+z).to(tl.uint64);wtab=(WTAB+row*8+z).to(tl.uint64)
+    po=(PO+(row*S+sp)*16*128+z).to(tl.uint64)
+    pm=(PM+(row*S+sp)*16+z).to(tl.uint64);pl=(PL+(row*S+sp)*16+z).to(tl.uint64)
+    qp=(Q+row*16*128+z).to(tl.uint64)
+    qk=(z.to(tl.float32)+128**-.5*1.4426950408889634*16777216.).to(tl.int32,bitcast=True)
+    code:tl.constexpr=_FUSED2_ASM if V2 else _FUSED_ASM
+    x,y=tl.inline_asm_elementwise(code,_FUSED_CONS,
+        [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+lo,z+hi,z+16,z+count,
+         _lo32(po),_hi32(po),_lo32(pm),_hi32(pm),_lo32(pl),_hi32(pl),qk,lane,
+         _lo32(qp),_hi32(qp),(lane&15)*256,
+         _lo32(wpg),_hi32(wpg),_lo32(wtab),_hi32(wtab),z+sp*(8//S),z+(sp+1)*(8//S)],
+        dtype=(tl.int32,tl.int32),is_pure=False,pack=1)
+
+
+@triton.jit
+def pack_window(WK, WV, KS, VS, PG, B: tl.constexpr,TOKEN:tl.constexpr=False,SPLIT_META:tl.constexpr=False,META=None):
+    row=tl.program_id(0)
+    page=tl.program_id(1)
+    h=tl.program_id(2)
+    t=tl.arange(0,16)
+    e=tl.arange(0,32)
+    src=((row*128+page*16+t[:,None])*2+h)*32+e[None,:]
+    kw=tl.load(WK+src).to(tl.uint32)^0x80808080
+    vw=tl.load(WV+src).to(tl.uint32)^0x80808080
+    base=PG+(row*8+page)*(2048 if SPLIT_META else 2112)
+    if TOKEN:
+        tl.store(base+t[:,None]*64+h*32+e[None,:],kw)
+        tl.store(base+1024+t[:,None]*64+h*32+e[None,:],vw)
+    else:
+        tl.store(base+_hw_k(h,e[None,:],t[:,None]),kw)
+        tl.store(base+_hw_v(h,e[None,:],t[:,None]),vw)
+    meta=(row*128+page*16+t)*2+h
+    if SPLIT_META:header=(META+(row*8+page)*64).to(tl.pointer_type(tl.int32))
+    else:header=base+2048
+    tl.store(header+h*16+t,tl.load(KS+meta).to(tl.uint32,bitcast=True))
+    tl.store(header+32+h*16+t,tl.load(VS+meta).to(tl.uint32,bitcast=True))
+
+
+@triton.jit
+def window_kernel(Q, PG, TAB, PO, PM, PL, B:tl.constexpr, S:tl.constexpr):
+    # Initial P0 primitive: all 128 physical ring positions are valid.
+    row=tl.program_id(0)
+    sp=tl.program_id(1)
+    lane=tl.arange(0,64)
+    z=lane*0
+    pg=(PG+z).to(tl.uint64)
+    tab=(TAB+row*8+z).to(tl.uint64)
+    po=(PO+(row*S+sp)*16*128+z).to(tl.uint64)
+    pm=(PM+(row*S+sp)*16+z).to(tl.uint64)
+    pl=(PL+(row*S+sp)*16+z).to(tl.uint64)
+    q=(Q+row*16*128+z).to(tl.uint64)
+    x,y=tl.inline_asm_elementwise(_ASM,_CONS,
+        [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+sp*(8//S),z+(sp+1)*(8//S),
+         z+16,z+8,_lo32(po),_hi32(po),_lo32(pm),_hi32(pm),_lo32(pl),_hi32(pl),
+         (z.to(tl.float32)+128**-.5*1.4426950408889634).to(tl.int32,bitcast=True),lane,_lo32(q),_hi32(q),
+         (lane&15)*256],dtype=(tl.int32,tl.int32),is_pure=False,pack=1)
+
+
+@triton.jit
+def merge_window(PO,PM,PL,OUTO,OUTM,OUTL,B:tl.constexpr,S:tl.constexpr):
+    row=tl.program_id(0)
+    head=tl.program_id(1)
+    sp=tl.arange(0,S)
+    d=tl.arange(0,128)
+    base=(row*S+sp)*16+head
+    mm=tl.load(PM+base)
+    ll=tl.load(PL+base)
+    mx=tl.max(mm,0)
+    weights=tl.exp2(mm-mx)
+    values=tl.load(PO+base[:,None]*128+d[None,:])
+    total=tl.sum(values*weights[:,None],0)
+    den=tl.sum(ll*weights,0)
+    tl.store(OUTO+(row*16+head)*128+d,total)
+    tl.store(OUTM+row*16+head,mx)
+    tl.store(OUTL+row*16+head,den)
