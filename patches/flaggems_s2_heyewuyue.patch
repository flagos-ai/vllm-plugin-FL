+    else:
+        code:tl.constexpr=_TAGGED2_ASM if V2 else _TAGGED_ASM
+    a,b=tl.inline_asm_elementwise(code,_TAGGED_CONS,
+        [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+lo,z+hi,z+cold-(original_npg-1)*16,z+npg,
+         _lo32(po),_hi32(po),_lo32(pm),_hi32(pm),_lo32(pl),_hi32(pl),qk,lane,
+         _lo32(qp),_hi32(qp),(lane&15)*s_q1*2,_lo32(wpg),_hi32(wpg),_lo32(wmeta),_hi32(wmeta),z+sp*2,z+(sp+1)*2,
+         _lo32(tag),_hi32(tag),z+cold,z+length],dtype=(tl.int32,tl.int32),is_pure=False,pack=1)
