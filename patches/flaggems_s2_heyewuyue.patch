+    e("ml_and_b32 v%d, v%d, 0x8" % (T0, LANE))
+    e("ml_shl_b32 v%d, v%d, 0x3" % (T0, T0))
+    e("ml_shl_b32 v%d, v%d, 0x2" % (T1, LG))
