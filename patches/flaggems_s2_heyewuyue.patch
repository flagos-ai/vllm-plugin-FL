+++ b/src/flag_gems/fused/minicpm/attention.py
@@ -0,0 +1,769 @@
+# Copyright (c) 2026 BAAI. All rights reserved.
+
+"""
+Iluvatar attention kernels for vLLM's TRITON_ATTN backend.
+
+vLLM's ``unified_attention`` runs one Triton kernel for every batch. On
+Iluvatar its 2D launch (prefill chunks, mixed steps) reaches ~3 TFLOPS and its
+3D launch (pure decode) ~165 GB/s of the ~690 GB/s the card reads. This module
+replaces both for the configuration we measured (GQA group 8, head size 128,
+bf16/fp16, 16-token pages, causal, no window/softcap/ALiBi/sinks/quantized KV):
+
+* prefill rows (query length > 1): K/V of each prefill sequence are first
+  copied from the paged cache into a contiguous per-step workspace, then one
+  program per (32 query tokens x 8 query heads, KV head) walks the keys with a
+  scalar base pointer and int32 tile offsets, 256 keys per tile, late V load,
+  online softmax in exp2, causal tiles skipped (53-55 TFLOPS on 2048-token
+  chunks with long context, exact at context 0).
+* decode rows (query length 1), in pure decode batches (CUDA graphs) and in
+  mixed steps: split-KV over 16-token pages, one program per (KV head,
+  sequence, split) holding the 8 query heads of that KV head, then a reduce
+  over splits (445-464 GB/s). The split count depends only on the number of
+  decode rows, so captured graphs stay valid on replay.
+
+The per-step plan (which sequences are prefill rows, their workspace offsets)
+is computed once per step from the CPU copies in ``CommonAttentionMetadata``
+inside the metadata builder, so the layers add no host synchronisation.
+Batches outside the measured configuration use vLLM's ``unified_attention``.
+
+Before patching, ``self_check`` runs the kernels once on small synthetic
+batches (decode with each split count, graph padding rows, page edges,
+context-0 and chunked prefill with odd lengths, a mixed step) against an fp32
+reference. If any output is off or not finite, or a kernel fails to compile,
+the patch is not installed and vLLM's kernel runs; this backend has shown
+configuration-specific miscompiles before.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from types import SimpleNamespace
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+from .logging_utils import get_logger
+logger = get_logger(__name__)
+
+_LOG2E = 1.4426950408889634
+_QPK = 8          # query heads per KV head
+_HEAD = 128
+_PAGE = 16        # KV cache block size
+_PF_BLOCK_Q = 32  # query tokens per prefill program (x 8 heads = 256 rows)
+_PF_T = 256       # max tail padding; dynamic T=128 (long) / 256 (short)
+_PF_WARPS = 16
+_PF_QK_INT8 = False  # int8 KV cache: scores from int8 MMAs (q quantised per row, K codes as stored)
+
+
+# --------------------------------------------------------------------------- kernels
+
+
+@triton.jit
+def _ws_copy_kernel(K, V, KS, VS, TABLE, SEQ_LENS, PIDX, WSO, KW, VW, KSW,
+                    s_kb, s_kt, s_kh, s_vb, s_vt, s_vh, s_sb, s_st, s_sh, s_tab, s_wg, s_wk,
+                    HKV: tl.constexpr, D: tl.constexpr, PAGE: tl.constexpr, QUANT: tl.constexpr):
+    """Copy one page of K and V of prefill sequence PIDX[p] into the workspace
+    [HKV, token, D]; tokens past the sequence length are written as zeros. QUANT 1: the pages hold int8
+    codes with one fp32 scale per (token, head) in KS / VS; the workspace gets code * scale. QUANT 2: V as
+    QUANT 1, K stays int8 codes (workspace KW int8) with its scales in KSW [HKV, token] (int8 QK attention)."""
+    p = tl.program_id(0)
+    pg = tl.program_id(1)
+    s = tl.load(PIDX + p)
+    seq_len = tl.load(SEQ_LENS + s)
+    if pg * PAGE >= seq_len:
+        return
+    blk = tl.load(TABLE + s.to(tl.int64) * s_tab + pg).to(tl.int64)
+    off = tl.load(WSO + p).to(tl.int64) + pg * PAGE
+    t = tl.arange(0, PAGE)
+    d = tl.arange(0, D)
+    ok = (pg * PAGE + t) < seq_len
+    for g in range(HKV):
+        k = tl.load(K + blk * s_kb + t[:, None] * s_kt + g * s_kh + d[None, :], mask=ok[:, None], other=0)
+        v = tl.load(V + blk * s_vb + t[:, None] * s_vt + g * s_vh + d[None, :], mask=ok[:, None], other=0)
+        if QUANT > 0:
+            ks = tl.load(KS + blk * s_sb + t * s_st + g * s_sh, mask=ok, other=0.0)
+            vs = tl.load(VS + blk * s_sb + t * s_st + g * s_sh, mask=ok, other=0.0)
+            v = (v.to(tl.float32) * vs[:, None]).to(VW.dtype.element_ty)
+            if QUANT == 1:
+                k = (k.to(tl.float32) * ks[:, None]).to(KW.dtype.element_ty)
+            else:
+                tl.store(KSW + g * s_wk + off + t, ks)
+        tl.store(KW + g * s_wg + (off + t)[:, None] * D + d[None, :], k)
+        tl.store(VW + g * s_wg + (off + t)[:, None] * D + d[None, :], v)
+
+
+@triton.jit
+def _zero_tail_kernel(KW, VW, KSW, tok, s_wg, s_wk, N: tl.constexpr, D: tl.constexpr, HAS_KS: tl.constexpr):
+    """Zero tokens [tok, tok + N) of K and V workspaces of one KV head (grid = KV heads), and of the K scale
+    workspace when there is one. Own kernel: FlagGems' replacement of aten zero_ ignores the strides of a
+    sliced view (E019 attempt 7)."""
+    g = tl.program_id(0)
+    t = tok + tl.arange(0, N)
+    d = tl.arange(0, D)
+    z = tl.zeros([N, D], dtype=KW.dtype.element_ty)
+    tl.store(KW + g * s_wg + t[:, None] * D + d[None, :], z)
+    tl.store(VW + g * s_wg + t[:, None] * D + d[None, :], tl.zeros([N, D], dtype=VW.dtype.element_ty))
+    if HAS_KS:
+        tl.store(KSW + g * s_wk + t, tl.zeros([N], dtype=tl.float32))
+
+
+@triton.jit
+def _pf_tile(acc, m_i, l_i, q, k, vp, start, offs_t, qpos, seq_len, qk_scale, MASKED: tl.constexpr):
+    sc = tl.dot(q, k)
+    if MASKED:
+        tok = start + offs_t
+        vis = (tok[None, :] <= qpos[:, None]) & (tok[None, :] < seq_len)
+        sc = tl.where(vis, sc, float("-inf"))
+    m_new = tl.maximum(m_i, tl.max(sc, 1) * qk_scale)
+    if MASKED:
+        m_new = tl.where(m_new > float("-inf"), m_new, 0.0)
+    alpha = tl.exp2(m_i - m_new)
+    acc = acc * alpha[:, None]
+    l_i = l_i * alpha
+    m_i = m_new
+    p32 = tl.exp2(sc * qk_scale - m_i[:, None])
+    l_i = l_i + tl.sum(p32, 1)
+    acc += tl.dot(p32.to(vp.dtype.element_ty), tl.load(vp))
+    return acc, m_i, l_i
+
+
+@triton.jit
+def _pf_range(acc, m_i, l_i, q, KW, VW, kv_base, j0, j1, offs_t, offs_d, qpos, seq_len, qk_scale,
+              MASKED: tl.constexpr, T: tl.constexpr, D: tl.constexpr):
+    kp = KW + kv_base + (j0 * T + offs_t)[None, :] * D + offs_d[:, None]
+    vp = VW + kv_base + (j0 * T + offs_t)[:, None] * D + offs_d[None, :]
+    for j in range(j0, j1):
+        k = tl.load(kp)
+        acc, m_i, l_i = _pf_tile(acc, m_i, l_i, q, k, vp, j * T, offs_t, qpos, seq_len, qk_scale, MASKED)
+        kp += T * D
+        vp += T * D
+    return acc, m_i, l_i
+
+
+@triton.jit(do_not_specialize=["n_p", "total_blocks"])   # E022: varying counts must not recompile (%16 variants)
+def _prefill_kernel(Q, O, CU_Q, SEQ_LENS, PIDX, CB, WSO, KW, VW, qk_scale,
+                    s_q0, s_q1, s_o0, s_o1, s_wg, n_p, total_blocks,
+                    QPK: tl.constexpr, BLOCK_Q: tl.constexpr, T: tl.constexpr, D: tl.constexpr,
+                    TAIL_ONLY: tl.constexpr = False):
+    BLOCK_M: tl.constexpr = BLOCK_Q * QPK
+    g = tl.program_id(1)
+    if TAIL_ONLY:
+        p = n_p - 1 - tl.program_id(0)
+    else:
+        b = total_blocks - 1 - tl.program_id(0)   # heavier (later) causal blocks first
+        # Largest p with CB[p] <= b.
+        lo = 0
+        hi = n_p
+        while lo < hi:
+            mid = (lo + hi) // 2
+            c = tl.load(CB + mid) <= b
+            lo = tl.where(c, mid + 1, lo)
+            hi = tl.where(c, hi, mid)
+        p = lo - 1
+    s = tl.load(PIDX + p)
+    cu_s = tl.load(CU_Q + s)
+    q_len = tl.load(CU_Q + s + 1) - cu_s
+    if TAIL_ONLY:
+        qb = tl.cdiv(q_len, BLOCK_Q) - 1
+    else:
+        qb = b - tl.load(CB + p)
+    seq_len = tl.load(SEQ_LENS + s)
+    ctx = seq_len - q_len
+    ws_off = tl.load(WSO + p).to(tl.int64)
+
+    offs_r = tl.arange(0, BLOCK_M)
+    tok = qb * BLOCK_Q + offs_r // QPK
+    head = g * QPK + offs_r % QPK
+    row_ok = tok < q_len
+    offs_d = tl.arange(0, D)
+    offs_t = tl.arange(0, T)
+    q = tl.load(Q + (cu_s + tok)[:, None].to(tl.int64) * s_q0 + head[:, None] * s_q1 + offs_d[None, :],
+                mask=row_ok[:, None], other=0.0)
+    qpos = ctx + tok
+
+    acc = tl.zeros([BLOCK_M, D], dtype=tl.float32)
+    m_i = tl.full([BLOCK_M], float("-inf"), dtype=tl.float32)
+    l_i = tl.zeros([BLOCK_M], dtype=tl.float32)
+
+    kv_end = ctx + tl.minimum((qb + 1) * BLOCK_Q, q_len)   # keys the last row needs
+    n_full = (ctx + qb * BLOCK_Q + 1) // T                  # tiles every row sees fully
+    n_all = (kv_end + T - 1) // T
+    kv_base = g * s_wg + ws_off * D
+    acc, m_i, l_i = _pf_range(acc, m_i, l_i, q, KW, VW, kv_base, 0, n_full, offs_t, offs_d,
+                              qpos, seq_len, qk_scale, False, T, D)
+    # A query block can overlap at most ceil(BLOCK_Q / T) + 1 key tiles.
+    # Expand the masked tail so each tile keeps its own scalar softmax update.
+    for offset in tl.static_range((BLOCK_Q + T - 1) // T + 1):
+        tile = n_full + offset
+        if tile < n_all:
+            kp = KW + kv_base + (tile * T + offs_t)[None, :] * D + offs_d[:, None]
+            vp = VW + kv_base + (tile * T + offs_t)[:, None] * D + offs_d[None, :]
+            acc, m_i, l_i = _pf_tile(acc, m_i, l_i, q, tl.load(kp), vp, tile * T,
+                                     offs_t, qpos, seq_len, qk_scale, True)
+    l_i = tl.where(l_i > 0.0, l_i, 1.0)
+    out = acc / l_i[:, None]
+    tl.store(O + (cu_s + tok)[:, None].to(tl.int64) * s_o0 + head[:, None] * s_o1 + offs_d[None, :],
+             out.to(O.dtype.element_ty), mask=row_ok[:, None])
+
+
+@triton.jit
+def _pf_tile8(acc, m_i, l_i, q8, sq, k8, sk, vp, start, offs_t, qpos, seq_len, qk_scale, MASKED: tl.constexpr):
+    """_pf_tile with an int8 q . k product: int32 MMA, then * (row scale of q) * (column scale of k)."""
+    sc = tl.dot(q8, k8, out_dtype=tl.int32).to(tl.float32) * sq[:, None] * sk[None, :]
+    if MASKED:
+        tok = start + offs_t
+        vis = (tok[None, :] <= qpos[:, None]) & (tok[None, :] < seq_len)
+        sc = tl.where(vis, sc, float("-inf"))
+    m_new = tl.maximum(m_i, tl.max(sc, 1) * qk_scale)
+    if MASKED:
+        m_new = tl.where(m_new > float("-inf"), m_new, 0.0)
+    alpha = tl.exp2(m_i - m_new)
+    acc = acc * alpha[:, None]
+    l_i = l_i * alpha
+    m_i = m_new
+    p32 = tl.exp2(sc * qk_scale - m_i[:, None])
+    l_i = l_i + tl.sum(p32, 1)
+    acc += tl.dot(p32.to(vp.dtype.element_ty), tl.load(vp))
+    return acc, m_i, l_i
+
+
+@triton.jit
+def _pf_range8(acc, m_i, l_i, q8, sq, KW, VW, KSW, kv_base, ks_base, j0, j1, offs_t, offs_d, qpos, seq_len, qk_scale,
+               MASKED: tl.constexpr, T: tl.constexpr, D: tl.constexpr):
+    kp = KW + kv_base + (j0 * T + offs_t)[None, :] * D + offs_d[:, None]
+    vp = VW + kv_base + (j0 * T + offs_t)[:, None] * D + offs_d[None, :]
+    sp = KSW + ks_base + j0 * T + offs_t
+    for j in range(j0, j1):
+        acc, m_i, l_i = _pf_tile8(acc, m_i, l_i, q8, sq, tl.load(kp), tl.load(sp), vp, j * T, offs_t, qpos, seq_len,
+                                  qk_scale, MASKED)
+        kp += T * D
+        vp += T * D
+        sp += T
+    return acc, m_i, l_i
+
+
+@triton.jit(do_not_specialize=["n_p", "total_blocks"])
+def _prefill_kernel8(Q, O, CU_Q, SEQ_LENS, PIDX, CB, WSO, KW, VW, KSW, qk_scale,
+                     s_q0, s_q1, s_o0, s_o1, s_wg, s_wk, n_p, total_blocks,
+                     QPK: tl.constexpr, BLOCK_Q: tl.constexpr, T: tl.constexpr, D: tl.constexpr):
+    """_prefill_kernel with the scores from int8 MMAs: K arrives as int8 codes + per-token scales (the cache's own
+    codes, KW / KSW workspace), Q is quantised here per row (per token and head, absmax / 127, round half away)."""
+    BLOCK_M: tl.constexpr = BLOCK_Q * QPK
+    b = total_blocks - 1 - tl.program_id(0)
+    g = tl.program_id(1)
+    lo = 0
+    hi = n_p
+    while lo < hi:
+        mid = (lo + hi) // 2
+        c = tl.load(CB + mid) <= b
+        lo = tl.where(c, mid + 1, lo)
+        hi = tl.where(c, hi, mid)
+    p = lo - 1
+    s = tl.load(PIDX + p)
+    qb = b - tl.load(CB + p)
+    cu_s = tl.load(CU_Q + s)
+    q_len = tl.load(CU_Q + s + 1) - cu_s
+    seq_len = tl.load(SEQ_LENS + s)
+    ctx = seq_len - q_len
+    ws_off = tl.load(WSO + p).to(tl.int64)
+
+    offs_r = tl.arange(0, BLOCK_M)
+    tok = qb * BLOCK_Q + offs_r // QPK
+    head = g * QPK + offs_r % QPK
+    row_ok = tok < q_len
+    offs_d = tl.arange(0, D)
+    offs_t = tl.arange(0, T)
+    qf = tl.load(Q + (cu_s + tok)[:, None].to(tl.int64) * s_q0 + head[:, None] * s_q1 + offs_d[None, :],
+                 mask=row_ok[:, None], other=0.0).to(tl.float32)
+    sq = tl.maximum(tl.max(tl.abs(qf), 1), 1e-6) / 127.0
+    r = qf / sq[:, None]
+    q8 = tl.where(r >= 0.0, tl.floor(r + 0.5), -tl.floor(-r + 0.5)).to(tl.int8)
+    qpos = ctx + tok
+
+    acc = tl.zeros([BLOCK_M, D], dtype=tl.float32)
+    m_i = tl.full([BLOCK_M], float("-inf"), dtype=tl.float32)
+    l_i = tl.zeros([BLOCK_M], dtype=tl.float32)
+
+    kv_end = ctx + tl.minimum((qb + 1) * BLOCK_Q, q_len)
+    n_full = (ctx + qb * BLOCK_Q + 1) // T
+    n_all = (kv_end + T - 1) // T
+    kv_base = g * s_wg + ws_off * D
+    ks_base = g * s_wk + ws_off
+    acc, m_i, l_i = _pf_range8(acc, m_i, l_i, q8, sq, KW, VW, KSW, kv_base, ks_base, 0, n_full, offs_t, offs_d,
+                               qpos, seq_len, qk_scale, False, T, D)
+    acc, m_i, l_i = _pf_range8(acc, m_i, l_i, q8, sq, KW, VW, KSW, kv_base, ks_base, n_full, n_all, offs_t, offs_d,
+                               qpos, seq_len, qk_scale, True, T, D)
+    l_i = tl.where(l_i > 0.0, l_i, 1.0)
+    out = acc / l_i[:, None]
+    tl.store(O + (cu_s + tok)[:, None].to(tl.int64) * s_o0 + head[:, None] * s_o1 + offs_d[None, :],
+             out.to(O.dtype.element_ty), mask=row_ok[:, None])
+
+
+@triton.jit(do_not_specialize=["S"])
+def _decode_kernel(Q, K, V, TABLE, SEQ_LENS, CU_Q, PO, PM, PL, qk_scale,
+                   s_q0, s_q1, s_kb, s_kt, s_kh, s_vb, s_vt, s_vh, s_tab, S,
+                   HQ: tl.constexpr, D: tl.constexpr, QPK: tl.constexpr):
+    """Grid (KV head, sequence, split). Rows with query length != 1 are skipped."""
+    h = tl.program_id(0)
+    seq = tl.program_id(1)
+    sp = tl.program_id(2)
+    qrow = tl.load(CU_Q + seq)
+    if tl.load(CU_Q + seq + 1) - qrow != 1:
+        return
+    L = tl.load(SEQ_LENS + seq)
+    npg = tl.cdiv(L, 16)
+    per = tl.cdiv(npg, S)
+    lo = sp * per
+    hi = tl.minimum(lo + per, npg)
+    rows = tl.arange(0, 16)
+    rmask = rows < QPK
+    d = tl.arange(0, D)
+    offs_t = tl.arange(0, 16)
+    q = tl.load(Q + qrow.to(tl.int64) * s_q0 + (h * QPK + rows)[:, None] * s_q1 + d[None, :],
+                mask=rmask[:, None], other=0.0)
+    m_i = tl.full([16], float("-inf"), tl.float32)
+    l_i = tl.zeros([16], tl.float32)
+    acc = tl.zeros([16, D], tl.float32)
+    tab = TABLE + seq.to(tl.int64) * s_tab
+    koff = offs_t[:, None] * s_kt + h * s_kh + d[None, :]
+    voff = offs_t[:, None] * s_vt + h * s_vh + d[None, :]
+    # E025: unrolling the page loop batches several pages' global loads between the barrier drains (+8-9 % kernel throughput, bit-identical)
+    for j in tl.range(lo, hi, loop_unroll_factor=4):
+        blk = tl.load(tab + j).to(tl.int64)
+        msk = (j * 16 + offs_t) < L
+        k = tl.load(K + blk * s_kb + koff, mask=msk[:, None], other=0.0)
+        v = tl.load(V + blk * s_vb + voff, mask=msk[:, None], other=0.0)
+        sc = tl.dot(q, tl.trans(k))
+        sc = tl.where(msk[None, :], sc * qk_scale, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(sc, 1))
+        alpha = tl.exp2(m_i - m_new)
+        p = tl.exp2(sc - m_new[:, None])
+        l_i = l_i * alpha + tl.sum(p, 1)
+        acc = acc * alpha[:, None] + tl.dot(p.to(v.dtype), v)
+        m_i = m_new
+    pbase = (seq * S + sp) * HQ + h * QPK
+    tl.store(PO + (pbase + rows)[:, None] * D + d[None, :], acc, mask=rmask[:, None])
+    tl.store(PM + pbase + rows, m_i, mask=rmask)
+    tl.store(PL + pbase + rows, l_i, mask=rmask)
+
+
+@triton.jit
+def _unp(w, i: tl.constexpr):
+    """Byte i of an int32 word holding four int8 codes, as an exact fp16 value (xor 0x80 -> offset binary, magic 1024 + u - 1152)."""
+    return ((((w >> (8 * i)) & 0xff) ^ 0x80) | 0x6400).to(tl.int16).to(tl.float16, bitcast=True) - 1152.0
+
+
+@triton.jit(do_not_specialize=["S"])
+def _decode_kernel_i8(Q, K, V, KS, VS, TABLE, SEQ_LENS, CU_Q, PO, PM, PL, qk_scale,
+                      s_q0, s_q1, s_kb, s_kt, s_kh, s_sb, s_st, s_sh, s_tab, S,
+                      HQ: tl.constexpr, D: tl.constexpr, QPK: tl.constexpr, NP: tl.constexpr, UNROLL: tl.constexpr):
+    """_decode_kernel on an int8 KV cache with one fp32 scale per (token, head) (E025 attempt 6: dword loads,
+    byte unpack to fp16, head dim permuted so word c holds dims 4c..4c+3). K and V are int32 views of the cache
+    (33 words per head row: 32 of codes, then the scale), KS / VS the scale views; both pairs share strides."""
+    T: tl.constexpr = 16 * NP
+    h = tl.program_id(0)
+    seq = tl.program_id(1)
+    sp = tl.program_id(2)
+    qrow = tl.load(CU_Q + seq)
+    if tl.load(CU_Q + seq + 1) - qrow != 1:
+        return
+    L = tl.load(SEQ_LENS + seq)
+    npg = tl.cdiv(L, 16)
+    per = tl.cdiv(npg, S)
+    lo = sp * per
+    hi = tl.maximum(tl.minimum(lo + per, npg), lo)      # empty split: lo == hi (a negative trip count mis-executes in the NP-strided unrolled loop)
+    rows = tl.arange(0, 16)
+    rmask = rows < QPK
+    c = tl.arange(0, 32)
+    t = tl.arange(0, T)
+    pg = t // 16
+    tt = t % 16
+    qb = Q + qrow.to(tl.int64) * s_q0 + (h * QPK + rows)[:, None] * s_q1 + (4 * c)[None, :]
+    q0 = tl.load(qb, mask=rmask[:, None], other=0.0).to(tl.float16)
+    q1 = tl.load(qb + 1, mask=rmask[:, None], other=0.0).to(tl.float16)
+    q2 = tl.load(qb + 2, mask=rmask[:, None], other=0.0).to(tl.float16)
+    q3 = tl.load(qb + 3, mask=rmask[:, None], other=0.0).to(tl.float16)
+    m_i = tl.full([16], float("-inf"), tl.float32)
+    l_i = tl.zeros([16], tl.float32)
+    a0 = tl.zeros([16, 32], tl.float32)
+    a1 = tl.zeros([16, 32], tl.float32)
+    a2 = tl.zeros([16, 32], tl.float32)
+    a3 = tl.zeros([16, 32], tl.float32)
+    tab = TABLE + seq.to(tl.int64) * s_tab
+    off = tt[:, None] * s_kt + h * s_kh + c[None, :]
+    for j in tl.range(lo, hi, NP, loop_unroll_factor=UNROLL):
+        pj = j + pg
+        msk = (pj < hi) & (pj * 16 + tt < L)
+        blk = tl.load(tab + pj, mask=pj < hi, other=0).to(tl.int64)
+        kw = tl.load(K + blk[:, None] * s_kb + off, mask=msk[:, None], other=0)
+        vw = tl.load(V + blk[:, None] * s_kb + off, mask=msk[:, None], other=0)
+        sk = tl.load(KS + blk * s_sb + tt * s_st + h * s_sh, mask=msk, other=0.0)
+        sv = tl.load(VS + blk * s_sb + tt * s_st + h * s_sh, mask=msk, other=0.0)
+        sc = tl.dot(q0, tl.trans(_unp(kw, 0)))
+        sc = sc + tl.dot(q1, tl.trans(_unp(kw, 1)))
+        sc = sc + tl.dot(q2, tl.trans(_unp(kw, 2)))
+        sc = sc + tl.dot(q3, tl.trans(_unp(kw, 3)))
+        sc = sc * sk[None, :]
+        sc = tl.where(msk[None, :], sc * qk_scale, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(sc, 1))
+        alpha = tl.exp2(m_i - m_new)
+        p = tl.exp2(sc - m_new[:, None])
+        l_i = l_i * alpha + tl.sum(p, 1)
+        ps = (p * (sv * 64.0)[None, :]).to(tl.float16)       # x64 keeps small probabilities out of fp16 denormals
+        a0 = a0 * alpha[:, None] + tl.dot(ps, _unp(vw, 0))
+        a1 = a1 * alpha[:, None] + tl.dot(ps, _unp(vw, 1))
+        a2 = a2 * alpha[:, None] + tl.dot(ps, _unp(vw, 2))
+        a3 = a3 * alpha[:, None] + tl.dot(ps, _unp(vw, 3))
+        m_i = m_new
+    pbase = (seq * S + sp) * HQ + h * QPK
+    po = PO + (pbase + rows)[:, None] * D + (4 * c)[None, :]
+    r = 1.0 / 64.0
+    tl.store(po, a0 * r, mask=rmask[:, None])
+    tl.store(po + 1, a1 * r, mask=rmask[:, None])
+    tl.store(po + 2, a2 * r, mask=rmask[:, None])
+    tl.store(po + 3, a3 * r, mask=rmask[:, None])
+    tl.store(PM + pbase + rows, m_i, mask=rmask)
+    tl.store(PL + pbase + rows, l_i, mask=rmask)
+
+
+@triton.jit(do_not_specialize=["S"])
+def _reduce_kernel(PO, PM, PL, O, CU_Q, s_o0, s_o1, S, SP: tl.constexpr, HQ: tl.constexpr, D: tl.constexpr):
+    seq = tl.program_id(0)
+    qrow = tl.load(CU_Q + seq)
+    if tl.load(CU_Q + seq + 1) - qrow != 1:
+        return
+    rows = tl.arange(0, HQ)
+    sidx = tl.arange(0, SP)
+    smask = sidx < S
+    d = tl.arange(0, D)
+    base = seq * S * HQ
+    m = tl.load(PM + base + sidx[:, None] * HQ + rows[None, :], mask=smask[:, None], other=float("-inf"))
+    lsum = tl.load(PL + base + sidx[:, None] * HQ + rows[None, :], mask=smask[:, None], other=0.0)
+    mx = tl.max(m, 0)
+    mx = tl.where(mx > float("-inf"), mx, 0.0)      # empty sequence (graph padding): no NaN
+    denom = tl.sum(tl.exp2(m - mx[None, :]) * lsum, 0)
+    denom = tl.where(denom > 0.0, denom, 1.0)
+    acc = tl.zeros([HQ, D], tl.float32)
+    for s in range(S):
+        w = tl.exp2(tl.load(PM + base + s * HQ + rows) - mx)
+        acc += tl.load(PO + (base + s * HQ + rows)[:, None] * D + d[None, :]) * w[:, None]
+    out = acc / denom[:, None]
+    tl.store(O + qrow.to(tl.int64) * s_o0 + rows[:, None] * s_o1 + d[None, :], out.to(O.dtype.element_ty))
+
+
+# --------------------------------------------------------------------------- per-step plan
+
+
+@dataclass
+class StepPlan:
+    cu: torch.Tensor                 # the query_start_loc tensor this plan belongs to
+    n_decode: int                    # rows with query length 1
+    n_p: int                         # prefill sequences
+    pidx: Optional[torch.Tensor]     # [n_p] batch index of each prefill sequence
+    cb: Optional[torch.Tensor]       # [n_p] first q block of each prefill sequence
+    wso: Optional[torch.Tensor]      # [n_p] workspace token offset of each prefill sequence
+    total_blocks: int
+    max_pages: int
+    kw: Optional[torch.Tensor]       # workspace [HKV, tokens, D] (int8 codes when ksw is set)
+    vw: Optional[torch.Tensor]
+    ksw: Optional[torch.Tensor] = None   # [HKV, tokens] fp32 K scales (int8 QK attention)
+    pair_shapes: tuple = ()
+    causal_shapes: tuple = ()
+    causal_state: Optional[tuple] = None
+    cp_lse: Optional[tuple] = None
+    pair_capacity: int = 0
+    prefill_desc: tuple = ()
+    dense_subsets: Optional[dict] = None
+    prefill_t: int = 256
+    pair_scratch: Optional[tuple] = None
+    history_pages: Optional[int] = None
+    direct_rows: int = 0
+    fresh_sources: Optional[tuple] = None
+    last_logit_only: bool = False
+    last_logits_rows: Optional[torch.Tensor] = None
+
+
+_current_plan: Optional[StepPlan] = None
+
+
+def decode_splits(n_decode: int) -> int:
+    """KV splits per decode row; a function of the row count only (graph capture)."""
+    if n_decode >= 28:
+        return 8
+    if n_decode >= 8:
+        return 16
+    return 32
+
+
+def plan_step(common, num_kv_heads: int, head_size: int, dtype: torch.dtype, device, i8k: bool = False) -> None:
+    """Called from the metadata builder once per step. Uses CPU copies only."""
+    global _current_plan
+    _current_plan = None
+    if common.max_query_len <= 1:
+        return
+    seq_cpu = common.seq_lens_cpu_upper_bound
+    if seq_cpu is None:
+        return
+    qsl = common.query_start_loc_cpu
+    n = common.num_reqs
+    qlen = (qsl[1:n + 1] - qsl[:n]).tolist()
+    slen = seq_cpu[:n].tolist()
+    pidx, cb, wso = [], [], []
+    blocks = tok = max_pages = 0
+    for i in range(n):
+        if qlen[i] > 1:
+            pidx.append(i)
+            cb.append(blocks)
+            wso.append(tok)
+            blocks += -(-qlen[i] // _PF_BLOCK_Q)
+            pages = -(-slen[i] // _PAGE)
+            tok += pages * _PAGE
+            max_pages = max(max_pages, pages)
+    n_decode = sum(1 for x in qlen if x == 1)
+    prefill_t = 128 if max((slen[i] for i in pidx), default=0) >= 2048 else 256
+    n_tok = tok + 2 * _PF_T                       # masked tail tiles may read past the last sequence
+    kw = torch.empty((num_kv_heads, n_tok, head_size), dtype=torch.int8 if i8k else dtype, device=device)
+    vw = torch.empty((num_kv_heads, n_tok, head_size), dtype=dtype, device=device)
+    ksw = torch.empty((num_kv_heads, n_tok), dtype=torch.float32, device=device) if i8k else None
+    _zero_tail_kernel[(num_kv_heads,)](kw, vw, ksw if i8k else kw, tok, kw.stride(0), ksw.stride(0) if i8k else 0,
+                                       N=2 * _PF_T, D=head_size, HAS_KS=i8k, num_warps=4)
+    idx = torch.tensor([pidx, cb, wso], dtype=torch.int32).to(device, non_blocking=True)
+    prefill_desc = tuple((i, qlen[i], off) for i, off in zip(pidx, wso))
+    pair_shapes = []
+    causal_shapes = []
+    pair_capacity = 0
+    for i, q_count, off in prefill_desc:
+        ctx = slen[i] - q_count
+        if q_count >= 128 and 1024 <= slen[i] <= 32768:
+            causal_shapes.append((len(pair_shapes), (int(qsl[i]), q_count, ctx, off)))
+        shape = None
+        if ctx >= 4096 and slen[i] <= 16384 and q_count >= 128:
+            _once("e489_context_shape", "E489 nonzero-context prefill shape observed (ctx>=4096)")
+            anchor = 4096 if ctx < 7168 else (8192 if ctx < 11264 else 14336)
+            shape = (int(qsl[i]), q_count, ctx, off, anchor)
+            pair_capacity = max(pair_capacity, (q_count + 127) // 128)
+        pair_shapes.append(shape)
+    # The CPU sequence lengths are upper bounds; rounding up may do extra work.
+    history_pages = max((slen[i] - qlen[i] + _PAGE - 1) // _PAGE for i in pidx) if pidx else 0
+    direct_rows = 0
+    if pidx and not i8k and not n_decode and history_pages == 0 and all(int(qsl[i]) == off for i, off in zip(pidx, wso)):
+        direct_rows = sum(qlen[i] for i in pidx)
+    _current_plan = StepPlan(history_pages=history_pages, direct_rows=direct_rows, cu=common.query_start_loc, n_decode=n_decode, n_p=len(pidx),
+                             pidx=idx[0], cb=idx[1], wso=idx[2], total_blocks=blocks,
+                             max_pages=max_pages, kw=kw, vw=vw, ksw=ksw, pair_shapes=tuple(pair_shapes) if pair_capacity else (),
+                             causal_shapes=tuple(causal_shapes), pair_capacity=pair_capacity, prefill_desc=prefill_desc, prefill_t=prefill_t)
+
+
+# --------------------------------------------------------------------------- launchers
+
+
+def _i8_views(k, v, k_scale_cache, v_scale_cache):
+    """int32 views of the int8 caches [blocks, 16, heads, 132] (32 words of codes + the scale word) or None."""
+    if k_scale_cache is None or v_scale_cache is None or k.stride() != v.stride() or k_scale_cache.stride() != v_scale_cache.stride():
+        return None
+    try:
+        return k.view(torch.int32), v.view(torch.int32)
+    except RuntimeError:
+        return None
+
+
+def hc_views(kv_cache):
+    """Head-contiguous view of an int8 per-token-head KV cache [blocks, 2, 16, heads, 128 + 4] (E028).
+
+    vLLM interleaves the heads inside a page (token-major rows of 132 B, the scale in the last 4 bytes of a row). The decode
+    kernels read it with MMA-fragment shaped accesses that reach only ~280 GB/s on this card; coalesced dword loads of a whole
+    head chunk reach ~630 GB/s (E028 loadbench). The page is 8448 B either way, so the same bytes are re-interpreted as
+    [K codes: head, token, 128 B (2 KB per head)] [V codes] [K scales: head, token (fp32)] [V scales]; all consumers (cache
+    write kernel, decode, prefill workspace copy) take the views' strides. Returns key / value code views [blocks, 16, heads, 128]
+    and fp32 scale views [blocks, 16, heads]."""
+    nb, two, bs, nkv, ph = kv_cache.shape
+    hs = ph - 4
+    page = kv_cache.stride(0)
+    off = kv_cache.storage_offset()
+    codes = nkv * bs * hs
+    kc = torch.as_strided(kv_cache, (nb, bs, nkv, hs), (page, hs, bs * hs, 1), off)
+    vc = torch.as_strided(kv_cache, (nb, bs, nkv, hs), (page, hs, bs * hs, 1), off + codes)
+    base = torch.tensor([], dtype=torch.float32, device=kv_cache.device).set_(kv_cache.untyped_storage())
+    ksc = torch.as_strided(base, (nb, bs, nkv), (page // 4, 1, bs), (off + 2 * codes) // 4)
+    vsc = torch.as_strided(base, (nb, bs, nkv), (page // 4, 1, bs), (off + 2 * codes) // 4 + nkv * bs)
+    return kc, vc, ksc, vsc
+
+
+def stock_to_hc_codes(k, v):
+    """The stock key / value cache halves kv_cache[:, 0] / kv_cache[:, 1] ([blocks, 16, heads, 132], V starts 16 * heads * 132 bytes into the
+    page) -> the head-contiguous code views of hc_views (V codes start heads * 16 * 128 bytes into the page, right after the K codes)."""
+    nb, bs, nkv, _ = k.shape
+    assert v.storage_offset() - k.storage_offset() == bs * nkv * (_HEAD + 4) and v.stride(0) == k.stride(0)
+    strides = (k.stride(0), _HEAD, bs * _HEAD, 1)
+    kc = torch.as_strided(k, (nb, bs, nkv, _HEAD), strides, k.storage_offset())
+    vc = torch.as_strided(k, (nb, bs, nkv, _HEAD), strides, k.storage_offset() + nkv * bs * _HEAD)
+    return kc, vc
+
+
+_DEC_NP, _DEC_UNROLL = 2, 8    # int8 decode: pages per iteration, unroll (E027 sweep on the vLLM layout: 0.91 / 0.87 of the bf16 kernel at 64 x 4300 / 30 x 16900)
+
+
+def run_decode(q, k, v, out, cu_seqlens_q, seqused_k, block_table, softmax_scale, n_decode,
+               k_scale_cache=None, v_scale_cache=None):
+    nseq = seqused_k.shape[0]
+    S = decode_splits(n_decode)
+    hq, hkv, d = q.shape[1], k.shape[2], q.shape[2]
+    po = torch.empty((nseq * S * hq, d), dtype=torch.float32, device=q.device)
+    pm = torch.empty((nseq * S * hq,), dtype=torch.float32, device=q.device)
+    pl = torch.empty_like(pm)
+    if k.dtype == torch.int8:
+        k32, v32 = _i8_views(k, v, k_scale_cache, v_scale_cache)
+        _decode_kernel_i8[(hkv, nseq, S)](
+            q, k32, v32, k_scale_cache, v_scale_cache, block_table, seqused_k, cu_seqlens_q, po, pm, pl,
+            softmax_scale * _LOG2E, q.stride(0), q.stride(1), k32.stride(0), k32.stride(1), k32.stride(2),
+            k_scale_cache.stride(0), k_scale_cache.stride(1), k_scale_cache.stride(2), block_table.stride(0), S,
+            HQ=hq, D=d, QPK=hq // hkv, NP=_DEC_NP, UNROLL=_DEC_UNROLL, num_warps=1, num_stages=1)
+    else:
+        _decode_kernel[(hkv, nseq, S)](
+            q, k, v, block_table, seqused_k, cu_seqlens_q, po, pm, pl, softmax_scale * _LOG2E,
+            q.stride(0), q.stride(1), k.stride(0), k.stride(1), k.stride(2), v.stride(0), v.stride(1), v.stride(2),
+            block_table.stride(0), S, HQ=hq, D=d, QPK=hq // hkv, num_warps=1, num_stages=1)
+    _reduce_kernel[(nseq,)](po, pm, pl, out, cu_seqlens_q, out.stride(0), out.stride(1), S,
+                            SP=triton.next_power_of_2(S), HQ=hq, D=d, num_warps=4)
+
+
+def run_prefill(q, k, v, out, cu_seqlens_q, seqused_k, block_table, softmax_scale, plan: StepPlan,
+                k_scale_cache=None, v_scale_cache=None):
+    hq, hkv, d = q.shape[1], k.shape[2], q.shape[2]
+    kw, vw = plan.kw, plan.vw
+    quant = k.dtype == torch.int8
+    i8k = plan.ksw is not None
+    ks = k_scale_cache if quant else k
+    vs = v_scale_cache if quant else v
+    _ws_copy_kernel[(plan.n_p, plan.max_pages)](
+        k, v, ks, vs, block_table, seqused_k, plan.pidx, plan.wso, kw, vw, plan.ksw if i8k else kw,
+        k.stride(0), k.stride(1), k.stride(2), v.stride(0), v.stride(1), v.stride(2),
+        ks.stride(0) if quant else 0, ks.stride(1) if quant else 0, ks.stride(2) if quant else 0,
+        block_table.stride(0), kw.stride(0), plan.ksw.stride(0) if i8k else 0,
+        HKV=hkv, D=d, PAGE=_PAGE, QUANT=(2 if i8k else int(quant)), num_warps=4)
+    if i8k:
+        _prefill_kernel8[(plan.total_blocks, hkv)](
+            q, out, cu_seqlens_q, seqused_k, plan.pidx, plan.cb, plan.wso, kw, vw, plan.ksw, softmax_scale * _LOG2E,
+            q.stride(0), q.stride(1), out.stride(0), out.stride(1), kw.stride(0), plan.ksw.stride(0), plan.n_p,
+            plan.total_blocks, QPK=hq // hkv, BLOCK_Q=_PF_BLOCK_Q, T=plan.prefill_t, D=d, num_warps=_PF_WARPS, num_stages=1)
+        return
+    _prefill_kernel[(plan.total_blocks, hkv)](
+        q, out, cu_seqlens_q, seqused_k, plan.pidx, plan.cb, plan.wso, kw, vw, softmax_scale * _LOG2E,
+        q.stride(0), q.stride(1), out.stride(0), out.stride(1), kw.stride(0), plan.n_p, plan.total_blocks,
+        QPK=hq // hkv, BLOCK_Q=_PF_BLOCK_Q, T=plan.prefill_t, D=d, num_warps=_PF_WARPS, num_stages=1)
+
+
+
+
+_I8_OK = False    # set by self_check: the int8-KV kernels passed
+_logged = set()
+
+
+def _once(key, msg, *args):
+    if key not in _logged:
+        _logged.add(key)
+        logger.info(msg, *args)
+
+
+
+
+# --------------------------------------------------------------------------- start-up self-check
+
+
+def _reference(q, k, v, cu, seq_lens, table, scale):
+    outs = []
+    for i in range(seq_lens.shape[0]):
+        n, q0, q1 = int(seq_lens[i]), int(cu[i]), int(cu[i + 1])
+        if q1 == q0:
+            continue
+        if n == 0:
+            outs.append(torch.zeros_like(q[q0:q1], dtype=torch.float32))
+            continue
+        ids = table[i, :-(-n // _PAGE)].long()
+        kk = k[ids].reshape(-1, k.shape[2], _HEAD)[:n].float().repeat_interleave(_QPK, 1)
+        vv = v[ids].reshape(-1, v.shape[2], _HEAD)[:n].float().repeat_interleave(_QPK, 1)
+        qs = q[q0:q1].float()
+        sc = torch.einsum("qhd,khd->hqk", qs, kk) * scale
+        qpos = torch.arange(n - qs.shape[0], n, device=q.device)[:, None]
+        sc = sc.masked_fill(torch.arange(n, device=q.device)[None, :] > qpos, float("-inf"))
+        outs.append(torch.einsum("hqk,khd->qhd", sc.softmax(-1), vv))
+    return torch.cat(outs)
+
+
+def _quantize_cache(x):
+    """bf16 [B, 16, H, 128] (CPU) -> int8 codes, fp32 scales [B, 16, H]: vLLM's per-(token, head) recipe, round half away from zero."""
+    xf = x.float()
+    sc = (xf.abs().amax(-1) / 127.0).clamp_min(1e-6)
+    r = xf / sc[..., None]
+    return (torch.sign(r) * torch.floor(r.abs() + 0.5)).clamp(-127, 127).to(torch.int8), sc
+
+
+def _check_case(seq_lens, query_lens, device, gen, quant=False) -> float:
+    hkv, scale = 2, _HEAD ** -0.5
+    pages = [-(-n // _PAGE) for n in seq_lens]
+    total = sum(pages)
+    k = torch.randn((total + 1, _PAGE, hkv, _HEAD), generator=gen).to(device=device, dtype=torch.bfloat16)   # CPU generator: the device RNG is not reproducible on this card
+    v = torch.randn((total + 1, _PAGE, hkv, _HEAD), generator=gen).to(device=device, dtype=torch.bfloat16)
+    table = torch.zeros((len(seq_lens), max(max(pages), 1)), dtype=torch.int32, device=device)
+    perm = torch.randperm(total, generator=gen).to(device=device, dtype=torch.int32) + 1
+    pos = 0
+    for i, n in enumerate(pages):
+        table[i, :n] = perm[pos:pos + n]
+        pos += n
+    q = (torch.randn((sum(query_lens), _QPK * hkv, _HEAD), generator=gen) * 8).to(device=device, dtype=torch.bfloat16)
+    cu_cpu = torch.tensor([0] + query_lens, dtype=torch.int32).cumsum(0).to(torch.int32)
+    cu = cu_cpu.to(device)
+    su = torch.tensor(seq_lens, dtype=torch.int32, device=device)
+    out = torch.zeros_like(q)
+    k_in, v_in, ksc, vsc = k, v, None, None
+    if quant:                                   # the vLLM per-token-head cache buffer [blocks, 2, 16, heads, 128 + 4], read head-contiguous (hc_views)
+        kq, ks = _quantize_cache(k.cpu())
+        vq, vs = _quantize_cache(v.cpu())
+        raw = torch.zeros((total + 1, 2, _PAGE, hkv, _HEAD + 4), dtype=torch.int8)
+        kc, vc, ksc, vsc = hc_views(raw)
+        kc.copy_(kq); vc.copy_(vq); ksc.copy_(ks); vsc.copy_(vs)
+        raw = raw.to(device)
+        _, _, ksc, vsc = hc_views(raw)
+        k_in, v_in = stock_to_hc_codes(raw[:, 0], raw[:, 1])      # the conversion the served wrapper applies to vLLM's cache halves
+        k = (kq.float() * ks[..., None]).to(torch.bfloat16).to(device)
+        v = (vq.float() * vs[..., None]).to(torch.bfloat16).to(device)
+    if max(query_lens) <= 1:
+        run_decode(q, k_in, v_in, out, cu, su, table, scale, len(seq_lens), ksc, vsc)
+    else:
+        plan_step(SimpleNamespace(max_query_len=max(query_lens), seq_lens_cpu_upper_bound=su.cpu(),
+                                  query_start_loc_cpu=cu_cpu, num_reqs=len(seq_lens), query_start_loc=cu),
+                  hkv, _HEAD, torch.bfloat16, device, quant and _PF_QK_INT8)
+        plan = _current_plan
+        if plan.n_decode:
+            run_decode(q, k_in, v_in, out, cu, su, table, scale, plan.n_decode, ksc, vsc)
+        run_prefill(q, k_in, v_in, out, cu, su, table, scale, plan, ksc, vsc)
+    torch.cuda.synchronize(device)
+    if not torch.isfinite(out.float()).all():
+        return float("inf")
+    ref = _reference(q, k, v, cu_cpu, su.cpu(), table, scale)
+    return ((out.float() - ref).abs().max() / ref.abs().max().clamp_min(1e-6)).item()
+
+
+def self_check(device, quant=False) -> float:
+    """Worst relative error (max abs / max |ref|) of our kernels over small synthetic batches (quant: int8 KV cache)."""
+    global _current_plan
+    gen = torch.Generator().manual_seed(0)
+    cases = [
+        ([1], [1]),                                                   # 32 splits, one token
+        ([17, 300, 4097, 16, 15, 33, 1600, 0], [1] * 8),              # 16 splits, page edges, graph pad row
+        ([700 + 97 * i for i in range(28)] + [0] * 4, [1] * 32),      # 8 splits, padding rows
+        ([17, 4127, 300, 1], [17, 31, 1, 1]),                         # context 0 / chunked prefill, odd lengths
+        ([2600] * 6 + [2048 + 300] + [900] * 25, [1] * 6 + [300] + [1] * 25),   # mixed step
+    ]
+    try:
+        return max(_check_case(sl, ql, device, gen, quant) for sl, ql in cases)
+    finally:
+        _current_plan = None
+        torch.cuda.empty_cache()
+
+
+
+
