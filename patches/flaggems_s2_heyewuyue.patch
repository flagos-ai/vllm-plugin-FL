+def run_decode4(qr, c8, c16, win, outr, cu, seq, table, scale, n_decode, final=None, v2=False):
+    from . import attention as A
+    li = getattr(win, "_crosslayer_index", None)
+    if final is not None and li is not None and li not in (6, 28):
+        A._once("e377_mild_sparse", "E377 mild sparse decode (denom=4, full_layers=(6, 28))")
+        from .crosslayer import run_if_active
+        if run_if_active(qr, c8, c16, win, outr, cu, seq, table, scale, n_decode, final, v2):
+            return
+    A._once("e335_full_history_decode", "E335 full-history INT4 KV decode active")
+    nseq = seq.shape[0]
+    S = int4_splits(n_decode)
+    hq = qr.shape[1]
+    po = torch.empty((nseq * (S + 1) * hq, D), dtype=torch.float32, device=qr.device)
+    pm = torch.empty((nseq * (S + 1) * hq,), dtype=torch.float32, device=qr.device)
+    pl = torch.empty_like(pm)
+    tags, rows = layer_state(qr.device, li)
+    if v2:
+        from .int4_kv_v2 import _dec15_kernel
+        dk = _dec15_kernel
+    else:
+        dk = _dec14_kernel
+    dk[(1, nseq, S)](qr, c8, table, seq, cu, rows, tags, po, pm, pl, scale * _LOG2E,
+                     qr.stride(0), qr.stride(1), table.stride(0), S, W=WIN, num_warps=1, num_stages=1)
+    if not WIN_ON:                                       # P0 ablation switch only
+        pm.view(nseq, S + 1, hq)[:, S].fill_(float("-inf")); pl.view(nseq, S + 1, hq)[:, S].zero_()
+        po.view(nseq, S + 1, hq, D)[:, S].zero_()
+        A._reduce_kernel[(nseq,)](po, pm, pl, outr, cu, outr.stride(0), outr.stride(1), S + 1,
+                                  SP=triton.next_power_of_2(S + 1), HQ=hq, D=D, num_warps=4)
+        return
+    if getattr(win,'native',False) and getattr(win,'native_fast_window',True) and hq==16:
+        from ._window_native import native_window_partial
+        native_window_partial[(nseq,)](qr,win.k32,seq,cu,rows,tags,po,pm,pl,scale*_LOG2E,qr.stride(0),qr.stride(1),S=S,
+            TOKEN=getattr(win,'native_layout','mma')=='token',SPLIT_META=getattr(win,'native_split_meta',False),WMETA=win.ks,SKIP_EMPTY=getattr(win,'native_skip_empty',False),num_warps=4,num_stages=1)
+    else:
+        _win4_kernel[(HKV_EXP, nseq)](qr, seq, cu, rows, tags, win.k32, win.v32, win.ks, win.vs, po, pm, pl,
+                                      scale * _LOG2E, qr.stride(0), qr.stride(1), S,
+                                      HQ=hq, D=D, QPK=QPK, W=WIN,NATIVE_WIN=getattr(win,'native',False),TOKEN_WIN=getattr(win,'native_layout','mma')=='token',SPLIT_META_WIN=getattr(win,'native_split_meta',False),num_warps=WIN_WARPS, num_stages=1)
+    if final is not None:                                # E043: reduce + inverse rotation + bf16 store in one launch
+        had, sign = _had_pm(qr.device)
+        reduce_inverse(po, pm, pl, final, cu, had, sign, S + 1, nseq, hq)
+        return
+    A._reduce_kernel[(nseq,)](po, pm, pl, outr, cu, outr.stride(0), outr.stride(1), S + 1,
+                              SP=triton.next_power_of_2(S + 1), HQ=hq, D=D, num_warps=4)
