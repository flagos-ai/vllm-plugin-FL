+    w_one = tl.max(w_vec, axis=0)  # all ties share one value, hence one weight
+
+    # Ties dropped: the largest r < n_eq with below + r * w_one <= thr_z.
+    r_f = tl.where(w_one > 0.0, (thr_z - below) / w_one, 0.0)
+    r_f = tl.minimum(tl.maximum(r_f, 0.0), (n_eq - 1).to(tl.float32))
+    r = r_f.to(tl.int32)
+
+    # ---- pass 4: write -inf over dropped logits in place. Every block is
+    # stored whole (kept values rewritten unchanged): a masked scatter store
+    # is ~8x slower than a dense store on MetaX.
+    neg_inf = tl.full([BLOCK], float("-inf"), tl.float32)
+    carry = tl.zeros([], tl.int32)
+    for start in range(0, vocab_size, BLOCK):
+        idx = start + offs
+        valid = idx < vocab_size
+        x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32)
+        key = _ordered_key(x)
+        drop = key < kstar
+        if carry < r:
+            eq = valid & (key == kstar)
+            cnt = tl.sum(eq.to(tl.int32), axis=0)
+            need = r - carry
+            if need >= cnt:
+                drop = drop | eq
+            else:
+                # Smallest j with count(eq & offs < j) >= need, by bisection
+                # on the block (no scan primitive needed).
+                jlo = tl.zeros([], tl.int32)
+                jhi = tl.zeros([], tl.int32) + BLOCK
+                for _ in range(LOG2_BLOCK + 1):
+                    jmid = (jlo + jhi) // 2
+                    ok = tl.sum((eq & (offs < jmid)).to(tl.int32), axis=0) >= need
+                    jhi = tl.where(ok, jmid, jhi)
+                    jlo = tl.where(ok, jlo, jmid + 1)
+                drop = drop | (eq & (offs < jhi))
+            carry += cnt
+        out = tl.where(drop, neg_inf, x).to(logits_ptr.dtype.element_ty)
