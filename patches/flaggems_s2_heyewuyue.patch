@@ -0,0 +1,30 @@
+import triton
+import triton.language as tl
+from flag_gems.fused.minicpm.w8a8 import _swizzle
+
+
+@triton.jit(do_not_specialize=["M"])
+def gate_up(A, B, S, T, O, M, F: tl.constexpr, K: tl.constexpr,
+            BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,
+            STRIPE: tl.constexpr):
+    pm, pn = _swizzle(M, 2*F, BM, BN, GROUP)
+    row = pm*BM + tl.arange(0, BM)
+    col = pn*BN + tl.arange(0, BN)
+    inner = tl.arange(0, BK)
+    ax = A + row[:, None]*K + inner[None, :]
+    bx = B + col[None, :]*K + inner[:, None]
+    acc = tl.zeros((BM, BN), tl.int32)
+    for _ in range(K//BK):
+        acc += tl.dot(tl.load(ax), tl.load(bx), out_dtype=tl.int32)
+        ax += BK
+        bx += BK
+    z = (acc.to(tl.float32)*tl.load(S+row)[:, None]*tl.load(T+col)[None, :]).to(tl.bfloat16)
+    tl.static_assert(STRIPE == 16)
+    packed = tl.reshape(z,(BM,BN//(2*STRIPE),2,STRIPE))
+    gates, ups = tl.split(tl.permute(packed,(0,1,3,2)))
+    gate = tl.reshape(gates,(BM,BN//2)).to(tl.float32)
+    up = tl.reshape(ups,(BM,BN//2)).to(tl.float32)
+    silu = (gate*(1.0/(1.0+tl.exp(-gate)))).to(tl.bfloat16).to(tl.float32)
+    value = (silu*up).to(tl.bfloat16)
+    dest = pn*(BN//2) + tl.arange(0,BN//2)
+    tl.store(O+row[:,None]*F+dest[None,:],value)
