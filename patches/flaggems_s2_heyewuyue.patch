@@ -0,0 +1,350 @@
+# Copyright (c) 2026 BAAI. All rights reserved.
+
+"""
+W8A8 INT8 linear layers for Iluvatar BI-V150.
+
+On Iluvatar the int8 MMA runs at 2.0-2.5x the bf16 rate at prefill shapes and
+1.6-2.2x at M = 64 (our Triton GEMM, 169-200 TOPS), while any in-loop
+int8 -> float conversion is slow, so only W8A8 pays: both operands int8, one
+int32 -> fp32 conversion per output in the epilogue.
+
+* Weights (qkv_proj, o_proj, gate_up_proj, down_proj): per-output-channel
+  symmetric int8, round half up, quantized once after loading; the bf16
+  weight is freed (the freed memory goes to the KV cache).
+* Activations: per-token symmetric int8, round half up, computed per call.
+* down_proj: its input carries outlier channels (SiLU(gate) * up), so it is
+  rotated by a block-diagonal Hadamard matrix (block 512, orthonormal,
+  symmetric) before quantization; the weight is rotated by the same matrix
+  offline, so x H (W H)^T = x W^T. H512 = H4 (x) H128 (Sylvester), so each
+  512-block costs four [BM, 128] x [128, 128] MMAs and a +-1 combination.
+* GEMM: int8 x int8 -> int32, epilogue * row scale * column scale -> bf16;
+  tile configuration per shape class (decode M <= 64, prefill otherwise).
+
+The numerics are those of the offline accuracy proxy (E013 attempt 10:
+w8+a8+rot b512, dNLL +0.0023 vs bf16, 1.56x weight-only int8). The linear
+call is a registered custom op, opaque to torch.compile. A start-up
+self-check compares the op with a torch reference on every shape class;
+on failure nothing is patched and the layers stay bf16.
+"""
+
+import logging   # no postponed annotations: the custom op schema is inferred from them
+
+import torch
+import triton
+import triton.language as tl
+
+from .logging_utils import get_logger
+logger = get_logger(__name__)
+
+KINDS = ("qkv_proj", "o_proj", "gate_up_proj", "down_proj")
+ROT_KIND = "down_proj"
+ROT_BLOCK = 512
+_ONE_TILE_MAX, _ONE_TILE_WARPS = 4096, 8   # E022: single-load activation quant for K = 2048
+_QBLOCK = 1024           # activation quant: elements per load (K is a multiple)
+
+
+# --------------------------------------------------------------------------- kernels
+
+
+@triton.jit
+def _quant_kernel(X, Q, S, M, K, sx, sq, BLOCK: tl.constexpr):
+    """Per-row symmetric int8: s = max|x| / 127, q = floor(x / s + 0.5). Grid = padded rows; rows >= M
+    read zeros and write q = 0, so the GEMM can load whole tiles without masks. K % BLOCK == 0."""
+    row = tl.program_id(0)                 # int32 offsets throughout (every tensor < 2^31 elements)
+    offs = tl.arange(0, BLOCK)
+    ok = (offs * 0 + row) < M
+    xp = X + row * sx + offs
+    amax = tl.zeros([BLOCK], tl.float32)
+    for k in range(0, K, BLOCK):
+        amax = tl.maximum(amax, tl.abs(tl.load(xp + k, mask=ok, other=0.0).to(tl.float32)))
+    s = tl.maximum(tl.max(amax, 0), 1e-8) / 127.0
+    qp = Q + row * sq + offs
+    for k in range(0, K, BLOCK):
+        q = tl.floor(tl.load(xp + k, mask=ok, other=0.0).to(tl.float32) / s + 0.5)
+        q = tl.minimum(tl.maximum(q, -127.0), 127.0)
+        tl.store(qp + k, q.to(tl.int8))
+    tl.store(S + row, s)
+
+
+@triton.jit
+def _quant1_kernel(X, Q, S, M, sx, sq, K: tl.constexpr):
+    """_quant_kernel for a row that fits one tile (K a power of two): one load, same arithmetic, same result."""
+    row = tl.program_id(0)
+    offs = tl.arange(0, K)
+    x = tl.load(X + row * sx + offs, mask=(offs * 0 + row) < M, other=0.0).to(tl.float32)
+    s = tl.maximum(tl.max(tl.abs(x), 0), 1e-8) / 127.0
+    q = tl.floor(x / s + 0.5)
+    q = tl.minimum(tl.maximum(q, -127.0), 127.0)
+    tl.store(Q + row * sq + offs, q.to(tl.int8))
+    tl.store(S + row, s)
+
+
+@triton.jit
+def _rot_kernel(X, H, T, BA, M, sx, st, NB, BM: tl.constexpr, R: tl.constexpr):
+    """Grid (row blocks, 512-blocks): T[rows, blk] = bf16(x[rows, blk] @ (H4 (x) H128) / sqrt(512)) and
+    BA[row, blk] = max |T[row, blk]|. Rows >= M (padding) read zeros. One block per program keeps
+    enough programs in flight at decode sizes."""
+    rm = tl.program_id(0) * BM + tl.arange(0, BM)
+    blk = tl.program_id(1)
+    mm = rm < M                         # masked rows (clamping rows to M - 1 miscompiled, E018 attempt 1)
+    c = tl.arange(0, 128)
+    h = tl.load(H + c[:, None] * 128 + c[None, :])
+    xp = X + rm[:, None] * sx + blk * 512 + c[None, :]
+    y0 = tl.dot(tl.load(xp, mask=mm[:, None], other=0.0), h)
+    y1 = tl.dot(tl.load(xp + 128, mask=mm[:, None], other=0.0), h)
+    y2 = tl.dot(tl.load(xp + 256, mask=mm[:, None], other=0.0), h)
+    y3 = tl.dot(tl.load(xp + 384, mask=mm[:, None], other=0.0), h)
+    o0 = ((y0 + y1 + y2 + y3) * R).to(tl.bfloat16)
+    o1 = ((y0 - y1 + y2 - y3) * R).to(tl.bfloat16)
+    o2 = ((y0 + y1 - y2 - y3) * R).to(tl.bfloat16)
+    o3 = ((y0 - y1 - y2 + y3) * R).to(tl.bfloat16)
+    tp = T + rm[:, None] * st + blk * 512 + c[None, :]
+    tl.store(tp, o0)
+    tl.store(tp + 128, o1)
+    tl.store(tp + 256, o2)
+    tl.store(tp + 384, o3)
+    a = tl.maximum(tl.maximum(tl.abs(o0.to(tl.float32)), tl.abs(o1.to(tl.float32))),      # E043: one reduction, not four
+                   tl.maximum(tl.abs(o2.to(tl.float32)), tl.abs(o3.to(tl.float32))))
+    m = tl.max(a, 1)
+    tl.store(BA + rm * NB + blk, m)
+
+
+@triton.jit
+def _quant_from_kernel(T, BA, Q, S, K, st, sq, NB, BLOCK: tl.constexpr, NBP: tl.constexpr):
+    """Per-row int8 of the rotated rows, the row max taken from the per-block maxima."""
+    row = tl.program_id(0)
+    j = tl.arange(0, NBP)
+    s = tl.maximum(tl.max(tl.load(BA + row * NB + j, mask=j < NB, other=0.0), 0), 1e-8) / 127.0
+    offs = tl.arange(0, BLOCK)
+    tp = T + row * st + offs
+    qp = Q + row * sq + offs
+    for k in range(0, K, BLOCK):
+        q = tl.floor(tl.load(tp + k).to(tl.float32) / s + 0.5)
+        q = tl.minimum(tl.maximum(q, -127.0), 127.0)
+        tl.store(qp + k, q.to(tl.int8))
+    tl.store(S + row, s)
+
+
+@triton.jit
+def _quant_from1_kernel(T, BA, Q, S, st, sq, NB, K: tl.constexpr, KP: tl.constexpr, NBP: tl.constexpr):
+    """E043: _quant_from_kernel with the whole row in one tile (KP = next power of two >= K): same arithmetic, same result."""
+    row = tl.program_id(0)
+    j = tl.arange(0, NBP)
+    s = tl.maximum(tl.max(tl.load(BA + row * NB + j, mask=j < NB, other=0.0), 0), 1e-8) / 127.0
+    offs = tl.arange(0, KP)
+    x = tl.load(T + row * st + offs, mask=offs < K, other=0.0).to(tl.float32)
+    q = tl.minimum(tl.maximum(tl.floor(x / s + 0.5), -127.0), 127.0)
+    tl.store(Q + row * sq + offs, q.to(tl.int8), mask=offs < K)
+    tl.store(S + row, s)
+
+
+@triton.jit
+def _swizzle(M, N, BM: tl.constexpr, BN: tl.constexpr, GROUP: tl.constexpr):
+    pid = tl.program_id(0)
+    npm = tl.cdiv(M, BM)
+    npn = tl.cdiv(N, BN)
+    gid = pid // (GROUP * npn)
+    first = gid * GROUP
+    gs = min(npm - first, GROUP)
+    pm = first + (pid % gs)
+    pn = (pid % (GROUP * npn)) // gs
+    return pm, pn
+
+
+@triton.jit
+def _gemm_kernel(A, B, C, SA, SB, N, K, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+                 GROUP: tl.constexpr, NPM, UNROLL: tl.constexpr = 1):
+    """C[Mp, N] = (A[Mp, K] int8 . B[N, K]^T int8) * SA[Mp] * SB[N] -> bf16 over padded rows (Mp = NPM * BM).
+    No masks anywhere: a masked load in the K loop ran this kernel 5x slower (E018 attempt 1 vs E012)."""
+    pm, pn = _swizzle(NPM * BM, N, BM, BN, GROUP)
+    rm = pm * BM + tl.arange(0, BM)
+    rn = pn * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    a = A + rm[:, None] * K + rk[None, :]
+    b = B + rn[None, :] * K + rk[:, None]
+    acc = tl.zeros([BM, BN], dtype=tl.int32)
+    for _ in tl.range(0, K, BK, loop_unroll_factor=UNROLL):
+        acc += tl.dot(tl.load(a), tl.load(b), out_dtype=tl.int32)
+        a += BK
+        b += BK
+    sa = tl.load(SA + rm)
+    sb = tl.load(SB + rn)
+    out = acc.to(tl.float32) * sa[:, None] * sb[None, :]
+    tl.store(C + rm[:, None] * N + rn[None, :], out.to(C.dtype.element_ty))
+
+
+# --------------------------------------------------------------------------- launchers
+
+# (BM, BN, BK, warps, stages, group): E012 attempt 1 best per shape, weight in (N, K) layout
+_PREFILL_CFG = (128, 256, 64, 8, 2, 8)
+# E027 gemm_sweep_pf2 (graph-timed, M 512-8192): 256 x 256 tiles with 16 warps are 20-30 % faster (gate_up 170 -> 228 TOPS, down 182 -> 236, qkv 178 -> 238, o 187 -> 242)
+_PREFILL_BIG_CFG = (256, 256, 64, 16, 2, 8)
+_PREFILL_BIG_M = 512
+
+
+def _cfg(m: int, k: int, n: int):
+    if m >= _PREFILL_BIG_M:
+        return _PREFILL_BIG_CFG
+    if m > 64:
+        return _PREFILL_CFG
+    if m <= 16:                         # E022 L0 sweep (graph-timed): BM 16 tiles, 12-35 % faster at M = 16
+        if n >= 8192:                   # gate_up 12288
+            return (16, 64, 128, 4, 2, 8)
+        return (16, 64, 256, 4, 2, 8)   # qkv 2560 / o, down 2048
+    if n >= 8192:                       # gate_up 12288
+        return (64, 256, 64, 4, 2, 8)
+    if n > 2048:                        # qkv 2560
+        return (64, 64, 128, 8, 2, 8)   # E027 gemm_sweep: 308 -> 315 GB/s
+    return (64, 64, 256, 8, 2, 8)       # o / down 2048: E027 gemm_sweep, BK 256 = fewer barrier drains, o 301 -> 315, down 340 -> 397 GB/s
+
+
+def shapes_ok(k: int, n: int, rot: bool) -> bool:
+    if k % _QBLOCK or (rot and k % ROT_BLOCK):
+        return False
+    return all(n % c[1] == 0 and k % c[2] == 0 for c in (_PREFILL_CFG, _PREFILL_BIG_CFG, _cfg(1, k, n)))
+
+
+_H128 = {}
+
+
+def _h128(device) -> torch.Tensor:
+    h = _H128.get(device)
+    if h is None:
+        h = torch.ones(1, 1)
+        while h.shape[0] < 128:
+            h = torch.cat([torch.cat([h, h], 1), torch.cat([h, -h], 1)], 0)
+        h = _H128[device] = h.to(device=device, dtype=torch.bfloat16)   # +-1: exact
+    return h
+
+
+def hadamard(n: int, device) -> torch.Tensor:
+    """Orthonormal Sylvester Hadamard, the matrix of the accuracy proxy (fp32)."""
+    h = torch.ones(1, 1, device=device)
+    while h.shape[0] < n:
+        h = torch.cat([torch.cat([h, h], 1), torch.cat([h, -h], 1)], 0)
+    return h / n ** 0.5
+
+
+def rot_cols(t: torch.Tensor, h: torch.Tensor) -> torch.Tensor:
+    """t [..., K] @ blockdiag(h) in fp32."""
+    b = h.shape[0]
+    return (t.float().reshape(*t.shape[:-1], -1, b) @ h).reshape(t.shape)
+
+
+ROT_BM, ROT_BM_PREFILL, ROT_WARPS = 16, 64, 4   # E018 attempt 2 sweep: M 64 -> 0.016 ms, M 2048 -> 0.29 ms
+
+
+def quant_act(x: torch.Tensor, rot: bool, mp: int = 0, bm: int = 0, warps: int = 0):
+    """Per-token int8 of x [M, K] into padded [Mp, K] (rows >= M are 0) and fp32 scales [Mp]."""
+    m, k = x.shape
+    mp = mp or m
+    q = torch.empty((mp, k), dtype=torch.int8, device=x.device)
+    s = torch.empty((mp,), dtype=torch.float32, device=x.device)
+    if rot:
+        bm = bm or (ROT_BM if m <= 64 else ROT_BM_PREFILL)
+        mpr = triton.cdiv(mp, bm) * bm
+        nb = k // ROT_BLOCK
+        t = torch.empty((mpr, k), dtype=torch.bfloat16, device=x.device)
+        ba = torch.empty((mpr, nb), dtype=torch.float32, device=x.device)
+        _rot_kernel[(mpr // bm, nb)](x, _h128(x.device), t, ba, m, x.stride(0), t.stride(0), nb,
+                                     BM=bm, R=ROT_BLOCK ** -0.5, num_warps=warps or ROT_WARPS, num_stages=1)
+        if k <= 8192:
+            _quant_from1_kernel[(mp,)](t, ba, q, s, t.stride(0), q.stride(0), nb, K=k, KP=triton.next_power_of_2(k),
+                                       NBP=triton.next_power_of_2(nb), num_warps=8)
+        else:
+            _quant_from_kernel[(mp,)](t, ba, q, s, k, t.stride(0), q.stride(0), nb, BLOCK=_QBLOCK,
+                                      NBP=triton.next_power_of_2(nb), num_warps=4)
+    elif k <= _ONE_TILE_MAX and k & (k - 1) == 0:
+        _quant1_kernel[(mp,)](x, q, s, m, x.stride(0), q.stride(0), K=k, num_warps=_ONE_TILE_WARPS)
+    else:
+        _quant_kernel[(mp,)](x, q, s, m, k, x.stride(0), q.stride(0), BLOCK=_QBLOCK, num_warps=4)
+    return q, s
+
+
+def w8a8_linear(x: torch.Tensor, w: torch.Tensor, ws: torch.Tensor, rot: int) -> torch.Tensor:
+    """x [M, K] bf16/fp16 (row-contiguous), w [N, K] int8, ws [N] fp32 -> [M, N] in x's dtype."""
+    m, k = x.shape
+    n = w.shape[0]
+    if m == 0:
+        return torch.empty((0, n), dtype=x.dtype, device=x.device)
+    if x.stride(1) != 1:
+        x = x.contiguous()
+    bm, bn, bk, nw, ns, grp = _cfg(m, k, n)
+    npm = triton.cdiv(m, bm)
+    q, s = quant_act(x, bool(rot), npm * bm)
+    out = torch.empty((npm * bm, n), dtype=x.dtype, device=x.device)
+    _gemm_kernel[(npm * (n // bn),)](q, w, out, s, ws, n, k, BM=bm, BN=bn, BK=bk, GROUP=grp, NPM=npm,
+                                     num_warps=nw, num_stages=ns)
+    return out[:m]
+
+
+def _w8a8_linear_fake(x: torch.Tensor, w: torch.Tensor, ws: torch.Tensor, rot: int) -> torch.Tensor:
+    return x.new_empty((x.shape[0], w.shape[0]))
+
+
+# --------------------------------------------------------------------------- reference + self-check
+
+
+def quant_rows_ref(x: torch.Tensor):
+    xf = x.float()
+    s = xf.abs().amax(-1, keepdim=True).clamp_min(1e-8) / 127.0
+    return torch.floor(xf / s + 0.5).clamp_(-127, 127), s
+
+
+def quantize_weight_ref(w: torch.Tensor, rot: bool):
+    """bf16 [N, K] -> (int8 [N, K], fp32 [N]); down_proj rotated first (fp32, rounded to w's dtype)."""
+    if rot:
+        w = rot_cols(w, hadamard(ROT_BLOCK, w.device)).to(w.dtype)
+    q, s = quant_rows_ref(w)
+    return q.to(torch.int8).contiguous(), s.squeeze(-1).contiguous()
+
+
+def quantize_weight(w: torch.Tensor, rot: bool):
+    """quantize_weight_ref through our own kernels: the weight's output channels are rows, and the
+    rotation acts on K exactly as for activations. Under serve FlagGems replaces aten ops (its amax is
+    wrong here, E019 attempt 1), so load-time quantization uses no torch reductions."""
+    q, s = quant_act(w.contiguous(), rot)
+    return q, s
+
+
+def reference(x, wq, ws, rot):
+    if rot:
+        x = rot_cols(x, hadamard(ROT_BLOCK, x.device)).to(x.dtype)
+    q, s = quant_rows_ref(x)
+    return ((q @ wq.float().t()) * s * ws).to(x.dtype)
+
+
+def self_check(device) -> float:
+    """Worst relative error (max abs / max |ref|) of weight quantization and the op over every shape class
+    of the model. References run on CPU, out of FlagGems' reach."""
+    g = torch.Generator().manual_seed(0)      # CPU generator: the device RNG is not reproducible on this card
+    worst = 0.0
+    for k, n, rot in ((2048, 2560, False), (2048, 2048, False), (2048, 12288, False), (6144, 2048, True)):
+        w = (torch.randn((n, k), generator=g).to(torch.bfloat16) * 0.02).to(device)
+        wq, ws = quantize_weight(w, rot)
+        wq_c, ws_c = wq.cpu(), ws.cpu()
+        rq, rs = quantize_weight_ref(w.cpu(), rot)
+        dq = (wq_c.int() - rq.int()).abs().max().item()
+        ds = ((ws_c - rs).abs() / rs).max().item()
+        if dq > 1 or ds > 1e-2:       # one bf16 ulp of the rotated max (2^-7) is a legitimate rounding difference
+            logger.warning("BI-V150 W8A8 self-check: weight quant [%d, %d] rot=%d differs from reference "
+                           "(max code diff %d, max scale rel %.3g)", n, k, rot, dq, ds)
+            return float("inf")
+        for m in (1, 17, 64, 65, 300, 700, 1100):
+            x = torch.randn((m, k), generator=g).to(torch.bfloat16)
+            x[:, 7] *= 30.0                                   # an outlier channel, as in real activations
+            out = w8a8_linear(x.to(device), wq, ws, int(rot)).cpu().float()
+            ref = reference(x.cpu(), wq_c, ws_c, rot).float()
+            if not torch.isfinite(out).all():
+                logger.warning("BI-V150 W8A8 self-check: non-finite output, [%d, %d] rot=%d M=%d", n, k, rot, m)
+                return float("inf")
+            worst = max(worst, ((out - ref).abs().max() / ref.abs().max().clamp_min(1e-6)).item())
+    torch.cuda.empty_cache()
+    return worst
+
+
+# --------------------------------------------------------------------------- vLLM hook
+
+N_QUANTIZED = 0
+
+
