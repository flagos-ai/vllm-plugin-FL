+    cold,slot=_wstart(TAGS,ROWS,row,length,128)
+    original_npg=tl.cdiv(cold,16)
+    count=tl.load(COUNTS+row);active=count>=0
+    npg=tl.where(active,count,original_npg)
+    per=tl.cdiv(npg,S);lo=sp*per;hi=tl.maximum(lo,tl.minimum(lo+per,npg))
+    lane=tl.arange(0,64);z=lane*0
+    pg=(PG+z).to(tl.uint64)
+    tab=tl.where(active,(TAB+row*s_tab+z).to(tl.uint64),(ORIGINAL+row*s_original+z).to(tl.uint64))
+    slot=tl.maximum(slot,0)
+    wpg=(WPG+slot*8*(2048 if SPLIT_META else 2112)+z).to(tl.uint64)
+    if SPLIT_META:
+        wmeta=(WMETA+slot*8*64+z).to(tl.uint64)
+    else:wmeta=z.to(tl.uint64)
+    tag=(TAGS+slot*128+z).to(tl.uint64)
+    qp=(Q+qrow*s_q0+z).to(tl.uint64)
+    po=(PO+(row*S+sp)*16*128+z).to(tl.uint64)
+    pm=(PM+(row*S+sp)*16+z).to(tl.uint64);pl=(PL+(row*S+sp)*16+z).to(tl.uint64)
+    qk=(z.to(tl.float32)+qk_scale*16777216.).to(tl.int32,bitcast=True)
+    if SPLIT_META:
+        tl.static_assert(TOKEN)
+        code:tl.constexpr=_TAGGED_META2_ASM if V2 else _TAGGED_META_ASM
+    elif TOKEN:
+        code:tl.constexpr=_TAGGED_TOKEN2_ASM if V2 else _TAGGED_TOKEN_ASM
+    elif COLOR:
