+    images = _packed_pair_reader._PREFILL_IMAGES
+    assert all(layer.mlp.gate_up_proj.weight.data_ptr() in images for layer in layers)
+    resident = [images[layer.mlp.gate_up_proj.weight.data_ptr()] for layer in layers]
