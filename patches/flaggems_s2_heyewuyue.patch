+    """Apply a top-p filter to ``logits`` [num_rows, vocab] in place.
+
+    ``p`` holds one top-p value per row. Dropped logits become ``-inf``;
+    kept logits are unchanged. Returns ``logits``.
+    """
+    logger.debug("GEMS TOP_P_MASK_")
+    assert logits.dim() == 2, f"logits must be 2D, got {logits.dim()}D"
+    assert logits.stride(1) == 1, "logits rows must be contiguous"
+    assert block > 0 and block & (block - 1) == 0, "block must be a power of 2"
+    num_rows, vocab_size = logits.shape
+    p = p.to(device=logits.device, dtype=torch.float32).reshape(-1).contiguous()
+    assert p.numel() == num_rows, "p must hold one value per row"
