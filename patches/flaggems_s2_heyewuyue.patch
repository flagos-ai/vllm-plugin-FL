+
+    def mad(d, a, b, c):
+        e("ml_matrix_mad_f32_f16_m16n16k16 %s, %s, %s, %s" % (t4(d), t2(a), t2(b), t4(c)))
+
+    def planes(src, use):                            # nibble planes of a 2-register tile; the byte swap serves planes 1 and 2
+        e("ml_byte_permute_b32 v%d, v%d, v%d, s2" % (T0, src, src))
+        e("ml_byte_permute_b32 v%d, v%d, v%d, s2" % (T1, src + 1, src + 1))
+        for p, (op, x, y, k) in enumerate((("ml_and_b32", src, src + 1, "0xf000f"), ("ml_pk_srl_b16", T0, T1, "0xc000c"),
+                                           ("ml_and_b32", T0, T1, "0xf000f"), ("ml_pk_srl_b16", src, src + 1, "0xc000c"))):
+            e("%s v%d, v%d, %s" % (op, AT, x, k))
+            e("%s v%d, v%d, %s" % (op, AT + 1, y, k))
+            use(p)
