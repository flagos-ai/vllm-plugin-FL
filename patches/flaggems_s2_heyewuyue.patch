+@triton.jit
+def hot_writer(KR,VR,SLOTMAP,CU,SEQ,ROWS,NROWS,WPG,TAGS,s_r0,s_r1,HAS_WIN:tl.constexpr=True,TOKEN:tl.constexpr=False):
+    if not HAS_WIN:return
+    i=tl.program_id(0);h=tl.program_id(1)
+    if tl.load(SLOTMAP+i)<0:return
+    d=tl.arange(0,128)
+    k=tl.load(KR+i*s_r0+h*s_r1+d).to(tl.float32)
+    v=tl.load(VR+i*s_r0+h*s_r1+d).to(tl.float32)
+    ks=tl.maximum(tl.max(tl.abs(k),axis=0)/127.,1e-8)
+    vs=tl.maximum(tl.max(tl.abs(v),axis=0)/127.,1e-8)
+    ku=(tl.minimum(tl.maximum(tl.floor(k/ks+.5),-127.),127.).to(tl.int32)&255)^128
+    vu=(tl.minimum(tl.maximum(tl.floor(v/vs+.5),-127.),127.).to(tl.int32)&255)^128
+    pl=tl.arange(0,4)
+    kw=tl.sum(tl.reshape(ku,(32,4))<<(8*pl[None,:]),axis=1)
+    vw=tl.sum(tl.reshape(vu,(32,4))<<(8*pl[None,:]),axis=1)
+    lo=0;hi=NROWS
+    while lo<hi:
+        mid=(lo+hi)//2;c=tl.load(CU+mid)<=i
+        lo=tl.where(c,mid+1,lo);hi=tl.where(c,hi,mid)
+    row=lo-1;start=tl.load(CU+row);end=tl.load(SEQ+row)
+    pos=end-(tl.load(CU+row+1)-start)+(i-start)
+    slot=tl.load(ROWS+row)
+    if slot>=0 and pos>=end-128:
+        e=tl.arange(0,32);base=WPG+(slot*8+(pos%128)//16)*2112
+        if TOKEN:
+            tl.store(base+(pos%16)*64+h*32+e,kw)
+            tl.store(base+1024+(pos%16)*64+h*32+e,vw)
+        else:
+            tl.store(base+_hw_k(h,e,pos%16),kw)
+            tl.store(base+_hw_v(h,e,pos%16),vw)
+        tl.store(base+2048+h*16+pos%16,ks.to(tl.int32,bitcast=True))
+        tl.store(base+2080+h*16+pos%16,vs.to(tl.int32,bitcast=True))
+        if h==0:tl.store(TAGS+slot*128+pos%128,pos)
+
+
+@triton.jit
+def joined_writer(KR,VR,SLOTMAP,CU,SEQ,ROWS,NROWS,C16,C8,WPG,TAGS,s_r0,s_r1,
+                  V2:tl.constexpr,HAS_WIN:tl.constexpr=True,TOKEN:tl.constexpr=False):
+    if tl.program_id(2)==0:
+        _write_kernel(KR,VR,SLOTMAP,CU,SEQ,ROWS,NROWS,C16,C8,WPG,WPG,WPG,WPG,TAGS,
+            s_r0,s_r1,2112,4224,HAS_WIN=False,W=128,V2=V2,NATIVE_WIN=False)
+    else:
+        hot_writer(KR,VR,SLOTMAP,CU,SEQ,ROWS,NROWS,WPG,TAGS,s_r0,s_r1,HAS_WIN=HAS_WIN,TOKEN=TOKEN)
