+"""Sort-free top-p (nucleus) filter.
+
+Same result as sorting each row ascending (stable), taking the softmax
+cumulative sum and masking every position whose cumulative probability is
+<= 1 - p (never the last one), but without sorting the vocabulary.
+
+Logits are mapped to order-preserving int32 keys, so "the top-p cut" is a
+threshold on keys. The cut key is found by **MSB-first radix select**: each
+pass resolves ``BITS`` bits of the key by summing the softmax weight of the
+row into ``2**BITS`` buckets and picking the bucket where the cumulative mass
+first exceeds the threshold. No arithmetic on the key range is needed, so
+nothing can overflow (MetaX Triton miscompiles int64, which rules out range
+subdivision).
+
+Passes over the row:
+
+1. stats: row max, softmax denominator (online rescaling) and the OR / AND of
+   all keys, i.e. which key bits actually differ across the row;
+2. one search pass per group of ``BITS`` bits that contains a differing bit
+   (groups where every key agrees are skipped without reading the row; for
+   logits that started as bf16 the low 16 bits never differ);
+3. one pass for the tie count and weight at the cut key;
+4. one in-place write pass.
+
+The expensive cross-thread reductions run once per pass, never per block:
+lanes accumulate elementwise and are reduced after the loop. Weights are
+``exp2`` against an absolute threshold, so no per-element division remains.
+
+Only reductions, comparisons and scalar loop-carried values are used, so
+the kernel avoids the scan, sort, atomic and int64 constructs that are slow
+or broken on some Triton backends.
+"""
+
+import logging
+
+import torch
+import triton
+import triton.language as tl
+
+from flag_gems.runtime import torch_device_fn
+
+logger = logging.getLogger(__name__)
+
+# Annotated constexpr so the kernel may read them (Triton forbids plain
+# globals). _MIN32 is the 0x80000000 bit pattern, used to flip a key between
+# signed-comparison order and MSB-first radix order.
+_MIN32: tl.constexpr = -2147483648
+_LOG2E: tl.constexpr = 1.4426950408889634
+
+
+@triton.jit
+def _ordered_key(x):
+    """Order-preserving int32 key of a float32 value."""
+    # -0.0 + 0.0 == +0.0, so both zeros share one key (value semantics).
+    bits = (x + 0.0).to(tl.int32, bitcast=True)
+    return tl.where(bits < 0, bits ^ 0x7FFFFFFF, bits)
+
+
+@triton.jit
+def _lshr(x, s: tl.constexpr):
+    """Logical right shift of an int32 (Triton's >> is arithmetic)."""
+    if s == 0:
+        return x
+    return ((x >> 1) & 0x7FFFFFFF) >> (s - 1)
+
+
+@triton.jit
+def _bit_or(a, b):
+    return a | b
+
+
+@triton.jit
+def _bit_and(a, b):
+    return a & b
+
+
+@triton.jit
+def _top_p_mask_kernel(
+    logits_ptr,
+    p_ptr,
+    stride_row,
+    vocab_size,
+    BLOCK: tl.constexpr,
+    PASSES: tl.constexpr,
+    LOG2_BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    base = logits_ptr + row.to(tl.int64) * stride_row
+    offs = tl.arange(0, BLOCK)
+    thr = 1.0 - tl.load(p_ptr + row).to(tl.float32)
+
+    # ---- pass 1: row max, softmax denominator, OR/AND of the magnitude bits.
+    m_vec = tl.full([BLOCK], -3.0e38, tl.float32)
+    z_vec = tl.zeros([BLOCK], tl.float32)
+    or_vec = tl.zeros([BLOCK], tl.int32)
+    and_vec = tl.full([BLOCK], 0x7FFFFFFF, tl.int32)
+    for start in range(0, vocab_size, BLOCK):
+        idx = start + offs
+        valid = idx < vocab_size
+        x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32)
+        mag = (x + 0.0).to(tl.int32, bitcast=True) & 0x7FFFFFFF
+        or_vec = or_vec | tl.where(valid, mag, 0)
+        and_vec = and_vec & tl.where(valid, mag, 0x7FFFFFFF)
+        new_m = tl.maximum(m_vec, x)
+        # exp2 with a pre-scaled argument: no per-element division later.
+        z_vec = z_vec * tl.exp2((m_vec - new_m) * _LOG2E) + tl.where(
+            valid, tl.exp2((x - new_m) * _LOG2E), 0.0
+        )
+        m_vec = new_m
+    m = tl.max(m_vec, axis=0)
+    z = tl.sum(z_vec * tl.exp2((m_vec - m) * _LOG2E), axis=0)
+    m_or = tl.reduce(or_vec, 0, _bit_or)
+    m_and = tl.reduce(and_vec, 0, _bit_and)
+    # Magnitude bits that differ somewhere in the row. The key flips the
+    # magnitude bits of negative values, so a constant magnitude group is
+    # constant within a sign, whichever sign the search has settled on.
+    differ = m_or ^ m_and
+    # Absolute threshold on exp2 weights: sum(w[key <= k]) <= thr * z.
+    # Clamped below z so the whole row always exceeds it, which keeps the cut
+    # inside the key range (only reachable for p below ~6e-8, which vLLM
+    # rejects; valid p <= 1 is unaffected).
+    thr_z = tl.minimum(thr * z, z * 0.99999994)
+
+    # ---- pass 2: MSB-first radix select for the smallest radix key u with
+    # sum(w[u' <= u]) > thr_z. Two bits per pass: four one-dimensional
+    # accumulators, one per bucket, reduced once after the loop.
+    prefix = tl.zeros([], tl.int32)  # the bits of u decided so far
+    below = tl.zeros([], tl.float32)  # mass of keys below the subtree
+    for p_idx in tl.static_range(PASSES):
+        # Group 0 holds the sign bit and is always searched. Later groups
+        # whose magnitude bits agree across the row are taken without a read.
+        if p_idx > 0 and (_lshr(differ, 32 - (p_idx + 1) * 2) & 3) == 0:
