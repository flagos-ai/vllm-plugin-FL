+                u = _ordered_key(x) ^ _MIN32
+                if p_idx > 0:
+                    valid = valid & (_lshr(u, 32 - p_idx * 2) == prefix)
+                w = tl.where(valid, tl.exp2((x - m) * _LOG2E), 0.0)
+                bucket = _lshr(u, 32 - (p_idx + 1) * 2) & 3
+                a0 += tl.where(bucket == 0, w, 0.0)
+                a1 += tl.where(bucket == 1, w, 0.0)
+                a2 += tl.where(bucket == 2, w, 0.0)
+                a3 += tl.where(bucket == 3, w, 0.0)
