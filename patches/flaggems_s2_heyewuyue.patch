+_ROW_SLOT_CPU: Optional[torch.Tensor] = None
+_ROW_SLOT_NP = None
+_LAST_ROW_N: int = 0
+
+
+def shared_state(device):
+    global _TAGS, _STAGE_TAGS, _ROW_SLOT, _ROW_PROMPT, _ROW_SLOT_CPU, _ROW_SLOT_NP, _LAST_ROW_N
+    if _TAGS is None:
+        _TAGS = torch.full((SLOTS * WIN,), -1, dtype=torch.int32, device=device)
+        _STAGE_TAGS = [_TAGS] + [
+            torch.full((SLOTS * WIN,), -1, dtype=torch.int32, device=device)
+            for _ in range(3)
+        ]
+        _ROW_SLOT = torch.full((4096,), -1, dtype=torch.int32, device=device)
+        _ROW_PROMPT = torch.zeros_like(_ROW_SLOT)
+        _ROW_SLOT_CPU = torch.full((4096,), -1, dtype=torch.int32, pin_memory=True)
+        _ROW_SLOT_NP = _ROW_SLOT_CPU.numpy()
+        _LAST_ROW_N = 0
+    return _TAGS, _ROW_SLOT
+
+
+def layer_state(device, layer_idx: Optional[int] = None):
+    shared_state(device)
+    if layer_idx is None:
+        return _TAGS, _ROW_SLOT
+    from .pyramid_prefill import stage_of_layer
+    return _STAGE_TAGS[stage_of_layer(layer_idx)], _ROW_SLOT
+
+
+def set_rows(slots_cpu, reset: list, prompt_tokens_cpu=None) -> None:
+    """Model runner, once per step after the batch order is final: slot of each batch row (-1 = none); tags of newly
+    assigned slots are cleared (a slot's old entries belong to another request)."""
+    global _LAST_ROW_N
+    if _TAGS is None:
+        return
+    if reset:
+        from . import crosslayer
+        crosslayer.reset_slots(_TAGS.device, reset)
+        for s in reset:
+            for st in _STAGE_TAGS:
+                st[s * WIN:(s + 1) * WIN].fill_(-1)
+    if isinstance(slots_cpu, torch.Tensor):
+        n = int(slots_cpu.shape[0])
+        _ROW_SLOT_CPU[:n].copy_(slots_cpu)
+    else:
+        n = len(slots_cpu)
+        if n:
+            _ROW_SLOT_NP[:n] = slots_cpu
+    copy_n = n if n >= _LAST_ROW_N else _LAST_ROW_N
+    if n < _LAST_ROW_N:
+        _ROW_SLOT_NP[n:_LAST_ROW_N] = -1
+    if copy_n > 0:
+        _ROW_SLOT[:copy_n].copy_(_ROW_SLOT_CPU[:copy_n], non_blocking=True)
+    _LAST_ROW_N = n
