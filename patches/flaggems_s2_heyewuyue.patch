+            below += tl.where(first > 0, s0, 0.0) + tl.where(first > 1, s1, 0.0) + tl.where(first > 2, s2, 0.0)
+            prefix = (prefix << 2) | first
+    kstar = prefix ^ _MIN32
+
+    # ---- pass 3: tie count and weight at the cut key.
+    n_vec = tl.zeros([BLOCK], tl.int32)
+    w_vec = tl.zeros([BLOCK], tl.float32)
+    for start in range(0, vocab_size, BLOCK):
+        idx = start + offs
+        valid = idx < vocab_size
