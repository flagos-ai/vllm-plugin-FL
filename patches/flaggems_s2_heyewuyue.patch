--- /dev/null
+++ b/src/flag_gems/fused/minicpm/lin_own.py
@@ -0,0 +1,92 @@
+"""Own skinny bf16 linear for decode-size M (E019 attempts 16-17): out[M, N] = x[M, K] @ W[N, K]^T.
+
+Why: FlagGems' iluvatar `linear_kernel` (aten::linear under flag_gems.enable()) is wrong and non-deterministic for
+M = 2..8 at N >= 12288 (whole runs of output columns are garbage, e.g. the lm_head logits, E019 attempts 14-16).
+This kernel masks the activation rows explicitly (no `rm % M` wrap / max_contiguous hint), accumulates in fp32 over the
+whole K in one program (no split-K, no atomics), and writes every output element exactly once: bit-identical across
+calls. Tile configurations from the E019 attempt 17 sweep on BI-V150 (lm_head 130560 x 2048, graph-timed): M <= 8
+0.807 ms = 663 GB/s (the card's read ceiling is 657-661 GB/s, E007), faster than FlagGems at every M <= 64.
+
+The lm_head is the only bf16 linear left once W8A8 is on. Its logits go through `UnquantizedEmbeddingMethod.apply`
+(not an `UnquantizedLinearMethod`, so the W8A8 patch never sees it) into `torch.nn.functional.linear`, which
+flag_gems.enable() replaces. `patch_lm_head_linear_for_iluvatar` routes M <= 64 rows to the kernel below after a
+start-up self-check against a CPU fp32 reference; on failure nothing is patched and the stock path stays.
+"""
+import logging
+
+import torch
+import triton
+import triton.language as tl
+
+from .logging_utils import get_logger
+logger = get_logger(__name__)
+
+
+@triton.jit
+def _lin_kernel(X, W, O, M, sx, sw, so, K, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    pn = tl.program_id(0)
+    rn = (pn * BN + tl.arange(0, BN)).to(tl.int64)
+    rm = tl.arange(0, BM)
+    rk = tl.arange(0, BK)
+    mm = rm < M
+    a = X + rm[:, None] * sx + rk[None, :]
+    b = W + rn[None, :] * sw + rk[:, None]
+    acc = tl.zeros([BM, BN], dtype=tl.float32)
+    for _ in range(0, K, BK):
+        acc += tl.dot(tl.load(a, mask=mm[:, None], other=0.0), tl.load(b))
+        a += BK
+        b += BK
+    tl.store(O + rm[:, None] * so + rn[None, :], acc.to(O.dtype.element_ty), mask=mm[:, None])
+
+
+# (max M, BM, BN, BK, warps), one stage: lm_head sweep, E019 attempt 17
+_CFG = ((8, 16, 256, 64, 8), (16, 16, 32, 128, 2), (32, 32, 128, 64, 4), (64, 64, 256, 64, 8))
+MAX_M = 64
+
+
+def _cfg(m: int):
+    for c in _CFG:
+        if m <= c[0]:
+            return c[1:]
+    return None
+
+
+def usable(x: torch.Tensor, w: torch.Tensor) -> bool:
+    if not (x.dtype == torch.bfloat16 and w.dtype == torch.bfloat16 and w.dim() == 2 and x.dim() == 2
+            and 1 <= x.shape[0] <= MAX_M and x.stride(1) == 1 and w.stride(1) == 1 and w.shape[1] == x.shape[1]):
+        return False
+    bm, bn, bk, _ = _cfg(x.shape[0])
+    return w.shape[0] % bn == 0 and w.shape[1] % bk == 0
+
+
+def linear_small(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+    m, k = x.shape
+    n = w.shape[0]
+    bm, bn, bk, warps = _cfg(m)
+    out = torch.empty((m, n), dtype=x.dtype, device=x.device)
+    _lin_kernel[(n // bn,)](x, w, out, m, x.stride(0), w.stride(0), out.stride(0), k, BM=bm, BN=bn, BK=bk,
+                            num_warps=warps, num_stages=1)
+    return out
+
+
+def self_check(device) -> float:
+    """Worst relative error (max abs / max |ref|) of the kernel for every M bucket; the reference runs on CPU,
+    out of FlagGems' reach. Also fails on non-finite output or on repeated calls that differ."""
+    g = torch.Generator(device=device).manual_seed(0)
+    n, k = 2048, 2048
+    w = (torch.randn((n, k), device=device, generator=g) * 0.02).to(torch.bfloat16)
+    wc = w.cpu().float()
+    worst = 0.0
+    for m in (1, 3, 8, 9, 16, 17, 32, 33, 64):
+        x = torch.randn((m, k), device=device, generator=g).to(torch.bfloat16)
+        out = linear_small(x, w)
+        again = linear_small(x, w)
+        out_c = out.float().cpu()
+        if not torch.isfinite(out_c).all() or not torch.equal(out, again):
+            logger.warning("BI-V150 lm_head linear self-check: non-finite or non-repeatable output at M=%d", m)
+            return float("inf")
+        ref = x.cpu().float() @ wc.T
+        worst = max(worst, ((out_c - ref).abs().max() / ref.abs().max().clamp_min(1e-6)).item())
+    return worst
+
+
