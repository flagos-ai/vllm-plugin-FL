+    kd, vd = dequant_pages(c8.cpu())
+    tab = table.cpu()
+    bad = tot = 0
+    for i, n in enumerate(lens):
+        pos = torch.arange(n)
+        b = tab[i, pos // PAGE].long()
+        for got, want in ((kd[b, pos % PAGE], quant_k_ref(ks[i])), (vd[b, pos % PAGE], quant_v_ref(vs[i]))):
+            bad += ((got - want).abs() > 1e-3 * want.abs().amax().clamp_min(1e-6)).sum().item()
+            tot += got.numel()
+    res["write_mismatch"] = bad / tot
+    tc = tags.cpu()
+    t_ok = all(int(tc[s * WIN + p % WIN]) == p for i, s in enumerate(slots) if s >= 0 for p in range(max(0, lens[i] - WIN), lens[i]))
+    res["window_tags"] = 0.0 if t_ok else 1.0
