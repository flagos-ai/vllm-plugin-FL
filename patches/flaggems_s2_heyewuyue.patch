+    N = w_i8.shape[0]
+    out = torch.empty((M, N), dtype=torch.bfloat16, device=x.device)
+    BM, BN, BK = 64, 128, 128
+    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)
+    _w8a8_nt_kernel[grid](
