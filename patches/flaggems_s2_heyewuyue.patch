+"""Packed W4 gate/up producer for the M64 group-A8 MLP.
+
+Numerical contract: q4 is signed [-8,7], the matrix operands decode to q4<<4,
+and scale16 is the original W4 row scale divided by 16. The result must match
+the frozen E214 producer running the expanded q4<<4 image with scale16.
+The native core changes only ownership and supply; BF16/SiLU/H128/A8 stay.
+"""
+import torch
+import triton
+import triton.language as tl
+import triton.experimental.tle.language.gpu as tleg
+
+from ._gu_m32_w4_layout import core_assembly, h32_assembly, max8_assembly
+
+
+CORE = tl.constexpr(core_assembly())
+CORE_CONS = tl.constexpr(",".join([f"=&{{v{i}}}" for i in range(64)] +
+                                [f"=&{{s{i}}}" for i in range(48)] +
+                                ["r"] * 10 + ["~{memory}"]))
+H32 = tl.constexpr(h32_assembly())
+H32_CONS = tl.constexpr(",".join(["=&r"] * 33 + [str(i) for i in range(16)] + ["r"]))
+MAX8 = tl.constexpr(max8_assembly())
+MAX8_CONS = tl.constexpr(",".join(["=&r"] * 17 + [str(i) for i in range(8)] + ["r"]))
+
+
+@triton.jit
+def pack_b4(W, P, LUT, K: tl.constexpr):
+    pair, kc = tl.program_id(0), tl.program_id(1)
+    i = tl.arange(0, 1024)
+    nf = pair * 2 + i // 512
+    word, lane, byte = (i % 512) // 256, (i % 256) // 4, i % 4
+    n = nf * 16 + lane % 16
+    k = kc * 64 + word * 32 + 4 * (lane // 16) + byte
+    lo = tl.load(W + n * K + k).to(tl.int32) & 15
+    hi = tl.load(W + n * K + k + 16).to(tl.int32) & 15
+    offset = ((nf // 16) * (K // 64) + kc) * 8192 + (pair % 8) * 1024
+    tl.store(P + offset + tl.load(LUT + i), (lo | (hi << 4)).to(tl.uint8))
+
+
+@triton.jit
+def producer(A, B, SA, SB16, Q, S, RAW, K: tl.constexpr, F: tl.constexpr,
+             RAW_INTEGER: tl.constexpr = False):
+    pn = tl.program_id(0)
+    tid = tl.arange(0, 512)
+    warp, lane, z = tid // 64, tid % 64, tid * 0
+    rowbase, quarter = (warp // 4) * 32 + lane // 16, warp % 4
+    colbase = pn * 256 + quarter * 32 + lane % 16
+    # 8KiB double A + 16KiB double packed B. After the native core completes,
+    # the entire same 32KiB allocation becomes sixteen FP32 word planes.
+    scratch = tleg.alloc((8192,), tl.float32, scope=tleg.smem, nv_mma_shared_layout=False)
+    ptr = tleg.local_ptr(scratch, (0,))
+    tl.store(ptr, 0.)
+    tl.debug_barrier()
+    ap = (A + warp * (16 * K) + z).to(tl.uint64)
+    bp = (B + pn * (K // 64) * 8192 + warp * 1024 + z).to(tl.uint64)
+    values = tl.inline_asm_elementwise(
+        CORE, CORE_CONS,
+        [(ap & 0xffffffff).to(tl.int32), (ap >> 32).to(tl.int32),
+         (bp & 0xffffffff).to(tl.int32), (bp >> 32).to(tl.int32),
+         z + K // 64, z + K, warp,
+         ptr.to(tl.uint64).to(tl.int32) + z,
+         (ptr + 2048).to(tl.uint64).to(tl.int32) + z, lane * 4],
+        dtype=(tl.int32,) * 112, is_pure=False, pack=1)
+    tl.debug_barrier()
+    if RAW_INTEGER:
+        for gu in tl.static_range(2):
+            for nf in tl.static_range(2):
+                for mt in tl.static_range(2):
+                    for r in tl.static_range(4):
+                        row = rowbase + mt * 16 + 4 * r
+                        col = pn * 128 + quarter * 32 + nf * 16 + lane % 16 + gu * F
+                        tl.store(RAW + row * (2 * F) + col, values[gu * 16 + nf * 8 + mt * 4 + r])
+        return
+
+    activated = ()
+    for nf in tl.static_range(2):
+        for mt in tl.static_range(2):
+            for r in tl.static_range(4):
+                sa = tl.load(SA + rowbase + mt * 16 + 4 * r)
+                sg = tl.load(SB16 + colbase + nf * 16)
+                su = tl.load(SB16 + colbase + nf * 16 + 128)
+                # Preserve the frozen expanded-image multiplication order.
+                gate = (values[nf * 8 + mt * 4 + r].to(tl.float32) * sa * sg).to(tl.bfloat16).to(tl.float32)
+                up = (values[16 + nf * 8 + mt * 4 + r].to(tl.float32) * sa * su).to(tl.bfloat16).to(tl.float32)
+                value = (gate * tl.sigmoid(gate) * up).to(tl.bfloat16).to(tl.float32)
+                activated += (value,)
+    h = tl.inline_asm_elementwise(H32, H32_CONS, activated + (lane,),
+                                 dtype=(tl.float32,) * 33, is_pure=False, pack=1)
+    for i in tl.static_range(16):
+        tl.store(ptr + i * 512 + tid, h[i])
+    tl.debug_barrier()
+    outputs, maxima = (), ()
+    for i in tl.static_range(16):
+        x = h[i]
+        x1 = tl.load(ptr + i * 512 + (tid ^ 64))
+        x2 = tl.load(ptr + i * 512 + (tid ^ 128))
+        x3 = tl.load(ptr + i * 512 + (tid ^ 192))
+        # Logical Hadamard bit5, then bit6: exactly the frozen H64
+        # register-bit8 stage followed by the cross-warp H128 stage.
+        p0, p1 = x + x1, x2 + x3
+        n0 = tl.where((quarter & 1) == 0, x - x1, x1 - x)
+        n1 = tl.where((quarter & 1) == 0, x2 - x3, x3 - x2)
+        pp = ((p0 + p1) * (128 ** -.5)).to(tl.bfloat16).to(tl.float32)
+        np = ((n0 + n1) * (128 ** -.5)).to(tl.bfloat16).to(tl.float32)
+        pn_value = (tl.where(quarter < 2, p0 - p1, p1 - p0) * (128 ** -.5)).to(tl.bfloat16).to(tl.float32)
+        nn = (tl.where(quarter < 2, n0 - n1, n1 - n0) * (128 ** -.5)).to(tl.bfloat16).to(tl.float32)
+        own = tl.where(quarter == 0, pp, tl.where(quarter == 1, np, tl.where(quarter == 2, pn_value, nn)))
+        both = tl.maximum(tl.maximum(tl.abs(pp), tl.abs(np)), tl.maximum(tl.abs(pn_value), tl.abs(nn)))
+        outputs += (own,)
+        maxima += (both,)
+    local_max = ()
+    for r in tl.static_range(8):
+        local_max += (tl.maximum(maxima[r], maxima[r + 8]),)
+    mx = tl.inline_asm_elementwise(MAX8, MAX8_CONS, local_max + (lane,),
+                                  dtype=(tl.float32,) * 17, is_pure=False, pack=1)
+    for rr in tl.static_range(8):
+        row = rowbase + (rr // 4) * 16 + (rr % 4) * 4
+        scale = tl.maximum(mx[rr], 1.e-8) / 127.
+        tl.store(S + row * (F // 128) + pn, scale, mask=(quarter == 0) & (lane % 16 == 0))
+        for nf in tl.static_range(2):
+            value = outputs[nf * 8 + rr]
+            code = tl.minimum(tl.maximum(tl.floor(value / scale + .5), -127.), 127.).to(tl.int8)
+            col = pn * 128 + quarter * 32 + nf * 16 + lane % 16
+            tl.store(Q + row * F + col, code)
+
+
+def prepare_weight(q4, scale16):
+    from flag_gems.fused.minicpm._native_pair_mlp import lut
+    assert q4.ndim == 2 and q4.dtype == torch.int8 and q4.is_contiguous()
+    n, k = q4.shape
+    assert n % 256 == 0 and k % 64 == 0
+    assert scale16.dtype == torch.float32 and scale16.numel() == n
+    f = n // 2
+    paired = q4.view(2, f // 128, 128, k).permute(1, 0, 2, 3).contiguous().view(n, k)
+    ps = scale16.reshape(2, f // 128, 128).permute(1, 0, 2).contiguous().flatten()
+    packed = torch.empty(n * k // 2, dtype=torch.uint8, device=q4.device)
+    pack_b4[(n // 32, k // 64)](paired, packed, lut(q4.device), K=k, num_warps=4)
+    return packed, ps
+
+
+def run(q, scale, packed, weight_scale16, codes, scales, raw=None):
+    assert q.ndim == 2 and q.shape[0] == 64 and q.dtype == torch.int8
+    assert scale.dtype == torch.float32 and weight_scale16.dtype == torch.float32
+    assert codes.dtype == torch.int8 and scales.dtype == torch.float32
+    assert packed.dtype == torch.uint8 and packed.is_contiguous()
+    k, f = q.shape[1], codes.shape[1]
+    assert k % 64 == 0 and f % 128 == 0
+    assert packed.numel() == f * k and weight_scale16.numel() == 2 * f
+    assert tuple(scales.shape) == (64, f // 128)
+    if raw is not None:
+        assert tuple(raw.shape) == (64, 2 * f) and raw.dtype == torch.int32
+    return producer[(f // 128,)](q, packed, scale, weight_scale16, codes, scales,
+        codes if raw is None else raw, K=k, F=f, RAW_INTEGER=raw is not None,
+        num_warps=8, num_stages=1)
+
+
+@triton.jit
+def fit_weight(X, Q, SCALE, K: tl.constexpr, WIDTH: tl.constexpr,
+               BLOCK: tl.constexpr, ROW_SCALE: tl.constexpr):
+    row, group = tl.program_id(0), tl.program_id(1)
+    r = tl.arange(0, BLOCK)
+    x = tl.load(X + row * K + group * WIDTH + r, r < WIDTH, other=0.).to(tl.float32)
+    base = tl.maximum(tl.max(tl.abs(x), 0), 1.e-8) / 7.
+    best, best_error = base, tl.full((), float("inf"), tl.float32)
+    for j in tl.static_range(8):
+        factor = (0.65 + 0.06 * j) if ROW_SCALE else (0.70 + 0.05 * j)
+        scale = base * factor
+        q = tl.minimum(tl.maximum(tl.floor(x / scale + 0.5), -8.), 7.)
+        delta = x - q * scale
+        error = tl.sum(tl.where(r < WIDTH, delta * delta, 0.), 0)
+        best = tl.where(error < best_error, scale, best)
+        best_error = tl.minimum(best_error, error)
+    q = tl.minimum(tl.maximum(tl.floor(x / best + 0.5), -8.), 7.)
+    tl.store(Q + row * K + group * WIDTH + r, q.to(tl.int8), r < WIDTH)
+    tl.store(SCALE + row * (K // WIDTH) + group, best)
+
+
+@triton.jit
+def unpack_tiled(B, C, LUT, N: tl.constexpr, K: tl.constexpr):
+    pn, kc = tl.program_id(0), tl.program_id(1)
+    i = tl.arange(0, 8192)
+    pair, j = i // 1024, i % 1024
+    nf = 2 * pair + j // 512
+    word, lane, byte = (j % 512) // 256, (j % 256) // 4, j % 4
+    n = nf * 16 + lane % 16
+    k = word * 32 + 4 * (lane // 16) + byte
+    byte4 = tl.load(B + (pn * (K // 64) + kc) * 8192 + pair * 1024 + tl.load(LUT + j)).to(tl.int32)
+    buf = tleg.alloc((16384,), tl.uint8, scope=tleg.smem, nv_mma_shared_layout=False)
+    ptr = tleg.local_ptr(buf, (0,))
+    row_mask = (n % 8) * 4
+    tl.store(ptr + n * 64 + (k ^ row_mask), (byte4 << 4).to(tl.uint8))
+    tl.store(ptr + n * 64 + ((k + 16) ^ row_mask), (byte4 & 240).to(tl.uint8))
+    tl.debug_barrier()
+    for offset in tl.static_range(2):
+        index = i + offset * 8192
+        rn, rk = index // 64, index % 64
+        value = tl.load(ptr + rn * 64 + (rk ^ ((rn % 8) * 4)))
+        logical_n = pn * 128 + rn % 128 + (rn // 128) * (N // 2)
+        tl.store(C + logical_n * K + kc * 64 + rk, value.to(tl.int8))
+
+
+def expand(weight, n, k):
+    from flag_gems.fused.minicpm._native_pair_mlp import lut
+
+    out = torch.empty((n, k), dtype=torch.int8, device=weight.device)
+    unpack_tiled[(n // 256, k // 64)](weight, out, lut(weight.device), N=n, K=k, num_warps=4, num_stages=1)
+    return out
diff --git a/src/flag_gems/fused/minicpm/_gu_m32_w4_layout.py b/src/flag_gems/fused/minicpm/_gu_m32_w4_layout.py
new file mode 100644
index 0000000..dbef7c8
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_gu_m32_w4_layout.py
@@ -0,0 +1,144 @@
+"""Warp ownership and register layout helpers for M32 W4 gate/up projection on BI-V150."""
+
+
+def output_coordinate(warp, lane, accumulator):
+    gu, rem = divmod(accumulator, 16)
+    nf, rem = divmod(rem, 8)
+    mt, r = divmod(rem, 4)
+    return ((warp // 4) * 32 + mt * 16 + lane // 16 + 4 * r,
+            gu * 128 + (warp % 4) * 32 + nf * 16 + lane % 16)
+
+
+def a_lds_offset(warp, lane, step, mt, word):
+    """Byte address relative to the current natural-A SME stage."""
+    kw = 2 * step + word
+    return (warp // 4) * 2048 + mt * 1024 + ((4 * lane + kw * 64) & 255) + kw * 256
+
+
+def b_lds_offset(warp, lane, step, gu, nf):
+    """Byte address of four packed nibbles, relative to current B stage."""
+    return (warp % 4) * 1024 + gu * 4096 + nf * 512 + step * 256 + 4 * lane
+
+
+def core_assembly():
+    e = []
+    emit = e.append
+    # v0..31 accumulators; v32..39 two K32 A sets; v40..47 packed B;
+    # v48/49 decoded B; v50 lane-byte; v51 address; v52 B base. All fixed registers
+    # are declared by the consumer, including scalar temporaries.
+    for i, reg in enumerate((16, 17, 20, 21, 36, 37, 38, 39, 40)):
+        emit(f"ml_mov_v2s_b32 s{reg}, ${112 + i}, 0x0")
+    emit("ml_mov_b32 v50, $121")
+    emit("sl_mov_b32 s18, 0x40000000")
+    emit("sl_mov_b32 s19, s37")
+    emit("sl_mov_b32 s22, 0x40000000")
+    emit("sl_mov_b32 s23, 0x40")
+    for reg in range(32):
+        emit(f"ml_mov_b32 v{reg}, 0x0")
+    emit("sl_mov_b32 s2, 0x0")
+
+    def copy(stage, label):
+        # Four M16 natural-A tiles are transported once per CTA.
+        emit("sl_cmp_lt_i32 wcr, s38, 0x4")
+        emit(f"sl_cbr_wcrz .Le253_skipA_{label}")
+        emit("sl_shl_b32 s4, s38, 0xa")
+        emit(f"sl_add_i32 s33, s39, {stage}")
+        emit("sl_add_i32 s33, s33, s4")
+        emit("sl_mov_b32 s32, 0x0")
+        emit("sl_sme_load_16x1b64_rowxfb8 s[16:19], s[32:33], 0x0, 0x0, 0x0, 0x1")
+        emit(f".Le253_skipA_{label}:")
+        # Eight packed 1024B B units remain compressed through LDS.
+        emit("sl_shl_b32 s4, s38, 0xa")
+        emit(f"sl_shl_b32 s5, {stage}, 0x1")
+        emit("sl_add_i32 s31, s40, s5")
+        emit("sl_add_i32 s31, s31, s4")
+        emit("sl_mov_b32 s30, 0x0")
+        emit("sl_sme_load_16x1b64_rowxfb8 s[20:23], s[30:31], 0x0, 0x0, 0x0, 0x1")
+        emit("sl_add_i64 s[16:17], s[16:17], 0x40")
+        emit("sl_add_i64 s[20:21], s[20:21], 0x2000")
+
+    copy("s2", "first")
+    emit(".Le253_k64:")
+    emit("sl_wait g2scnt(0)")
+    emit("sl_barrier")
+    emit("sl_xor_b32 s3, s2, 0x1000")
+    emit("sl_cmp_gt_i32 wcr, s36, 0x1")
+    emit("sl_cbr_wcrz .Le253_no_next")
+    copy("s3", "next")
+    emit(".Le253_no_next:")
+    emit("sl_srl_b32 s6, s38, 0x2")
+    emit("sl_shl_b32 s6, s6, 0xb")
+    emit("sl_add_i32 s6, s6, s39")
+    emit("sl_add_i32 s6, s6, s2")
+    emit("sl_add_i32 s8, s6, 0x400")
+    emit("sl_and_b32 s7, s38, 0x3")
+    emit("sl_shl_b32 s7, s7, 0xa")
+    emit("sl_shl_b32 s5, s2, 0x1")
+    emit("sl_add_i32 s7, s7, s40")
+    emit("sl_add_i32 s7, s7, s5")
+    emit("ml_add_i32 v52, s7, v50")
+    # Sixteen loads are issued before consumption: eight per K32. The
+    # pending-count waits preserve the proven E245 producer-consumer order.
+    for step in range(2):
+        for mt in range(2):
+            for w in range(2):
+                kw = 2 * step + w
+                emit(f"ml_add_i32 v51, v50, 0x{kw * 64:x}")
+                emit("ml_and_b32 v51, v51, 0xff")
+                emit(f"ml_add_i32 v51, s{6 if mt == 0 else 8}, v51")
+                emit(f"ml_slb_load_b32x1 v{32 + step * 4 + mt * 2 + w}, v51, noreg, #{kw * 256}, null")
+        for gu in range(2):
+            for nf in range(2):
+                off = gu * 4096 + nf * 512 + step * 256
+                emit(f"ml_add_i32 v51, v52, 0x{off:x}")
+                emit(f"ml_slb_load_b32x1 v{40 + step * 4 + gu * 2 + nf}, v51, noreg, #0, null")
+    for step in range(2):
+        emit(f"sl_wait lmcnt({8 if step == 0 else 0})")
+        for gu in range(2):
+            for nf in range(2):
+                packed = 40 + step * 4 + gu * 2 + nf
+                emit(f"ml_shl_b32 v48, v{packed}, 0x4")
+                emit("ml_and_b32 v48, v48, 0xf0f0f0f0")
+                emit(f"ml_and_b32 v49, v{packed}, 0xf0f0f0f0")
+                for mt in range(2):
+                    acc = gu * 16 + nf * 8 + mt * 4
+                    a = 32 + step * 4 + mt * 2
+                    emit(f"ml_matrix_mad_i32_i8_m16n16k32 v[{acc}:{acc+3}], v[{a}:{a+1}], v[48:49], v[{acc}:{acc+3}]")
+    emit("sl_add_i32 s36, s36, 0xffffffff")
+    emit("sl_mov_b32 s2, s3")
+    emit("sl_cmp_gt_i32 wcr, s36, 0x0")
+    emit("sl_cbr_wcrnz .Le253_k64")
+    return ";\n".join(e) + ";\n"
+
+
+def h32_assembly():
+    e = []
+    for bit in range(4):
+        e.append(f"ml_xor_b32 $32, $49, 0x{1 << bit:x}")
+        for reg in range(16):
+            e.append(f"ml_slb_shuffle_rtn_b32 ${16+reg}, ${reg}, $32")
+        e.append("sl_wait lmcnt(0)")
+        e.append(f"ml_shl_b32 $32, $49, 0x{31-bit:x}")
+        e.append("ml_and_b32 $32, $32, 0x80000000")
+        for reg in range(16):
+            e.append(f"ml_xor_b32 ${reg}, ${reg}, $32")
+            e.append(f"ml_add_f32 ${reg}, ${reg}, ${16+reg}")
+    # Register bit 3 is logical column bit4. Bits5/6 are the two
+    # cross-warp dimensions, and must be evaluated in this order later.
+    for reg in range(8):
+        e.append(f"ml_add_f32 $32, ${reg}, ${reg+8}")
+        e.append(f"ml_sub_f32 ${reg+8}, ${reg}, ${reg+8}")
+        e.append(f"ml_mov_b32 ${reg}, $32")
+    return ";\n".join(e) + ";\n"
+
+
+def max8_assembly():
+    e = []
+    for bit in range(4):
+        e.append(f"ml_xor_b32 $16, $25, 0x{1 << bit:x}")
+        for reg in range(8):
+            e.append(f"ml_slb_shuffle_rtn_b32 ${8+reg}, ${reg}, $16")
+        e.append("sl_wait lmcnt(0)")
+        for reg in range(8):
+            e.append(f"ml_max_f32 ${reg}, ${reg}, ${8+reg}")
+    return ";\n".join(e) + ";\n"
diff --git a/src/flag_gems/fused/minicpm/_h128_basis.py b/src/flag_gems/fused/minicpm/_h128_basis.py
new file mode 100644
index 0000000..cb6842f
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_h128_basis.py
@@ -0,0 +1,42 @@
+"""Shared 128-point Hadamard basis rotation kernel for BI-V150 MLP down projection."""
+import torch
+import triton
+import triton.language as tl
+from . import w8a8 as W
+
+@triton.jit(do_not_specialize=["M"])
+def rotate(X,H,T,BA,M,K:tl.constexpr,BM:tl.constexpr):
+    row=tl.program_id(0)*BM+tl.arange(0,BM);blk=tl.program_id(1);c=tl.arange(0,128)
+    x=tl.load(X+row[:,None]*K+blk*128+c[None,:],mask=row[:,None]<M,other=0.)
+    h=tl.load(H+c[:,None]*128+c[None,:]);y=(tl.dot(x,h)*(128**-.5)).to(tl.bfloat16)
+    tl.store(T+row[:,None]*K+blk*128+c[None,:],y)
+    tl.store(BA+row*(K//128)+blk,tl.max(tl.abs(y.to(tl.float32)),1))
+
+
+def quant_act(x,mp=0):
+    m,k=x.shape;mp=mp or m;bm=16 if m<=64 else 64
+    rows=triton.cdiv(mp,bm)*bm;groups=k//128
+    t=torch.empty((rows,k),device=x.device,dtype=torch.bfloat16)
+    ba=torch.empty((rows,groups),device=x.device,dtype=torch.float32)
+    q=torch.empty((mp,k),device=x.device,dtype=torch.int8);s=torch.empty((mp,),device=x.device,dtype=torch.float32)
+    rotate[(rows//bm,groups)](x,W._h128(x.device),t,ba,M=m,K=k,BM=bm,num_warps=4,num_stages=1)
+    W._quant_from1_kernel[(mp,)](t,ba,q,s,k,k,groups,K=k,KP=triton.next_power_of_2(k),NBP=triton.next_power_of_2(groups),num_warps=8)
+    return q,s
+
+
+def quant_weight(weight):
+    return quant_act(weight.contiguous())
+
+
+def linear(x:torch.Tensor,weight:torch.Tensor,scale:torch.Tensor)->torch.Tensor:
+    """Standalone H128 down projection; same persistent image as fused MLP."""
+    m,k=x.shape;n=weight.shape[0]
+    if m==0:return torch.empty((0,n),device=x.device,dtype=x.dtype)
+    bm,bn,bk,nw,ns,grp=W._cfg(m,k,n);mp=triton.cdiv(m,bm)*bm
+    q,s=quant_act(x,mp);out=torch.empty((mp,n),device=x.device,dtype=torch.bfloat16)
+    W._gemm_kernel[(triton.cdiv(m,bm)*(n//bn),)](q,weight,out,s,scale,n,k,BM=bm,BN=bn,BK=bk,GROUP=grp,NPM=triton.cdiv(m,bm),num_warps=nw,num_stages=ns)
+    return out[:m]
+
+
+def linear_fake(x:torch.Tensor,weight:torch.Tensor,scale:torch.Tensor)->torch.Tensor:
+    return torch.empty((x.shape[0],weight.shape[0]),device=x.device,dtype=x.dtype)
diff --git a/src/flag_gems/fused/minicpm/_inverse_fp32.py b/src/flag_gems/fused/minicpm/_inverse_fp32.py
new file mode 100644
index 0000000..31f8f4e
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_inverse_fp32.py
@@ -0,0 +1,36 @@
+"""Experimental direct-FP32 H128 inverse, production selection unchanged."""
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _reduce_inverse_fp32(PO, PM, PL, O, CU_Q, SIGN, s_o0, s_o1,
+                              S: tl.constexpr, inv_sqrt_d: tl.constexpr,
+                              SP: tl.constexpr, HEADS: tl.constexpr = 4):
+    seq = tl.program_id(0)
+    head = tl.program_id(1) * HEADS + tl.arange(0, HEADS)
+    row = tl.load(CU_Q + seq)
+    if tl.load(CU_Q + seq + 1) - row != 1:
+        return
+    si = tl.arange(0, SP)
+    d = tl.arange(0, 128)
+    base = seq * S * 16
+    m = tl.load(PM + base + si[:, None] * 16 + head[None, :], mask=(si < S)[:, None], other=float('-inf'))
+    l = tl.load(PL + base + si[:, None] * 16 + head[None, :], mask=(si < S)[:, None], other=0.)
+    mx = tl.max(m, 0)
+    mx = tl.where(mx > float('-inf'), mx, 0.)
+    denom = tl.sum(tl.exp2(m - mx[None, :]) * l, 0)
+    denom = tl.where(denom > 0., denom, 1.)
+    acc = tl.zeros((HEADS, 128), tl.float32)
+    for s in range(S):
+        weight = tl.exp2(tl.load(PM + base + s * 16 + head) - mx)
+        acc += tl.load(PO + (base + s * 16 + head)[:, None] * 128 + d[None, :]) * weight[:, None]
+    x = acc / denom[:, None]
+    # FP32 butterfly no longer needs the BF16 hi/residual approximation used by MMA.
+    for stage in tl.static_range(7):
+        bit = 1 << stage
+        idx = tl.broadcast_to((d ^ bit)[None, :], (HEADS, 128))
+        partner = tl.gather(x, idx, axis=1)
+        x = tl.where((d[None, :] & bit) == 0, x + partner, partner - x)
+    y = x * inv_sqrt_d * tl.load(SIGN + d)[None, :]
+    tl.store(O + row.to(tl.int64) * s_o0 + head[:, None] * s_o1 + d[None, :], y.to(O.dtype.element_ty))
diff --git a/src/flag_gems/fused/minicpm/_kv_pipeline.py b/src/flag_gems/fused/minicpm/_kv_pipeline.py
new file mode 100644
index 0000000..95c53b5
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_kv_pipeline.py
@@ -0,0 +1,100 @@
+"""Exact v14 payload lookahead in native-window register holes.
+
+Two compute copies alternate K/V/meta banks. The source loop is transformed
+structurally; current arithmetic and page order are unchanged. No payload MOV
+swaps, additional VGPRs, shared memory, or unconditional out-of-range loads.
+"""
+import re
+
+CURRENT=set(range(56,60))|set(range(64,72))|set(range(80,88))
+LOOKAHEAD=set(range(60,64))|set(range(72,80))|set(range(88,96))
+
+
+def _registers(text):
+    result=set()
+    for m in re.finditer(r'v\[(\d+):(\d+)\]|\bv(\d+)\b',text):
+        if m.group(3) is not None:result.add(int(m.group(3)))
+        else:result.update(range(int(m.group(1)),int(m.group(2))+1))
+    return result
+
+
+def _rename(text,bank):
+    def reg(n):
+        if not bank:return n
+        if 56<=n<=59:return n+4
+        if 64<=n<=71 or 80<=n<=87:return n+8
+        return n
+    def replace(m):
+        if m.group(3) is not None:return 'v'+str(reg(int(m.group(3))))
+        a,b=int(m.group(1)),int(m.group(2));ra,rb=reg(a),reg(b)
+        assert rb-ra==b-a,('noncontiguous native operand',m.group(0))
+        return f'v[{ra}:{rb}]'
+    return re.sub(r'v\[(\d+):(\d+)\]|\bv(\d+)\b',replace,text)
+
+
+def pipeline(code):
+    prefix,loop=code.split('.Lk14_loop:;\n',1)
+    initial,rest=loop.split('sl_wait vmcnt(0);\n',1)
+    compute,tail=rest.split('sl_add_i32 s20, s20, 0x1;',1)
+    _,slow_final=tail.split('.Lk14_slow:;\n',1)
+    slow,final=slow_final.split('.Lk14_done:;\n',1)
+    slow='.Lk14_slow:;\n'+slow
+    # Prefetch destinations must be dead for the *whole* current compute,
+    # including lazy-max rescaling paths. Preserve current source descriptors.
+    assert not(_registers(compute+slow)&LOOKAHEAD),('VGPR interference',_registers(compute+slow)&LOOKAHEAD)
+    assert not re.search(r'\bs(?:[4-7]|14|15)\b|s\[(?:4|5|6|7|14|15):',compute+slow),'SGPR interference'
+    _,payload=initial.split('sl_wait smcnt(0);\n',1)
+    assert 'sl_mul_i64_i32 s[10:11], s8,'in payload
+    assert payload.count('sl_add_i64 s[40:41], s[16:17], s[10:11]')==1
+    assert 'sl_wait'not in payload
+    # Global descriptor s4:7 and page-id s14 are unused by current arithmetic.
+    def future_id(delta,label):
+        return ('sl_add_i32 s15, s20, 0x%x;\nsl_cmp_lt_i32 wcr, s15, s21;\n'
+                'sl_cbr_wcrz %s;\nsl_shl_b32 s9, s15, 0x2;\n'
+                'sl_lsa_load_b32x1 s14, s[36:37], s9, #0, ca;\n%s:;\n')%(delta,label,label)
+    def prefetch(bank,label):
+        packet=_rename(payload,bank).replace('s[40:41]','s[4:5]').replace('s[40:43]','s[4:7]')
+        packet=packet.replace('s[10:11], s8,','s[10:11], s14,')
+        return ('sl_add_i32 s15, s20, 0x1;\nsl_cmp_lt_i32 wcr, s15, s21;\n'
+                f'sl_cbr_wcrz .Lpipe_no_next_{label};\nsl_wait smcnt(0);\n'+packet+
+                future_id(2,f'.Lpipe_no_future_{label}')+f'.Lpipe_no_next_{label}:;\n')
+    def body(bank,label,other):
+        main=_rename(compute,bank).replace('.Lk14_',f'.Lpipe{label}_')
+        return (f'.Lpipe{label}_head:;\n'+prefetch(1-bank,label)+main+
+            'sl_add_i32 s20, s20, 0x1;\nsl_cmp_lt_i32 wcr, s20, s21;\n'
+            'sl_cbr_wcrz .Lk14_done;\nsl_wait vmcnt(0);\n'+f'sl_jump .Lpipe{other}_head;\n')
+    result=prefix+'sl_mov_b32 s6, 0x40000000;\nsl_mov_b32 s7, 0xffffffff;\n'+initial
+    result+=future_id(1,'.Lpipe_initial_no_next')+'sl_wait vmcnt(0);\n'
+    result+=body(0,'A','B')+body(1,'B','A')
+    result+=_rename(slow,0).replace('.Lk14_','.LpipeA_')+_rename(slow,1).replace('.Lk14_','.LpipeB_')
+    result+='.Lk14_done:;\n'+final
+    assert max(_registers(result))==max(_registers(code))
+    return result
+
+
+def normalize_v2(code):
+    """Lift existing K-only pipeline into the exact single-packet source form.
+
+    Arithmetic is byte-for-byte retained; only original asynchronous loads,
+    descriptors and associated waits are replaced before applying pipeline().
+    """
+    prefix,rest=code.split('.Lk14_loop:;\n',1)
+    start=prefix.rindex('sl_mull_u32 s9, s20, 0x4;\n')
+    prefix=prefix[:start]
+    loads,compute=rest.split('.Lk15_nx:;\n',1)
+    compute=compute.replace('sl_wait vmcnt(12);\n','').replace('sl_wait vmcnt(8);\n','').replace('sl_wait vmcnt(10);\n','')
