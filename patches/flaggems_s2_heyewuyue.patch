+def int4_splits(n_decode: int) -> int:
+    """KV splits per decode row (a function of the row count only: graph capture). One program per row and split, and 512 is the
+    residency of the card at <= 128 registers: S 8 at 64 rows 456 us, S 9 719 us (E040 attempt 24), so rows * S stays <= 512."""
+    for lim, s in ((32, 16), (64, 8), (128, 4), (256, 2)):
+        if n_decode <= lim:
+            return s
+    return 1
+
