+++ b/src/flag_gems/fused/minicpm/pair_prefill.py
@@ -0,0 +1,168 @@
+"""Prefill for one long sequence with one sampled history ranking per two Q64 blocks."""
+import torch
+import triton
+import triton.language as tl
+
+from .attention import _once, _pf_range, _pf_tile
+from .pair_prefill_policy import POLICY
+
+MARKER = "E366 shared Q64-pair prefill active"
+enabled = True
+
+
+@triton.jit(do_not_specialize=["ctx", "qlen", "qstart", "ws_off", "ntiles", "s_q", "s_h", "s_k"])
+def _score(Q, K, SCORES, ctx, qlen, qstart, ws_off, ntiles, s_q, s_h, s_k, scale,
+           QS: tl.constexpr, KS: tl.constexpr):
+    pair, key_group, head = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    rows = tl.arange(0, QS * 8)
+    cols = tl.arange(0, 8 * KS)
+    dim = tl.arange(0, 128)
+    qpos = tl.maximum(pair * 128 - (QS - 1 - rows // 8) * (128 // QS), 0)
+    kblock = key_group * 8 + cols // KS
+    kpos = kblock * 128 + cols % KS * (128 // KS) + 64 // KS
+    q = tl.load(Q + (qstart + qpos[:, None]) * s_q + (head * 8 + rows[:, None] % 8) * s_h + dim[None, :])
+    k = tl.load(K + head * s_k + (ws_off + kpos[None, :]) * 128 + dim[:, None],
+                mask=kpos[None, :] <= ctx + pair * 128, other=0.0)
+    dot = tl.dot(q, k) * scale
+    dot = tl.where(kpos[None, :] <= (ctx + qpos)[:, None], dot, -float("inf"))
+    grouped = dot.reshape((QS * 8, 8, KS))
+    peak = tl.max(grouped, 2)
+    shift = tl.where(peak > -float("inf"), peak, 0.0)
+    weight = tl.sum(tl.exp2(grouped - shift[:, :, None]), 2)
+    lse = tl.where(weight > 0, shift + tl.log2(weight), -float("inf"))
+    block = key_group * 8 + tl.arange(0, 8)
+    off = ((head * ntiles + pair) * (QS * 8) + rows[:, None]) * 128 + block[None, :]
+    tl.store(SCORES + off, lse, mask=block[None, :] < tl.cdiv(ctx + qlen, 128))
+
+
+@triton.jit(do_not_specialize=["ntiles", "history", "blocks", "keep"])
+def _rank(SCORES, PICKED, ntiles, history, blocks, keep, QROWS: tl.constexpr):
+    pair, head = tl.program_id(0), tl.program_id(1)
+    row = tl.arange(0, QROWS)
+    block = tl.arange(0, 128)
+    off = ((head * ntiles + pair) * QROWS + row[:, None]) * 128 + block[None, :]
+    lse = tl.load(SCORES + off, mask=block[None, :] < blocks, other=-float("inf"))
+    weight = tl.exp2(lse - tl.max(lse, 1)[:, None])
+    mass = tl.sum(weight / tl.sum(weight, 1)[:, None], 0)
+    mass = tl.where((block == 0) | (block >= history - 2), float("inf"), mass)
+    packed = (mass.to(tl.uint32, bitcast=True).to(tl.uint64) << 32) | block.to(tl.uint64)
+    ranked = tl.sort(tl.where(block < history, packed, 0), descending=True).to(tl.int32)
+    picked = tl.sort(tl.where(block < keep, ranked, 0x7fffffff), descending=False)
+    tl.store(PICKED + (head * ntiles + pair) * 128 + block, picked, mask=block < keep)
+
+
+@triton.jit(do_not_specialize=["ctx", "qlen", "qstart", "ws_off", "ntiles", "qblocks", "keep",
+                               "s_q", "s_qh", "s_o", "s_oh", "s_k"])
+def _attend(Q, K, V, PICKS, O, ctx, qlen, qstart, ws_off, ntiles, qblocks, keep,
+            s_q, s_qh, s_o, s_oh, s_k, scale):
+    qb = qblocks - 1 - tl.program_id(0)
+    head = tl.program_id(1)
+    row = tl.arange(0, 64 * 8)
+    col = tl.arange(0, 128)
+    dim = tl.arange(0, 128)
+    pos = qb * 64 + row // 8
+    qh = head * 8 + row % 8
+    q = tl.load(Q + (qstart + pos[:, None]) * s_q + qh[:, None] * s_qh + dim[None, :],
+                mask=pos[:, None] < qlen, other=0.0)
+    acc = tl.zeros((64 * 8, 128), tl.float32)
+    maximum = tl.full((64 * 8,), -float("inf"), tl.float32)
+    norm = tl.zeros((64 * 8,), tl.float32)
+    base = head * s_k + ws_off * 128
+    qpos, length = ctx + pos, ctx + qlen
+    for index in range(keep):
+        selected = tl.load(PICKS + (head * ntiles + qb // 2) * 128 + index)
+        start = selected * 128
+        key = tl.load(K + base + (start + col)[None, :] * 128 + dim[:, None])
+        value = V + base + (start + col)[:, None] * 128 + dim[None, :]
+        acc, maximum, norm = _pf_tile(acc, maximum, norm, q, key, value,
+                                       start, col, qpos, length, scale, False)
+    full_end = (ctx + qb * 64 + 1) // 128
+    causal_end = tl.cdiv(ctx + tl.minimum((qb + 1) * 64, qlen), 128)
+    acc, maximum, norm = _pf_range(acc, maximum, norm, q, K, V, base, ctx // 128, full_end,
+                                   col, dim, qpos, length, scale, False, 128, 128)
+    for offset in tl.static_range(2):
+        tile = full_end + offset
+        if tile < causal_end:
+            kpos = tile * 128 + col
+            key = tl.load(K + base + kpos[None, :] * 128 + dim[:, None],
+                          mask=kpos[None, :] < length, other=0.0)
+            vp = V + base + kpos[:, None] * 128 + dim[None, :]
+            acc, maximum, norm = _tail_tile(acc, maximum, norm, q, key, vp, tile * 128,
+                                           col, qpos, length, scale, True)
+    tl.store(O + (qstart + pos[:, None]) * s_o + qh[:, None] * s_oh + dim[None, :],
+             acc / norm[:, None], mask=pos[:, None] < qlen)
+
+
+@triton.jit
+def _tail_tile(acc, m_i, l_i, q, k, vp, start, offs_t, qpos, seq_len, qk_scale, MASKED: tl.constexpr):
+    sc = tl.dot(q, k)
+    if MASKED:
+        tok = start + offs_t
+        vis = (tok[None, :] <= qpos[:, None]) & (tok[None, :] < seq_len)
+        sc = tl.where(vis, sc, float("-inf"))
+    m_new = tl.maximum(m_i, tl.max(sc, 1) * qk_scale)
+    if MASKED:
+        m_new = tl.where(m_new > float("-inf"), m_new, 0.0)
+    alpha = tl.exp2(m_i - m_new)
+    acc = acc * alpha[:, None]
+    l_i = l_i * alpha
+    m_i = m_new
+    p32 = tl.exp2(sc * qk_scale - m_i[:, None])
+    l_i = l_i + tl.sum(p32, 1)
+    acc += tl.dot(p32.to(vp.dtype.element_ty), tl.load(vp, mask=(start + offs_t)[:, None] < seq_len, other=0.0))
+    return acc, m_i, l_i
+
+def launch_one(q, out, plan, shape, setting, scale, *, tail_only=False):
+    qstart, qlen, ctx, ws_off, anchor = shape
+    keep_at_anchor, qs, ks = setting
+    history = ctx // 128
+    keep = triton.cdiv(keep_at_anchor * history, anchor // 128)
+    ntiles, blocks = triton.cdiv(qlen, 128), triton.cdiv(ctx + qlen, 128)
+    if plan.pair_scratch is None:
+        capacity = plan.pair_capacity
+        plan.pair_scratch = (
+            torch.empty((2, capacity, 128, 128), dtype=torch.float32, device=q.device),
+            torch.empty((2, capacity, 128), dtype=torch.int32, device=q.device),
+        )
+    scores, picks = plan.pair_scratch
+    kw, vw = plan.kw, plan.vw
+    _score[(ntiles, triton.cdiv(blocks, 8), 2)](
+        q, kw, scores, ctx, qlen, qstart, ws_off, ntiles, q.stride(0), q.stride(1), kw.stride(0), scale,
+        QS=qs, KS=ks, num_warps=4, num_stages=1)
+    _rank[(ntiles, 2)](scores, picks, ntiles, history, blocks, keep, QROWS=qs * 8, num_warps=4)
+    qblocks = triton.cdiv(qlen, 64)
+    _attend[(1 if tail_only else qblocks, 2)](
+        q, kw, vw, picks, out, ctx, qlen, qstart, ws_off, ntiles, qblocks, keep,
+        q.stride(0), q.stride(1), out.stride(0), out.stride(1), kw.stride(0), scale,
+        num_warps=16, num_stages=1)
+
+
+def launch(q, out, plan, layer, scale, *, tail_only=False, save_lse=False):
+    if layer is None:
+        return 0
+    from .causal_prefill import launch as launch_causal
+    mask = launch_causal(q, out, plan, layer, scale, save_lse=save_lse)
+    # E489: legacy E366/E378 pair_prefill disabled; any non-causal chunk uses exact dense _prefill_kernel
+    return mask
+
+
+def dense_subset(plan, mask):
+    if plan.dense_subsets is None:
+        plan.dense_subsets = {}
+    if mask in plan.dense_subsets:
+        return plan.dense_subsets[mask]
+    pidx, cb, wso, total = [], [], [], 0
+    for i, (seq, qlen, off) in enumerate(plan.prefill_desc):
+        if mask & (1 << i):
+            continue
+        pidx.append(seq)
+        cb.append(total)
+        wso.append(off)
+        total += triton.cdiv(qlen, 32)
+    if not pidx:
+        result = None
+    else:
+        idx = torch.tensor([pidx, cb, wso], dtype=torch.int32).to(plan.kw.device, non_blocking=True)
+        result = (idx[0], idx[1], idx[2], len(pidx), total)
+    plan.dense_subsets[mask] = result
+    return result
