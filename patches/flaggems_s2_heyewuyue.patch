index 0000000..958553f
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_epoch_collect.py
@@ -0,0 +1,83 @@
+"""Isolated frozen-asm extension: emit page probability partials during full attention.
+
+Each of four lane groups writes its four-token exp sum plus current lazy-softmax
+max. A subsequent kernel combines groups and normalizes with the original full
+attention split/window denominator. No K reread or min/max metadata required.
+"""
+import re
+import triton
+import triton.language as tl
+from flag_gems.fused.minicpm.int4_kv import _wstart, _lo32, _hi32, _DEC14_ASM, _DEC14_CONS
+from flag_gems.fused.minicpm.int4_kv_v2 import _DEC15_ASM, _DEC15_CONS
+
+def extend(original):
+    text=original.value
+    anchor='ml_byte_permute_b32 v82, v41, v40, s3;'
+    assert text.count(anchor)==1
+    prefix='''ml_mov_v2s_b32 s48, $21, 0x0;
+ml_mov_v2s_b32 s49, $22, 0x0;
+sl_mov_b32 s50, 0x40000000;
+sl_mov_b32 s51, 0xffffffff;
+'''
+    emit='''ml_add_f32 v89, v36, v37;
+ml_add_f32 v89, v89, v38;
+ml_add_f32 v89, v89, v39;
+ml_mov_b32 v90, s20;
+ml_shl_b32 v90, v90, 0x9;
+ml_shl_b32 v91, v116, 0x3;
+ml_add_i32 v90, v90, v91;
+ml_lsa_store_dword v89, s[48:51], unsigned v90, noreg, #0, wb;
+ml_lsa_store_dword v85, s[48:51], unsigned v90, noreg, #4, wb;
+'''
+    return prefix+text.replace(anchor,emit+anchor)
+
+ASM4=tl.constexpr(extend(_DEC14_ASM))
+ASM2=tl.constexpr(extend(_DEC15_ASM))
+CONS=tl.constexpr('={v120},={s51},'+','.join(['r']*21))
+FALLBACK4=tl.constexpr(re.sub(r'(\.L\w+)',r'\1_fallback',_DEC14_ASM.value))
+FALLBACK2=tl.constexpr(re.sub(r'(\.L\w+)',r'\1_fallback',_DEC15_ASM.value))
+
+@triton.jit(do_not_specialize=['S'])
+def full_collect_refresh(Q,PG,TABLE,SEQ_LENS,CU_Q,ROWSLOT,TAGS,PO,PM,PL,MASS,REFRESH,
+                 qk_scale,s_q0,s_q1,s_tab,S,W:tl.constexpr,NP:tl.constexpr,V2:tl.constexpr):
+    seq=tl.program_id(1);sp=tl.program_id(2);qrow=tl.load(CU_Q+seq)
+    if tl.load(REFRESH+seq)==0:return
+    if tl.load(CU_Q+seq+1)-qrow!=1:return
+    L4,_=_wstart(TAGS,ROWSLOT,seq,tl.load(SEQ_LENS+seq),W)
+    npg=tl.cdiv(L4,16);per=tl.cdiv(npg,S);lo=sp*per
+    hi=tl.maximum(tl.minimum(lo+per,npg),lo)
+    lane=tl.arange(0,64);z=lane*0;col=lane&15
+    pbase=(seq*(S+1)+sp)*16
+    pg=(PG+z).to(tl.int64,bitcast=True)
+    tab=(TABLE+seq.to(tl.int64)*s_tab+z).to(tl.int64,bitcast=True)
+    po=(PO+pbase*128+z).to(tl.int64,bitcast=True)
+    pm=(PM+pbase+z).to(tl.int64,bitcast=True)
+    pl=(PL+pbase+z).to(tl.int64,bitcast=True)
+    qp=(Q+qrow.to(tl.int64)*s_q0+z).to(tl.int64,bitcast=True)
+    mass=(MASS+seq.to(tl.int64)*NP*128+z).to(tl.int64,bitcast=True)
+    qk=(z.to(tl.float32)+qk_scale*16777216.).to(tl.int32,bitcast=True)
+    rem=z+(L4-(npg-1)*16)
+    if npg > NP or npg < 128:
+        if V2:
+            x0,x1=tl.inline_asm_elementwise(FALLBACK2,_DEC15_CONS,
+                [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+lo,z+hi,rem,z+npg,
+                 _lo32(po),_hi32(po),_lo32(pm),_hi32(pm),_lo32(pl),_hi32(pl),qk,lane,
+                 _lo32(qp),_hi32(qp),col*s_q1*2],dtype=(tl.int32,tl.int32),is_pure=False,pack=1)
+        else:
+            x0,x1=tl.inline_asm_elementwise(FALLBACK4,_DEC14_CONS,
+                [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+lo,z+hi,rem,z+npg,
+                 _lo32(po),_hi32(po),_lo32(pm),_hi32(pm),_lo32(pl),_hi32(pl),qk,lane,
+                 _lo32(qp),_hi32(qp),col*s_q1*2],dtype=(tl.int32,tl.int32),is_pure=False,pack=1)
+    elif V2:
+        x0,x1=tl.inline_asm_elementwise(ASM2,CONS,
+            [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+lo,z+hi,rem,z+npg,
+             _lo32(po),_hi32(po),_lo32(pm),_hi32(pm),_lo32(pl),_hi32(pl),qk,lane,
+             _lo32(qp),_hi32(qp),col*s_q1*2,_lo32(mass),_hi32(mass)],
+            dtype=(tl.int32,tl.int32),is_pure=False,pack=1)
+    else:
+        x0,x1=tl.inline_asm_elementwise(ASM4,CONS,
+            [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+lo,z+hi,rem,z+npg,
+             _lo32(po),_hi32(po),_lo32(pm),_hi32(pm),_lo32(pl),_hi32(pl),qk,lane,
+             _lo32(qp),_hi32(qp),col*s_q1*2,_lo32(mass),_hi32(mass)],
+            dtype=(tl.int32,tl.int32),is_pure=False,pack=1)
+
diff --git a/src/flag_gems/fused/minicpm/_epoch_normalize.py b/src/flag_gems/fused/minicpm/_epoch_normalize.py
