+def _tagged_asm(v2=False,token=False,split_meta=False,skip_empty=False):
+    text=_fused_asm(v2,token=token)
+    where=text.index('.Lk14_loop:')
+    prefix,suffix=text[:where],text[where:]
+    save=''.join(f'ml_mov_v2s_b32 s{54+i}, ${27+i}, 0x0;\n'for i in range(4))
+    setup=('sl_mov_b64 s[48:49], s[54:55];\nsl_mov_b32 s50, 0x40000000;\n'
+           'sl_mov_b32 s51, 0xffffffff;\n')
+    # Physical ring pages are implicit0..7; no page-table load for hot data.
+    old=('sl_mull_u32 s9, s20, 0x4;\nsl_lsa_load_b32x1 s8, s[36:37], s9, #0, ca;\n'
+         'sl_wait smcnt(0);\n')
+    assert suffix.count(old)==1
+    suffix=suffix.replace(old,'sl_mov_b32 s8, s20;\n')
+    point='sl_add_i64 s[40:41], s[16:17], s[10:11];\n'
+    loads=['sl_shl_b32 s54, s20, 0x4','ml_add_i32 v111, s54, v136','ml_shl_b32 v111, v111, 0x2']
+    loads += [f'ml_lsa_load_dword v{140+i}, s[48:51], unsigned v111, noreg, #{16*i}, ca'for i in range(4)]
+    suffix=suffix.replace(point,point+';\n'.join(loads)+';\n',1)
+    masks=[]
+    for i in range(4):
+        masks += [f'ml_cmp_gt_i32 tcr, s56, v{140+i}',
+            f'ml_csel_b32 v{36+i}, v137, v{36+i}, tcr',f'ml_csel_b32 v{40+i}, v52, v{40+i}, tcr',
+            f'ml_cmp_gt_i32 tcr, s57, v{140+i}',
+            f'ml_csel_b32 v{36+i}, v{36+i}, v137, tcr',f'ml_csel_b32 v{40+i}, v{40+i}, v52, tcr']
+        oldexp=f'ml_sub_f32 v{36+i}, v{36+i}, v105;\nml_exp_f32 v{36+i}, v{36+i};'
+        newexp=f'ml_cmp_gt_f32 tcr, v{36+i}, v137;\n'+oldexp+f'\nml_csel_b32 v{36+i}, v{36+i}, v52, tcr;'
+        assert suffix.count(oldexp)==1
+        suffix=suffix.replace(oldexp,newexp)
+    suffix=suffix.replace('.Lk14_nt:;\n','.Lk14_nt:;\n'+';\n'.join(masks)+';\n',1)
+    if split_meta:
+        # The former hot-page-table pointer is free in the implicit ring loop.
+        # Reuse it as the separate128KiB scale buffer without more operands.
+        setup+='sl_mov_b32 s38, 0x40000000;\nsl_mov_b32 s39, 0xffffffff;\n'
+        suffix=suffix.replace('sl_mul_i64_i32 s[10:11], s8, 0x2100;','sl_mul_i64_i32 s[10:11], s8, 0x2000;')
+        for i in range(4):
+            for off,reg in((8192+16*i,56+i),(8320+16*i,60+i)):
+                old=(f'ml_add_i32 v111, v116, 0x{off:x};\n'
+                     f'ml_lsa_load_dword v{reg}, s[40:43], unsigned v111, noreg, #0, ca;')
+                assert suffix.count(old)==1,(off,reg)
+                new=(('sl_shl_b32 s54, s20, 0x8;\n'if off==8192 else'')+
+                     f'ml_add_i32 v111, v116, 0x{off-8192:x};\nml_add_i32 v111, s54, v111;\n'
+                     f'ml_lsa_load_dword v{reg}, s[36:39], unsigned v111, noreg, #0, ca;')
+                suffix=suffix.replace(old,new)
+    if skip_empty:
+        setup+='sl_sub_i32 s55, s57, s56;\n'
+        guard=['sl_cmp_ge_i32 wcr, s55, 0x80','sl_cbr_wcrnz .Lhot_valid',
+            'sl_cmp_ge_i32 wcr, s56, s57','sl_cbr_wcrnz .Lhot_advance',
+            'sl_add_i32 s54, s57, 0xffffffff','sl_srl_b32 s54, s54, 0x4',
+            'sl_sub_i32 s8, s54, s20','sl_and_b32 s8, s8, 0x7',
+            'sl_sub_i32 s8, s54, s8','sl_shl_b32 s8, s8, 0x4',
+            'sl_add_i32 s8, s8, 0x10','sl_cmp_le_i32 wcr, s8, s56',
+            'sl_cbr_wcrnz .Lhot_advance','.Lhot_valid:']
+        assert suffix.count('.Lk14_loop:;\n')==1
+        suffix=suffix.replace('.Lk14_loop:;\n','.Lk14_loop:;\n'+';\n'.join(guard)+';\n',1)
+        advance='sl_add_i32 s20, s20, 0x1;'
+        assert suffix.count(advance)==1
+        suffix=suffix.replace(advance,'.Lhot_advance:;\n'+advance,1)
+    return save+prefix+setup+suffix
