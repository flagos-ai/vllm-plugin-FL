@@ -0,0 +1,253 @@
+"""Quantized decode: stable-slot logical page IDs, 16-token epochs (E157; was 8).
+
+E157: layers 0/1 are anchors (dense on refresh, top npg/8 pages otherwise) instead of always-dense.
+
+Original dispatch, full storage, prefill and exact int8 hot-window are retained.
+This is a fixed layer-budget/epoch bundle, not a runtime evaluation policy.
+"""
+import re
+import os
+import torch
+import triton
+import triton.language as tl
+from . import int4_kv as I4
+from ._epoch_collect import full_collect_refresh
+from ._epoch_sparse import _dec14_kernel_epoch, _dec15_kernel_epoch
+from ._epoch_normalize import normalize
+from ._refresh_split import full_collect_split, merge_refresh, norm_select, select_commit
+from flag_gems.ops.topk import argsort
+
+CAP=2048
+MAX_ROWS=256
+_THROUGHPUT_PROFILE=os.environ.get('FLAGOS_CARD_A_PROFILE','balanced').strip().lower()=='throughput'
+_DEC_MIN_K=tl.constexpr(2 if _THROUGHPUT_PROFILE else 64)
+_DEC_MAX_K=tl.constexpr(2048 if _THROUGHPUT_PROFILE else 96)
+_CAP=tl.constexpr(2048)
+_SLOTS=tl.constexpr(64)
+ANCHORS=(0,1,2,3,4,11,20,28,40,41)
+DENOMS=(4,4,4,4,4,4,4,4,4,4)
+_UNIFIED_MARKED=False
+# E065: per-step/per-layer mechanism statistics in map_cached are diagnostic only (E062: 0.21 ms per B64 step).
+# Production keeps only the per-refresh counter in sort_commit as the in-serve marker.
+FULL_STATS=False
+# E092: refreshing rows on anchor layers run the dense collector with REFRESH_SPLITS
+# programs each (scratch below), then merge into slot 0. 0 restores the original S-split path.
+REFRESH_SPLITS=32
+REFRESH_THRESH=16
+REFRESH_MAX_ROWS=64
+SORT_WARPS=4
+NORM_PB=16
+NORM_LOOP=4      # page blocks per normalize program (fewer early-exit programs)
+FUSED_SELECT=2   # 0 normalize+argsort, 1 fused norm_select, 2 parallel normalize + select_commit
+SELECT_PB=64
+SELECT_WARPS=8
+SELECT_ARY=2     # threshold search arity in top-k selection (2 or 16)
+_REFRESH_MARKED=False
+MAP_DEDUP=True
+_DEDUP_MARKED=False
+_NATIVE_FUSION_MARKED=False
+_WORK={}
+_BOUND=set()
+_SPLIT_MARKED=False
+
+class Workspace:
+    def __init__(self,device):
+        self.mass=torch.empty((MAX_ROWS,CAP,64,2),device=device,dtype=torch.float32)
+        self.scores=torch.empty((MAX_ROWS,CAP),device=device,dtype=torch.float32)
+        self.table=torch.empty((MAX_ROWS,CAP),device=device,dtype=torch.int32)
+        self.counts=torch.empty(MAX_ROWS,device=device,dtype=torch.int32)
+        self.cold=torch.empty_like(self.counts)
+        self.refresh=torch.empty_like(self.counts)
+        self.norm=torch.empty((MAX_ROWS,2,16),device=device,dtype=torch.float32)
+        self.logical=torch.empty((len(ANCHORS),64,CAP),device=device,dtype=torch.int32)
+        self.epochs=torch.full((len(ANCHORS),64),-1,device=device,dtype=torch.int32)
+        self.last=torch.full_like(self.epochs,-1)
+        self.npg=torch.zeros_like(self.epochs)
+        self.k=torch.zeros_like(self.epochs)
+        self.stats=torch.zeros((len(ANCHORS),5),device=device,dtype=torch.int64)
+        sr=REFRESH_SPLITS
+        if sr:
+            # Allocated with the workspace (before KV memory profiling), B<=64 rows only.
+            self.rpo=torch.empty((REFRESH_MAX_ROWS*(sr+1)*16,128),device=device,dtype=torch.float32)
+            self.rpm=torch.empty((REFRESH_MAX_ROWS*(sr+1)*16,),device=device,dtype=torch.float32)
+            self.rpl=torch.empty_like(self.rpm)
+
+def workspace(device):
+    key=str(device)
+    if key not in _WORK:
+        _WORK[key]=Workspace(device)
+        I4.logger.warning('E157 layers01 anchors denom=8'); I4.logger.warning('E157 sparse policy denoms=8/8/8/16/8/8 epoch=16'); I4.logger.warning('E060 epoch sparse active: full=0,1 anchors=%s denoms=%s epoch=16 CAP=2048 rows=256 logicalMiB=3 full_stats=%s',ANCHORS,DENOMS,FULL_STATS)
+    return _WORK[key]
+
+def reset_slots(device,reset):
+    w=_WORK.get(str(device))
+    if w is not None:
+        for slot in reset:
+            w.epochs[:,slot].fill_(-1)
+            w.last[:,slot].fill_(-1)
+
+def bind_layer(win,layer):
+    name=getattr(layer,'layer_name','') or ''
+    match=re.search(r'layers\.(\d+)\.',name)
+    if not match:raise RuntimeError('E060 missing explicit model layer identity: '+name)
+    index=int(match.group(1));assert 0<=index<42,index
+    win._crosslayer_index=index
+    if index not in _BOUND:
+        _BOUND.add(index)
+        role='anchor' if index in ANCHORS else 'recipient'
+        I4.logger.warning('E060 layer=%d role=%s name=%s',index,role,name)
+
+@triton.jit
+def map_cached(SEQ,CU,ROWS,TAGS,ORIGINAL,EPOCH,LAST,NPG,KEEP,IDS,OUT,COUNTS,COLD,REFRESH,STATS,
+               TS:tl.constexpr,BANK:tl.constexpr,SOURCE:tl.constexpr,FULL_STATS:tl.constexpr,PROMPT=None):
+    row=tl.program_id(0);L=tl.load(SEQ+row);slot=tl.load(ROWS+row)
+    start,_=I4._wstart(TAGS,ROWS,row,L,128)
+    npg=tl.cdiv(start,16);epoch=L//16
+    active=(tl.load(CU+row+1)-tl.load(CU+row)==1)&(slot>=0)&(npg>=128)&(npg<=_CAP)
+    p=BANK*_SLOTS+slot
+    oldepoch=tl.load(EPOCH+p,slot>=0,-1);last=tl.load(LAST+p,slot>=0,-1)
+    oldn=tl.load(NPG+p,slot>=0,0);k=tl.load(KEEP+p,slot>=0,0)
+    if SOURCE:
+        valid=active&(oldepoch==epoch)&(last==L-1)&(oldn>0)&(oldn<=npg)
+        refresh=active&~valid
+        tl.store(LAST+p,L,slot>=0)
+    else:
+        valid=active&(oldepoch==epoch)&(last==L)&(oldn>0)&(oldn<=npg)
+        refresh=False
+    tl.store(REFRESH+row,refresh.to(tl.int32))
+    tl.store(COLD+row,tl.where(active,npg,-1))
+    count=k+npg-oldn
+    tl.store(COUNTS+row,tl.where(valid,count,-1))
+    if valid:
+        i=tl.arange(0,_CAP)
+        logical=tl.load(IDS+(p.to(tl.int64)*_CAP)+i,i<k,0)
+        # Cached anchor's final page is already last; append all new cold pages.
+        logical=tl.where(i<k,logical,oldn+i-k)
+        block=tl.load(ORIGINAL+row.to(tl.int64)*TS+logical,i<count,0)
+        tl.store(OUT+row.to(tl.int64)*_CAP+i,block,i<count)
+        if FULL_STATS:
+            tl.atomic_add(STATS+BANK*5+(1 if SOURCE else 2),1)
+            tl.atomic_add(STATS+BANK*5+3,npg.to(tl.int64))
+            tl.atomic_add(STATS+BANK*5+4,count.to(tl.int64))
+
+@triton.jit
+def prepare_norm(REFRESH,PM,PL,NORM,S:tl.constexpr,SP:tl.constexpr):
+    row=tl.program_id(0)
+    if tl.load(REFRESH+row)==0:return
+    h=tl.arange(0,16);p=tl.arange(0,SP)
+    m=tl.load(PM+(row*(S+1)+p[:,None])*16+h[None,:],p[:,None]<S+1,float('-inf'))
+    l=tl.load(PL+(row*(S+1)+p[:,None])*16+h[None,:],p[:,None]<S+1,0.)
+    mx=tl.max(m,0);denom=tl.sum(l*tl.exp2(m-mx[None,:]),0)
+    tl.store(NORM+row*32+h,mx);tl.store(NORM+row*32+16+h,1./denom)
+
+@triton.jit
+def sort_commit(SCORES,REFRESH,ROWS,SEQ,COLD,IDS,EPOCH,NPG,KEEP,STATS,BANK:tl.constexpr,DENOM:tl.constexpr):
+    row=tl.program_id(0)
+    if tl.load(REFRESH+row)==0:return
+    slot=tl.load(ROWS+row);p=BANK*_SLOTS+slot;npg=tl.load(COLD+row)
+    i=tl.arange(0,_CAP);score=tl.load(SCORES+row*_CAP+i)
+    _,idx=argsort(score,i.to(tl.int32),dim=0,descending=True)
+    k=tl.minimum(npg,tl.minimum(_DEC_MAX_K,tl.maximum(_DEC_MIN_K,tl.cdiv(npg,DENOM))))
+    tail=tl.sum(tl.where(i==k-1,idx,0),0)
+    logical=tl.where(i==k-1,npg-1,tl.where(idx==npg-1,tail,idx))
+    if DENOM==1:logical=i
+    tl.store(IDS+p.to(tl.int64)*_CAP+i,logical,i<k)
+    tl.store(EPOCH+p,tl.load(SEQ+row)//16);tl.store(NPG+p,npg);tl.store(KEEP+p,k)
+    tl.atomic_add(STATS+BANK*5,1)
+
+def run_if_active(q,c8,c16,win,outr,cu,seq,table,scale,n_decode,final,v2):
+    li=win._crosslayer_index;n=seq.shape[0]
+    if n>MAX_ROWS:return False
+    global _UNIFIED_MARKED
+    if not _UNIFIED_MARKED:
+        _UNIFIED_MARKED=True
+        I4.logger.warning('E489 unified sparse decode active (min_keep=64, K_MAX=96)')
+    source=li in ANCHORS
+    anchor=li if source else (4 if li<11 else (11 if li<20 else (20 if li<28 else 28)))
+    bank=ANCHORS.index(anchor)
+    w=workspace(q.device);S=I4.int4_splits(n_decode);hq=q.shape[1]
+    if n_decode == 64:
+        S=4
+        global _SPLIT_MARKED
+        if not _SPLIT_MARKED:
+            _SPLIT_MARKED=True
+            I4.logger.warning('E072 sparse splits active rows=64 S=4; full layers0/1 unchanged')
+    tags,rows=I4.layer_state(q.device, li)
+    # E094: a recipient whose previous layer is a recipient of the same anchor reuses that layer's mapping
+    # (same step, same block table, bank state only written by anchors, mapping outputs read-only in recipients).
+    reuse=MAP_DEDUP and not source and li-1>=2 and (li-1) not in ANCHORS
+    if not reuse:
+        map_cached[(n,)](seq,cu,rows,tags,table,w.epochs,w.last,w.npg,w.k,w.logical,w.table,w.counts,w.cold,w.refresh,w.stats,
+            table.stride(0),bank,source,FULL_STATS,num_warps=4)
+    else:
+        global _DEDUP_MARKED
+        if not _DEDUP_MARKED:
+            _DEDUP_MARKED=True
+            I4.logger.warning('E094 recipient map dedup active: map_cached only on first recipient after each anchor')
+    if getattr(win,'native',False) and getattr(win,'native_fusion',True) and not source and n_decode==64 and n==64:
+        global _NATIVE_FUSION_MARKED
+        if not _NATIVE_FUSION_MARKED:
+            _NATIVE_FUSION_MARKED=True
+            I4.logger.warning('E111 tagged native recipient dispatched: rows=64 S=%d token_layout=%s',S,getattr(win,'native_layout','mma'))
+        if getattr(win,'native_cta_fusion',False) and S==4 and getattr(win,'native_split_meta',False) and getattr(win,'native_layout','mma')=='token':
+            if not getattr(I4,'_E111_CTA_MARKED',False):
+                I4._E111_CTA_MARKED=True
+                I4.logger.warning('E111 swizzled CTA merge+inverse active: S4,32KiB, no global split partials')
+            if getattr(win,'native_skip_empty',False) and not getattr(I4,'_E111_SKIP_MARKED',False):
+                I4._E111_SKIP_MARKED=True
+                I4.logger.warning('E111 empty hot-page guard dispatched: exact ring bounds, full pages preserved')
+            if not v2 and not getattr(I4,'_E113_PIPE_MARKED',False):
+                I4._E113_PIPE_MARKED=True
+                I4.logger.warning('E113 V4 cold payload pipeline dispatched: existing register banks, original V2 preserved')
+            from ._cta_native_merge import recipient
+            had,sign=I4._had_pm(q.device)
+            recipient[(n,)](q,c8,table,w.table,w.counts,win.k32,win.ks,seq,cu,rows,tags,final,sign,
+                scale*I4._LOG2E,q.stride(0),q.stride(1),table.stride(0),CAP,V2=v2,SKIP_EMPTY=getattr(win,'native_skip_empty',False),num_warps=4,num_stages=1)
+            return True
+        from ._window_native import tagged_recipient
+        po=torch.empty((n*S*hq,128),device=q.device,dtype=torch.float32)
