+"""E111 native-layout int8 hot-window experiment, not dispatched.
+
+Native storage is exactly 8448 bytes per 16-token/two-head page: 8192
+code bytes + 256 FP32 scale bytes, equal to the existing ring payload.
+The arithmetic loop derives from frozen E098 v14, replacing nibble extraction
+with byte extraction and using per-token FP32 K/V scales. First device probe
+covers full valid 128-token windows only; partial tags are a later gate.
+"""
+import triton
+import triton.language as tl
+import triton.experimental.tle.language.gpu as tleg
+from .int4_kv import _hw_k,_hw_v,_lo32,_hi32,_wstart,_write_kernel
