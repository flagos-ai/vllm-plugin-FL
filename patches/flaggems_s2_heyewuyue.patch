+@triton.jit
+def quarter_cta_recipient(Q,PG,TAB,COUNTS,WPG,WTAB,O,SIGN,B:tl.constexpr,S:tl.constexpr,STRIDE:tl.constexpr,V2:tl.constexpr=False):
+    row=tl.program_id(0)
+    tid=tl.arange(0,256);sp=tid//64;lane=tid%64;z=tid*0
+    count=tl.load(COUNTS+row);per=tl.cdiv(count,S);lo=sp*per;hi=tl.minimum(lo+per,count)
