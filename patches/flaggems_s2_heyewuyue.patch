+def attend(qr, kr, vr, c8, c16, win, outr, cu, seq, table, scale, max_q, final=None, v2=False):
+    """rotated q [n, HQ, D] -> rotated output [n, HQ, D] (fp32)"""
+    from . import attention as A
+    if max_q <= 1:
