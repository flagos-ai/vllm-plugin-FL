+    qr = (torch.randn((len(lens), QPK * HKV_EXP, D), generator=gen) * 0.3).to(device=device, dtype=torch.bfloat16)
+    cu = torch.arange(len(lens) + 1, dtype=torch.int32, device=device)
+    seq = torch.tensor(lens, dtype=torch.int32, device=device)
+    out = torch.zeros((len(lens), QPK * HKV_EXP, D), dtype=torch.float32, device=device)
+    scale = D ** -0.5
