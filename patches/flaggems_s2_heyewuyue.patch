index 0000000..55c19bc
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_group_a8_mlp.py
@@ -0,0 +1,444 @@
+"""Producer-local group-128 INT8 activation MLP kernels for Iluvatar BI-V150.
+
+The producer emits final int8 activations and per-row/group scales. Down
+rescales every integer K-group before float accumulation. No FP32 Y buffer,
+global row-amax, H4 kernel or expanded weight representation is used.
+"""
+import torch
+import triton
+import triton.language as tl
+import triton.experimental.tle.language.gpu as tleg
+
+
+def _h128_assembly(column_warps=False):
+    # pack=32 is the native M16xN128 D fragment per lane:
+    # reg=(m>>2)+4*(n>>4), lane=(n&15)+16*(m&3).
+    # All exchanges of one stage issue before its sole lmcnt wait.
+    lines = []
+    for bit in range(4):
+        lines.append(f'ml_xor_b32 $64, $128, 0x{1<<bit:x}')
+        for r in range(32):
+            lines.append(f'ml_slb_shuffle_rtn_b32 ${32+r}, ${r}, $64')
+        lines.append('sl_wait lmcnt(0)')
+        lines.append(f'ml_shl_b32 $65, $128, 0x{31-bit:x}')
+        lines.append('ml_and_b32 $65, $65, 0x80000000')
+        for r in range(32):
+            lines.append(f'ml_xor_b32 ${r}, ${r}, $65')
+            lines.append(f'ml_add_f32 ${r}, ${r}, ${32+r}')
+    for bit in ((16,) if column_warps else (4, 8, 16)):
+        for r in range(32):
+            if r & bit:
+                continue
+            partner = r ^ bit
+            lines.append(f'ml_add_f32 $66, ${r}, ${partner}')
+            lines.append(f'ml_sub_f32 ${partner}, ${r}, ${partner}')
+            lines.append(f'ml_mov_b32 ${r}, $66')
+    # Auxiliary outputs are scratch constraints, never consumed by Triton.
+    for i in range(64,96):
+        lines.append(f'ml_mov_b32 ${i}, 0x0')
+    return ';\n'.join(lines)+';\n'
+
+
+_HASM = tl.constexpr(_h128_assembly())
+_H32ASM = tl.constexpr(_h128_assembly(True))
+_HCONS = tl.constexpr(','.join(['=&r']*96+[str(i) for i in range(32)]+['r']*32))
+
+
+def _smem_h128_assembly():
+    import struct
+    e=[]
+    e += ['ml_mov_b32 v68, $72','ml_mov_b32 v69, $73',
+          'ml_and_b32 v65, v69, 0xfffffffe','ml_shl_b32 v65, v65, 0x1',
+          'ml_add_i32 v65, v65, v68','ml_and_b32 v70, v69, 0x1',
+          'ml_shl_b32 v70, v70, 0x4','ml_mov_b32 v71, 0x10',
+          'ml_sub_i32 v70, v71, v70']
+    for r in range(32):
+        e += [f'ml_add_i32 v66, v65, 0x{r*128:x}',
+              f'ml_slb_load_b32x1 v{r}, v66, noreg, #0, null']
+    e += ['sl_wait lmcnt(0)']
+    for r in range(32):
+        e += [f'ml_shl_b32 v{r}, v{r}, v70',f'ml_and_b32 v{r}, v{r}, 0xffff0000']
+    for bit in range(4):
+        e += [f'ml_xor_b32 v66, v69, 0x{1<<bit:x}']
+        for r in range(32):e += [f'ml_slb_shuffle_rtn_b32 v{32+r}, v{r}, v66']
+        e += ['sl_wait lmcnt(0)',f'ml_shl_b32 v67, v69, 0x{31-bit:x}',
+              'ml_and_b32 v67, v67, 0x80000000']
+        for r in range(32):e += [f'ml_xor_b32 v{r}, v{r}, v67',f'ml_add_f32 v{r}, v{r}, v{32+r}']
+    for bit in (4,8,16):
+        for r in range(32):
+            if r&bit:continue
+            p=r^bit
+            e += [f'ml_add_f32 v64, v{r}, v{p}',f'ml_sub_f32 v{p}, v{r}, v{p}',f'ml_mov_b32 v{r}, v64']
+    coefficient=struct.unpack('<I',struct.pack('<f',128**-.5))[0]
+    e += ['ml_shl_b32 v65, v69, 0x1','ml_add_i32 v65, v65, v68']
+    for r in range(32):
+        e += [f'ml_mul_f32 v{r}, v{r}, 0x{coefficient:08x}',f'ml_cvt_bf16_f32 v{r}, v{r}',
+              f'ml_add_i32 v66, v65, 0x{r*128:x}',f'ml_slb_store_b16 v{r}, v66, noreg, #0, null']
+    e += ['sl_wait lmcnt(0)']
+    return ';\n'.join(e)+';\n'
+
+
+_SMEM_HASM=tl.constexpr(_smem_h128_assembly())
+_SMEM_HCONS=tl.constexpr(','.join([f'={{v{i}}}'for i in range(72)]+['r','r','~{memory}']))
+
+
+@triton.jit
+def _producer(A, B, SA, SB, H, Q, S, K: tl.constexpr, F: tl.constexpr,
+              BM: tl.constexpr, BK: tl.constexpr, NATIVE: tl.constexpr = False):
+    pn = tl.program_id(0)
+    rm = tl.program_id(1) * BM + tl.arange(0, BM)
+    rn = pn * 128 + tl.arange(0, 128)
+    rk = tl.arange(0, BK)
+    a = A + rm[:, None] * K + rk[None, :]
+    bg = B + rn[None, :] * K + rk[:, None]
+    bu = bg + F * K
+    ag = tl.zeros((BM, 128), tl.int32)
+    au = tl.zeros((BM, 128), tl.int32)
+    for _ in range(K // BK):
+        av = tl.load(a)
+        ag += tl.dot(av, tl.load(bg), out_dtype=tl.int32)
+        au += tl.dot(av, tl.load(bu), out_dtype=tl.int32)
+        a += BK
+        bg += BK
+        bu += BK
+    sa = tl.load(SA + rm)
+    g = (ag.to(tl.float32) * sa[:, None] * tl.load(SB + rn)[None, :]).to(tl.bfloat16).to(tl.float32)
+    u = (au.to(tl.float32) * sa[:, None] * tl.load(SB + F + rn)[None, :]).to(tl.bfloat16).to(tl.float32)
+    act = (g * tl.sigmoid(g) * u).to(tl.bfloat16)
+    c = tl.arange(0, 128)
+    # Keep the known production H128 layout in this first connected producer.
+    # A separate native-fragment implementation will replace only this stage.
+    if NATIVE == 3:
+        # One explicit CTA-local handoff. The memory image pins native H128
+        # ownership independently of the compiler's chosen GEMM warp layout.
+        buf=tleg.alloc((8192,),tl.bfloat16,scope=tleg.smem,nv_mma_shared_layout=False)
+        ptr=tleg.local_ptr(buf,(0,))
+        packed=((rm[:,None]//16)*2048+((rm[:,None]%16)//4+4*(c[None,:]//16))*64
+                +(c[None,:]%16)+16*(rm[:,None]%4))
+        tl.store(ptr+packed,act)
+        tl.debug_barrier()
+        threads=tl.arange(0,256)
+        warp=threads//64
+        address=ptr.to(tl.uint64).to(tl.int32)+warp*4096
+        scratch=tl.inline_asm_elementwise(_SMEM_HASM,_SMEM_HCONS,[address,threads%64],
+            dtype=(tl.int32,)*72,is_pure=False,pack=1)
+        tl.debug_barrier()
+        # Already normalized and rounded to BF16 by the native handoff.
+        y=tl.load(ptr+packed).to(tl.float32)
+    elif NATIVE:
+        lane = (c[None,:] & 15) + 16*(rm[:,None] & 3)
+        code:tl.constexpr = _H32ASM if NATIVE == 2 else _HASM
+        transformed, scratch, aux = tl.inline_asm_elementwise(code, _HCONS,
+            [act.to(tl.float32), lane], dtype=(tl.float32, tl.float32, tl.int32),
+            # A lane-collective asm must not be cloned/rematerialized across
+            # layout conversions as an ordinary elementwise pure expression.
+            is_pure=False, pack=32)
+        if NATIVE == 2:
+            # M64/N128 with column-owned warps: H32 is register/lane-local;
+            # only the final two stages exchange across four column warps.
+            for bit in tl.static_range(5,7):
+                idx=tl.broadcast_to((c^(1<<bit))[None,:],(BM,128))
+                partner=tl.gather(transformed,idx,axis=1)
+                transformed=tl.where((c[None,:]&(1<<bit))==0,transformed+partner,partner-transformed)
+    else:
+        h = tl.load(H + c[:, None] * 128 + c[None, :])
+        transformed = tl.dot(act, h)
+    if NATIVE != 3:
+        y = (transformed * (128.0 ** -0.5)).to(tl.bfloat16).to(tl.float32)
+    scale = tl.maximum(tl.max(tl.abs(y), 1), 1e-8) / 127.0
+    codes = tl.minimum(tl.maximum(tl.floor(y / scale[:, None] + 0.5), -127.0), 127.0).to(tl.int8)
+    tl.store(Q + rm[:, None] * F + rn[None, :], codes)
+    tl.store(S + rm * (F // 128) + pn, scale)
+
+
+@triton.jit
+def _down(Q, S, W, SW, O, K: tl.constexpr, N: tl.constexpr,
+          BM: tl.constexpr, BN: tl.constexpr, SPLIT: tl.constexpr):
+    pn = tl.program_id(0)
+    sp = tl.program_id(1)
+    rm = tl.arange(0, BM)
+    rn = pn * BN + tl.arange(0, BN)
+    rk = tl.arange(0, 128)
+    acc = tl.zeros((BM, BN), tl.float32)
+    groups: tl.constexpr = K // 128
+    for g in range(sp * (groups // SPLIT), (sp + 1) * (groups // SPLIT)):
+        a = tl.load(Q + rm[:, None] * K + (g * 128 + rk)[None, :])
+        b = tl.load(W + rn[None, :] * K + (g * 128 + rk)[:, None])
+        dot = tl.dot(a, b, out_dtype=tl.int32)
+        sa = tl.load(S + rm * groups + g)
+        acc += dot.to(tl.float32) * sa[:, None]
+    if SPLIT == 1:
+        sw = tl.load(SW + rn)
+        tl.store(O + rm[:, None] * N + rn[None, :], (acc * sw[None, :]).to(tl.bfloat16))
+    else:
+        tl.store(O + sp * BM * N + rm[:, None] * N + rn[None, :], acc)
+
+
+@triton.jit
+def _finish(P, SW, O, N: tl.constexpr, M: tl.constexpr, SPLIT: tl.constexpr, BLOCK: tl.constexpr):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    total = tl.zeros((BLOCK,), tl.float32)
+    for sp in tl.static_range(SPLIT):
+        total += tl.load(P + sp * M * N + i, mask=i < M * N, other=0.)
+    sw = tl.load(SW + i % N)
+    tl.store(O + i, (total * sw).to(tl.bfloat16), mask=i < M * N)
+
+
+def group_mlp(q, scale, wgu, sgu, wdn, sdn, had, split=2, native=3, down_warps=8):
+    if native not in (0,3,8,9):
+        raise ValueError('E110: implicit pack32 ownership variants are diagnostic-only; use native=3')
+    m, k = q.shape
+    f = sgu.numel() // 2
+    n = wdn.shape[0]
+    codes = torch.empty((m, f), device=q.device, dtype=torch.int8)
+    scales = torch.empty((m, f // 128), device=q.device, dtype=torch.float32)
+    out = torch.empty((m, n), device=q.device, dtype=torch.bfloat16)
+    producer_bm = 16 if native == 1 else m
+    if native in(8,9):
+        from . import _native_pair_mlp as N
+        if wgu.dtype == torch.uint8:
+            from . import _gu_m32_w4 as gu_m32_w4
+            producer = gu_m32_w4.run(q,scale,wgu,sgu,codes,scales)
+        else:
+            producer=(N.run_dense if native==9 else N.run)(q,scale,wgu,sgu,codes,scales)
+    else:
+        producer = _producer[(f // 128, m // producer_bm)](q, wgu, scale, sgu, had, codes, scales,
+            K=k, F=f, BM=producer_bm, BK=64, NATIVE=native, num_warps=1 if native == 1 else 4, num_stages=2)
+    partial = out if split == 1 else torch.empty((split, m, n), device=q.device, dtype=torch.float32)
+    down = _down[(n // 64, split)](codes, scales, wdn, sdn, partial,
+        K=f, N=n, BM=m, BN=64, SPLIT=split, num_warps=down_warps, num_stages=2)
+    if split != 1:
+        _finish[(triton.cdiv(m * n, 256),)](partial, sdn, out, N=n, M=m, SPLIT=split, BLOCK=256, num_warps=4)
+    return out, codes, scales, producer, down
+
+
+@triton.jit(do_not_specialize=["M"])
+def _e350_silu_matrix(GU, HMAT, T, BA, M, F: tl.constexpr, R: tl.constexpr):
+    row = tl.program_id(0) * R + tl.arange(0, R)
+    block = tl.program_id(1)
+    d = tl.arange(0, 128)
+    col = block * 128 + d
+    addr = row[:, None] * 2 * F + col[None, :]
+    gate = tl.load(GU + addr, mask=row[:, None] < M, other=0).to(tl.float32)
+    up = tl.load(GU + addr + F, mask=row[:, None] < M, other=0).to(tl.float32)
+    silu = (gate * tl.sigmoid(gate)).to(tl.bfloat16).to(tl.float32)
+    x = (silu * up).to(tl.bfloat16)
+    h = tl.load(HMAT + d[:, None] * 128 + d[None, :])
+    y = (tl.dot(x, h) * (128 ** -.5)).to(tl.bfloat16)
+    tl.store(T + row[:, None] * F + col[None, :], y)
+    tl.store(BA + row * (F // 128) + block, tl.max(tl.abs(y.to(tl.float32)), 1))
+
+
+
+def _e350_legacy(gu, rows, width, padded):
+    from . import _h128_basis as H, fused_layers as F
+
+    act = torch.empty((rows, width), device=gu.device, dtype=torch.bfloat16)
+    F._silu_mul_kernel[(rows, width // 1024)](gu, act, F_=width, BLOCK=1024, num_warps=4)
+    return H.quant_act(act, padded)
+
+
+
+@triton.jit
+def _e374_shfl_xor(x, lane, mask):
+    return tl.inline_asm_elementwise(
+        "ml_slb_shuffle_rtn_b32 $0, $1, $2;\nsl_wait lmcnt(0);",
+        "=r,r,r",
+        [x, lane ^ mask],
+        dtype=x.dtype,
+        is_pure=True,
+        pack=1,
+    )
+
+
+@triton.jit
+def _e374_fwht128_2(a, b, lane):
+    s = a + b
+    d = a - b
+    a, b = s, d
+    for stride in tl.static_range(6):
+        mask = 1 << (5 - stride)
+        pa = _e374_shfl_xor(a, lane, mask)
+        pb = _e374_shfl_xor(b, lane, mask)
+        bit = (lane & mask) != 0
+        a = tl.where(bit, pa - a, a + pa)
+        b = tl.where(bit, pb - b, b + pb)
+    return a, b
+
+
+@triton.jit
+def _silu_h128_quant_6144_1r_kernel(GU, Q, S, M, F: tl.constexpr, inv_sqrt_d: tl.constexpr):
+    row = tl.program_id(0)
+    lane = tl.arange(0, 64)
+    mm = row < M
+    gbase = GU + row * (2 * F)
+    qbase = Q + row * F
+    rmax = tl.full((64,), 0.0, tl.float32)
+    for b in range(48):
+        col = b * 128 + lane
+        g0 = tl.load(gbase + col, mask=mm, other=0.0).to(tl.float32)
+        g1 = tl.load(gbase + col + 64, mask=mm, other=0.0).to(tl.float32)
+        u0 = tl.load(gbase + F + col, mask=mm, other=0.0).to(tl.float32)
+        u1 = tl.load(gbase + F + col + 64, mask=mm, other=0.0).to(tl.float32)
+        s0 = (g0 * tl.sigmoid(g0)).to(tl.bfloat16).to(tl.float32)
+        s1 = (g1 * tl.sigmoid(g1)).to(tl.bfloat16).to(tl.float32)
+        x0 = (s0 * u0).to(tl.bfloat16).to(tl.float32)
+        x1 = (s1 * u1).to(tl.bfloat16).to(tl.float32)
+        x0, x1 = _e374_fwht128_2(x0, x1, lane)
+        x0 = (x0 * inv_sqrt_d).to(tl.bfloat16).to(tl.float32)
+        x1 = (x1 * inv_sqrt_d).to(tl.bfloat16).to(tl.float32)
+        rmax = tl.maximum(rmax, tl.maximum(tl.abs(x0), tl.abs(x1)))
+    for stride in tl.static_range(6):
+        mask = 1 << (5 - stride)
+        rmax = tl.maximum(rmax, _e374_shfl_xor(rmax, lane, mask))
+    scale = tl.maximum(rmax, 1e-8) / 127.0
+    inv_scale = 1.0 / scale
+    tl.store(S + row + lane * 0, scale, mask=mm & (lane == 0))
+    for b in range(48):
+        col = b * 128 + lane
+        g0 = tl.load(gbase + col, mask=mm, other=0.0).to(tl.float32)
+        g1 = tl.load(gbase + col + 64, mask=mm, other=0.0).to(tl.float32)
+        u0 = tl.load(gbase + F + col, mask=mm, other=0.0).to(tl.float32)
+        u1 = tl.load(gbase + F + col + 64, mask=mm, other=0.0).to(tl.float32)
+        s0 = (g0 * tl.sigmoid(g0)).to(tl.bfloat16).to(tl.float32)
+        s1 = (g1 * tl.sigmoid(g1)).to(tl.bfloat16).to(tl.float32)
+        x0 = (s0 * u0).to(tl.bfloat16).to(tl.float32)
+        x1 = (s1 * u1).to(tl.bfloat16).to(tl.float32)
+        x0, x1 = _e374_fwht128_2(x0, x1, lane)
+        x0 = (x0 * inv_sqrt_d).to(tl.bfloat16).to(tl.float32)
+        x1 = (x1 * inv_sqrt_d).to(tl.bfloat16).to(tl.float32)
+        vx0 = tl.floor(x0 * inv_scale + 0.5)
+        vx1 = tl.floor(x1 * inv_scale + 0.5)
+        q0 = tl.minimum(tl.maximum(vx0, -127.0), 127.0).to(tl.int8)
+        q1 = tl.minimum(tl.maximum(vx1, -127.0), 127.0).to(tl.int8)
+        tl.store(qbase + col, q0, mask=mm)
+        tl.store(qbase + col + 64, q1, mask=mm)
+
+
+def _e350_quant(gu, rows, width, padded):
+    from . import fused_layers as F
+
+    if rows < 256 or width != 6144 or gu.dtype != torch.bfloat16 or not gu.is_contiguous():
+        return _e350_legacy(gu, rows, width, padded)
+    F._mark("e374_silu_h128_quant", "E374 fused SiLU+H128+quant 1r active")
+    q = torch.empty((padded, width), device=gu.device, dtype=torch.int8)
+    s = torch.empty(padded, device=gu.device, dtype=torch.float32)
+    _silu_h128_quant_6144_1r_kernel[(padded,)](
+        gu, q, s, rows, width, 128 ** -0.5, num_warps=1, num_stages=1)
+    return q, s
+
+
+def _prefill_mlp(q,s,m,wgu,sgu,wdn,sdn,*,force_panel=False):
+    from . import w8a8 as W,fused_layers as F,_packed_pair_reader as P,_h128_basis as H
+    k=q.shape[1];f=sgu.numel()//2
+    activated = m >= 2048 and wgu.data_ptr() in P._STRIPED
+    if activated:
+        from .compact_gate_up import gate_up
+        bm,bn,bk,nw,ns,group = W._cfg(m,k,2*f)
+        padded = triton.cdiv(m,bm)*bm
+        image, scales = P._PREFILL_IMAGES[wgu.data_ptr()]
+        gu = torch.empty((padded,f),device=q.device,dtype=torch.bfloat16)
+        gate_up[(padded//bm*(2*f//bn),)](q,image,s,scales,gu,padded,f,k,bm,bn,bk,group,16,
+                                         num_warps=nw,num_stages=ns)
+        F._mark("e457_stripe16","E457 stripe16 compact BF16 prefill active")
+    else:
+        gu,_=P.run(q,s,wgu,sgu,m,unpack='tile')
+    bn=W._cfg(m,f,wdn.shape[0])[0];pad=triton.cdiv(m,bn)*bn
+    if not force_panel and 512 <= m < 2048 and f == 6144:
+        F._mark("e405_short_gu", f"E405 original GU-down for short prefill m={m}")
+    if (m >= 2048 or force_panel) and f == 6144 and wdn.shape[0] == 2048 and gu.dtype == torch.bfloat16 and gu.is_contiguous():
+        from .e401_gu_down import activation_exact_groups, project_down
+        bm, bn, bk, nw, ns, group = W._cfg(m, f, wdn.shape[0])
+        a8 = torch.empty((pad, f), device=q.device, dtype=torch.int8)
+        scale = torch.empty(pad, device=q.device, dtype=torch.float32)
+        out = torch.empty((pad, wdn.shape[0]), device=q.device, dtype=torch.bfloat16)
+        activation_exact_groups[(pad,)](
+            gu, a8, scale, m, pad, PANEL=True, WARPS=16, ACTIVATED=activated, num_warps=16, num_stages=1)
+        project_down[(pad // bm * (wdn.shape[0] // bn),)](
+            a8, wdn, out, scale, sdn, wdn.shape[0], f, BM=bm, BN=bn, BK=bk, GROUP=group,
+            NPM=pad // bm, num_warps=nw, num_stages=ns)
+        shape = "wide" if m >= 8192 else "prefill"
+        F._mark("e401_gu_panel_" + shape, f"E401 GU 48-group K64 panel active m={m} shape={shape}")
+        return out[:m]
+    q2,s2=_e350_quant(gu,m,f,pad)
+    out=torch.empty((pad,wdn.shape[0]),device=q.device,dtype=torch.bfloat16)
+    bm,bn,bk,nw,ns,grp=W._cfg(m,f,wdn.shape[0])
+    W._gemm_kernel[(triton.cdiv(m,bm)*(wdn.shape[0]//bn),)](q2,wdn,out,s2,sdn,wdn.shape[0],f,BM=bm,BN=bn,BK=bk,GROUP=grp,NPM=triton.cdiv(m,bm),num_warps=nw,num_stages=ns)
+    return out[:m]
+
+
+# Bind each loaded GU image to its layer, then verify the *launched* native
+# M64 chain during decode graph capture. Drop each entry once proven.
+_CAPTURE_PENDING = {}
+
+
+def bind_capture_layer(weight, name):
+    _CAPTURE_PENDING[weight.data_ptr()] = name
+
+
+def _audit_capture(wgu, m, path):
+    if m != 64 or not _CAPTURE_PENDING or not torch.cuda.is_current_stream_capturing():
+        return
+    name = _CAPTURE_PENDING.pop(wgu.data_ptr(), None)
+    if name is not None:
+        from .fused_layers import logger
+        logger.warning('E114 M64 native8 capture path=%s name=%s', path, name)
+        if wgu.dtype == torch.uint8:
+            logger.warning('E263 packed GU M64 capture path=%s name=%s', path, name)
+
+
+def activation_mlp(x:torch.Tensor,wgu:torch.Tensor,sgu:torch.Tensor,wdn:torch.Tensor,sdn:torch.Tensor)->torch.Tensor:
+    """One persistent packed GU/H128 down image, including stock MLP calls."""
+    from . import w8a8 as W,fused_layers as F
+    F._mark('e110_plain_mlp','E110 packed stock-MLP path active: shared basis, first-layer and prefill covered')
+    m,k=x.shape;f=sgu.numel()//2
+    if m==0:return torch.empty((0,wdn.shape[0]),device=x.device,dtype=torch.bfloat16)
+    if m<=64:
+        q,s=W.quant_act(x,False,64)
+        out=group_mlp(q,s,wgu,sgu,wdn,sdn,None,split=2,native=8,down_warps=8)[0]
+        _audit_capture(wgu,m,"plain")
+        return out[:m]
+    cfg=W._cfg(m,k,2*f);mp=triton.cdiv(m,cfg[0])*cfg[0]
+    q,s=W.quant_act(x,False,mp)
+    return _prefill_mlp(q,s,m,wgu,sgu,wdn,sdn)
+
+
+def activation_mlp_fake(x:torch.Tensor,wgu:torch.Tensor,sgu:torch.Tensor,wdn:torch.Tensor,sdn:torch.Tensor)->torch.Tensor:
+    return torch.empty_like(x)
+
+
+_LAST_PREFILL_GU = None
+
+def norm_mlp(attn_out:torch.Tensor,residual:torch.Tensor,nw:torch.Tensor,eps:float,wgu:torch.Tensor,sgu:torch.Tensor,wdn:torch.Tensor,sdn:torch.Tensor)->tuple[torch.Tensor,torch.Tensor]:
+    """E110 candidate norm with one stored basis and existing norm kernel."""
+    from . import fused_layers as F,w8a8 as W
+    F._mark('e110_mlp','E110 native8 groupA8 norm MLP active: one packed GU + H128 down basis')
+    m,k=attn_out.shape
+    if 0<m<=64:
+        q,s,res=F._nq(attn_out,residual,nw,eps)
+        out=group_mlp(q,s,wgu,sgu,wdn,sdn,None,split=2,native=8,down_warps=8)[0]
+        _audit_capture(wgu,m,"norm")
+        return out[:m],res
+    if m==0:return torch.empty_like(attn_out),torch.empty_like(residual)
+    cfg=W._cfg(m,k,sgu.numel())
+    if m >= 2048 and wgu.data_ptr() == _LAST_PREFILL_GU:
+        from . import attention as A
+        plan = A._current_plan
+        idx = plan.last_logits_rows if plan is not None else None
+        if idx is not None and 0 < idx.numel() <= 512:
+            idx = idx.long()
+            n = idx.numel()
+            kept = torch.zeros((512, k), dtype=attn_out.dtype, device=attn_out.device)
+            kept_residual = torch.zeros_like(kept)
+            kept[:n].copy_(attn_out.index_select(0, idx))
+            kept_residual[:n].copy_(residual.index_select(0, idx))
+            q, s, res, _ = F._nq_big(kept, kept_residual, nw, eps, cfg[0])
+            part = _prefill_mlp(q, s, len(kept), wgu, sgu, wdn, sdn, force_panel=True)
+            full = torch.zeros_like(attn_out)
+            full_res = torch.zeros_like(residual)
+            full.index_copy_(0, idx, part[:n])
+            full_res.index_copy_(0, idx, res[:n])
+            F._mark("e425_head_rows", "E425 last-layer original large-panel MLP for logits rows active")
+            return full, full_res
+    q,s,res,_=F._nq_big(attn_out,residual,nw,eps,cfg[0])
+    return _prefill_mlp(q,s,m,wgu,sgu,wdn,sdn),res
