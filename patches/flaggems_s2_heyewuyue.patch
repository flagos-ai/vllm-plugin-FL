diff --git a/src/flag_gems/fused/metax_fast_ops.py b/src/flag_gems/fused/metax_fast_ops.py
new file mode 100644
index 0000000..012b038
--- /dev/null
+++ b/src/flag_gems/fused/metax_fast_ops.py
@@ -0,0 +1,202 @@
+"""Pure Triton vectorized RoPE, RMSNorm, and SiLU+Mul kernels for MetaX C500."""
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _metax_rope_neox_kernel(
+    Q, K, COS, SIN, POS,
+    M,
+    sq_m, sq_h,
+    sk_m, sk_h,
+    sc_p, ss_p,
+    HQ: tl.constexpr,
+    HKV: tl.constexpr,
+    HALF_D: tl.constexpr,
+):
+    # Each program handles 1 token and 1 head (0..HQ-1 for Q, HQ..HQ+HKV-1 for K)
+    tok = tl.program_id(0)
+    hid = tl.program_id(1)
+    if tok >= M:
+        return
+    pos = tl.load(POS + tok).to(tl.int64)
+    offs = tl.arange(0, HALF_D)
+    c = tl.load(COS + pos * sc_p + offs).to(tl.float32)
+    s = tl.load(SIN + pos * ss_p + offs).to(tl.float32)
+
+    if hid < HQ:
+        base = Q + tok.to(tl.int64) * sq_m + hid * sq_h
+        x1 = tl.load(base + offs).to(tl.float32)
+        x2 = tl.load(base + HALF_D + offs).to(tl.float32)
+        y1 = x1 * c - x2 * s
+        y2 = x2 * c + x1 * s
+        tl.store(base + offs, y1.to(Q.dtype.element_ty))
+        tl.store(base + HALF_D + offs, y2.to(Q.dtype.element_ty))
+    else:
+        kh = hid - HQ
+        base = K + tok.to(tl.int64) * sk_m + kh * sk_h
+        x1 = tl.load(base + offs).to(tl.float32)
+        x2 = tl.load(base + HALF_D + offs).to(tl.float32)
+        y1 = x1 * c - x2 * s
+        y2 = x2 * c + x1 * s
+        tl.store(base + offs, y1.to(K.dtype.element_ty))
+        tl.store(base + HALF_D + offs, y2.to(K.dtype.element_ty))
+
+
+def fast_rope_forward(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    cos: torch.Tensor,
+    sin: torch.Tensor,
+    position_ids: torch.Tensor,
+    rotary_interleaved: bool = False,
+    inplace: bool = True,
+):
+    if rotary_interleaved or position_ids is None or cos.shape[-1] != 64:
+        from flag_gems.modules.rotary_embedding import gems_rope_forward
+        return gems_rope_forward(
+            query, key, cos, sin,
+            position_ids=position_ids,
+            rotary_interleaved=rotary_interleaved,
+            inplace=inplace,
+        )
+    q_orig = query
+    k_orig = key
+    if not inplace:
+        query = query.clone()
+        key = key.clone()
+    if query.dim() == 2 and query.shape[-1] % 128 == 0 and key.dim() == 2 and key.shape[-1] % 128 == 0:
+        q3 = query.view(query.shape[0], query.shape[1] // 128, 128)
+        k3 = key.view(key.shape[0], key.shape[1] // 128, 128)
+    elif query.shape[-1] == 128 and key.shape[-1] == 128:
+        q3 = query.reshape(-1, query.shape[-2], 128)
+        k3 = key.reshape(-1, key.shape[-2], 128)
+    else:
+        from flag_gems.modules.rotary_embedding import gems_rope_forward
+        return gems_rope_forward(
+            q_orig, k_orig, cos, sin,
+            position_ids=position_ids,
+            rotary_interleaved=rotary_interleaved,
+            inplace=inplace,
+        )
+    if q3.stride(2) != 1 or k3.stride(2) != 1:
+        from flag_gems.modules.rotary_embedding import gems_rope_forward
+        return gems_rope_forward(
+            q_orig, k_orig, cos, sin,
+            position_ids=position_ids,
+            rotary_interleaved=rotary_interleaved,
+            inplace=inplace,
+        )
+    pos1 = position_ids.reshape(-1)
+    M, HQ, _ = q3.shape
+    HKV = k3.shape[1]
+    if M == 0:
+        return q_orig if inplace else query, k_orig if inplace else key
+    cos2 = cos.reshape(-1, 64)
+    sin2 = sin.reshape(-1, 64)
+    _metax_rope_neox_kernel[(M, HQ + HKV)](
+        q3, k3, cos2, sin2, pos1,
+        M,
+        q3.stride(0), q3.stride(1),
+        k3.stride(0), k3.stride(1),
+        cos2.stride(0), sin2.stride(0),
+        HQ=HQ, HKV=HKV, HALF_D=64,
+        num_warps=2,
+    )
+    return (q_orig, k_orig) if inplace else (query, key)
+
+
+@triton.jit
+def _metax_rms_norm_kernel(
+    X, RES, W, OUT,
+    M, eps,
+    sx_m, sr_m, so_m,
+    HAS_RES: tl.constexpr,
+    D: tl.constexpr,
+):
+    row = tl.program_id(0)
+    if row >= M:
+        return
+    offs = tl.arange(0, D)
+    x = tl.load(X + row.to(tl.int64) * sx_m + offs).to(tl.float32)
+    if HAS_RES:
+        r = tl.load(RES + row.to(tl.int64) * sr_m + offs).to(tl.float32)
+        x = x + r
+        tl.store(RES + row.to(tl.int64) * sr_m + offs, x.to(RES.dtype.element_ty))
+    w = tl.load(W + offs).to(tl.float32)
+    var = tl.sum(x * x, axis=0) * (1.0 / D)
+    inv_rms = tl.rsqrt(var + eps)
+    y = x * inv_rms * w
+    tl.store(OUT + row.to(tl.int64) * so_m + offs, y.to(OUT.dtype.element_ty))
+
+
+def fast_rms_forward(
+    x: torch.Tensor,
+    residual: torch.Tensor | None,
+    weight: torch.Tensor,
+    epsilon: float,
+):
+    D = x.shape[-1]
+    if D != 2048 or not x.is_contiguous() or (residual is not None and not residual.is_contiguous()):
+        from flag_gems.modules.normalization import gems_rms_forward
+        return gems_rms_forward(x, residual, weight, epsilon)
+    x2 = x.reshape(-1, D)
+    M = x2.shape[0]
+    if residual is not None:
+        r2 = residual.reshape(-1, D)
+        out = x2  # in-place into x (matches vLLM fused_add_rms_norm contract)
+        _metax_rms_norm_kernel[(M,)](
+            x2, r2, weight, out,
+            M, float(epsilon),
+            x2.stride(0), r2.stride(0), out.stride(0),
+            HAS_RES=True, D=2048, num_warps=8,
+        )
+        return x, residual
+    else:
+        out = torch.empty_like(x2)
+        _metax_rms_norm_kernel[(M,)](
+            x2, x2, weight, out,
+            M, float(epsilon),
+            x2.stride(0), x2.stride(0), out.stride(0),
+            HAS_RES=False, D=2048, num_warps=8,
+        )
+        return out.reshape(x.shape)
+
+
+@triton.jit
+def _metax_silu_mul_kernel(
+    X, OUT,
+    M, D,
+    sx_m, so_m,
+    BD: tl.constexpr,
+):
+    row = tl.program_id(0)
+    blk = tl.program_id(1)
+    if row >= M:
+        return
+    offs = blk * BD + tl.arange(0, BD)
+    msk = offs < D
+    base = X + row.to(tl.int64) * sx_m
+    g = tl.load(base + offs, mask=msk, other=0.0).to(tl.float32)
+    u = tl.load(base + D + offs, mask=msk, other=0.0).to(tl.float32)
+    y = (g * tl.sigmoid(g)) * u
+    tl.store(OUT + row.to(tl.int64) * so_m + offs, y.to(OUT.dtype.element_ty), mask=msk)
+
+
+def fast_silu_and_mul(x: torch.Tensor) -> torch.Tensor:
+    if x.shape[-1] % 2 != 0:
+        from flag_gems.modules.activation import gems_silu_and_mul
+        d = x.shape[-1] // 2
+        return gems_silu_and_mul(x[..., :d], x[..., d:])
+    D = x.shape[-1] // 2
+    x2 = x.reshape(-1, 2 * D)
+    M = x2.shape[0]
+    out = torch.empty((M, D), dtype=x.dtype, device=x.device)
+    BD = 1024
+    _metax_silu_mul_kernel[(M, triton.cdiv(D, BD))](
+        x2, out, M, D, x2.stride(0), out.stride(0), BD=BD, num_warps=4,
+    )
+    return out.reshape(*x.shape[:-1], D)
diff --git a/src/flag_gems/fused/metax_w8a8.py b/src/flag_gems/fused/metax_w8a8.py
new file mode 100644
index 0000000..fdf353a
--- /dev/null
+++ b/src/flag_gems/fused/metax_w8a8.py
@@ -0,0 +1,572 @@
+"""Pure Triton W8A8 GEMM, fused RMSNorm/SiLU+Mul quantization, and vectorized RoPE for MetaX C500.
+
+INT8 weights are derived lazily at load time from BF16 weights via per-channel symmetric quantization.
+"""
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+_FLAGS_X_IGROUP = (
+    " -mllvm -metaxgpu-sched-regpressure=true -mllvm -metaxgpu-sinkload=false"
+    " -mllvm -metaxgpu-vectorize-slp=true -mllvm -metaxgpu-igroup"
+    " -mllvm -metaxgpu-aggressive-4g-addr-opt=true -mllvm -misched-postra=true"
+    " -mllvm -enable-post-misched=true "
+)
+
+
+@triton.jit
+def _rms_norm_q8_kernel(
+    X, RES, W, OUT_I8, OUT_SC,
+    M, eps,
+    sx_m, sr_m, so_m,
+    HAS_RES: tl.constexpr,
+    D: tl.constexpr,
+):
+    row = tl.program_id(0)
+    if row >= M:
+        return
+    offs = tl.arange(0, D)
+    x = tl.load(X + row.to(tl.int64) * sx_m + offs).to(tl.float32)
+    if HAS_RES:
+        r = tl.load(RES + row.to(tl.int64) * sr_m + offs).to(tl.float32)
+        x = x + r
+        tl.store(RES + row.to(tl.int64) * sr_m + offs, x.to(RES.dtype.element_ty))
+    w = tl.load(W + offs).to(tl.float32)
+    var = tl.sum(x * x, axis=0) * (1.0 / D)
+    y = x * tl.rsqrt(var + eps) * w
+    amax = tl.max(tl.abs(y), axis=0)
+    sc = tl.maximum(amax * (1.0 / 127.0), 1e-6)
+    q = y * (1.0 / sc)
+    q = tl.where(q >= 0.0, q + 0.5, q - 0.5)
+    q = tl.clamp(q, -127.0, 127.0)
+    tl.store(OUT_SC + row, sc)
+    tl.store(OUT_I8 + row.to(tl.int64) * so_m + offs, q.to(tl.int8))
+
+
+def rms_norm_q8(
+    x: torch.Tensor,
+    residual: torch.Tensor | None,
+    weight: torch.Tensor,
+    epsilon: float,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Fused (add+)RMSNorm + per-token INT8 quantization. Returns (x_i8, x_sc, residual)."""
+    D = x.shape[-1]
+    x2 = x.reshape(-1, D)
+    M = x2.shape[0]
+    out_i8 = torch.empty((M, D), dtype=torch.int8, device=x.device)
+    out_sc = torch.empty((M,), dtype=torch.float32, device=x.device)
+    if residual is not None:
+        r2 = residual.reshape(-1, D)
+        _rms_norm_q8_kernel[(M,)](
+            x2, r2, weight, out_i8, out_sc, M, float(epsilon),
+            x2.stride(0), r2.stride(0), out_i8.stride(0),
+            HAS_RES=True, D=D, num_warps=2 if M > 64 else 4,
+        )
+        return out_i8, out_sc, residual
+    else:
+        _rms_norm_q8_kernel[(M,)](
+            x2, x2, weight, out_i8, out_sc, M, float(epsilon),
+            x2.stride(0), x2.stride(0), out_i8.stride(0),
+            HAS_RES=False, D=D, num_warps=2 if M > 64 else 4,
+        )
+        return out_i8, out_sc, x
+
+
+@triton.jit
+def _silu_mul_q8_1pass_kernel(GU, OUT_I8, OUT_SC, M, sgu_m, so_m):
+    row = tl.program_id(0)
+    if row >= M:
+        return
+    base = GU + row.to(tl.int64) * sgu_m
+    o0 = tl.arange(0, 2048)
+    g0 = tl.load(base + o0).to(tl.float32); u0 = tl.load(base + 6144 + o0).to(tl.float32); y0 = (g0 * tl.sigmoid(g0)) * u0
+    g1 = tl.load(base + 2048 + o0).to(tl.float32); u1 = tl.load(base + 8192 + o0).to(tl.float32); y1 = (g1 * tl.sigmoid(g1)) * u1
+    g2 = tl.load(base + 4096 + o0).to(tl.float32); u2 = tl.load(base + 10240 + o0).to(tl.float32); y2 = (g2 * tl.sigmoid(g2)) * u2
+    amax = tl.maximum(tl.maximum(tl.max(tl.abs(y0), axis=0), tl.max(tl.abs(y1), axis=0)), tl.max(tl.abs(y2), axis=0))
+    sc = tl.maximum(amax * (1.0 / 127.0), 1e-6)
+    inv_sc = 1.0 / sc
+    tl.store(OUT_SC + row, sc)
+    ob = OUT_I8 + row.to(tl.int64) * so_m
+    q0 = tl.clamp(tl.where(y0 * inv_sc >= 0.0, y0 * inv_sc + 0.5, y0 * inv_sc - 0.5), -127.0, 127.0).to(tl.int8)
+    q1 = tl.clamp(tl.where(y1 * inv_sc >= 0.0, y1 * inv_sc + 0.5, y1 * inv_sc - 0.5), -127.0, 127.0).to(tl.int8)
+    q2 = tl.clamp(tl.where(y2 * inv_sc >= 0.0, y2 * inv_sc + 0.5, y2 * inv_sc - 0.5), -127.0, 127.0).to(tl.int8)
+    tl.store(ob + o0, q0)
+    tl.store(ob + 2048 + o0, q1)
+    tl.store(ob + 4096 + o0, q2)
+
+
+def silu_mul_q8(gu: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """1-pass fused SiLU+Mul + per-token INT8 quantization for D=6144 (1.53x faster)."""
+    D = gu.shape[-1] // 2
+    g2 = gu.reshape(-1, 2 * D)
+    M = g2.shape[0]
+    out_i8 = torch.empty((M, D), dtype=torch.int8, device=gu.device)
+    out_sc = torch.empty((M,), dtype=torch.float32, device=gu.device)
+    _silu_mul_q8_1pass_kernel[(M,)](
+        g2, out_i8, out_sc, M, g2.stride(0), out_i8.stride(0), num_warps=2 if M > 64 else 4,
+    )
+    return out_i8, out_sc
+
+
+@triton.jit
+def _quant_row_i8_kernel(
+    X, OUT_I8, OUT_SC,
+    M,
+    sx_m, so_m,
+    D: tl.constexpr,
+):
+    row = tl.program_id(0)
+    if row >= M:
+        return
+    offs = tl.arange(0, D)
+    x = tl.load(X + row.to(tl.int64) * sx_m + offs).to(tl.float32)
+    sc = tl.maximum(tl.max(tl.abs(x), axis=0) * (1.0 / 127.0), 1e-6)
+    q = x * (1.0 / sc)
+    q = tl.where(q >= 0.0, q + 0.5, q - 0.5)
+    q = tl.clamp(q, -127.0, 127.0)
+    tl.store(OUT_SC + row, sc)
+    tl.store(OUT_I8 + row.to(tl.int64) * so_m + offs, q.to(tl.int8))
+
+
+def quant_row_i8(x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    D = x.shape[-1]
+    x2 = x.reshape(-1, D)
+    M = x2.shape[0]
+    out_i8 = torch.empty((M, D), dtype=torch.int8, device=x.device)
+    out_sc = torch.empty((M,), dtype=torch.float32, device=x.device)
+    _quant_row_i8_kernel[(M,)](
+        x2, out_i8, out_sc, M, x2.stride(0), out_i8.stride(0), D=D, num_warps=2,
+    )
+    return out_i8, out_sc
+
+
+@triton.jit
+def _w8a8_nt_kernel(
+    A, B, AS, BS, C,
+    M, N, K,
+    sa_m, sa_k, sb_n, sb_k, sc_m, sc_n,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+    GROUP_M: tl.constexpr,
+    EVEN_M: tl.constexpr, EVEN_K: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    num_pid_m = tl.cdiv(M, BM)
+    num_pid_n = tl.cdiv(N, BN)
+    num_pid_in_group = GROUP_M * num_pid_n
+    group_id = pid // num_pid_in_group
+    first_pid_m = group_id * GROUP_M
+    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)
+    pid_m = first_pid_m + (pid % group_size_m)
+    pid_n = (pid % num_pid_in_group) // group_size_m
+
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+
+    a_ptrs = A + (rm[:, None].to(tl.int64) * sa_m + rk[None, :] * sa_k)
+    b_ptrs = B + (rn[:, None].to(tl.int64) * sb_n + rk[None, :] * sb_k)
+
+    acc = tl.zeros((BM, BN), dtype=tl.int32)
+    for k in range(0, tl.cdiv(K, BK)):
+        if EVEN_M and EVEN_K:
+            a = tl.load(a_ptrs)
+            b = tl.load(b_ptrs)
+        else:
+            km = k * BK + rk[None, :] < K
+            a = tl.load(a_ptrs, mask=(rm[:, None] < M) & km, other=0)
+            b = tl.load(b_ptrs, mask=(rn[:, None] < N) & km, other=0)
+        acc = tl.dot(a, tl.trans(b), acc=acc, out_dtype=tl.int32)
+        a_ptrs += BK * sa_k
+        b_ptrs += BK * sb_k
+
+    a_sc = tl.load(AS + rm, mask=rm < M, other=0.0)
+    b_sc = tl.load(BS + rn, mask=rn < N, other=0.0)
+    out = (acc.to(tl.float32) * (a_sc[:, None] * b_sc[None, :])).to(C.dtype.element_ty)
+    c_ptrs = C + (rm[:, None].to(tl.int64) * sc_m + rn[None, :] * sc_n)
+    if EVEN_M:
+        tl.store(c_ptrs, out, mask=rn[None, :] < N)
+    else:
+        tl.store(c_ptrs, out, mask=(rm[:, None] < M) & (rn[None, :] < N))
+
+
+def get_w8_weight(linear_mod) -> tuple[torch.Tensor, torch.Tensor]:
+    """Lazily derive and cache per-output-channel INT8 weights from original BF16 weight."""
+    cached = getattr(linear_mod, "_e470_w8", None)
+    w = linear_mod.weight
+    if cached is not None and cached[2] == w.data_ptr():
+        return cached[0], cached[1]
+    wf = w.detach().float()
+    sc = (wf.abs().amax(dim=1) / 127.0).clamp(min=1e-6).contiguous()
+    wi8 = torch.round(wf / sc[:, None]).clamp(-127.0, 127.0).to(torch.int8).contiguous()
+    linear_mod._e470_w8 = (wi8, sc, w.data_ptr())
+    return wi8, sc
+
+
+def w8a8_linear(a_i8: torch.Tensor, a_sc: torch.Tensor, linear_mod) -> torch.Tensor:
+    w_i8, w_sc = get_w8_weight(linear_mod)
+    M, K = a_i8.shape
+    N = w_i8.shape[0]
+    out = torch.empty((M, N), dtype=torch.bfloat16, device=a_i8.device)
+    # E470 P0 winning configs: (128,128,64) for N=2560, (128,256,64) for N=2048/12288 (197-241 TOPS)
+    if M >= 512:
+        BM = 128
+        BN = 128 if (N == 2560 or M < 1024) else 256
+        BK = 64
+        nw = 8
+    else:
+        BM, BN, BK, nw = 64, 128, 128, 8
+    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)
+    _w8a8_nt_kernel[grid](
+        a_i8, w_i8, a_sc, w_sc, out,
+        M, N, K,
+        a_i8.stride(0), a_i8.stride(1),
+        w_i8.stride(0), w_i8.stride(1),
+        out.stride(0), out.stride(1),
+        BM=BM, BN=BN, BK=BK, GROUP_M=8,
+        EVEN_M=(M % BM == 0), EVEN_K=(K % BK == 0),
+        num_warps=nw, num_stages=2, pipeline="basic", extra_options=_FLAGS_X_IGROUP,
+    )
+    return out
+
+
+@triton.jit
+def _rope_vec16_kernel(
+    Q, K, COS, SIN, POS,
+    M,
+    sq_m, sq_h, sk_m, sk_h, sc_p, ss_p,
+    HQ: tl.constexpr, HKV: tl.constexpr, HALF_D: tl.constexpr, BM: tl.constexpr,
+):
+    pm = tl.program_id(0)
+    hid = tl.program_id(1)
+    toks = pm * BM + tl.arange(0, BM)
+    tm = toks < M
+    pos = tl.load(POS + toks, mask=tm, other=0).to(tl.int64)
+    offs = tl.arange(0, HALF_D)
+    c = tl.load(COS + pos[:, None] * sc_p + offs[None, :], mask=tm[:, None], other=0.0).to(tl.float32)
+    s = tl.load(SIN + pos[:, None] * ss_p + offs[None, :], mask=tm[:, None], other=0.0).to(tl.float32)
+    if hid < HQ:
+        base = Q + toks[:, None].to(tl.int64) * sq_m + hid * sq_h
+        x1 = tl.load(base + offs[None, :], mask=tm[:, None], other=0.0).to(tl.float32)
+        x2 = tl.load(base + HALF_D + offs[None, :], mask=tm[:, None], other=0.0).to(tl.float32)
+        tl.store(base + offs[None, :], (x1 * c - x2 * s).to(Q.dtype.element_ty), mask=tm[:, None])
+        tl.store(base + HALF_D + offs[None, :], (x2 * c + x1 * s).to(Q.dtype.element_ty), mask=tm[:, None])
+    else:
+        kh = hid - HQ
+        base = K + toks[:, None].to(tl.int64) * sk_m + kh * sk_h
+        x1 = tl.load(base + offs[None, :], mask=tm[:, None], other=0.0).to(tl.float32)
+        x2 = tl.load(base + HALF_D + offs[None, :], mask=tm[:, None], other=0.0).to(tl.float32)
+        tl.store(base + offs[None, :], (x1 * c - x2 * s).to(K.dtype.element_ty), mask=tm[:, None])
+        tl.store(base + HALF_D + offs[None, :], (x2 * c + x1 * s).to(K.dtype.element_ty), mask=tm[:, None])
+
+
+def fast_rope_vec(query: torch.Tensor, key: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor, pos: torch.Tensor):
+    q3 = query.view(query.shape[0], query.shape[1] // 128, 128) if query.dim() == 2 else query.reshape(-1, query.shape[-2], 128)
+    k3 = key.view(key.shape[0], key.shape[1] // 128, 128) if key.dim() == 2 else key.reshape(-1, key.shape[-2], 128)
+    M, HQ, _ = q3.shape
+    HKV = k3.shape[1]
+    if M == 0:
+        return query, key
+    pos1 = pos.reshape(-1)
+    cos2 = cos.reshape(-1, 64)
+    sin2 = sin.reshape(-1, 64)
+    BM = 8 if M <= 64 else 16
+    _rope_vec16_kernel[(triton.cdiv(M, BM), HQ + HKV)](
+        q3, k3, cos2, sin2, pos1, M,
+        q3.stride(0), q3.stride(1), k3.stride(0), k3.stride(1),
+        cos2.stride(0), sin2.stride(0),
+        HQ=HQ, HKV=HKV, HALF_D=64, BM=BM, num_warps=4,
+    )
+    return query, key
+
+
+@triton.jit
+def _gather_2x_bf16_kernel(
+    H_in, R_in, P_in, IDX, H_out, R_out, P_out,
+    M_out, D,
+    sh_in, sr_in, sh_out, sr_out,
+    BD: tl.constexpr,
+):
+    row = tl.program_id(0)
+    if row >= M_out:
+        return
+    src = tl.load(IDX + row)
+    pos = tl.load(P_in + src)
+    tl.store(P_out + row, pos)
+    offs = tl.arange(0, BD)
+    mask = offs < D
+    h = tl.load(H_in + src.to(tl.int64) * sh_in + offs, mask=mask)
+    r = tl.load(R_in + src.to(tl.int64) * sr_in + offs, mask=mask)
+    tl.store(H_out + row.to(tl.int64) * sh_out + offs, h, mask=mask)
+    tl.store(R_out + row.to(tl.int64) * sr_out + offs, r, mask=mask)
+
+
+def fast_gather_2x_bf16(
+    h: torch.Tensor, r: torch.Tensor, pos: torch.Tensor, idx: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    M_out = int(idx.shape[0])
+    D = int(h.shape[1])
+    h_out = torch.empty((M_out, D), dtype=h.dtype, device=h.device)
+    r_out = torch.empty((M_out, D), dtype=r.dtype, device=r.device)
+    p_out = torch.empty((M_out,), dtype=pos.dtype, device=pos.device)
+    BD = triton.next_power_of_2(D)
+    _gather_2x_bf16_kernel[(M_out,)](
+        h, r, pos, idx, h_out, r_out, p_out,
+        M_out, D, h.stride(0), r.stride(0), h_out.stride(0), r_out.stride(0),
+        BD=BD, num_warps=8,
+    )
+    return h_out, r_out, p_out
+
+
+def w8a8_lm_head(x: torch.Tensor, w_i8: torch.Tensor, w_sc: torch.Tensor) -> torch.Tensor:
+    a_i8, a_sc = quant_row_i8(x)
