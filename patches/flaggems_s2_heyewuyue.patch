+    key = (K, N)
+    if key not in fixed_mm_calls:
+        logger.warning("E035 fixed mm rule (K=%d, N=%d): %d ranges, first M=%d uses %s warps=%d stages=%d", K, N, len(rules), M, tile, num_warps, num_stages)
+        fixed_mm_calls[key] = 0
+    fixed_mm_calls[key] += 1
+    with torch_device_fn.device(a.device):
+        if "SPLIT_K" in tile:
+            _launch_sk(a, b, c, M, N, K, tile, num_warps, num_stages)
+        else:
