+def _dec14_asm(slack=6.0):
+    """Text of the page loop of one decode row (one lane block of 64 x 16 x 16). The page image above is the operand layout of
+    ml_matrix_mad_f32_f16_m16n16k16 (D = A x B + C; A[m, k]: lane k + 16 ((m >> 1) & 3), half m & 1, reg m >> 3; B[k, n]: lane
+    n + 16 ((k >> 1) & 3), half k & 1, reg k >> 3; D[m, n]: lane n + 16 (m & 3), reg m >> 2), so the loop has no layout conversion,
+    no shared memory, no shuffle and no barrier. A raw nibble is a valid fp16 denormal (n * 2^-24). Softmax is lazy: the running
+    max moves only when a score passes it by `slack` (log2 units), in the cold path. E040 attempt 24."""
+    import struct
+    L = []
+    e = L.append
+    names = ["pg_lo", "pg_hi", "tab_lo", "tab_hi", "lo", "hi", "rem", "npg", "po_lo", "po_hi", "pm_lo", "pm_hi", "pl_lo", "pl_hi",
+             "qk", "lane", "q_lo", "q_hi", "q_off"]
+    IN = {n: "$%d" % (i + 2) for i, n in enumerate(names)}
+
+    def A(g, p):                                     # output accumulator tuple
+        return 4 * (g * 4 + p)
+    R, DA, EA, Z4, REC, KR, VR, AT = 32, (36, 44), (40, 48), 52, 56, 60, 68, 76
+    PA, PB, PF, LL, MM, TH, QS0, QS1, T0, T1, T2, T3, ON = 78, 80, 82, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93
+    OFF, ROFF, X1, X2, QR, LANE, LG, NINF, POFF, PMF = 95, 96, 98, 99, 100, 116, 117, 118, 119, 120
