+@triton.jit
+def _ws4_kernel(C16, C8, TABLE, SEQ_LENS, PIDX, WSO, KW, VW, s_tab, s_wg, HKV: tl.constexpr, D: tl.constexpr, V2: tl.constexpr):
+    """One page of prefill sequence PIDX[p] -> bf16 workspace [HKV, token, D] (rotated space); tokens past the length are 0."""
+    p = tl.program_id(0)
+    pg = tl.program_id(1)
+    s = tl.load(PIDX + p)
+    L = tl.load(SEQ_LENS + s)
+    if pg * 16 >= L:
+        return
+    blk = tl.load(TABLE + s.to(tl.int64) * s_tab + pg).to(tl.int64)
+    off = tl.load(WSO + p).to(tl.int64) + pg * 16
+    tt = tl.arange(0, 16)
+    e = tl.arange(0, 32)
+    ok = (pg * 16 + tt) < L
+    blkv = tl.zeros([16], tl.int64) + blk
+    p16 = C16 + blk * 2112
+    g0 = (e < 16)[None, :]
+    for g in range(HKV):
+        ht = g * 16 + tt
+        kx = tl.load(p16 + _hw_k(g, e[None, :], tt[:, None])).to(tl.int32)
+        if V2:
+            vx = tl.load(p16 + _hw_v2(g, e[None, :] & 15, tt[:, None])).to(tl.int32)
+        else:
+            vx = tl.load(p16 + _hw_v(g, e[None, :], tt[:, None])).to(tl.int32)
+        s0, s1, z0, z1, sv = _meta(C8, blkv, ht, ok)
+        sk = tl.where(g0, s0[:, None], s1[:, None])
+        zk = tl.where(g0, z0[:, None], z1[:, None])
+        dst = g * s_wg + (off + tt)[:, None] * D + (4 * e)[None, :]
+        for j in tl.static_range(4):
+            kv_ = tl.where(ok[:, None], (((kx >> (4 * j)) & 15).to(tl.float32) - zk) * sk, 0.0)
+            if V2:
+                vv_ = tl.where(ok[:, None], ((((vx >> (8 * (e >> 4)[None, :] + 2 * j)) & 3).to(tl.float32) - 1.5) * sv[:, None]), 0.0)
+            else:
+                vv_ = tl.where(ok[:, None], (((vx >> (4 * j)) & 15).to(tl.float32) - 8.0) * sv[:, None], 0.0)
+            tl.store(KW + dst + j, kv_.to(KW.dtype.element_ty))
+            tl.store(VW + dst + j, vv_.to(VW.dtype.element_ty))
+
+
+@triton.jit
+def _bits16(x, ty):
+    """fp32 -> workspace dtype, its 16 bits zero-extended into int64"""
+    return (x.to(ty).to(tl.int16, bitcast=True).to(tl.int32) & 0xFFFF).to(tl.int64)
+
+
+@triton.jit
+def _ws4p_kernel(C16, C8, TABLE, SEQ_LENS, PIDX, WSO, KW, VW, s_tab, s_wg4, max_pages,
+                 HKV: tl.constexpr, D: tl.constexpr, V2: tl.constexpr, PPP: tl.constexpr):
+    """E097: _ws4_kernel with the same per-element arithmetic, but each halfword e is loaded once and its four dims
+    4e..4e+3 are packed into one int64 word, so a [16 tokens, 128 dims] tile is 32 contiguous 8-byte words per token
+    (coalesced, no partial-sector stores). PPP consecutive pages per program."""
+    p = tl.program_id(0)
+    s = tl.load(PIDX + p)
+    L = tl.load(SEQ_LENS + s)
+    tt = tl.arange(0, 16)
+    e = tl.arange(0, 32)[None, :]
+    g0 = e < 16
+    ty = KW.dtype.element_ty
+    KW64 = KW.to(tl.pointer_type(tl.int64))
+    VW64 = VW.to(tl.pointer_type(tl.int64))
+    for i in tl.static_range(PPP):
+        pg = tl.program_id(1) * PPP + i
+        if (pg * 16 < L) & (pg < max_pages):
+            blk = tl.load(TABLE + s.to(tl.int64) * s_tab + pg).to(tl.int64)
+            off = tl.load(WSO + p).to(tl.int64) + pg * 16
+            ok = (pg * 16 + tt) < L
+            blkv = tl.zeros([16], tl.int64) + blk
+            p16 = C16 + blk * 2112
+            for g in tl.static_range(HKV):
+                ht = g * 16 + tt
+                kx = tl.load(p16 + _hw_k(g, e, tt[:, None])).to(tl.int32)
+                if V2:
+                    vx = tl.load(p16 + _hw_v2(g, e & 15, tt[:, None])).to(tl.int32)
+                else:
+                    vx = tl.load(p16 + _hw_v(g, e, tt[:, None])).to(tl.int32)
+                s0, s1, z0, z1, sv = _meta(C8, blkv, ht, ok)
+                sk = tl.where(g0, s0[:, None], s1[:, None])
+                zk = tl.where(g0, z0[:, None], z1[:, None])
+                kword = tl.zeros([16, 32], tl.int64)
+                vword = tl.zeros([16, 32], tl.int64)
+                for j in tl.static_range(4):
+                    kv_ = tl.where(ok[:, None], (((kx >> (4 * j)) & 15).to(tl.float32) - zk) * sk, 0.0)
+                    if V2:
+                        vv_ = tl.where(ok[:, None], ((((vx >> (8 * (e >> 4) + 2 * j)) & 3).to(tl.float32) - 1.5) * sv[:, None]), 0.0)
+                    else:
+                        vv_ = tl.where(ok[:, None], (((vx >> (4 * j)) & 15).to(tl.float32) - 8.0) * sv[:, None], 0.0)
+                    kword = kword | (_bits16(kv_, ty) << (16 * j))
+                    vword = vword | (_bits16(vv_, ty) << (16 * j))
+                dst = g * s_wg4 + (off + tt)[:, None] * (D // 4) + e
+                tl.store(KW64 + dst, kword)
+                tl.store(VW64 + dst, vword)
+
+
+WS4_PACKED = True      # E097 (False = E092 strided _ws4_kernel)
+WS4_PPP = 1
+WS4_WARPS = 2        # E097 P0 attempt 2: 2 warps fastest of {1,2,4} x PPP {1,2,4}
+_WS4_MARKED = False
+
+
+def run_ws4(c16, c8, table, seq, plan, kw, vw, v2):
+    history_pages = getattr(plan, "history_pages", None)
+    if history_pages is None:
+        history_pages = plan.max_pages
+    if history_pages == 0:
+        return
+    global _WS4_MARKED
+    if not WS4_PACKED:
+        _ws4_kernel[(plan.n_p, history_pages)](c16, c8, table, seq, plan.pidx, plan.wso, kw, vw,
+                                                table.stride(0), kw.stride(0), HKV=HKV_EXP, D=D, V2=v2, num_warps=4)
+        return
+    if not _WS4_MARKED:
+        _WS4_MARKED = True
+        logger.warning("E097 packed int64 ws4 stores active ppp=%d warps=%d", WS4_PPP, WS4_WARPS)
+    _ws4p_kernel[(plan.n_p, triton.cdiv(history_pages, WS4_PPP))](
+        c16, c8, table, seq, plan.pidx, plan.wso, kw, vw, table.stride(0), kw.stride(0) // 4, history_pages,
+        HKV=HKV_EXP, D=D, V2=v2, PPP=WS4_PPP, num_warps=WS4_WARPS)
+
+
+@triton.jit
+def _clear_partial_page(KW, VW, SEQ, PIDX, WSO, head_stride, D: tl.constexpr):
+    request = tl.program_id(0)
+    head = tl.program_id(1)
+    seq = tl.load(PIDX + request)
+    length = tl.load(SEQ + seq)
+    partial = length % 16
+    if partial != 0:
+        lane = tl.arange(0, 16)
+        row = tl.load(WSO + request).to(tl.int64) + length - partial + lane
+        offset = head * head_stride + row[:, None] * D + tl.arange(0, D)[None, :]
+        tl.store(KW + offset, 0, mask=lane[:, None] >= partial)
+        tl.store(VW + offset, 0, mask=lane[:, None] >= partial)
+
+
+@triton.jit
+def _ws_fresh_kernel(KR, VR, CU_Q, SEQ_LENS, PIDX, WSO, KW, VW, s_r0, s_r1, s_wg, HKV: tl.constexpr, D: tl.constexpr):
+    """The prefill chunk's own rotated K / V (bf16) over its workspace rows: a chunk attends to itself unquantised."""
+    p = tl.program_id(0)
+    b = tl.program_id(1)
+    s = tl.load(PIDX + p)
+    c0 = tl.load(CU_Q + s)
+    qlen = tl.load(CU_Q + s + 1) - c0
+    if b * 16 >= qlen:
+        return
+    ctx = tl.load(SEQ_LENS + s) - qlen
+    t = b * 16 + tl.arange(0, 16)
+    ok = t < qlen
+    d = tl.arange(0, D)
+    off = tl.load(WSO + p).to(tl.int64) + ctx + t
+    src = (c0 + t).to(tl.int64)[:, None] * s_r0 + d[None, :]
+    for g in range(HKV):
+        k = tl.load(KR + src + g * s_r1, mask=ok[:, None], other=0.0)
+        v = tl.load(VR + src + g * s_r1, mask=ok[:, None], other=0.0)
+        tl.store(KW + g * s_wg + off[:, None] * D + d[None, :], k.to(KW.dtype.element_ty), mask=ok[:, None])
+        tl.store(VW + g * s_wg + off[:, None] * D + d[None, :], v.to(VW.dtype.element_ty), mask=ok[:, None])
+
