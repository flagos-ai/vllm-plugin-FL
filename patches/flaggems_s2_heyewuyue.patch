@@ -0,0 +1,80 @@
+"""Epoch-refreshed sparse-table page attention kernels for Iluvatar BI-V150.
+Only logical loop count changes; final selected page must be original final cold page.
+"""
+import torch,triton
+import triton.language as tl
+from flag_gems.fused.minicpm.int4_kv import _wstart,_lo32,_hi32,_DEC14_ASM,_DEC14_CONS
+from flag_gems.fused.minicpm.int4_kv_v2 import _DEC15_ASM,_DEC15_CONS
+
+@triton.jit(do_not_specialize=["S"])
+def _dec14_kernel_epoch(Q, PG, ORIGINAL, TABLE, COUNTS, REFRESH, SEQ_LENS, CU_Q, ROWSLOT, TAGS, PO, PM, PL, qk_scale, s_q0, s_q1, s_original, s_tab, S, W: tl.constexpr, SKIP_REFRESH: tl.constexpr):
+    """One decode row, split S: Triton sets up pointers and the window start, the page loop is one inline asm block (see above)."""
+    seq = tl.program_id(1)
+    sp = tl.program_id(2)
+    if SKIP_REFRESH:
+        if tl.load(REFRESH+seq)!=0:return
+    qrow = tl.load(CU_Q + seq)
+    if tl.load(CU_Q + seq + 1) - qrow != 1:
+        return
+    L4, _ = _wstart(TAGS, ROWSLOT, seq, tl.load(SEQ_LENS + seq), W)
+    original_npg = tl.cdiv(L4, 16)
+    count = tl.load(COUNTS + seq)
+    active = count >= 0
+    npg = tl.where(active,count,original_npg)
+    per = tl.cdiv(npg, S)
+    lo = sp * per
+    hi = tl.maximum(tl.minimum(lo + per, npg), lo)
+    lane = tl.arange(0, 64)
+    z = lane * 0
+    col = lane & 15
+    pbase = (seq * (S + 1) + sp) * 16
+    pg = (PG + z).to(tl.int64, bitcast=True)
+    tab = tl.where(active,(TABLE+seq.to(tl.int64)*s_tab+z).to(tl.int64,bitcast=True),
+                   (ORIGINAL+seq.to(tl.int64)*s_original+z).to(tl.int64,bitcast=True))
+    po = (PO + pbase * 128 + z).to(tl.int64, bitcast=True)
+    pm = (PM + pbase + z).to(tl.int64, bitcast=True)
+    pl = (PL + pbase + z).to(tl.int64, bitcast=True)
+    qp = (Q + qrow.to(tl.int64) * s_q0 + z).to(tl.int64, bitcast=True)
+    qk = (z.to(tl.float32) + qk_scale * 16777216.0).to(tl.int32, bitcast=True)
+    rem = z + (L4 - (original_npg - 1) * 16)
+    x0, x1 = tl.inline_asm_elementwise(_DEC14_ASM, _DEC14_CONS, [_lo32(pg), _hi32(pg), _lo32(tab), _hi32(tab), z + lo, z + hi, rem, z + npg,
+                                                                _lo32(po), _hi32(po), _lo32(pm), _hi32(pm), _lo32(pl), _hi32(pl), qk, lane,
+                                                                _lo32(qp), _hi32(qp), col * s_q1 * 2],
+                                       dtype=(tl.int32, tl.int32), is_pure=False, pack=1)
+
+
+
+@triton.jit(do_not_specialize=["S"])
+def _dec15_kernel_epoch(Q, PG, ORIGINAL, TABLE, COUNTS, REFRESH, SEQ_LENS, CU_Q, ROWSLOT, TAGS, PO, PM, PL, qk_scale, s_q0, s_q1, s_original, s_tab, S, W: tl.constexpr, SKIP_REFRESH: tl.constexpr):
+    seq = tl.program_id(1)
+    sp = tl.program_id(2)
+    if SKIP_REFRESH:
+        if tl.load(REFRESH+seq)!=0:return
+    qrow = tl.load(CU_Q + seq)
+    if tl.load(CU_Q + seq + 1) - qrow != 1:
+        return
+    L4, _ = _wstart(TAGS, ROWSLOT, seq, tl.load(SEQ_LENS + seq), W)
+    original_npg = tl.cdiv(L4, 16)
+    count = tl.load(COUNTS + seq)
+    active = count >= 0
+    npg = tl.where(active,count,original_npg)
+    per = tl.cdiv(npg, S)
+    lo = sp * per
+    hi = tl.maximum(tl.minimum(lo + per, npg), lo)
+    lane = tl.arange(0, 64)
+    z = lane * 0
+    col = lane & 15
+    pbase = (seq * (S + 1) + sp) * 16
+    pg = (PG + z).to(tl.int64, bitcast=True)
+    tab = tl.where(active,(TABLE+seq.to(tl.int64)*s_tab+z).to(tl.int64,bitcast=True),
+                   (ORIGINAL+seq.to(tl.int64)*s_original+z).to(tl.int64,bitcast=True))
+    po = (PO + pbase * 128 + z).to(tl.int64, bitcast=True)
+    pm = (PM + pbase + z).to(tl.int64, bitcast=True)
+    pl = (PL + pbase + z).to(tl.int64, bitcast=True)
+    qp = (Q + qrow.to(tl.int64) * s_q0 + z).to(tl.int64, bitcast=True)
+    qk = (z.to(tl.float32) + qk_scale * 16777216.0).to(tl.int32, bitcast=True)
+    rem = z + (L4 - (original_npg - 1) * 16)
+    x0, x1 = tl.inline_asm_elementwise(_DEC15_ASM, _DEC15_CONS, [_lo32(pg), _hi32(pg), _lo32(tab), _hi32(tab), z + lo, z + hi, rem, z + npg,
+                                                                _lo32(po), _hi32(po), _lo32(pm), _hi32(pm), _lo32(pl), _hi32(pl), qk, lane,
+                                                                _lo32(qp), _hi32(qp), col * s_q1 * 2],
+                                       dtype=(tl.int32, tl.int32), is_pure=False, pack=1)
diff --git a/src/flag_gems/fused/minicpm/_group_a8_mlp.py b/src/flag_gems/fused/minicpm/_group_a8_mlp.py
