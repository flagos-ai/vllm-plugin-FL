+def cache_views(kv_cache):
+    """kv_cache [blocks, 2, 16, 2, 66] int8 (one 4224 B page per block) -> (uint8 byte view, int16 view) at its address."""
+    assert kv_cache.dtype == torch.int8 and kv_cache.shape[1:] == (2, PAGE, HKV_EXP, LAST_DIM), kv_cache.shape
+    assert kv_cache.stride(0) == PAGE_BYTES and kv_cache.storage_offset() % 2 == 0
+    nb = kv_cache.shape[0]
+    c8 = torch.as_strided(kv_cache, (nb * PAGE_BYTES,), (1,), kv_cache.storage_offset()).view(torch.uint8)
+    base = torch.tensor([], dtype=torch.int16, device=kv_cache.device).set_(kv_cache.untyped_storage())
+    c16 = torch.as_strided(base, (nb * PAGE_BYTES // 2,), (1,), kv_cache.storage_offset() // 2)
+    return c8, c16
+
