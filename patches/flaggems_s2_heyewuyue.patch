+            v[w0:] = _win_ref(vs[i][w0:])
+        ref = _ref_attn(qc[i], k, v, scale)
+        e = ((out[i] - ref).abs().max() / ref.abs().max()).item()
+        err = max(err, e)
+        if slots[i] >= 0 and i != 4:
+            err_nowin = max(err_nowin, ((out[i] - _ref_attn(qc[i], k4, v4, scale)).abs().max() / ref.abs().max()).item())
+    res["decode"] = err
+    res["decode_vs_no_window_ref"] = err_nowin                                   # positive control: must be clearly larger
+    res["prefill"] = _check_prefill(device, gen, A, SimpleNamespace)
+    return res
+
+
+def _check_prefill(device, gen, A, NS):
+    """A mixed step: two prefill chunks over earlier context (one with context 0) plus one decode row."""
+    kv = torch.zeros((400, 2, PAGE, HKV_EXP, LAST_DIM), dtype=torch.int8, device=device)
+    c8, c16 = cache_views(kv)
+    win = Window(device)
