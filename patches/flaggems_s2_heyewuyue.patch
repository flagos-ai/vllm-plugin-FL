+def _recolor_q_lane(text):
+    import re
+    # Restore the original v14 Q operand's mod4 register-bank alignment.
+    # A cyclic permutation keeps the same live set and total register count.
+    def reg(x):
+        return x+1 if 119<=x<=134 else(119 if x==135 else x)
+    def replace(m):
+        if m.group(1) is not None:
+            a,b=reg(int(m.group(1))),reg(int(m.group(2)))
+            assert b-a==int(m.group(2))-int(m.group(1)),m.group(0)
+            return f'v[{a}:{b}]'
+        return 'v'+str(reg(int(m.group(3))))
+    return re.sub(r'v\[(\d+):(\d+)\]|\bv(\d+)',replace,text)
+
+
+_TAGGED_COLOR_ASM=tl.constexpr(_recolor_q_lane(_tagged_asm()))
+_TAGGED_COLOR2_ASM=tl.constexpr(_recolor_q_lane(_tagged_asm(True)))
