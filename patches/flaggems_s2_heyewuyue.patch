--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_epoch_normalize.py
@@ -0,0 +1,25 @@
+import triton
+import triton.language as tl
+_CAP=tl.constexpr(2048)
+
+@triton.jit
+def normalize(MASS,COLD,NORM,SCORES,REFRESH,PB:tl.constexpr=16,LOOP:tl.constexpr=1):
+    row=tl.program_id(0)
+    if tl.load(REFRESH+row)==0:return
+    npg=tl.load(COLD+row)
+    for it in tl.static_range(LOOP):
+        blk=tl.program_id(1)*LOOP+it
+        page=blk*PB+tl.arange(0,PB)
+        rank=tl.full((PB,),float('-inf'),tl.float32)
+        if (npg>0)&(blk*PB<npg):
+            h=tl.arange(0,16);g=tl.arange(0,4)
+            offset=((row*_CAP+page[:,None,None])*64+g[None,:,None]*16+h[None,None,:])*2
+            p=tl.load(MASS+offset,page[:,None,None]<npg,0.)
+            pm=tl.load(MASS+((row*_CAP+page[:,None])*64+h[None,:])*2+1,page[:,None]<npg,0.)
+            mx=tl.load(NORM+row*32+h);inv=tl.load(NORM+row*32+16+h)
+            mass=tl.sum(p,1)*tl.exp2(pm-mx[None,:])*inv[None,:]
+            rank=tl.max(mass,1)
+            rank=tl.where(page<npg,rank,float('-inf'))
+            rank=tl.where((page==0)|(page==npg-1),float('inf'),rank)
+        tl.store(SCORES+row*_CAP+page,rank)
+
