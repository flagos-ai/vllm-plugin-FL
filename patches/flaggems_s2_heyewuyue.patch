+def _fused_asm(v2=False,token=False):
+    import struct
+    cold = _cold_remapped_v2() if v2 else _cold_remapped()
+    prefix = cold[:cold.index('.Lk14_done:')] + '.Lk14_done:;\nsl_wait vmcnt(0);\n'
+    prefix = prefix.replace('.Lk14_', '.Lc14_')
+    saved = ''.join(f'ml_mov_v2s_b32 s{48+i}, ${21+i}, 0x0;\n' for i in range(6))
+    transition = []
+    # Correct the old nibble offset without normalizing or writing O; all O
+    # values remain in the common denormal*64 accumulator unit.
+    for r in range(32):
+        if v2:
+            plane=r//4
+            exponent=plane if plane<=4 else plane-5
+            coefficient=struct.unpack('<I',struct.pack('<f',1.5*4.**exponent))[0]
+            inv=struct.unpack('<I',struct.pack('<f',4.**(-exponent)))[0]
+            transition.append(f'ml_mul_f32 v109, v{32+r%4}, 0x{coefficient:08x}')
+            transition.append(f'ml_sub_f32 v{r}, v{r}, v109')
+            transition.append(f'ml_mul_f32 v{r}, v{r}, 0x{inv:08x}')
+        else:
+            transition.append(f'ml_sub_f32 v{r}, v{r}, v{32+r%4}')
+    for r in range(32,36):
+        transition.append(f'ml_mov_b32 v{r}, 0x0')
+    transition += ['sl_mov_b64 s[16:17], s[48:49]',
+        'sl_mov_b64 s[36:37], s[50:51]', 'sl_mov_b32 s20, s52',
+        'sl_mov_b32 s21, s53', 'sl_mov_b32 s22, 0x10', 'sl_mov_b32 s23, 0x7',
+        'ml_mov_b32 v113, 0x800080', 'ml_mov_b32 v114, 0x800080',
+        'ml_mov_b32 v109, s30', 'ml_mul_f32 v109, v109, 0x33800000',
+        'ml_mov_v2s_b32 s30, v109, 0x0', 'ml_shl_b32 v115, v135, 0x3']
+    window = _window_asm(token=token)
+    suffix = window[window.index('.Lk14_loop:'):]
+    return saved + prefix + ';\n'.join(transition)+';\n'+suffix
+
