+                int((_ROW_SLOT[:seq.shape[0]] >= 0).sum()) if not torch.cuda.is_current_stream_capturing() else -1)
+        run_decode4(qr, c8, c16, win, outr, cu, seq, table, scale, seq.shape[0], final, v2)
+        return
+    A._once("e040pf", "E040 int4 KV: prefill path active")
