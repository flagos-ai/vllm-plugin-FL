+@triton.jit
+def tagged_recipient(Q,PG,ORIGINAL,TAB,COUNTS,WPG,SEQ,CU,ROWS,TAGS,PO,PM,PL,
+                     qk_scale,s_q0,s_q1,s_original,s_tab,S:tl.constexpr,V2:tl.constexpr=False,COLOR:tl.constexpr=0,TOKEN:tl.constexpr=False,SPLIT_META:tl.constexpr=False,WMETA=None):
+    row=tl.program_id(0);sp=tl.program_id(1)
