@@ -0,0 +1,372 @@
+"""E043 fused decoder-layer halves for Iluvatar BI-V150, Llama-style layer, W8A8 weights, decode (M <= 64 rows).
+
+  iluvatar_norm_qkv : (hidden + residual) -> RMSNorm -> int8 row quant -> qkv GEMM            (1 custom op, 2 launches)
+  iluvatar_norm_mlp : (attn_out + residual) -> RMSNorm -> int8 quant -> gate_up GEMM with silu*up epilogue
+                      -> Hadamard rotation + int8 quant -> down GEMM                            (1 custom op, 5 launches)
+
+Stock chain per layer for the same work: norm (inductor) + quant + GEMM, norm + quant + gate_up GEMM + silu (inductor) + rot + quant + GEMM.
+M > 64 (prefill / mixed) runs the stock formulas inside the op, so numerics there only differ by the RMSNorm rounding order.
+Mechanism markers: "E043 fused norm+quant+qkv active" / "E043 fused norm+quant+gate_up(silu)+down active" (once per process).
+"""
+import weakref
+
+import torch
+import triton
+import triton.language as tl
+
+import logging
+
+from . import w8a8 as W
+from . import int4_kv as I4
+
+from .logging_utils import get_logger
+logger = get_logger(__name__)
+_MAXM = 64
+_MARKED = set()
+_UNIT_NORMS = weakref.WeakValueDictionary()
+
+
+def register_unit_norm(weight):
+    _UNIT_NORMS[(weight.device, weight.data_ptr())] = weight
+
+
+def _unit_norm(weight):
+    unit = _UNIT_NORMS.get((weight.device, weight.data_ptr()))
+    if unit is not None:
+        _mark("unit_norm", "E451 identity RMS gamma parallel maximum active")
+    return unit is not None
+
+
+def _mark(key, msg):
+    if key not in _MARKED:
+        _MARKED.add(key)
+        logger.warning(msg)
+
+
+@triton.jit
+def _nq_kernel(A, B, RES, WT, Q, S, M, eps, K: tl.constexpr, UNIT: tl.constexpr = False):
+    """One row per program: r = bf16(a + b) (stored to RES), y = bf16(r * rsqrt(mean(r^2) + eps) * w), s = max|y| / 127, q = int8(y / s).
+    Rows >= M are written as zero rows (q = 0, s = 1e-8 / 127), as the stock zero-padded quant does."""
+    offs = tl.arange(0, K)
+    row = tl.program_id(0)
+    ok = (offs * 0 + row) < M
+    h = (tl.load(A + row * K + offs, mask=ok, other=0.0).to(tl.float32) + tl.load(B + row * K + offs, mask=ok, other=0.0).to(tl.float32)).to(tl.bfloat16)
+    tl.store(RES + row * K + offs, h, mask=ok)
+    h = h.to(tl.float32)
+    var = tl.sum(h * h, 0) / K
+    inv = tl.math.rsqrt(var + eps)
+    if UNIT:
+        # BF16 round-to-nearest is monotone; inv is a positive row scalar.
+        peak = (tl.max(tl.abs(h), 0) * inv).to(tl.bfloat16).to(tl.float32)
+        y = (h * inv).to(tl.bfloat16).to(tl.float32)
+    else:
+        w = tl.load(WT + offs).to(tl.float32)
+        y = (h * inv * w).to(tl.bfloat16).to(tl.float32)
+        peak = tl.max(tl.abs(y), 0)
+    s = tl.maximum(peak, 1e-8) / 127.0
+    q = tl.minimum(tl.maximum(tl.floor(y / s + 0.5), -127.0), 127.0)
+    tl.store(Q + row * K + offs, q.to(tl.int8))
+    tl.store(S + row, s)
+
+
+@triton.jit
+def _gemm_silu_kernel(A, B, C, SA, SB, K, F_: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    """C[:, j] = silu(g_j) * u_j with g = A @ B[j].T, u = A @ B[F + j].T (int8 -> int32, per-row x per-column scales, bf16 rounding of g and u)."""
+    pn = tl.program_id(0)
+    rm = tl.arange(0, BM)
+    rn = pn * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    a = A + rm[:, None] * K + rk[None, :]
+    bg = B + rn[None, :] * K + rk[:, None]
+    bu = bg + F_ * K
+    ag = tl.zeros([BM, BN], dtype=tl.int32)
+    au = tl.zeros([BM, BN], dtype=tl.int32)
+    for _ in tl.range(0, K, BK):
+        at = tl.load(a)
+        ag += tl.dot(at, tl.load(bg), out_dtype=tl.int32)
+        au += tl.dot(at, tl.load(bu), out_dtype=tl.int32)
+        a += BK
+        bg += BK
+        bu += BK
+    sa = tl.load(SA + rm)
+    g = (ag.to(tl.float32) * sa[:, None] * tl.load(SB + rn)[None, :]).to(tl.bfloat16).to(tl.float32)
+    u = (au.to(tl.float32) * sa[:, None] * tl.load(SB + F_ + rn)[None, :]).to(tl.bfloat16).to(tl.float32)
+    tl.store(C + rm[:, None] * F_ + rn[None, :], ((g * tl.sigmoid(g)) * u).to(tl.bfloat16))
+
+
+@triton.jit
+def _silu_mul_kernel(GU, OUT, F_: tl.constexpr, BLOCK: tl.constexpr):
+    """OUT[r, c] = bf16(bf16(silu(g)) * u) with g = GU[r, c], u = GU[r, F + c] (one pass; the eager chain ran 4)."""
+    r = tl.program_id(0).to(tl.int64)
+    c = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    g = tl.load(GU + r * (2 * F_) + c).to(tl.float32)
+    u = tl.load(GU + r * (2 * F_) + F_ + c).to(tl.float32)
+    sg = (g * tl.sigmoid(g)).to(tl.bfloat16).to(tl.float32)
+    tl.store(OUT + r * F_ + c, (sg * u).to(OUT.dtype.element_ty))
+
+
+def _norm_ref(h: torch.Tensor, w: torch.Tensor, eps: float) -> torch.Tensor:
+    hf = h.float()
+    return (hf * torch.rsqrt(hf.pow(2).mean(-1, keepdim=True) + eps) * w.float()).to(h.dtype)
+
+
+def _nq(a, b, w, eps):
+    m, k = a.shape
+    q = torch.empty((_MAXM, k), dtype=torch.int8, device=a.device)
+    s = torch.empty((_MAXM,), dtype=torch.float32, device=a.device)
+    res = torch.empty_like(a)
+    _nq_kernel[(_MAXM,)](a, b, res, w, q, s, m, eps, K=k, UNIT=_unit_norm(w), num_warps=8)
+    return q, s, res
+
+
+def _gemm(q, s, w, ws, m):
+    n, k = w.shape
+    bm, bn, bk, nw, ns, grp = W._cfg(m, k, n)
+    out = torch.empty((_MAXM, n), dtype=torch.bfloat16, device=w.device)
+    W._gemm_kernel[(n // bn,)](q, w, out, s, ws, n, k, BM=bm, BN=bn, BK=bk, GROUP=grp, NPM=1, num_warps=nw, num_stages=ns)
+    return out
+
+
+def _fused_ok(m: int, k: int) -> bool:
+    return m <= _MAXM and _MAXM >= 1 and k & (k - 1) == 0 and k <= 8192
+
+
+def _big_ok(m: int, k: int, *xs: torch.Tensor) -> bool:
+    """M > 64 (prefill / mixed): one norm+quant kernel over padded rows + the stock prefill GEMM tiles. Rows must be dense."""
+    return m > _MAXM and k & (k - 1) == 0 and k <= 8192 and all(x.stride(1) == 1 and x.stride(0) == k for x in xs)
+
+
+def _nq_big(a, b, w, eps, bm):
+    m, k = a.shape
+    npm = triton.cdiv(m, bm)
+    mp = npm * bm
+    q = torch.empty((mp, k), dtype=torch.int8, device=a.device)
+    s = torch.empty((mp,), dtype=torch.float32, device=a.device)
+    res = torch.empty_like(a)
+    _nq_kernel[(mp,)](a, b, res, w, q, s, m, eps, K=k, UNIT=_unit_norm(w), num_warps=8)
+    return q, s, res, npm
+
+
+def _gemm_big(q, s, w, ws, m, npm, cfg):
+    n, k = w.shape
+    bm, bn, bk, nw, ns, grp = cfg
+    out = torch.empty((npm * bm, n), dtype=torch.bfloat16, device=w.device)
+    W._gemm_kernel[(npm * (n // bn),)](q, w, out, s, ws, n, k, BM=bm, BN=bn, BK=bk, GROUP=grp, NPM=npm, num_warps=nw, num_stages=ns)
+    return out[:m]
+
+
+def norm_qkv(hidden: torch.Tensor, residual: torch.Tensor, nw: torch.Tensor, eps: float, w: torch.Tensor, ws: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    m, k = hidden.shape
+    _mark("qkv", "E043 fused norm+quant+qkv active")
+    if m > 0 and _big_ok(m, k, hidden, residual) and hidden.dtype == torch.bfloat16 and w.shape[0] % W._cfg(m, k, w.shape[0])[1] == 0:
+        cfg = W._cfg(m, k, w.shape[0])
+        q, s, res, npm = _nq_big(hidden, residual, nw, eps, cfg[0])
+        return _gemm_big(q, s, w, ws, m, npm, cfg), res
+    if m == 0 or not _fused_ok(m, k) or hidden.stride(1) != 1 or residual.stride(1) != 1:
+        r = hidden + residual
+        return W.w8a8_linear(_norm_ref(r, nw, eps), w, ws, 0), r
+    q, s, res = _nq(hidden, residual, nw, eps)
+    return _gemm(q, s, w, ws, m)[:m], res
+
+
+def norm_mlp(attn_out: torch.Tensor, residual: torch.Tensor, nw: torch.Tensor, eps: float, wgu: torch.Tensor, wsgu: torch.Tensor, wdn: torch.Tensor, wsdn: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    m, k = attn_out.shape
+    _mark("mlp", "E043 fused norm+quant+gate_up(silu)+down active")
+    if (m > 0 and _big_ok(m, k, attn_out, residual) and attn_out.dtype == torch.bfloat16 and wgu.shape[0] % 2 == 0
+            and (wgu.shape[0] // 2) % 1024 == 0 and wgu.shape[0] % W._cfg(m, k, wgu.shape[0])[1] == 0):
+        cfg = W._cfg(m, k, wgu.shape[0])
+        q, s, res, npm = _nq_big(attn_out, residual, nw, eps, cfg[0])
+        gu = _gemm_big(q, s, wgu, wsgu, m, npm, cfg)
+        f = wgu.shape[0] // 2
+        act = torch.empty((m, f), dtype=torch.bfloat16, device=attn_out.device)
+        _silu_mul_kernel[(m, f // 1024)](gu, act, F_=f, BLOCK=1024, num_warps=4)
+        return W.w8a8_linear(act, wdn, wsdn, 1), res
+    if m == 0 or not _fused_ok(m, k) or attn_out.stride(1) != 1 or residual.stride(1) != 1:
+        r = attn_out + residual
+        gu = W.w8a8_linear(_norm_ref(r, nw, eps), wgu, wsgu, 0)
+        d = gu.shape[-1] // 2
+        act = torch.nn.functional.silu(gu[..., :d].float()).to(gu.dtype) * gu[..., d:]
+        return W.w8a8_linear(act, wdn, wsdn, 1), r
+    q, s, res = _nq(attn_out, residual, nw, eps)
+    f = wgu.shape[0] // 2
+    if f % 512 == 0:
+        from ._mlp_rotated import gate_up_rot_quant
+        _mark("mlp_rotated", "E072 M64 gate_up H128 epilogue + original H4 quant active")
+        q2, s2 = gate_up_rot_quant(q, s, wgu, wsgu, k, f)
+    else:
+        act = torch.empty((_MAXM, f), dtype=torch.bfloat16, device=attn_out.device)
+        _gemm_silu_kernel[(f // 128,)](q, wgu, act, s, wsgu, k, F_=f, BM=_MAXM, BN=128, BK=64, num_warps=4, num_stages=2)
+        q2, s2 = W.quant_act(act, True, _MAXM)
+    return _gemm(q2, s2, wdn, wsdn, m)[:m], res
+
+
+def _norm_qkv_fake(hidden: torch.Tensor, residual: torch.Tensor, nw: torch.Tensor, eps: float, w: torch.Tensor, ws: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    return hidden.new_empty((hidden.shape[0], w.shape[0])), torch.empty_like(hidden)
+
+
+def _norm_mlp_fake(attn_out: torch.Tensor, residual: torch.Tensor, nw: torch.Tensor, eps: float, wgu: torch.Tensor, wsgu: torch.Tensor, wdn: torch.Tensor, wsdn: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    return torch.empty_like(attn_out), torch.empty_like(attn_out)
+
+
+@triton.jit
+def _rope_rot3_kernel(XQ, XK, XV, YQ, YK, YV, HAD, SIGN, CS, POS, RQ, RK, HQ, HK,
+                      q0, q1, k0, k1, v0, v1, yq0, yq1, yk0, yk1, cs0, inv_sqrt_d,
+                      BR: tl.constexpr, D: tl.constexpr):
+    nq = tl.cdiv(RQ, BR)
+    nk = tl.cdiv(RK, BR)
+    pid = tl.program_id(0)
+    isq = pid < nq
+    isv = pid >= nq + nk
+    base = tl.where(isq, 0, tl.where(isv, nq + nk, nq))
+    R = tl.where(isq, RQ, RK)
+    H = tl.where(isq, HQ, HK)
+    r = (pid - base) * BR + tl.arange(0, BR)
+    rm = r < R
+    t = (r // H).to(tl.int64)
+    hh = r % H
+    d = tl.arange(0, D)
+    px = tl.where(isq, XQ, tl.where(isv, XV, XK))
+    s0 = tl.where(isq, q0, tl.where(isv, v0, k0))
+    s1 = tl.where(isq, q1, tl.where(isv, v1, k1))
+    rowp = px + t[:, None] * s0 + hh[:, None] * s1
+    x = tl.load(rowp + d[None, :], mask=rm[:, None], other=0.0).to(tl.float32)
+    if not isv:
+        rd = (d + D // 2) % D
+        xr = tl.load(rowp + rd[None, :], mask=rm[:, None], other=0.0).to(tl.float32)
+        pos = tl.load(POS + t, mask=rm, other=0).to(tl.int64)
+        cd = d % (D // 2)
+        c = tl.load(CS + pos[:, None] * cs0 + cd[None, :], mask=rm[:, None], other=0.0)
+        s = tl.load(CS + pos[:, None] * cs0 + (D // 2) + cd[None, :], mask=rm[:, None], other=0.0)
+        s = tl.where(rd[None, :] < D // 2, s, -s)
+        x = (x * c + xr * s).to(tl.bfloat16).to(tl.float32)
+    sg = tl.load(SIGN + d)
+    x = x * sg[None, :]
+    had = tl.load(HAD + d[:, None] * D + d[None, :])
+    y = tl.dot(x.to(tl.bfloat16), had) * inv_sqrt_d
+    if isq:
+        tl.store(YQ + t[:, None] * yq0 + hh[:, None] * yq1 + d[None, :], y.to(tl.bfloat16), mask=rm[:, None])
+    else:
+        py = tl.where(isv, YV, YK)
+        tl.store(py + t[:, None] * yk0 + hh[:, None] * yk1 + d[None, :], y, mask=rm[:, None])
+
+
+@triton.jit
+def _e374_shfl_xor(x, lane, mask):
+    return tl.inline_asm_elementwise(
+        "ml_slb_shuffle_rtn_b32 $0, $1, $2;\nsl_wait lmcnt(0);",
+        "=r,r,r",
+        [x, lane ^ mask],
+        dtype=x.dtype,
+        is_pure=True,
+        pack=1,
+    )
+
+
+@triton.jit
+def _e374_fwht128_2(a, b, lane):
+    s = a + b
+    d = a - b
+    a, b = s, d
+    for stride in tl.static_range(6):
+        mask = 1 << (5 - stride)
+        pa = _e374_shfl_xor(a, lane, mask)
+        pb = _e374_shfl_xor(b, lane, mask)
+        bit = (lane & mask) != 0
+        a = tl.where(bit, pa - a, a + pa)
+        b = tl.where(bit, pb - b, b + pb)
+    return a, b
+
+
+@triton.jit
+def _rope_token_bfly_kernel(XQ, XK, XV, YQ, YK, YV, SIGN, CS, POS,
+                            q0, q1, k0, k1, v0, v1, yq0, yq1, yk0, yk1, cs0, inv_sqrt_d, WK, WV, WHEAD, REAL_ROWS, DIRECT: tl.constexpr):
+    t = tl.program_id(0).to(tl.int64)
+    tid = tl.arange(0, 256)
+    wid = tid // 64
+    lane = tid % 64
+    pos = tl.load(POS + t).to(tl.int64)
+    c = tl.load(CS + pos * cs0 + lane)
+    s = tl.load(CS + pos * cs0 + 64 + lane)
+    sg0 = tl.load(SIGN + lane)
+    sg1 = tl.load(SIGN + lane + 64)
+    for q_iter in tl.static_range(4):
+        hh = wid * 4 + q_iter
+        rowp = XQ + t * q0 + hh * q1
+        x0 = tl.load(rowp + lane).to(tl.float32)
+        x1 = tl.load(rowp + lane + 64).to(tl.float32)
+        y0 = (x0 * c - x1 * s).to(tl.bfloat16).to(tl.float32)
+        y1 = (x1 * c + x0 * s).to(tl.bfloat16).to(tl.float32)
+        x0, x1 = _e374_fwht128_2(y0 * sg0, y1 * sg1, lane)
+        outq = YQ + t * yq0 + hh * yq1
+        tl.store(outq + lane, (x0 * inv_sqrt_d).to(tl.bfloat16))
+        tl.store(outq + lane + 64, (x1 * inv_sqrt_d).to(tl.bfloat16))
+    is_v = wid >= 2
+    hk = wid & 1
+    px = tl.where(is_v, XV, XK)
+    s0 = tl.where(is_v, v0, k0)
+    s1 = tl.where(is_v, v1, k1)
+    rowkv = px + t * s0 + hk * s1
+    x0 = tl.load(rowkv + lane).to(tl.float32)
+    x1 = tl.load(rowkv + lane + 64).to(tl.float32)
+    y0 = (x0 * c - x1 * s).to(tl.bfloat16).to(tl.float32)
+    y1 = (x1 * c + x0 * s).to(tl.bfloat16).to(tl.float32)
+    x0 = tl.where(is_v, x0, y0)
+    x1 = tl.where(is_v, x1, y1)
+    x0, x1 = _e374_fwht128_2(x0 * sg0, x1 * sg1, lane)
+    py = tl.where(is_v, YV, YK)
+    outkv = py + t * yk0 + hk * yk1
+    tl.store(outkv + lane, x0 * inv_sqrt_d)
+    tl.store(outkv + lane + 64, x1 * inv_sqrt_d)
+    if DIRECT:
+        ws = tl.where(is_v, WV, WK) + hk * WHEAD + t * 128
+        tl.store(ws + lane, (x0 * inv_sqrt_d).to(tl.bfloat16), mask=t < REAL_ROWS)
+        tl.store(ws + lane + 64, (x1 * inv_sqrt_d).to(tl.bfloat16), mask=t < REAL_ROWS)
+
+
+def rope_rot(qkv: torch.Tensor, positions: torch.Tensor, cs: torch.Tensor, hq: int, hk: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """qkv [n, (hq + 2 hk) * 128] bf16 -> (qr [n, hq*128] bf16 = Had(sign * rope(q)), kr [n, hk*128] fp32, vr [n, hk*128] fp32)."""
+    _mark("rope", "E043 fused rope + q/k/v rotation active")
+    n, d = qkv.shape[0], I4.D
+    q = qkv[:, :hq * d].view(n, hq, d)
+    k = qkv[:, hq * d:(hq + hk) * d].view(n, hk, d)
+    v = qkv[:, (hq + hk) * d:].view(n, hk, d)
+    qr = torch.empty((n, hq, d), dtype=torch.bfloat16, device=qkv.device)
+    kr = torch.empty((n, hk, d), dtype=torch.float32, device=qkv.device)
+    vr = torch.empty_like(kr)
+    if n:
+        if hq == 16 and hk == 2:
+            _mark("rope_bfly", "E374 token-shared butterfly rope_rot active")
+            _, sign = I4._had_pm(qkv.device)
+            from . import attention as A
+            plan = A._current_plan if n > 64 else None
+            real = getattr(plan, "direct_rows", 0)
+            direct = 0 < real <= n and plan.kw.dtype == torch.bfloat16 and plan.kw.device == qkv.device
+            wk, wv, stride = (plan.kw, plan.vw, plan.kw.stride(0)) if direct else (kr, vr, 0)
+            _rope_token_bfly_kernel[(n,)](
+                q, k, v, qr, kr, vr, sign, cs, positions,
+                q.stride(0), q.stride(1), k.stride(0), k.stride(1),
+                v.stride(0), v.stride(1), qr.stride(0), qr.stride(1), kr.stride(0), kr.stride(1),
+                cs.stride(0), I4._INV_SQRT_D, wk, wv, stride, real, DIRECT=direct, num_warps=4, num_stages=1)
+            if direct:
+                plan.fresh_sources = (kr, vr)
+        else:
+            br = 16
+            had, sign = I4._had_pm(qkv.device)
+            rq, rk = n * hq, n * hk
+            g = triton.cdiv(rq, br) + 2 * triton.cdiv(rk, br)
+            _rope_rot3_kernel[(g,)](q, k, v, qr, kr, vr, had, sign, cs, positions, rq, rk, hq, hk, q.stride(0), q.stride(1), k.stride(0), k.stride(1),
+                                    v.stride(0), v.stride(1), qr.stride(0), qr.stride(1), kr.stride(0), kr.stride(1), cs.stride(0), I4._INV_SQRT_D,
+                                    BR=br, D=d, num_warps=8)
+    return qr.view(n, hq * d), kr.view(n, hk * d), vr.view(n, hk * d)
+
+
+def _rope_rot_fake(qkv: torch.Tensor, positions: torch.Tensor, cs: torch.Tensor, hq: int, hk: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    n = qkv.shape[0]
+    return (qkv.new_empty((n, hq * 128), dtype=torch.bfloat16), qkv.new_empty((n, hk * 128), dtype=torch.float32),
+            qkv.new_empty((n, hk * 128), dtype=torch.float32))
+
+
+
+
+
+
