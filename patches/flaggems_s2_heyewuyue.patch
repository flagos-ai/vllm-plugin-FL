+def write(kr, vr, slot_mapping, c8, c16, win, cu, seq, v2=False):
+    n = slot_mapping.shape[0]
+    if n == 0:
+        return
+    tags, rows = layer_state(kr.device, getattr(win, "_crosslayer_index", None))
+    has = cu is not None
+    style=getattr(win,'native_write_style','inline')
+    token=getattr(win,'native_layout','mma')=='token'
+    split_meta=getattr(win,'native_split_meta',False)
+    if split_meta and style!='inline':raise ValueError('E111 split-metadata window requires the inline writer')
+    if getattr(win,'native',False) and style in ('separate','joined'):
+        from ._window_native import hot_writer,joined_writer
+        if style=='joined' and has:
+            joined_writer[(n,HKV_EXP,2)](kr,vr,slot_mapping,cu,seq,rows,cu.shape[0]-1,c16,c8,win.k32,tags,
+                kr.stride(0),kr.stride(1),V2=v2,HAS_WIN=True,TOKEN=token,num_warps=1)
+        else:
+            _write_kernel[(n,HKV_EXP)](kr,vr,slot_mapping,slot_mapping,slot_mapping,rows,0,c16,c8,win.k,win.v,win.ks,win.vs,tags,
+                kr.stride(0),kr.stride(1),PAGE_BYTES//2,PAGE_BYTES,HAS_WIN=False,W=WIN,V2=v2,num_warps=1)
+            if has:
+                hot_writer[(n,HKV_EXP)](kr,vr,slot_mapping,cu,seq,rows,cu.shape[0]-1,win.k32,tags,
+                    kr.stride(0),kr.stride(1),HAS_WIN=True,TOKEN=token,num_warps=1)
+        return
+    _write_kernel[(n, HKV_EXP)](kr, vr, slot_mapping, cu if has else slot_mapping, seq if has else slot_mapping,
+                                rows, (cu.shape[0] - 1) if has else 0, c16, c8, win.k, win.v, win.ks, win.vs, tags,
+                                kr.stride(0), kr.stride(1), PAGE_BYTES // 2, PAGE_BYTES, HAS_WIN=has, W=WIN, V2=v2,
+                                NATIVE_WIN=getattr(win,'native',False),TOKEN_WIN=token,SPLIT_META_WIN=split_meta,num_warps=1)
