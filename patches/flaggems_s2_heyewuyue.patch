+@triton.jit
+def _fused_rope_write_kv_kernel(
+    Q, K, V, COS, SIN, POS,
+    KC, VC, KS, VS, SLOTS,
+    M,
+    sq_m, sq_h, sk_m, sk_h, sv_m, sv_h,
+    sc_p, ss_p,
+    s_cb, s_cs, s_ch, s_sb, s_ss, s_sh,
+    HQ: tl.constexpr, HKV: tl.constexpr, PAGE: tl.constexpr, HALF_D: tl.constexpr,
+):
+    tok = tl.program_id(0)
+    hid = tl.program_id(1)
+    if tok >= M:
+        return
+    pos = tl.load(POS + tok).to(tl.int64)
+    offs = tl.arange(0, HALF_D)
+    c = tl.load(COS + pos * sc_p + offs).to(tl.float32)
+    s = tl.load(SIN + pos * ss_p + offs).to(tl.float32)
+
+    if hid < HQ:
+        base = Q + tok.to(tl.int64) * sq_m + hid * sq_h
+        x1 = tl.load(base + offs).to(tl.float32)
+        x2 = tl.load(base + HALF_D + offs).to(tl.float32)
+        tl.store(base + offs, (x1 * c - x2 * s).to(Q.dtype.element_ty))
+        tl.store(base + HALF_D + offs, (x2 * c + x1 * s).to(Q.dtype.element_ty))
+    else:
+        kh = hid - HQ
+        kb = K + tok.to(tl.int64) * sk_m + kh * sk_h
+        k1 = tl.load(kb + offs).to(tl.float32)
+        k2 = tl.load(kb + HALF_D + offs).to(tl.float32)
+        rk1 = k1 * c - k2 * s
+        rk2 = k2 * c + k1 * s
+        tl.store(kb + offs, rk1.to(K.dtype.element_ty))
+        tl.store(kb + HALF_D + offs, rk2.to(K.dtype.element_ty))
+
+        slot = tl.load(SLOTS + tok).to(tl.int64)
+        if slot >= 0:
+            blk = slot // PAGE
+            spos = slot % PAGE
+            k_amax = tl.maximum(tl.max(tl.abs(rk1), axis=0), tl.max(tl.abs(rk2), axis=0))
+            k_sc = tl.maximum(k_amax * (1.0 / 127.0), 1e-6)
+            k_inv = 1.0 / k_sc
+            q1 = tl.clamp(tl.where(rk1 * k_inv >= 0.0, rk1 * k_inv + 0.5, rk1 * k_inv - 0.5), -128.0, 127.0).to(tl.int8)
+            q2 = tl.clamp(tl.where(rk2 * k_inv >= 0.0, rk2 * k_inv + 0.5, rk2 * k_inv - 0.5), -128.0, 127.0).to(tl.int8)
+            tl.store(KS + blk * s_sb + spos * s_ss + kh * s_sh, k_sc)
+            kc_b = KC + blk * s_cb + spos * s_cs + kh * s_ch
+            tl.store(kc_b + offs, q1)
+            tl.store(kc_b + HALF_D + offs, q2)
+
+            vb = V + tok.to(tl.int64) * sv_m + kh * sv_h
+            v1 = tl.load(vb + offs).to(tl.float32)
+            v2 = tl.load(vb + HALF_D + offs).to(tl.float32)
+            v_amax = tl.maximum(tl.max(tl.abs(v1), axis=0), tl.max(tl.abs(v2), axis=0))
+            v_sc = tl.maximum(v_amax * (1.0 / 127.0), 1e-6)
+            v_inv = 1.0 / v_sc
+            vq1 = tl.clamp(tl.where(v1 * v_inv >= 0.0, v1 * v_inv + 0.5, v1 * v_inv - 0.5), -128.0, 127.0).to(tl.int8)
+            vq2 = tl.clamp(tl.where(v2 * v_inv >= 0.0, v2 * v_inv + 0.5, v2 * v_inv - 0.5), -128.0, 127.0).to(tl.int8)
+            tl.store(VS + blk * s_sb + spos * s_ss + kh * s_sh, v_sc)
+            vc_b = VC + blk * s_cb + spos * s_cs + kh * s_ch
+            tl.store(vc_b + offs, vq1)
+            tl.store(vc_b + HALF_D + offs, vq2)
+
+
+def fused_rope_write_kv(q, k, v, cos, sin, pos, views, slot_mapping):
+    M, HQ, _ = q.shape
+    HKV = k.shape[1]
+    if M == 0:
+        return
+    pos1 = pos.reshape(-1)
+    cos2 = cos.reshape(-1, 64)
+    sin2 = sin.reshape(-1, 64)
+    kc, vc, ks, vs = views.kc, views.vc, views.ksc, views.vsc
+    _fused_rope_write_kv_kernel[(M, HQ + HKV)](
+        q, k, v, cos2, sin2, pos1,
+        kc, vc, ks, vs, slot_mapping, M,
+        q.stride(0), q.stride(1), k.stride(0), k.stride(1), v.stride(0), v.stride(1),
+        cos2.stride(0), sin2.stride(0),
+        kc.stride(0), kc.stride(1), kc.stride(2),
+        ks.stride(0), ks.stride(1), ks.stride(2),
+        HQ=HQ, HKV=HKV, PAGE=16, HALF_D=64, num_warps=1,
+    )
+
+
+@torch.library.custom_op("fl_e473::rope_defer", mutates_args=("query", "key"))
+def _op_rope_defer(
