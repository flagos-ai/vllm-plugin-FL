+def run_prefill4(qr, kr, vr, c8, c16, outr, cu, seq, table, scale, plan, max_q, v2=False, layer=None, save_lse=False):
+    from . import attention as A
+    tail_only = layer == 41 and plan.last_logit_only
+    if tail_only:
+        outr.zero_()
+        A._once("e414_final_attention", "E414 last-layer prefill attention tail active")
+    kw, vw = plan.kw, plan.vw
+    if not getattr(plan, "cleared_partial_pages", False):
+        _clear_partial_page[(plan.n_p, HKV_EXP)](kw, vw, seq, plan.pidx, plan.wso, kw.stride(0), D=D, num_warps=4)
+        plan.cleared_partial_pages = True
+        A._once("e458_padding", "E458 partial workspace pages initialized")
+    run_ws4(c16, c8, table, seq, plan, kw, vw, v2)
+    sources = getattr(plan, "fresh_sources", None)
+    if (sources is not None and sources[0].data_ptr() == kr.data_ptr()
+            and sources[1].data_ptr() == vr.data_ptr()):
+        A._once("e458_direct", "E458 direct fresh BF16 KV consumed")
+    else:
+        _ws_fresh_kernel[(plan.n_p, triton.cdiv(max_q, 16))](kr, vr, cu, seq, plan.pidx, plan.wso, kw, vw,
+                                                             kr.stride(0), kr.stride(1), kw.stride(0), HKV=HKV_EXP, D=D, num_warps=4)
+    plan.fresh_sources = None
+    pidx, cb, wso, n_p, total = plan.pidx, plan.cb, plan.wso, plan.n_p, plan.total_blocks
+    if (plan.pair_shapes or plan.causal_shapes) and layer is not None:
+        from .pair_prefill import dense_subset, launch
+        mask = launch(qr, outr, plan, layer, scale * _LOG2E, tail_only=tail_only, save_lse=save_lse)
+        if mask:
+            subset = dense_subset(plan, mask)
+            if subset is None:
+                return
+            pidx, cb, wso, n_p, total = subset
+    hq = qr.shape[1]
+    A._prefill_kernel[(n_p if tail_only else total, HKV_EXP)](
+        qr, outr, cu, seq, pidx, cb, wso, kw, vw, scale * _LOG2E,
+        qr.stride(0), qr.stride(1), outr.stride(0), outr.stride(1), kw.stride(0), n_p, total,
+        QPK=hq // HKV_EXP, BLOCK_Q=A._PF_BLOCK_Q, T=plan.prefill_t, D=D,
+        TAIL_ONLY=tail_only, num_warps=A._PF_WARPS, num_stages=1)
+    A._once(f'e380_t{plan.prefill_t}', f'E380 prefill T={plan.prefill_t} active')
