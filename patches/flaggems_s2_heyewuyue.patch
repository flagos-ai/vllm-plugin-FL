+    pair=(n%F)//128
+    unit=(n//F)*8+(n%128)//16
+    within=n%16+(k%4)*64+(((k//4)-(k//16))%4)*256+((k//16)%4)*16
+    return (pair*(K//64)+k//64)*16384+unit*1024+within
+
+@triton.jit(do_not_specialize=["M"])
+def gemm(A,B,C,SA,SB,M,N:tl.constexpr,K:tl.constexpr,
+         BM:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,GROUP:tl.constexpr,PACKED:tl.constexpr=True, STRIPED:tl.constexpr=False):
+    pm,pn=W._swizzle(M,N,BM,BN,GROUP)
+    rm=pm*BM+tl.arange(0,BM);rn=pn*BN+tl.arange(0,BN);rk=tl.arange(0,BK)
+    a=A+rm[:,None]*K+rk[None,:]
+    if STRIPED:
+        code_row=(rn%(N//2)//16)*32+(rn//(N//2))*16+rn%16
+        b=B+code_row[None,:]*K+rk[:,None]
+    elif PACKED:b=B+address(rn[None,:],rk[:,None],K,N//2)
+    else:b=B+rn[None,:]*K+rk[:,None]
+    acc=tl.zeros((BM,BN),tl.int32)
+    for start in range(K//BK):
+        acc+=tl.dot(tl.load(a),tl.load(b),out_dtype=tl.int32)
+        a+=BK
+        if PACKED:b+=(BK//64)*16384
+        else:b+=BK
+    paired=(rn%(N//2)//128)*256+(rn//(N//2))*128+rn%128
+    if STRIPED: paired=code_row
+    x=acc.to(tl.float32)*tl.load(SA+rm)[:,None]*tl.load(SB+paired)[None,:]
+    tl.store(C+rm[:,None]*N+rn[None,:],x.to(tl.bfloat16))
+
+@triton.jit
+def unpack_check(B,C,N:tl.constexpr,K:tl.constexpr,BLOCK:tl.constexpr):
+    i=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK);n=i//K;k=i%K
+    tl.store(C+i,tl.load(B+address(n,k,K,N//2),mask=i<N*K,other=0),mask=i<N*K)
+
+
+_PREFILL_IMAGES = {}
+_STRIPED = set()
+
+
+def stripe_prefill(weight):
+    key = weight.data_ptr()
+    codes, paired = _PREFILL_IMAGES[key]
+    n, k = codes.shape
+    assert n == 12288 and k == 2048 and paired.numel() == n
+    logical = paired.reshape(-1,2,128).transpose(0,1).reshape(-1)
+    codes = codes.reshape(2,-1,16,k).transpose(0,1).contiguous().reshape(n,k)
+    scales = logical.reshape(2,-1,16).transpose(0,1).contiguous().reshape(n)
+    _PREFILL_IMAGES[key] = (codes, scales)
+    _STRIPED.add(key)
+
+
+def bind_prefill_image(packed, expanded, row_scale=None):
+    # Expanded weights for older callers share the packed scale. A separately
+    # quantized resident image owns its paired row scales as well as its codes.
+    _STRIPED.discard(packed.data_ptr())
+    _PREFILL_IMAGES[packed.data_ptr()] = (expanded, row_scale)
+
+
+def run(q,scale,weight,weight_scale,m,unpack=False):
+    n,k=weight_scale.numel(),weight.shape[1]
+    bm,bn,bk,nw,ns,group=W._cfg(m,k,n)
+    mp=triton.cdiv(m,bm)*bm
+    assert q.shape[0]>=mp
+    resident = _PREFILL_IMAGES.get(weight.data_ptr())
+    if resident is not None:
+        unpack = True
+        image, resident_scale = resident
+        if resident_scale is not None:
+            weight_scale = resident_scale
+    elif weight.dtype == torch.uint8:
+        from ._gu_m32_w4 import expand
+        unpack = True
+        image = expand(weight,n,k)
+    elif unpack:
+        decoded=torch.empty_like(weight)
+        if unpack=='tile':unpack_tiled[(n//256,k//64)](weight,decoded,N=n,K=k,num_warps=4,num_stages=1)
+        else:unpack_check[(triton.cdiv(n*k,1024),)](weight,decoded,N=n,K=k,BLOCK=1024,num_warps=4)
+        image=decoded
+    else:image=weight
+    out=torch.empty((mp,n),device=q.device,dtype=torch.bfloat16)
+    ker=gemm[(triton.cdiv(m,bm)*(n//bn),)](q,image,out,scale,weight_scale,M=mp,N=n,K=k,BM=bm,BN=bn,BK=bk,GROUP=group,PACKED=not unpack,STRIPED=weight.data_ptr() in _STRIPED,num_warps=nw,num_stages=ns)
+    return out[:m],ker
+
+
+@triton.jit
+def unpack_tiled(B,C,N:tl.constexpr,K:tl.constexpr):
+    # Read a whole256x64 packed slab coalesced, transpose through16KiB LDS,
+    # then write64 contiguous K-bytes/row. It is a temporary prefill buffer.
+    pn=tl.program_id(0);kc=tl.program_id(1);i=tl.arange(0,16384)
+    unit=i//1024;p=i%1024
+    n=unit*16+p%16;word=(p//16)%4
+    k=word*16+((p//256+word)%4)*4+(p//64)%4
+    buf=tleg.alloc((16384,),tl.uint8,scope=tleg.smem,nv_mma_shared_layout=False)
+    ptr=tleg.local_ptr(buf,(0,))
+    swizzled=n*64+(k^((n%8)*4))
+    tl.store(ptr+swizzled,tl.load(B+(pn*(K//64)+kc)*16384+i))
+    tl.debug_barrier()
+    rn=i//64;rk=i%64
+    value=tl.load(ptr+rn*64+(rk^((rn%8)*4)))
+    logical_n=pn*128+rn%128+(rn//128)*(N//2)
+    tl.store(C+logical_n*K+kc*64+rk,value.to(tl.int8))
+
+
+def linear(x:torch.Tensor,weight:torch.Tensor,scale:torch.Tensor)->torch.Tensor:
+    """Correct standalone linear fallback for the single packed GU image."""
+    m,k=x.shape
+    if m==0:return torch.empty((0,scale.numel()),device=x.device,dtype=x.dtype)
+    bm=W._cfg(m,k,scale.numel())[0];mp=triton.cdiv(m,bm)*bm
+    q,s=W.quant_act(x,False,mp)
+    return run(q,s,weight,scale,m,unpack='tile')[0]
+
+
+def linear_fake(x:torch.Tensor,weight:torch.Tensor,scale:torch.Tensor)->torch.Tensor:
+    return torch.empty((x.shape[0],scale.numel()),device=x.device,dtype=x.dtype)
diff --git a/src/flag_gems/fused/minicpm/_refresh_split.py b/src/flag_gems/fused/minicpm/_refresh_split.py
new file mode 100644
index 0000000..bcbcb40
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_refresh_split.py
@@ -0,0 +1,189 @@
+"""E092: row-parallel anchor refresh for few refreshing rows, and threshold page selection.
+
+1. full_collect_split: same frozen inline-asm dense collector as full_collect_refresh.
+   It counts refreshing rows R on device. If R <= THRESH every refreshing row gets SR
+   programs writing scratch partials (merged afterwards); otherwise it behaves exactly
+   like the original S-split launch into the original buffers.
+2. merge_refresh: folds the SR scratch partials into slot 0 and empties slots 1..S-1
+   (only when R <= THRESH), so window/reduce/prepare_norm read the usual layout.
+3. select_commit (production, after the parallel normalize): top-k by binary threshold
+   search over order-preserving int32 keys instead of a full 2048 argsort. Selected set
+   equals the original top-k up to ties; pages are written in ascending page order (the
+   consumer map_cached reads the whole kept list, order only changes accumulation order),
+   so page 0 comes first and the final cold page npg-1 lands at position k-1 as before.
+   norm_select (fused rank+select in one program per row) is kept as a measured
+   alternative: its serial rank loop is slower at 16k.
+Changes are summation/accumulation order only; budgets, epochs and pages kept are unchanged.
+"""
+import os
+import triton
+import triton.language as tl
+from flag_gems.fused.minicpm.int4_kv import _wstart, _lo32, _hi32, _DEC14_CONS
+from flag_gems.fused.minicpm.int4_kv_v2 import _DEC15_CONS
+from flag_gems.fused.minicpm._epoch_collect import ASM2, ASM4, CONS, FALLBACK2, FALLBACK4
+
+_CAP = tl.constexpr(2048)
+_THROUGHPUT_PROFILE = os.environ.get('FLAGOS_CARD_A_PROFILE', 'balanced').strip().lower() == 'throughput'
+_DEC_MIN_K = tl.constexpr(2 if _THROUGHPUT_PROFILE else 64)
+_DEC_MAX_K = tl.constexpr(2048 if _THROUGHPUT_PROFILE else 96)
+_SLOTS = tl.constexpr(64)
+
+
+@triton.jit
+def _refresh_count(REFRESH, N):
+    r = tl.arange(0, 256)
+    return tl.sum(tl.load(REFRESH + r, mask=r < N, other=0), 0)
+
+
+@triton.jit(do_not_specialize=['S', 'N'])
+def full_collect_split(Q, PG, TABLE, SEQ_LENS, CU_Q, ROWSLOT, TAGS, PO, PM, PL, RPO, RPM, RPL, MASS, REFRESH,
+                       qk_scale, s_q0, s_q1, s_tab, S, N, SR: tl.constexpr, THRESH: tl.constexpr,
+                       W: tl.constexpr, NP: tl.constexpr, V2: tl.constexpr):
+    seq = tl.program_id(1); sp = tl.program_id(2); qrow = tl.load(CU_Q + seq)
+    if tl.load(REFRESH + seq) == 0: return
+    if tl.load(CU_Q + seq + 1) - qrow != 1: return
+    small = _refresh_count(REFRESH, N) <= THRESH
+    splits = tl.where(small, SR, S)
+    if sp >= splits: return
+    L4, _ = _wstart(TAGS, ROWSLOT, seq, tl.load(SEQ_LENS + seq), W)
+    npg = tl.cdiv(L4, 16); per = tl.cdiv(npg, splits); lo = sp * per
+    hi = tl.maximum(tl.minimum(lo + per, npg), lo)
+    lane = tl.arange(0, 64); z = lane * 0; col = lane & 15
+    pbase = tl.where(small, (seq * (SR + 1) + sp) * 16, (seq * (S + 1) + sp) * 16)
+    pg = (PG + z).to(tl.int64, bitcast=True)
+    tab = (TABLE + seq.to(tl.int64) * s_tab + z).to(tl.int64, bitcast=True)
+    po = tl.where(small, (RPO + pbase * 128 + z).to(tl.int64, bitcast=True), (PO + pbase * 128 + z).to(tl.int64, bitcast=True))
+    pm = tl.where(small, (RPM + pbase + z).to(tl.int64, bitcast=True), (PM + pbase + z).to(tl.int64, bitcast=True))
+    pl = tl.where(small, (RPL + pbase + z).to(tl.int64, bitcast=True), (PL + pbase + z).to(tl.int64, bitcast=True))
+    qp = (Q + qrow.to(tl.int64) * s_q0 + z).to(tl.int64, bitcast=True)
+    mass = (MASS + seq.to(tl.int64) * NP * 128 + z).to(tl.int64, bitcast=True)
+    qk = (z.to(tl.float32) + qk_scale * 16777216.).to(tl.int32, bitcast=True)
+    rem = z + (L4 - (npg - 1) * 16)
+    if npg > NP or npg < 128:
+        if V2:
+            x0, x1 = tl.inline_asm_elementwise(FALLBACK2, _DEC15_CONS,
+                [_lo32(pg), _hi32(pg), _lo32(tab), _hi32(tab), z + lo, z + hi, rem, z + npg,
+                 _lo32(po), _hi32(po), _lo32(pm), _hi32(pm), _lo32(pl), _hi32(pl), qk, lane,
+                 _lo32(qp), _hi32(qp), col * s_q1 * 2], dtype=(tl.int32, tl.int32), is_pure=False, pack=1)
+        else:
+            x0, x1 = tl.inline_asm_elementwise(FALLBACK4, _DEC14_CONS,
+                [_lo32(pg), _hi32(pg), _lo32(tab), _hi32(tab), z + lo, z + hi, rem, z + npg,
+                 _lo32(po), _hi32(po), _lo32(pm), _hi32(pm), _lo32(pl), _hi32(pl), qk, lane,
+                 _lo32(qp), _hi32(qp), col * s_q1 * 2], dtype=(tl.int32, tl.int32), is_pure=False, pack=1)
+    elif V2:
+        x0, x1 = tl.inline_asm_elementwise(ASM2, CONS,
+            [_lo32(pg), _hi32(pg), _lo32(tab), _hi32(tab), z + lo, z + hi, rem, z + npg,
+             _lo32(po), _hi32(po), _lo32(pm), _hi32(pm), _lo32(pl), _hi32(pl), qk, lane,
+             _lo32(qp), _hi32(qp), col * s_q1 * 2, _lo32(mass), _hi32(mass)],
+            dtype=(tl.int32, tl.int32), is_pure=False, pack=1)
+    else:
+        x0, x1 = tl.inline_asm_elementwise(ASM4, CONS,
+            [_lo32(pg), _hi32(pg), _lo32(tab), _hi32(tab), z + lo, z + hi, rem, z + npg,
+             _lo32(po), _hi32(po), _lo32(pm), _hi32(pm), _lo32(pl), _hi32(pl), qk, lane,
+             _lo32(qp), _hi32(qp), col * s_q1 * 2, _lo32(mass), _hi32(mass)],
+            dtype=(tl.int32, tl.int32), is_pure=False, pack=1)
+
+
+@triton.jit(do_not_specialize=['S', 'N'])
+def merge_refresh(RPO, RPM, RPL, PO, PM, PL, REFRESH, CU, TAGS, ROWS, SEQ, S, N,
+                  SR: tl.constexpr, THRESH: tl.constexpr, W: tl.constexpr):
+    row = tl.program_id(0)
+    if tl.load(REFRESH + row) == 0: return
+    qrow = tl.load(CU + row)
+    if tl.load(CU + row + 1) - qrow != 1: return
+    if _refresh_count(REFRESH, N) > THRESH: return
+    L4, _ = _wstart(TAGS, ROWS, row, tl.load(SEQ + row), W)
+    npg = tl.cdiv(L4, 16); per = tl.cdiv(npg, SR)
+    s = tl.arange(0, SR); h = tl.program_id(1) * 4 + tl.arange(0, 4); d = tl.arange(0, 128)
+    valid = (s * per) < npg
+    rb = row * (SR + 1)
+    m = tl.load(RPM + (rb + s[:, None]) * 16 + h[None, :], mask=valid[:, None], other=float('-inf'))
+    l = tl.load(RPL + (rb + s[:, None]) * 16 + h[None, :], mask=valid[:, None], other=0.)
+    m = tl.where(valid[:, None], m, float('-inf')); l = tl.where(valid[:, None], l, 0.)
+    mx = tl.max(m, 0); mx = tl.where(mx > float('-inf'), mx, 0.)
+    lsum = tl.sum(tl.exp2(m - mx[None, :]) * l, 0)
+    acc = tl.zeros((4, 128), tl.float32)
+    for i in range(SR):
+        ok = i * per < npg
+        wi = tl.where(ok, tl.exp2(tl.load(RPM + (rb + i) * 16 + h) - mx), 0.)
+        po = tl.load(RPO + ((rb + i) * 16 + h)[:, None] * 128 + d[None, :])
+        acc += tl.where(ok, po, 0.) * wi[:, None]
+    base = row * (S + 1)
+    tl.store(PM + base * 16 + h, mx); tl.store(PL + base * 16 + h, lsum)
+    tl.store(PO + (base * 16 + h)[:, None] * 128 + d[None, :], acc)
+    for sp in range(1, S):
+        tl.store(PM + (base + sp) * 16 + h, tl.full((4,), float('-inf'), tl.float32))
+        tl.store(PL + (base + sp) * 16 + h, tl.zeros((4,), tl.float32))
+        tl.store(PO + ((base + sp) * 16 + h)[:, None] * 128 + d[None, :], tl.zeros((4, 128), tl.float32))
+
+
+@triton.jit
+def _topk_commit(SCORES, ROWS, SEQ, IDS, EPOCH, NPG, KEEP, STATS, row, npg, BANK: tl.constexpr, DENOM: tl.constexpr, ARY: tl.constexpr, prompt=0):
+    """Top-k of SCORES[row] by threshold search over the int32 key space (binary: 33 passes, ARY=16: 8 passes)."""
+    i = tl.arange(0, _CAP)
+    score = tl.load(SCORES + row * _CAP + i)
+    k = tl.minimum(npg, tl.minimum(_DEC_MAX_K, tl.maximum(_DEC_MIN_K, tl.cdiv(npg, DENOM))))
+    bits = score.to(tl.int32, bitcast=True)
+    key = bits ^ ((bits >> 31) & 0x7fffffff)                         # order-preserving float -> int32
+    lo = tl.full((), -2147483648, tl.int64)
+    if ARY == 16:
+        j = tl.arange(0, 16).to(tl.int64); step = tl.full((), 268435456, tl.int64)   # 2^32 / 16
+        for _ in tl.static_range(8):                               # invariant: count(key >= lo) >= k
+            t = (lo + j * step).to(tl.int32)
+            c = tl.sum((key[None, :] >= t[:, None]).to(tl.int32), 1)
+            lo = lo + (tl.sum((c >= k).to(tl.int64), 0) - 1) * step
+            step = step // 16
+    else:
+        hi = tl.full((), 2147483647, tl.int64)
+        for _ in tl.static_range(33):                              # largest T with count(key >= T) >= k
+            mid = lo + (hi - lo + 1) // 2
+            c = tl.sum((key >= mid.to(tl.int32)).to(tl.int32), 0)
+            lo = tl.where(c >= k, mid, lo); hi = tl.where(c >= k, hi, mid - 1)
+    t0 = lo.to(tl.int32); gt = key > t0; eq = key == t0
+    need = k - tl.sum(gt.to(tl.int32), 0)
+    sel = gt | (eq & (tl.cumsum(eq.to(tl.int32), 0) <= need))
+    pos = tl.cumsum(sel.to(tl.int32), 0) - 1
+    slot = tl.load(ROWS + row); p = BANK * _SLOTS + slot
+    if DENOM == 1:
+        tl.store(IDS + p.to(tl.int64) * _CAP + i, i, i < k)
+    else:
+        tl.store(IDS + p.to(tl.int64) * _CAP + pos, i, sel)
+    tl.store(EPOCH + p, tl.load(SEQ + row) // 16); tl.store(NPG + p, npg); tl.store(KEEP + p, k)
+    tl.atomic_add(STATS + BANK * 5, 1)
+
+
+@triton.jit
+def select_commit(SCORES, REFRESH, ROWS, SEQ, COLD, IDS, EPOCH, NPG, KEEP, STATS, BANK: tl.constexpr, DENOM: tl.constexpr, ARY: tl.constexpr, PROMPT=None):
+    """Drop-in for sort_commit after the parallel normalize: same kept set, ascending page order."""
+    row = tl.program_id(0)
+    if tl.load(REFRESH + row) == 0: return
+    prompt = 0
+    if PROMPT is not None:
+        prompt = tl.load(PROMPT + row)
+    _topk_commit(SCORES, ROWS, SEQ, IDS, EPOCH, NPG, KEEP, STATS, row,
+                 tl.load(COLD + row), BANK, DENOM, ARY, prompt)
+
+
+@triton.jit
+def norm_select(MASS, COLD, NORM, SCORES, REFRESH, ROWS, SEQ, IDS, EPOCH, NPG, KEEP, STATS,
+                BANK: tl.constexpr, DENOM: tl.constexpr, PB: tl.constexpr, ARY: tl.constexpr):
+    row = tl.program_id(0)
+    if tl.load(REFRESH + row) == 0: return
+    npg = tl.load(COLD + row)
+    h = tl.arange(0, 16); g = tl.arange(0, 4)
+    mx = tl.load(NORM + row * 32 + h); inv = tl.load(NORM + row * 32 + 16 + h)
+    # Same per-page rank formula as _epoch_normalize.normalize.
+    for b in range(0, _CAP // PB):
+        page = b * PB + tl.arange(0, PB)
+        rank = tl.full((PB,), float('-inf'), tl.float32)
+        if (npg > 0) & (b * PB < npg):
+            offset = ((row * _CAP + page[:, None, None]) * 64 + g[None, :, None] * 16 + h[None, None, :]) * 2
+            p = tl.load(MASS + offset, page[:, None, None] < npg, 0.)
+            pm = tl.load(MASS + ((row * _CAP + page[:, None]) * 64 + h[None, :]) * 2 + 1, page[:, None] < npg, 0.)
+            mass = tl.sum(p, 1) * tl.exp2(pm - mx[None, :]) * inv[None, :]
+            rank = tl.max(mass, 1)
+            rank = tl.where(page < npg, rank, float('-inf'))
+            rank = tl.where((page == 0) | (page == npg - 1), float('inf'), rank)
+        tl.store(SCORES + row * _CAP + page, rank)
+    tl.debug_barrier()
+    _topk_commit(SCORES, ROWS, SEQ, IDS, EPOCH, NPG, KEEP, STATS, row, npg, BANK, DENOM, ARY)
diff --git a/src/flag_gems/fused/minicpm/_residual_w4.py b/src/flag_gems/fused/minicpm/_residual_w4.py
new file mode 100644
index 0000000..a4a6f4d
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_residual_w4.py
@@ -0,0 +1,233 @@
+"""Derive the MiniCPM5-2B residual basis and packed GU from the local checkpoint."""
+import json
+import math
+import time
+from pathlib import Path
+
+import os
+import torch
+
+from . import _group_a8_mlp, _h128_basis, _native_pair_mlp, _packed_pair_reader, w8a8
+from .fused_layers import logger
+
+_CHECKPOINT_CONFIG = {
+    "model_type": "llama",
+    "num_hidden_layers": 42,
+    "hidden_size": 2048,
+    "intermediate_size": 6144,
+    "vocab_size": 130560,
+    "num_attention_heads": 16,
+    "num_key_value_heads": 2,
+    "tie_word_embeddings": False,
+}
+
+_PROJECTIONS = (
+    ("gu", "mlp", "gate_up_proj", ("mlp.gate_proj.weight", "mlp.up_proj.weight"),
+     "post_attention_layernorm"),
+    ("down", "mlp", "down_proj", ("mlp.down_proj.weight",), None),
+    ("qkv", "self_attn", "qkv_proj", ("self_attn.q_proj.weight", "self_attn.k_proj.weight",
+                                    "self_attn.v_proj.weight"), "input_layernorm"),
+    ("o", "self_attn", "o_proj", ("self_attn.o_proj.weight",), None),
+)
+
+
+class _Checkpoint:
+    def __init__(self, root, index, device):
+        from safetensors import safe_open
+
+        self.root = root
+        self.index = index
+        self.device = device
+        self.safe_open = safe_open
+
+    def open(self, key):
+        return self.safe_open(self.root / self.index[key], framework="pt", device="cpu")
+
+    def tensor(self, key):
+        with self.open(key) as shard:
+            return shard.get_tensor(key).to(self.device)
+
+
+class _ResidualBasis:
+    def __init__(self, device):
+        hadamard = torch.ones((1, 1), dtype=torch.float32, device=device)
+        for _ in range(11):
+            upper = torch.cat((hadamard, hadamard), dim=1)
+            lower = torch.cat((hadamard, -hadamard), dim=1)
+            hadamard = torch.cat((upper, lower), dim=0)
+        self.matrix = hadamard * (1 / math.sqrt(2048))
