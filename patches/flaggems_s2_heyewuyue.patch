+        _top_p_mask_kernel[(num_rows,)](
+            logits,
+            p,
+            logits.stride(0),
+            vocab_size,
+            BLOCK=block,
+            PASSES=16,
+            LOG2_BLOCK=block.bit_length() - 1,
+            num_warps=num_warps,
+            num_stages=num_stages,
+        )
+    return logits
