+"""M64 gate_up partial H128 epilogue and original H4/row quantization.
+
+E071 compared production M64 q/scales bitwise across four varied weight copies.
+No weight precision, nonlinear rounding or framework selection change.
+"""
+import torch
+import triton
+import triton.language as tl
+from . import w8a8 as W
+
+@triton.jit
+def _gemm_silu_h_kernel(A, B, Y, SA, SB, H, K, F_: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    pn = tl.program_id(0)
+    rm = tl.arange(0, BM)
+    rn = pn * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    a = A + rm[:, None] * K + rk[None, :]
+    bg = B + rn[None, :] * K + rk[:, None]
+    bu = bg + F_ * K
+    ag = tl.zeros([BM, BN], dtype=tl.int32)
+    au = tl.zeros([BM, BN], dtype=tl.int32)
+    for _ in tl.range(0, K, BK):
+        at = tl.load(a)
+        ag += tl.dot(at, tl.load(bg), out_dtype=tl.int32)
+        au += tl.dot(at, tl.load(bu), out_dtype=tl.int32)
+        a += BK
+        bg += BK
+        bu += BK
+    sa = tl.load(SA + rm)
+    g = (ag.to(tl.float32) * sa[:, None] * tl.load(SB + rn)[None, :]).to(tl.bfloat16).to(tl.float32)
+    u = (au.to(tl.float32) * sa[:, None] * tl.load(SB + F_ + rn)[None, :]).to(tl.bfloat16).to(tl.float32)
+    act = ((g * tl.sigmoid(g)) * u).to(tl.bfloat16)
+    c = tl.arange(0, BN)
+    h = tl.load(H + c[:, None] * BN + c[None, :])
+    y = tl.dot(act, h)
+    tl.store(Y + rm[:, None] * F_ + rn[None, :], y)
+
+
+@triton.jit
+def _quant_h4_kernel(Y, Q, S, F_: tl.constexpr, NB: tl.constexpr, NBP: tl.constexpr, R: tl.constexpr):
+    row = tl.program_id(0)
+    j = tl.arange(0, NBP)
+    c = tl.arange(0, 128)
+    jm = (j < NB)[:, None]
+    p = Y + row * F_ + j[:, None] * 512 + c[None, :]
+    y0 = tl.load(p, mask=jm, other=0.0)
+    y1 = tl.load(p + 128, mask=jm, other=0.0)
+    y2 = tl.load(p + 256, mask=jm, other=0.0)
+    y3 = tl.load(p + 384, mask=jm, other=0.0)
+    o0 = ((y0 + y1 + y2 + y3) * R).to(tl.bfloat16).to(tl.float32)
+    o1 = ((y0 - y1 + y2 - y3) * R).to(tl.bfloat16).to(tl.float32)
+    o2 = ((y0 + y1 - y2 - y3) * R).to(tl.bfloat16).to(tl.float32)
+    o3 = ((y0 - y1 - y2 + y3) * R).to(tl.bfloat16).to(tl.float32)
+    a = tl.maximum(tl.maximum(tl.abs(o0), tl.abs(o1)), tl.maximum(tl.abs(o2), tl.abs(o3)))
+    s = tl.maximum(tl.max(tl.max(a, 1), 0), 1e-8) / 127.0
+    qp = Q + row * F_ + j[:, None] * 512 + c[None, :]
+    tl.store(qp, tl.minimum(tl.maximum(tl.floor(o0 / s + 0.5), -127.0), 127.0).to(tl.int8), mask=jm)
+    tl.store(qp + 128, tl.minimum(tl.maximum(tl.floor(o1 / s + 0.5), -127.0), 127.0).to(tl.int8), mask=jm)
+    tl.store(qp + 256, tl.minimum(tl.maximum(tl.floor(o2 / s + 0.5), -127.0), 127.0).to(tl.int8), mask=jm)
+    tl.store(qp + 384, tl.minimum(tl.maximum(tl.floor(o3 / s + 0.5), -127.0), 127.0).to(tl.int8), mask=jm)
+    tl.store(S + row, s)
+
+
+
+def gate_up_rot_quant(q, scale, weight, weight_scale, k, f):
+    m=q.shape[0]
+    y=torch.empty((m,f),device=q.device,dtype=torch.float32)
+    q2=torch.empty((m,f),device=q.device,dtype=torch.int8)
+    s2=torch.empty((m,),device=q.device,dtype=torch.float32)
+    _gemm_silu_h_kernel[(f//128,)](q,weight,y,scale,weight_scale,W._h128(q.device),k,F_=f,BM=m,BN=128,BK=64,num_warps=4,num_stages=2)
+    nb=f//512
+    _quant_h4_kernel[(m,)](y,q2,s2,F_=f,NB=nb,NBP=triton.next_power_of_2(nb),R=512**-0.5,num_warps=8)
+    return q2,s2
