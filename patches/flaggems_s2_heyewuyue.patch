+        e("ml_add_i32 v%d, v%d, 0x%x" % (T0, LG, 4 * i))
+        e("ml_cmp_gt_i32 tcr, s22, v%d" % T0)
+        e("ml_csel_b32 v%d, v%d, v%d, tcr" % (36 + i, 36 + i, NINF))
+        e("ml_csel_b32 v%d, v%d, v%d, tcr" % (40 + i, 40 + i, Z4))
+    e(".Lk14_nt:")
+    e("ml_max_f32 v%d, v36, v37" % T0)
+    e("ml_max_f32 v%d, v%d, v38" % (T0, T0))
+    e("ml_max_f32 v%d, v%d, v39" % (T0, T0))
+    e("ml_cmp_gt_f32 tcr, v%d, v%d" % (T0, TH))
+    e("sl_cbr_tcrnz .Lk14_slow, tcr")
+    e(".Lk14_back:")
+    for i in range(4):
+        s, v = 36 + i, 40 + i
+        e("ml_sub_f32 v%d, v%d, v%d" % (s, s, MM))
+        e("ml_exp_f32 v%d, v%d" % (s, s))
+        e("ml_add_f32 v%d, v%d, v%d" % (LL, LL, s))
+        e("ml_mul_f32 v%d, v%d, v%d" % (v, v, s))
+        e("ml_mul_f32 v%d, v%d, 0x42800000" % (v, v))
+        e("ml_cvt_f16_f32 v%d, v%d" % (v, v))
+    e("ml_byte_permute_b32 v%d, v41, v40, s3" % PF)
+    e("ml_byte_permute_b32 v%d, v43, v42, s3" % (PF + 1))
+    mad(R, ON, PF, R)                                # offset of the V codes: R = 8 sum P
+    e("sl_mov_b64 tcr, s[44:45]")
+    e("ml_csel_b32 v%d, v%d, v%d, tcr" % (PA, PF, Z4))
+    e("ml_csel_b32 v%d, v%d, v%d, tcr" % (PA + 1, PF + 1, Z4))
+    e("ml_csel_b32 v%d, v%d, v%d, tcr" % (PB, Z4, PF))
+    e("ml_csel_b32 v%d, v%d, v%d, tcr" % (PB + 1, Z4, PF + 1))
+    for h in range(2):
+        for g in range(2):
+            planes(VR + 4 * h + 2 * g, lambda p: mad(A(g, p), AT, PA if h == 0 else PB, A(g, p)))
+    e("sl_add_i32 s20, s20, 0x1")
+    e("sl_cmp_lt_i32 wcr, s20, s21")
+    e("sl_cbr_wcrnz .Lk14_loop")
+    e("sl_jump .Lk14_done")
+    e(".Lk14_slow:")                                 # exact max over the 4 lanes of a column, rescale everything accumulated
+    e("ml_slb_shuffle_rtn_b32 v%d, v%d, v%d" % (T1, T0, X1))
+    e("sl_wait lmcnt(0)")
+    e("ml_max_f32 v%d, v%d, v%d" % (T0, T0, T1))
+    e("ml_slb_shuffle_rtn_b32 v%d, v%d, v%d" % (T1, T0, X2))
+    e("sl_wait lmcnt(0)")
+    e("ml_max_f32 v%d, v%d, v%d" % (T0, T0, T1))
+    e("ml_max_f32 v%d, v%d, v%d" % (T1, MM, T0))
+    e("ml_sub_f32 v%d, v%d, v%d" % (T2, MM, T1))
+    e("ml_exp_f32 v%d, v%d" % (T2, T2))
+    e("ml_mov_b32 v%d, v%d" % (MM, T1))
+    e("ml_mov_b32 v%d, 0x%x" % (T3, struct.unpack("<I", struct.pack("<f", slack))[0]))
+    e("ml_add_f32 v%d, v%d, v%d" % (TH, MM, T3))
+    for i in list(range(36)) + [LL]:
+        e("ml_mul_f32 v%d, v%d, v%d" % (i, i, T2))
+    e("sl_jump .Lk14_back")
+    e(".Lk14_done:")
+    e("ml_slb_shuffle_rtn_b32 v%d, v%d, v%d" % (T1, LL, X1))
+    e("sl_wait lmcnt(0)")
+    e("ml_add_f32 v%d, v%d, v%d" % (LL, LL, T1))
+    e("ml_slb_shuffle_rtn_b32 v%d, v%d, v%d" % (T1, LL, X2))
+    e("sl_wait lmcnt(0)")
+    e("ml_add_f32 v%d, v%d, v%d" % (LL, LL, T1))
+    e("ml_and_b32 v%d, v%d, 0xf" % (T0, LANE))       # PO[col][4 c + p + 64 g], c = i << 2 | lg
+    e("ml_shl_b32 v%d, v%d, 0x9" % (POFF, T0))
+    e("ml_shl_b32 v%d, v%d, 0x4" % (T1, LG))
+    e("ml_add_i32 v%d, v%d, v%d" % (POFF, POFF, T1))
+    e("ml_shl_b32 v%d, v%d, 0x2" % (PMF, T0))
+    e("sl_mov_b64 s[40:41], s[24:25]")
+    e("ml_mov_b32 v%d, 0x48800000" % T3)             # 2^18: the nibble unit 2^-24 times the 64 carried by P
+    for g in range(2):
+        for p in range(4):
+            for i in range(4):
+                e("ml_sub_f32 v%d, v%d, v%d" % (T1, A(g, p) + i, R + i))
+                e("ml_mul_f32 v%d, v%d, v%d" % (T1, T1, T3))
+                e("ml_lsa_store_dword v%d, s[40:43], unsigned v%d, noreg, #%d, wb" % (T1, POFF, 256 * g + 64 * i + 4 * p))
