+"""Swizzled CTA-level split-KV merge and inverse transform for Iluvatar BI-V150.
+
+One32KiB buffer first holds m/l, then all4 split numerators. The read image
+assigns4heads/warp and8dimensions/lane. Register-dependent XOR removes the
+head-strided LDS bank conflict. No global split partials or Triton reductions.
+"""
+import triton
+import triton.language as tl
+import triton.experimental.tle.language.gpu as tleg
+from .int4_kv import _lo32,_hi32,_wstart
+from ._window_native import _register_asm
+
+
+def _post():
+    L=[];e=L.append
+    # Inputs: s24 scratch(byte address), s26:27 BF16out, s28:29 SIGN.
+    # s52 is hotlo=2*split; v0..31 native numerator, v104/105 l/m.
+    e('sl_srl_b32 s52, s52, 0x1');e('sl_shl_b32 s53, s52, 0x8')
+    e('ml_shl_b32 v109, v135, 0x2');e('ml_add_i32 v109, s53, v109');e('ml_add_i32 v109, s24, v109')
+    e('ml_slb_store_b32x1 v105, v109, noreg, #0, null')
+    e('ml_add_i32 v110, v109, 0x400');e('ml_slb_store_b32x1 v104, v110, noreg, #0, null')
+    e('sl_wait lmcnt(0)');e('sl_barrier')
+    e('ml_and_b32 v109, v135, 0xf');e('ml_shl_b32 v109, v109, 0x2');e('ml_add_i32 v109, s24, v109')
+    for i in range(4):
+        e(f'ml_add_i32 v110, v109, 0x{256*i:x}');e(f'ml_slb_load_b32x1 v{56+i}, v110, noreg, #0, null')
+        e(f'ml_add_i32 v110, v109, 0x{1024+256*i:x}');e(f'ml_slb_load_b32x1 v{60+i}, v110, noreg, #0, null')
+    e('sl_wait lmcnt(0)')
+    e('ml_max_f32 v96, v56, v57');e('ml_max_f32 v96, v96, v58');e('ml_max_f32 v96, v96, v59')
+    e('ml_cmp_gt_f32 tcr, v96, v137');e('ml_csel_b32 v96, v96, v52, tcr')
+    for i in range(4):e(f'ml_sub_f32 v{56+i}, v{56+i}, v96');e(f'ml_exp_f32 v{56+i}, v{56+i}')
+    e('ml_mul_f32 v97, v56, v60')
+    for i in range(1,4):e(f'ml_fma_f32 v97, v{56+i}, v{60+i}, v97')
+    e('ml_mov_b32 v100, 0x3f800000');e('ml_cmp_gt_f32 tcr, v97, v52');e('ml_csel_b32 v97, v97, v100, tcr')
+    e('ml_xor_b32 v99, v97, 0x80000000');e('ml_rcp_f32 v97, v97')
+    e('ml_fma_f32 v99, v99, v97, v100');e('ml_fma_f32 v97, v99, v97, v97')
+    e('ml_sub_f32 v98, v105, v96');e('ml_exp_f32 v98, v98')
+    for r in range(32):e(f'ml_mul_f32 v{r}, v{r}, v98')
+    # All metadata reads finish before its storage is reused for partials.
+    e('sl_barrier')
+    for p in range(4):
+        e(f'ml_xor_b32 v{109+p}, v135, 0x{4*p:x}')
+        e(f'ml_shl_b32 v{109+p}, v{109+p}, 0x2')
+        e(f'ml_add_i32 v{109+p}, s53, v{109+p}');e(f'ml_add_i32 v{109+p}, s24, v{109+p}')
+    for r in range(32):
+        e(f'ml_add_i32 v113, v{109+(r//4)%4}, 0x{r*1024:x}');e(f'ml_slb_store_b32x1 v{r}, v113, noreg, #0, null')
+    e('sl_wait lmcnt(0)');e('sl_barrier')
+    # Swizzled native image -> one warp owns4heads x128dimensions.
+    e('sl_shl_b32 s53, s52, 0x2');e('ml_srl_b32 v136, v135, 0x4');e('ml_add_i32 v136, s53, v136')
+    e('ml_and_b32 v98, v135, 0x3');e('ml_shl_b32 v99, v98, 0x2')
+    e('ml_and_b32 v109, v135, 0xf');e('ml_srl_b32 v109, v109, 0x2');e('ml_shl_b32 v109, v109, 0x4')
+    e('ml_add_i32 v109, v109, v136');e('ml_xor_b32 v109, v109, v99');e('ml_shl_b32 v109, v109, 0x2')
+    e('ml_shl_b32 v98, v98, 0xc');e('ml_add_i32 v109, v109, v98');e('ml_add_i32 v109, s24, v109')
+    for r in range(8):
+        for sp in range(4):
+            off=(16*(r//4)+r%4)*1024+sp*256
+            e(f'ml_add_i32 v110, v109, 0x{off:x}');e(f'ml_slb_load_b32x1 v{4*r+sp}, v110, noreg, #0, null')
+    e('sl_wait lmcnt(0)')
+    # Redistribute the per-head reciprocal to the new warp ownership.
+    e('ml_slb_shuffle_rtn_b32 v97, v97, v136');e('sl_wait lmcnt(0)')
+    for r in range(8):
+        e(f'ml_add_f32 v98, v{4*r}, v{4*r+1}');e(f'ml_add_f32 v99, v{4*r+2}, v{4*r+3}')
+        e(f'ml_add_f32 v{64+r}, v98, v99');e(f'ml_mul_f32 v{64+r}, v{64+r}, v97')
+    # H128: low4 dimensions are lane-local, high3 are register-local.
+    for bit in range(4):
+        e(f'ml_xor_b32 v98, v135, 0x{1<<bit:x}')
+        for r in range(8):e(f'ml_slb_shuffle_rtn_b32 v{72+r}, v{64+r}, v98')
+        e('sl_wait lmcnt(0)');e(f'ml_shl_b32 v99, v135, 0x{31-bit:x}');e('ml_and_b32 v99, v99, 0x80000000')
+        for r in range(8):e(f'ml_xor_b32 v{64+r}, v{64+r}, v99');e(f'ml_add_f32 v{64+r}, v{64+r}, v{72+r}')
+    for bit in(1,2,4):
+        for r in range(8):
+            if r&bit:continue
+            p=r^bit;e(f'ml_add_f32 v98, v{64+r}, v{64+p}');e(f'ml_sub_f32 v{64+p}, v{64+r}, v{64+p}');e(f'ml_mov_b32 v{64+r}, v98')
+    e('sl_mov_b64 s[36:37], s[28:29]');e('sl_mov_b32 s38, 0x40000000');e('sl_mov_b32 s39, 0xffffffff')
+    e('ml_and_b32 v109, v135, 0xf');e('ml_shl_b32 v109, v109, 0x2')
+    for r in range(8):e(f'ml_lsa_load_dword v{80+r}, s[36:39], unsigned v109, noreg, #{r*64}, ca')
+    e('sl_wait vmcnt(0)')
+    e('sl_mov_b64 s[40:41], s[26:27]');e('sl_mov_b32 s42, 0x40000000');e('sl_mov_b32 s43, 0xffffffff')
+    e('ml_shl_b32 v110, v136, 0x8');e('ml_and_b32 v109, v135, 0xf');e('ml_shl_b32 v109, v109, 0x1');e('ml_add_i32 v110, v110, v109')
+    for r in range(8):
+        e(f'ml_mul_f32 v{64+r}, v{64+r}, 0x3db504f3')
+        e(f'ml_mul_f32 v{64+r}, v{64+r}, v{80+r}');e(f'ml_cvt_bf16_f32 v{64+r}, v{64+r}')
+        e(f'ml_lsa_store_short v{64+r}, s[40:43], unsigned v110, noreg, #{r*32}, wb')
+    e('sl_wait vmcnt(0)')
+    return ';\n'.join(L)+';\n'
+
+
+def _micro_asm():
+    L=[];e=L.append
+    for i,s in enumerate((24,25,26,27,28,29,40,41,16,17,20,21)):e(f'ml_mov_v2s_b32 s{s}, ${i+2}, 0x0')
+    e('ml_mov_b32 v135, $14');e('ml_mov_v2s_b32 s52, $15, 0x0')
+    for first in(16,20,40):e(f'sl_mov_b32 s{first+2}, 0x40000000');e(f'sl_mov_b32 s{first+3}, 0xffffffff')
+    e('ml_mov_b32 v52, 0x0');e('ml_mov_b32 v137, 0xff800000')
+    e('ml_and_b32 v138, v135, 0xf');e('ml_shl_b32 v138, v138, 0x9')
+    e('ml_srl_b32 v139, v135, 0x4');e('ml_shl_b32 v139, v139, 0x4');e('ml_add_i32 v138, v138, v139')
+    for g in range(2):
+        for p in range(4):
+            for i in range(4):e(f'ml_lsa_load_dword v{16*g+4*p+i}, s[40:43], unsigned v138, noreg, #{256*g+64*i+4*p}, ca')
+    e('ml_and_b32 v139, v135, 0xf');e('ml_shl_b32 v139, v139, 0x2')
+    e('ml_lsa_load_dword v105, s[16:19], unsigned v139, noreg, #0, ca')
+    e('ml_lsa_load_dword v104, s[20:23], unsigned v139, noreg, #0, ca');e('sl_wait vmcnt(0)')
+    return ';\n'.join(L)+';\n'+_post()
+
+
+MICRO_ASM=tl.constexpr(_micro_asm())
+MICRO_CONS=tl.constexpr('={v143},={s57},'+','.join(['r']*14)+',~{memory}')
+FUSED_ASM=tl.constexpr(_register_asm(tagged=True,token=True,split_meta=True,shift_inputs=False)+_post())
+FUSED2_ASM=tl.constexpr(_register_asm(True,tagged=True,token=True,split_meta=True,shift_inputs=False)+_post())
+SKIP_ASM=tl.constexpr(_register_asm(tagged=True,token=True,split_meta=True,shift_inputs=False,skip_empty=True)+_post())
+SKIP2_ASM=tl.constexpr(_register_asm(True,tagged=True,token=True,split_meta=True,shift_inputs=False,skip_empty=True)+_post())
+FUSED_CONS=tl.constexpr('={v143},={s57},'+','.join(['r']*29)+',~{memory}')
+
+
+@triton.jit
+def merge_parts(PO,PM,PL,SIGN,OUT,CODE:tl.constexpr):
+    row=tl.program_id(0);tid=tl.arange(0,256);sp=tid//64;lane=tid%64;z=tid*0
+    buf=tleg.alloc((8192,),tl.float32,scope=tleg.smem,nv_mma_shared_layout=False)
+    ptr=tleg.local_ptr(buf,(0,));tl.store(ptr,0.);tl.debug_barrier()
+    scratch=(ptr.to(tl.uint64)+z)
+    op=(OUT+row*16*128+z).to(tl.uint64);sg=(SIGN+z).to(tl.uint64)
+    po=(PO+(row*4+sp)*16*128+z).to(tl.uint64)
+    pm=(PM+(row*4+sp)*16+z).to(tl.uint64);pl=(PL+(row*4+sp)*16+z).to(tl.uint64)
+    a,b=tl.inline_asm_elementwise(CODE,MICRO_CONS,
+        [_lo32(scratch),_hi32(scratch),_lo32(op),_hi32(op),_lo32(sg),_hi32(sg),
+         _lo32(po),_hi32(po),_lo32(pm),_hi32(pm),_lo32(pl),_hi32(pl),lane,sp*2],
+        dtype=(tl.int32,tl.int32),is_pure=False,pack=1)
+
+
+@triton.jit
+def recipient(Q,PG,ORIGINAL,TAB,COUNTS,WPG,WMETA,SEQ,CU,ROWS,TAGS,OUT,SIGN,
+              qk_scale,s_q0,s_q1,s_original,s_tab,V2:tl.constexpr=False,SKIP_EMPTY:tl.constexpr=False):
+    row=tl.program_id(0);qrow=tl.load(CU+row)
+    if tl.load(CU+row+1)-qrow!=1:return
+    length=tl.load(SEQ+row);cold,slot=_wstart(TAGS,ROWS,row,length,128)
+    original_npg=tl.cdiv(cold,16);count=tl.load(COUNTS+row);active=count>=0
+    npg=tl.where(active,count,original_npg)
+    tid=tl.arange(0,256);sp=tid//64;lane=tid%64;z=tid*0
+    per=tl.cdiv(npg,4);lo=sp*per;hi=tl.maximum(lo,tl.minimum(lo+per,npg))
+    buf=tleg.alloc((8192,),tl.float32,scope=tleg.smem,nv_mma_shared_layout=False)
+    ptr=tleg.local_ptr(buf,(0,));tl.store(ptr,0.);tl.debug_barrier()
+    slot=tl.maximum(slot,0)
+    pg=(PG+z).to(tl.uint64)
+    tab=tl.where(active,(TAB+row*s_tab+z).to(tl.uint64),(ORIGINAL+row*s_original+z).to(tl.uint64))
+    wp=(WPG+slot*8*2048+z).to(tl.uint64);meta=(WMETA+slot*8*64+z).to(tl.uint64)
+    tag=(TAGS+slot*128+z).to(tl.uint64);qp=(Q+qrow*s_q0+z).to(tl.uint64)
+    scratch=ptr.to(tl.uint64)+z;op=(OUT+row*16*128+z).to(tl.uint64);sg=(SIGN+z).to(tl.uint64)
+    qk=(z.to(tl.float32)+qk_scale*16777216.).to(tl.int32,bitcast=True)
+    if SKIP_EMPTY:code:tl.constexpr=SKIP2_ASM if V2 else SKIP_ASM
+    else:code:tl.constexpr=FUSED2_ASM if V2 else FUSED_ASM
+    a,b=tl.inline_asm_elementwise(code,FUSED_CONS,
+        [_lo32(pg),_hi32(pg),_lo32(tab),_hi32(tab),z+lo,z+hi,z+cold-(original_npg-1)*16,z+npg,
+         _lo32(scratch),_hi32(scratch),_lo32(op),_hi32(op),_lo32(sg),_hi32(sg),qk,lane,
+         _lo32(qp),_hi32(qp),(lane&15)*s_q1*2,_lo32(wp),_hi32(wp),_lo32(meta),_hi32(meta),z+sp*2,z+(sp+1)*2,
+         _lo32(tag),_hi32(tag),z+cold,z+length],dtype=(tl.int32,tl.int32),is_pure=False,pack=1)
diff --git a/src/flag_gems/fused/minicpm/_deferred_kv_writer.py b/src/flag_gems/fused/minicpm/_deferred_kv_writer.py
new file mode 100644
index 0000000..91e34dc
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/_deferred_kv_writer.py
@@ -0,0 +1,127 @@
+"""Write native int8 window entries inline and flush encoded KV pages at the decode tail."""
+import triton
+import triton.language as tl
+import torch
+from . import int4_kv as I
+from .int4_kv import _write_kernel
+
+BATCH = 64
+LAYERS = 42
+_STATES = {}
+
+
+@triton.jit
+def _stage(KR, VR, SLOTMAP, CU, SEQ, ROWS, C8, C16, WPG, META, TAGS,
+           STAGED_K, STAGED_V, READY, ADDRESSES, LAYER: tl.constexpr, V2: tl.constexpr):
+    token = tl.program_id(0)
+    head = tl.program_id(1)
+    if (token == 0) & (head == 0):
+        tl.store(ADDRESSES + LAYER * 2, C8.to(tl.uint64))
+        tl.store(ADDRESSES + LAYER * 2 + 1, SLOTMAP.to(tl.uint64))
+    sl = tl.load(SLOTMAP + token)
+    if sl < 0:
+        if head == 0:
+            tl.store(READY + LAYER * 64 + token, 0)
+        return
+    row = token
+    if (tl.load(CU + row) != token) | (tl.load(CU + row + 1) != token + 1):
+        lo, hi = 0, 64
+        while lo < hi:
+            mid = (lo + hi) // 2
+            before = tl.load(CU + mid) <= token
+            lo = tl.where(before, mid + 1, lo)
+            hi = tl.where(before, hi, mid)
+        row = lo - 1
+    slot = tl.load(ROWS + row)
+    position = tl.load(SEQ + row) - 1
+    if head == 0:
+        tl.store(READY + LAYER * 64 + token, (slot >= 0).to(tl.int32))
+    if slot < 0:
+        _write_kernel(KR, VR, SLOTMAP, CU, SEQ, ROWS, 0, C16, C8,
+                      WPG, WPG, META, META, TAGS, 256, 128, 2112, 4224,
+                      HAS_WIN=False, W=128, V2=V2)
+    else:
+        words = tl.arange(0, 32)
+        planes = tl.arange(0, 4)
+        dim = words[:, None] * 4 + planes[None, :]
+        offset = token.to(tl.int64) * 256 + head * 128 + dim
+        k = tl.load(KR + offset)
+        v = tl.load(VR + offset)
+        staging_offset = LAYER * 64 * 256 + offset
+        tl.store(STAGED_K + staging_offset, k)
+        tl.store(STAGED_V + staging_offset, v)
+        ks = tl.maximum(tl.max(tl.max(tl.abs(k), 1)) / 127.0, 1e-8)
+        vs = tl.maximum(tl.max(tl.max(tl.abs(v), 1)) / 127.0, 1e-8)
+        kq = tl.floor(k / ks + 0.5)
+        vq = tl.floor(v / vs + 0.5)
+        ku = (tl.minimum(tl.maximum(kq, -127.0), 127.0).to(tl.int32) & 255) ^ 128
+        vu = (tl.minimum(tl.maximum(vq, -127.0), 127.0).to(tl.int32) & 255) ^ 128
+        kw = tl.sum(ku << (8 * planes[None, :]), axis=1)
+        vw = tl.sum(vu << (8 * planes[None, :]), axis=1)
+        page = slot * 8 + (position % 128) // 16
+        in_page = position % 16
+        payload = WPG + page * 2048 + in_page * 64 + head * 32 + words
+        tl.store(payload, kw)
+        tl.store(payload + 1024, vw)
+        scales = META + page * 64 + head * 16 + in_page
+        tl.store(scales, ks)
+        tl.store(scales + 32, vs)
+        if head == 0:
+            tl.store(TAGS + slot * 128 + position % 128, position)
+
+@triton.jit
+def _flush(KR, VR, READY, ADDRESSES, ROLE_LAYERS, COUNTER, V2: tl.constexpr):
+    token = tl.program_id(0)
+    group = tl.program_id(2)
+    layer = tl.load(ROLE_LAYERS + group)
+    if not V2:
+        if (token == 0) & (tl.program_id(1) == 0) & (group == 0):
+            tl.store(COUNTER, tl.load(COUNTER) + 1)
+    if tl.load(READY + layer * 64 + token) == 0:
+        return
+    c8 = tl.load(ADDRESSES + layer * 2).to(tl.pointer_type(tl.uint8))
+    mapping = tl.load(ADDRESSES + layer * 2 + 1).to(tl.pointer_type(tl.int64))
+    k = KR + layer * 64 * 256
+    v = VR + layer * 64 * 256
+    _write_kernel(k, v, mapping, ROLE_LAYERS, ROLE_LAYERS, ROLE_LAYERS, 0,
+                  c8.to(tl.pointer_type(tl.int16)), c8, c8, c8, k, v, ROLE_LAYERS,
+                  256, 128, 2112, 4224, HAS_WIN=False, W=128, V2=V2)
+
+
+class State:
+    def __init__(self, device):
+        shape = (LAYERS, BATCH, 2, 128)
+        self.k = torch.empty(shape, device=device, dtype=torch.float32)
+        self.v = torch.empty_like(self.k)
+        self.ready = torch.empty((LAYERS, BATCH), device=device, dtype=torch.int32)
+        self.addresses = torch.empty((LAYERS, 2), device=device, dtype=torch.int64)
+        self.counter = torch.zeros((), device=device, dtype=torch.int32)
+        self.roles = tuple(torch.tensor(
+            [i for i in range(LAYERS) if (i in I._V2_SET) == role],
+            device=device, dtype=torch.int32,
+        ) for role in (False, True))
+        self.marked = set()
+        self.pending_layers = []
+
+    def write(self, layer, k, v, mapping, c8, c16, win, cu, seq, v2):
+        self.pending_layers.append(layer)
+        tags, rows = I.layer_state(k.device, layer)
+        _stage[(BATCH, 2)](k, v, mapping, cu, seq, rows, c8, c16, win.k32, win.ks, tags,
+                          self.k, self.v, self.ready, self.addresses, LAYER=layer, V2=v2, num_warps=1)
+        if layer not in self.marked and torch.cuda.is_current_stream_capturing():
+            self.marked.add(layer)
+            I.logger.warning("E136 deferred writer capture layer=%d", layer)
+
+    def flush(self):
+        assert self.pending_layers == list(range(LAYERS)), self.pending_layers
+        self.pending_layers.clear()
+        for v2, layers in zip((False, True), self.roles):
+            _flush[(BATCH, 2, layers.numel())](self.k, self.v, self.ready, self.addresses, layers,
+                                               self.counter, V2=v2, num_warps=1)
+
+
+def state(device):
+    key = torch.device(device)
+    if key not in _STATES:
+        _STATES[key] = State(device)
+    return _STATES[key]
diff --git a/src/flag_gems/fused/minicpm/_epoch_collect.py b/src/flag_gems/fused/minicpm/_epoch_collect.py
