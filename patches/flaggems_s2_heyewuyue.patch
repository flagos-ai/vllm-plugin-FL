+def _register_asm(v2=False,tagged=False,token=False,split_meta=False,shift_inputs=True,skip_empty=False):
+    import re
+    text=_tagged_asm(v2,token=token,split_meta=split_meta,skip_empty=skip_empty)if tagged else _fused_asm(v2,token=token)
+    # Finalized numerator stays in v0..31; no global or shared partial stores.
+    for g in range(2):
+        for p in range(4):
+            for i in range(4):
+                r=4*(4*g+p)+i
+                old=(f'ml_sub_f32 v110, v{r}, v{32+i};\n'
+                     'ml_mul_f32 v110, v110, v112;\n'
+                     f'ml_lsa_store_dword v110, s[40:43], unsigned v138, noreg, #{256*g+64*i+4*p}, wb;')
+                assert text.count(old)==1
+                text=text.replace(old,f'ml_sub_f32 v{r}, v{r}, v{32+i};\nml_mul_f32 v{r}, v{r}, v112;')
+    for r in (105,104):
+        text=text.replace(f'ml_lsa_store_dword v{r}, s[40:43], unsigned v139, noreg, #0, wb;','')
+    if not shift_inputs:return text
+    shift=200 if tagged else 192
+    return re.sub(r'\$(\d+)',lambda m:'$'+str(int(m.group(1))+shift if int(m.group(1))>=2 else int(m.group(1))),text)
+
