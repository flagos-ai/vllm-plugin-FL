+def _cta_asm(v2=False):
+    import re
+    text=_fused_asm(v2)
+    old='sl_mov_b64 s[40:41], s[24:25];'
+    assert text.count(old)==1
+    text=text.replace(old,old+'\nml_add_i32 v138, s24, v138;')
+    # Only O goes through LDS. Return m/l directly in the known lane image,
+    # keeping the entire CTA scratch exactly32KiB instead of >32KiB.
+    pattern=r'ml_lsa_store_dword v110, s\[40:43\], unsigned v138, noreg, #(\d+), wb'
+    text,n=re.subn(pattern,lambda m:'ml_slb_store_b32x1 v110, v138, noreg, #'+m.group(1)+', null',text)
+    assert n==32,n
+    for reg in (105,104):
+        line=f'ml_lsa_store_dword v{reg}, s[40:43], unsigned v139, noreg, #0, wb;'
+        assert text.count(line)==1
+        text=text.replace(line,'')
+    # This asm is followed by Triton work. Declare EVERY fixed register it
+    # overwrites so the compiler cannot keep later pointers in clobbered regs.
+    text=re.sub(r'\$(\d+)',lambda m:'$'+str(int(m.group(1))+192 if int(m.group(1))>=2 else int(m.group(1))),text)
+    return text+'\nsl_wait lmcnt(0);\n'
