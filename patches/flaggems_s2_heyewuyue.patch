+@triton.jit
+def _quarter_merge(values_out,ptr,sp,lane,read_offset,weights,denom,QUARTER:tl.constexpr,INVERSE:tl.constexpr=True):
+    tl.store(ptr+sp*512+0+lane,values_out[16*(QUARTER//2)+2*(QUARTER%2)+0])
+    tl.store(ptr+sp*512+64+lane,values_out[16*(QUARTER//2)+2*(QUARTER%2)+1])
+    tl.store(ptr+sp*512+128+lane,values_out[16*(QUARTER//2)+2*(QUARTER%2)+4])
+    tl.store(ptr+sp*512+192+lane,values_out[16*(QUARTER//2)+2*(QUARTER%2)+5])
+    tl.store(ptr+sp*512+256+lane,values_out[16*(QUARTER//2)+2*(QUARTER%2)+8])
+    tl.store(ptr+sp*512+320+lane,values_out[16*(QUARTER//2)+2*(QUARTER%2)+9])
+    tl.store(ptr+sp*512+384+lane,values_out[16*(QUARTER//2)+2*(QUARTER%2)+12])
+    tl.store(ptr+sp*512+448+lane,values_out[16*(QUARTER//2)+2*(QUARTER%2)+13])
+    tl.debug_barrier()
+    vals=tl.load(ptr+read_offset)
+    x=tl.sum(vals*weights[:,:,None],axis=0)/denom[:,None]
+    tl.debug_barrier()
+    if INVERSE:
+        ds=tl.arange(0,32)
+        for bit in tl.static_range(5):
+            index=tl.broadcast_to((ds^(1<<bit))[None,:],(16,32))
+            partner=tl.gather(x,index,axis=1)
+            x=tl.where((ds[None,:]&(1<<bit))==0,x+partner,partner-x)
+    return x
