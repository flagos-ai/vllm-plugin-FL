+class Window:
+    """Per-layer int8 side buffer of the newest WIN tokens of SLOTS requests (rotated K / V, one fp32 scale per token-head)."""
+
+    def __init__(self, device, native=False,split_meta=False):
+        self.native=native
+        self.native_split_meta=native and split_meta
+        if native:
+            self.pool=torch.zeros((SLOTS*8*(8192 if split_meta else 8448),),dtype=torch.uint8,device=device)
+            self.k=self.pool.view(torch.int8);self.v=self.k
+            self.k32=self.pool.view(torch.int32);self.v32=self.k32
+            self.ks=torch.zeros((SLOTS*8*64,),dtype=torch.float32,device=device)if split_meta else self.pool.view(torch.float32)
+            self.vs=self.ks
+            self.payload_bytes=self.pool.numel()+(self.ks.numel()*4 if split_meta else 0)
+        else:
+            self.k = torch.zeros((SLOTS * WIN * HKV_EXP * D,), dtype=torch.int8, device=device)
+            self.v = torch.zeros_like(self.k)
+            self.k32, self.v32 = self.k.view(torch.int32), self.v.view(torch.int32)
+            self.ks = torch.zeros((SLOTS * WIN * HKV_EXP,), dtype=torch.float32, device=device)
+            self.vs = torch.zeros_like(self.ks)
+            self.payload_bytes=self.k.numel()+self.v.numel()+4*(self.ks.numel()+self.vs.numel())
