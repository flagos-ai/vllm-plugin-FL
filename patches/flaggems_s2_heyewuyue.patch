+    e("ml_lsa_store_dword v%d, s[40:43], unsigned v%d, noreg, #0, wb" % (MM, PMF))
+    e("sl_mov_b64 s[40:41], s[28:29]")
+    e("ml_lsa_store_dword v%d, s[40:43], unsigned v%d, noreg, #0, wb" % (LL, PMF))
+    return ";\n".join(L) + ";\n"
+
+
+_DEC14_ASM = tl.constexpr(_dec14_asm())
+_DEC14_CONS = tl.constexpr("={v120},={s47}," + ",".join(["r"] * 19))
+
+
+@triton.jit
+def _hi32(x):
+    return (x >> 32).to(tl.int32)
+
+
+@triton.jit
+def _lo32(x):
+    return (x & 0xffffffff).to(tl.int32)
+
+
+@triton.jit(do_not_specialize=["S"])
+def _dec14_kernel(Q, PG, TABLE, SEQ_LENS, CU_Q, ROWSLOT, TAGS, PO, PM, PL, qk_scale, s_q0, s_q1, s_tab, S, W: tl.constexpr):
+    """One decode row, split S: Triton sets up pointers and the window start, the page loop is one inline asm block (see above)."""
+    seq = tl.program_id(1)
+    sp = tl.program_id(2)
+    qrow = tl.load(CU_Q + seq)
+    if tl.load(CU_Q + seq + 1) - qrow != 1:
+        return
+    L4, _ = _wstart(TAGS, ROWSLOT, seq, tl.load(SEQ_LENS + seq), W)
+    npg = tl.cdiv(L4, 16)
+    per = tl.cdiv(npg, S)
+    lo = sp * per
+    hi = tl.maximum(tl.minimum(lo + per, npg), lo)
+    lane = tl.arange(0, 64)
+    z = lane * 0
+    col = lane & 15
+    pbase = (seq * (S + 1) + sp) * 16
+    pg = (PG + z).to(tl.int64, bitcast=True)
+    tab = (TABLE + seq.to(tl.int64) * s_tab + z).to(tl.int64, bitcast=True)
+    po = (PO + pbase * 128 + z).to(tl.int64, bitcast=True)
+    pm = (PM + pbase + z).to(tl.int64, bitcast=True)
+    pl = (PL + pbase + z).to(tl.int64, bitcast=True)
+    qp = (Q + qrow.to(tl.int64) * s_q0 + z).to(tl.int64, bitcast=True)
+    qk = (z.to(tl.float32) + qk_scale * 16777216.0).to(tl.int32, bitcast=True)
+    rem = z + (L4 - (npg - 1) * 16)
+    x0, x1 = tl.inline_asm_elementwise(_DEC14_ASM, _DEC14_CONS, [_lo32(pg), _hi32(pg), _lo32(tab), _hi32(tab), z + lo, z + hi, rem, z + npg,
+                                                                _lo32(po), _hi32(po), _lo32(pm), _hi32(pm), _lo32(pl), _hi32(pl), qk, lane,
+                                                                _lo32(qp), _hi32(qp), col * s_q1 * 2],
+                                       dtype=(tl.int32, tl.int32), is_pure=False, pack=1)
+
