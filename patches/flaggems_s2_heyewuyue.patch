+import torch
+import triton
+import triton.language as tl
+from .w8a8 import _swizzle, quant_act
+
+@triton.jit
+def _gemm_kernel(A, B, C, SA, SB, N, K, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+                 GROUP: tl.constexpr, NPM, UNROLL: tl.constexpr = 1):
+    """C[Mp, N] = (A[Mp, K] int8 . B[N, K]^T int8) * SA[Mp] * SB[N] -> bf16 over padded rows (Mp = NPM * BM).
+    No masks anywhere: a masked load in the K loop ran this kernel 5x slower (E018 attempt 1 vs E012)."""
+    pm, pn = _swizzle(NPM * BM, N, BM, BN, GROUP)
+    rm = pm * BM + tl.arange(0, BM)
+    rn = pn * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    a = A + rm[:, None] * K + rk[None, :]
+    b = B + rn[None, :] * K + rk[:, None]
+    acc = tl.zeros([BM, BN], dtype=tl.int32)
+    for _ in tl.range(0, K, BK, loop_unroll_factor=UNROLL):
+        acc += tl.dot(tl.load(a), tl.load(b), out_dtype=tl.int32)
+        a += BK
+        b += BK
+    sa = tl.load(SA + rm)
+    sb = tl.load(SB + rn)
+    out = acc.to(tl.float32) * sa[:, None] * sb[None, :]
+    tl.store(C + rm[:, None] * N + rn[None, :], out.to(tl.bfloat16).to(tl.float32))
+
+
+def project(x, weight, weight_scale):
+    m, k = x.shape
+    n = weight.shape[0]
+    bm = 16 if m <= 16 else 64
+    q, scale = quant_act(x.contiguous(), False, bm)
+    out = torch.empty((bm, n), dtype=torch.float32, device=x.device)
+    _gemm_kernel[(n // 256,)](q, weight, out, scale, weight_scale, n, k, BM=bm,
+        BN=256, BK=64, GROUP=8, NPM=1, UNROLL=1, num_warps=4, num_stages=1)
+    return out[:m]
diff --git a/src/flag_gems/fused/minicpm/int4_kv.py b/src/flag_gems/fused/minicpm/int4_kv.py
new file mode 100644
index 0000000..a21270c
--- /dev/null
+++ b/src/flag_gems/fused/minicpm/int4_kv.py
@@ -0,0 +1,1481 @@
+"""
+K4V2 compressed KV cache for Iluvatar BI-V150.
+
+Page layout (16 tokens, 2 KV heads, 4224 B = 132 B per token-head):
+  Page bytes are the MMA operand registers of the decode loop (E040 v14, `_hw_k`, `_hw_v`):
+  [0, 2048)    K codes, halfword 512 h + 256 g + 128 r + 2 l + x for token t, halfword e = 16 g + c of head h:
+               r = t >> 3, l = c + 16 ((t >> 1) & 3), x = t & 1. Nibble p of halfword e = rotated dim 4e + p (unsigned, zero point
+               per 64-dim group)
+  [2048, 4096) V codes, same nibbles, offset-binary (code - 8), halfword 1024 + 512 h + 256 g + 128 r + 2 l + x with r = c >> 3,
+               x = c & 1, l = k + 16 ((c >> 1) & 3), k = t2 | t0 << 1 | t1 << 2 | t3 << 3 (t bits)
+  [4096, 4224) record dword [head, token]: K scale group 0, K scale group 1 (e5m3 bytes, fp16 bits = byte << 7), zero points (group 0
+               low nibble, group 1 high nibble), V scale (e5m3 byte)
+Quantisation is token-local (prefix-shared pages are never rewritten): K and V are rotated by a sign-randomised Hadamard (q and
+the output are rotated the same way, exact), scales are rounded up to 3 mantissa bits, and each scale is picked by an MSE search
+over 7 clip ratios. The newest WIN tokens of each running request also go to a per-request int8 side buffer (SLOTS request
+slots, allocated before memory profiling, so they come out of the KV pool); decode reads them instead of the pages whenever the
+slot's tag says the entry holds that position, and falls back to the pages otherwise (no slot, prefix-cache hits, resumes).
+Prefill rows attend to the pages (dequantised into the workspace) and to the fresh rotated bf16 K / V of their own chunk.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import re
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+from .logging_utils import get_logger
+from ._inverse_fp32 import _reduce_inverse_fp32
+logger = get_logger(__name__)
+
+D, PAGE, HKV_EXP, QPK = 128, 16, 2, 8
+PAGE_BYTES = 4224
+OFF_V, OFF_REC = 2048, 4096
+WIN, SLOTS = 128, 64
+WIN_ON = True                                        # P0 ablation only: False times the page kernel alone
+WIN_WARPS = 2                                        # E040 P0: 33.7 us vs 51.1 (4 warps) at 64 rows
+LAST_DIM = PAGE_BYTES // (2 * PAGE * HKV_EXP)       # 66: kv_cache shape (blocks, 2, 16, 2, 66) has exactly one page per block
+_LOG2E = 1.4426950408889634
+_INV_SQRT_D = 1.0 / math.sqrt(D)
+
+# shared state: tags [SLOTS, WIN] (position held by each window entry, -1 = empty), per-row slot of the current batch
+_TAGS: Optional[torch.Tensor] = None
+_STAGE_TAGS: Optional[list[torch.Tensor]] = None
+_ROW_SLOT: Optional[torch.Tensor] = None
+_ROW_PROMPT: Optional[torch.Tensor] = None
+_HAD: dict = {}
+
+
+def _had_pm(device):
+    """(+-1 Sylvester Hadamard [D, D] bf16, sign vector [D] fp32): H = diag(sign) @ Had / sqrt(D) (E039 proxy, seed 7)."""
+    key = str(device)
+    if key not in _HAD:
+        h = torch.ones(1, 1)
+        while h.shape[0] < D:
+            h = torch.cat([torch.cat([h, h], 1), torch.cat([h, -h], 1)], 0)
+        g = torch.Generator().manual_seed(7)
+        sign = (torch.randint(0, 2, (D,), generator=g) * 2 - 1).float()
+        _HAD[key] = (h.to(torch.bfloat16).to(device), sign.to(device))
+    return _HAD[key]
+
+
+def rot_matrix(device):
+    """fp32 orthonormal H (reference / tests): x_rot = x @ H."""
+    h, sign = _had_pm(device)
+    return sign[:, None] * h.float() * _INV_SQRT_D
+
+
+# --------------------------------------------------------------------------- kernels
+
+
+@triton.jit
+def _rot_kernel(X, Y, HAD, SIGN, R, H, sx0, sx1, sy0, sy1, inv_sqrt_d,
+                INV: tl.constexpr, SPLIT: tl.constexpr, BR: tl.constexpr, D: tl.constexpr):
+    """Y[r] = X[r] @ H (INV: @ H^T), rows r = (token, head) with token = r // H; H = diag(sign) Had / sqrt(D).
+    The +-1 Hadamard and the sign flip are exact in bf16, so only the fp32 accumulation rounds."""
+    r = tl.program_id(0) * BR + tl.arange(0, BR)
+    rm = r < R
+    t = (r // H).to(tl.int64)
+    hh = r % H
+    d = tl.arange(0, D)
+    x = tl.load(X + t[:, None] * sx0 + hh[:, None] * sx1 + d[None, :], mask=rm[:, None], other=0.0).to(tl.float32)
+    sg = tl.load(SIGN + d)
+    if not INV:
+        x = x * sg[None, :]
+    had = tl.load(HAD + d[:, None] * D + d[None, :])
+    xh = x.to(tl.bfloat16)
+    y = tl.dot(xh, had)
+    if SPLIT:                                                   # fp32 input: the bf16 residual keeps ~16 mantissa bits
+        y += tl.dot((x - xh.to(tl.float32)).to(tl.bfloat16), had)
+    y = y * inv_sqrt_d
+    if INV:
+        y = y * sg[None, :]
+    tl.store(Y + t[:, None] * sy0 + hh[:, None] * sy1 + d[None, :], y.to(Y.dtype.element_ty), mask=rm[:, None])
+
+
+
+@triton.jit
+def _e374_shfl_xor(x, lane, mask):
+    return tl.inline_asm_elementwise(
+        "ml_slb_shuffle_rtn_b32 $0, $1, $2;\nsl_wait lmcnt(0);",
+        "=r,r,r",
+        [x, lane ^ mask],
+        dtype=x.dtype,
+        is_pure=True,
+        pack=1,
+    )
+
+
+@triton.jit
+def _e374_fwht128_2(a, b, lane):
+    s = a + b
+    d = a - b
+    a, b = s, d
+    for stride in tl.static_range(6):
+        mask = 1 << (5 - stride)
+        pa = _e374_shfl_xor(a, lane, mask)
+        pb = _e374_shfl_xor(b, lane, mask)
+        bit = (lane & mask) != 0
+        a = tl.where(bit, pa - a, a + pa)
+        b = tl.where(bit, pb - b, b + pb)
+    return a, b
+
+
+@triton.jit
+def _rot_bfly_kernel(X, Y, SIGN, sx0, sx1, sy0, sy1, inv_sqrt_d,
+                     INV: tl.constexpr):
+    t = tl.program_id(0).to(tl.int64)
+    tid = tl.arange(0, 256)
+    wid = tid // 64
+    lane = tid % 64
+    sg0 = tl.load(SIGN + lane)
+    sg1 = tl.load(SIGN + lane + 64)
+    for iter_h in tl.static_range(4):
+        hh = wid * 4 + iter_h
+        xp = X + t * sx0 + hh * sx1
+        yp = Y + t * sy0 + hh * sy1
+        x0 = tl.load(xp + lane).to(tl.float32)
+        x1 = tl.load(xp + lane + 64).to(tl.float32)
+        if not INV:
+            x0 = x0 * sg0
+            x1 = x1 * sg1
+        y0, y1 = _e374_fwht128_2(x0, x1, lane)
+        y0 = y0 * inv_sqrt_d
+        y1 = y1 * inv_sqrt_d
+        if INV:
+            y0 = y0 * sg0
+            y1 = y1 * sg1
+        tl.store(yp + lane, y0.to(Y.dtype.element_ty))
+        tl.store(yp + lane + 64, y1.to(Y.dtype.element_ty))
+
+
+def rotate(x, y, inv=False):
+    """x, y: [tokens, heads, D] (any strides with unit last stride)."""
+    n, h, d = x.shape
+    R = n * h
+    if R == 0:
+        return y
+    if h == 16 and d == D:
+        from . import attention as A
+        A._once("e374_rot_bfly", "E374 butterfly H128 rotate active")
+        _, sign = _had_pm(x.device)
+        _rot_bfly_kernel[(n,)](x, y, sign, x.stride(0), x.stride(1), y.stride(0), y.stride(1),
+                               _INV_SQRT_D, INV=inv, num_warps=4, num_stages=1)
+        return y
+    had, sign = _had_pm(x.device)
+    _rot_kernel[(triton.cdiv(R, 16),)](x, y, had, sign, R, h, x.stride(0), x.stride(1), y.stride(0), y.stride(1),
+                                      _INV_SQRT_D, INV=inv, SPLIT=x.dtype == torch.float32, BR=16, D=D, num_warps=4)
+    return y
+
+
+@triton.jit
+def _rot2_kernel(XK, XV, YK, YV, HAD, SIGN, R, H, kx0, kx1, vx0, vx1, y0, y1, inv_sqrt_d,
+                 BR: tl.constexpr, D: tl.constexpr):
+    """E043: K and V rotation in one launch (programs [0, nb) rotate K, [nb, 2nb) rotate V); bf16 input, same math as _rot_kernel."""
+    nb = tl.cdiv(R, BR)
+    pid = tl.program_id(0)
+    isv = pid >= nb
+    r = (pid - tl.where(isv, nb, 0)) * BR + tl.arange(0, BR)
+    rm = r < R
+    t = (r // H).to(tl.int64)
+    hh = r % H
+    d = tl.arange(0, D)
+    px = tl.where(isv, XV, XK)
+    s0 = tl.where(isv, vx0, kx0)
+    s1 = tl.where(isv, vx1, kx1)
+    x = tl.load(px + t[:, None] * s0 + hh[:, None] * s1 + d[None, :], mask=rm[:, None], other=0.0).to(tl.float32)
+    sg = tl.load(SIGN + d)
+    x = x * sg[None, :]
+    had = tl.load(HAD + d[:, None] * D + d[None, :])
+    y = tl.dot(x.to(tl.bfloat16), had) * inv_sqrt_d
+    py = tl.where(isv, YV, YK)
+    tl.store(py + t[:, None] * y0 + hh[:, None] * y1 + d[None, :], y, mask=rm[:, None])
+
+
+def rotate2(key, value, kr, vr):
+    """E043: rotate(key, kr); rotate(value, vr) as one launch (bf16 inputs, fp32 outputs of equal strides)."""
+    n, h, _ = key.shape
+    R = n * h
+    if R == 0:
+        return
+    had, sign = _had_pm(key.device)
+    _rot2_kernel[(2 * triton.cdiv(R, 16),)](key, value, kr, vr, had, sign, R, h, key.stride(0), key.stride(1),
+                                            value.stride(0), value.stride(1), kr.stride(0), kr.stride(1),
+                                            _INV_SQRT_D, BR=16, D=D, num_warps=4)
+
+
+@triton.jit(do_not_specialize=["S"])
+def _reduce_inv_kernel(PO, PM, PL, O, CU_Q, HAD, SIGN, s_o0, s_o1, S, inv_sqrt_d, SP: tl.constexpr, HQ: tl.constexpr, D: tl.constexpr):
+    """E043: _reduce_kernel followed by the inverse rotation (fp32 split dot) and the bf16 store: one launch, one HBM round trip less."""
+    seq = tl.program_id(0)
+    qrow = tl.load(CU_Q + seq)
+    if tl.load(CU_Q + seq + 1) - qrow != 1:
+        return
+    rows = tl.arange(0, HQ)
+    sidx = tl.arange(0, SP)
+    smask = sidx < S
+    d = tl.arange(0, D)
+    base = seq * S * HQ
+    m = tl.load(PM + base + sidx[:, None] * HQ + rows[None, :], mask=smask[:, None], other=float("-inf"))
+    lsum = tl.load(PL + base + sidx[:, None] * HQ + rows[None, :], mask=smask[:, None], other=0.0)
+    mx = tl.max(m, 0)
+    mx = tl.where(mx > float("-inf"), mx, 0.0)
+    denom = tl.sum(tl.exp2(m - mx[None, :]) * lsum, 0)
+    denom = tl.where(denom > 0.0, denom, 1.0)
+    acc = tl.zeros([HQ, D], tl.float32)
+    for s in range(S):
+        w = tl.exp2(tl.load(PM + base + s * HQ + rows) - mx)
+        acc += tl.load(PO + (base + s * HQ + rows)[:, None] * D + d[None, :]) * w[:, None]
+    x = acc / denom[:, None]
+    sg = tl.load(SIGN + d)
+    had = tl.load(HAD + d[:, None] * D + d[None, :])
+    xh = x.to(tl.bfloat16)
+    y = tl.dot(xh, had)
+    y += tl.dot((x - xh.to(tl.float32)).to(tl.bfloat16), had)
+    y = y * inv_sqrt_d * sg[None, :]
+    tl.store(O + qrow.to(tl.int64) * s_o0 + rows[:, None] * s_o1 + d[None, :], y.to(O.dtype.element_ty))
+
+
+_FP32_INV_MARKED = False
+
+
+def reduce_inverse(po, pm, pl, final, cu, had, sign, s1, nseq, hq):
+    """E082 (via E090/E092): reduce + direct FP32 H128 butterfly inverse + bf16 store.
+
+    Replaces the BF16 hi/residual MMA emulation of _reduce_inv_kernel; same
+    Hadamard, signs and scale, FP32 throughout. Four heads per program, one warp.
+    """
+    global _FP32_INV_MARKED
+    assert hq == 16 and hq % 4 == 0, hq
+    if not _FP32_INV_MARKED:
+        _FP32_INV_MARKED = True
+        logger.warning("E082 FP32 inverse butterfly active heads/program=4")
+    _reduce_inverse_fp32[(nseq, hq // 4)](po, pm, pl, final, cu, sign, final.stride(0), final.stride(1),
+                                         S=s1, inv_sqrt_d=_INV_SQRT_D, SP=triton.next_power_of_2(s1),
+                                         HEADS=4, num_warps=1, num_stages=1)
+
+
+@triton.jit
+def _e5m3_up(s):
+    """positive fp32 -> e5m3 byte (fp16 bits >> 7, mantissa rounded up) as int32; decode with _e5m3_dec."""
+    b = s.to(tl.float16).to(tl.int16, bitcast=True).to(tl.int32)
+    return tl.minimum(tl.maximum((b + 127) >> 7, 1), 247)                 # 247: largest finite e5m3 (exp 30, mant 7)
+
+
+@triton.jit
+def _e5m3_dec(b):
+    return (b.to(tl.int32) << 7).to(tl.int16).to(tl.float16, bitcast=True).to(tl.float32)
+
+
+@triton.jit
+def _hw_k(h, e, t):
+    """int16 index in a page of K halfword e, token t, head h"""
+    return 512 * h + 256 * (e >> 4) + 128 * (t >> 3) + 2 * ((e & 15) + 16 * ((t >> 1) & 3)) + (t & 1)
+
+
+@triton.jit
+def _hw_v(h, e, t):
+    """int16 index in a page of V halfword e, token t, head h"""
+    c = e & 15
+    k = ((t >> 2) & 1) | ((t & 1) << 1) | (((t >> 1) & 1) << 2) | (((t >> 3) & 1) << 3)
+    return 1024 + 512 * h + 256 * (e >> 4) + 128 * (c >> 3) + 2 * (k + 16 * ((c >> 1) & 3)) + (c & 1)
+
+
+@triton.jit
+def _hw_v2(h, c, t):
+    """int16 index in a page of the V2 halfword of dim-pair column c (0..15; the two 64-dim groups share it), token t, head h:
+    8 two-bit codes, field p8 = 4 g + p is dim 64 g + 4 c + p."""
+    k = ((t >> 2) & 1) | ((t & 1) << 1) | (((t >> 1) & 1) << 2) | (((t >> 3) & 1) << 3)
+    return 1024 + 256 * h + 128 * (c >> 3) + 2 * (k + 16 * ((c >> 1) & 3)) + (c & 1)
+
+
+import os as _os_v2
+_V2_DEFAULT = "0-9,11,12,14,18,23,24,27-38,40,41" if _os_v2.environ.get("FLAGOS_CARD_A_PROFILE", "balanced").strip().lower() == "throughput" else "0,1,2,3,4,5,6,7,9,18,23,26,30,33,34,36,37,39,40,41"
+
+
+def v2_layer_set():
+    import os
+    spec = _V2_DEFAULT
+    out = set()
+    for part in spec.split(","):
+        part = part.strip()
+        if not part or part == "none":
+            continue
+        a, _, b = part.partition("-")
+        out.update(range(int(a), int(b or a) + 1))
+    return frozenset(out)
+
+
+_V2_SET = v2_layer_set()
+
+
+def is_v2_layer(layer):
+    import re
+    m = re.search(r"layers\.(\d+)\.", getattr(layer, "layer_name", "") or "")
+    return bool(m) and int(m.group(1)) in _V2_SET
+
+
+@triton.jit
+def _write_kernel(KR, VR, SLOTMAP, CU, SEQ, ROWSLOT, n_rows, C16, C8, WK, WV, WKS, WVS, TAGS,
+                  s_r0, s_r1, page16, page8, HAS_WIN: tl.constexpr, W: tl.constexpr, V2: tl.constexpr,
+                  NATIVE_WIN: tl.constexpr=False,TOKEN_WIN:tl.constexpr=False,SPLIT_META_WIN:tl.constexpr=False):
+    """One (token, KV head): rotated fp32 K / V -> int4 page entry (+ int8 window entry). Tiles are [32 halfwords, 4 nibbles]:
+    element [e, p] is rotated dim 4e + p, so halfwords 0-15 are K group 0 (dims 0-63) and 16-31 group 1."""
+    i = tl.program_id(0)
+    h = tl.program_id(1)
+    sl = tl.load(SLOTMAP + i)
+    if sl < 0:
+        return
+    blk = sl // 16
+    tt = (sl % 16).to(tl.int32)
+    e16 = tl.arange(0, 32)
+    pl = tl.arange(0, 4)
+    dim = 4 * e16[:, None] + pl[None, :]
+    g0 = (e16 < 16)[:, None]
+    xk = tl.load(KR + i.to(tl.int64) * s_r0 + h * s_r1 + dim)
+    xv = tl.load(VR + i.to(tl.int64) * s_r0 + h * s_r1 + dim)
+    # ---- K: asym, integer zero point, e5m3 scale, per 64-dim group, MSE clip search
+    lo00 = tl.minimum(tl.min(tl.min(tl.where(g0, xk, float("inf")), 1)), 0.0)
+    hi00 = tl.maximum(tl.max(tl.max(tl.where(g0, xk, float("-inf")), 1)), 0.0)
+    lo01 = tl.minimum(tl.min(tl.min(tl.where(g0, float("inf"), xk), 1)), 0.0)
+    hi01 = tl.maximum(tl.max(tl.max(tl.where(g0, float("-inf"), xk), 1)), 0.0)
+    be0 = float("inf")
+    be1 = float("inf")
+    sb0 = 0
+    sb1 = 0
+    z0 = 0.0
+    z1 = 0.0
+    qk = tl.zeros([32, 4], tl.float32)
+    for k in tl.static_range(7):
+        r = 1.0 - 0.05 * k
+        hf0 = (hi00 - lo00) * 0.5 * r
+        hf1 = (hi01 - lo01) * 0.5 * r
+        lo0 = tl.minimum((hi00 + lo00) * 0.5 - hf0, 0.0)
+        lo1 = tl.minimum((hi01 + lo01) * 0.5 - hf1, 0.0)
+        cb0 = _e5m3_up(tl.maximum(2.0 * hf0 / 15.0, 1.220703125e-4))
+        cb1 = _e5m3_up(tl.maximum(2.0 * hf1 / 15.0, 1.220703125e-4))
+        s0 = _e5m3_dec(cb0)
+        s1 = _e5m3_dec(cb1)
+        cz0 = tl.minimum(tl.maximum(tl.floor(-lo0 / s0 + 0.5), 0.0), 15.0)
+        cz1 = tl.minimum(tl.maximum(tl.floor(-lo1 / s1 + 0.5), 0.0), 15.0)
+        sr = tl.where(g0, s0, s1)
+        zr = tl.where(g0, cz0, cz1)
+        q = tl.minimum(tl.maximum(tl.floor(xk / sr + 0.5) + zr, 0.0), 15.0)
+        er = ((q - zr) * sr - xk) * ((q - zr) * sr - xk)
+        e0 = tl.sum(tl.sum(tl.where(g0, er, 0.0), 1))
+        e1 = tl.sum(tl.sum(tl.where(g0, 0.0, er), 1))
+        u0 = e0 < be0
+        u1 = e1 < be1
+        be0 = tl.where(u0, e0, be0)
+        be1 = tl.where(u1, e1, be1)
+        sb0 = tl.where(u0, cb0, sb0)
+        sb1 = tl.where(u1, cb1, sb1)
+        z0 = tl.where(u0, cz0, z0)
+        z1 = tl.where(u1, cz1, z1)
+        ur = tl.where(g0, u0, u1)
+        qk = tl.where(ur, q, qk)
+    # ---- V: symmetric, e5m3 scale, MSE clip search (V2: 2 bit mid-rise {-1.5,-.5,.5,1.5} x s, 9 clip ratios)
+    av = tl.max(tl.max(tl.abs(xv), 1))
+    bev = float("inf")
+    sbv = 0
+    qv = tl.zeros([32, 4], tl.float32)
+    if V2:
+        for k in tl.static_range(9):
+            r = 1.0 - 0.05 * k
+            cbv = _e5m3_up(tl.maximum(av * r / 1.5, 1.220703125e-4))
+            sv = _e5m3_dec(cbv)
+            f = tl.minimum(tl.maximum(tl.floor(xv / sv), -2.0), 1.0)
+            y = (f + 0.5) * sv
+            ev = tl.sum(tl.sum((y - xv) * (y - xv), 1))
+            uv = ev < bev
+            bev = tl.where(uv, ev, bev)
+            sbv = tl.where(uv, cbv, sbv)
+            qv = tl.where(uv, f + 2.0, qv)
+    else:
+        for k in tl.static_range(7):
+            r = 1.0 - 0.05 * k
+            cbv = _e5m3_up(tl.maximum(av * r / 7.0, 1.220703125e-4))
+            sv = _e5m3_dec(cbv)
+            q = tl.minimum(tl.maximum(tl.floor(xv / sv + 0.5), -8.0), 7.0)
+            ev = tl.sum(tl.sum((q * sv - xv) * (q * sv - xv), 1))
+            uv = ev < bev
+            bev = tl.where(uv, ev, bev)
+            sbv = tl.where(uv, cbv, sbv)
+            qv = tl.where(uv, q, qv)
+    sh = 4 * pl[None, :]
+    hk = tl.sum(qk.to(tl.int32) << sh, 1)
+    ht = h * 16 + tt
+    p16 = C16 + blk * page16
+    tl.store(p16 + _hw_k(h, e16, tt), hk.to(tl.int16))
+    if V2:                                                    # one byte per (e): g 0 -> low byte, g 1 -> high byte of the V2 halfword
+        hb = tl.sum(qv.to(tl.int32) << (2 * pl[None, :]), 1)
+        tl.store(C8 + blk * page8 + 2 * _hw_v2(h, e16 & 15, tt) + (e16 >> 4), hb.to(tl.uint8))
+    else:
+        hv = tl.sum((qv + 8.0).to(tl.int32) << sh, 1)
+        tl.store(p16 + _hw_v(h, e16, tt), hv.to(tl.int16))
+    p8 = C8 + blk * page8 + 4096 + ht * 4
+    tl.store(p8, sb0.to(tl.uint8))
+    tl.store(p8 + 1, sb1.to(tl.uint8))
+    tl.store(p8 + 2, (z0.to(tl.int32) | (z1.to(tl.int32) << 4)).to(tl.uint8))
+    tl.store(p8 + 3, sbv.to(tl.uint8))
+    if HAS_WIN:
+        lo = 0
+        hi = n_rows
+        while lo < hi:                                            # row of token i: largest row with CU[row] <= i
+            mid = (lo + hi) // 2
+            cnd = tl.load(CU + mid) <= i
+            lo = tl.where(cnd, mid + 1, lo)
+            hi = tl.where(cnd, hi, mid)
+        row = lo - 1
+        c0 = tl.load(CU + row)
+        end = tl.load(SEQ + row)
+        pos = end - (tl.load(CU + row + 1) - c0) + (i - c0)
+        slot = tl.load(ROWSLOT + row)
+        if (slot >= 0) & (pos >= end - W):
+            e = slot * W + pos % W
+            ks = tl.maximum(tl.max(tl.max(tl.abs(xk), 1)) / 127.0, 1e-8)
+            vs = tl.maximum(av / 127.0, 1e-8)
+            kq = tl.floor(xk / ks + 0.5)
+            vq = tl.floor(xv / vs + 0.5)
+            if NATIVE_WIN:
+                base=WK.to(tl.pointer_type(tl.int32))+(slot*8+(pos%W)//16)*(2048 if SPLIT_META_WIN else 2112)
+                ku=(tl.minimum(tl.maximum(kq,-127.),127.).to(tl.int32)&255)^128
+                vu=(tl.minimum(tl.maximum(vq,-127.),127.).to(tl.int32)&255)^128
+                kw=tl.sum(ku<<(8*pl[None,:]),axis=1)
+                vw=tl.sum(vu<<(8*pl[None,:]),axis=1)
+                if TOKEN_WIN:
+                    tl.store(base+(pos%16)*64+h*32+e16,kw)
+                    tl.store(base+1024+(pos%16)*64+h*32+e16,vw)
+                else:
+                    tl.store(base+_hw_k(h,e16,pos%16),kw)
+                    tl.store(base+_hw_v(h,e16,pos%16),vw)
+                if SPLIT_META_WIN:
+                    meta=WKS+(slot*8+(pos%W)//16)*64
+                    tl.store(meta+h*16+pos%16,ks)
+                    tl.store(meta+32+h*16+pos%16,vs)
+                else:
+                    tl.store(base+2048+h*16+pos%16,ks.to(tl.int32,bitcast=True))
+                    tl.store(base+2080+h*16+pos%16,vs.to(tl.int32,bitcast=True))
+            else:
+                wb = (e * 2 + h).to(tl.int64) * 128
+                tl.store(WK + wb + dim, tl.minimum(tl.maximum(kq, -127.0), 127.0).to(tl.int8))
+                tl.store(WV + wb + dim, tl.minimum(tl.maximum(vq, -127.0), 127.0).to(tl.int8))
+                tl.store(WKS + e * 2 + h, ks)
+                tl.store(WVS + e * 2 + h, vs)
+            if h == 0:
+                tl.store(TAGS + e, pos)
+
+
+@triton.jit
+def _meta(C8, blk, ht, ok):
+    """per token: K scales / zero points of groups 0 and 1, V scale"""
+    p8 = C8 + blk * 4224 + 4096 + ht * 4
+    s0 = _e5m3_dec(tl.load(p8, mask=ok, other=0))
+    s1 = _e5m3_dec(tl.load(p8 + 1, mask=ok, other=0))
+    zb = tl.load(p8 + 2, mask=ok, other=0).to(tl.int32)
+    vs = _e5m3_dec(tl.load(p8 + 3, mask=ok, other=0))
+    return s0, s1, (zb & 15).to(tl.float32), (zb >> 4).to(tl.float32), vs
+
+
+@triton.jit
+def _wstart(TAGS, ROWSLOT, seq, L, W: tl.constexpr):
+    """First position of the window suffix this row's slot holds (L if none). Entries are written for every computed
+    position that ends within W of its step's end, so the held positions of [L - W, L) are always a suffix: binary search."""
+    slot = tl.load(ROWSLOT + seq)
+    lo = tl.maximum(L - W, 0)
+    hi = L
+    if slot < 0:
+        lo = L
+    else:
+        for _ in tl.static_range(8):                       # W = 128: 8 halvings cover it
+            go = lo < hi
+            mid = (lo + hi) // 2
+            held = tl.load(TAGS + slot * W + mid % W, mask=go, other=-1) == mid
+            lo = tl.where(go & (held == 0), mid + 1, lo)
+            hi = tl.where(go & held, mid, hi)
+    return lo, slot
+
+
+@triton.jit
+def _unp8(w, i: tl.constexpr):
+    """byte i of an int32 word of four int8 codes as the exact fp16 value (xor 0x80 -> offset binary, magic 1024 + u - 1152)"""
+    return ((((w >> (8 * i)) & 0xff) ^ 0x80) | 0x6400).to(tl.int16).to(tl.float16, bitcast=True) - 1152.0
+
+
+@triton.jit(do_not_specialize=["S"])
+def _win4_kernel(Q, SEQ_LENS, CU_Q, ROWSLOT, TAGS, WK, WV, WKS, WVS, PO, PM, PL, qk_scale,
+                 s_q0, s_q1, S, HQ: tl.constexpr, D: tl.constexpr, QPK: tl.constexpr, W: tl.constexpr,
+                 NATIVE_WIN:tl.constexpr=False,TOKEN_WIN:tl.constexpr=False,SPLIT_META_WIN:tl.constexpr=False):
+    """Window suffix [v0, L) of one decode row from the int8 side buffer (natural dim order, read as int32 words like the
+    shipped int8 kernel: word c holds dims 4c..4c+3), one scale per token-head factored out of the dots.
+    Writes partial slot S of S + 1; the page kernel covers [0, v0)."""
+    h = tl.program_id(0)
+    seq = tl.program_id(1)
+    qrow = tl.load(CU_Q + seq)
+    if tl.load(CU_Q + seq + 1) - qrow != 1:
+        return
+    L = tl.load(SEQ_LENS + seq)
+    v0, slot = _wstart(TAGS, ROWSLOT, seq, L, W)
+    t = tl.arange(0, W)
+    p = v0 + t
+    ok = p < L
+    rows = tl.arange(0, 16)
+    rmask = rows < QPK
+    c = tl.arange(0, 32)
+    eb = ((slot * W + p % W) * 2 + h).to(tl.int64)
+    off = eb[:, None] * 32 + c[None, :]
+    if NATIVE_WIN:
+        base=(slot*8+(p%W)//16)*(2048 if SPLIT_META_WIN else 2112)
+        if TOKEN_WIN:
+            offset=(p%16)[:,None]*64+h*32+c[None,:]
+            kw=tl.load(WK+base[:,None]+offset,mask=ok[:,None],other=0).to(tl.uint32)^0x80808080
+            vw=tl.load(WK+base[:,None]+1024+offset,mask=ok[:,None],other=0).to(tl.uint32)^0x80808080
+        else:
+            kw=tl.load(WK+base[:,None]+_hw_k(h,c[None,:],(p%16)[:,None]),mask=ok[:,None],other=0).to(tl.uint32)^0x80808080
+            vw=tl.load(WK+base[:,None]+_hw_v(h,c[None,:],(p%16)[:,None]),mask=ok[:,None],other=0).to(tl.uint32)^0x80808080
+        if SPLIT_META_WIN:
+            meta=(slot*8+(p%W)//16)*64
+            ks8=tl.load(WKS+meta+h*16+p%16,mask=ok,other=0.)
+            vs8=tl.load(WKS+meta+32+h*16+p%16,mask=ok,other=0.)
+        else:
+            ks8=tl.load(WK+base+2048+h*16+p%16,mask=ok,other=0).to(tl.float32,bitcast=True)
+            vs8=tl.load(WK+base+2080+h*16+p%16,mask=ok,other=0).to(tl.float32,bitcast=True)
+    else:
+        kw = tl.load(WK + off, mask=ok[:, None], other=0)
+        vw = tl.load(WV + off, mask=ok[:, None], other=0)
+        ks8 = tl.load(WKS + eb, mask=ok, other=0.0)
+        vs8 = tl.load(WVS + eb, mask=ok, other=0.0)
+    qb = Q + qrow.to(tl.int64) * s_q0 + (h * QPK + rows)[:, None] * s_q1 + (4 * c)[None, :]
+    sc = tl.dot(tl.load(qb, mask=rmask[:, None], other=0.0).to(tl.float16), tl.trans(_unp8(kw, 0)))
+    sc += tl.dot(tl.load(qb + 1, mask=rmask[:, None], other=0.0).to(tl.float16), tl.trans(_unp8(kw, 1)))
+    sc += tl.dot(tl.load(qb + 2, mask=rmask[:, None], other=0.0).to(tl.float16), tl.trans(_unp8(kw, 2)))
+    sc += tl.dot(tl.load(qb + 3, mask=rmask[:, None], other=0.0).to(tl.float16), tl.trans(_unp8(kw, 3)))
+    sc = tl.where(ok[None, :], sc * (ks8 * qk_scale)[None, :], float("-inf"))
+    m = tl.max(sc, 1)
+    m = tl.where(m > float("-inf"), m, 0.0)
+    pr = tl.exp2(sc - m[:, None])
+    l_i = tl.sum(pr, 1)
+    ps = (pr * (vs8 * 64.0)[None, :]).to(tl.float16)
+    pbase = (seq * (S + 1) + S) * HQ + h * QPK
+    po = PO + (pbase + rows)[:, None] * D + (4 * c)[None, :]
+    r = 1.0 / 64.0
+    tl.store(po, tl.dot(ps, _unp8(vw, 0)) * r, mask=rmask[:, None])
+    tl.store(po + 1, tl.dot(ps, _unp8(vw, 1)) * r, mask=rmask[:, None])
+    tl.store(po + 2, tl.dot(ps, _unp8(vw, 2)) * r, mask=rmask[:, None])
+    tl.store(po + 3, tl.dot(ps, _unp8(vw, 3)) * r, mask=rmask[:, None])
+    tl.store(PM + pbase + rows, tl.where(l_i > 0.0, m, float("-inf")), mask=rmask)
+    tl.store(PL + pbase + rows, l_i, mask=rmask)
