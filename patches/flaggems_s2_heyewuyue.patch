@@ -0,0 +1,629 @@
+# Copyright (c) 2026 BAAI. All rights reserved.
+
+"""Sort-free top-p (nucleus) filter for Iluvatar, and the sampler patch that uses it.
+
+The kernel is our FlagGems ``fused.top_p_mask_`` (E002, branch
+``e002-sortfree-topp``), vendored here because the Iluvatar image ships an
+older FlagGems without it. vLLM's Triton top-k/top-p kernel takes 3-7 ms per
+step on Iluvatar at 64 rows; top-p-only batches go to this kernel instead.
+
+Same result as sorting each row ascending (stable), taking the softmax
+cumulative sum and masking every position whose cumulative probability is
+<= 1 - p (never the last one), but without sorting the vocabulary.
+
+Logits are mapped to order-preserving int32 keys, so "the top-p cut" is a
+threshold on keys, found by MSB-first radix select (two key bits per pass,
+skipping bit groups that agree across the row), then a tie pass and an
+in-place write pass. Only reductions, comparisons and scalar loop-carried
+values are used (no scan, sort, atomics or int64 arithmetic on keys).
+"""
+
+import logging
+
+import torch
+import triton
+import triton.language as tl
+
+from .logging_utils import get_logger
+logger = get_logger(__name__)
+
+# Instantiated constexpr so the kernel may read them (Triton 3.6 rejects
+# plain and annotated globals). _MIN32 is the 0x80000000 bit pattern, used to
+# flip a key between signed-comparison order and MSB-first radix order.
+_MIN32 = tl.constexpr(-2147483648)
+_LOG2E = tl.constexpr(1.4426950408889634)
+
+
+@triton.jit
+def _ordered_key(x):
+    """Order-preserving int32 key of a float32 value."""
+    # -0.0 + 0.0 == +0.0, so both zeros share one key (value semantics).
+    bits = (x + 0.0).to(tl.int32, bitcast=True)
+    return tl.where(bits < 0, bits ^ 0x7FFFFFFF, bits)
+
+
+@triton.jit
+def _lshr(x, s: tl.constexpr):
+    """Logical right shift of an int32 (Triton's >> is arithmetic)."""
+    if s == 0:
+        return x
+    return ((x >> 1) & 0x7FFFFFFF) >> (s - 1)
+
+
+@triton.jit
+def _bit_or(a, b):
+    return a | b
+
+
+@triton.jit
+def _bit_and(a, b):
+    return a & b
+
+
+@triton.jit
+def _top_p_mask_kernel(
+    logits_ptr,
+    p_ptr,
+    stride_row,
+    vocab_size,
+    invt_ptr,
+    out_ptr,
+    seed_ptr,
+    BLOCK: tl.constexpr,
+    PASSES: tl.constexpr,
+    LOG2_BLOCK: tl.constexpr,
+    SAMPLE: tl.constexpr,
+):
+    row = tl.program_id(0)
+    base = logits_ptr + row.to(tl.int64) * stride_row
+    offs = tl.arange(0, BLOCK)
+    thr = 1.0 - tl.load(p_ptr + row).to(tl.float32)
+    if SAMPLE:
+        invt = tl.load(invt_ptr + row).to(tl.float32)
+        seed = tl.load(seed_ptr)
+    else:
+        invt = 1.0
+
+    # ---- pass 1: row max, softmax denominator, OR/AND of the magnitude bits.
+    m_vec = tl.full([BLOCK], -3.0e38, tl.float32)
+    z_vec = tl.zeros([BLOCK], tl.float32)
+    or_vec = tl.zeros([BLOCK], tl.int32)
+    and_vec = tl.full([BLOCK], 0x7FFFFFFF, tl.int32)
+    for start in range(0, vocab_size, BLOCK):
+        idx = start + offs
+        valid = idx < vocab_size
+        x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32) * invt
+        mag = (x + 0.0).to(tl.int32, bitcast=True) & 0x7FFFFFFF
+        or_vec = or_vec | tl.where(valid, mag, 0)
+        and_vec = and_vec & tl.where(valid, mag, 0x7FFFFFFF)
+        new_m = tl.maximum(m_vec, x)
+        # exp2 with a pre-scaled argument: no per-element division later.
+        z_vec = z_vec * tl.exp2((m_vec - new_m) * _LOG2E) + tl.where(
+            valid, tl.exp2((x - new_m) * _LOG2E), 0.0
+        )
+        m_vec = new_m
+    m = tl.max(m_vec, axis=0)
+    z = tl.sum(z_vec * tl.exp2((m_vec - m) * _LOG2E), axis=0)
+    m_or = tl.reduce(or_vec, 0, _bit_or)
+    m_and = tl.reduce(and_vec, 0, _bit_and)
+    # Magnitude bits that differ somewhere in the row. The key flips the
+    # magnitude bits of negative values, so a constant magnitude group is
+    # constant within a sign, whichever sign the search has settled on.
+    differ = m_or ^ m_and
+    # Absolute threshold on exp2 weights: sum(w[key <= k]) <= thr * z.
+    # Clamped below z so the whole row always exceeds it, which keeps the cut
+    # inside the key range (only reachable for p below ~6e-8, which vLLM
+    # rejects; valid p <= 1 is unaffected).
+    thr_z = tl.minimum(thr * z, z * 0.99999994)
+
+    # ---- pass 2: MSB-first radix select for the smallest radix key u with
+    # sum(w[u' <= u]) > thr_z. Two bits per pass: four one-dimensional
+    # accumulators, one per bucket, reduced once after the loop.
+    prefix = tl.zeros([], tl.int32)  # the bits of u decided so far
+    below = tl.zeros([], tl.float32)  # mass of keys below the subtree
+    for p_idx in tl.static_range(PASSES):
+        # Group 0 holds the sign bit and is always searched. Later groups
+        # whose magnitude bits agree across the row are taken without a read.
+        if p_idx > 0 and (_lshr(differ, 32 - (p_idx + 1) * 2) & 3) == 0:
+            c = _lshr(m_and, 32 - (p_idx + 1) * 2) & 3
+            # u's top bit is 1 for positive values; negative values carry
+            # the complemented magnitude bits.
+            neg = (_lshr(prefix, 2 * p_idx - 1) & 1) == 0
+            prefix = (prefix << 2) | tl.where(neg, c ^ 3, c)
+        else:
+            a0 = tl.zeros([BLOCK], tl.float32)
+            a1 = tl.zeros([BLOCK], tl.float32)
+            a2 = tl.zeros([BLOCK], tl.float32)
+            a3 = tl.zeros([BLOCK], tl.float32)
+            for start in range(0, vocab_size, BLOCK):
+                idx = start + offs
+                valid = idx < vocab_size
+                x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32) * invt
+                u = _ordered_key(x) ^ _MIN32
+                if p_idx > 0:
+                    valid = valid & (_lshr(u, 32 - p_idx * 2) == prefix)
+                w = tl.where(valid, tl.exp2((x - m) * _LOG2E), 0.0)
+                bucket = _lshr(u, 32 - (p_idx + 1) * 2) & 3
+                a0 += tl.where(bucket == 0, w, 0.0)
+                a1 += tl.where(bucket == 1, w, 0.0)
+                a2 += tl.where(bucket == 2, w, 0.0)
+                a3 += tl.where(bucket == 3, w, 0.0)
+            s0 = tl.sum(a0, axis=0)
+            s1 = tl.sum(a1, axis=0)
+            s2 = tl.sum(a2, axis=0)
+            c0 = below + s0
+            c1 = c0 + s1
+            c2 = c1 + s2
+            first = tl.where(c0 > thr_z, 0, tl.where(c1 > thr_z, 1, tl.where(c2 > thr_z, 2, 3)))
+            below += tl.where(first > 0, s0, 0.0) + tl.where(first > 1, s1, 0.0) + tl.where(first > 2, s2, 0.0)
+            prefix = (prefix << 2) | first
+    kstar = prefix ^ _MIN32
+
+    # ---- pass 3: tie count and weight at the cut key.
+    n_vec = tl.zeros([BLOCK], tl.int32)
+    w_vec = tl.zeros([BLOCK], tl.float32)
+    for start in range(0, vocab_size, BLOCK):
+        idx = start + offs
+        valid = idx < vocab_size
+        x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32) * invt
+        eq = valid & ((_ordered_key(x) ^ _MIN32) == prefix)
+        n_vec += eq.to(tl.int32)
+        w_vec = tl.maximum(w_vec, tl.where(eq, tl.exp2((x - m) * _LOG2E), 0.0))
+    n_eq = tl.sum(n_vec, axis=0)
+    w_one = tl.max(w_vec, axis=0)  # all ties share one value, hence one weight
+
+    # Ties dropped: the largest r < n_eq with below + r * w_one <= thr_z.
+    r_f = tl.where(w_one > 0.0, (thr_z - below) / w_one, 0.0)
+    r_f = tl.minimum(tl.maximum(r_f, 0.0), (n_eq - 1).to(tl.float32))
+    r = r_f.to(tl.int32)
+
+    # ---- pass 4: write -inf over dropped logits in place. Every block is
+    # stored whole (kept values rewritten unchanged): a masked scatter store
+    # is ~8x slower than a dense store on MetaX.
+    neg_inf = tl.full([BLOCK], float("-inf"), tl.float32)
+    carry = tl.zeros([], tl.int32)
+    best = tl.full([], -3.0e38, tl.float32)
+    best_i = tl.zeros([], tl.int32)
+    for start in range(0, vocab_size, BLOCK):
+        idx = start + offs
+        valid = idx < vocab_size
+        x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32) * invt
+        key = _ordered_key(x)
+        drop = key < kstar
+        if carry < r:
+            eq = valid & (key == kstar)
+            cnt = tl.sum(eq.to(tl.int32), axis=0)
+            need = r - carry
+            if need >= cnt:
+                drop = drop | eq
+            else:
+                # Smallest j with count(eq & offs < j) >= need, by bisection
+                # on the block (no scan primitive needed).
+                jlo = tl.zeros([], tl.int32)
+                jhi = tl.zeros([], tl.int32) + BLOCK
+                for _ in range(LOG2_BLOCK + 1):
+                    jmid = (jlo + jhi) // 2
+                    ok = tl.sum((eq & (offs < jmid)).to(tl.int32), axis=0) >= need
+                    jhi = tl.where(ok, jmid, jhi)
+                    jlo = tl.where(ok, jlo, jmid + 1)
+                drop = drop | (eq & (offs < jhi))
+            carry += cnt
+        if SAMPLE:
+            # Gumbel-max over the kept tokens: argmax(x - log(-log u)) with u ~ U(0,1) is an exact draw from
+            # softmax(x restricted to the kept set), the same law as argmax(probs / Exp(1)) in vLLM.
+            keep = (~drop) & valid
+            if tl.sum(keep.to(tl.int32), axis=0) > 0:        # most blocks hold no nucleus token: skip the draw there
+                u = tl.rand(seed, row * vocab_size + idx)
+                u = tl.minimum(tl.maximum(u, 1.0e-20), 0.99999994)
+                sc = tl.where(keep, x - tl.log(-tl.log(u)), -3.0e38)
+                bm = tl.max(sc, axis=0)
+                bi = tl.min(tl.where(sc == bm, offs, BLOCK), axis=0) + start
+                upd = bm > best
+                best_i = tl.where(upd, bi, best_i)
+                best = tl.where(upd, bm, best)
+        else:
+            out = tl.where(drop, neg_inf, x).to(logits_ptr.dtype.element_ty)
+            tl.store(base + idx, out, mask=valid)
+    if SAMPLE:
+        tl.store(out_ptr + row, best_i)
+
+
+# --------------------------------------------------------------------------- E043 candidate-compaction sampler
+
+# Pass 1 (row max, softmax mass) is the full kernel's. Pass 2 stores the tokens within DEPTH of the max (per-lane slots, then
+# one prefix sum into a dense scratch row), and the radix cut and the Gumbel draw run over those tokens only. A row whose mass
+# below that set exceeds (1-p) z, that stores more than CAP tokens or overflows a lane's K slots runs the full-row body.
+# Real MiniCPM5 logits (1280 rows, temperature 1): 132 tokens within 12 of the max on average, 10120 at most, mass below
+# <= 0.028 z, so p = 0.95 (cut at 0.05 z) never needs the fallback.
+_FAST_K, _FAST_CAP, _FAST_DEPTH, _FAST_BLOCK, _FAST_SB = 8, 16384, 12.0, 4096, 512
+FAST_SAMPLE_CALLS = 0
+_FAST_BUF = {}
+
+
+@triton.jit
+def _tp_fast_kernel(logits_ptr, p_ptr, stride_row, vocab_size, invt_ptr, out_ptr, seed_ptr, SV, SI, LV, LI,
+                    BLOCK: tl.constexpr, SB: tl.constexpr, K: tl.constexpr, CAP: tl.constexpr, DEPTH: tl.constexpr,
+                    PASSES: tl.constexpr, LOG2_BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    base = logits_ptr + row.to(tl.int64) * stride_row
+    offs = tl.arange(0, BLOCK)
+    thr = 1.0 - tl.load(p_ptr + row).to(tl.float32)
+    invt = tl.load(invt_ptr + row).to(tl.float32)
+    seed = tl.load(seed_ptr)
+
+    # ---- pass 1: row max and softmax mass
+    m_vec = tl.full([BLOCK], -3.0e38, tl.float32)
+    z_vec = tl.zeros([BLOCK], tl.float32)
+    for start in range(0, vocab_size, BLOCK):
+        idx = start + offs
+        valid = idx < vocab_size
+        x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32) * invt
+        new_m = tl.maximum(m_vec, x)
+        z_vec = z_vec * tl.exp2((m_vec - new_m) * _LOG2E) + tl.where(valid, tl.exp2((x - new_m) * _LOG2E), 0.0)
+        m_vec = new_m
+    m = tl.max(m_vec, axis=0)
+    z = tl.sum(z_vec * tl.exp2((m_vec - m) * _LOG2E), axis=0)
+    thr_z = tl.minimum(thr * z, z * 0.99999994)
+    # ---- pass 2: per-lane candidate slots (no cross-lane work in the loop), tail mass, magnitude-bit OR/AND
+    lane = row * BLOCK + offs
+    cvec = tl.zeros([BLOCK], tl.int32)
+    tail_vec = tl.zeros([BLOCK], tl.float32)
+    or_vec = tl.zeros([BLOCK], tl.int32)
+    and_vec = tl.full([BLOCK], 0x7FFFFFFF, tl.int32)
+    for start in range(0, vocab_size, BLOCK):
+        idx = start + offs
+        valid = idx < vocab_size
+        x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32) * invt
+        cand = valid & (x >= m - DEPTH)
+        tail_vec += tl.where(valid & (~cand), tl.exp2((x - m) * _LOG2E), 0.0)
+        mag = (x + 0.0).to(tl.int32, bitcast=True) & 0x7FFFFFFF
+        or_vec = or_vec | tl.where(cand, mag, 0)
+        and_vec = and_vec & tl.where(cand, mag, 0x7FFFFFFF)
+        st = cand & (cvec < K)
+        tl.store(LV + lane * K + cvec, x, mask=st)
+        tl.store(LI + lane * K + cvec, idx, mask=st)
+        cvec += cand.to(tl.int32)
+    tail = tl.sum(tail_vec, axis=0)
+    m_or = tl.reduce(or_vec, 0, _bit_or)
+    m_and = tl.reduce(and_vec, 0, _bit_and)
+    differ = m_or ^ m_and
+    ovf = tl.max(cvec, axis=0) > K
+    cc = tl.minimum(cvec, K)
+    off = tl.cumsum(cc, axis=0) - cc
+    n = tl.sum(cc, axis=0)
+    sv = SV + row * CAP
+    si = SI + row * CAP
+    for k in tl.static_range(K):
+        mk = (cc > k) & ((off + k) < CAP)
+        tl.store(sv + off + k, tl.load(LV + lane * K + k, mask=mk, other=0.0), mask=mk)
+        tl.store(si + off + k, tl.load(LI + lane * K + k, mask=mk, other=0), mask=mk)
+    if (n <= CAP) & (tail <= thr_z) & (~ovf):
+        sb = tl.arange(0, SB)
+        # ---- radix select over the stored tokens (as the full kernel, `below` starts at the tail mass)
+        prefix = tl.zeros([], tl.int32)
+        below = tail
+        for p_idx in tl.static_range(PASSES):
+            if p_idx > 0 and (_lshr(differ, 32 - (p_idx + 1) * 2) & 3) == 0:
+                c = _lshr(m_and, 32 - (p_idx + 1) * 2) & 3
+                neg = (_lshr(prefix, 2 * p_idx - 1) & 1) == 0
+                prefix = (prefix << 2) | tl.where(neg, c ^ 3, c)
+            else:
+                a0 = tl.zeros([SB], tl.float32)
+                a1 = tl.zeros([SB], tl.float32)
+                a2 = tl.zeros([SB], tl.float32)
+                a3 = tl.zeros([SB], tl.float32)
+                for s0 in range(0, n, SB):
+                    j = s0 + sb
+                    valid = j < n
+                    x = tl.load(sv + j, mask=valid, other=float("-inf"))
+                    u = _ordered_key(x) ^ _MIN32
+                    if p_idx > 0:
+                        valid = valid & (_lshr(u, 32 - p_idx * 2) == prefix)
+                    w = tl.where(valid, tl.exp2((x - m) * _LOG2E), 0.0)
+                    bucket = _lshr(u, 32 - (p_idx + 1) * 2) & 3
+                    a0 += tl.where(bucket == 0, w, 0.0)
+                    a1 += tl.where(bucket == 1, w, 0.0)
+                    a2 += tl.where(bucket == 2, w, 0.0)
+                    a3 += tl.where(bucket == 3, w, 0.0)
+                t0 = tl.sum(a0, axis=0)
+                t1 = tl.sum(a1, axis=0)
+                t2 = tl.sum(a2, axis=0)
+                c0 = below + t0
+                c1 = c0 + t1
+                c2 = c1 + t2
+                first = tl.where(c0 > thr_z, 0, tl.where(c1 > thr_z, 1, tl.where(c2 > thr_z, 2, 3)))
+                below += tl.where(first > 0, t0, 0.0) + tl.where(first > 1, t1, 0.0) + tl.where(first > 2, t2, 0.0)
+                prefix = (prefix << 2) | first
+        kstar = prefix ^ _MIN32
+        # ---- ties at the cut key
+        n_vec = tl.zeros([SB], tl.int32)
+        w_vec = tl.zeros([SB], tl.float32)
+        for s0 in range(0, n, SB):
+            j = s0 + sb
+            valid = j < n
+            x = tl.load(sv + j, mask=valid, other=float("-inf"))
+            eq = valid & ((_ordered_key(x) ^ _MIN32) == prefix)
+            n_vec += eq.to(tl.int32)
+            w_vec = tl.maximum(w_vec, tl.where(eq, tl.exp2((x - m) * _LOG2E), 0.0))
+        n_eq = tl.sum(n_vec, axis=0)
+        w_one = tl.max(w_vec, axis=0)
+        r_f = tl.where(w_one > 0.0, (thr_z - below) / w_one, 0.0)
+        r_f = tl.minimum(tl.maximum(r_f, 0.0), (n_eq - 1).to(tl.float32))
+        r = r_f.to(tl.int32)
+        # ---- ties at the cut: the r lowest token indices are dropped (stable-sort order), found by bisection on the index
+        tcut = tl.zeros([], tl.int32)
+        if r > 0:
+            tlo = tl.zeros([], tl.int32)
+            thi = tl.zeros([], tl.int32) + 262144
+            for _ in range(19):
+                tmid = (tlo + thi) // 2
+                cv = tl.zeros([SB], tl.int32)
+                for s0 in range(0, n, SB):
+                    j = s0 + sb
+                    valid = j < n
+                    x = tl.load(sv + j, mask=valid, other=float("-inf"))
+                    gi = tl.load(si + j, mask=valid, other=0)
+                    cv += (valid & (_ordered_key(x) == kstar) & (gi < tmid)).to(tl.int32)
+                okb = tl.sum(cv, axis=0) >= r
+                thi = tl.where(okb, tmid, thi)
+                tlo = tl.where(okb, tlo, tmid + 1)
+            tcut = thi
+        # ---- keep set, Gumbel-max draw (noise keyed by the global token index, as the full kernel)
+        best = tl.full([], -3.0e38, tl.float32)
+        best_i = tl.zeros([], tl.int32)
+        for s0 in range(0, n, SB):
+            j = s0 + sb
+            valid = j < n
+            x = tl.load(sv + j, mask=valid, other=float("-inf"))
+            gi = tl.load(si + j, mask=valid, other=0)
+            key = _ordered_key(x)
+            drop = (key < kstar) | ((key == kstar) & (gi < tcut))
+            keep = (~drop) & valid
+            u = tl.rand(seed, row * vocab_size + gi)
+            u = tl.minimum(tl.maximum(u, 1.0e-20), 0.99999994)
+            sc = tl.where(keep, x - tl.log(-tl.log(u)), -3.0e38)
+            bm = tl.max(sc, axis=0)
+            bi = tl.min(tl.where(sc == bm, gi, 2147483647), axis=0)
+            upd = bm > best
+            best_i = tl.where(upd, bi, best_i)
+            best = tl.where(upd, bm, best)
+        tl.store(out_ptr + row, best_i)
+    else:
+        _top_p_mask_kernel(logits_ptr, p_ptr, stride_row, vocab_size, invt_ptr, out_ptr, seed_ptr,
+                           BLOCK=BLOCK, PASSES=PASSES, LOG2_BLOCK=LOG2_BLOCK, SAMPLE=True)
+
+
+def _fast_buffers(device, rows):
+    key = (str(device), rows)
+    b = _FAST_BUF.get(key)
+    if b is None:
+        b = _FAST_BUF[key] = (
+            torch.empty((rows, _FAST_CAP), dtype=torch.float32, device=device),
+            torch.empty((rows, _FAST_CAP), dtype=torch.int32, device=device),
+            torch.empty((rows * _FAST_BLOCK * _FAST_K,), dtype=torch.float32, device=device),
+            torch.empty((rows * _FAST_BLOCK * _FAST_K,), dtype=torch.int32, device=device))
+    return b
+
+
+def top_p_sample_fast(logits, p, inv_temp, seed):
+    """top_p_sample with the candidate-compaction kernel (same kept set, same noise per token index)."""
+    global FAST_SAMPLE_CALLS
+    num_rows, vocab_size = logits.shape
+    p = p.to(device=logits.device, dtype=torch.float32).reshape(-1).contiguous()
+    inv_temp = inv_temp.to(device=logits.device, dtype=torch.float32).reshape(-1).contiguous()
+    out = torch.empty((num_rows,), dtype=torch.int32, device=logits.device)
+    sv, si, lv, li = _fast_buffers(logits.device, num_rows)
+    if FAST_SAMPLE_CALLS == 0:
+        logger.info("E043 candidate-compaction top-p sampler active (rows=%d)", num_rows)
+    FAST_SAMPLE_CALLS += 1
+    with torch.cuda.device(logits.device):
+        _tp_fast_kernel[(num_rows,)](
+            logits, p, logits.stride(0), vocab_size, inv_temp, out, seed, sv, si, lv, li,
+            BLOCK=_FAST_BLOCK, SB=_FAST_SB, K=_FAST_K, CAP=_FAST_CAP, DEPTH=_FAST_DEPTH,
+            PASSES=16, LOG2_BLOCK=_FAST_BLOCK.bit_length() - 1, num_warps=8, num_stages=1)
+    return out.to(torch.int64)
+
+
+
+# --------------------------------------------------------------------------- E044 inverse-CDF top-p sampler
+# One draw t ~ softmax(x) by inverse CDF over block masses, kept iff sum(w[x_j <= x_t]) > (1-p) z (the radix kernel's membership rule), else redraw:
+# rejection sampling, so the law is softmax restricted to the nucleus. ~2 row reads instead of ~19; P(reject) <= 1-p. E044 attempt 4.
+INV_SAMPLE_CALLS = 0
+
+
+@triton.jit
+def _tp_inv_kernel(logits_ptr, p_ptr, stride_row, vocab_size, invt_ptr, out_ptr, seed_ptr, NB, BLOCK: tl.constexpr, NBLK: tl.constexpr, ITERS: tl.constexpr):
+    row = tl.program_id(0)
+    base = logits_ptr + row.to(tl.int64) * stride_row
+    offs = tl.arange(0, BLOCK)
+    bo = tl.arange(0, NBLK)
+    thr = 1.0 - tl.load(p_ptr + row).to(tl.float32)
+    invt = tl.load(invt_ptr + row).to(tl.float32)
+    seed = tl.load(seed_ptr)
+    mb_vec = tl.full([NBLK], -3.0e38, tl.float32)
+    sb_vec = tl.zeros([NBLK], tl.float32)
+    for blk in range(0, NB):
+        idx = blk * BLOCK + offs
+        valid = idx < vocab_size
+        x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32) * invt
+        mb = tl.max(x, axis=0)
+        sb = tl.sum(tl.where(valid, tl.exp2((x - mb) * _LOG2E), 0.0), axis=0)
+        mb_vec = tl.where(bo == blk, mb, mb_vec)
+        sb_vec = tl.where(bo == blk, sb, sb_vec)
+    m = tl.max(mb_vec, axis=0)
+    S = sb_vec * tl.exp2((mb_vec - m) * _LOG2E)
+    z = tl.sum(S, axis=0)
+    thr_z = tl.minimum(thr * z, z * 0.99999994)
+    cum = tl.cumsum(S, axis=0)
+    it = 0
+    acc = 0
+    res = 0
+    while (acc == 0) & (it < ITERS):
+        u = tl.max(tl.rand(seed, row * ITERS + it + bo * 0), axis=0)
+        u = tl.minimum(tl.maximum(u, 1.0e-20), 0.99999994)
+        target = u * z
+        b = tl.minimum(tl.sum((cum <= target).to(tl.int32), axis=0), NB - 1)
+        prev = tl.sum(tl.where(bo == b - 1, cum, 0.0), axis=0)
+        idx = b * BLOCK + offs
+        valid = idx < vocab_size
+        x = tl.load(base + idx, mask=valid, other=float("-inf")).to(tl.float32) * invt
+        w = tl.where(valid, tl.exp2((x - m) * _LOG2E), 0.0)
+        cw = tl.cumsum(w, axis=0)
+        j = tl.minimum(tl.sum(((cw <= (target - prev)) & valid).to(tl.int32), axis=0), tl.sum(valid.to(tl.int32), axis=0) - 1)
+        xt = tl.sum(tl.where(offs == j, x, 0.0), axis=0)
+        inc = tl.zeros([BLOCK], tl.float32)
+        for blk in range(0, NB):
+            i2 = blk * BLOCK + offs
+            v2 = i2 < vocab_size
+            x2 = tl.load(base + i2, mask=v2, other=float("-inf")).to(tl.float32) * invt
+            inc += tl.where(v2 & (x2 <= xt), tl.exp2((x2 - m) * _LOG2E), 0.0)
+        ok = tl.sum(inc, axis=0) > thr_z
+        res = tl.where(ok, b * BLOCK + j, res)
+        acc = ok.to(tl.int32)
+        it += 1
+    tl.store(out_ptr + row, res)
+
+
+def top_p_sample_inv(logits, p, inv_temp, seed, block=8192, num_warps=8):
+    global INV_SAMPLE_CALLS
+    R, V = logits.shape
+    p = p.to(device=logits.device, dtype=torch.float32).reshape(-1).contiguous()
+    inv_temp = inv_temp.to(device=logits.device, dtype=torch.float32).reshape(-1).contiguous()
+    if INV_SAMPLE_CALLS == 0:
+        logger.info("E044 inverse-CDF top-p sampler active (rows=%d)", R)
+    INV_SAMPLE_CALLS += 1
+    out = torch.empty(R, dtype=torch.int32, device=logits.device)
+    nb = triton.cdiv(V, block)
+    with torch.cuda.device(logits.device):
+        _tp_inv_kernel[(R,)](logits, p, logits.stride(0), V, inv_temp, out, seed, nb, BLOCK=block, NBLK=triton.next_power_of_2(nb), ITERS=24, num_warps=num_warps, num_stages=1)
+    return out.to(torch.int64)
+
+
+
+
+def top_p_mask_(
+    logits: torch.Tensor,
+    p: torch.Tensor,
+    block: int | None = None,
+    num_warps: int = 16,
+    num_stages: int = 2,
+) -> torch.Tensor:
+    """Apply a top-p filter to ``logits`` [num_rows, vocab] in place.
+
+    ``p`` holds one top-p value per row. Dropped logits become ``-inf``;
+    kept logits are unchanged. Returns ``logits``.
+    """
+    logger.debug("GEMS TOP_P_MASK_")
+    assert logits.dim() == 2, f"logits must be 2D, got {logits.dim()}D"
+    assert logits.stride(1) == 1, "logits rows must be contiguous"
+    num_rows, vocab_size = logits.shape
+    if block is None:   # E017 attempt 1 on Iluvatar: 4096 best at 64 rows, 8192 at 1-32
+        block = 4096 if num_rows >= 64 else 8192
+    assert block > 0 and block & (block - 1) == 0, "block must be a power of 2"
+    p = p.to(device=logits.device, dtype=torch.float32).reshape(-1).contiguous()
+    assert p.numel() == num_rows, "p must hold one value per row"
+    if num_rows == 0:
+        return logits
+    with torch.cuda.device(logits.device):
+        _top_p_mask_kernel[(num_rows,)](
+            logits,
+            p,
+            logits.stride(0),
+            vocab_size,
+            p,
+            p,
+            p,
+            BLOCK=block,
+            PASSES=16,
+            LOG2_BLOCK=block.bit_length() - 1,
+            SAMPLE=False,
+            num_warps=num_warps,
+            num_stages=num_stages,
+        )
+    return logits
+
+
+def top_p_sample(
+    logits: torch.Tensor,
+    p: torch.Tensor,
+    inv_temp: torch.Tensor,
+    seed: torch.Tensor,
+    block: int | None = None,
+    num_warps: int = 16,
+    num_stages: int = 2,
+) -> torch.Tensor:
+    """One draw per row from softmax(logits * inv_temp) restricted to the top-p set (E022 fused sampler).
+
+    The top-p cut is the one ``top_p_mask_`` makes; the draw is Gumbel-max over the kept tokens. ``logits`` is not
+    modified. ``seed`` is a 1-element int tensor on the device (a fresh value per call, drawn on the device).
+    """
+    num_rows, vocab_size = logits.shape
+    assert logits.stride(1) == 1
+    if logits.dtype == torch.float32 and block is None:
+        return top_p_sample_inv(logits, p, inv_temp, seed)
+    if block is None:
+        block = 4096 if num_rows >= 64 else 8192
+    p = p.to(device=logits.device, dtype=torch.float32).reshape(-1).contiguous()
+    inv_temp = inv_temp.to(device=logits.device, dtype=torch.float32).reshape(-1).contiguous()
+    out = torch.empty((num_rows,), dtype=torch.int32, device=logits.device)
+    with torch.cuda.device(logits.device):
+        _top_p_mask_kernel[(num_rows,)](
+            logits,
+            p,
+            logits.stride(0),
+            vocab_size,
+            inv_temp,
+            out,
+            seed,
+            BLOCK=block,
+            PASSES=16,
+            LOG2_BLOCK=block.bit_length() - 1,
+            SAMPLE=True,
+            num_warps=num_warps,
+            num_stages=num_stages,
+        )
+    return out.to(torch.int64)
+
+
+# --------------------------------------------------------------------------- sampler patch
+
+# Mechanism marker: number of batches filtered by the sort-free kernel.
+SORT_FREE_TOP_P_CALLS = 0
+
+
+
+
+
+
+# --------------------------------------------------------------------------- fused sampler (E022)
+
+FUSED_SAMPLE_CALLS = 0
+_SEED_BUF = {}
+
+
+def _fused_ok(logits, md) -> bool:
+    """The fused draw replaces temperature, top-p, softmax and the exponential-noise argmax; anything else stays stock."""
+    if not (md.all_random and md.top_k is None and md.top_p is not None and not md.generators):
+        return False
+    if md.max_num_logprobs is not None or md.logprob_token_ids or md.temperature is None:
+        return False
+    if logits.dim() != 2 or logits.stride(1) != 1 or logits.dtype != torch.float32 or logits.shape[0] == 0:
+        return False
+    for proc in md.logitsprocs.argmax_invariant:       # min-p is the only built-in one; inactive when its count is 0
+        if getattr(proc, "min_p_count", 1) != 0:
+            return False
+    return True
+
+
+
+
+def _warm_up(device) -> None:
+    """Compile every kernel variant the sampler can launch (block 4096 for >= 64 rows, 8192 below; mask and
+    sample) before the first request, so no benchmark run pays 3-5 s per variant (E022 attempt 2 JIT audit)."""
+    seed = torch.zeros(1, dtype=torch.int64, device=device)
+    for rows in (64, 8):
+        x = torch.randn((rows, 4096), device=device)
+        p = torch.full((rows,), 0.95, device=device)
+        top_p_mask_(x.clone(), p)
+        top_p_sample(x, p, torch.ones(rows, device=device), seed)
+    torch.cuda.synchronize()
