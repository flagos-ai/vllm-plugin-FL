@@ -0,0 +1,101 @@
+"""One-pass activation with explicit one-group-per-wave lane ownership."""
+from triton.experimental import gluon
+from triton.experimental.gluon import language as gl
+
+
+@gluon.jit
+def _peer(x, lane, mask: gl.constexpr):
+    return gl.inline_asm_elementwise(
+        "ml_slb_shuffle_rtn_b32 $0, $1, $2;\nsl_wait lmcnt(0);",
+        "=r,r,r", [x, lane ^ mask], dtype=x.dtype, is_pure=True, pack=1)
+
+
+@gluon.jit
+def _rotate(GU, row, group, lane, M, ACTIVATED: gl.constexpr):
+    valid = row < M
+    if ACTIVATED:
+        x = GU + row*6144 + group*128 + lane
+        x0 = gl.load(x, valid, 0).to(gl.float32)
+        x1 = gl.load(x+64, valid, 0).to(gl.float32)
+    else:
+        g = GU + row*12288 + group*128 + lane
+        g0 = gl.load(g, valid, 0).to(gl.float32)
+        g1 = gl.load(g+64, valid, 0).to(gl.float32)
+        u0 = gl.load(g+6144, valid, 0).to(gl.float32)
+        u1 = gl.load(g+6208, valid, 0).to(gl.float32)
+        s0 = (g0 * (1.0 / (1.0 + gl.exp(-g0)))).to(gl.bfloat16).to(gl.float32)
+        s1 = (g1 * (1.0 / (1.0 + gl.exp(-g1)))).to(gl.bfloat16).to(gl.float32)
+        x0 = (s0*u0).to(gl.bfloat16).to(gl.float32)
+        x1 = (s1*u1).to(gl.bfloat16).to(gl.float32)
+    a, b = x0+x1, x0-x1
+    for shift in gl.static_range(6):
+        mask = 1 << (5-shift)
+        pa, pb = _peer(a, lane, mask), _peer(b, lane, mask)
+        high = (lane & mask) != 0
+        a, b = gl.where(high, pa-a, a+pa), gl.where(high, pb-b, b+pb)
+    return ((a*(128 ** -.5)).to(gl.bfloat16).to(gl.float32),
+            (b*(128 ** -.5)).to(gl.bfloat16).to(gl.float32))
+
+
+@gluon.jit
+def _store_pair(Q, row, group, lane, MP, a, b, inv_scale, PANEL: gl.constexpr):
+    qa = gl.minimum(gl.maximum(gl.floor(a*inv_scale + 0.5), -127), 127).to(gl.int8)
+    qb = gl.minimum(gl.maximum(gl.floor(b*inv_scale + 0.5), -127), 127).to(gl.int8)
+    if PANEL:
+        out = Q + group*2*MP*64 + row*64 + lane
+        offset = MP*64
+    else:
+        out = Q + row*6144 + group*128 + lane
+        offset = 64
+    gl.store(out, qa)
+    gl.store(out+offset, qb)
+
+
+@gluon.jit(do_not_specialize=["M", "MP"])
+def activation_exact_groups(GU, Q, S, M, MP, PANEL: gl.constexpr, WARPS: gl.constexpr,
+                            ACTIVATED: gl.constexpr = False):
+    gl.static_assert(WARPS == 16)
+    order: gl.constexpr = gl.BlockedLayout([1, 1], [1, 64], [WARPS, 1], [1, 0])
+    group = gl.arange(0, 16, layout=gl.SliceLayout(1, order))[:, None]
+    lane = gl.arange(0, 64, layout=gl.SliceLayout(0, order))[None, :]
+    row = gl.program_id(0)
+    a0, b0 = _rotate(GU, row, group, lane, M, ACTIVATED)
+    a1, b1 = _rotate(GU, row, group+16, lane, M, ACTIVATED)
+    a2, b2 = _rotate(GU, row, group+32, lane, M, ACTIVATED)
+    p0 = gl.maximum(gl.abs(a0), gl.abs(b0))
+    p1 = gl.maximum(gl.abs(a1), gl.abs(b1))
+    p2 = gl.maximum(gl.abs(a2), gl.abs(b2))
+    maximum = gl.max(gl.max(gl.maximum(gl.maximum(p0,p1),p2), 1), 0)
+    scale = gl.maximum(maximum, 1e-8) / 127.0
+    gl.store(S + row, scale)
+    inv_scale = 1.0 / scale
+    _store_pair(Q, row, group, lane, MP, a0, b0, inv_scale, PANEL)
+    _store_pair(Q, row, group+16, lane, MP, a1, b1, inv_scale, PANEL)
+    _store_pair(Q, row, group+32, lane, MP, a2, b2, inv_scale, PANEL)
+
+
+import triton
+import triton.language as tl
+from flag_gems.fused.minicpm.w8a8 import _swizzle
+@triton.jit
+def project_down(A, B, C, SA, SB, N, K, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+                 GROUP: tl.constexpr, NPM, UNROLL: tl.constexpr = 1):
+    """C[Mp, N] = (A[Mp, K] int8 . B[N, K]^T int8) * SA[Mp] * SB[N] -> bf16 over padded rows (Mp = NPM * BM).
+    No masks anywhere: a masked load in the K loop ran this kernel 5x slower (E018 attempt 1 vs E012)."""
+    pm, pn = _swizzle(NPM * BM, N, BM, BN, GROUP)
+    rm = pm * BM + tl.arange(0, BM)
+    rn = pn * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    a = A + rm[:, None] * BK + rk[None, :]
+    b = B + rn[None, :] * K + rk[:, None]
+    acc = tl.zeros([BM, BN], dtype=tl.int32)
+    for _ in tl.range(0, K, BK, loop_unroll_factor=UNROLL):
+        acc += tl.dot(tl.load(a), tl.load(b), out_dtype=tl.int32)
+        a += NPM*BM*BK
+        b += BK
+    sa = tl.load(SA + rm)
+    sb = tl.load(SB + rn)
+    out = acc.to(tl.float32) * sa[:, None] * sb[None, :]
+    tl.store(C + rm[:, None] * N + rn[None, :], out.to(C.dtype.element_ty))
+
+
