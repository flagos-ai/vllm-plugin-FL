+    lens = [c + q for c, q in zip(ctx, qlen)]
+    slots = [0, -1, 1]
+    ks, vs, table = _fill_seqs(lens, slots, device, gen, kv, c8, c16, win)     # every token in the pages (the chunk too)
+    hq = QPK * HKV_EXP
+    kr = torch.cat([k[c:] for k, c in zip(ks, ctx)]).to(device)
+    vr = torch.cat([v[c:] for v, c in zip(vs, ctx)]).to(device)
+    qr = (torch.randn((sum(qlen), hq, D), generator=gen) * 0.3).to(device=device, dtype=torch.bfloat16)
+    cu_cpu = torch.tensor([0] + qlen).cumsum(0).to(torch.int32)
+    cu = cu_cpu.to(device)
+    seq = torch.tensor(lens, dtype=torch.int32, device=device)
+    A.plan_step(NS(max_query_len=max(qlen), seq_lens_cpu_upper_bound=seq.cpu(), query_start_loc_cpu=cu_cpu,
+                   num_reqs=len(lens), query_start_loc=cu), HKV_EXP, D, torch.bfloat16, device, False)
+    out = torch.zeros((sum(qlen), hq, D), dtype=torch.float32, device=device)
+    scale = D ** -0.5
+    try:
+        attend(qr, kr, vr, c8, c16, win, out, cu, seq, table, scale, max(qlen))
+    finally:
+        A._current_plan = None
+    torch.cuda.synchronize(device)
+    kd, vd = dequant_pages(c8.cpu())
+    tab, out, qc = table.cpu(), out.cpu(), qr.float().cpu()
+    err = 0.0
+    for i, n in enumerate(lens):
+        pos = torch.arange(n)
+        b = tab[i, pos // PAGE].long()
+        k, v = kd[b, pos % PAGE].clone(), vd[b, pos % PAGE].clone()
+        if qlen[i] > 1:                                                          # the chunk attends to itself in bf16
+            k[ctx[i]:] = ks[i][ctx[i]:].to(torch.bfloat16).float()
+            v[ctx[i]:] = vs[i][ctx[i]:].to(torch.bfloat16).float()
