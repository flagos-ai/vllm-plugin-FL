+        group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)
+        pid_m, pid_n = group_id * GROUP_M + (pid % group_size), (pid % width) // group_size
+    else:
+        pid_m, pid_n = pid // grid_n, pid % grid_n
