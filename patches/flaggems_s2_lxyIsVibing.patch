+        col_b: tl.constexpr = R0 * (SUB_N0_A + SUB_N1_A)
+        if pid >= ctas_r0:
+            pid_m1, pid_n1 = _bf16_swizzle_pid_2d(pid - ctas_r0, grid_m, R1, GM)
+            _bf16_gemm_region_body(A, B, C, M, N, K, pid_m1, pid_n1, col_b, BM, SUB_N0_B, 0, BK, EVEN_M, EVEN_N)
+            return
+        pid_m0, pid_n0 = _bf16_swizzle_pid_2d(pid, grid_m, R0, GM)
+        _bf16_gemm_region_body(A, B, C, M, N, K, pid_m0, pid_n0, 0, BM, SUB_N0_A, SUB_N1_A, BK, EVEN_M, EVEN_N)
+    else:
+        ctas_r0 = grid_m * R0
+        col_b: tl.constexpr = R0 * (SUB_N0_A + SUB_N1_A)
+        if pid < ctas_r0:
+            pid_m0, pid_n0 = _bf16_swizzle_pid_2d(pid, grid_m, R0, GM)
+            _bf16_gemm_region_body(A, B, C, M, N, K, pid_m0, pid_n0, 0, BM, SUB_N0_A, SUB_N1_A, BK, EVEN_M, EVEN_N)
+            return
+        pid_m1, pid_n1 = _bf16_swizzle_pid_2d(pid - ctas_r0, grid_m, R1, GM)
+        _bf16_gemm_region_body(A, B, C, M, N, K, pid_m1, pid_n1, col_b, BM, SUB_N0_B, SUB_N1_B, BK, EVEN_M, EVEN_N)
