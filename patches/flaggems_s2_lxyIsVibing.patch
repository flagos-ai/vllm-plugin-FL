+# ==============================================================================
+# Kernel 3: Stage-1 Paged KV Gather (`K8V4` / `K8V8` / `BF16` -> Contiguous BF16)
+# ==============================================================================
+@triton.jit
+def paged_gqa_stage1_gather_kv_kernel(
+    K, V, KS, VS, BT, CU, LEN, K_OUT, V_OUT, NSEQS, SLOT_OFFSET, SEQ_HINT=-1,
+    CUS: tl.constexpr = 1, LS: tl.constexpr = 1, BTS: tl.constexpr = 1, BTC: tl.constexpr = 1,
+    K0: tl.constexpr = 0, K1: tl.constexpr = 0, K2: tl.constexpr = 0, K3: tl.constexpr = 1,
+    V0: tl.constexpr = 0, V1: tl.constexpr = 1, V2: tl.constexpr = 0, V3: tl.constexpr = 1,
+    S0: tl.constexpr = 0, S1: tl.constexpr = 0, S2: tl.constexpr = 0, T0: tl.constexpr = 0, T1: tl.constexpr = 0, T2: tl.constexpr = 0,
+    KV_STRIDE: tl.constexpr = 16640, NKV: tl.constexpr = 2, D: tl.constexpr = 128,
+    PAGES_PER_CTA: tl.constexpr = 4, FILTER: tl.constexpr = 0, PACKED_BF16X2_SCALE: tl.constexpr = True,
+    WIDE_KV: tl.constexpr = False, USE_K8V4: tl.constexpr = False, INT8_KV: tl.constexpr = True, NO_ZERO_LEN: tl.constexpr = False,
+):
+    """Stage-1 prefill gather kernel dequantizing paged `K8V4`/`K8V8`/`BF16` KV into contiguous BF16 scratch."""
+    pid_blk, kh, local_slot = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    seq, _, _ = _locate_prefill_seq_hint(CU, NSEQS, SLOT_OFFSET + local_slot, SEQ_HINT, CUS, FILTER, NO_ZERO_LEN)
+    if seq < 0:
+        return
+    length = tl.load(LEN + seq * LS)
+    num_pages, base_page = tl.cdiv(length, 16), pid_blk * PAGES_PER_CTA
+    if length <= 0 or base_page >= num_pages:
+        return
+
+    out_dtype: tl.constexpr = K_OUT.dtype.element_ty
+    D_HALF: tl.constexpr = D // 2
+    slot_base = (local_slot * NKV + kh) * (KV_STRIDE * D)
+
+    if USE_K8V4 and V1 == 1:
+        k_dst_base, v_dst_base = K_OUT + slot_base, V_OUT + slot_base
+        n16, d, d_half, c4 = tl.arange(0, 16), tl.arange(0, D), tl.arange(0, D_HALF), tl.full((), 4, tl.int8)
+        bt_seq_ptr = BT + seq * BTS
+        for p in range(0, PAGES_PER_CTA):
