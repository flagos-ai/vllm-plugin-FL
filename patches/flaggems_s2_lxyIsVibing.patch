+@dataclass(frozen=True)
+class ComputeSpec:
+    """Data-type traits (`elem_bytes`, accumulator precision, minimum `BK`) for tile solving."""
+
+    elem_bytes: int = 1
+    accum_dtype: str = "int32"
+    min_bk: int = 64
+    allow_split_k: bool = True
+
+
+@dataclass(frozen=True)
+class LayerSpec:
+    """Static `(N, K)` geometry and per-token scale-group policy of a quantized linear layer.
+
+    When `carrier_packed=True` and `K >= 2 * N` (deep-K projections like `down_proj`), small-M
+    decode (`M <= 128`) can partition `K` into `vec_chunk = warp_size * 32 = 2048` sub-groups so
+    2-stage Split-K slices align cleanly with independent activation scale groups.
+    """
+
+    N: int
+    K: int
+    carrier_packed: bool = False
+    small_m_scale_groups: int = 1
+    large_m_scale_groups: int = 1
+    small_m_group_max_m: int = 128
+
+    @staticmethod
+    def from_problem(N: int, K: int, carrier: bool = False, scale_group_size: int = 0) -> LayerSpec:
+        """Construct a `LayerSpec` from `(N, K)`, deriving `small_m_scale_groups` from `scale_group_size` or `vec_chunk`."""
+        vec_chunk = get_device_topology().warp_size * 4 * 8
+        if scale_group_size > 0:
+            nsg = max(1, K // scale_group_size)
+        elif carrier and K >= 2 * N and (K % vec_chunk) == 0:
+            nsg = K // vec_chunk
+        else:
+            nsg = 1
+        return LayerSpec(N=N, K=K, carrier_packed=carrier, small_m_scale_groups=nsg)
+
+
+@dataclass(frozen=True)
+class TuningSpec:
+    """Resolved execution plan for an `M` bucket (`nt`, `1k_splitk`, or `2s_splitk`).
+
+    - `r0` tiles of width `bn0` + `r1` tiles of width `bn1` form a 1D or 2-region N-partition.
+    - `even_sc` / `odd_sc` separate MACA `scenario` hints so `storeCoalesce` is ONLY enabled
+      when `M % bm == 0` (`even_sc`), preventing boundary-row LDS corruption on unaligned `M`.
+    """
+
+    kind: str
+    bm: int
+    bn0: int
+    r0: int
+    bn1: int = 0
+    r1: int = 0
+    bk: int = 64
+    gm: int = 1
+    split_k: int = 1
+    n_scale_groups: int = 1
+    num_warps: int = 8
+    num_stages: int = 2
+    pln: int = -1
+    even_sc: str = ""
+    odd_sc: str = ""
+
+
+def _solve_2region_diophantine(N: int, bm: int, m_rep: int, bk: int, elem_bytes: int, topo: DeviceTopology):
+    """Solve `r0 * hi + r1 * lo >= N` with `r0 + r1 = r_min * (num_sms // gcd(g_m, num_sms))`.
+
+    On MetaX C500 (`num_sms = 104`), `m_rep = 2048, bm = 256` gives `g_m = 8` and wave unit
+    `u = 104 // gcd(8, 104) = 13` column tiles per wave (`8 * 13 = 104` CTAs). Partitioning `N`
+    across adjacent 2-CTA/CU co-resident widths `(256, 192)`, `(192, 160)`, or `(160, 128)` eliminates
+    tail-wave quantization (e.g., `N=12288 -> 36*256 + 16*192 = 52 = 4*13` column tiles = `4.00` waves)
+    while penalizing dual-subtile (`192 = 128+64`, `160 = 128+32`) overhead (`dual_pen`).
+    """
+    g_m = triton.cdiv(m_rep, bm)
+    u = max(1, topo.num_sms // math.gcd(g_m, topo.num_sms))
+    r_min = max(1, math.ceil(N / (256 * u)))
+    t_tiles = r_min * u
+    gm_swz = 1 if r_min == 1 else (8 if r_min >= 8 else (4 if elem_bytes == 1 else 8))
+    best = None
+    for hi, lo in ((256, 192), (192, 160), (160, 128)):
+        # Enforce 2-CTA/CU LDS co-residency (<= 32 KiB per CTA under MACA `pipeline="basic"`).
+        if not verify_lds_co_residency(bm, hi, bk, 2, elem_bytes=elem_bytes, target_ctas_per_cu=2):
+            continue
+        r0 = max(0, min(t_tiles, math.ceil((N - lo * t_tiles) / (hi - lo))))
+        r1 = t_tiles - r0
+        waste = (r0 * hi + r1 * lo) - N
+        if waste < 0 or waste >= 64:
+            continue
+        dual_pen = (1 if split_subtile(hi)[1] > 0 and r0 > 0 else 0) + (1 if split_subtile(lo)[1] > 0 and r1 > 0 else 0)
+        cand = ((waste, dual_pen, -(r0 * hi + r1 * lo) / t_tiles), r0, hi, r1, lo, gm_swz)
+        if best is None or cand[0] < best[0]:
+            best = cand
+    if best is None:
+        return None
+    _, r0, hi, r1, lo, gm_swz = best
+    if r0 == 0:
+        return (r1, lo, 0, 0, gm_swz)
+    return (r0, hi, 0, 0, gm_swz) if r1 == 0 else (r0, hi, r1, lo, gm_swz)
+
+
+def _pick_2stage_splitk(N: int, K: int, bk: int, nsg: int, num_sms: int) -> int:
+    """Choose `SPLIT_K` divisible by `nsg` and `K // bk` so `(N // 128) * sk` saturates `[0.85*C, 2*C]`."""
+    k_iters, g_ref = K // bk, max(1, N // 128)
+    best_sk, best_dist = (nsg if (nsg > 1 and k_iters % nsg == 0) else 1), 10**9
+    for sk in range(max(2, nsg), min(12, k_iters // 4) + 1):
+        if (sk % nsg) != 0 or (k_iters % sk) != 0:
+            continue
+        ctas = g_ref * sk
+        dist = abs(ctas - num_sms) + (0 if int(0.85 * num_sms) <= ctas <= 2 * num_sms else num_sms)
+        if dist < best_dist:
+            best_dist, best_sk = dist, sk
+    return best_sk
+
+
+@functools.lru_cache(maxsize=512)
+def solve_w8a8_tuning_for_bucket(spec: LayerSpec, m_rep: int, topo: DeviceTopology | None = None) -> TuningSpec:
+    """Derive a wave-quantization-aware W8A8 `TuningSpec` for `(spec, m_rep)` on MetaX C500.
+
+    Balances 104-CU wave efficiency, `8 MiB` L2 weight residency (`w_bytes` vs `l2`), and Split-K
+    reduction cost across representative `log2(M)` buckets (`m_rep in {8, 16, 32, 64, 128, 256, 512, 1024, 2048}`).
+    """
+    if topo is None:
+        topo = get_device_topology()
+    N, K, C, l2 = spec.N, spec.K, topo.num_sms, topo.l2_cache_bytes
+    nsg = spec.small_m_scale_groups if m_rep <= spec.small_m_group_max_m else spec.large_m_scale_groups
+    w_bytes, bk_hi = N * K, (128 if (K % (max(1, nsg) * 128)) == 0 else 64)
+
+    # Ultra-wide N (e.g. untied lm_head N=130560, w_bytes >> 24*L2): N-parallelism alone saturates
+    # >= 2 waves on 104 CUs without Split-K; stream weights once with `pln=1` at small M to cap L2 thrash.
+    if nsg == 1 and (triton.cdiv(N, 256) >= 2 * C or w_bytes > 24 * l2):
+        if m_rep >= 256:
+            return TuningSpec("nt", 256, 256, triton.cdiv(N, 256), bk=64, gm=4, num_warps=8)
+        if m_rep == 128:
+            return TuningSpec("nt", 128, 128, triton.cdiv(N, 128), bk=bk_hi, gm=1, num_warps=8)
+        if m_rep == 64:
+            return TuningSpec("nt", 64, 128, triton.cdiv(N, 128), bk=bk_hi, gm=1, num_warps=8, pln=1)
+        if m_rep == 32:
+            return TuningSpec("nt", 32, 64, triton.cdiv(N, 64), bk=bk_hi, gm=1, num_warps=4, pln=1)
+        return TuningSpec("nt", 16, 64, triton.cdiv(N, 64), bk=bk_hi, gm=1, num_warps=4)
+
+    # Large-M Prefill / Mixed steps (M >= 512): use 2-region Diophantine wave packing at BM=256/128
+    # so grid size hits exact multiples of 104 CUs; enable `storeCoalesce` ONLY on exact N & nsg==1.
+    if m_rep >= 512:
+        if m_rep == 2048 or (m_rep == 1024 and 4 * triton.cdiv(N, 256) >= int(1.5 * C)):
+            if (K % 64) == 0 and N >= 1024:
+                dio = _solve_2region_diophantine(N, 256, m_rep, 64, 1, topo)
+                if dio is not None:
+                    r0, bn0, r1, bn1, gm_swz = dio
+                    if (r0 * bn0 + r1 * bn1) == N and nsg == 1:
+                        sc = "storeCoalesce;dot_operands_out_loop" if (bn0 == 192 and K <= 2048) else "smemIndexOpt"
+                    else:
+                        sc = ""
+                    return TuningSpec("nt", 256, bn0, r0, bn1, r1, bk=64, gm=gm_swz, num_warps=8, even_sc=sc)
+            bn = 256 if N >= 2048 else 128
+            return TuningSpec("nt", 256, bn, triton.cdiv(N, bn), bk=64, gm=4, num_warps=8)
+        if m_rep == 1024:
+            u8 = max(1, C // math.gcd(8, C))
+            if (K % 64) == 0 and N <= 160 * u8:
+                dio = _solve_2region_diophantine(N, 128, 1024, 64, 1, topo)
+                if dio is not None:
+                    r0, bn0, r1, bn1, _ = dio
+                    return TuningSpec("nt", 128, bn0, r0, bn1, r1, bk=64, gm=4, num_warps=8)
+            bn = 256 if N >= 2048 else 128
+            return TuningSpec("nt", 128, bn, triton.cdiv(N, bn), bk=64, gm=4, num_warps=8)
+        if 2 * triton.cdiv(N, 256) >= int(0.75 * C):
+            return TuningSpec("nt", 256, 256, triton.cdiv(N, 256), bk=64, gm=4, num_warps=8)
+        return TuningSpec("nt", 128, 128, triton.cdiv(N, 128), bk=bk_hi, gm=4, num_warps=8)
+
+    if m_rep == 256:
+        if 2 * triton.cdiv(N, 256) >= int(0.75 * C):
+            return TuningSpec("nt", 128, 256, triton.cdiv(N, 256), bk=64, gm=4, num_warps=8)
+        bn = 128 if (K >= 2 * N or 4 * triton.cdiv(N, 128) >= int(0.9 * C)) else 64
+        return TuningSpec("nt", 64, bn, triton.cdiv(N, bn), bk=bk_hi, gm=4, num_warps=8)
+
+    # Medium/Decode transition (M <= 128): engage 2-stage or 1-kernel Split-K when N-tiles leave
+    # 104 CUs under-occupied (`< 0.75 * C`) on deep-K shapes or multi-group activation scales (`nsg > 1`).
+    if m_rep == 128:
+        if (nsg > 1 and (N % 64 == 0)) or ((N % 128 == 0) and K >= 2 * N and 2 * (N // 128) < int(0.75 * C) and K >= 2048):
+            bn_2s = 128 if (N % 128 == 0) else 64
+            w_2s = 8 if bn_2s == 128 else 4
+            sk = _pick_2stage_splitk(N, K, bk_hi, nsg, C)
+            if sk > 1:
+                return TuningSpec("2s_splitk", 64, bn_2s, N // bn_2s, bk=bk_hi, split_k=sk, n_scale_groups=nsg, num_warps=w_2s, pln=1, even_sc="dot_operands_out_loop")
+        if triton.cdiv(N, 128) >= int(0.85 * C):
+            return TuningSpec("nt", 128, 128, triton.cdiv(N, 128), bk=bk_hi, gm=4, num_warps=8)
+        bn = 128 if 2 * triton.cdiv(N, 128) >= int(0.85 * C) else 64
+        return TuningSpec("nt", 64, bn, triton.cdiv(N, bn), bk=bk_hi, gm=4, num_warps=8)
+
+    if (nsg > 1 and (N % 64 == 0)) or ((N % 128 == 0) and K >= 2 * N and (N // 128) < int(0.75 * C) and K >= 2048):
+        sk = _pick_2stage_splitk(N, K, bk_hi, nsg, C)
+        if sk > 1:
+            under_occ = (N % 128 != 0) or ((N // 128) * sk < int(0.85 * C))
+            bn_2s, w_2s = (64, 4) if under_occ else (128, 8)
+            if m_rep == 64:
+                # Prefer single-kernel L2-resident atomic Split-K (`1k_splitk`) when partial i32 buffer
+                # fits inside half of 8 MiB L2, avoiding a second kernel launch in Decode CUDAGraphs.
+                if nsg == 1 and (N % 128 == 0) and C < (N // 128) * sk < int(1.20 * C) and (2 * 64 * N * 4) <= l2 // 2:
+                    return TuningSpec("1k_splitk", 32, 64, N // 64, bk=bk_hi, split_k=2, num_warps=4)
+                return TuningSpec("2s_splitk", 64, bn_2s, N // bn_2s, bk=bk_hi, split_k=sk, n_scale_groups=nsg, num_warps=w_2s, pln=-1, even_sc="dot_operands_out_loop;smemOffsetCache;smemIndexOpt")
+            if m_rep == 32:
+                return TuningSpec("2s_splitk", 32, bn_2s, N // bn_2s, bk=bk_hi, split_k=sk, n_scale_groups=nsg, num_warps=w_2s, pln=-1, even_sc="smemIndexOpt")
+            return TuningSpec("2s_splitk", 16, bn_2s, N // bn_2s, bk=bk_hi, split_k=sk, n_scale_groups=nsg, num_warps=w_2s, pln=-1, even_sc="smemIndexOpt")
+
+    if triton.cdiv(N, 128) >= int(0.85 * C) and w_bytes <= 4 * l2:
+        if m_rep == 64:
+            return TuningSpec("nt", 64, 128, triton.cdiv(N, 128), bk=bk_hi, gm=1, num_warps=8)
+        if m_rep == 32:
+            return TuningSpec("nt", 32, 64, triton.cdiv(N, 64), bk=bk_hi, gm=1, num_warps=4)
+        if m_rep == 16:
+            return TuningSpec("nt", 16, 128, triton.cdiv(N, 128), bk=bk_hi, gm=1, num_warps=8)
+        return TuningSpec("nt", 16, 64, triton.cdiv(N, 64), bk=bk_hi, gm=1, num_warps=4)
+
+    if w_bytes > l2:
+        if m_rep == 64:
+            bn = 128 if (w_bytes > 15 * l2 and N % 128 == 0) else (64 if (N % 64 == 0) else 32)
+            sc = "storeCoalesce;dot_operands_out_loop" if (N % bn == 0 and nsg == 1) else ""
+            return TuningSpec("nt", 64, bn, triton.cdiv(N, bn), bk=bk_hi, gm=1, num_warps=8 if bn >= 64 else 4, even_sc=sc)
+        bm = 32 if m_rep == 32 else 16
+        if (N % 64 == 0) and (K % (bk_hi * 2) == 0) and (N // 64) <= C and (2 * bm * N * 4) <= l2 // 2:
+            return TuningSpec("1k_splitk", bm, 64, N // 64, bk=bk_hi, split_k=2, num_warps=4)
+        bn = 64 if N >= 64 else 32
+        return TuningSpec("nt", bm, bn, triton.cdiv(N, bn), bk=bk_hi, gm=1, num_warps=4)
+
+    if m_rep == 64:
+        bn = 64 if (2 * triton.cdiv(N, 64) >= C and N >= 64) else 32
+        sc = "cvt_shm_no_pad;dot_operands_out_loop" if (N % bn == 0 and (K % bk_hi) == 0 and 2 * triton.cdiv(N, bn) <= int(1.3 * C)) else ""
+        return TuningSpec("nt", 32, bn, triton.cdiv(N, bn), bk=bk_hi, gm=1, num_warps=4, even_sc=sc)
+
+    bm = 32 if m_rep == 32 else 16
+    if m_rep <= 8 and (N % 64 == 0) and (K % (bk_hi * 2) == 0):
+        gn64 = N // 64
+        sk = 4 if (gn64 * 4 <= 2 * C and (K % (bk_hi * 4) == 0)) else (2 if gn64 < int(0.85 * C) else 1)
+        if sk > 1 and (sk * bm * N * 4) <= l2 // 2:
+            return TuningSpec("1k_splitk", bm, 64, gn64, bk=bk_hi, split_k=sk, num_warps=4)
+    if (N % 32 == 0) and (K % (bk_hi * 2) == 0):
+        bn = 64 if (N // 64) >= int(0.65 * C) else 32
+        gn = N // bn
+        if gn < int(0.85 * C) and (2 * bm * N * 4) <= l2 // 2:
+            return TuningSpec("1k_splitk", bm, bn, gn, bk=bk_hi, split_k=2, num_warps=4)
+    bn = 64 if N >= 64 and (N // 64) >= int(0.65 * C) else 32
+    sc = "cvt_shm_no_pad;dot_operands_out_loop" if (N % bn == 0 and (K % bk_hi) == 0) else ""
+    return TuningSpec("nt", bm, bn, triton.cdiv(N, bn), bk=bk_hi, gm=1, num_warps=4, even_sc=sc)
