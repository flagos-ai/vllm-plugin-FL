+                    ks_f, vs_f = (pks_i32 << 16).to(tl.float32, bitcast=True), (pks_i32 & (-65536)).to(tl.float32, bitcast=True)
+                else:
+                    ks_f, vs_f = tl.load(KS + phys_page * S0 + n16 * S1 + kh * S2, mask=tmask, other=0.0), tl.load(VS + phys_page * T0 + n16 * T1 + kh * T2, mask=tmask, other=0.0)
