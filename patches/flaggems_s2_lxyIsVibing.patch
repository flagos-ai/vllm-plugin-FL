+@dataclass(frozen=True)
+class IluvatarDeviceProps:
+    """Hardware constants of Iluvatar CoreX BI-V150 (`ivcore11`, 16 CUs, warp_size=64)."""
+
+    arch_name: str = "ivcore11"
+    num_cus: int = 16
+    warp_size: int = 64
+    simds_per_cu: int = 4
+    total_simds: int = 64
+    lds_bytes_per_cu: int = 65536
+    two_cta_lds_budget: int = 32768
+    l2_bytes: int = 16 * 1024 * 1024
+    hbm_bw_gbps: float = 409.6
+    l2_bw_gbps: float = 1310.7
+    int8_tops: float = 240.0
+    bf16_tflops: float = 120.0
+    launch_overhead_us: float = 2.8
