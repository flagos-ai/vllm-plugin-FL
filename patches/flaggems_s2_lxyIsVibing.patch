+
+def _select_group_m(m: int, n: int, k: int, bm: int, bn: int, elem_bytes: int, hw: IluvatarDeviceProps) -> int:
+    """Bound L2 swizzle `group_m` so concurrent `B` wave tiles + `group_m` `A` tiles fit within 85% of 16 MiB L2."""
+    if (m + bm - 1) // bm <= 1:
+        return 4
+    if m > 512 and k >= 2 * n and n <= 2048:
+        # Tall-K skinny-N (`M > 512, K >= 2 * N, N <= 2048`): `group_m=1` sweeps all N-tiles across 2 M-tiles (<16 MiB L2).
+        return 1
+    b_wave_bytes = max(1, hw.num_cus // 8) * bn * k * elem_bytes
+    max_gm = max(1, (int(hw.l2_bytes * 0.85) - b_wave_bytes) // max(1, bm * k * elem_bytes))
+    return 8 if ((n > k or k >= 2 * n) and max_gm >= 8) else (4 if max_gm >= 4 else 1)
+
+
+def _estimate_w8a8_latency_us(
+    m: int, n: int, k: int, bm: int, bn: int, bk: int, sk: int, gm: int,
+    warps: int, stages: int, hw: IluvatarDeviceProps = DEFAULT_DEVICE_PROPS,
+) -> float:
+    """Analytical `ivcore11` W8A8 latency estimator modeling `< 32 KiB` 2-CTA/CU occupancy, warps, and Split-K."""
+    lds_bytes = stages * bk * (bm + bn)
+    if lds_bytes > hw.lds_bytes_per_cu or warps > 16 or (sk > 1 and (k % (bk * sk) != 0)):
+        return float("inf")
+    m_eff = max(m, 2)
+    # `32 KiB` SMEM runs 1 CTA/CU on `ivcore11`; strict `< 32 KiB` (`24 KiB` at `BM=32`) enables 2 CTAs/CU.
+    two_cta = (lds_bytes < hw.two_cta_lds_budget) and (warps <= 4)
+    slots = hw.num_cus * (2 if two_cta else 1)
+    warp_occ = 0.78 if (not two_cta and warps < 8) else 1.0
+    grid_m, grid_n = (m_eff + bm - 1) // bm, (n + bn - 1) // bn
+    total_ctas = grid_m * grid_n * sk
+    rounds, cu_rounds = math.ceil(total_ctas / slots), math.ceil(total_ctas / max(hw.num_cus, 1))
+    tile_eff = 0.98 if (bm >= 256 and bn >= 256) else (0.90 if (bm >= 128 and bn >= 128) else (0.80 if bn >= 128 else 0.76))
+    t_comp = (
+        2.0 * (grid_m * bm) * (grid_n * bn) * k / (hw.int8_tops * tile_eff * warp_occ * 1.0e6)
+    ) / max(grid_efficiency(total_ctas, slots), 0.05)
+    bn_dma = (0.85 if cu_rounds >= 2 else 0.72) if bn >= 128 else (0.82 if cu_rounds >= 2 else 0.56)
+    bk_dma = (1.12 if bk >= 128 else 0.92) * (1.0 if (stages >= 2 or sk >= 4) else 0.86)
+    co_res = 1.14 if two_cta else 1.0
+    tail_ctas = total_ctas - (rounds - 1) * slots
+    tail_eff = 1.0 if tail_ctas >= hw.num_cus else (0.65 + 0.35 * (tail_ctas / max(hw.num_cus, 1)))
+    sme_bw = (
+        hw.hbm_bw_gbps
+        * min(0.95, bn_dma * bk_dma)
+        * co_res
+        * warp_occ
+        * min(1.0, total_ctas / float(slots))
+        * (((rounds - 1) + tail_eff) / max(rounds, 1))
+    )
+    hbm_bytes = float(m_eff * k + n * k + (m_eff * n * 2 if sk == 1 else 0))
+    l2_reread = float(max(0, math.ceil(grid_n / max(slots, 1)) - 1) * m_eff * k + max(0, grid_m - 1) * n * k)
+    k_iters = math.ceil(k / max(1, bk * sk))
+    t_s1 = (
+        max(t_comp, (hbm_bytes / max(sme_bw * 1.0e3, 1.0)) + (l2_reread / (hw.l2_bw_gbps * 1.0e3)))
+        + 0.9 * rounds
+        + 0.22 * k_iters
+    )
+    if sk == 1:
+        return t_s1
+    part_bytes = float(sk * (grid_m * bm) * n * 4)
+    red_bw = hw.l2_bw_gbps if part_bytes <= (hw.l2_bytes * 0.75) else (hw.hbm_bw_gbps * 0.70)
+    return t_s1 + 1.8 + ((2.0 * part_bytes + m_eff * n * 2.0) / (red_bw * 1.0e3))
+
+
+def select_gemm_tuning(
+    m: int, cfg: QuantLayerConfig, epilogue_mode: int = 0, hw: IluvatarDeviceProps = DEFAULT_DEVICE_PROPS
+) -> GemmTuningConfig:
+    """Select analytical SME tile/warps/stages/split_k for `(m, cfg, epilogue_mode)`."""
+    n, k, bk, stages = cfg.shape_n, cfg.shape_k, 64, 2
+    if cfg.quant_mode == "w8a16" and m < 32:
+        return GemmTuningConfig(16, 128 if n % 128 == 0 else 64, 64, 4, 1, 1, 1) if m <= 16 else GemmTuningConfig(32, 64, 64, 2, 1, 1, 1)
+    if epilogue_mode == 2:
+        bn_sub = cfg.interleave_block_cols
+        if m <= 32 and bn_sub == 128:
+            return GemmTuningConfig(32, 128, 64, 4, 1, 1, 8)
+        if m <= 64:
+            use_bk128 = (bn_sub == 128) and (k % 128 == 0)
+            return GemmTuningConfig(64, bn_sub, 128 if use_bk128 else bk, 4, 1 if use_bk128 else stages, 1, 8)
+        bm = 128 if m <= 256 else 256
+        warps = (16 if bm >= 256 else 8) if bn_sub == 128 else 8
+        return GemmTuningConfig(bm, bn_sub, bk, warps, stages, 1, 8)
+    if epilogue_mode == 1:
+        bn_blk = cfg.interleave_block_cols
+        return GemmTuningConfig(64 if m <= 64 else (128 if m <= 256 else 256), bn_blk, bk, 4 if m <= 64 else (8 if bn_blk == 128 else 4), stages, 1, 8)
+    # Wide-N projections (`N >= 32768`):
+    # At `M <= 64`, `BM=64, BN=256, BK=64, stages=1` uses `(64 + 256) * 64 = 20 KiB` LDS
+    # (`<= 32 KiB` `two_cta_lds_budget`) with `warps=4`, unlocking 2 co-resident CTAs/CU
+    # (`32 active CTAs` across 16 CUs) to hide HBM weight-streaming latency.
+    if n >= 32768:
+        if m <= 64:
+            if n % 256 == 0:
+                return GemmTuningConfig(64, 256, bk, 4, 1, 1, 8)
+            return GemmTuningConfig(64, 128 if n % 128 == 0 else 64, bk, 4, stages, 1, 8)
+        bn = 256 if n % 256 == 0 else (128 if n % 128 == 0 else 64)
+        bm = 128 if (m <= 256 or bn == 64) else 256
+        warps = 4 if bn == 64 else (8 if (m <= 256 or bn == 128) else 16)
+        return GemmTuningConfig(bm, bn, bk, warps, stages, 1, 8)
+
+    # Small-M (`M <= 64`) general projections across arbitrary `(N, K)` aspect ratios:
+    # - For `M <= 32`, `BM=32, BN=64, BK=128, S=2` (`24 KiB < 32 KiB`) unlocks 2 CTAs/CU,
+    #   and `SK=4, S=1` (`12 KiB`) maximizes HBM concurrency on tall `K >= 4096`.
+    # - For `33 <= M <= 64`, `BM=64, BN=64, BK=128, S=2` hits `32 KiB` (1 CTA/CU), where
+    #   promoting `warps=8` fills all 4 SIMDs at 2 waves/SIMD and halves Split-K traffic (`SK=2`).
+    m_eff = max(m, 2)
+    if m <= 64:
+        cands: list[GemmTuningConfig] = []
+        for bm in ((32, 64) if m <= 32 else (64,)):
+            gm64 = _select_group_m(m_eff, n, k, bm, 64, 1, hw)
+            m_tiles = (m_eff + bm - 1) // bm
+            w_bk128 = 4 if (stages * 128 * (bm + 64) < hw.two_cta_lds_budget) else 8
+            cands.append(GemmTuningConfig(bm, 64, bk, 4, stages, 1, gm64))
+            if k % 128 == 0 and (stages * 128 * (bm + 64) <= hw.lds_bytes_per_cu):
+                cands.append(GemmTuningConfig(bm, 64, 128, w_bk128, stages, 1, gm64))
+            if n % 128 == 0:
+                gm128 = _select_group_m(m_eff, n, k, bm, 128, 1, hw)
+                if (n // 128) * m_tiles >= (hw.num_cus * 4):
+                    cands.append(GemmTuningConfig(bm, 128, bk, 4, stages, 1, gm128))
+                need_sk = (
+                    (k >= 4096 and (n // 128) * m_tiles <= (hw.num_cus * 2))
+                    or ((n // 64) * m_tiles < (hw.num_cus * 2) and k >= 2048)
+                )
+                if need_sk and (k % (bk * 4) == 0):
+                    cands.append(GemmTuningConfig(bm, 128, bk, 4, stages, 4, gm128))
+                    if bm == 32 and (k % (128 * 4) == 0):
+                        cands.append(GemmTuningConfig(32, 64, 128, 4, 1, 4, gm64))
+                emit_bn64_sk2 = need_sk and (k % (bk * 2) == 0)
+                if emit_bn64_sk2:
+                    cands.append(GemmTuningConfig(bm, 128, bk, 4, stages, 2, gm128))
+            else:
+                emit_bn64_sk2 = (k % (bk * 2) == 0) and k >= 2048 and ((n // 64) * m_tiles <= (hw.num_cus * 2))
+            if emit_bn64_sk2:
+                cands.append(GemmTuningConfig(bm, 64, bk, 4, stages, 2, gm64))
+                if k % 256 == 0:
+                    cands.append(GemmTuningConfig(bm, 64, 128, w_bk128, stages, 2, gm64))
+        return min(
+            cands,
+            key=lambda t: _estimate_w8a8_latency_us(
+                m_eff, n, k, t.block_m, t.block_n, t.block_k, t.split_k, t.group_m, t.num_warps, t.num_stages, hw
+            ),
+        )
+    if m <= 256:
+        bn = 256 if (n % 256 == 0 and m > 128) else (128 if n % 128 == 0 else 64)
+        return GemmTuningConfig(128, bn, bk, 8 if bn >= 128 else 4, stages, 1, _select_group_m(m, n, k, 128, bn, 1, hw))
+    bn = 256 if n % 256 == 0 else (128 if n % 128 == 0 else 64)
+    bm, warps = (256 if bn >= 128 else 128), (16 if bn == 256 else (8 if bn == 128 else 4))
+    return GemmTuningConfig(bm, bn, bk, warps, stages, 1, _select_group_m(m, n, k, bm, bn, 1, hw))
+
+
+def get_interval_table(cfg: QuantLayerConfig, epilogue_mode: int = 0) -> tuple[tuple[int, int, GemmTuningConfig], ...]:
+    """Return cached merged `(m_lo, m_hi, GemmTuningConfig)` intervals for `(cfg, epilogue_mode)`."""
+    key = (cfg.shape_n, cfg.shape_k, cfg.quant_mode, cfg.col_layout, epilogue_mode)
+    if (cached := _INTERVAL_CACHE.get(key)) is not None:
+        return cached
+    res = merge_m_intervals(
+        lambda m_val: select_gemm_tuning(m_val, cfg, epilogue_mode),
+        sample_points=(8, 9, 16, 17, 31, 32, 33, 64, 65, 128, 129, 256, 257, 512, 513, 16384),
+    )
+    _INTERVAL_CACHE[key] = res
+    return res
+
+
+@functools.lru_cache(maxsize=256)
+def _cached_layer_cfg(n: int, k: int, quant_mode: str, col_layout: str) -> QuantLayerConfig:
+    """Memoize lightweight `QuantLayerConfig` keys used by `lookup_gemm_tuning`."""
+    return QuantLayerConfig(shape_n=n, shape_k=k, quant_mode=quant_mode, hadamard_bs=0, col_layout=col_layout)
+
+
+def get_gemm_tuning(m: int, cfg: QuantLayerConfig, epilogue_mode: int = 0) -> GemmTuningConfig:
+    """Look up the analytical `GemmTuningConfig` for batch size `m` via the M-interval table."""
+    for m_lo, m_hi, tuning in get_interval_table(cfg, epilogue_mode):
+        if m_lo <= m <= m_hi:
+            return tuning
+    return select_gemm_tuning(m, cfg, epilogue_mode)
+
+
+def lookup_gemm_tuning(m: int, n: int, k: int, quant_mode: str = "w8a8", epilogue_mode: int = 0) -> GemmTuningConfig:
+    """Look up analytical GEMM tuning directly from `(m, n, k, quant_mode, epilogue_mode)`."""
+    return get_gemm_tuning(m, _cached_layer_cfg(n, k, quant_mode, "interleaved_64" if epilogue_mode in (1, 2) else "contiguous"), epilogue_mode)
+
