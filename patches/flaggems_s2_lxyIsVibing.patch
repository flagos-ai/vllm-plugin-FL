+    """Carve zero-copy `(k_scale, v_scale, packed_i32)` views from the 128B-aligned KV scale tail.
+
+    Falls back to standalone FP32 scale tensors when `kv_cache` storage lacks tail capacity.
+    """
+    raw = kv_cache.untyped_storage()
+    tail_bytes = compute_bf16x2_page_tail_bytes(block_size, nkv)
+    if block_size % 16 == 0 and int(kv_cache.storage_offset()) == 0 and raw.nbytes() >= data_bytes + num_blocks * tail_bytes:
