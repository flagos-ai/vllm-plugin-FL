+# ==============================================================================
+# Kernel 4: Stage-2 Col-Major Dual-SME (`use_sme=39`) Mixed / Prefill Kernel
+#   - Transposes the FlashAttention recurrence into Col-Major `ChainDot` form:
+#     `s_t = K @ Q^T` (`[N, M]`) and `acc_t = V^T @ P^T` (`[D, M]`), aligning `M`
+#     (`qrows * EFF_GQA`) with `ivcore11` Dual-SME's wide output columns (`use_sme=39`).
+#   - Longest-Processing-Time (LPT) Reverse Causal Scheduling: reverses both `local_slot`
+#     (`(num_programs(1) - 1) - program_id(1)`) and `qblock` (`(num_qb - 1 - idx) * qrows_step`)
+#     so the heaviest causal prefix tiles launch in the first wave across the 16 CUs while
+#     short causal tiles pack into the tail waves, eliminating causal tail stragglers.
+# ==============================================================================
+@triton.jit
+def paged_gqa_stage2_colmajor_sme_tle_kernel(
+    Q, K_CONTIG, V_CONTIG, CU, LEN, O, NSEQS, TOTAL_Q, SLOT_OFFSET, SM_SCALE_LOG2E, SEQ_HINT=-1,
+    QS: tl.constexpr = 2048, QH: tl.constexpr = 128, QD: tl.constexpr = 1, CUS: tl.constexpr = 1, LS: tl.constexpr = 1,
+    KV_STRIDE: tl.constexpr = 16640, NHEADS: tl.constexpr = 16, NKV: tl.constexpr = 2, GQA: tl.constexpr = 8, D: tl.constexpr = 128,
+    M: tl.constexpr = 128, N: tl.constexpr = 64,
+    FILTER: tl.constexpr = 1, PRECISE: tl.constexpr = False, NO_ZERO_LEN: tl.constexpr = False, PADDED_GQA: tl.constexpr = 0,
+):
+    """Stage-2 Col-Major Dual-SME (`use_sme=39`) FlashAttention over contiguous BF16 KV scratch."""
+    EFF_GQA: tl.constexpr = GQA if PADDED_GQA == 0 else PADDED_GQA
+    sh = tl.program_id(0)
+    local_slot = (tl.num_programs(1) - 1) - tl.program_id(1)
+    kh, idx = sh % NKV, sh // NKV
+    qrows_step: tl.constexpr = M // EFF_GQA
+    kv_dtype: tl.constexpr = K_CONTIG.dtype.element_ty
+
+    seq, begin, qlen = _locate_prefill_seq_hint(CU, NSEQS, SLOT_OFFSET + local_slot, SEQ_HINT, CUS, FILTER, NO_ZERO_LEN)
+    if seq < 0:
+        return
+    num_qb = tl.cdiv(qlen, qrows_step)
+    if idx >= num_qb:
+        return
+    qblock = (num_qb - 1 - idx) * qrows_step
+
+    length, r = tl.load(LEN + seq * LS), tl.arange(0, M)
+    qi, gqa_lane = qblock + r // EFF_GQA, r % EFF_GQA
+    h = kh * GQA + gqa_lane
+    valid = (qi < qlen) & (begin + qi < TOTAL_Q) if EFF_GQA == GQA else (gqa_lane < GQA) & (qi < qlen) & (begin + qi < TOTAL_Q)
+    d, n = tl.arange(0, D), tl.arange(0, N)
+
+    qt_raw = tl.load(Q + (begin + qi[None, :]) * QS + h[None, :] * QH + d[:, None] * QD, valid[None, :], 0)
+    if PRECISE and kv_dtype == tl.float16:
+        qt32 = qt_raw.to(tl.float32)
+        qmax = tl.max(tl.abs(qt32), 0)
+        qnorm = tl.where(qmax > 256.0, (qmax.to(tl.uint32, bitcast=True) & 0x7F800000).to(tl.float32, bitcast=True), 1.0)
+        q_t_init, q_scale = (qt32 / qnorm[None, :]).to(kv_dtype), (SM_SCALE_LOG2E * qnorm)[None, :]
+    else:
+        q_t_init = (qt_raw.to(tl.float32) * SM_SCALE_LOG2E).to(kv_dtype)
+
+    end = tl.minimum(length, length - qlen + tl.minimum(qblock + qrows_step, qlen))
+    mx, den, acc_t = tl.full((M,), -float("inf"), tl.float32), tl.zeros((M,), tl.float32), tl.zeros((D, M), tl.float32)
+    slot_offset = (local_slot * NKV + kh) * (KV_STRIDE * D)
+    K_base, V_base = K_CONTIG + slot_offset, V_CONTIG + slot_offset
+
+    full_tiles = tl.minimum(end, tl.maximum(0, length - qlen + qblock + 1)) // N
+    full_end = full_tiles * N
+    rd, rn0 = tl.max_contiguous(tl.multiple_of(d, D), D), tl.max_contiguous(tl.multiple_of(n, N), N)
+    kp, vtp = K_base + rn0[:, None] * D + rd[None, :], V_base + rd[:, None] + rn0[None, :] * D
+
+    for _ in range(0, full_tiles):
+        s_t = tl.dot(tl.load(kp), q_t_init, out_dtype=tl.float32, allow_tf32=True)
+        if PRECISE and kv_dtype == tl.float16:
+            s_t = s_t * q_scale
+        nm = tl.maximum(mx, tl.max(s_t, 0))
+        a, p_t = tl.exp2(mx - nm), tl.exp2(s_t - nm[None, :])
+        den = den * a + tl.sum(p_t, 0)
+        acc_t = tl.dot(tl.load(vtp), p_t.to(kv_dtype), acc_t * a[None, :], out_dtype=tl.float32, allow_tf32=True)
+        mx = nm
+        kp += N * D
+        vtp += N * D
+
+    last_tok = tl.maximum(0, end - 1)
+    for start in range(full_end, end, N):
+        tok_k = tl.minimum(start + n, last_tok)
+        s_t = tl.dot(tl.load(K_base + tok_k[:, None] * D + d[None, :]), q_t_init, out_dtype=tl.float32, allow_tf32=True)
+        if PRECISE and kv_dtype == tl.float16:
+            s_t = s_t * q_scale
+        s_t = tl.where((start + n)[:, None] <= tl.minimum(end - 1, length - qlen + qi)[None, :], s_t, -float("inf"))
+        nm = tl.maximum(mx, tl.max(s_t, 0))
+        safe = tl.where(nm == -float("inf"), 0.0, nm)
+        a, p_t = tl.exp2(mx - safe), tl.exp2(s_t - safe[None, :])
+        den = den * a + tl.sum(p_t, 0)
+        tok_v = tl.minimum(start + n, last_tok)
+        acc_t = tl.dot(tl.load(V_base + d[:, None] + tok_v[None, :] * D), p_t.to(kv_dtype), acc_t * a[None, :], out_dtype=tl.float32, allow_tf32=True)
+        mx = nm
+
+    inv_den = 1.0 / tl.where(den > 0, den, 1.0)
+    tl.store(O + (begin + qi)[:, None] * (NHEADS * D) + h[:, None] * D + d[None, :], tl.trans(acc_t * inv_den[None, :]).to(O.dtype.element_ty), valid[:, None])
+
+
+# ==============================================================================
+# Kernel 5: Column-Wise INT8 Q^T Pre-Quantization & BOS-Free Body K-Scale Extraction
+#   - Emits `[D, M]` INT8 `Q^T` tiles in reverse-LPT `qblock` order matching Stage-2 Hybrid.
+#   - Computes per-head `ks_body` over `pages >= 4` (`tokens >= 64`), excluding BOS spike pages.
+# ==============================================================================
+@triton.jit
+def paged_gqa_prequant_q_kscale_kernel(
+    Q, KS, BT, CU, LEN, QT_OUT, QS_OUT, KS_PARTIAL_OUT,
+    NSEQS, TOTAL_Q, SLOT_OFFSET, MAX_QB, SM_SCALE_LOG2E, SEQ_HINT=-1,
+    QS: tl.constexpr = 2048, QH: tl.constexpr = 128, QD: tl.constexpr = 1,
+    CUS: tl.constexpr = 1, LS: tl.constexpr = 1, BTS: tl.constexpr = 1, BTC: tl.constexpr = 1,
+    S0: tl.constexpr = 0, S1: tl.constexpr = 0, S2: tl.constexpr = 0,
+    NKV: tl.constexpr = 2, GQA: tl.constexpr = 8, D: tl.constexpr = 128, M: tl.constexpr = 256,
+    KS_SPLITS: tl.constexpr = 8,
+    FILTER: tl.constexpr = 1, PACKED_BF16X2_SCALE: tl.constexpr = True,
+    WIDE_KV: tl.constexpr = False, NO_ZERO_LEN: tl.constexpr = False, PADDED_GQA: tl.constexpr = 0,
+):
+    """Pre-quantize `Q^T` (`SUB_M=128`) and extract partial BOS-free `ks_body` max scales."""
+    pid0, local_slot = tl.program_id(0), tl.program_id(1)
+    seq, begin, qlen = _locate_prefill_seq_hint(CU, NSEQS, SLOT_OFFSET + local_slot, SEQ_HINT, CUS, FILTER, NO_ZERO_LEN)
+    if seq < 0:
+        return
+    length = tl.load(LEN + seq * LS)
+
+    KS_CTAS: tl.constexpr = NKV * KS_SPLITS
+    if pid0 < KS_CTAS:
+        kh, sp = pid0 % NKV, pid0 // NKV
+        slot_kh = local_slot * NKV + kh
+        num_pages = tl.cdiv(length, 16)
+        body_pages = tl.maximum(num_pages - 4, 0)
+        pages_per_sp = tl.cdiv(body_pages, KS_SPLITS)
+        p_start = 4 + sp * pages_per_sp
+        p_end = tl.minimum(num_pages, p_start + pages_per_sp)
+
+        bmax = tl.zeros((256,), tl.float32)
+        t256 = tl.arange(0, 256)
+        p_off, slot16 = t256 >> 4, t256 & 15
+        bt_seq_ptr = BT + seq * BTS
+        for base_p in range(p_start, p_end, 16):
+            p_idx = base_p + p_off
+            m = (p_idx < p_end) & ((base_p * 16 + t256) < length)
+            phys_page = tl.load(bt_seq_ptr + tl.minimum(p_idx, tl.maximum(num_pages - 1, 0)) * BTC, mask=m, other=0)
+            if WIDE_KV:
+                phys_page = phys_page.to(tl.int64)
+            if PACKED_BF16X2_SCALE:
+                raw = tl.load(KS + phys_page * S0 + slot16 * S1 + kh * S2, mask=m, other=0)
+                ks_f = (raw << 16).to(tl.float32, bitcast=True)
+            else:
+                ks_f = tl.load(KS + phys_page * S0 + slot16 * S1 + kh * S2, mask=m, other=0.0).to(tl.float32)
+            bmax = tl.maximum(bmax, tl.abs(ks_f))
+        tl.store(KS_PARTIAL_OUT + slot_kh * KS_SPLITS + sp, tl.maximum(tl.max(bmax, 0), 1e-12))
+        return
+
+    SUB_M: tl.constexpr = 128 if M >= 128 else M
+    SUBS_PER_TILE: tl.constexpr = M // SUB_M
+    sub_global = pid0 - KS_CTAS
+    kh, tile_sub = sub_global % NKV, sub_global // NKV
+    idx, sub_id = tile_sub // SUBS_PER_TILE, tile_sub % SUBS_PER_TILE
+
+    EFF_GQA: tl.constexpr = GQA if PADDED_GQA == 0 else PADDED_GQA
+    qrows_step: tl.constexpr = M // EFF_GQA
+    num_qb = tl.cdiv(qlen, qrows_step)
+    if idx >= num_qb:
+        return
+    qblock = (num_qb - 1 - idx) * qrows_step
+
+    tile_id = (local_slot * NKV + kh) * MAX_QB + idx
+    r_sub = tl.max_contiguous(tl.multiple_of(tl.arange(0, SUB_M), SUB_M), SUB_M)
+    r = sub_id * SUB_M + r_sub
+    qi, gqa_lane = qblock + r // EFF_GQA, r % EFF_GQA
+    h = kh * GQA + gqa_lane
+    valid = (qi < qlen) & (begin + qi < TOTAL_Q) if EFF_GQA == GQA else (gqa_lane < GQA) & (qi < qlen) & (begin + qi < TOTAL_Q)
+    d = tl.max_contiguous(tl.multiple_of(tl.arange(0, D), D), D)
+    q_f32 = tl.load(Q + (begin + qi[:, None]) * QS + h[:, None] * QH + d[None, :] * QD, mask=valid[:, None], other=0.0).to(tl.float32)
+    q_amax = tl.maximum(tl.max(tl.abs(q_f32), 1), 1e-12)
+    q_i8 = _clamp_f32(_rint_f32(q_f32 * (127.0 / q_amax)[:, None]), -127.0, 127.0).to(tl.int8)
+    tl.store(QT_OUT + tile_id * (D * M) + sub_id * SUB_M + d[:, None] * M + r_sub[None, :], tl.trans(q_i8))
+    tl.store(QS_OUT + tile_id * M + r, (q_amax * (1.0 / 127.0)) * SM_SCALE_LOG2E)
+
+
+# ==============================================================================
+# Kernel 6: Stage-1 Hybrid KV Gather (Lossless Sink-64 INT8 K + Body-Rescaled INT8 K + BF16 V)
+#   - Reduces `KS_PARTIAL[KS_SPLITS]` -> `ks_body` (`KS_BODY_OUT`) in registers.
+#   - Copies raw `INT8 K` + per-token `KS_SINK[64]` losslessly for `tokens < 64` (`page_idx < 4`).
+#   - Rescales `tokens >= 64` `INT8 K` by `1 / ks_body` into uniform body scale & unpacks `BF16 V`.
+# ==============================================================================
+@triton.jit
+def paged_gqa_stage1_gather_hybrid_kv_kernel(
+    K, V, KS, VS, BT, CU, LEN, K_OUT, V_OUT, KS_SINK, KS_PARTIAL, KS_BODY_OUT, NSEQS, SLOT_OFFSET, SEQ_HINT=-1,
+    CUS: tl.constexpr = 1, LS: tl.constexpr = 1, BTS: tl.constexpr = 1, BTC: tl.constexpr = 1,
+    K0: tl.constexpr = 0, K1: tl.constexpr = 0, K2: tl.constexpr = 0, K3: tl.constexpr = 1,
+    V0: tl.constexpr = 0, V1: tl.constexpr = 1, V2: tl.constexpr = 0, V3: tl.constexpr = 1,
+    S0: tl.constexpr = 0, S1: tl.constexpr = 0, S2: tl.constexpr = 0, T0: tl.constexpr = 0, T1: tl.constexpr = 0, T2: tl.constexpr = 0,
+    KV_STRIDE: tl.constexpr = 16640, NKV: tl.constexpr = 2, D: tl.constexpr = 128,
+    PAGES_PER_CTA: tl.constexpr = 4, KS_SPLITS: tl.constexpr = 8, FLAGS: tl.constexpr = 0,
+):
+    """Stage-1 hybrid gather emitting lossless Sink-64/rescaled-body INT8 `K` and BF16 `V` scratch."""
+    FILTER: tl.constexpr = FLAGS & 7
+    PACKED_BF16X2_SCALE: tl.constexpr = (FLAGS & 8) != 0
+    WIDE_KV: tl.constexpr = (FLAGS & 16) != 0
+    USE_K8V4: tl.constexpr = (FLAGS & 32) != 0
+    NO_ZERO_LEN: tl.constexpr = (FLAGS & 64) != 0
+
+    pid_blk, kh, local_slot = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    seq, _, _ = _locate_prefill_seq_hint(CU, NSEQS, SLOT_OFFSET + local_slot, SEQ_HINT, CUS, FILTER, NO_ZERO_LEN)
+    if seq < 0:
+        return
+    length = tl.load(LEN + seq * LS)
+    num_pages, base_page = tl.cdiv(length, 16), pid_blk * PAGES_PER_CTA
+    if length <= 0 or base_page >= num_pages:
+        return
+
+    out_dtype: tl.constexpr = V_OUT.dtype.element_ty
+    D_HALF: tl.constexpr = D // 2
+    slot_kh = local_slot * NKV + kh
+    slot_base = slot_kh * (KV_STRIDE * D)
+    ks_body = tl.max(tl.load(KS_PARTIAL + slot_kh * KS_SPLITS + tl.arange(0, KS_SPLITS)), 0)
+    if pid_blk == 0:
+        tl.store(KS_BODY_OUT + slot_kh, ks_body)
+    inv_ks_body = 1.0 / ks_body
+
+    if USE_K8V4 and V1 == 1:
+        k_dst_base, v_dst_base = K_OUT + slot_base, V_OUT + slot_base
+        ks_sink_base = KS_SINK + slot_kh * 64
+        n16, d, d_half, c4 = tl.arange(0, 16), tl.arange(0, D), tl.arange(0, D_HALF), tl.full((), 4, tl.int8)
+        bt_seq_ptr = BT + seq * BTS
+        for p in range(0, PAGES_PER_CTA):
+            page_idx = base_page + p
+            if page_idx < num_pages:
+                phys_page = tl.load(bt_seq_ptr + page_idx * BTC)
+                if WIDE_KV:
+                    phys_page = phys_page.to(tl.int64)
+                tok_offs = page_idx * 16 + n16
+                tmask = tok_offs < length
+                k_i8 = tl.load(K + phys_page * K0 + n16[:, None] * K1 + kh * K2 + d[None, :] * K3, mask=tmask[:, None], other=0)
+                if PACKED_BF16X2_SCALE:
+                    pks_i32 = tl.load(KS + phys_page * S0 + n16 * S1 + kh * S2, mask=tmask, other=0)
+                    ks_f, vs_f = (pks_i32 << 16).to(tl.float32, bitcast=True), (pks_i32 & (-65536)).to(tl.float32, bitcast=True)
+                else:
+                    ks_f, vs_f = tl.load(KS + phys_page * S0 + n16 * S1 + kh * S2, mask=tmask, other=0.0), tl.load(VS + phys_page * T0 + n16 * T1 + kh * T2, mask=tmask, other=0.0)
+                if page_idx < 4:
+                    tl.store(k_dst_base + tok_offs[:, None] * D + d[None, :], k_i8, mask=tmask[:, None])
+                    tl.store(ks_sink_base + page_idx * 16 + n16, ks_f, mask=tmask)
+                else:
+                    k_rescaled = _clamp_f32(_rint_f32(k_i8.to(tl.float32) * (ks_f[:, None] * inv_ks_body)), -127.0, 127.0).to(tl.int8)
+                    tl.store(k_dst_base + tok_offs[:, None] * D + d[None, :], k_rescaled, mask=tmask[:, None])
+                v_pk = tl.trans(tl.load(V + phys_page * V0 + n16[None, :] * V1 + kh * V2 + d_half[:, None] * V3, mask=tmask[None, :], other=0))
+                v_fp = tl.zeros((16, D), out_dtype)
+                v_fp = tle.insert_tile(v_fp, (((v_pk << c4) >> c4).to(tl.float32) * vs_f[:, None]).to(out_dtype), [0, 0])
+                v_fp = tle.insert_tile(v_fp, ((v_pk >> c4).to(tl.float32) * vs_f[:, None]).to(out_dtype), [0, 1])
+                tl.store(v_dst_base + tok_offs[:, None] * D + d[None, :], v_fp, mask=tmask[:, None])
+    else:
+        d, t = tl.arange(0, D), tl.arange(0, PAGES_PER_CTA * 16)
+        out_tok, p_idx, slot = base_page * 16 + t, base_page + (t >> 4), t & 15
+        p_valid = out_tok < length
+        phys_page = tl.load(BT + seq * BTS + tl.minimum(p_idx, num_pages - 1) * BTC)
+        if WIDE_KV:
+            phys_page = phys_page.to(tl.int64)
+        k_i8 = tl.load(K + phys_page[:, None] * K0 + slot[:, None] * K1 + kh * K2 + d[None, :] * K3, mask=p_valid[:, None], other=0)
+        if USE_K8V4:
+            v_pk = tl.load(V + phys_page[:, None] * V0 + slot[:, None] * V1 + kh * V2 + (d % D_HALF)[None, :] * V3, mask=p_valid[:, None], other=0).to(tl.int32)
+            v_i8 = tl.where((d >= D_HALF)[None, :], v_pk >> 4, (v_pk << 28) >> 28)
+        else:
+            v_i8 = tl.load(V + phys_page[:, None] * V0 + slot[:, None] * V1 + kh * V2 + d[None, :] * V3, mask=p_valid[:, None], other=0)
+        if PACKED_BF16X2_SCALE:
+            ks_i32 = tl.load(KS + phys_page * S0 + slot * S1 + kh * S2, mask=p_valid, other=0)
+            ks_f, vs_f = (ks_i32 << 16).to(tl.float32, bitcast=True), (ks_i32 & (-65536)).to(tl.float32, bitcast=True)
+        else:
+            ks_f, vs_f = tl.load(KS + phys_page * S0 + slot * S1 + kh * S2, mask=p_valid, other=0.0), tl.load(VS + phys_page * T0 + slot * T1 + kh * T2, mask=p_valid, other=0.0)
+        is_sink_tok = out_tok < 64
+        k_rescaled = _clamp_f32(_rint_f32(k_i8.to(tl.float32) * (ks_f[:, None] * inv_ks_body)), -127.0, 127.0).to(tl.int8)
+        k_out_i8 = tl.where(is_sink_tok[:, None], k_i8, k_rescaled)
+        v_fp = (v_i8.to(tl.float32) * vs_f[:, None]).to(out_dtype)
+        base_out = slot_base + out_tok[:, None] * D + d[None, :]
+        tl.store(K_OUT + base_out, k_out_i8, mask=p_valid[:, None])
+        tl.store(V_OUT + base_out, v_fp, mask=p_valid[:, None])
+        tl.store(KS_SINK + slot_kh * 64 + tl.minimum(out_tok, 63), ks_f, mask=p_valid & is_sink_tok)
+
+
+# ==============================================================================
+# Kernel 7: Stage-2 Hybrid INT8 K@Q^T + Register-Direct BF16 V^T@P^T Dual-Stage SME (use_sme=7, num_stages=2)
+#   - LinearLayout `ChainDotKRotate` (`kRotate=1`) register pass-through eliminates `ml_slb_store_b8`.
+#   - Host-sliced `K_I8_OFF64` / `V_BF16_OFF64` preserve 2D SME backward stride analysis.
+#   - Hoisted `qk_body = q_scale * ks_body` avoids `num_stages=2` Loop-1 scale barriers.
+#   - Loop 2 uses branchless `start == 0` selection for lossless Sink-64 + causal tail tiles.
+# ==============================================================================
+@triton.jit
+def paged_gqa_stage2_hybrid_colmajor_sme_kernel(
+    QT, QS_PTR, K_CONTIG, K_I8_OFF64, V_CONTIG, V_BF16_OFF64, KS_SINK, KS_BODY,
+    CU, LEN, O, NSEQS, TOTAL_Q, SLOT_OFFSET, SEQ_HINT=-1,
+    CUS: tl.constexpr = 1, LS: tl.constexpr = 1, KV_STRIDE: tl.constexpr = 16640,
+    NHEADS: tl.constexpr = 16, NKV: tl.constexpr = 2, GQA: tl.constexpr = 8, D: tl.constexpr = 128,
+    M: tl.constexpr = 256, N: tl.constexpr = 64,
+    FILTER: tl.constexpr = 1, NO_ZERO_LEN: tl.constexpr = False, PADDED_GQA: tl.constexpr = 0,
+):
+    """Stage-2 Hybrid Dual-SME (`use_sme=7`) prefill kernel with INT8 `K @ Q^T` and BF16 `V^T @ P^T`."""
+    EFF_GQA: tl.constexpr = GQA if PADDED_GQA == 0 else PADDED_GQA
+    sh = tl.program_id(0)
+    local_slot = (tl.num_programs(1) - 1) - tl.program_id(1)
+    kh, idx = sh % NKV, sh // NKV
+    qrows_step: tl.constexpr = M // EFF_GQA
+    max_qb = tl.num_programs(0) // NKV
+
+    seq, begin, qlen = _locate_prefill_seq_hint(CU, NSEQS, SLOT_OFFSET + local_slot, SEQ_HINT, CUS, FILTER, NO_ZERO_LEN)
+    if seq < 0:
+        return
+    num_qb = tl.cdiv(qlen, qrows_step)
+    if idx >= num_qb:
+        return
+    qblock = (num_qb - 1 - idx) * qrows_step
+    length = tl.load(LEN + seq * LS)
+
+    slot_kh = local_slot * NKV + kh
+    tile_id = slot_kh * max_qb + idx
+    r, d, n = tl.arange(0, M), tl.arange(0, D), tl.arange(0, N)
+    qi, gqa_lane = qblock + r // EFF_GQA, r % EFF_GQA
+    h = kh * GQA + gqa_lane
+    valid = (qi < qlen) & (begin + qi < TOTAL_Q) if EFF_GQA == GQA else (gqa_lane < GQA) & (qi < qlen) & (begin + qi < TOTAL_Q)
+
+    rd = tl.max_contiguous(tl.multiple_of(d, D), D)
+    rm = tl.max_contiguous(tl.multiple_of(r, M), M)
+    qt_i8 = tl.load(QT + tile_id * (D * M) + rd[:, None] * M + rm[None, :])
+    q_scale = tl.load(QS_PTR + tile_id * M + rm)
+    ks_body = tl.load(KS_BODY + slot_kh)
+    qk_body = q_scale * ks_body
+
+    end = tl.maximum(0, tl.minimum(length, length - qlen + tl.minimum(qblock + qrows_step, qlen)))
+    mx = tl.full((M,), -float("inf"), tl.float32)
+    den = tl.zeros((M,), tl.float32)
+    acc_t = tl.zeros((D, M), tl.float32)
+
+    slot_offset = slot_kh * (KV_STRIDE * D)
+    full_tiles = tl.minimum(end, tl.maximum(0, length - qlen + qblock + 1)) // N
+    rn0 = tl.max_contiguous(tl.multiple_of(n, N), N)
+    kp = K_I8_OFF64 + slot_offset + rn0[:, None] * D + rd[None, :]
+    vtp = V_BF16_OFF64 + slot_offset + rd[:, None] + rn0[None, :] * D
+
+    for _ in range(1, full_tiles):
+        s_i32 = tl.dot(tl.load(kp), qt_i8, out_dtype=tl.int32)
+        nm = tl.maximum(mx, tl.max(s_i32, 0).to(tl.float32) * qk_body)
+        neg_nm = -nm
+        a = tl.exp2(mx + neg_nm)
+        p_t = tl.exp2(tl.math.fma(s_i32.to(tl.float32), qk_body[None, :], neg_nm[None, :]))
+        den = den * a + tl.sum(p_t, 0)
+        acc_t = tl.dot(tl.load(vtp), p_t.to(tl.bfloat16), acc_t * a[None, :], out_dtype=tl.float32, allow_tf32=True)
+        mx = nm
+        kp += N * D
+        vtp += N * D
+
+    has_sink = tl.where(full_tiles >= 1, 1, 0)
+    full_end = full_tiles * N
+    tail_tiles = tl.cdiv(tl.maximum(0, end - full_end), N)
+    total_bdy = has_sink + tail_tiles
+    last_tok = tl.maximum(0, end - 1)
+    qi_lim = tl.minimum(last_tok, length - qlen + qi)
+    K_base, V_base = K_CONTIG + slot_offset, V_CONTIG + slot_offset
+    KS_sink_base = KS_SINK + slot_kh * 64
+
+    for bi in range(0, total_bdy):
+        is_sink = bi < has_sink
+        start = tl.where(is_sink, 0, full_end + (bi - has_sink) * N)
+        tok = tl.minimum(start + n, last_tok)
+        s_i32 = tl.dot(tl.load(K_base + tok[:, None] * D + rd[None, :]), qt_i8, out_dtype=tl.int32)
+        ks_vec = tl.where(start == 0, tl.load(KS_sink_base + tl.minimum(tok, 63)), ks_body)
+        s_t = (s_i32.to(tl.float32) * ks_vec[:, None]) * q_scale[None, :]
+        s_t = tl.where(is_sink | ((start + n)[:, None] <= qi_lim[None, :]), s_t, -float("inf"))
+        nm = tl.maximum(mx, tl.max(s_t, 0))
+        safe = tl.where(nm == -float("inf"), 0.0, nm)
+        a, p_t = tl.exp2(mx - safe), tl.exp2(s_t - safe[None, :])
+        den = den * a + tl.sum(p_t, 0)
+        acc_t = tl.dot(tl.load(V_base + rd[:, None] + tok[None, :] * D), p_t.to(tl.bfloat16), acc_t * a[None, :], out_dtype=tl.float32, allow_tf32=True)
+        mx = nm
+
+    inv_den = 1.0 / tl.where(den > 0, den, 1.0)
+    tl.store(O + (begin + qi)[:, None] * (NHEADS * D) + h[:, None] * D + rd[None, :], tl.trans((acc_t * inv_den[None, :]).to(O.dtype.element_ty)), valid[:, None])
+
+
+# ==============================================================================
+# Kernel 8: Unified Pure-TLE Split-KV LSE Merge Kernel
+# ==============================================================================
+@triton.jit
+def paged_gqa_splitk_merge_tle_kernel(
+    PA, PM, PL, OUT_PTR, CU_PTR, NSEQS, TOTAL_Q,
+    STRIDE_CU: tl.constexpr, STRIDE_O_TOK: tl.constexpr, STRIDE_O_HEAD: tl.constexpr,
+    SPLITS: tl.constexpr, NHEADS: tl.constexpr, D: tl.constexpr, FILTER_DECODE_ONLY: tl.constexpr = False,
+):
+    """Merge `SPLITS` partial attention accumulators `(PA, PM, PL)` via online log-sum-exp."""
+    D_HALF: tl.constexpr = D // 2
+    row_id, h = tl.program_id(0), tl.program_id(1)
+    active_tokens = tl.load(CU_PTR + NSEQS * STRIDE_CU).to(tl.int64)
+    if FILTER_DECODE_ONLY:
+        q_start = tl.load(CU_PTR + row_id * STRIDE_CU).to(tl.int64)
+        if (tl.load(CU_PTR + (row_id + 1) * STRIDE_CU).to(tl.int64) - q_start) != 1 or (q_start >= active_tokens) or (q_start >= TOTAL_Q):
+            return
+        out_tok_idx = q_start
+    else:
+        if (row_id >= active_tokens) or (row_id >= TOTAL_Q):
+            return
+        out_tok_idx = row_id.to(tl.int64)
+
+    sp, d = tl.arange(0, SPLITS), tl.arange(0, D)
+    ix = (row_id * SPLITS + sp) * NHEADS + h
+    m, denominator = tl.load(PM + ix), tl.load(PL + ix)
+    mm = tl.max(m, 0)
+    safe = tl.where(mm == -float("inf"), 0.0, mm)
+    a = tl.where(denominator > 0, tl.exp2(m - safe), 0.0)
+    total = tl.sum(a * denominator, 0)
+    part = tl.load(PA + ix[:, None] * D + d[None, :], denominator[:, None] > 0, 0.0)
+    w = (a * (1.0 / tl.where(total > 0, total, 1.0)))[:, None]
+    out_lo = tl.sum(tle.extract_tile(part, [0, 0], [SPLITS, D_HALF]) * w, 0).to(OUT_PTR.dtype.element_ty)
+    out_hi = tl.sum(tle.extract_tile(part, [0, 1], [SPLITS, D_HALF]) * w, 0).to(OUT_PTR.dtype.element_ty)
+    out_2d = tl.zeros((1, D), OUT_PTR.dtype.element_ty)
+    out_2d = tle.insert_tile(out_2d, tl.reshape(out_lo, (1, D_HALF)), [0, 0])
+    out_2d = tle.insert_tile(out_2d, tl.reshape(out_hi, (1, D_HALF)), [0, 1])
+    tl.store(OUT_PTR + out_tok_idx * STRIDE_O_TOK + h * STRIDE_O_HEAD + d, tl.reshape(out_2d, (D,)))
+
+
+# ==============================================================================
+# Kernel 9: Fused Pure-TLE Split-KV LSE Merge + Per-Token INT8 Quantization
+#   - Directly emits `(OUT_Q_PTR, OUT_S_PTR)` after exact BF16/FP16 rounding for the
+#     downstream `o_proj` W8A8 GEMM, eliminating an intermediate BF16 round-trip and launch.
+# ==============================================================================
+@triton.jit
+def paged_gqa_splitk_merge_quant_tle_kernel(
+    PA, PM, PL, OUT_Q_PTR, OUT_S_PTR, CU_PTR, NSEQS, TOTAL_Q,
+    STRIDE_CU: tl.constexpr, SPLITS: tl.constexpr, NHEADS: tl.constexpr, D: tl.constexpr, OUT_DTYPE_BF16: tl.constexpr = True,
+):
+    """Fused Split-KV LSE merge + per-token symmetric INT8 quantization for downstream `o_proj`."""
+    row_id = tl.program_id(0)
+    active_tokens = tl.load(CU_PTR + NSEQS * STRIDE_CU).to(tl.int64)
+    if row_id >= active_tokens:
+        if row_id < TOTAL_Q:
+            cols = tl.arange(0, NHEADS * D)
+            tl.store(OUT_Q_PTR + row_id.to(tl.int64) * (NHEADS * D) + cols, tl.zeros((NHEADS * D,), tl.int8))
+            tl.store(OUT_S_PTR + row_id, 1e-12)
+        return
+    if row_id >= TOTAL_Q:
+        return
+
+    sp, h = tl.arange(0, SPLITS), tl.arange(0, NHEADS)
+    ix = (row_id * SPLITS + sp[:, None]) * NHEADS + h[None, :]
+    m, denom = tl.load(PM + ix), tl.load(PL + ix)
+    mm = tl.max(m, 0)
+    safe = tl.where(mm == -float("inf"), 0.0, mm)
+    a = tl.where(denom > 0, tl.exp2(m - safe[None, :]), 0.0)
+    total = tl.sum(a * denom, 0)
+    w = a * (1.0 / tl.where(total > 0, total, 1.0))[None, :]
+
+    hd_offs = tl.arange(0, NHEADS * D)
+    pa_base = PA + (row_id.to(tl.int64) * SPLITS) * (NHEADS * D)
+    part_mask = tl.reshape(tl.broadcast_to((denom > 0)[:, :, None], (SPLITS, NHEADS, D)), (SPLITS, NHEADS * D))
+    part = tl.load(pa_base + sp[:, None] * (NHEADS * D) + hd_offs[None, :], mask=part_mask, other=0.0)
+    w_hd = tl.reshape(tl.broadcast_to(w[:, :, None], (SPLITS, NHEADS, D)), (SPLITS, NHEADS * D))
+    merged_exact = tl.sum(part * w_hd, 0).to(tl.bfloat16 if OUT_DTYPE_BF16 else tl.float16).to(tl.float32)
+
+    amax = tl.max(tl.abs(merged_exact), axis=0)
+    inv_s = tl.where(amax > 0.0, 127.0 / amax, 0.0)
+    tl.store(OUT_S_PTR + row_id, tl.maximum(amax * (1.0 / 127.0), 1e-12))
+    q = _clamp_f32(_rint_f32(merged_exact * inv_s), -127.0, 127.0).to(tl.int8)
+    tl.store(OUT_Q_PTR + row_id.to(tl.int64) * (NHEADS * D) + hd_offs, q)
+
+
+_CACHE_WRITE_LAUNCHER = FastKernelLauncher(reshape_and_cache_k8v4_kernel, n_runtime_args=19)
+_DECODE_LAUNCHER = FastKernelLauncher(paged_gqa_decode_split_kv_tle_kernel, n_runtime_args=15)
+_STAGE1_LAUNCHER = FastKernelLauncher(paged_gqa_stage1_gather_kv_kernel, n_runtime_args=12)
+_STAGE2_LAUNCHER = FastKernelLauncher(paged_gqa_stage2_colmajor_sme_tle_kernel, n_runtime_args=11)
+_PREQUANT_Q_LAUNCHER = FastKernelLauncher(paged_gqa_prequant_q_kscale_kernel, n_runtime_args=14)
+_STAGE1_HYBRID_LAUNCHER = FastKernelLauncher(paged_gqa_stage1_gather_hybrid_kv_kernel, n_runtime_args=15)
+_STAGE2_HYBRID_LAUNCHER = FastKernelLauncher(paged_gqa_stage2_hybrid_colmajor_sme_kernel, n_runtime_args=15)
+_MERGE_LAUNCHER = FastKernelLauncher(paged_gqa_splitk_merge_tle_kernel, n_runtime_args=7)
+_MERGE_QUANT_LAUNCHER = FastKernelLauncher(paged_gqa_splitk_merge_quant_tle_kernel, n_runtime_args=8)
+
+
+def _get_two_stage_kv_workspace(device: torch.device, slots_x_nkv: int, kv_stride: int, head_dim: int = 128) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return a stream-local contiguous BF16 `(K_buf, V_buf)` scratch pair for two-stage prefill."""
+    dev_idx = device.index or 0
+    stream_id = _cuda_raw_stream(dev_idx) if _cuda_raw_stream is not None else torch.cuda.current_stream(device).cuda_stream
+    key = (dev_idx, stream_id, head_dim)
+    entry = _TWO_STAGE_KV_SCRATCH.get(key)
+    if entry is None or entry[0].shape[0] < slots_x_nkv or entry[0].shape[1] < kv_stride or entry[0].shape[2] != head_dim or entry[0].dtype != torch.bfloat16:
+        cap_rows = max(slots_x_nkv, _TWO_STAGE_MAX_SLOTS * 2)
+        if entry is not None:
+            cap_rows, kv_stride = max(cap_rows, entry[0].shape[0]), max(kv_stride, entry[0].shape[1])
+            _TWO_STAGE_KV_SCRATCH.pop(key, None)
+        k_buf, v_buf = torch.empty((cap_rows, kv_stride, head_dim), dtype=torch.bfloat16, device=device), torch.empty((cap_rows, kv_stride, head_dim), dtype=torch.bfloat16, device=device)
+        if len(_TWO_STAGE_KV_SCRATCH) < 16:
+            _TWO_STAGE_KV_SCRATCH[key] = (k_buf, v_buf)
+        return k_buf, v_buf
+    return entry
+
+
+def _get_two_stage_hybrid_q_scratch(
+    device: torch.device, need_q_tiles: int, head_dim: int, m_tile: int, rows: int
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Return stream-local `(qt_i8, qs_scale, ks_sink, ks_partial, ks_body)` scratch buffers for hybrid prefill."""
+    dev_idx = device.index or 0
+    stream_id = _cuda_raw_stream(dev_idx) if _cuda_raw_stream is not None else torch.cuda.current_stream(device).cuda_stream
+    key = (dev_idx, stream_id, head_dim, m_tile)
+    entry = _TWO_STAGE_HYBRID_Q_SCRATCH.get(key)
+    if entry is None or entry[0].shape[0] < need_q_tiles or entry[2].shape[0] < rows:
+        prev_q = entry[0].shape[0] if entry is not None else 0
+        prev_rows = entry[2].shape[0] if entry is not None else 0
+        cap_q = max(need_q_tiles, 256, prev_q)
+        cap_rows = max(rows, _TWO_STAGE_MAX_SLOTS * 2, prev_rows)
+        if entry is not None:
+            _TWO_STAGE_HYBRID_Q_SCRATCH.pop(key, None)
+        qt_i8 = torch.empty((cap_q, head_dim, m_tile), dtype=torch.int8, device=device)
+        qs_scale = torch.empty((cap_q, m_tile), dtype=torch.float32, device=device)
+        ks_sink = torch.empty((cap_rows, 64), dtype=torch.float32, device=device)
+        ks_partial = torch.empty((cap_rows * 8,), dtype=torch.float32, device=device)
+        ks_body = torch.empty((cap_rows,), dtype=torch.float32, device=device)
+        res = (qt_i8, qs_scale, ks_sink, ks_partial, ks_body)
+        if len(_TWO_STAGE_HYBRID_Q_SCRATCH) < 16:
+            _TWO_STAGE_HYBRID_Q_SCRATCH[key] = res
+        return res
+    return entry
+
+
+def reshape_and_cache_k8v4(
+    key: torch.Tensor, value: torch.Tensor, key_cache: torch.Tensor, value_cache: torch.Tensor, slot_mapping: torch.Tensor,
+    k_scale_cache: torch.Tensor | None = None, v_scale_cache: torch.Tensor | None = None, *,
+    query: torch.Tensor | None = None, query_out: torch.Tensor | None = None,
+    positions: torch.Tensor | None = None, cos_sin_cache: torch.Tensor | None = None,
+    q_norm_weight: torch.Tensor | None = None, k_norm_weight: torch.Tensor | None = None, rms_eps: float = 1e-6,
+    apply_v_h64: bool = False, use_db_lsq: bool = True, is_neox: bool = True,
+) -> torch.Tensor | None:
+    """Write `(key, value)` into `DG-R2-K8V4`, `K8V8`, or `BF16` paged KV cache, optionally fusing per-head QK-Norm + Q/K NeoX RoPE."""
+    _ = is_neox
+    num_tokens = int(slot_mapping.shape[0])
+    if num_tokens == 0:
+        return query_out if query_out is not None else query
+
+    nkv, head_dim, block_size = int(key.shape[1]), int(key.shape[2]), int(key_cache.shape[1])
+    if key.stride(1) != head_dim or key.stride(2) != 1:
+        key = key.contiguous()
+    if value.stride(1) != head_dim or value.stride(2) != 1:
+        value = value.contiguous()
+    fused_rope = (positions is not None) and (cos_sin_cache is not None)
+    if fused_rope and query is not None:
+        if query.stride(1) != head_dim or query.stride(2) != 1:
+            query = query.contiguous()
+        num_q_heads = int(query.shape[1])
+        q_out = query if query_out is None else query_out
+        q_per_cta = (
+            16
+            if (num_tokens >= 512 and num_q_heads >= 16 and nkv <= 2)
+            else (8 if num_q_heads >= 8 else (4 if num_q_heads >= 4 else max(1, num_q_heads)))
+        )
+        num_q_groups = triton.cdiv(num_q_heads, q_per_cta)
+        qi_s0, qo_s0, q_in_t, q_out_t = int(query.stride(0)), int(q_out.stride(0)), query, q_out
+    else:
+        num_q_heads, q_per_cta, num_q_groups, qi_s0, qo_s0 = 0, 1, 0, 0, 0
+        q_in_t = q_out_t = key
+
+    has_qk_norm = (q_norm_weight is not None) and (k_norm_weight is not None)
+    if has_qk_norm:
+        qn_t = q_norm_weight if q_norm_weight.stride(0) == 1 else q_norm_weight.contiguous()
+        kn_t = k_norm_weight if k_norm_weight.stride(0) == 1 else k_norm_weight.contiguous()
+        eps_f = float(rms_eps)
+    else:
+        qn_t = kn_t = key
+        eps_f = 0.0
+
+    # Schedule 1 KV head per CTA so DB-LSQ K/V quantization executes across parallel CUs (`32 VGPRs`).
+    kv_per_cta = 1
+    total_groups = num_q_groups + triton.cdiv(nkv, kv_per_cta)
+    if key_cache.dtype != torch.int8:
+        kv_mode, packed_bf16x2, ks_t, vs_t, ks_s, vs_s = 0, False, key, key, (0, 0, 0), (0, 0, 0)
+    else:
+        kv_mode = 2 if (value_cache.shape[-1] * 2 == head_dim) else 1
+        if k_scale_cache is None:
+            raise ValueError("INT8/K8V4 cache write requires k_scale_cache")
+        packed_bf16x2 = k_scale_cache.dtype == torch.int32
+        ks_t, ks_s = k_scale_cache, tuple(int(x) for x in k_scale_cache.stride())
+        if packed_bf16x2:
+            vs_t, vs_s = k_scale_cache, (0, 0, 0)
+        else:
+            if v_scale_cache is None:
+                raise ValueError("Unpacked INT8/K8V4 cache write requires v_scale_cache")
+            vs_t, vs_s = v_scale_cache, tuple(int(x) for x in v_scale_cache.stride())
+
+    pos_t, cs_t = (positions if fused_rope else slot_mapping), (cos_sin_cache if fused_rope else key)
+    cs_s0 = int(cos_sin_cache.stride(0)) if fused_rope else 0
+    ki_s0, vi_s0 = int(key.stride(0)), int(value.stride(0))
+    kc_s0, kc_s1, kc_s2, _ = (int(x) for x in key_cache.stride())
+    vc_s0, vc_s1, vc_s2, vc_s3 = (int(x) for x in value_cache.stride())
+    wide = any(sum((sz - 1) * st for sz, st in zip(t.shape, t.stride())) > 2**31 - 1 for t in (key_cache, value_cache))
+
+    grid_0, dev = num_tokens * total_groups, key.device
+    dev_idx = dev.index or 0
+    ptr_mask = q_in_t.data_ptr() | q_out_t.data_ptr() | key.data_ptr() | value.data_ptr() | pos_t.data_ptr() | cs_t.data_ptr() | slot_mapping.data_ptr() | key_cache.data_ptr() | value_cache.data_ptr() | ks_t.data_ptr() | vs_t.data_ptr() | qn_t.data_ptr() | kn_t.data_ptr()
+    l_key = (
+        dev_idx, key.dtype, key_cache.dtype, slot_mapping.dtype, pos_t.dtype, ks_t.dtype, qn_t.dtype, int_align_spec(qi_s0), int_align_spec(qo_s0), int_align_spec(ki_s0), int_align_spec(vi_s0), int_align_spec(cs_s0),
+        kc_s0, kc_s1, kc_s2, vc_s0, vc_s1, vc_s2, vc_s3, ks_s, vs_s, block_size, num_q_heads, nkv, head_dim, q_per_cta, kv_per_cta, num_q_groups, total_groups, kv_mode, fused_rope, packed_bf16x2, bool(use_db_lsq), bool(apply_v_h64), wide, has_qk_norm,
+    )
+    entry = _CACHE_WRITE_LAUNCHER.get(l_key) if (ptr_mask & 0xF) == 0 else None
+    if entry is not None and _CACHE_WRITE_LAUNCHER.can_fast_launch(ptr_mask):
+        _CACHE_WRITE_LAUNCHER.launch(entry, grid_0, 1, 1, dev_idx, q_in_t, q_out_t, key, value, pos_t, cs_t, slot_mapping, key_cache, value_cache, ks_t, vs_t, qn_t, kn_t, eps_f, qi_s0, qo_s0, ki_s0, vi_s0, cs_s0)
+    else:
+        with torch_device_fn.device(dev):
+            ck = reshape_and_cache_k8v4_kernel[(grid_0,)](
+                q_in_t, q_out_t, key, value, pos_t, cs_t, slot_mapping, key_cache, value_cache, ks_t, vs_t, qn_t, kn_t, eps_f, qi_s0, qo_s0, ki_s0, vi_s0, cs_s0,
+                KC0=kc_s0, KC1=kc_s1, KC2=kc_s2, VC0=vc_s0, VC1=vc_s1, VC2=vc_s2, VC3=vc_s3, KS0=ks_s[0], KS1=ks_s[1], KS2=ks_s[2], VS0=vs_s[0], VS1=vs_s[1], VS2=vs_s[2],
+                BLOCK_SIZE=block_size, NUM_Q_HEADS=num_q_heads, NUM_KV_HEADS=nkv, HEAD_DIM=head_dim, Q_PER_CTA=q_per_cta, KV_PER_CTA=kv_per_cta, NUM_Q_GROUPS=num_q_groups, TOTAL_GROUPS=total_groups,
+                KV_MODE=kv_mode, FUSED_ROPE=fused_rope, PACKED_BF16X2=packed_bf16x2, USE_DB_LSQ=bool(use_db_lsq), APPLY_V_H64=bool(apply_v_h64), WIDE_KV=wide, HAS_QK_NORM=has_qk_norm, num_warps=1 if (head_dim // 2) <= 64 else 2, num_stages=1,
+            )
+        if (ptr_mask & 0xF) == 0:
+            _CACHE_WRITE_LAUNCHER.record(l_key, ck)
