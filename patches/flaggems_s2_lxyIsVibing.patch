+            k_fp, v_fp = (k_raw.to(tl.float32) * ks_f[:, None]).to(out_dtype), (v_i8.to(tl.float32) * vs_f[:, None]).to(out_dtype)
+        base_out = slot_base + out_tok[:, None] * D + d[None, :]
+        tl.store(K_OUT + base_out, k_fp, mask=p_valid[:, None])
+        tl.store(V_OUT + base_out, v_fp, mask=p_valid[:, None])
+
