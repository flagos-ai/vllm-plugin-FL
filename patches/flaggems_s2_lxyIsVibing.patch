+# SPDX-License-Identifier: Apache-2.0
+"""Zero-Spill 8-Way Vector-Register Interval-Bisection Sort-Free TopK/TopP & Fused
+Gumbel-Max Sampling Triton Kernels for MetaX C500 (Wave64).
+
+Why this sort-free design is optimal on MetaX C500 (`xcore1000`, `warp_size=64`, `8` warps/CTA):
+1. **Zero Intra-Loop CTA Reductions & Zero VGPR Spills (`7` Vector Accumulators)**:
+   Sorting `V = 130,560` logits per row incurs multi-pass radix-sort HBM traffic and LDS barrier
+   stalls. Instead, `BLOCK_SIZE = 4096` (`512` threads x `8` elems/thread) streams vocabulary tiles
+   through **7 vector accumulators** (`q1..q7` -> `8` sub-intervals per pass). Across 2 passes
+   (`8^2 = 64x` interval shrinkage), all counts/masses stay in per-lane VGPRs with `0` VGPR spills
+   and `0` `tl.sum` cross-wave LDS barriers inside the `NUM_TILES` loop.
+2. **2-Slot In-Register Candidate Gather (`cand_x0`, `cand_x1`)**:
+   After 2-stage 8-way refinement, nearly every lane holds `<= 2` bracket candidates (`[low, high]`).
+   Tracking 2 candidate slots in registers lets a 10-step scalar-interval binary search resolve the
+   exact `tau_k` / `tau_star` threshold without allocating or scanning a global candidate buffer.
+3. **Vectorized Lane-Constant Gumbel-Max Sampling (`w / (-log u)`)**:
+   Using the exponential race identity `argmax_i (p_i / Exp(1)_i) ~ Categorical(p)` (Gumbel-Max in
+   linear probability space `w_i = exp(x_i - m_i)`), when `USE_TL_RAND=True` a single uniform draw
+   per `BLOCK_SIZE` lane (`q_lane = -log(u)`) is factored out of the `NUM_TILES` loop and applied
+   once after Pass 3 (`0` per-tile RNG instructions and `0` `[B, V]` noise HBM traffic).
+"""
+
+from __future__ import annotations
+
+import logging
+import torch
+import triton
+import triton.language as tl
+
+logger = logging.getLogger("flag_gems." + __name__)
+
+
+@triton.jit
+def _metax_topk_kernel(
+    logits_ptr,
+    stride_m,
+    k_ptr,
+    buf_x_ptr,
+    VOCAB_SIZE: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+    BUF_CAP: tl.constexpr,
+    NUM_TILES: tl.constexpr,
+):
+    """In-place sort-free Top-K logits filter (`1` CTA per batch row, `BLOCK_SIZE=4096`).
+
+    Narrows `[m_min, m_max]` by `64x` via two 8-way (`7`-threshold) vector-register counting passes,
+    gathers up to 2 bracket candidates per lane in VGPRs, refines `tau_k` with 10 register bisection
+    steps, and masks logits `< tau_k` to `-inf`.
+    """
+    row_id = tl.program_id(0)
+    row_ptr = logits_ptr + row_id.to(tl.int64) * stride_m
+    lane_id = tl.arange(0, BLOCK_SIZE)
+
+    k_val = tl.load(k_ptr + row_id).to(tl.int32)
+    k_active = (k_val > 0) & (k_val < VOCAB_SIZE)
+    if not k_active:
+        return
+
+    # Pass 1: Vector-register min/max of finite logits (0 intra-loop CTA reductions)
+    vec_max = tl.full((BLOCK_SIZE,), -float("inf"), dtype=tl.float32)
+    vec_min = tl.full((BLOCK_SIZE,), float("inf"), dtype=tl.float32)
+    vec_cnt = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+    for i in range(0, NUM_TILES):
+        offs = i * BLOCK_SIZE + lane_id
+        mask = offs < VOCAB_SIZE
+        x = tl.load(row_ptr + offs, mask=mask, other=-float("inf")).to(tl.float32)
+        fin = x > -float("inf")
+        vec_max = tl.maximum(vec_max, x)
+        vec_min = tl.minimum(vec_min, tl.where(fin, x, float("inf")))
+        vec_cnt += fin.to(tl.int32)
+
+    m_max = tl.max(vec_max, axis=0)
+    m_min = tl.min(vec_min, axis=0)
+    tot_fin = tl.sum(vec_cnt, axis=0)
+    need_mask = k_active & (tot_fin > k_val) & (m_max > m_min)
+    if not need_mask:
+        return
+
+    # Pass 2: 2-stage 8-way vector-register interval refinement (7 accumulators -> 0 VGPR spills)
+    low = m_min
+    high = m_max
+    for _ in range(0, 2):
+        step = (high - low) * 0.125
+        q1 = low + step * 1.0
+        q2 = low + step * 2.0
+        q3 = low + step * 3.0
+        q4 = low + step * 4.0
+        q5 = low + step * 5.0
+        q6 = low + step * 6.0
+        q7 = low + step * 7.0
+
+        vc1 = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+        vc2 = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+        vc3 = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+        vc4 = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+        vc5 = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+        vc6 = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+        vc7 = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+
+        for i in range(0, NUM_TILES):
+            offs = i * BLOCK_SIZE + lane_id
+            mask = offs < VOCAB_SIZE
+            x = tl.load(row_ptr + offs, mask=mask, other=-float("inf")).to(tl.float32)
+            vc1 += (x >= q1).to(tl.int32)
+            vc2 += (x >= q2).to(tl.int32)
+            vc3 += (x >= q3).to(tl.int32)
+            vc4 += (x >= q4).to(tl.int32)
+            vc5 += (x >= q5).to(tl.int32)
+            vc6 += (x >= q6).to(tl.int32)
+            vc7 += (x >= q7).to(tl.int32)
+
+        c1 = tl.sum(vc1, axis=0)
+        c2 = tl.sum(vc2, axis=0)
+        c3 = tl.sum(vc3, axis=0)
+        c4 = tl.sum(vc4, axis=0)
+        c5 = tl.sum(vc5, axis=0)
+        c6 = tl.sum(vc6, axis=0)
+        c7 = tl.sum(vc7, axis=0)
+
+        low = tl.where(c1 >= k_val, q1, low)
+        low = tl.where(c2 >= k_val, q2, low)
+        low = tl.where(c3 >= k_val, q3, low)
+        low = tl.where(c4 >= k_val, q4, low)
+        low = tl.where(c5 >= k_val, q5, low)
+        low = tl.where(c6 >= k_val, q6, low)
+        low = tl.where(c7 >= k_val, q7, low)
+
+        high = tl.where(c7 < k_val, q7, high)
+        high = tl.where(c6 < k_val, q6, high)
+        high = tl.where(c5 < k_val, q5, high)
+        high = tl.where(c4 < k_val, q4, high)
+        high = tl.where(c3 < k_val, q3, high)
+        high = tl.where(c2 < k_val, q2, high)
+        high = tl.where(c1 < k_val, q1, high)
+
+    # Pass 3: Zero-barrier in-register 2-slot candidate gather (0 intra-loop tl.cumsum / tl.store)
+    vec_cnt_above = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+    cand_cnt = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+    cand_x0 = tl.full((BLOCK_SIZE,), -float("inf"), dtype=tl.float32)
+    cand_x1 = tl.full((BLOCK_SIZE,), -float("inf"), dtype=tl.float32)
+    for i in range(0, NUM_TILES):
+        offs = i * BLOCK_SIZE + lane_id
+        mask = offs < VOCAB_SIZE
+        x = tl.load(row_ptr + offs, mask=mask, other=-float("inf")).to(tl.float32)
+        vec_cnt_above += (x > high).to(tl.int32)
+        in_brk = (x >= low) & (x <= high)
+        cand_x0 = tl.where(in_brk & (cand_cnt == 0), x, cand_x0)
+        cand_x1 = tl.where(in_brk & (cand_cnt == 1), x, cand_x1)
+        cand_cnt += in_brk.to(tl.int32)
+
+    cnt_above_high = tl.sum(vec_cnt_above, axis=0)
+    max_lane_cnt = tl.max(cand_cnt, axis=0)
+    m0 = cand_cnt >= 1
+    m1 = cand_cnt >= 2
+
+    b_low = low
+    b_high = high
+    for _ in range(0, 10):
+        mid = 0.5 * (b_low + b_high)
+        c_mid = cnt_above_high + tl.sum(
+            (m0 & (cand_x0 >= mid)).to(tl.int32) + (m1 & (cand_x1 >= mid)).to(tl.int32),
+            axis=0,
+        )
+        b_low = tl.where(c_mid >= k_val, mid, b_low)
+        b_high = tl.where(c_mid >= k_val, b_high, mid)
+
+    tau_c0 = tl.min(tl.where(m0 & (cand_x0 >= b_low), cand_x0, high), axis=0)
+    tau_c1 = tl.min(tl.where(m1 & (cand_x1 >= b_low), cand_x1, high), axis=0)
+    tau_cand = tl.minimum(tau_c0, tau_c1)
+    tau_k = tl.where(max_lane_cnt <= 2, tau_cand, b_low)
+
+    for i in range(0, NUM_TILES):
+        offs = i * BLOCK_SIZE + lane_id
+        mask = offs < VOCAB_SIZE
+        x = tl.load(row_ptr + offs, mask=mask, other=-float("inf")).to(tl.float32)
+        drop = mask & (x < tau_k) & (x > -float("inf"))
+        tl.store(row_ptr + offs, -float("inf"), mask=drop)
+
+
+@triton.jit
+def _metax_topp_kernel(
+    logits_ptr,
+    stride_m,
+    p_ptr,
+    buf_x_ptr,
+    buf_idx_ptr,
+    q_ptr,
+    stride_qm,
+    out_tok_ptr,
+    VOCAB_SIZE: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+    BUF_CAP: tl.constexpr,
+    NUM_TILES: tl.constexpr,
+    WRITE_LOGITS: tl.constexpr,
+    FUSE_SAMPLE: tl.constexpr,
+    Q_MASK: tl.constexpr = 0,
+    HAS_TEMP: tl.constexpr = False,
+    ALL_RANDOM: tl.constexpr = True,
+    OUT_INT32: tl.constexpr = False,
+    SPLIT_TAIL: tl.constexpr = False,
+    USE_TL_RAND: tl.constexpr = False,
+    HAS_TOPP: tl.constexpr = True,
+):
+    """Sort-free Top-P nucleus filter and/or fused temperature + Gumbel-Max sampler (`1` CTA/row).
+
+    Supports both in-place logits masking (`WRITE_LOGITS=True, FUSE_SAMPLE=False`) and single-launch
+    categorical token sampling (`WRITE_LOGITS=False, FUSE_SAMPLE=True`), with per-row greedy short-circuit
+    (`t_val < 1e-5` when `ALL_RANDOM=False`) and unmasked full-tile peeling (`SPLIT_TAIL=True`).
+    """
+    row_id = tl.program_id(0)
+    s_m = tl.multiple_of(stride_m, 16) if SPLIT_TAIL else stride_m
+    row_ptr = logits_ptr + row_id.to(tl.int64) * s_m
+    q_row_ptr = (
+        q_ptr + row_id.to(tl.int64) * stride_qm
+        if (FUSE_SAMPLE & (not USE_TL_RAND))
+        else row_ptr
+    )
+    lane_id = tl.arange(0, BLOCK_SIZE)
+
+    if HAS_TEMP:
+        # Note: `buf_x_ptr` carries the per-row `temperature` tensor when `HAS_TEMP=True`.
+        t_val = tl.load(buf_x_ptr + row_id).to(tl.float32)
+        if not ALL_RANDOM:
+            # Per-row greedy fast path (`temperature < 1e-5`): single-pass streaming argmax in VGPRs,
+            # bypassing online softmax, Top-P interval refinement, and RNG completely.
+            if t_val < 1e-5:
+                vec_max = tl.full((BLOCK_SIZE,), -float("inf"), dtype=tl.float32)
+                vec_idx = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+                for i in range(0, NUM_TILES):
+                    offs = i * BLOCK_SIZE + lane_id
+                    mask = offs < VOCAB_SIZE
+                    x = tl.load(row_ptr + offs, mask=mask, other=-float("inf")).to(tl.float32)
+                    better = x > vec_max
+                    vec_max = tl.where(better, x, vec_max)
+                    vec_idx = tl.where(better, offs, vec_idx)
+                best_pos = tl.argmax(vec_max, axis=0)
+                final_tok = tl.sum(tl.where(lane_id == best_pos, vec_idx, 0), axis=0)
+                if OUT_INT32:
+                    tl.store(out_tok_ptr + row_id, final_tok.to(tl.int32))
+                else:
+                    tl.store(out_tok_ptr + row_id, final_tok.to(tl.int64))
+                return
+        inv_t = 1.0 / t_val
+        scale_temp = t_val != 1.0
+    else:
+        inv_t = 1.0
+        scale_temp = False
+
+    if HAS_TOPP:
+        p_val = tl.load(p_ptr + row_id).to(tl.float32)
+        p_active = p_val < 1.0
+    else:
+        p_val = 1.0
+        p_active = False
+    if (not FUSE_SAMPLE) & (not p_active):
+        return
+
+    FULL_TILES: tl.constexpr = (NUM_TILES - 1) if SPLIT_TAIL else NUM_TILES
+    EVICT_LOGITS: tl.constexpr = not WRITE_LOGITS
+
+    # Pass 1: Vector-register Online Softmax (single exp/element + Tile-0 peel, 0 intra-loop CTA reductions)
+    if SPLIT_TAIL:
+        offs0 = tl.max_contiguous(tl.multiple_of(lane_id, BLOCK_SIZE), BLOCK_SIZE)
+        x0 = tl.load(row_ptr + offs0).to(tl.float32)
+        if HAS_TEMP:
+            if scale_temp:
+                x0 = x0 * inv_t
+        vec_m = x0
+        vec_d = tl.where(x0 > -float("inf"), 1.0, 0.0)
+        START_TILE: tl.constexpr = 1
+    else:
+        vec_m = tl.full((BLOCK_SIZE,), -float("inf"), dtype=tl.float32)
+        vec_d = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+        START_TILE: tl.constexpr = 0
+
+    for i in range(START_TILE, FULL_TILES):
+        offs = tl.max_contiguous(tl.multiple_of(i * BLOCK_SIZE + lane_id, BLOCK_SIZE), BLOCK_SIZE)
+        if SPLIT_TAIL:
+            if EVICT_LOGITS:
+                x = tl.load(row_ptr + offs, eviction_policy="evict_first").to(tl.float32)
+            else:
+                x = tl.load(row_ptr + offs).to(tl.float32)
+        else:
+            x = tl.load(row_ptr + offs, mask=offs < VOCAB_SIZE, other=-float("inf")).to(tl.float32)
+        if HAS_TEMP:
+            if scale_temp:
+                x = x * inv_t
+        gt = x > vec_m
+        exp_arg = tl.where(gt, vec_m - x, tl.where(x > -float("inf"), x - vec_m, -float("inf")))
+        exp_val = tl.exp(exp_arg)
+        vec_d = tl.where(gt, vec_d * exp_val + 1.0, vec_d + exp_val)
+        vec_m = tl.where(gt, x, vec_m)
+
+    if SPLIT_TAIL:
+        offs_t = (NUM_TILES - 1) * BLOCK_SIZE + lane_id
+        mask_t = offs_t < VOCAB_SIZE
+        x_t = tl.load(row_ptr + offs_t, mask=mask_t, other=-float("inf")).to(tl.float32)
+        if HAS_TEMP:
+            if scale_temp:
+                x_t = x_t * inv_t
+        gt_t = x_t > vec_m
+        exp_arg_t = tl.where(gt_t, vec_m - x_t, tl.where(x_t > -float("inf"), x_t - vec_m, -float("inf")))
+        exp_val_t = tl.exp(exp_arg_t)
+        vec_d = tl.where(gt_t, vec_d * exp_val_t + 1.0, vec_d + exp_val_t)
+        vec_m = tl.where(gt_t, x_t, vec_m)
+
+    m_i = tl.max(vec_m, axis=0)
+    d_i = tl.sum(
+        tl.where(m_i > -float("inf"), vec_d * tl.exp(vec_m - m_i), 0.0), axis=0
+    )
+
+    has_finite = (m_i > -float("inf")) & (d_i > 0.0)
+    need_topp = has_finite & p_active
+    one_minus_p = tl.maximum(1.0 - p_val, 1e-7)
+    target_keep_sum = p_val * d_i
+
+    # Exact mathematical floor: any token below tau_floor has prob <= (1-p)/V
+    tau_floor = tl.where(
+        need_topp,
+        m_i + tl.log(one_minus_p * d_i / VOCAB_SIZE) - 0.05,
+        -float("inf"),
+    )
+
+    # Pass 2: Adaptive 8-way non-uniform vector-register refinement (7 accumulators -> 0 VGPR spills)
+    low = tau_floor
+    high = tl.where(need_topp, m_i, -float("inf"))
+    MAX_P2: tl.constexpr = 0 if (not HAS_TOPP) else (2 if WRITE_LOGITS else 1)
+    for pass2_iter in range(0, MAX_P2):
+        if (pass2_iter == 0) | ((high - low) > 0.25):
+            span = high - low
+            q1 = low + span * 0.03125
+            q2 = low + span * 0.0625
+            q3 = low + span * 0.125
+            q4 = low + span * 0.21875
+            q5 = low + span * 0.34375
+            q6 = low + span * 0.50
+            q7 = low + span * 0.71875
+
+            vs1 = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+            vs2 = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+            vs3 = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+            vs4 = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+            vs5 = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+            vs6 = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+            vs7 = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+
+            for i in range(0, FULL_TILES):
+                offs = tl.max_contiguous(tl.multiple_of(i * BLOCK_SIZE + lane_id, BLOCK_SIZE), BLOCK_SIZE)
+                if SPLIT_TAIL:
+                    x = tl.load(row_ptr + offs).to(tl.float32)
+                else:
+                    x = tl.load(row_ptr + offs, mask=offs < VOCAB_SIZE, other=-float("inf")).to(tl.float32)
+                if HAS_TEMP:
+                    if scale_temp:
+                        x = x * inv_t
+                w = tl.where(need_topp & (x >= q1), tl.exp(x - m_i), 0.0)
+                vs1 += w
+                vs2 += tl.where(x >= q2, w, 0.0)
+                vs3 += tl.where(x >= q3, w, 0.0)
+                vs4 += tl.where(x >= q4, w, 0.0)
+                vs5 += tl.where(x >= q5, w, 0.0)
+                vs6 += tl.where(x >= q6, w, 0.0)
+                vs7 += tl.where(x >= q7, w, 0.0)
+
+            if SPLIT_TAIL:
+                offs_t = (NUM_TILES - 1) * BLOCK_SIZE + lane_id
+                x_t = tl.load(row_ptr + offs_t, mask=offs_t < VOCAB_SIZE, other=-float("inf")).to(tl.float32)
+                if HAS_TEMP:
+                    if scale_temp:
+                        x_t = x_t * inv_t
+                w_t = tl.where(need_topp & (x_t >= q1), tl.exp(x_t - m_i), 0.0)
+                vs1 += w_t
+                vs2 += tl.where(x_t >= q2, w_t, 0.0)
+                vs3 += tl.where(x_t >= q3, w_t, 0.0)
+                vs4 += tl.where(x_t >= q4, w_t, 0.0)
+                vs5 += tl.where(x_t >= q5, w_t, 0.0)
+                vs6 += tl.where(x_t >= q6, w_t, 0.0)
+                vs7 += tl.where(x_t >= q7, w_t, 0.0)
+
+            s1 = tl.sum(vs1, axis=0)
+            s2 = tl.sum(vs2, axis=0)
+            s3 = tl.sum(vs3, axis=0)
+            s4 = tl.sum(vs4, axis=0)
+            s5 = tl.sum(vs5, axis=0)
+            s6 = tl.sum(vs6, axis=0)
+            s7 = tl.sum(vs7, axis=0)
+
+            low = tl.where(s1 >= target_keep_sum, q1, low)
+            low = tl.where(s2 >= target_keep_sum, q2, low)
+            low = tl.where(s3 >= target_keep_sum, q3, low)
+            low = tl.where(s4 >= target_keep_sum, q4, low)
+            low = tl.where(s5 >= target_keep_sum, q5, low)
+            low = tl.where(s6 >= target_keep_sum, q6, low)
+            low = tl.where(s7 >= target_keep_sum, q7, low)
+
+            high = tl.where(s7 < target_keep_sum, q7, high)
+            high = tl.where(s6 < target_keep_sum, q6, high)
+            high = tl.where(s5 < target_keep_sum, q5, high)
+            high = tl.where(s4 < target_keep_sum, q4, high)
+            high = tl.where(s3 < target_keep_sum, q3, high)
+            high = tl.where(s2 < target_keep_sum, q2, high)
+            high = tl.where(s1 < target_keep_sum, q1, high)
+
+    low = tl.where(need_topp, low, -float("inf"))
+    high = tl.where(need_topp, high, -float("inf"))
+
+    # Pass 3: Zero-barrier in-register 2-slot candidate gather + above-high Gumbel tracking
+    vec_above_high = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+    vec_best_score = tl.full((BLOCK_SIZE,), -1.0, dtype=tl.float32)
+    vec_best_idx = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+    vec_cnt = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+    cand_x0 = tl.full((BLOCK_SIZE,), -float("inf"), dtype=tl.float32)
+    cand_x1 = tl.full((BLOCK_SIZE,), -float("inf"), dtype=tl.float32)
+    cand_idx0 = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+    cand_idx1 = tl.zeros((BLOCK_SIZE,), dtype=tl.int32)
+
+    LANE_CONST_Q: tl.constexpr = (FUSE_SAMPLE & (not WRITE_LOGITS)) & (
+        USE_TL_RAND | (Q_MASK == (BLOCK_SIZE - 1))
+    )
+
+    for i in range(0, FULL_TILES):
+        offs = tl.max_contiguous(tl.multiple_of(i * BLOCK_SIZE + lane_id, BLOCK_SIZE), BLOCK_SIZE)
+        if SPLIT_TAIL:
+            if EVICT_LOGITS:
+                x = tl.load(row_ptr + offs, eviction_policy="evict_first").to(tl.float32)
+            else:
+                x = tl.load(row_ptr + offs).to(tl.float32)
+        else:
+            x = tl.load(row_ptr + offs, mask=offs < VOCAB_SIZE, other=-float("inf")).to(tl.float32)
+        if HAS_TEMP:
+            if scale_temp:
+                x = x * inv_t
+        is_above = has_finite & (x > high)
+        w_above = tl.where(is_above, tl.exp(x - m_i), 0.0)
+        vec_above_high += w_above
+        if FUSE_SAMPLE & (not WRITE_LOGITS):
+            if LANE_CONST_Q:
+                s_above = tl.where(is_above, w_above, -1.0)
+                better = s_above > vec_best_score
+                vec_best_score = tl.where(better, s_above, vec_best_score)
+                vec_best_idx = tl.where(better, offs, vec_best_idx)
+            else:
+                q_offs = (offs & Q_MASK) if Q_MASK > 0 else offs
+                q_val = tl.load(q_row_ptr + q_offs, mask=is_above, other=1.0).to(tl.float32)
+                s_above = tl.where(is_above, w_above / q_val, -1.0)
+                better = s_above > vec_best_score
+                vec_best_score = tl.where(better, s_above, vec_best_score)
+                vec_best_idx = tl.where(better, offs, vec_best_idx)
+        in_brk = need_topp & (x >= low) & (x <= high)
+        is_s0 = in_brk & (vec_cnt == 0)
+        is_s1 = in_brk & (vec_cnt == 1)
+        cand_x0 = tl.where(is_s0, x, cand_x0)
+        cand_idx0 = tl.where(is_s0, offs, cand_idx0)
+        cand_x1 = tl.where(is_s1, x, cand_x1)
+        cand_idx1 = tl.where(is_s1, offs, cand_idx1)
+        vec_cnt += in_brk.to(tl.int32)
+
+    if SPLIT_TAIL:
+        offs_t = (NUM_TILES - 1) * BLOCK_SIZE + lane_id
+        if EVICT_LOGITS:
+            x_t = tl.load(
+                row_ptr + offs_t,
+                mask=offs_t < VOCAB_SIZE,
+                other=-float("inf"),
+                eviction_policy="evict_first",
+            ).to(tl.float32)
+        else:
+            x_t = tl.load(
+                row_ptr + offs_t, mask=offs_t < VOCAB_SIZE, other=-float("inf")
+            ).to(tl.float32)
+        if HAS_TEMP:
+            if scale_temp:
+                x_t = x_t * inv_t
+        is_above_t = has_finite & (x_t > high)
+        w_above_t = tl.where(is_above_t, tl.exp(x_t - m_i), 0.0)
+        vec_above_high += w_above_t
+        if FUSE_SAMPLE & (not WRITE_LOGITS):
+            if LANE_CONST_Q:
+                s_above_t = tl.where(is_above_t, w_above_t, -1.0)
+                better_t = s_above_t > vec_best_score
+                vec_best_score = tl.where(better_t, s_above_t, vec_best_score)
+                vec_best_idx = tl.where(better_t, offs_t, vec_best_idx)
+            else:
+                q_offs_t = (offs_t & Q_MASK) if Q_MASK > 0 else offs_t
+                q_val_t = tl.load(q_row_ptr + q_offs_t, mask=is_above_t, other=1.0).to(tl.float32)
+                s_above_t = tl.where(is_above_t, w_above_t / q_val_t, -1.0)
+                better_t = s_above_t > vec_best_score
+                vec_best_score = tl.where(better_t, s_above_t, vec_best_score)
+                vec_best_idx = tl.where(better_t, offs_t, vec_best_idx)
+        in_brk_t = need_topp & (x_t >= low) & (x_t <= high)
+        is_s0_t = in_brk_t & (vec_cnt == 0)
+        is_s1_t = in_brk_t & (vec_cnt == 1)
+        cand_x0 = tl.where(is_s0_t, x_t, cand_x0)
+        cand_idx0 = tl.where(is_s0_t, offs_t, cand_idx0)
+        cand_x1 = tl.where(is_s1_t, x_t, cand_x1)
+        cand_idx1 = tl.where(is_s1_t, offs_t, cand_idx1)
+        vec_cnt += in_brk_t.to(tl.int32)
+
+    max_lane_cnt = tl.max(vec_cnt, axis=0)
+    sum_above_high = tl.sum(vec_above_high, axis=0)
+    m0 = vec_cnt >= 1
+    m1 = vec_cnt >= 2
+    w0 = tl.where(m0, tl.exp(cand_x0 - m_i), 0.0)
+    w1 = tl.where(m1, tl.exp(cand_x1 - m_i), 0.0)
+
+    # 10-step in-register binary search on [low, high]
+    b_low = low
+    b_high = high
+    for _ in range(0, 10):
+        mid = 0.5 * (b_low + b_high)
+        s_mid = (
+            sum_above_high
+            + tl.sum(
+                tl.where(cand_x0 >= mid, w0, 0.0) + tl.where(cand_x1 >= mid, w1, 0.0),
+                axis=0,
+            )
+        )
+        b_low = tl.where(s_mid >= target_keep_sum, mid, b_low)
+        b_high = tl.where(s_mid >= target_keep_sum, b_high, mid)
+
+    tau_c0 = tl.min(tl.where(m0 & (cand_x0 >= b_low), cand_x0, high), axis=0)
+    tau_c1 = tl.min(tl.where(m1 & (cand_x1 >= b_low), cand_x1, high), axis=0)
+    tau_cand = tl.minimum(tau_c0, tau_c1)
+    tau_star = tl.where(max_lane_cnt <= 2, tau_cand, b_low)
+    tau_star = tl.where(need_topp, tau_star, -float("inf"))
+
+    # Exact tie-mass accounting at `x == tau_star`: keep only enough tied tokens (`need_keep`) so
+    # cumulative nucleus mass reaches `target_keep_sum = p * d_i` without retaining excess ties.
+    sum_strictly_above = sum_above_high + tl.sum(
+        tl.where(m0 & (cand_x0 > tau_star), w0, 0.0)
+        + tl.where(m1 & (cand_x1 > tau_star), w1, 0.0),
+        axis=0,
+    )
+    is_tie0 = m0 & (cand_x0 == tau_star)
+    is_tie1 = m1 & (cand_x1 == tau_star)
+    c_tie = tl.sum(is_tie0.to(tl.int32) + is_tie1.to(tl.int32), axis=0)
+    w_tau = tl.where(need_topp, tl.exp(tau_star - m_i), 1.0)
+    need_keep_f = tl.maximum(target_keep_sum - sum_strictly_above, 0.0) / tl.maximum(
+        w_tau, 1e-38
+    )
+    need_keep = need_keep_f.to(tl.int32)
+    need_keep = tl.where(
+        (sum_strictly_above + need_keep.to(tl.float32) * w_tau)
+        < target_keep_sum - 1e-7,
+        need_keep + 1,
+        need_keep,
+    )
+    need_keep = tl.maximum(need_keep, 1)
+    num_drop_ties = tl.maximum(c_tie - need_keep, 0)
+    num_drop_ties = tl.where(need_topp & (max_lane_cnt <= 2), num_drop_ties, 0)
+
+    if FUSE_SAMPLE & (not WRITE_LOGITS):
+        if num_drop_ties > 0:
+            tie_cnt_lane = is_tie0.to(tl.int32) + is_tie1.to(tl.int32)
+            tie_prefix = tl.cumsum(tie_cnt_lane, axis=0) - tie_cnt_lane
+            rank0 = tie_prefix + 1
+            rank1 = tie_prefix + is_tie0.to(tl.int32) + 1
+            keep0 = m0 & ((cand_x0 > tau_star) | (is_tie0 & (rank0 > num_drop_ties)))
+            keep1 = m1 & ((cand_x1 > tau_star) | (is_tie1 & (rank1 > num_drop_ties)))
+        else:
+            keep0 = m0 & (cand_x0 >= tau_star)
+            keep1 = m1 & (cand_x1 >= tau_star)
+
+        # Gumbel-Max equivalence: `argmax_i (exp(x_i - m_i) / (-log U_i))` samples exactly from
+        # the renormalized nucleus softmax. Under `LANE_CONST_Q`, each lane's maximum across tiles
+        # was tracked on raw `w_above` first and is divided by `q_lane = -log(u)` once outside the loop.
+        if LANE_CONST_Q:
+            if USE_TL_RAND:
+                q_lane = -tl.log(
+                    tl.maximum(
+                        tl.rand(stride_qm.to(tl.int32), row_id * BLOCK_SIZE + lane_id),
+                        1e-10,
+                    )
+                )
+            else:
+                q_lane = tl.load(q_row_ptr + lane_id).to(tl.float32)
+            vec_best_score = tl.where(vec_best_score >= 0.0, vec_best_score / q_lane, -1.0)
+            s0 = tl.where(keep0, w0 / q_lane, -1.0)
+            s1_v = tl.where(keep1, w1 / q_lane, -1.0)
+        else:
+            q_idx0 = (cand_idx0 & Q_MASK) if Q_MASK > 0 else cand_idx0
+            q_idx1 = (cand_idx1 & Q_MASK) if Q_MASK > 0 else cand_idx1
+            q0 = tl.load(q_row_ptr + q_idx0.to(tl.int64), mask=keep0, other=1.0).to(
+                tl.float32
+            )
+            q1_v = tl.load(q_row_ptr + q_idx1.to(tl.int64), mask=keep1, other=1.0).to(
+                tl.float32
+            )
+            s0 = tl.where(keep0, w0 / q0, -1.0)
+            s1_v = tl.where(keep1, w1 / q1_v, -1.0)
+
+        take1 = s1_v > s0
+        s_cand = tl.where(take1, s1_v, s0)
+        idx_cand = tl.where(take1, cand_idx1, cand_idx0)
+
+        take_cand = s_cand > vec_best_score
+        vec_final_score = tl.where(take_cand, s_cand, vec_best_score)
+        vec_final_idx = tl.where(take_cand, idx_cand, vec_best_idx)
+
+        best_pos = tl.argmax(vec_final_score, axis=0)
+        final_tok = tl.sum(tl.where(lane_id == best_pos, vec_final_idx, 0), axis=0)
+        if OUT_INT32:
+            tl.store(out_tok_ptr + row_id, final_tok.to(tl.int32))
+        else:
+            tl.store(out_tok_ptr + row_id, final_tok.to(tl.int64))
+        return
+
+    # Pass 4: Zero-barrier in-place masking (0 intra-loop tl.cumsum / tl.sum!)
+    drop_ties_all = num_drop_ties > 0
+    for i in range(0, NUM_TILES):
+        offs = i * BLOCK_SIZE + lane_id
+        mask = offs < VOCAB_SIZE
+        x = tl.load(row_ptr + offs, mask=mask, other=-float("inf")).to(tl.float32)
+        drop_cond = tl.where(drop_ties_all, x <= tau_star, x < tau_star)
+        drop = need_topp & mask & drop_cond
+        tl.store(row_ptr + offs, -float("inf"), mask=drop)
+
+    if drop_ties_all:
+        tie_cnt_lane = is_tie0.to(tl.int32) + is_tie1.to(tl.int32)
+        tie_prefix = tl.cumsum(tie_cnt_lane, axis=0) - tie_cnt_lane
+        rank0 = tie_prefix + 1
+        rank1 = tie_prefix + is_tie0.to(tl.int32) + 1
+        tl.store(
+            row_ptr + cand_idx0.to(tl.int64),
+            tau_star,
+            mask=is_tie0 & (rank0 > num_drop_ties),
+        )
+        tl.store(
+            row_ptr + cand_idx1.to(tl.int64),
+            tau_star,
+            mask=is_tie1 & (rank1 > num_drop_ties),
+        )
+
+
+_GET_DEVICE = getattr(torch._C, "_cuda_getDevice", torch.cuda.current_device)
+_GET_RAW_STREAM = getattr(torch._C, "_cuda_getCurrentRawStream", None)
+_SAMPLER_BUFS: dict[tuple[torch.device, int], tuple[torch.Tensor, torch.Tensor]] = {}
+_SAMPLER_OUT_RING: dict[tuple[torch.device, int], list] = {}
+_RNG_STEP_SEED: int = 0x5A17C3D9
+_WARMED_BF16_FAST: set[tuple] = set()
+
+
+def _next_rng_seed() -> int:
+    """Advance Weyl-sequence RNG seed (`0x9E3779B9`) for stateless in-kernel `tl.rand` draws."""
+    global _RNG_STEP_SEED
+    _RNG_STEP_SEED = (_RNG_STEP_SEED + 0x9E3779B9) & 0x7FFFFFFF
+    return _RNG_STEP_SEED
+
+
+def _get_sampler_out_tok(device: torch.device, batch_size: int) -> torch.Tensor:
+    """Return a stream-keyed 8-slot ring-buffered `[B, 1]` int32 output tensor (`<= 8` streams)."""
+    raw_stream = 0
+    if device.type == "cuda" and _GET_RAW_STREAM is not None:
+        dev_idx = device.index if device.index is not None else _GET_DEVICE()
+        raw_stream = int(_GET_RAW_STREAM(dev_idx))
+    s_key = (device, raw_stream)
+    entry = _SAMPLER_OUT_RING.get(s_key)
+    if entry is None:
+        if len(_SAMPLER_OUT_RING) >= 8:
+            _SAMPLER_OUT_RING.pop(next(iter(_SAMPLER_OUT_RING)), None)
+        entry = [
+            torch.empty((8, max(batch_size, 256), 1), dtype=torch.int32, device=device),
+            0,
+        ]
+        _SAMPLER_OUT_RING[s_key] = entry
+    elif entry[0].shape[1] < batch_size:
+        entry[0] = torch.empty((8, max(batch_size, 256), 1), dtype=torch.int32, device=device)
+    slot = entry[1]
+    entry[1] = (slot + 1) & 7
+    return entry[0][slot, :batch_size]
+
+
+def _get_sampler_bufs(device: torch.device, batch_size: int, buf_cap: int = 4096):
+    """Return cached `(buf_x, buf_idx)` FP32/INT32 scratch buffers sized for at least `batch_size` rows."""
+    key = (device, buf_cap)
+    alloc_b = max(batch_size, 256)
+    if key not in _SAMPLER_BUFS or _SAMPLER_BUFS[key][0].shape[0] < batch_size:
+        if key not in _SAMPLER_BUFS and len(_SAMPLER_BUFS) >= 8:
+            _SAMPLER_BUFS.pop(next(iter(_SAMPLER_BUFS)), None)
+        _SAMPLER_BUFS[key] = (
+            torch.empty((alloc_b, buf_cap), dtype=torch.float32, device=device),
+            torch.empty((alloc_b, buf_cap), dtype=torch.int32, device=device),
+        )
+    return _SAMPLER_BUFS[key]
+
+
+def _sample_exp_noise(
+    logits: torch.Tensor,
+    generators: dict[int, torch.Generator] | None,
+) -> torch.Tensor:
+    """Draw `[B, V]` FP32 Exp(1) noise for Gumbel-Max sampling, honoring per-row `generators`."""
+    B, V = logits.shape
+    q = torch.empty((B, V), dtype=torch.float32, device=logits.device)
+    if not generators or len(generators) != B:
+        q.exponential_()
+    if generators:
+        for i, generator in generators.items():
+            if i < B:
+                q[i].exponential_(generator=generator)
+    return q
+
+
+def apply_top_k_top_p_metax(
+    logits: torch.Tensor,
+    k: torch.Tensor | None,
+    p: torch.Tensor | None,
+) -> torch.Tensor:
+    """In-place sort-free Top-K and Top-P logits masking on MetaX."""
+    if p is None and k is None:
+        return logits
+    B, V = logits.shape
+    if B == 0:
+        return logits
+
+    BLOCK_SIZE = 4096
+    BUF_CAP = 4096
+    NUM_TILES = (V + BLOCK_SIZE - 1) // BLOCK_SIZE
+    buf_x, buf_idx = _get_sampler_bufs(logits.device, B, BUF_CAP)
+
+    if k is not None:
+        _metax_topk_kernel[(B,)](
+            logits,
+            logits.stride(0),
+            k,
+            buf_x,
+            VOCAB_SIZE=V,
+            BLOCK_SIZE=BLOCK_SIZE,
+            BUF_CAP=BUF_CAP,
+            NUM_TILES=NUM_TILES,
+            num_warps=8,
+        )
+
+    if p is not None:
+        split_tail = (V > BLOCK_SIZE) and (logits.stride(0) % 16 == 0)
+        _metax_topp_kernel[(B,)](
+            logits,
+            logits.stride(0),
+            p,
+            buf_x,
+            buf_idx,
+            logits,
+            logits.stride(0),
+            buf_idx,
+            VOCAB_SIZE=V,
+            BLOCK_SIZE=BLOCK_SIZE,
+            BUF_CAP=BUF_CAP,
+            NUM_TILES=NUM_TILES,
+            WRITE_LOGITS=True,
+            FUSE_SAMPLE=False,
+            Q_MASK=0,
+            HAS_TEMP=False,
+            ALL_RANDOM=True,
+            OUT_INT32=False,
+            SPLIT_TAIL=split_tail,
+            num_warps=8,
+        )
+
+    return logits
+
+
+def topk_topp_forward_metax(
+    logits: torch.Tensor,
+    generators: dict[int, torch.Generator] | None = None,
+    k: torch.Tensor | None = None,
+    p: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Fused sort-free Top-K + Top-P + Gumbel-Max categorical sampling (int64 output)."""
+    B, V = logits.shape
+    if B == 0:
+        return torch.empty((0,), dtype=torch.int64, device=logits.device)
+    if p is None:
+        logits = apply_top_k_top_p_metax(logits, k, None)
+        probs = logits.softmax(dim=-1, dtype=torch.float32)
+        q = _sample_exp_noise(logits, generators)
+        return probs.div_(q).argmax(dim=-1)
+
+    BLOCK_SIZE = 4096
+    BUF_CAP = 4096
+    NUM_TILES = (V + BLOCK_SIZE - 1) // BLOCK_SIZE
+    buf_x, buf_idx = _get_sampler_bufs(logits.device, B, BUF_CAP)
+
+    if k is not None:
+        _metax_topk_kernel[(B,)](
+            logits,
+            logits.stride(0),
+            k,
+            buf_x,
+            VOCAB_SIZE=V,
+            BLOCK_SIZE=BLOCK_SIZE,
+            BUF_CAP=BUF_CAP,
+            NUM_TILES=NUM_TILES,
+            num_warps=8,
+        )
+
+    use_tl_rand = (not generators) and (V > 4096)
+    if use_tl_rand:
+        # Reuse `stride_qm` to pass the Weyl RNG seed; `Q_MASK=4095` enables lane-constant Gumbel draws.
+        q = logits
+        q_stride = _next_rng_seed()
+        q_mask = 4095
+    else:
+        q = _sample_exp_noise(logits, generators)
+        q_stride = q.stride(0)
+        q_mask = 0
+
+    out_tok = torch.empty((B,), dtype=torch.int64, device=logits.device)
+    split_tail = (V > BLOCK_SIZE) and (logits.stride(0) % 16 == 0)
+    _metax_topp_kernel[(B,)](
+        logits,
+        logits.stride(0),
+        p,
+        buf_x,
+        buf_idx,
+        q,
+        q_stride,
+        out_tok,
+        VOCAB_SIZE=V,
+        BLOCK_SIZE=BLOCK_SIZE,
+        BUF_CAP=BUF_CAP,
+        NUM_TILES=NUM_TILES,
+        WRITE_LOGITS=False,
+        FUSE_SAMPLE=True,
+        Q_MASK=q_mask,
+        HAS_TEMP=False,
+        ALL_RANDOM=True,
+        OUT_INT32=False,
+        SPLIT_TAIL=split_tail,
+        USE_TL_RAND=use_tl_rand,
+        num_warps=8,
+        num_stages=3,
+    )
+    return out_tok
+
+
+def prewarm_topk_topp_metax(
+    logits: torch.Tensor | None = None,
+    top_p: torch.Tensor | None = None,
+    temperature: torch.Tensor | None = None,
+    *,
+    device: torch.device | str = "cuda:0",
+    dtype: torch.dtype = torch.bfloat16,
+    vocab_size: int = 131072,
+    force: bool = False,
+) -> bool:
+    """Pre-compile reachable BF16 fused Top-P + temperature Gumbel-Max specializations."""
+    if logits is not None:
+        dev = logits.device
+        dt = logits.dtype
+        V = logits.shape[1]
+        stride_m = logits.stride(0)
+    else:
+        dev = torch.device(device)
+        dt = dtype
+        V = int(vocab_size)
+        stride_m = V
+
+    BLOCK_SIZE = 4096
+    if V <= BLOCK_SIZE:
+        return False
+    split_tail = (V > BLOCK_SIZE) and (stride_m % 16 == 0)
+    warm_key = (dev, dt, V, split_tail)
+    if not force and warm_key in _WARMED_BF16_FAST:
+        return False
+    _WARMED_BF16_FAST.add(warm_key)
+
+    BUF_CAP = 4096
+    NUM_TILES = (V + BLOCK_SIZE - 1) // BLOCK_SIZE
+    _, buf_idx = _get_sampler_bufs(dev, 1, BUF_CAP)
+    row_w = logits[:1] if logits is not None else torch.zeros((1, V), dtype=dt, device=dev)
+    p_w = top_p[:1] if top_p is not None else torch.full((1,), 0.9, dtype=torch.float32, device=dev)
+    t_w = temperature[:1] if temperature is not None else torch.ones((1,), dtype=torch.float32, device=dev)
+    out_w = torch.empty((1, 1), dtype=torch.int32, device=dev)
+    for ar_flag in (True, False):
+        _metax_topp_kernel[(1,)](
+            row_w, stride_m, p_w, t_w, buf_idx, row_w, 12345, out_w,
+            VOCAB_SIZE=V, BLOCK_SIZE=BLOCK_SIZE, BUF_CAP=BUF_CAP, NUM_TILES=NUM_TILES,
+            WRITE_LOGITS=False, FUSE_SAMPLE=True, Q_MASK=4095, HAS_TEMP=True,
+            ALL_RANDOM=ar_flag, OUT_INT32=True, SPLIT_TAIL=split_tail, USE_TL_RAND=True,
+            num_warps=8, num_stages=3,
+        )
+    return True
+
+
+def fused_topp_gumbel_sample_metax(
+    logits: torch.Tensor,
+    top_p: torch.Tensor,
+    temperature: torch.Tensor,
+    generators: dict[int, torch.Generator] | None = None,
+    all_random: bool = True,
+) -> torch.Tensor:
+    """Single-launch fused temperature + Top-P + Gumbel-Max categorical sampler (int32 [B, 1])."""
+    B, V = logits.shape
+    if B == 0:
+        return torch.empty((0, 1), dtype=torch.int32, device=logits.device)
+
+    BLOCK_SIZE = 4096
+    BUF_CAP = 4096
+    NUM_TILES = (V + BLOCK_SIZE - 1) // BLOCK_SIZE
+    split_tail = (V > BLOCK_SIZE) and (logits.stride(0) % 16 == 0)
+
+    _, buf_idx = _get_sampler_bufs(logits.device, B, BUF_CAP)
+    use_tl_rand = (not generators) and (V > 4096)
+    if use_tl_rand:
+        # Reuse `stride_qm` to pass the Weyl RNG seed; `Q_MASK=4095` enables lane-constant Gumbel draws.
+        q = logits
+        q_stride = _next_rng_seed()
+        q_mask = 4095
+    else:
+        q = _sample_exp_noise(logits, generators)
+        q_stride = q.stride(0)
+        q_mask = 0
+
+    out_tok = _get_sampler_out_tok(logits.device, B)
+    _metax_topp_kernel[(B,)](
+        logits,
+        logits.stride(0),
+        top_p,
+        temperature,
+        buf_idx,
+        q,
+        q_stride,
+        out_tok,
+        VOCAB_SIZE=V,
+        BLOCK_SIZE=BLOCK_SIZE,
+        BUF_CAP=BUF_CAP,
+        NUM_TILES=NUM_TILES,
+        WRITE_LOGITS=False,
+        FUSE_SAMPLE=True,
+        Q_MASK=q_mask,
+        HAS_TEMP=True,
+        ALL_RANDOM=bool(all_random),
+        OUT_INT32=True,
+        SPLIT_TAIL=split_tail,
+        USE_TL_RAND=use_tl_rand,
+        num_warps=8,
+        num_stages=3,
+    )
+    return out_tok
+
+
+def fl_fast_topp_gumbel_sample(
+    logits: torch.Tensor,
+    *,
+    p: torch.Tensor | None = None,
+    temp: torch.Tensor | None = None,
+    generators: dict[int, torch.Generator] | None = None,
+    out: torch.Tensor | None = None,
+    all_greedy: bool = False,
+    use_splitv: bool = True,
+) -> torch.Tensor:
+    """Unified `vllm_fl.worker.sampler` fast Top-P / Gumbel-Max / greedy entry point.
+
+    - `all_greedy=True`: dispatches directly to FlagGems' vectorized `argmax` (`0` softmax/RNG work).
+    - `generators is None`: enables stateless in-kernel `USE_TL_RAND=True` (`Q_MASK=4095` lane-constant
+      Gumbel divisor), eliminating `[B, V]` FP32 exponential noise allocation and HBM reads.
+    - `generators` present: falls back to exact per-request `torch.Generator` `_sample_exp_noise`.
+    """
+    _ = use_splitv
+    B, V = logits.shape
+    dev = logits.device
+    if out is None:
+        out = torch.empty((B,), dtype=torch.int32, device=dev)
+    if B == 0:
+        return out
+    if logits.stride(1) != 1:
+        logits = logits.contiguous()
+    contig_out = out.is_contiguous()
+    out_flat = out.view(-1) if contig_out else torch.empty((B,), dtype=out.dtype, device=dev)
+    if all_greedy:
+        # Batch-wide greedy fast path: skip Top-P / Gumbel kernel launch and run pure argmax.
+        from flag_gems.ops.argmax import argmax as _fg_argmax
+
+        _fg_argmax(logits, dim=-1, keepdim=False, out=out_flat)
+        if not contig_out:
+            out.view(-1).copy_(out_flat)
+        return out
+
+    has_topp = p is not None
+    has_temp = temp is not None
+    p_arg = (p.contiguous() if not p.is_contiguous() else p) if has_topp else logits
+    t_arg = (temp.contiguous() if not temp.is_contiguous() else temp) if has_temp else logits
+
+    BLOCK_SIZE = 4096
+    BUF_CAP = 4096
+    NUM_TILES = (V + BLOCK_SIZE - 1) // BLOCK_SIZE
+    split_tail = (V > BLOCK_SIZE) and (logits.stride(0) % 16 == 0)
+    _, buf_idx = _get_sampler_bufs(dev, B, BUF_CAP)
+
+    use_tl_rand = not generators
+    if use_tl_rand:
+        q = logits
+        q_stride = _next_rng_seed()
+        q_mask = 4095
+    else:
+        q = _sample_exp_noise(logits, generators)
+        q_stride = q.stride(0)
+        q_mask = 0
+
+    with torch.cuda.device(dev):
+        _metax_topp_kernel[(B,)](
+            logits,
+            logits.stride(0),
+            p_arg,
+            t_arg,
+            buf_idx,
+            q,
+            q_stride,
+            out_flat,
+            VOCAB_SIZE=V,
+            BLOCK_SIZE=BLOCK_SIZE,
+            BUF_CAP=BUF_CAP,
+            NUM_TILES=NUM_TILES,
+            WRITE_LOGITS=False,
+            FUSE_SAMPLE=True,
+            Q_MASK=q_mask,
+            HAS_TEMP=has_temp,
+            ALL_RANDOM=(not has_temp),
+            OUT_INT32=(out.dtype == torch.int32),
+            SPLIT_TAIL=split_tail,
+            USE_TL_RAND=use_tl_rand,
+            HAS_TOPP=has_topp,
+            num_warps=8,
+            num_stages=(3 if has_topp else 2),
+        )
+    if not contig_out:
+        out.view(-1).copy_(out_flat)
+    return out
+
+
+def prewarm_topp_sampler(
+    device: torch.device | str,
+    dtype: torch.dtype,
+    vocab_size: int,
+) -> None:
+    """Eagerly JIT-compile all reachable `(HAS_TOPP, HAS_TEMP, OUT_INT32, all_greedy)` specializations
+    at worker startup so serving steps never hit first-request Triton compilation latency.
+    """
+    prewarm_topk_topp_metax(device=device, dtype=dtype, vocab_size=vocab_size)
+    dev = torch.device(device)
+    V = int(vocab_size)
+    if V > 0:
+        lg = torch.zeros((1, V), dtype=dtype, device=dev)
+        p1 = torch.full((1,), 0.95, dtype=torch.float32, device=dev)
+        t1 = torch.ones((1,), dtype=torch.float32, device=dev)
+        o32 = torch.empty((1, 1), dtype=torch.int32, device=dev)
+        o64 = torch.empty((1,), dtype=torch.int64, device=dev)
+        fl_fast_topp_gumbel_sample(lg, p=p1, temp=t1, out=o32, all_greedy=False)
+        fl_fast_topp_gumbel_sample(lg, p=None, temp=t1, out=o32, all_greedy=False)
+        fl_fast_topp_gumbel_sample(lg, p=p1, temp=None, out=o64, all_greedy=False)
+        fl_fast_topp_gumbel_sample(lg, p=None, temp=None, out=o64, all_greedy=False)
+        fl_fast_topp_gumbel_sample(lg, out=o32, all_greedy=True)
+
+
+__all__ = [
+    "apply_top_k_top_p_metax",
+    "fl_fast_topp_gumbel_sample",
+    "fused_topp_gumbel_sample_metax",
+    "prewarm_topk_topp_metax",
+    "prewarm_topp_sampler",
+    "topk_topp_forward_metax",
+]
