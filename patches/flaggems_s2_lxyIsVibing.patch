+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Analytical MetaX C500 (`xcore1000`, Wave64) GEMM tile-packing, Split-K, and interval heuristics.
+
+Hardware First-Principles on MetaX C500 (`xcore1000`):
+- **Topology**: `104` Active CUs (`multi_processor_count == 104`), `warp_size = 64` (Wave64),
+  max `8` warps (`512` threads) per CTA, `32` hardware waves/CU, `64 KiB` LDS per CU, `8 MiB` L2.
+- **Wave64 `pipeline="basic"` 1x-Buffer LDS Law & 2-CTA/CU Co-Residency**:
+  Under MACA Triton `pipeline="basic"`, shared memory allocates `1x` tile buffer (`(BM + BN) * BK * elem_bytes`),
+  NOT `num_stages * buffer`. Keeping per-CTA LDS `<= 32 KiB` (e.g., `256x256x64` INT8 = `32 KiB`,
+  `256x192x32` BF16 = `28 KiB`, `256x160x32` BF16 = `26 KiB`) allows **2 CTAs/CU co-residency**,
+  overlapping one CTA's `global_load_lds_dwordx4` DMA with the peer CTA's Matrix Core `tl.dot`.
+- **MACA Compiler Hint Guardrails (`scenario="storeCoalesce"`)**:
+  `scenario="storeCoalesce"` stages the epilogue through shared memory for coalesced 128B HBM writes,
+  but MUST strictly require `EVEN_M=True` (`M % BM == 0`) and exact column coverage (`EVEN_N=True`);
+  when `EVEN_M=False`, shared-memory epilogue writes corrupt out-of-bounds masked boundary rows (`P4` trap),
+  and rescaling `int32` MFMA accumulators inside K-loops (`n_scale_groups > 1`) triggers `mxcc` NaNs.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import functools
+import math
+from typing import Any
+
+import triton
+
+from flag_gems.utils.fast_launcher import (
+    DisableAdjustBlockSize,
+    launch_compiled_kernel as _fast_launch_compiled_kernel,
+)
+from flag_gems.utils.quant_precondition import (
+    ACT_FUSED_ADD_RMS_NORM,
+    ACT_NONE,
+    ACT_RMS_NORM,
+    ACT_SILU_AND_MUL,
+    _select_act_quant_schedule,
+    register_act_quant_schedule,
+)
+from flag_gems.utils.tile_solver import (
+    DeviceTopology,
+    get_device_topology,
+    grid_efficiency,
+    merge_m_intervals,
+    solve_occupancy_adaptive_split_n,
+    split_subtile,
+    verify_lds_co_residency,
+)
+
+# Backward-compatible aliases exposing generic FlagGems topology helpers under MetaX names.
+MetaXDeviceCapabilities = DeviceTopology
+get_metax_capabilities = get_device_topology
+wave_efficiency = grid_efficiency
