+@functools.lru_cache(maxsize=512)
+def _solve_splitk_plan_cached(M: int, N: int, K: int, num_sms: int):
+    """Solve wave-aligned BF16 Split-K (`SPLIT_K in {2, 3, 4}`) for deep-K shapes (`K >= 3 * N`).
+
+    Instead of chopping `BM/BN` when `cdiv(M, BM) * (N // BN) < 104` CUs, keeps high-reuse tiles
+    intact (`256x256`, `128x128`, or Decode `64x64` / `32x64` / `16x64`) and splits `K` across CUs.
+    """
+    t_unit = max(1, num_sms // math.gcd(8, num_sms))
+    n_1round, m_full = (t_unit - 1) * 160 + 128, 8 * 256
+    if N > n_1round or (N % 256) != 0 or K < 3 * N or (K % 64) != 0:
+        return None
+    if (m_full < M <= m_full + 512) or (896 < M <= 1664):
+        bm, bn, bk, gm, warps, stages = 256, 256, 32, 8, 8, 2
+        sk_cands = (2, 3, 4) if (1024 < M <= 1664) else (3, 4, 2)
+        scen = "storeCoalesce" if (M % bm == 0) else ""
+    elif 192 <= M <= 896:
+        bm, bn, bk, gm, warps, stages = 128, 128, 64, 8, 8, 2
+        sk_cands = (2, 3, 4) if M > 512 else (3, 4, 2)
+        scen = "fullstage" if (M % bm == 0) else ""
+    elif 32 < M <= 64:
+        bk_d = 128 if (K % 384 == 0 or K % 512 == 0) else 64
+        bm, bn, bk, gm, warps, stages, scen, sk_cands = 64, 64, bk_d, 1, 8, 2, "", (3, 4, 2)
+    elif 16 < M <= 32 or M <= 4:
+        bk_d = 128 if (K % 384 == 0 or K % 512 == 0) else 64
+        bm, bn, bk, gm, warps, stages, scen, sk_cands = 32, 64, bk_d, 1, 8, 2, "", (3, 4, 2)
+    elif 4 < M <= 16:
+        bm, bn, bk, gm, warps, stages, scen, sk_cands = 16, 64, 64, 1, 4, 4, "", (3, 4, 2)
+    else:
+        return None
+    sk = next((s for s in sk_cands if K % (s * bk) == 0), 0)
+    if sk <= 1:
+        return None
+    even_m = (M % bm) == 0
+    return (sk, bm, bn, bk, gm, warps, stages, even_m, (triton.cdiv(M, bm) * (N // bn) * sk,), {"scenario": scen} if scen else {})
+
+
+def solve_splitk_plan(M: int, N: int, K: int, num_cus: int | None = None):
+    """Return wave-aligned BF16 Split-K plan for `(M, N, K)` on `num_cus` CUs, or `None`."""
+    return _solve_splitk_plan_cached(M, N, K, get_device_topology().num_sms if num_cus is None else num_cus)
+
+
+solve_wave_splitk_plan = solve_splitk_plan
+solve_tile_splitk_plan = solve_splitk_plan
+
+
+@functools.lru_cache(maxsize=512)
+def solve_bf16_nt_config(M: int, N: int, K: int, topo: DeviceTopology | None = None):
+    """Derive fallback single-region BF16 NT `(BM, BN, BK, GM, warps, stages, pipe, scen, pln)`.
+
+    Used when neither 2-region Diophantine wave packing nor deep-K Split-K applies (e.g. small-M
+    Decode or intermediate `M`). Keeps `pipeline="basic"` so `1x`-buffer LDS stays `<= 32 KiB`
+    (`256x256x32` = `32 KiB` -> `2 CTAs/CU`; `BK=64` on `256x256` would hit `64 KiB` and drop to
+    `1 CTA/CU`), and strictly gates `storeCoalesce` / `fullstage` on `M % BM == 0`.
+    """
+    if topo is None:
+        topo = get_device_topology()
+    C = topo.num_sms
+    t_unit = max(1, C // math.gcd(8, C))
+    n_1round = (t_unit - 1) * 160 + 128
+    wide_n, huge_n, mid_1r = triton.cdiv(N, 128) >= int(0.9 * C), triton.cdiv(N, 256) >= 2 * C, triton.cdiv(N, 192) <= (t_unit + 1)
+
+    # Small-M Decode regimes (M <= 64): narrow BM in {16, 32, 64} with `pipeline_load_num` (`pln`) hints.
+    if M <= 16:
+        if huge_n:
+            bn_h = 64 if N % 64 == 0 else 32
+            return (16, bn_h, 64, 1, 4, 4, "basic", "", 1 if bn_h == 64 else -1)
+        if wide_n:
+            return (16, 64, 64, 1, 4, 4, "basic", "storeCoalesce;dot_operands_out_loop" if (M % 16 == 0 and N % 64 == 0) else "", -1)
+        if N <= n_1round:
+            return (16, 32, 64, 1, 4, 4, "basic", "storeCoalesce" if (K >= 3 * N and M % 16 == 0 and N % 32 == 0) else "", 2)
+        return (16, 32 if N <= 2 * n_1round else 64, 64, 1, 4, 4, "basic", "", -1)
+    if M <= 32:
+        if huge_n:
+            return (32, 128 if N % 128 == 0 else 64, 64, 1, 8 if N % 128 == 0 else 4, 2, "basic", "", 1)
+        if wide_n:
+            return (32, 64, 64, 1, 4, 2, "basic", "", 2)
+        if mid_1r:
+            return (32, 32, 64, 1, 4, 4, "basic", "fullstage" if (M % 32 == 0) else "", 1 if (N <= n_1round and K >= 3 * N) else 2)
+        return (16, 64, 64, 1, 4, 4, "basic", "", 2) if N <= 2 * n_1round else (32, 64, 64, 1, 4, 4, "basic", "", -1)
+    if M <= 64:
+        if huge_n:
+            bn_h = 128 if N % 128 == 0 else 64
+            return (64, bn_h, 64, 1, 8 if bn_h == 128 else 4, 2, "basic", "", 1)
+        if wide_n:
+            return (64, 128, 64, 1, 8, 4, "basic", "storeCoalesce" if (M == 64 and N % 128 == 0) else "", -1)
+        if N <= n_1round and K >= 3 * N:
+            return (32, 32, 64, 1, 4, 4, "basic", "fullstage" if (M % 32 == 0) else "", 1)
+        if mid_1r and K >= 128 and (M > 48 or N > n_1round):
+            return (32, 64, 128, 1, 8, 2, "basic", "dot_operands_out_loop", -1)
+        if N <= n_1round:
+            return (16, 64, 64, 1, 4, 4, "basic", "", 2) if (M <= 48 and N == n_1round) else (32, 32, 64, 1, 4, 4, "basic", "", -1)
+        return (32, 64, 64, 2, 4, 4, "basic", "", -1)
+    if M <= 256:
+        if wide_n:
+            if M > 128:
+                bn_w = 128 if (huge_n and N % 256 != 0 and N % 128 == 0) else 256
+                return (128, bn_w, 64 if bn_w == 128 else 32, 4, 8, 2, "basic", "", 1 if (huge_n and bn_w == 128) else -1)
+            return (128, 128, 64, 4, 8, 2, "basic", "", -1)
+        if N % 128 == 0 and (M > 128 or N > 2 * n_1round):
+            return (64, 128, 64, 4, 8, 2, "basic", "", -1)
+        return (64, 64, 64, 4, 4, 4, "basic", "", -1)
+    # Large-M fallback (`M > 256`): keep 256x256 / 256x128 at BK=32 (`<= 32 KiB` LDS -> 2 CTAs/CU).
+    if N % 128 == 0 or wide_n:
+        if wide_n and K <= 2 * n_1round and (N % 128 == 0):
+            bn_w = 256 if (N % 256 == 0) else 128
+            gm_w = 4 if (huge_n and bn_w == 128) else 8
+            return (256, bn_w, 32, gm_w, 8, 2, "basic", "storeCoalesce" if (M % 256 == 0) else "", -1)
+        if N > n_1round and mid_1r and K <= n_1round and M >= 768:
+            bm_sel = 256 if M >= 1536 else 128
+            return (bm_sel, 256, 32, 8 if M >= 1024 else 1, 8, 2, "basic", "storeCoalesce" if (M % bm_sel == 0) else "", -1 if M >= 1024 else 2)
+        if N == n_1round:
+            sc_f = "fullstage" if (M % 128 == 0) else ""
+            if M >= 1664:
+                return (128, 128, 64, 1, 8, 2, "basic", sc_f, 1)
+            if M > 1024:
+                return (128, 256, 32, 4, 8, 2, "basic", sc_f, 2)
+            if M > 768:
+                return (128, 256, 32, 8, 8, 2, "basic", "storeCoalesce" if (M % 128 == 0) else "", -1)
+            return (128, 128, 64, 8, 8, 2, "basic", sc_f, 1 if sc_f else -1)
+        sc_def = "fullstage" if (M % 128 == 0 and N % 128 == 0) else ""
+        return (128, 128, 64, 8, 8, 2, "basic", sc_def, 1 if sc_def else -1)
+    return (64, 64, 64, 8, 4, 3, "cpasync", "", -1)
+
