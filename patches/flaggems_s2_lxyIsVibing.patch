+        if (slot_id == 0) & ((b_end - b_last) > 1):
+            seq, begin, qlen = NSEQS - 1, b_last, b_end - b_last
+        elif (slot_id == 1) & (NSEQS >= 2) & ((b_end - b_last) > 1):
+            b_prev = tl.load(CU + (NSEQS - 2) * CUS)
+            if (b_last - b_prev) > 1:
+                seq, begin, qlen = NSEQS - 2, b_prev, b_last - b_prev
+    if seq < 0:
+        c0 = tl.load(CU) if (NO_ZERO_LEN and FILTER == 1) else 0
+        found, s = 0, NSEQS - 1
+        while (s >= 0) & (seq < 0):
+            b0 = tl.load(CU + s * CUS)
+            ql = tl.load(CU + (s + 1) * CUS) - b0
+            if (ql > 1) if FILTER == 1 else (ql >= 1):
+                if found == slot_id:
+                    seq, begin, qlen = s, b0, ql
+                found += 1
+            s = (-1 if ((seq < 0) & (((b0 - c0) - s) < (slot_id + 1 - found))) else (s - 1)) if (NO_ZERO_LEN and FILTER == 1) else (s - 1)
+    return seq, begin, qlen
+
+
+# `O(1)` Prefill Sequence Resolver (`SEQ_HINT` / `prefill_seq_idx`):
+# In Mixed Chunked-Prefill + Decode batches (typically 1 prefill sequence + up to 255 decodes),
+# scanning `CU` (`query_start_loc`) inside every Stage-1/Stage-2 CTA wastes scalar memory reads.
+# Passing host-known `seq_hint = prefill_seq_idx` resolves `(seq, begin, qlen)` in two `O(1)` loads.
+@triton.jit
+def _locate_prefill_seq_hint(CU, NSEQS, slot_id, seq_hint, CUS: tl.constexpr, FILTER: tl.constexpr, NO_ZERO_LEN: tl.constexpr):
+    """Fast-path `O(1)` prefill sequence lookup using host `seq_hint`, falling back to `_locate_prefill_seq`."""
+    if (slot_id == 0) & (seq_hint >= 0):
+        b0 = tl.load(CU + seq_hint * CUS)
+        b1 = tl.load(CU + (seq_hint + 1) * CUS)
+        return seq_hint, b0, b1 - b0
+    return _locate_prefill_seq(CU, NSEQS, slot_id, CUS, FILTER, NO_ZERO_LEN)
+
+
+# ==============================================================================
+# Kernel 1: Fused Optional Per-Head QK-Norm + Q+K RoPE + `DG-R2-K8V4` Cache Write
+# ==============================================================================
+@triton.jit(do_not_specialize=["rms_eps"])
+def reshape_and_cache_k8v4_kernel(
+    q_in_ptr, q_out_ptr, k_in_ptr, v_in_ptr, positions_ptr, cos_sin_ptr, slot_mapping_ptr,
+    key_cache_ptr, value_cache_ptr, k_scale_ptr, v_scale_ptr,
+    q_norm_ptr, k_norm_ptr, rms_eps,
+    stride_qi_tok, stride_qo_tok, stride_ki_tok, stride_vi_tok, stride_cs_pos,
+    KC0: tl.constexpr, KC1: tl.constexpr, KC2: tl.constexpr,
+    VC0: tl.constexpr, VC1: tl.constexpr, VC2: tl.constexpr, VC3: tl.constexpr,
+    KS0: tl.constexpr, KS1: tl.constexpr, KS2: tl.constexpr,
+    VS0: tl.constexpr, VS1: tl.constexpr, VS2: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr, NUM_Q_HEADS: tl.constexpr, NUM_KV_HEADS: tl.constexpr, HEAD_DIM: tl.constexpr,
+    Q_PER_CTA: tl.constexpr, KV_PER_CTA: tl.constexpr, NUM_Q_GROUPS: tl.constexpr, TOTAL_GROUPS: tl.constexpr,
+    KV_MODE: tl.constexpr, FUSED_ROPE: tl.constexpr, PACKED_BF16X2: tl.constexpr,
+    USE_DB_LSQ: tl.constexpr, APPLY_V_H64: tl.constexpr, WIDE_KV: tl.constexpr,
+    HAS_QK_NORM: tl.constexpr = False,
+):
+    """Fused QK-Norm, NeoX RoPE, and paged KV cache writer (`KV_MODE=0`: BF16, `1`: K8V8, `2`: DG-R2-K8V4)."""
+    HALF_DIM: tl.constexpr = HEAD_DIM // 2
+    pid = tl.program_id(0)
+    tok, grp = pid // TOTAL_GROUPS, pid % TOTAL_GROUPS
+    d = tl.max_contiguous(tl.multiple_of(tl.arange(0, HALF_DIM), HALF_DIM), HALF_DIM)
+
+    if FUSED_ROPE:
+        pos = tl.maximum(tl.load(positions_ptr + tok).to(tl.int64), 0)
+        cs_base = cos_sin_ptr + pos * stride_cs_pos + d
+        cos, sin = tl.load(cs_base).to(tl.float32), tl.load(cs_base + HALF_DIM).to(tl.float32)
+
+    if FUSED_ROPE and grp < NUM_Q_GROUPS:
+        qh_base = grp * Q_PER_CTA
+        qi_tok, qo_tok = q_in_ptr + tok.to(tl.int64) * stride_qi_tok + d, q_out_ptr + tok.to(tl.int64) * stride_qo_tok + d
+        if HAS_QK_NORM:
+            qi_dtype: tl.constexpr = q_in_ptr.dtype.element_ty
+            qw1, qw2 = tl.load(q_norm_ptr + d), tl.load(q_norm_ptr + HALF_DIM + d)
+        for i in tl.static_range(0, Q_PER_CTA):
+            qh = qh_base + i
+            if qh < NUM_Q_HEADS:
+                q1, q2 = tl.load(qi_tok + qh * HEAD_DIM).to(tl.float32), tl.load(qi_tok + qh * HEAD_DIM + HALF_DIM).to(tl.float32)
+                if HAS_QK_NORM:
+                    rrms_q = 1.0 / tl.sqrt(tl.sum(q1 * q1 + q2 * q2, axis=0) * (1.0 / HEAD_DIM) + rms_eps)
+                    q1 = ((q1 * rrms_q).to(qi_dtype) * qw1).to(tl.float32)
+                    q2 = ((q2 * rrms_q).to(qi_dtype) * qw2).to(tl.float32)
+                tl.store(qo_tok + qh * HEAD_DIM, (q1 * cos - q2 * sin).to(q_out_ptr.dtype.element_ty))
+                tl.store(qo_tok + qh * HEAD_DIM + HALF_DIM, (q2 * cos + q1 * sin).to(q_out_ptr.dtype.element_ty))
+        return
+
+    slot = tl.load(slot_mapping_ptr + tok)
+    if slot < 0:
+        return
+    slot_i = slot.to(tl.int64) if WIDE_KV else slot.to(tl.int32)
+    if BLOCK_SIZE == 16:
+        blk, slot_in_blk = slot_i >> 4, slot_i & 15
+    else:
+        blk, slot_in_blk = slot_i // BLOCK_SIZE, slot_i % BLOCK_SIZE
+
+    kvh_base = (grp - NUM_Q_GROUPS) * KV_PER_CTA
+    ki_tok, vi_tok = k_in_ptr + tok.to(tl.int64) * stride_ki_tok + d, v_in_ptr + tok.to(tl.int64) * stride_vi_tok + d
+    kc_base = key_cache_ptr + blk * KC0 + slot_in_blk * KC1 + d
+    if HAS_QK_NORM:
+        ki_dtype: tl.constexpr = k_in_ptr.dtype.element_ty
+        kw1, kw2 = tl.load(k_norm_ptr + d), tl.load(k_norm_ptr + HALF_DIM + d)
+
+    for i in tl.static_range(0, KV_PER_CTA):
+        kvh = kvh_base + i
+        if kvh < NUM_KV_HEADS:
+            k1, k2 = tl.load(ki_tok + kvh * HEAD_DIM).to(tl.float32), tl.load(ki_tok + kvh * HEAD_DIM + HALF_DIM).to(tl.float32)
+            if HAS_QK_NORM:
+                rrms_k = 1.0 / tl.sqrt(tl.sum(k1 * k1 + k2 * k2, axis=0) * (1.0 / HEAD_DIM) + rms_eps)
+                k1 = ((k1 * rrms_k).to(ki_dtype) * kw1).to(tl.float32)
+                k2 = ((k2 * rrms_k).to(ki_dtype) * kw2).to(tl.float32)
+            v1, v2 = tl.load(vi_tok + kvh * HEAD_DIM).to(tl.float32), tl.load(vi_tok + kvh * HEAD_DIM + HALF_DIM).to(tl.float32)
+            if FUSED_ROPE:
+                ok1, ok2 = (k1 * cos - k2 * sin).to(tl.bfloat16).to(tl.float32), (k2 * cos + k1 * sin).to(tl.bfloat16).to(tl.float32)
+            else:
+                ok1, ok2 = k1, k2
+
+            if APPLY_V_H64 and HALF_DIM == 64:
+                for _vh in tl.static_range(0, 2):
+                    vx = tl.reshape(v1 if _vh == 0 else v2, (1, 32, 2))
+                    for _ in tl.static_range(6):
+                        va, vb = tl.split(vx)
+                        vx = tl.reshape(tl.permute(tl.join(va + vb, va - vb), (0, 2, 1)), (1, 32, 2))
+                    vx_out = tl.reshape(vx, (64,)) * 0.125
+                    if _vh == 0:
+                        v1 = vx_out
+                    else:
+                        v2 = vx_out
+
+            if KV_MODE == 0:
+                vc_base = value_cache_ptr + blk * VC0 + slot_in_blk * VC1 + kvh * VC2
+                tl.store(kc_base + kvh * KC2, ok1.to(key_cache_ptr.dtype.element_ty))
+                tl.store(kc_base + kvh * KC2 + HALF_DIM, ok2.to(key_cache_ptr.dtype.element_ty))
+                tl.store(vc_base + d * VC3, v1.to(value_cache_ptr.dtype.element_ty))
+                tl.store(vc_base + (d + HALF_DIM) * VC3, v2.to(value_cache_ptr.dtype.element_ty))
+            else:
+                k_amax = tl.maximum(tl.max(tl.abs(ok1), axis=0), tl.max(tl.abs(ok2), axis=0))
+                ks0 = tl.maximum(k_amax * (1.0 / 127.0), 1e-6)
+                kt0_1, kt0_2 = ok1 * (1.0 / ks0), ok2 * (1.0 / ks0)
+                kq1 = tl.clamp(tl.where(kt0_1 >= 0.0, kt0_1 + 0.5, kt0_1 - 0.5), -128.0, 127.0).to(tl.int8)
+                kq2 = tl.clamp(tl.where(kt0_2 >= 0.0, kt0_2 + 0.5, kt0_2 - 0.5), -128.0, 127.0).to(tl.int8)
+                if USE_DB_LSQ:
+                    ks_floor = tl.maximum(k_amax * (1.0 / 127.49), 1e-6)
+                    kqf0_1, kqf0_2 = kq1.to(tl.float32), kq2.to(tl.float32)
+                    kxq0 = tl.sum(ok1 * kqf0_1 + ok2 * kqf0_2, axis=0)
+                    kqq0 = tl.sum(kqf0_1 * kqf0_1 + kqf0_2 * kqf0_2, axis=0)
+                    ks_ls = tl.where(kqq0 > 0.0, tl.maximum(kxq0 / kqq0, 1e-6), ks0)
+                    ks_ce = tl.maximum(ks_ls.to(tl.bfloat16).to(tl.float32), 1e-6)
+                    ku_ce = ks_ce.to(tl.int32, bitcast=True)
+                    ku_lo_raw = tl.maximum(ku_ce - 65536, 8388608)
+                    ku_lo = tl.where(ku_lo_raw.to(tl.float32, bitcast=True) >= ks_floor, ku_lo_raw, ku_ce)
+                    ks_lo, ku_hi = ku_lo.to(tl.float32, bitcast=True), ku_ce + 65536
+                    ks_hi = ku_hi.to(tl.float32, bitcast=True)
+                    k_scale, ks_u32, k_phi = ks_ce, ku_ce, ks_ce * (ks_ce * kqq0 - 2.0 * kxq0)
+                    for _kc in tl.static_range(0, 3):
+                        sc_c = ks_ce if _kc == 0 else (ks_lo if _kc == 1 else ks_hi)
+                        uc_c = ku_ce if _kc == 0 else (ku_lo if _kc == 1 else ku_hi)
+                        inv_c = 1.0 / tl.maximum(sc_c, ks_floor)
+                        tc1, tc2 = ok1 * inv_c, ok2 * inv_c
+                        qc1 = tl.clamp(tl.where(tc1 >= 0.0, tc1 + 0.5, tc1 - 0.5), -128.0, 127.0).to(tl.int8)
+                        qc2 = tl.clamp(tl.where(tc2 >= 0.0, tc2 + 0.5, tc2 - 0.5), -128.0, 127.0).to(tl.int8)
+                        qfc1, qfc2 = qc1.to(tl.float32), qc2.to(tl.float32)
+                        xqc, qqc = tl.sum(ok1 * qfc1 + ok2 * qfc2, axis=0), tl.sum(qfc1 * qfc1 + qfc2 * qfc2, axis=0)
+                        phi_c = sc_c * (sc_c * qqc - 2.0 * xqc)
+                        win = phi_c < k_phi
+                        kq1, kq2 = tl.where(win, qc1, kq1), tl.where(win, qc2, kq2)
+                        k_scale, ks_u32, k_phi = tl.where(win, sc_c, k_scale), tl.where(win, uc_c, ks_u32), tl.minimum(k_phi, phi_c)
+                else:
+                    k_scale = ks0
+                    ks_u32 = ks0.to(tl.bfloat16).to(tl.float32).to(tl.int32, bitcast=True)
+
+                tl.store(kc_base + kvh * KC2, kq1)
+                tl.store(kc_base + kvh * KC2 + HALF_DIM, kq2)
+
+                if KV_MODE == 2:
+                    v_amax = tl.maximum(tl.max(tl.abs(v1), axis=0), tl.max(tl.abs(v2), axis=0))
+                    if USE_DB_LSQ:
+                        safe_vv = tl.maximum(tl.sum(v1 * v1 + v2 * v2, axis=0), 1e-12)
+                        vs0 = tl.maximum(v_amax * (0.94 / 7.25), 1e-6)
+                        vt0_1, vt0_2 = v1 * (1.0 / vs0), v2 * (1.0 / vs0)
+                        vq0_1 = tl.clamp(tl.where(vt0_1 >= 0.0, vt0_1 + 0.5, vt0_1 - 0.5), -8.0, 7.0).to(tl.int8)
+                        vq0_2 = tl.clamp(tl.where(vt0_2 >= 0.0, vt0_2 + 0.5, vt0_2 - 0.5), -8.0, 7.0).to(tl.int8)
+                        vqf0_1, vqf0_2 = vq0_1.to(tl.float32), vq0_2.to(tl.float32)
+                        vxq0, vqq0 = tl.sum(v1 * vqf0_1 + v2 * vqf0_2, axis=0), tl.sum(vqf0_1 * vqf0_1 + vqf0_2 * vqf0_2, axis=0)
+                        vs1 = tl.where(vqq0 > 0.0, tl.maximum(vxq0 / vqq0, 1e-6), vs0)
+                        vt1_1, vt1_2 = v1 * (1.0 / vs1), v2 * (1.0 / vs1)
+                        vq1 = tl.clamp(tl.where(vt1_1 >= 0.0, vt1_1 + 0.5, vt1_1 - 0.5), -8.0, 7.0).to(tl.int8)
+                        vq2 = tl.clamp(tl.where(vt1_2 >= 0.0, vt1_2 + 0.5, vt1_2 - 0.5), -8.0, 7.0).to(tl.int8)
+                        vqf1_1, vqf1_2 = vq1.to(tl.float32), vq2.to(tl.float32)
+                        vxq1, vqq1 = tl.sum(v1 * vqf1_1 + v2 * vqf1_2, axis=0), tl.sum(vqf1_1 * vqf1_1 + vqf1_2 * vqf1_2, axis=0)
+                        vs_ls = tl.where(vqq1 > 0.0, tl.maximum(vxq1 / vqq1, 1e-6), vs1)
+                        eff_qq1 = 0.75 * vqq1 + 0.25 * (vxq1 * vxq1 / safe_vv)
+                        vs_tgt = tl.where(vqq1 > 0.0, vs_ls * tl.clamp(vqq1 / tl.maximum(eff_qq1, 1e-12), 1.0, 1.025), vs1)
+                        vs_ce = tl.maximum(vs_tgt.to(tl.bfloat16).to(tl.float32), 1e-6)
+                        vu_ce = vs_ce.to(tl.int32, bitcast=True)
+                        vu_lo, vu_hi = tl.maximum(vu_ce - 65536, 8388608), vu_ce + 65536
+                        vs_lo, vs_hi = vu_lo.to(tl.float32, bitcast=True), vu_hi.to(tl.float32, bitcast=True)
+                        v_scale, vs_u32, v_phi = vs_ce, vu_ce, vs_ce * (vs_ce * eff_qq1 - 2.0 * vxq1)
+                        for _vc in tl.static_range(0, 3):
+                            sc_c = vs_ce if _vc == 0 else (vs_lo if _vc == 1 else vs_hi)
+                            uc_c = vu_ce if _vc == 0 else (vu_lo if _vc == 1 else vu_hi)
+                            tc1, tc2 = v1 * (1.0 / sc_c), v2 * (1.0 / sc_c)
+                            qc1 = tl.clamp(tl.where(tc1 >= 0.0, tc1 + 0.5, tc1 - 0.5), -8.0, 7.0).to(tl.int8)
+                            qc2 = tl.clamp(tl.where(tc2 >= 0.0, tc2 + 0.5, tc2 - 0.5), -8.0, 7.0).to(tl.int8)
+                            qfc1, qfc2 = qc1.to(tl.float32), qc2.to(tl.float32)
+                            xqc, qqc = tl.sum(v1 * qfc1 + v2 * qfc2, axis=0), tl.sum(qfc1 * qfc1 + qfc2 * qfc2, axis=0)
+                            phi_c = sc_c * (sc_c * (0.75 * qqc + 0.25 * (xqc * xqc / safe_vv)) - 2.0 * xqc)
+                            win = phi_c < v_phi
+                            vq1, vq2 = tl.where(win, qc1, vq1), tl.where(win, qc2, vq2)
+                            v_scale, vs_u32, v_phi = tl.where(win, sc_c, v_scale), tl.where(win, uc_c, vs_u32), tl.minimum(v_phi, phi_c)
+                    else:
+                        v_scale = tl.maximum(v_amax * (1.0 / 7.0), 1e-6)
+                        vs_u32 = v_scale.to(tl.bfloat16).to(tl.float32).to(tl.int32, bitcast=True)
+                        vt1, vt2 = v1 * (1.0 / v_scale), v2 * (1.0 / v_scale)
+                        vq1 = tl.clamp(tl.where(vt1 >= 0.0, vt1 + 0.5, vt1 - 0.5), -8.0, 7.0).to(tl.int8)
+                        vq2 = tl.clamp(tl.where(vt2 >= 0.0, vt2 + 0.5, vt2 - 0.5), -8.0, 7.0).to(tl.int8)
+                    tl.store(value_cache_ptr + blk * VC0 + slot_in_blk * VC1 + kvh * VC2 + d * VC3, ((vq1 & 0x0F) | (vq2 << 4)).to(tl.int8))
+                else:
+                    v_amax = tl.maximum(tl.max(tl.abs(v1), axis=0), tl.max(tl.abs(v2), axis=0))
+                    v_scale = tl.maximum(v_amax * (1.0 / 127.0), 1e-6)
+                    vs_u32 = v_scale.to(tl.bfloat16).to(tl.float32).to(tl.int32, bitcast=True)
+                    vt1, vt2 = v1 * (1.0 / v_scale), v2 * (1.0 / v_scale)
+                    vq1 = tl.clamp(tl.where(vt1 >= 0.0, vt1 + 0.5, vt1 - 0.5), -128.0, 127.0).to(tl.int8)
+                    vq2 = tl.clamp(tl.where(vt2 >= 0.0, vt2 + 0.5, vt2 - 0.5), -128.0, 127.0).to(tl.int8)
+                    vc_base = value_cache_ptr + blk * VC0 + slot_in_blk * VC1 + kvh * VC2
+                    tl.store(vc_base + d * VC3, vq1)
+                    tl.store(vc_base + (d + HALF_DIM) * VC3, vq2)
+
+                ks_off = blk * KS0 + slot_in_blk * KS1 + kvh * KS2
+                if PACKED_BF16X2:
+                    tl.store(k_scale_ptr + ks_off, ((ks_u32 >> 16) & 0xFFFF) | (vs_u32 & (-65536)))
+                else:
+                    tl.store(k_scale_ptr + ks_off, k_scale)
+                    tl.store(v_scale_ptr + blk * VS0 + slot_in_blk * VS1 + kvh * VS2, v_scale)
+
+
+# ==============================================================================
+# Kernel 2: 1-Warp Pure-TLE Split-KV Decode (`USE_K8V4: tl.constexpr`)
+#   - Uses `num_warps=1` (Wave64) keeping register footprint <= 128 VGPRs (2 waves/SIMD).
+#   - Quantizes `Q` online to INT8 for `Q @ K^T` INT32 SME dot, unrolls 2 physical pages
+#     (`step_tok = 32`) per loop in `K8V4` mode, unpacks signed INT4 `V` halves via arithmetic
+#     shifts (`(v << 4) >> 4` and `v >> 4`), and merges `[acc_lo, acc_hi]` via `tle.insert_tile`.
+# ==============================================================================
+@triton.jit
+def paged_gqa_decode_split_kv_tle_kernel(
+    Q, K, V, CU, LEN, BT, KS, VS, O, PA, PM, PL, NSEQS, TOTAL_Q, SM_SCALE_LOG2E,
+    QS: tl.constexpr, QH: tl.constexpr, QD: tl.constexpr, CUS: tl.constexpr, LS: tl.constexpr, BTS: tl.constexpr, BTC: tl.constexpr,
+    K0: tl.constexpr, K1: tl.constexpr, K2: tl.constexpr, K3: tl.constexpr,
+    V0: tl.constexpr, V1: tl.constexpr, V2: tl.constexpr, V3: tl.constexpr,
+    S0: tl.constexpr, S1: tl.constexpr, S2: tl.constexpr, T0: tl.constexpr, T1: tl.constexpr, T2: tl.constexpr,
+    NKV: tl.constexpr, GQA: tl.constexpr, PADDED_GQA: tl.constexpr, D: tl.constexpr, M: tl.constexpr,
+    SPLITS: tl.constexpr, USE_K8V4: tl.constexpr, INT8_KV: tl.constexpr, FLAGS: tl.constexpr,
+):
+    """1-warp TLE Split-KV paged GQA decode kernel supporting `DG-R2-K8V4`, `K8V8`, and `BF16` caches."""
+    FILTER: tl.constexpr = FLAGS & 7
+    SEQ_SCRATCH: tl.constexpr = (FLAGS & 64) != 0
+    WIDE_KV: tl.constexpr = (FLAGS & 128) != 0
+    ADAPTIVE_SPLITS: tl.constexpr = (FLAGS & 256) != 0
+    PACKED_BF16X2_SCALE: tl.constexpr = (FLAGS & 2048) != 0
+    FILTER_DECODE_ONLY: tl.constexpr = (FLAGS & 8192) != 0
+    MAX_Q_GT_1: tl.constexpr = (FLAGS & 16384) != 0
+    DB_LSQ_Q: tl.constexpr = (FLAGS & 32768) != 0
+    NHEADS: tl.constexpr = NKV * GQA
+    D_HALF: tl.constexpr = D // 2
+    qrows: tl.constexpr = M // PADDED_GQA
+    step_tok: tl.constexpr = 32 if USE_K8V4 else 16
+
+    sh, qb, sp = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    kh, seq = sh % NKV, sh // NKV
+
+    if FILTER_DECODE_ONLY or FILTER == 2:
+        if qb != 0:
+            return
+        q_start, q_end = tl.load(CU + seq * CUS).to(tl.int64), tl.load(CU + (seq + 1) * CUS).to(tl.int64)
+        if (q_end - q_start) != 1:
+            return
+        q_tok_idx, r = q_start, tl.arange(0, M)
+        h, length = kh * GQA + (r % PADDED_GQA), tl.load(LEN + seq * LS)
+        valid_dec, effective_splits = (r < GQA) & (q_tok_idx < TOTAL_Q), SPLITS
