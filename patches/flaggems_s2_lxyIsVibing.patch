+def fwht_lastdim_fp32(x: torch.Tensor, block_size: int = 64) -> torch.Tensor:
+    """Exact orthonormal power-of-two Fast Walsh-Hadamard Transform along the last dimension."""
+    if block_size < 2 or (block_size & (block_size - 1)) != 0:
+        raise ValueError(f"block_size must be a power of 2 >= 2, got {block_size}")
+    orig_shape = x.shape
+    if orig_shape[-1] % block_size != 0:
+        raise ValueError(f"Last dim {orig_shape[-1]} must be divisible by {block_size}")
+    work_dtype = torch.float64 if not x.is_cuda else torch.float32
+    y = x.to(work_dtype).reshape(-1, block_size)
+    h = 1
+    while h < block_size:
+        y = y.view(-1, block_size // (2 * h), 2, h)
+        a, b = y[:, :, 0, :], y[:, :, 1, :]
+        y = torch.stack((a + b, a - b), dim=2)
+        h *= 2
+    scale = 1.0 / math.sqrt(float(block_size))
+    return (y.reshape(orig_shape) * scale).to(torch.float32).contiguous()
+
+
+def make_deterministic_rademacher(dim: int, seed: int, device: torch.device | str) -> torch.Tensor:
+    """Generate a deterministic float32 +/-1.0 Rademacher sign vector on `device`."""
+    gen = torch.Generator(device="cpu")
+    gen.manual_seed(int(seed))
+    bits = torch.randint(0, 2, (dim,), generator=gen, device="cpu", dtype=torch.int32)
+    return (bits * 2 - 1).to(dtype=torch.float32).to(device=device)
+
