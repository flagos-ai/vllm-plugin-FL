+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Saliency-weighted multi-grid optimal clipping (SW-MGOC), orthogonal primitives,
+and universal pure-`tl.*` single-pass fused activation + FWHT-64 + INT8 quantizers.
+
+Key Hardware-Portable Mechanisms:
+  1. IEEE-754 FP32 magic-number round-to-nearest-even (`_rint_f32`) in 2 FADD ops,
+     avoiding vendor-specific `libdevice` / `tl.extra` dependencies.
+  2. Zero-LDS 6-stage butterfly Sylvester Fast Walsh-Hadamard Transform (`fwht64_zero_lds`)
+     executed purely in registers via rank-7 hypercube reshape and `tl.xor_sum`.
+  3. Single-pass VGPR-resident activation + optional FWHT-64 + symmetric INT8 quantization
+     (`fused_act_quant_kernel`) writing scales in `[NUM_SCALE_GROUPS, M]` contiguous-M layout
+     for coalesced GEMM tile consumption, eliminating intermediate HBM round-trips.
+  4. Dual-slot L2-hot Eager ring buffer plus backend-registered minimum-row backing
+     storage (`_alloc_q_and_s`) enabling zero-copy skinny-M 2D matrix-engine tile
+     promotion without extra padding kernels.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+import math
+from typing import Any
+
+import torch
+import triton
+import triton.language as tl
+
+from flag_gems.runtime import device, torch_device_fn
+from flag_gems.utils.fast_launcher import (
+    can_fast_launch,
+    get_fast_handle,
+    int_spec,
+    invoke_fast_handle,
+    launch_compiled_kernel,
+)
+
+ACT_NONE = 0
+ACT_RMS_NORM = 1
+ACT_FUSED_ADD_RMS_NORM = 2
+ACT_SILU_AND_MUL = 3
+
+_GET_DEVICE = getattr(torch._C, "_cuda_getDevice", torch.cuda.current_device)
+_GET_RAW_STREAM = getattr(torch._C, "_cuda_getCurrentRawStream", None)
+_IS_CAPTURING_FN = getattr(
+    torch._C, "_cuda_isCurrentStreamCapturing", torch.cuda.is_current_stream_capturing
+)
+_ACT_QUANT_META = {(w, 1): {"num_warps": w, "num_stages": 1} for w in (1, 2, 4, 8)}
+
+ActQuantScheduleFn = Callable[[int, int, int, bool, int], tuple[bool, int, int]]
+_ACT_QUANT_SCHEDULES: dict[str, ActQuantScheduleFn] = {}
+_RESOLVED_ACT_QUANT_SCHEDULE: tuple[str, ActQuantScheduleFn | None] | None = None
+_ACT_QUANT_MIN_ROWS: dict[str, int] = {}
+_EAGER_QUANT_RING: dict[tuple[int, int], list[Any]] = {}
+
+
+def register_act_quant_alloc_rows(vendor_name: str, min_rows: int) -> None:
+    """Register minimum physical row allocation (`>= 1`) for small-M quantized activations."""
+    if int(min_rows) < 1:
+        raise ValueError(f"min_rows must be >= 1, got {min_rows}")
+    _ACT_QUANT_MIN_ROWS[str(vendor_name)] = int(min_rows)
+
+
+def register_act_quant_schedule(
+    vendor_name: str, fn: ActQuantScheduleFn | None = None
+) -> Any:
+    """Register a backend `(m, k, act_mode, do_hadamard, eff_nsg) -> (is_exact, bk, warps)` callback."""
+
+    def _bind(cb: ActQuantScheduleFn) -> ActQuantScheduleFn:
+        global _RESOLVED_ACT_QUANT_SCHEDULE
+        _ACT_QUANT_SCHEDULES[vendor_name] = cb
+        _RESOLVED_ACT_QUANT_SCHEDULE = None
+        return cb
+
+    return _bind(fn) if fn is not None else _bind
+
+
+# Adding 12582912.0 (1.5 * 2^23) shifts an FP32 value (`|x| < 2^22`, well above INT8
+# range `[-127, 127]`) into the binade where 1 ULP == 1.0, forcing hardware IEEE-754
+# round-ties-to-even in the significand; subtracting 12582912.0 restores the rounded integer.
+@triton.jit
+def _rint_f32(x):
+    """Exact IEEE-754 round-half-to-even in FP32 (`|x| < 2^22`)."""
+    return (x + 12582912.0) - 12582912.0
+
+
+@triton.jit
+def _clamp_f32(x, lo, hi):
+    """Portable FP32 clamp using standard tl.minimum and tl.maximum."""
+    return tl.minimum(tl.maximum(x, lo), hi)
+
+
+@triton.jit
+def _saliency_weight(abs_w, GAMMA_MODE: tl.constexpr):
+    """Compute |w|^gamma via hardware square-root instructions."""
+    # GAMMA_MODE maps to gamma in {0: 0.0, 1: 0.25, 2: 0.50, 3: 0.75, 4: 1.0}.
+    if GAMMA_MODE == 0:
+        return abs_w * 0.0 + 1.0
+    elif GAMMA_MODE == 1:
+        return tl.sqrt(tl.sqrt(tl.maximum(abs_w, 1e-12)))
+    elif GAMMA_MODE == 2:
+        return tl.sqrt(tl.maximum(abs_w, 1e-12))
+    elif GAMMA_MODE == 3:
+        s1 = tl.sqrt(tl.maximum(abs_w, 1e-12))
+        return s1 * tl.sqrt(s1)
+    else:
+        return abs_w
+
+
+@triton.jit
+def _eval_lsq_alpha(w, omega, mask, inv_s0, EVEN_K: tl.constexpr):
+    """Evaluate closed-form LSQ reconstruction loss for one clipping scale `inv_s0`."""
+    q = _clamp_f32(_rint_f32(w * inv_s0), -127.0, 127.0)
+    if not EVEN_K:
+        q = tl.where(mask, q, 0.0)
+    # Closed-form optimal dequantization scale s* = (w . q) / (q . q) minimizing ||s*q - w||^2.
+    wq_sum = tl.sum(w * q, axis=0)
+    qq_sum = tl.sum(q * q, axis=0)
+    s_cand = tl.where(qq_sum > 0.0, wq_sum / tl.maximum(qq_sum, 1e-12), 1.0)
+    err = s_cand * q - w
+    return tl.sum(omega * err * err, axis=0)
+
+
+@triton.jit
+def _sw_mgoc_reg_kernel(
+    w_ptr, wq_ptr, ws_ptr, N, K, stride_wn, stride_wk, stride_qn, stride_qk,
+    BLOCK_K: tl.constexpr, EVEN_K: tl.constexpr, GAMMA_MODE: tl.constexpr, ALPHA_MIN: tl.constexpr,
+):
+    """Register-resident 2-stage coarse-to-fine LSQ SW-MGOC kernel for `K <= 8192`."""
+    pid = tl.program_id(0)
+    if pid >= N:
+        return
+    offs_k = tl.arange(0, BLOCK_K)
+    mask = offs_k < K
+    if EVEN_K:
+        w = tl.load(w_ptr + pid * stride_wn + offs_k * stride_wk).to(tl.float32)
+    else:
+        w = tl.load(w_ptr + pid * stride_wn + offs_k * stride_wk, mask=mask, other=0.0).to(tl.float32)
+
+    abs_w = tl.abs(w)
+    amax = tl.max(abs_w, axis=0)
+    safe_amax = tl.maximum(amax, 1e-8)
+    omega = _saliency_weight(abs_w, GAMMA_MODE)
+    if not EVEN_K:
+        omega = tl.where(mask, omega, 0.0)
+
+    # Stage 1: coarse 9-point grid search over [ALPHA_MIN, 1.0].
+    best_loss, best_alpha = 1e30, 1.0
+    coarse_step: tl.constexpr = (1.0 - ALPHA_MIN) * 0.125
+    for step in range(9):
+        alpha = ALPHA_MIN + step * coarse_step
+        loss = _eval_lsq_alpha(w, omega, mask, 127.0 / (safe_amax * alpha), EVEN_K)
+        imp = loss < best_loss
+        best_loss = tl.where(imp, loss, best_loss)
+        best_alpha = tl.where(imp, alpha, best_alpha)
+
+    # Stage 2: fine 9-point refinement (+/- 0.01 at 0.0025 step) around best coarse alpha.
+    c_alpha = best_alpha
+    fine_lo: tl.constexpr = ALPHA_MIN - 0.01
+    for step in range(9):
+        alpha = _clamp_f32(c_alpha + (step - 4) * 0.0025, fine_lo, 1.0)
+        loss = _eval_lsq_alpha(w, omega, mask, 127.0 / (safe_amax * alpha), EVEN_K)
+        imp = loss < best_loss
+        best_loss = tl.where(imp, loss, best_loss)
+        best_alpha = tl.where(imp, alpha, best_alpha)
+
+    # Final quantization and closed-form LSQ scale projection using the winning alpha.
+    inv_s_best = tl.where(amax > 0.0, 127.0 / (safe_amax * best_alpha), 0.0)
+    q_final = _clamp_f32(_rint_f32(w * inv_s_best), -127.0, 127.0)
+    if not EVEN_K:
+        q_final = tl.where(mask, q_final, 0.0)
+    wq_f = tl.sum(w * q_final, axis=0)
+    qq_f = tl.sum(q_final * q_final, axis=0)
+    s_opt = tl.where(qq_f > 0.0, wq_f / tl.maximum(qq_f, 1e-12), 1.0)
+
+    if EVEN_K:
+        tl.store(wq_ptr + pid * stride_qn + offs_k * stride_qk, q_final.to(tl.int8))
+    else:
+        tl.store(wq_ptr + pid * stride_qn + offs_k * stride_qk, q_final.to(tl.int8), mask=mask)
+    tl.store(ws_ptr + pid, s_opt)
+
+
+@triton.jit
+def _sw_mgoc_tiled_eval(row_ptr, K, stride_wk, inv_s0, BLOCK_K: tl.constexpr, GAMMA_MODE: tl.constexpr):
+    """Evaluate saliency-weighted LSQ loss for one clipping scale across a wide row via two tiled passes."""
+    rk = tl.arange(0, BLOCK_K)
+    # Pass 1: accumulate (w . q) and (q . q) across K-tiles to compute closed-form LSQ scale s_cand.
+    wq_sum, qq_sum = 0.0, 0.0
+    for start_k in range(0, K, BLOCK_K):
+        cols = start_k + rk
+        mask = cols < K
+        w = tl.load(row_ptr + cols * stride_wk, mask=mask, other=0.0).to(tl.float32)
+        q = tl.where(mask, _clamp_f32(_rint_f32(w * inv_s0), -127.0, 127.0), 0.0)
+        wq_sum += tl.sum(w * q, axis=0)
+        qq_sum += tl.sum(q * q, axis=0)
+    s_cand = tl.where(qq_sum > 0.0, wq_sum / tl.maximum(qq_sum, 1e-12), 1.0)
+    # Pass 2: accumulate saliency-weighted squared reconstruction error using s_cand.
+    loss = 0.0
+    for start_k in range(0, K, BLOCK_K):
+        cols = start_k + rk
+        mask = cols < K
+        w = tl.load(row_ptr + cols * stride_wk, mask=mask, other=0.0).to(tl.float32)
+        omega = tl.where(mask, _saliency_weight(tl.abs(w), GAMMA_MODE), 0.0)
+        q = tl.where(mask, _clamp_f32(_rint_f32(w * inv_s0), -127.0, 127.0), 0.0)
+        err = s_cand * q - w
+        loss += tl.sum(omega * err * err, axis=0)
+    return loss
+
+
+@triton.jit
+def _sw_mgoc_tiled_kernel(
+    w_ptr, wq_ptr, ws_ptr, N, K, stride_wn, stride_wk, stride_qn, stride_qk,
+    BLOCK_K: tl.constexpr, GAMMA_MODE: tl.constexpr, ALPHA_MIN: tl.constexpr,
+):
+    """Tiled multi-pass LSQ SW-MGOC kernel for wide rows (`K > 8192`)."""
+    pid = tl.program_id(0)
+    if pid >= N:
+        return
+    row_ptr, out_ptr, rk = w_ptr + pid * stride_wn, wq_ptr + pid * stride_qn, tl.arange(0, BLOCK_K)
+    amax = 0.0
+    for start_k in range(0, K, BLOCK_K):
+        cols = start_k + rk
+        mask = cols < K
+        w = tl.load(row_ptr + cols * stride_wk, mask=mask, other=0.0).to(tl.float32)
+        amax = tl.maximum(amax, tl.max(tl.where(mask, tl.abs(w), 0.0), axis=0))
+    safe_amax = tl.maximum(amax, 1e-8)
+
+    best_loss, best_alpha = 1e30, 1.0
+    coarse_step: tl.constexpr = (1.0 - ALPHA_MIN) * 0.125
+    for step in range(9):
+        alpha = ALPHA_MIN + step * coarse_step
+        loss = _sw_mgoc_tiled_eval(row_ptr, K, stride_wk, 127.0 / (safe_amax * alpha), BLOCK_K, GAMMA_MODE)
+        imp = loss < best_loss
+        best_loss = tl.where(imp, loss, best_loss)
+        best_alpha = tl.where(imp, alpha, best_alpha)
+
+    c_alpha = best_alpha
+    fine_lo: tl.constexpr = ALPHA_MIN - 0.01
+    for step in range(9):
+        alpha = _clamp_f32(c_alpha + (step - 4) * 0.0025, fine_lo, 1.0)
+        loss = _sw_mgoc_tiled_eval(row_ptr, K, stride_wk, 127.0 / (safe_amax * alpha), BLOCK_K, GAMMA_MODE)
+        imp = loss < best_loss
+        best_loss = tl.where(imp, loss, best_loss)
+        best_alpha = tl.where(imp, alpha, best_alpha)
+
+    inv_s_best = tl.where(amax > 0.0, 127.0 / (safe_amax * best_alpha), 0.0)
+    wq_f, qq_f = 0.0, 0.0
+    for start_k in range(0, K, BLOCK_K):
+        cols = start_k + rk
+        mask = cols < K
+        w = tl.load(row_ptr + cols * stride_wk, mask=mask, other=0.0).to(tl.float32)
+        q_final = tl.where(mask, _clamp_f32(_rint_f32(w * inv_s_best), -127.0, 127.0), 0.0)
+        wq_f += tl.sum(w * q_final, axis=0)
+        qq_f += tl.sum(q_final * q_final, axis=0)
+        tl.store(out_ptr + cols * stride_qk, q_final.to(tl.int8), mask=mask)
+    tl.store(ws_ptr + pid, tl.where(qq_f > 0.0, wq_f / tl.maximum(qq_f, 1e-12), 1.0))
+
+
+def _gamma_to_mode(gamma: float) -> int:
+    """Quantize continuous saliency exponent `gamma` into nearest discrete `GAMMA_MODE` in `0..4`."""
+    return 0 if gamma <= 0.125 else (1 if gamma <= 0.375 else (2 if gamma <= 0.625 else (3 if gamma <= 0.875 else 4)))
+
+
+def sw_mgoc_quantize_weight(
+    weight: torch.Tensor,
+    gamma: float | None = 0.0,
+    alpha_min: float = 0.80,
+    out_wq: torch.Tensor | None = None,
+    out_ws: torch.Tensor | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Quantize a 2D `[N, K]` weight matrix per-channel to INT8 via closed-form LSQ SW-MGOC."""
+    if weight.ndim != 2:
+        raise ValueError(f"sw_mgoc_quantize_weight expects 2D [N, K] tensor, got {weight.shape}")
+    N, K = weight.shape
+    if gamma is None:
+        gamma = 0.25 if N >= 2 * K else 0.50
+    g_mode, a_min = _gamma_to_mode(float(gamma)), float(alpha_min)
+    wq_out = out_wq if out_wq is not None else torch.empty((N, K), dtype=torch.int8, device=weight.device)
+    ws_out = out_ws if out_ws is not None else torch.empty((N,), dtype=torch.float32, device=weight.device)
+    if N == 0 or K == 0:
+        return wq_out, ws_out
+
+    s_wn, s_wk = weight.stride(0), weight.stride(1)
+    s_qn, s_qk = wq_out.stride(0), wq_out.stride(1)
+    with torch_device_fn.device(weight.device):
+        if K <= 8192:
+            block_k = max(64, triton.next_power_of_2(K))
+            _sw_mgoc_reg_kernel[(N,)](
+                weight, wq_out, ws_out, N, K, s_wn, s_wk, s_qn, s_qk,
+                BLOCK_K=block_k, EVEN_K=(K == block_k), GAMMA_MODE=g_mode, ALPHA_MIN=a_min,
+                num_warps=4 if block_k <= 2048 else 8,
+            )
+        else:
+            _sw_mgoc_tiled_kernel[(N,)](
+                weight, wq_out, ws_out, N, K, s_wn, s_wk, s_qn, s_qk,
+                BLOCK_K=2048, GAMMA_MODE=g_mode, ALPHA_MIN=a_min, num_warps=8,
+            )
+    return wq_out, ws_out
+
+
+# In-register 6-stage Sylvester Fast Walsh-Hadamard Transform (`H_64 / sqrt(64)`):
+# Reshaping `[BLOCK_M, 64]` into `[BLOCK_M, 2, 2, 2, 2, 2, 2]` maps each butterfly stage
+# `d in 1..6` (stride `2^(6-d)`) to an axis-aligned 2-element reduction. Bitcasting FP32
+# to INT32 and applying `bits ^ tl.xor_sum(bits, axis=d)` swaps butterfly partners via
+# compiler-emitted warp shuffles with zero shared memory (LDS) usage or barriers.
+@triton.jit
+def fwht64_zero_lds(u, row_mask=None, BLOCK_M: tl.constexpr = 1):
+    """Zero-shared-memory 6-stage butterfly Walsh-Hadamard transform on 64-element blocks."""
+    xr = tl.reshape(u.to(tl.float32), [BLOCK_M, 2, 2, 2, 2, 2, 2])
+    cols = tl.broadcast_to(tl.arange(0, 64)[None, :], [BLOCK_M, 64])
+    ir = tl.reshape(cols, [BLOCK_M, 2, 2, 2, 2, 2, 2])
+    for d in tl.static_range(1, 7):
+        stride = 1 << (6 - d)
+        bits = xr.to(tl.int32, bitcast=True)
+        partner = (bits ^ tl.xor_sum(bits, axis=d, keep_dims=True)).to(tl.float32, bitcast=True)
+        xr = tl.where((ir & stride) == 0, xr + partner, partner - xr)
+    if row_mask is not None:
+        xr = tl.where(tl.reshape(row_mask, [BLOCK_M, 1, 1, 1, 1, 1, 1]), xr, 0.0)
+    # Normalize by 1 / sqrt(64) = 0.125 so H_64 is strictly involutory & orthonormal.
+    return tl.reshape(xr, u.shape) * 0.125
+
+
+@triton.jit
+def _act_load_tile(
+    idx: tl.constexpr, x_ptr, r_ptr, offs,
+    K: tl.constexpr, BLOCK_K: tl.constexpr, ACT_MODE: tl.constexpr,
+    K_SPAN: tl.constexpr = 0, IS_MASKED: tl.constexpr = False,
+):
+    """Load tile `idx` of a row and apply pre-norm activation (identity, residual-add, or SiLU*Mul)."""
+    cols = idx * BLOCK_K + offs
+    if IS_MASKED:
+        m = cols < K_SPAN
+        g = tl.load(x_ptr + cols, mask=m, other=0.0).to(tl.float32)
+        if ACT_MODE == 3:
+            # SiLU(gate) * up with round-trip to input dtype to match unfused BF16/FP16 semantics.
+            u = tl.load(x_ptr + K + cols, mask=m, other=0.0).to(tl.float32)
+            return tl.where(m, ((g * tl.sigmoid(g)) * u).to(x_ptr.dtype.element_ty).to(tl.float32), 0.0)
+        elif ACT_MODE == 2:
+            # Fused residual addition updates `r_ptr` in place before RMSNorm.
+            v = g + tl.load(r_ptr + cols, mask=m, other=0.0).to(tl.float32)
+            tl.store(r_ptr + cols, v.to(x_ptr.dtype.element_ty), mask=m)
+            return tl.where(m, v, 0.0)
+        else:
+            return g
+    else:
+        g = tl.load(x_ptr + cols).to(tl.float32)
+        if ACT_MODE == 3:
+            return ((g * tl.sigmoid(g)) * tl.load(x_ptr + K + cols).to(tl.float32)).to(x_ptr.dtype.element_ty).to(tl.float32)
+        elif ACT_MODE == 2:
+            v = g + tl.load(r_ptr + cols).to(tl.float32)
+            tl.store(r_ptr + cols, v.to(x_ptr.dtype.element_ty))
+            return v
+        else:
+            return g
+
+
+@triton.jit
+def _act_xform_tile(
+    idx: tl.constexpr, xv, w_ptr, offs, rstd,
+    BLOCK_K: tl.constexpr, ACT_MODE: tl.constexpr, DO_HADAMARD: tl.constexpr,
+    K_SPAN: tl.constexpr = 0, IS_MASKED: tl.constexpr = False,
+):
+    """Apply RMSNorm weight scaling (when `ACT_MODE in {1, 2}`) and optional in-register FWHT-64."""
+    cols = idx * BLOCK_K + offs
+    if IS_MASKED:
+        m = cols < K_SPAN
+        w = tl.load(w_ptr + cols, mask=m, other=0.0).to(tl.float32) if (ACT_MODE == 1 or ACT_MODE == 2) else 1.0
+        y = (xv * rstd * w) if (ACT_MODE == 1 or ACT_MODE == 2) else xv
+    else:
+        y = (xv * rstd * tl.load(w_ptr + cols).to(tl.float32)) if (ACT_MODE == 1 or ACT_MODE == 2) else xv
+    return fwht64_zero_lds(y, BLOCK_M=BLOCK_K // 64) if DO_HADAMARD else y
+
+
+@triton.jit
+def _pick_reg_tile(idx: tl.constexpr, y0, y1, y2, y3, y4, y5, y6, y7):
+    """Compile-time static selector returning VGPR tile `y{idx}` from the 8-tile unrolled register bank."""
+    if idx == 0:
+        return y0
+    elif idx == 1:
+        return y1
+    elif idx == 2:
+        return y2
+    elif idx == 3:
+        return y3
+    elif idx == 4:
+        return y4
+    elif idx == 5:
+        return y5
+    elif idx == 6:
+        return y6
+    else:
+        return y7
+
+
+@triton.jit
+def _eval_act_tile_masked(
+    src_ptr, w_ptr, cols, mask, rstd,
+    K: tl.constexpr, BLOCK_K: tl.constexpr, ACT_MODE: tl.constexpr, DO_HADAMARD: tl.constexpr,
+):
+    """Evaluate one masked tile of activation + optional FWHT-64 for the multi-pass fallback path."""
+    x = tl.load(src_ptr + cols, mask=mask, other=0.0).to(tl.float32)
+    if ACT_MODE == 3:
+        u = tl.load(src_ptr + K + cols, mask=mask, other=0.0).to(tl.float32)
+        y = ((x * tl.sigmoid(x)) * u).to(src_ptr.dtype.element_ty).to(tl.float32)
+    elif ACT_MODE == 1 or ACT_MODE == 2:
+        y = x * rstd * tl.load(w_ptr + cols, mask=mask, other=0.0).to(tl.float32)
+    else:
+        y = x
+    return fwht64_zero_lds(y, BLOCK_M=BLOCK_K // 64) if DO_HADAMARD else y
+
+
+# Single-pass fused activation + optional FWHT-64 + symmetric INT8 quantization:
+#   - `ACT_MODE`: 0=Identity, 1=RMSNorm, 2=FusedAddRMSNorm (updates `RESIDUAL` in-place),
+#     3=SiLU-and-Mul (reads `[M, 2*K]` `[gate, up]` and emits `[M, K]`).
+#   - `OUT_S` layout: `[NUM_SCALE_GROUPS, M]` (row-contiguous along `M`), allowing
+#     downstream W8A8 GEMM CTAs to issue a single coalesced `[BLOCK_M]` load per K-group.
+#   - `USE_REG_PATH`: keeps up to 8 `BLOCK_K` tiles (`x0..x7` / `y0..y7`) pinned in VGPRs
+#     across normalization, FWHT-64 rotation, absmax reduction, and INT8 rounding so the
+#     entire row is read from HBM once and written once.
+@triton.jit(do_not_specialize=["eps"])
+def fused_act_quant_kernel(
+    X, RESIDUAL, WEIGHT, OUT_Q, OUT_S, M, stride_xm, stride_rm, eps,
+    K: tl.constexpr, BLOCK_K: tl.constexpr, IS_EXACT_REG: tl.constexpr,
+    ACT_MODE: tl.constexpr = 0, DO_HADAMARD: tl.constexpr = False, NUM_SCALE_GROUPS: tl.constexpr = 1,
+):
+    """Single-pass VGPR-resident pure-`tl.*` fused activation + optional FWHT-64 + INT8 quantizer."""
+    offs = tl.arange(0, BLOCK_K)
+    out_ty: tl.constexpr = X.dtype.element_ty
+    IS_NORM: tl.constexpr = (ACT_MODE == 1) or (ACT_MODE == 2)
+    SPLIT_GRP_CTA: tl.constexpr = (NUM_SCALE_GROUPS > 1) and (not IS_NORM)
+    K_SPAN: tl.constexpr = (K // NUM_SCALE_GROUPS) if SPLIT_GRP_CTA else K
+    EFF_GROUPS: tl.constexpr = 1 if SPLIT_GRP_CTA else NUM_SCALE_GROUPS
+
+    pid = tl.program_id(0).to(tl.int64)
+    if SPLIT_GRP_CTA:
+        row, grp = pid // NUM_SCALE_GROUPS, pid % NUM_SCALE_GROUPS
+        col_off = grp * K_SPAN
+        x_base, r_base = X + row * stride_xm + col_off, RESIDUAL + row * stride_rm + col_off
+        w_base, q_base = WEIGHT + col_off, OUT_Q + row * K + col_off
+        out_s_base, s_grp_stride = OUT_S + grp * tl.cast(M, tl.int64) + row, tl.cast(0, tl.int64)
+    else:
+        row = pid
+        x_base, r_base = X + row * stride_xm, RESIDUAL + row * stride_rm
+        w_base, q_base = WEIGHT, OUT_Q + row * K
+        out_s_base, s_grp_stride = OUT_S + row, tl.cast(M, tl.int64)
+
+    NS_CAND: tl.constexpr = (K_SPAN + BLOCK_K - 1) // BLOCK_K
+    TAIL_MASKED: tl.constexpr = (K_SPAN % BLOCK_K) != 0
+    USE_REG_PATH: tl.constexpr = (IS_EXACT_REG and (NS_CAND <= 8)) and (
+        ((not TAIL_MASKED) and ((NS_CAND % EFF_GROUPS) == 0))
+        or (TAIL_MASKED and (EFF_GROUPS == 1))
+    )
+    if USE_REG_PATH:
+        NS_B: tl.constexpr = NS_CAND
+        TILES_PER_G: tl.constexpr = NS_B // EFF_GROUPS
+
+        x0 = _act_load_tile(0, x_base, r_base, offs, K, BLOCK_K, ACT_MODE, K_SPAN, TAIL_MASKED and (NS_B == 1))
+        sq = (x0 * x0) if IS_NORM else 0.0
+        x1, x2, x3, x4, x5, x6, x7 = x0, x0, x0, x0, x0, x0, x0
+        if NS_B >= 2:
+            x1 = _act_load_tile(1, x_base, r_base, offs, K, BLOCK_K, ACT_MODE, K_SPAN, TAIL_MASKED and (NS_B == 2))
+            if IS_NORM:
+                sq += x1 * x1
+        if NS_B >= 3:
+            x2 = _act_load_tile(2, x_base, r_base, offs, K, BLOCK_K, ACT_MODE, K_SPAN, TAIL_MASKED and (NS_B == 3))
+            if IS_NORM:
+                sq += x2 * x2
+        if NS_B >= 4:
+            x3 = _act_load_tile(3, x_base, r_base, offs, K, BLOCK_K, ACT_MODE, K_SPAN, TAIL_MASKED and (NS_B == 4))
+            if IS_NORM:
+                sq += x3 * x3
+        if NS_B >= 5:
+            x4 = _act_load_tile(4, x_base, r_base, offs, K, BLOCK_K, ACT_MODE, K_SPAN, TAIL_MASKED and (NS_B == 5))
+            if IS_NORM:
+                sq += x4 * x4
+        if NS_B >= 6:
+            x5 = _act_load_tile(5, x_base, r_base, offs, K, BLOCK_K, ACT_MODE, K_SPAN, TAIL_MASKED and (NS_B == 6))
+            if IS_NORM:
+                sq += x5 * x5
+        if NS_B >= 7:
+            x6 = _act_load_tile(6, x_base, r_base, offs, K, BLOCK_K, ACT_MODE, K_SPAN, TAIL_MASKED and (NS_B == 7))
+            if IS_NORM:
+                sq += x6 * x6
+        if NS_B >= 8:
+            x7 = _act_load_tile(7, x_base, r_base, offs, K, BLOCK_K, ACT_MODE, K_SPAN, TAIL_MASKED and (NS_B == 8))
+            if IS_NORM:
+                sq += x7 * x7
+
+        rstd = (1.0 / tl.sqrt(tl.sum(sq, axis=0) * (1.0 / K) + eps)) if IS_NORM else 1.0
+        y0 = _act_xform_tile(0, x0, w_base, offs, rstd, BLOCK_K, ACT_MODE, DO_HADAMARD, K_SPAN, TAIL_MASKED and (NS_B == 1))
+        y1, y2, y3, y4, y5, y6, y7 = y0, y0, y0, y0, y0, y0, y0
+        if NS_B >= 2:
+            y1 = _act_xform_tile(1, x1, w_base, offs, rstd, BLOCK_K, ACT_MODE, DO_HADAMARD, K_SPAN, TAIL_MASKED and (NS_B == 2))
+        if NS_B >= 3:
+            y2 = _act_xform_tile(2, x2, w_base, offs, rstd, BLOCK_K, ACT_MODE, DO_HADAMARD, K_SPAN, TAIL_MASKED and (NS_B == 3))
+        if NS_B >= 4:
+            y3 = _act_xform_tile(3, x3, w_base, offs, rstd, BLOCK_K, ACT_MODE, DO_HADAMARD, K_SPAN, TAIL_MASKED and (NS_B == 4))
+        if NS_B >= 5:
+            y4 = _act_xform_tile(4, x4, w_base, offs, rstd, BLOCK_K, ACT_MODE, DO_HADAMARD, K_SPAN, TAIL_MASKED and (NS_B == 5))
+        if NS_B >= 6:
+            y5 = _act_xform_tile(5, x5, w_base, offs, rstd, BLOCK_K, ACT_MODE, DO_HADAMARD, K_SPAN, TAIL_MASKED and (NS_B == 6))
+        if NS_B >= 7:
+            y6 = _act_xform_tile(6, x6, w_base, offs, rstd, BLOCK_K, ACT_MODE, DO_HADAMARD, K_SPAN, TAIL_MASKED and (NS_B == 7))
+        if NS_B >= 8:
+            y7 = _act_xform_tile(7, x7, w_base, offs, rstd, BLOCK_K, ACT_MODE, DO_HADAMARD, K_SPAN, TAIL_MASKED and (NS_B == 8))
+
+        for g in tl.static_range(0, EFF_GROUPS):
+            vmax = tl.zeros((BLOCK_K,), dtype=tl.float32)
+            for sub in tl.static_range(0, TILES_PER_G):
+                yt = _pick_reg_tile(g * TILES_PER_G + sub, y0, y1, y2, y3, y4, y5, y6, y7)
+                vmax = tl.maximum(vmax, tl.abs(yt))
+            amax = tl.max(vmax, axis=0)
+            inv_s = tl.where(amax > 0.0, 127.0 / amax, 0.0)
+            s_ptr = out_s_base if EFF_GROUPS == 1 else (out_s_base + g * s_grp_stride)
+            tl.store(s_ptr, tl.maximum(amax * (1.0 / 127.0), 1e-12))
+            for sub in tl.static_range(0, TILES_PER_G):
+                yt = _pick_reg_tile(g * TILES_PER_G + sub, y0, y1, y2, y3, y4, y5, y6, y7)
+                q = _clamp_f32(_rint_f32(yt * inv_s), -127.0, 127.0).to(tl.int8)
+                if TAIL_MASKED and ((g * TILES_PER_G + sub) == (NS_B - 1)):
+                    c_tail = (NS_B - 1) * BLOCK_K + offs
+                    tl.store(q_base + c_tail, q, mask=c_tail < K_SPAN)
+                else:
+                    tl.store(q_base + (g * TILES_PER_G + sub) * BLOCK_K + offs, q)
+    else:
+        rstd = 1.0
+        if IS_NORM:
+            sq_acc = tl.zeros((BLOCK_K,), dtype=tl.float32)
+            for k0 in range(0, K, BLOCK_K):
+                cols = k0 + offs
+                m = cols < K
+                xv = tl.load(x_base + cols, mask=m, other=0.0).to(tl.float32)
+                if ACT_MODE == 2:
+                    xv = xv + tl.load(r_base + cols, mask=m, other=0.0).to(tl.float32)
+                    tl.store(r_base + cols, xv.to(out_ty), mask=m)
+                sq_acc += tl.where(m, xv * xv, 0.0)
+            rstd = 1.0 / tl.sqrt(tl.sum(sq_acc, axis=0) * (1.0 / K) + eps)
+
+        src_ptr = r_base if ACT_MODE == 2 else x_base
+        K_GRP: tl.constexpr = K_SPAN // EFF_GROUPS
+        for g in tl.static_range(0, EFF_GROUPS):
+            g_off = g * K_GRP
+            vmax = tl.zeros((BLOCK_K,), dtype=tl.float32)
+            for k0 in range(0, K_GRP, BLOCK_K):
+                cols = k0 + offs
+                m = cols < K_GRP
+                y = _eval_act_tile_masked(
+                    src_ptr + g_off, w_base + g_off, cols, m, rstd, K, BLOCK_K, ACT_MODE, DO_HADAMARD
+                )
+                vmax = tl.maximum(vmax, tl.where(m, tl.abs(y), 0.0))
+            amax = tl.max(vmax, axis=0)
+            inv_s = tl.where(amax > 0.0, 127.0 / amax, 0.0)
+            s_ptr = out_s_base if EFF_GROUPS == 1 else (out_s_base + g * s_grp_stride)
+            tl.store(s_ptr, tl.maximum(amax * (1.0 / 127.0), 1e-12))
+            for k0 in range(0, K_GRP, BLOCK_K):
+                cols = k0 + offs
+                m = cols < K_GRP
+                y = _eval_act_tile_masked(
+                    src_ptr + g_off, w_base + g_off, cols, m, rstd, K, BLOCK_K, ACT_MODE, DO_HADAMARD
+                )
+                q = _clamp_f32(_rint_f32(y * inv_s), -127.0, 127.0).to(tl.int8)
+                tl.store(q_base + g_off + cols, q, mask=m)
+
+
+def _select_act_quant_schedule(
+    k: int, act_mode: int, do_hadamard: bool, num_scale_groups: int, m: int = 2048
+) -> tuple[bool, int, int]:
+    """Select `(is_exact_reg, block_k, num_warps)` for single-pass `fused_act_quant_kernel`."""
+    k_grp = k // num_scale_groups
+    is_norm = act_mode in (ACT_RMS_NORM, ACT_FUSED_ADD_RMS_NORM)
+    k_span = k if (num_scale_groups == 1 or is_norm) else k_grp
+
+    if do_hadamard and k_span == 2048 and k_grp == 2048 and m > 512:
+        return True, 512, 4
+    if (k_grp % 1024 == 0) and (k_span % 1024 == 0) and (k_span <= 8192):
+        return True, 1024, (4 if (k_span <= 2048 or m <= 128) else 8)
+    if (k_grp % 512 == 0) and (k_span % 512 == 0) and (k_span <= 4096):
+        return True, 512, 4
+    if (k_grp & (k_grp - 1)) == 0 and 64 <= k_grp < 512 and (k_span // k_grp) <= 8:
+        return True, k_grp, max(1, k_grp // 128)
+    block_k = 512 if k_grp >= 512 else max(64, triton.next_power_of_2(k_grp))
+    return False, block_k, (4 if block_k >= 512 else 1)
+
+
+def _launch_fused_act_quant(
+    x_2d: torch.Tensor,
+    residual_2d: torch.Tensor | None,
+    norm_weight: torch.Tensor | None,
+    out_q: torch.Tensor,
+    out_s: torch.Tensor,
+    eps: float,
+    act_mode: int,
+    do_hadamard: bool,
+    num_scale_groups: int,
+) -> None:
+    """Validate inputs, select tile schedule, and dispatch `fused_act_quant_kernel` via fast-launch."""
+    m, k = x_2d.shape[0], out_q.shape[1]
+    if m == 0 or k == 0:
+        return
+    if num_scale_groups < 1 or (k % num_scale_groups) != 0:
+        raise ValueError(f"Invalid num_scale_groups={num_scale_groups} for K={k}")
+    if do_hadamard and ((k // num_scale_groups) % 64 != 0):
+        raise ValueError(
+            f"Group size {k // num_scale_groups} must be divisible by 64 when do_hadamard=True"
+        )
+    if x_2d.stride(1) != 1:
+        x_2d = x_2d.contiguous()
+    res_buf = residual_2d if residual_2d is not None else x_2d
+    if residual_2d is not None and res_buf.stride(1) != 1:
+        raise ValueError("residual_2d must have unit inner stride(1) == 1")
+    if norm_weight is None:
+        w_buf = x_2d
+    else:
+        w_buf = norm_weight if norm_weight.stride(-1) == 1 else norm_weight.contiguous()
+
+    # Collapse multi-group scales to a single group for large-M (prefill) non-norm GEMMs.
+    eff_nsg = (
+        1
+        if (num_scale_groups > 1 and act_mode in (ACT_NONE, ACT_SILU_AND_MUL) and m > 128)
+        else num_scale_groups
+    )
+    global _RESOLVED_ACT_QUANT_SCHEDULE
+    v_name = getattr(device, "vendor_name", "") or getattr(device, "vendor", "")
+    if _RESOLVED_ACT_QUANT_SCHEDULE is None or _RESOLVED_ACT_QUANT_SCHEDULE[0] != v_name:
+        _RESOLVED_ACT_QUANT_SCHEDULE = (v_name, _ACT_QUANT_SCHEDULES.get(v_name))
+    sched_fn = _RESOLVED_ACT_QUANT_SCHEDULE[1]
+    is_exact, block_k, warps = (
+        sched_fn(m, k, act_mode, do_hadamard, eff_nsg)
+        if sched_fn is not None
+        else _select_act_quant_schedule(k, act_mode, do_hadamard, eff_nsg, m)
+    )
+    grid_0 = m * eff_nsg if (eff_nsg > 1 and act_mode in (ACT_NONE, ACT_SILU_AND_MUL)) else m
+    dev_idx = x_2d.device.index if x_2d.device.index is not None else _GET_DEVICE()
+    s_xm, s_rm, eps_f = int(x_2d.stride(0)), int(res_buf.stride(0)), float(eps)
+    ptr_mask = x_2d.data_ptr() | out_q.data_ptr() | out_s.data_ptr()
+    if res_buf is not x_2d:
+        ptr_mask |= res_buf.data_ptr()
+    if w_buf is not x_2d:
+        ptr_mask |= w_buf.data_ptr()
+    aligned_16 = (ptr_mask & 15) == 0
+    spec_key = (
+        "fused_act_quant",
+        dev_idx,
+        x_2d.dtype,
+        k,
+        block_k,
+        is_exact,
+        act_mode,
+        do_hadamard,
+        eff_nsg,
+        warps,
+        int_spec(m),
+        int_spec(s_xm),
+        int_spec(s_rm),
+    )
+    rt_args = (x_2d, res_buf, w_buf, out_q, out_s, m, s_xm, s_rm, eps_f)
+    if aligned_16 and _GET_RAW_STREAM is not None:
+        handle = get_fast_handle(spec_key)
+        if handle is not None and can_fast_launch(0, disallow_when_profiling=True):
+            if _GET_DEVICE() == dev_idx:
+                invoke_fast_handle(handle, grid_0, 1, 1, _GET_RAW_STREAM(dev_idx), rt_args)
+            else:
+                with torch_device_fn.device(dev_idx):
+                    invoke_fast_handle(handle, grid_0, 1, 1, _GET_RAW_STREAM(dev_idx), rt_args)
+            return
+    full_args = (*rt_args, k, block_k, is_exact, act_mode, do_hadamard, eff_nsg)
+    if launch_compiled_kernel(
+        spec_key,
+        grid_0,
+        dev_idx,
+        aligned_16,
+        fused_act_quant_kernel,
+        rt_args,
+        full_args,
+        _ACT_QUANT_META[(warps, 1)],
+        disallow_when_profiling=True,
+    ):
+        return
+    with torch_device_fn.device(x_2d.device):
+        fused_act_quant_kernel[(grid_0,)](
+            *rt_args,
+            K=k,
+            BLOCK_K=block_k,
+            IS_EXACT_REG=is_exact,
+            ACT_MODE=act_mode,
+            DO_HADAMARD=do_hadamard,
+            NUM_SCALE_GROUPS=eff_nsg,
+            num_warps=warps,
+            num_stages=1,
+        )
+
+
+def _alloc_q_and_s(ref: torch.Tensor, m: int, k: int, nsg: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Allocate `(out_q, out_s)` for activation quantization with bounded L2 ring reuse.
+
+    1. Bounded Dual-Slot Eager L2-Hot Ring Buffer (`m >= 32` outside CUDA Graph capture):
+       Alternates between two preallocated `(q_raw, s_raw)` slots keyed by `(device, stream)`,
+       capped at 8 stream entries via FIFO eviction. Cycling 2 slots avoids allocator overhead
+       and keeps transient INT8 buffers hot in L2 without aliasing adjacent producer/consumer ops.
+    2. Backend-Registered Minimum Physical Rows (`m < min_rows`, default `min_rows = 1`):
+       Backends whose 2D matrix instructions require `M >= min_rows` register `min_rows > 1`;
+       when `m < min_rows`, allocates `torch.zeros((min_rows, k))[:m]` so padding rows are
+       deterministically zeroed while `min_rows == 1` backends allocate exact `(m, k)`.
+    """
+    if m >= 32 and k <= 32768 and nsg <= 8 and ref.is_cuda and not bool(_IS_CAPTURING_FN()):
+        dev_idx = ref.device.index if ref.device.index is not None else _GET_DEVICE()
+        r_key = (dev_idx, _GET_RAW_STREAM(dev_idx) if _GET_RAW_STREAM is not None else 0)
+        need_q, need_s = m * k, nsg * m
+        ring = _EAGER_QUANT_RING.get(r_key)
+        if ring is None:
+            if len(_EAGER_QUANT_RING) >= 8:
+                _EAGER_QUANT_RING.pop(next(iter(_EAGER_QUANT_RING)))
+            cap_q, cap_s = max(need_q, 2048 * 6144), max(need_s, 4 * 2048)
+            ring = [
+                torch.empty((cap_q,), dtype=torch.int8, device=ref.device),
+                torch.empty((cap_s,), dtype=torch.float32, device=ref.device),
+                torch.empty((cap_q,), dtype=torch.int8, device=ref.device),
+                torch.empty((cap_s,), dtype=torch.float32, device=ref.device),
+                0,
+            ]
+            _EAGER_QUANT_RING[r_key] = ring
+        slot = ring[4]
+        ring[4] = (slot + 1) & 1
+        qi = slot * 2
+        q_raw, s_raw = ring[qi], ring[qi + 1]
+        if q_raw.numel() < need_q:
+            q_raw = torch.empty((need_q,), dtype=torch.int8, device=ref.device)
+            ring[qi] = q_raw
+        if s_raw.numel() < need_s:
+            s_raw = torch.empty((need_s,), dtype=torch.float32, device=ref.device)
+            ring[qi + 1] = s_raw
+        return q_raw[:need_q].view(m, k), (s_raw[:m] if nsg == 1 else s_raw[:need_s].view(nsg, m))
+    v_name = getattr(device, "vendor_name", "") or getattr(device, "vendor", "")
+    min_rows = _ACT_QUANT_MIN_ROWS.get(v_name, 1)
+    s_shape = (m,) if nsg == 1 else (nsg, m)
+    q_buf = (
+        torch.zeros((min_rows, k), dtype=torch.int8, device=ref.device)[:m]
+        if 0 < m < min_rows
+        else torch.empty((m, k), dtype=torch.int8, device=ref.device)
+    )
+    return q_buf, torch.empty(s_shape, dtype=torch.float32, device=ref.device)
+
+
+def _fake_q_and_s(ref: torch.Tensor, m: int, k: int, nsg: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Allocate fake/meta `(out_q, out_s)` tensors for `torch.compile` CustomOp tracing."""
+    s_shape = (m,) if nsg == 1 else (nsg, m)
+    return ref.new_empty((m, k), dtype=torch.int8), ref.new_empty(s_shape, dtype=torch.float32)
+
+
+@torch.library.custom_op("flag_gems::quant_input", mutates_args=())
+def quant_input(
+    x_2d: torch.Tensor, do_hadamard: bool = False, num_scale_groups: int = 1
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Quantize a 2D `[M, K]` activation tensor to symmetric INT8 with optional FWHT-64."""
+    out_q, out_s = _alloc_q_and_s(x_2d, x_2d.shape[0], x_2d.shape[1], int(num_scale_groups))
+    _launch_fused_act_quant(
+        x_2d, None, None, out_q, out_s, 1e-5, ACT_NONE, bool(do_hadamard), int(num_scale_groups)
+    )
+    return out_q, out_s
+
