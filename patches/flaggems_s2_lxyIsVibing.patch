+        base_i32 = torch.tensor([], dtype=torch.int32, device=dev).set_(raw)
+        base_bf16 = torch.tensor([], dtype=torch.bfloat16, device=dev).set_(raw)
+        # Pack `(k_scale_bf16, v_scale_bf16)` into one int32 word initialized to `(1.0, 1.0)`.
+        packed_i32 = torch.as_strided(base_i32, size=(num_blocks, block_size, nkv), stride=(tail_bytes // 4, nkv, 1), storage_offset=data_bytes // 4)
