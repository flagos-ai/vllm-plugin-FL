@@ -0,0 +1,42 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Thin `weight_int8pack_mm` adapter routing to Iluvatar `quant_gemm_w8a16` SME GEMM.
+
+Routes `torch._weight_int8pack_mm(self, mat2, scales)` through the unified pure-Triton/TLE
+`flag_gems::quant_gemm_w8a16` custom op so packed INT8 weight-only projections automatically
+inherit CoreX `ivcore11` SME tiling (`M < 32` W8A16 and `M >= 32` dynamic W8A8 promotion)
+and `FastKernelLauncher` C-wrapper caching without bespoke non-Triton layouts.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+
+from flag_gems.ops.mm import mm as _fg_mm
+
+logger = logging.getLogger("flag_gems." + __name__)
+
+
+def weight_int8pack_mm(
+    self: torch.Tensor,
+    mat2: torch.Tensor,
+    scales: torch.Tensor,
+) -> torch.Tensor:
+    """Compute `self @ (mat2 * scales[:, None]).T` for `self: [M, K]` and `mat2: int8 [N, K]`."""
+    logger.debug("GEMS_ILUVATAR WEIGHT_INT8PACK_MM")
+    if self.ndim != 2 or mat2.ndim != 2:
+        raise ValueError(f"weight_int8pack_mm expects 2D tensors, got {self.shape} and {mat2.shape}")
+    if self.shape[1] != mat2.shape[1]:
+        raise ValueError(f"Incompatible K dimension: {self.shape} vs {mat2.shape}")
+    w_nk = mat2 if mat2.is_contiguous() else mat2.contiguous()
+    s_f32 = scales.reshape(-1) if scales.dtype == torch.float32 else scales.reshape(-1).to(torch.float32)
+    if self.is_cuda:
+        if self.dtype in (torch.bfloat16, torch.float16):
+            return torch.ops.flag_gems.quant_gemm_w8a16(self, w_nk, s_f32, None)
+        return _fg_mm(self.to(torch.float32), w_nk.to(torch.float32).t() * s_f32[None, :]).to(self.dtype)
+    return torch.matmul(self.to(torch.float32), w_nk.to(torch.float32).t() * s_f32[None, :]).to(self.dtype)
+
+
+__all__ = ["weight_int8pack_mm"]
