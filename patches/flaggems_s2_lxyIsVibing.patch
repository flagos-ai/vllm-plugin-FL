+        ram = tl.max_contiguous(tl.multiple_of(rm, BM), BM)
+    else:
+        ram = tl.max_contiguous(tl.multiple_of(rm % M, BM), BM)
+    rbn = tl.max_contiguous(tl.multiple_of(rn, BN), BN)
+    k_per_split: tl.constexpr = K // SPLIT_K
+    k_start = tl.multiple_of(pid_k * k_per_split, BK)
+    rk = tl.max_contiguous(tl.multiple_of(k_start + tl.arange(0, BK), BK), BK)
+
+    a_ptrs = A + (ram[:, None] * K + rk[None, :])
+    b_ptrs = B + (rk[:, None] + rbn[None, :] * K)
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for _ in range(0, k_per_split // BK):
+        a = tl.load(a_ptrs)
+        b = tl.load(b_ptrs)
+        acc = tl.dot(a, b, acc, out_dtype=tl.float32, allow_tf32=False)
+        a_ptrs += BK
+        b_ptrs += BK
+
+    c_ptrs = Partial + pid_k * (M * N) + (rm[:, None] * N + rn[None, :])
+    if EVEN_M:
+        tl.store(c_ptrs, acc.to(Partial.dtype.element_ty))
+    else:
+        tl.store(c_ptrs, acc.to(Partial.dtype.element_ty), mask=(rm < M)[:, None])
