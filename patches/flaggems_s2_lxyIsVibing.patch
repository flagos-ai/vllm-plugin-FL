+"""Cross-version Triton CompiledKernel fast-launch runtime.
+
+Standard Triton Python-side kernel invocation (`kernel[grid](*args, **kwargs)`)
+incurs ~6-15 us of CPU overhead per launch due to Python argument binding,
+`constexpr` filtering, specialization-key hashing, and hook dispatch. In LLM
+Decode and Mixed Chunked-Prefill regimes (`T_GPU < T_CPU`), this host overhead
+directly bottlenecks token throughput.
+
+This module extracts a cached C-wrapper launch tuple from a compiled Triton
+`CompiledKernel` (supporting both Triton 3.5+/3.6+ ABI-1 `run.launch` and
+legacy ABI-0 `run` callables) and invokes it directly on the raw CUDA stream
+when 16-byte pointer alignment holds and no debug/profiler/distributed hooks
+are active.
+"""
+
+import os
+from typing import Any
+
+import torch
+import triton
+
+from flag_gems.runtime import torch_device_fn
+
+_TRITON_DEBUG_ENV = os.environ.get("TRITON_DEBUG", "0") not in (
+    "0",
+    "",
+    "false",
+    "False",
+)
+_GET_RAW_STREAM = getattr(torch._C, "_cuda_getCurrentRawStream", None)
+_GET_DEVICE = getattr(torch._C, "_cuda_getDevice", torch.cuda.current_device)
+_PROFILER_ENABLED = getattr(torch.autograd, "_profiler_enabled", lambda: False)
+_COMPILED_KERNEL_CLS = getattr(getattr(triton, "compiler", None), "CompiledKernel", None)
+
+try:
+    _ENTER_CALLS = triton.knobs.runtime.launch_enter_hook.calls
+    _EXIT_CALLS = triton.knobs.runtime.launch_exit_hook.calls
+except Exception:
+    _ENTER_CALLS = ()
+    _EXIT_CALLS = ()
+
+try:
+    from flagtree import _flagprism
+
+    _FLAGPRISM_COMPONENTS = _flagprism._components
+except Exception:
+    _FLAGPRISM_COMPONENTS = ()
+
+try:
+    from triton.runtime._distributed import DistributedRtContext as _DistRtCtx
+except Exception:
+    _DistRtCtx = None
+
+_FAST_LAUNCH_ENABLED: bool = (_GET_RAW_STREAM is not None) and (not _TRITON_DEBUG_ENV)
+_GLOBAL_FAST_HANDLE_CACHE: dict[Any, tuple[Any, ...]] = {}
+
+
+def set_fast_launch_enabled(enabled: bool) -> bool:
+    """Enable or disable CompiledKernel fast launch; returns previous state."""
+    global _FAST_LAUNCH_ENABLED
+    prev = _FAST_LAUNCH_ENABLED
+    _FAST_LAUNCH_ENABLED = bool(enabled)
+    return prev
+
+
+def is_fast_launch_enabled() -> bool:
+    """Return whether CompiledKernel fast launch is currently enabled."""
+    return _FAST_LAUNCH_ENABLED
+
+
+def int_spec(v: int) -> int:
+    """Compute Triton runtime integer specialization bucket.
+
+    Mirrors Triton's JIT argument specialization rules so fast-launch cache keys
+    never alias kernels compiled with different vectorization or stride assumptions:
+      - `2`: `v == 1` (enables unit-stride address simplification)
+      - `0` / `1`: signed int32 (`[-2^31, 2^31 - 1]`), divisible by 16 (`0`) vs unaligned (`1`)
+      - `3` / `4`: int64 (`|v| >= 2^31`), divisible by 16 (`3`) vs unaligned (`4`)
+    """
+    return (
+        2
+        if v == 1
+        else (
+            (0 if (v & 15) == 0 else 1)
+            if -2147483648 <= v <= 2147483647
+            else (3 if (v & 15) == 0 else 4)
+        )
+    )
+
+
+class DisableAdjustBlockSize:
+    """Temporarily disable Triton autotuning adjust_block_size knob when present.
+
+    Prevents compiler-side automatic block-size rewriting (`aabs`) from silently
+    mutating hand-solved tile dimensions (`BLOCK_M`, `BLOCK_N`, `BLOCK_K`) that are
+    coupled to explicit tensor layouts or hardware matrix-engine shapes.
+    """
+
+    def __init__(self, disable: bool):
+        """Capture Triton's autotuning knobs object when `disable` is True."""
+        knobs = getattr(triton, "knobs", None)
+        self._ak = (
+            getattr(knobs, "autotuning", None)
+            if (disable and knobs is not None)
+            else None
+        )
+        self._prev = None
+
+    def __enter__(self):
+        """Save the previous `adjust_block_size` value and disable it."""
+        if self._ak is not None and hasattr(self._ak, "adjust_block_size"):
+            self._prev = self._ak.adjust_block_size
+            self._ak.adjust_block_size = False
+
+    def __exit__(self, *args):
+        """Restore the original `adjust_block_size` setting on exit."""
+        if self._ak is not None and self._prev is not None:
+            self._ak.adjust_block_size = self._prev
+
+
+def can_fast_launch(
+    ptr_mask_16b: int = 0, *, disallow_when_profiling: bool = False
+) -> bool:
+    """Check whether direct CompiledKernel launch bypasses are safe to execute.
+
+    Fast launch is only valid when:
+      1. Raw stream query (`_cuda_getCurrentRawStream`) is available and enabled.
+      2. Bitwise OR of all tensor data pointers is 16-byte aligned (`(ptr_mask_16b & 15) == 0`),
+         matching the compiled kernel's `tt.divisibility = 16` assumption.
+      3. Neither PyTorch Profiler (when `disallow_when_profiling=True`), Triton launch
+         enter/exit hooks, FlagPrism IR/counter hooks, `TRITON_DEBUG`, nor
+         `DistributedRtContext` are active; otherwise execution falls back cleanly
+         to standard Triton Python dispatch so observability tools remain intact.
+    """
+    if not _FAST_LAUNCH_ENABLED or _GET_RAW_STREAM is None:
+        return False
+    if (ptr_mask_16b & 15) != 0:
+        return False
+    if disallow_when_profiling and _PROFILER_ENABLED():
+        return False
+    if _COMPILED_KERNEL_CLS is not None and (
+        getattr(_COMPILED_KERNEL_CLS, "launch_enter_hook", None) is not None
+        or getattr(_COMPILED_KERNEL_CLS, "launch_exit_hook", None) is not None
+    ):
+        return False
+    if (_ENTER_CALLS is not None and bool(_ENTER_CALLS)) or (
+        _EXIT_CALLS is not None and bool(_EXIT_CALLS)
+    ):
+        return False
+    if _FLAGPRISM_COMPONENTS or _TRITON_DEBUG_ENV:
+        return False
+    if _DistRtCtx is not None and getattr(_DistRtCtx, "_init_count", 0):
+        return False
+    return True
+
+
+def get_fast_handle(spec_key: Any) -> tuple[Any, ...] | None:
+    """Look up a cached fast-launch handle by specialization key."""
+    return _GLOBAL_FAST_HANDLE_CACHE.get(spec_key)
+
+
+def store_fast_handle(spec_key: Any, handle: tuple[Any, ...] | None) -> None:
+    """Store an extracted fast-launch handle in the bounded global cache."""
+    if handle is None or spec_key is None:
+        return
+    # Evict the oldest entry (FIFO via dict insertion order) to bound cache memory.
+    if spec_key not in _GLOBAL_FAST_HANDLE_CACHE and len(_GLOBAL_FAST_HANDLE_CACHE) >= 8192:
+        _GLOBAL_FAST_HANDLE_CACHE.pop(next(iter(_GLOBAL_FAST_HANDLE_CACHE)), None)
+    _GLOBAL_FAST_HANDLE_CACHE[spec_key] = handle
+
+
+def extract_fast_handle(ck: Any, jit_fn: Any = None) -> tuple[Any, ...] | None:
+    """Introspect CompiledKernel ABI and build a zero-overhead launch tuple.
+
+    Supports two Triton C-extension launcher ABIs:
+      - ABI-1 (Triton 3.5+ / FlagTree 0.7+): `ck.run.launch` expects runtime arguments
+        followed by `None` placeholders for trailing `tl.constexpr` parameters. We verify
+        that all `constexpr` parameters sit contiguously at the tail of `arg_names` and
+        that the kernel uses no global/profile scratch memory, debug instrumentation,
+        or TMA tensor descriptors before caching the handle.
+      - ABI-0 (earlier Triton 3.x): `ck.run` is directly a C-callable accepting only
+        non-constexpr runtime arguments plus optional launch hooks.
+    """
+    if isinstance(ck, tuple) and ck:
+        ck = ck[0]
+    if ck is None:
+        return None
+    # Materialize lazy CUfunction / module handles on first compilation if needed.
+    if getattr(ck, "function", None) is None and callable(
+        init_fn := getattr(ck, "_init_handles", None)
+    ):
+        init_fn()
+    run_obj = getattr(ck, "run", None)
+    if run_obj is None:
+        return None
+    c_launch = getattr(run_obj, "launch", None)
+    if (
+        c_launch is not None
+        and hasattr(run_obj, "launch_cooperative_grid")
+        and hasattr(run_obj, "launch_pdl")
+    ):
+        # ABI-1 path: unwrap decorators (e.g., Heuristics / Autotuner) to inspect raw JITFunction.
+        raw_jit = jit_fn
+        while (
+            raw_jit is not None
+            and not hasattr(raw_jit, "constexprs")
+            and hasattr(raw_jit, "fn")
+        ):
+            raw_jit = raw_jit.fn
+        constexprs = getattr(raw_jit, "constexprs", ())
+        arg_names = getattr(raw_jit, "arg_names", ())
+        n_ce, n_args = len(constexprs), len(arg_names)
+        if n_ce > n_args:
+            return None
+        # ABI-1 fast invocation appends `*rt_args, *pad`, which requires all constexprs
+        # to appear strictly as the trailing parameters of the kernel signature.
+        if n_ce > 0:
+            tail_ok = (
+                tuple(constexprs) == tuple(range(n_args - n_ce, n_args))
+                if isinstance(constexprs[0], int)
+                else tuple(constexprs) == tuple(arg_names[n_args - n_ce :])
+            )
+            if not tail_ok:
+                return None
+        # Bail out if runtime scratch allocation or TMA descriptor setup is required per launch.
+        if getattr(ck, "global_scratch_size", 0) != 0 or getattr(run_obj, "global_scratch_size", 0) != 0:
+            return None
+        if getattr(ck, "profile_scratch_size", 0) != 0 or getattr(run_obj, "profile_scratch_size", 0) != 0:
+            return None
+        meta = getattr(ck, "metadata", None)
+        if meta is not None and (
+            bool(getattr(meta, "debug_enabled", False))
+            or bool(getattr(meta, "tensordesc_meta", None))
+        ):
+            return None
+        pad = (None,) * n_ce
+        # Keep `ck` at index 7 to prevent GC of the underlying unloaded CUmodule/CUfunction.
+        return (1, c_launch, ck.function, ck.packed_metadata, run_obj.launch_cooperative_grid, run_obj.launch_pdl, pad, ck)
+    if not callable(run_obj):
+        return None
+    # ABI-0 path: `run_obj` is the direct C-extension launcher; retain `ck` at index 4.
+    return (0, run_obj, ck.function, ck.packed_metadata, ck)
+
+
+def invoke_fast_handle(
+    handle: tuple[Any, ...], g0: int, g1: int, g2: int, stream: int, rt_args: tuple[Any, ...]
+) -> None:
+    """Invoke an ABI-0 or ABI-1 CompiledKernel handle directly on `stream`."""
+    if handle[0] == 1:
+        # ABI-1 signature: (gridX, gridY, gridZ, stream, cu_func, coop, pdl,
+        #                   enter_hook, exit_hook, packed_meta, launch_meta,
+        #                   global_scratch, profile_scratch, *rt_args, *constexpr_nones)
+        handle[1](g0, g1, g2, stream, handle[2], handle[4], handle[5], None, None, handle[3], None, None, None, *rt_args, *handle[6])
+        return
+    # ABI-0 path: forward launch hooks only if registered on CompiledKernel.
+    eh = _COMPILED_KERNEL_CLS.launch_enter_hook if _COMPILED_KERNEL_CLS is not None else None
+    if eh is None:
+        handle[1](g0, g1, g2, stream, handle[2], handle[3], None, None, None, *rt_args)
+    else:
+        handle[1](
+            g0, g1, g2, stream, handle[2], handle[3],
+            handle[4].launch_metadata((g0, g1, g2), stream, *rt_args),
+            eh, _COMPILED_KERNEL_CLS.launch_exit_hook, *rt_args,
+        )
+
+
+def launch_compiled_kernel(
+    spec_key: Any,
+    grid: int | tuple[int, ...],
+    dev_idx: int,
+    aligned_16: bool,
+    jit_fn: Any,
+    rt_args: tuple[Any, ...],
+    full_args: tuple[Any, ...] = (),
+    meta_kwargs: dict[str, Any] | None = None,
+    disable_aabs: bool = False,
+    *,
+    disallow_when_profiling: bool = False,
+    expected_orig_fn: Any = None,
+) -> bool:
+    """Fast-launch or compile-and-cache a Triton kernel; returns False if bypassed.
+
+    On a cache hit, dispatches directly through `invoke_fast_handle`. On a cold miss,
+    runs standard Triton `jit_fn[grid](...)` once to trigger compilation, extracts the
+    ABI handle, and caches it under `spec_key` for all subsequent calls.
+    Respects monkey-patching (`expected_orig_fn`) by returning `False` if a test or tool
+    replaced `jit_fn`.
+    """
+    if not aligned_16 or (expected_orig_fn is not None and jit_fn is not expected_orig_fn):
+        return False
+    if not can_fast_launch(0, disallow_when_profiling=disallow_when_profiling):
+        return False
+    # Normalize 1D/2D/3D grid specification into an explicit (g0, g1, g2) tuple.
+    if isinstance(grid, int):
+        g0, g1, g2 = grid, 1, 1
+    elif len(grid) == 1:
+        g0, g1, g2 = grid[0], 1, 1
+    elif len(grid) == 2:
+        g0, g1, g2 = grid[0], grid[1], 1
+    else:
+        g0, g1, g2 = grid[0], grid[1], grid[2]
+
+    # Hot path: dispatch directly via the cached C launcher handle on the raw stream.
+    handle = _GLOBAL_FAST_HANDLE_CACHE.get(spec_key)
+    if handle is not None:
+        if _GET_DEVICE() == dev_idx:
+            invoke_fast_handle(handle, g0, g1, g2, _GET_RAW_STREAM(dev_idx), rt_args)
+        else:
+            with torch_device_fn.device(dev_idx):
+                invoke_fast_handle(handle, g0, g1, g2, _GET_RAW_STREAM(dev_idx), rt_args)
+        return True
+
+    # Cold miss: compile/launch once through standard Triton and cache the extracted handle.
+    call_args = full_args if full_args else rt_args
+    kw = meta_kwargs or {}
+    if _GET_DEVICE() == dev_idx:
+        if disable_aabs:
+            with DisableAdjustBlockSize(True):
+                ck = jit_fn[(g0, g1, g2)](*call_args, **kw)
+        else:
+            ck = jit_fn[(g0, g1, g2)](*call_args, **kw)
+    else:
+        with torch_device_fn.device(dev_idx):
+            if disable_aabs:
+                with DisableAdjustBlockSize(True):
+                    ck = jit_fn[(g0, g1, g2)](*call_args, **kw)
+            else:
+                ck = jit_fn[(g0, g1, g2)](*call_args, **kw)
+    store_fast_handle(spec_key, extract_fast_handle(ck, jit_fn))
+    return True
+
+
+__all__ = [
+    "DisableAdjustBlockSize",
+    "can_fast_launch",
+    "extract_fast_handle",
+    "get_fast_handle",
+    "int_spec",
+    "invoke_fast_handle",
+    "is_fast_launch_enabled",
+    "launch_compiled_kernel",
+    "set_fast_launch_enabled",
+    "store_fast_handle",
+]
