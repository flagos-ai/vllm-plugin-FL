@@ -0,0 +1,464 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Immutable quantization layer configuration, GEMM tuning descriptors,
+typed `QuantWeightTensor` wrapper subclass, layout negotiation, and public
+`quant_gemm_w8a8` / `quant_gemm_w8a16` CustomOp facade.
+
+Design Rationale (Three-Tier Architectural Decoupling):
+  1. `QuantLayerConfig` captures the hardware-independent mathematical and
+     tensor-layout contract of a quantized Linear layer (`w8a8` vs `w8a16`,
+     optional 64-element Hadamard rotation, activation scale group count, and
+     contiguous vs block-interleaved Gate/Up columns).
+  2. `GemmTuningConfig` isolates chip-specific execution parameters (tile shape,
+     warps, pipeline stages, L2 group-M swizzling, and Split-K factor) inside
+     registered vendor backends without polluting model code.
+  3. `QuantWeightTensor` subclasses `torch.Tensor` via `_make_wrapper_subclass`
+     so quantized weights flow transparently through standard PyTorch modules,
+     `F.linear`, `torch.compile`, and `aten.t` / `aten.view` metadata ops with
+     zero weight copies.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+import math
+from typing import Any, Callable
+
+import torch
+import torch.nn.functional as F
+
+from flag_gems.utils.quant_precondition import fwht_lastdim_fp32, sw_mgoc_quantize_weight
+
+aten = torch.ops.aten
+DTYPE_BF16, DTYPE_FP16 = 0, 1
+VALID_QUANT_MODES = ("w8a8", "w8a16")
+VALID_COL_LAYOUTS = ("contiguous", "interleaved_64")
+_RESHAPE_OP = getattr(getattr(aten, "reshape", None), "default", None)
+_RESHAPE_ALIAS_OP = getattr(getattr(aten, "_reshape_alias", None), "default", None)
+_LINEAR_ATEN_OP = getattr(getattr(aten, "linear", None), "default", None)
+
+
+def dtype_to_code(dtype: torch.dtype) -> int:
+    """Encode a supported quantized GEMM output dtype (`bf16`/`fp16`) as an integer CustomOp tag."""
+    if dtype == torch.bfloat16:
+        return DTYPE_BF16
+    if dtype == torch.float16:
+        return DTYPE_FP16
+    raise ValueError(f"Unsupported quantized GEMM output dtype: {dtype}")
+
+
+def code_to_dtype(code: int) -> torch.dtype:
+    """Decode an integer CustomOp dtype tag (`DTYPE_BF16`/`DTYPE_FP16`) back to `torch.dtype`."""
+    return torch.bfloat16 if code == DTYPE_BF16 else torch.float16
+
+
+def _resolve_contiguous_view(numel: int, shape: Sequence[int]) -> tuple[tuple[int, ...], tuple[int, ...]]:
+    """Resolve a target view `shape` (with optional `-1` dimension) into concrete `(dims, strides)`."""
+    dims, neg_idx, known = [int(d) for d in shape], -1, 1
+    for idx, d in enumerate(dims):
+        if d == -1:
+            if neg_idx >= 0:
+                raise RuntimeError("only one dimension can be inferred")
+            neg_idx = idx
+        else:
+            known *= d
+    if neg_idx >= 0:
+        if known == 0 or (numel % known) != 0:
+            raise RuntimeError(f"shape {dims} is invalid for input of size {numel}")
+        dims[neg_idx] = numel // known
+    elif math.prod(dims) != numel:
+        raise RuntimeError(f"shape {dims} is invalid for input of size {numel}")
+    # Compute standard row-major contiguous strides from innermost to outermost dimension.
+    strides = [1] * len(dims)
+    for idx in range(len(dims) - 2, -1, -1):
+        strides[idx] = strides[idx + 1] * max(1, dims[idx + 1])
+    return tuple(dims), tuple(strides)
+
+
+@dataclass(frozen=True)
+class QuantLayerConfig:
+    """Static mathematical and layout contract of one quantized Linear weight matrix."""
+
+    shape_n: int
+    shape_k: int
+    quant_mode: str = "w8a8"
+    hadamard_bs: int = 0
+    num_scale_groups: int = 1
+    col_layout: str = "contiguous"
+    has_bias: bool = False
+
+    def __post_init__(self) -> None:
+        """Validate shape, quantization mode, Hadamard alignment, scale-group, and layout invariants."""
+        if self.shape_n <= 0 or self.shape_k <= 0:
+            raise ValueError(f"Invalid QuantLayerConfig shape ({self.shape_n}, {self.shape_k}).")
+        if self.quant_mode not in VALID_QUANT_MODES:
+            raise ValueError(f"Unsupported quant_mode={self.quant_mode!r}.")
+        if self.hadamard_bs not in (0, 64) or (self.hadamard_bs == 64 and self.shape_k % 64 != 0):
+            raise ValueError(f"Invalid hadamard_bs={self.hadamard_bs} for shape_k={self.shape_k}.")
+        if self.num_scale_groups < 1 or (self.shape_k % self.num_scale_groups != 0):
+            raise ValueError(f"Invalid num_scale_groups={self.num_scale_groups} for shape_k={self.shape_k}.")
+        if self.hadamard_bs == 64 and ((self.shape_k // self.num_scale_groups) % 64 != 0):
+            raise ValueError("Scale group size must be divisible by 64 when hadamard_bs=64.")
+        if self.col_layout not in VALID_COL_LAYOUTS or (self.col_layout == "interleaved_64" and self.shape_n % 128 != 0):
+            raise ValueError(f"Invalid col_layout={self.col_layout!r} for shape_n={self.shape_n}.")
+
+    @property
+    def do_hadamard(self) -> bool:
+        """Return whether 64-element Fast Walsh-Hadamard preconditioning is enabled."""
+        return self.hadamard_bs == 64
+
+    @property
+    def interleave_block_cols(self) -> int:
+        """Column block width (`128` or `64`) used when interleaving `[gate_proj, up_proj]` rows."""
+        return 128 if (self.shape_n % 256 == 0) else 64
+
+
+@dataclass(frozen=True)
+class GemmTuningConfig:
+    """Hardware tile, warp, pipeline-stage, L2 swizzle, and Split-K schedule."""
+
+    block_m: int
+    block_n: int
+    block_k: int
+    num_warps: int
+    num_stages: int
+    split_k: int = 1
+    group_m: int = 8
+
+
+class QuantWeightTensor(torch.Tensor):
+    """Typed wrapper `Tensor` subclass holding `qweight_nk` (`int8 [N, K]`) and `w_scale` (`fp32 [N]`).
+
+    Exposes a logical `bfloat16 [N, K]` outer tensor envelope to PyTorch so existing
+    `nn.Linear` / vLLM Linear layers can store, transpose (`weight.t()`), and pass it
+    through `F.linear` / `torch.mm` / `torch.addmm` without awareness of the underlying
+    INT8 representation. Metadata-only view ops (`t`, `transpose`, `view`, `reshape`)
+    merely update `outer_size` / `outer_stride` while sharing `qweight_nk` and `w_scale`
+    zero-copy.
+    """
+
+    qweight_nk: torch.Tensor
+    w_scale: torch.Tensor
+    cfg: QuantLayerConfig
+
+    @staticmethod
+    def __new__(
+        cls,
+        qweight_nk: torch.Tensor,
+        w_scale: torch.Tensor,
+        cfg: QuantLayerConfig,
+        outer_size: Sequence[int] | None = None,
+        outer_stride: Sequence[int] | None = None,
+    ) -> QuantWeightTensor:
+        """Construct a `QuantWeightTensor` wrapper around contiguous `int8` weights and `fp32` scales."""
+        if qweight_nk.dtype != torch.int8 or qweight_nk.shape != (cfg.shape_n, cfg.shape_k):
+            raise ValueError(f"qweight_nk must be int8 {(cfg.shape_n, cfg.shape_k)}, got {qweight_nk.dtype} {tuple(qweight_nk.shape)}.")
+        if not qweight_nk.is_contiguous():
+            qweight_nk = qweight_nk.contiguous()
+        if w_scale.dtype != torch.float32 or w_scale.shape != (cfg.shape_n,):
+            w_scale = w_scale.to(dtype=torch.float32).reshape(cfg.shape_n)
+        if not w_scale.is_contiguous():
+            w_scale = w_scale.contiguous()
+        sz = tuple(int(s) for s in outer_size) if outer_size is not None else (cfg.shape_n, cfg.shape_k)
+        st = tuple(int(s) for s in outer_stride) if outer_stride is not None else (cfg.shape_k, 1)
+        elem = torch.Tensor._make_wrapper_subclass(
+            cls, sz, strides=st, storage_offset=0, dtype=torch.bfloat16, device=qweight_nk.device, requires_grad=False
+        )
+        elem.qweight_nk, elem.w_scale, elem.cfg = qweight_nk, w_scale, cfg
+        return elem
+
+    def _is_canonical_nk(self) -> bool:
+        """Return True when the wrapper exposes the canonical contiguous `[N, K]` view."""
+        return tuple(self.shape) == (self.cfg.shape_n, self.cfg.shape_k) and tuple(self.stride()) == (self.cfg.shape_k, 1)
+
+    def _is_transposed_kn(self) -> bool:
+        """Return True when the wrapper exposes the transposed `[K, N]` view produced by `.t()`."""
+        return tuple(self.shape) == (self.cfg.shape_k, self.cfg.shape_n) and tuple(self.stride()) == (1, self.cfg.shape_k)
+
+    def _as_nk(self) -> QuantWeightTensor:
+        """Return a canonical `[N, K]` wrapper sharing the same underlying quantized storage."""
+        return self if self._is_canonical_nk() else QuantWeightTensor(self.qweight_nk, self.w_scale, self.cfg)
+
+    def __repr__(self) -> str:
+        """Return a concise debug representation of the quantized weight metadata."""
+        c = self.cfg
+        return f"QuantWeightTensor(shape={tuple(self.shape)}, quant_mode={c.quant_mode!r}, hadamard_bs={c.hadamard_bs}, num_scale_groups={c.num_scale_groups}, col_layout={c.col_layout!r})"
+
+    def __tensor_flatten__(self) -> tuple[list[str], QuantLayerConfig]:
+        """Expose inner tensors and static `QuantLayerConfig` for PyTorch subclass tracing/flattening."""
+        return ["qweight_nk", "w_scale"], self.cfg
+
+    @classmethod
+    def __tensor_unflatten__(cls, inner: dict[str, torch.Tensor], ctx: QuantLayerConfig, outer_size: Any, outer_stride: Any) -> QuantWeightTensor:
+        """Reconstruct a `QuantWeightTensor` from flattened inner tensors and outer geometry."""
+        return cls(inner["qweight_nk"], inner["w_scale"], ctx, outer_size, outer_stride)
+
+    @classmethod
+    def __torch_dispatch__(cls, func: Any, types: Any, args: Any = (), kwargs: Any = None) -> Any:
+        """Intercept ATen GEMM/Linear ops and zero-copy view transformations on `QuantWeightTensor`."""
+        kwargs = kwargs or {}
+        # `F.linear(x, w)` lowers to `aten.mm(x, w.t())`, `aten.addmm(b, x, w.t())`, or `aten.linear(x, w, b)`.
+        # Match both transposed `[K, N]` (`mm`/`addmm`) and canonical `[N, K]` (`linear`) weight views.
+        if func is aten.mm.default and len(args) >= 2 and isinstance(args[1], cls) and not isinstance(args[0], cls) and args[1]._is_transposed_kn():
+            return dispatch_quant_linear(args[0], args[1]._as_nk(), None)
+        if func is aten.addmm.default and len(args) >= 3 and isinstance(args[2], cls) and not isinstance(args[1], cls) and args[2]._is_transposed_kn() and kwargs.get("alpha", 1) == 1 and kwargs.get("beta", 1) == 1:
+            return dispatch_quant_linear(args[1], args[2]._as_nk(), args[0])
+        if _LINEAR_ATEN_OP is not None and func is _LINEAR_ATEN_OP and len(args) >= 2 and isinstance(args[1], cls) and args[1]._is_canonical_nk():
+            return dispatch_quant_linear(args[0], args[1], args[2] if len(args) > 2 else kwargs.get("bias", None))
+
+        src = args[0]
+        if not isinstance(src, cls):
+            raise NotImplementedError(f"QuantWeightTensor does not implement dispatch op {func}")
+        sz, st = tuple(src.shape), tuple(src.stride())
+        if func in (aten.detach.default, aten.alias.default):
+            return cls(src.qweight_nk.detach(), src.w_scale.detach(), src.cfg, sz, st)
+        if func is aten.clone.default:
+            return cls(src.qweight_nk.clone(), src.w_scale.clone(), src.cfg, sz, st)
+        if func is aten._to_copy.default:
+            dev = kwargs.get("device", src.qweight_nk.device) or src.qweight_nk.device
+            return cls(src.qweight_nk.to(device=dev), src.w_scale.to(device=dev), src.cfg, sz, st)
+        if func is aten.empty_like.default:
+            dev = kwargs.get("device", src.qweight_nk.device) or src.qweight_nk.device
+            return cls(torch.empty_like(src.qweight_nk, device=dev), torch.empty_like(src.w_scale, device=dev), src.cfg, sz, st)
+        if func is aten.t.default:
+            if len(sz) > 2:
+                raise RuntimeError(f"t() expects a tensor with <= 2 dimensions, got {len(sz)}")
+            return cls(src.qweight_nk, src.w_scale, src.cfg, (sz[1], sz[0]) if len(sz) == 2 else sz, (st[1], st[0]) if len(sz) == 2 else st)
+        if func is aten.transpose.int:
+            ndim = len(sz)
+            d0, d1 = int(args[1]) % ndim, int(args[2]) % ndim
+            nsz, nst = list(sz), list(st)
+            nsz[d0], nsz[d1] = nsz[d1], nsz[d0]
+            nst[d0], nst[d1] = nst[d1], nst[d0]
+            return cls(src.qweight_nk, src.w_scale, src.cfg, nsz, nst)
+        if func in (aten.view.default, aten._unsafe_view.default, _RESHAPE_OP):
+            if tuple(int(x) for x in args[1]) == sz:
+                return cls(src.qweight_nk, src.w_scale, src.cfg, sz, st)
+            if not src.is_contiguous():
+                raise RuntimeError("QuantWeightTensor view/reshape requires a contiguous wrapper layout")
+            nsz, nst = _resolve_contiguous_view(src.numel(), args[1])
+            return cls(src.qweight_nk, src.w_scale, src.cfg, nsz, nst)
+        if _RESHAPE_ALIAS_OP is not None and func is _RESHAPE_ALIAS_OP:
+            return cls(src.qweight_nk, src.w_scale, src.cfg, args[1], args[2])
+        raise NotImplementedError(f"QuantWeightTensor does not implement dispatch op {func}")
+
+    @classmethod
+    def __torch_function__(cls, func: Any, types: Any, args: Any = (), kwargs: Any = None) -> Any:
+        """Short-circuit `F.linear` directly to `flag_gems.linear` and disable subclass overhead elsewhere.
+
+        Using `DisableTorchFunctionSubclass()` for all non-`F.linear` calls prevents PyTorch's
+        Python-level `__torch_function__` protocol from wrapping intermediate results or slowing
+        down view/attribute operations before C++ `__torch_dispatch__` runs.
+        """
+        if func is F.linear and len(args) >= 2 and isinstance(args[1], cls) and args[1]._is_canonical_nk():
+            import flag_gems
+
+            return flag_gems.linear(args[0], args[1], args[2] if len(args) > 2 else (kwargs or {}).get("bias", None))
+        with torch._C.DisableTorchFunctionSubclass():
+            return func(*args, **(kwargs or {}))
+
+
+@torch.no_grad()
+def quantize_linear_weight(
+    weight_bf16: torch.Tensor,
+    cfg: QuantLayerConfig,
+    *,
+    alpha_min: float = 0.85,
+    gamma: float = 0.0,
+    col_scale: torch.Tensor | None = None,
+) -> QuantWeightTensor:
+    """Precondition and quantize `[N, K]` Linear weight via `sw_mgoc_quantize_weight`.
+
+    Supports two physical pre-transformations prior to SW-MGOC INT8 quantization:
+      - `col_layout == "interleaved_64"`: interleaves `[gate_proj, up_proj]` in blocks
+        of 64 or 128 output columns (`[G_0, U_0, G_1, U_1, ...]`) so each GEMM CTA can
+        compute `silu(gate) * up` in-register within a single epilogue (`EPILOGUE_MODE=2`).
+      -Chunked FP32 preconditioning (`n > 8192`): for large output dimensions such as
+        vocabulary `LM-Head` matrices (`N ~ 73K-152K`), promotes and Hadamard-rotates
+        at most 8,192 rows at a time so transient FP32 workspace stays under ~100 MiB
+        instead of spiking multi-GiB VRAM during online model loading.
+    """
+    if weight_bf16.shape != (cfg.shape_n, cfg.shape_k):
+        raise ValueError(f"weight_bf16 shape {tuple(weight_bf16.shape)} != {(cfg.shape_n, cfg.shape_k)}")
+    n, k = cfg.shape_n, cfg.shape_k
+    if cfg.col_layout == "interleaved_64":
+        blk, half_n = cfg.interleave_block_cols, n // 2
+        w_src = torch.stack((weight_bf16[:half_n].view(half_n // blk, blk, k), weight_bf16[half_n:].view(half_n // blk, blk, k)), dim=1).reshape(n, k).contiguous()
+    else:
+        w_src = weight_bf16
+    if col_scale is not None or cfg.do_hadamard:
+        cs_row = col_scale.to(device=w_src.device, dtype=torch.float32)[None, :] if col_scale is not None else None
+        if n > 8192:
+            qweight_nk = torch.empty((n, k), dtype=torch.int8, device=w_src.device)
+            w_scale = torch.empty((n,), dtype=torch.float32, device=w_src.device)
+            for r0 in range(0, n, 8192):
+                r1 = min(r0 + 8192, n)
+                w_chunk = w_src[r0:r1].to(torch.float32)
+                if cs_row is not None:
+                    w_chunk.mul_(cs_row)
+                if cfg.do_hadamard:
+                    w_chunk = fwht_lastdim_fp32(w_chunk, 64)
+                sw_mgoc_quantize_weight(
+                    w_chunk, gamma=gamma, alpha_min=alpha_min, out_wq=qweight_nk[r0:r1], out_ws=w_scale[r0:r1]
+                )
+                del w_chunk
+        else:
+            w_work = w_src.to(torch.float32)
+            if cs_row is not None:
+                w_work.mul_(cs_row)
+            if cfg.do_hadamard:
+                w_work = fwht_lastdim_fp32(w_work, 64)
+            qweight_nk, w_scale = sw_mgoc_quantize_weight(w_work, gamma=gamma, alpha_min=alpha_min)
+            del w_work
+    else:
+        qweight_nk, w_scale = sw_mgoc_quantize_weight(w_src, gamma=gamma, alpha_min=alpha_min)
+    return QuantWeightTensor(qweight_nk, w_scale, cfg)
+
+
+QuantLinearHandler = Callable[[torch.Tensor, QuantWeightTensor, torch.Tensor | None], torch.Tensor]
+QuantLayoutResolver = Callable[[int, int, str, bool], str]
+QuantGemmW8A8Handler = Callable[[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor | None, int, int], torch.Tensor]
+QuantGemmW8A16Handler = Callable[[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor | None], torch.Tensor]
+
+_QUANT_LINEAR_HANDLERS: dict[str, QuantLinearHandler] = {}
+_QUANT_LAYOUT_RESOLVERS: dict[str, QuantLayoutResolver] = {}
+_QUANT_GEMM_W8A8_HANDLERS: dict[str, QuantGemmW8A8Handler] = {}
+_QUANT_GEMM_W8A16_HANDLERS: dict[str, QuantGemmW8A16Handler] = {}
+_ACTIVE_W8A8_HANDLER: tuple[str, QuantGemmW8A8Handler] | None = None
+_ACTIVE_W8A16_HANDLER: tuple[str, QuantGemmW8A16Handler] | None = None
+
+
+def _active_vendor() -> str:
+    """Return the active FlagGems hardware vendor identifier registered at runtime."""
+    import flag_gems
+
+    return getattr(flag_gems, "vendor_name", "")
+
+
+def register_quant_linear(vendor: str, handler: QuantLinearHandler | None = None) -> Any:
+    """Register a vendor-specific `QuantWeightTensor` Linear execution handler.
+
+    Each hardware backend registers its own handler keyed by `vendor_name` at
+    backend import time; the first registered handler also populates `_default` as a
+    safe fallback when `vendor_name` is unset.
+    """
+    def _bind(fn: QuantLinearHandler) -> QuantLinearHandler:
+        _QUANT_LINEAR_HANDLERS[vendor] = fn
+        _QUANT_LINEAR_HANDLERS.setdefault("_default", fn)
+        return fn
+
+    return _bind(handler) if handler is not None else _bind
+
+
+def dispatch_quant_linear(x: torch.Tensor, weight: QuantWeightTensor, bias: torch.Tensor | None = None) -> torch.Tensor:
+    """Route a `QuantWeightTensor` Linear call to the active vendor's registered handler."""
+    vendor = _active_vendor()
+    if (fn := _QUANT_LINEAR_HANDLERS.get(vendor) or _QUANT_LINEAR_HANDLERS.get("_default")) is None:
+        raise RuntimeError(f"No quant_linear backend registered for {vendor!r}")
+    return fn(x, weight, bias)
+
+
+def register_quant_layout_resolver(vendor: str, resolver: QuantLayoutResolver | None = None) -> Any:
+    """Register a vendor callback deciding whether a `(N, K)` weight uses `contiguous` or `interleaved_64`."""
+    def _bind(fn: QuantLayoutResolver) -> QuantLayoutResolver:
+        _QUANT_LAYOUT_RESOLVERS[vendor] = fn
+        return fn
+
+    return _bind(resolver) if resolver is not None else _bind
+
+
+def resolve_quant_weight_layout(
+    shape_n: int, shape_k: int, quant_mode: str = "w8a8", has_silu_mul_epilogue: bool = False, vendor: str | None = None
+) -> str:
+    """Negotiate physical column layout (`contiguous` vs `interleaved_64`) with the active backend."""
+    fn = _QUANT_LAYOUT_RESOLVERS.get(_active_vendor() if vendor is None else vendor)
+    return "contiguous" if fn is None else fn(int(shape_n), int(shape_k), str(quant_mode), bool(has_silu_mul_epilogue))
+
+
+def register_quant_gemm_w8a8(vendor: str, handler: QuantGemmW8A8Handler | None = None) -> Any:
+    """Register a vendor W8A8 GEMM implementation and invalidate the fast-dispatch cache."""
+    def _bind(fn: QuantGemmW8A8Handler) -> QuantGemmW8A8Handler:
+        global _ACTIVE_W8A8_HANDLER
+        _QUANT_GEMM_W8A8_HANDLERS[vendor] = fn
+        _QUANT_GEMM_W8A8_HANDLERS.setdefault("_default", fn)
+        _ACTIVE_W8A8_HANDLER = None
+        return fn
+
+    return _bind(handler) if handler is not None else _bind
+
+
+def register_quant_gemm_w8a16(vendor: str, handler: QuantGemmW8A16Handler | None = None) -> Any:
+    """Register a vendor W8A16 GEMM implementation and invalidate the fast-dispatch cache."""
+    def _bind(fn: QuantGemmW8A16Handler) -> QuantGemmW8A16Handler:
+        global _ACTIVE_W8A16_HANDLER
+        _QUANT_GEMM_W8A16_HANDLERS[vendor] = fn
+        _QUANT_GEMM_W8A16_HANDLERS.setdefault("_default", fn)
+        _ACTIVE_W8A16_HANDLER = None
+        return fn
+
+    return _bind(handler) if handler is not None else _bind
+
+
+def _resolve_gemm_handler(reg: dict[str, Any], op_name: str, vendor: str | None = None) -> Any:
+    """Look up a registered GEMM handler for `vendor`, falling back to `_default`."""
+    v_name = _active_vendor() if vendor is None else vendor
+    if (fn := reg.get(v_name) or reg.get("_default")) is None:
+        raise RuntimeError(f"No {op_name} backend registered for {v_name!r}")
+    return fn
+
+
+@torch.library.custom_op("flag_gems::quant_gemm_w8a8", mutates_args=())
+def quant_gemm_w8a8(
+    x_q: torch.Tensor, x_scale: torch.Tensor, qweight_nk: torch.Tensor, w_scale: torch.Tensor,
+    bias: torch.Tensor | None, out_dtype_code: int, epilogue_mode: int,
+) -> torch.Tensor:
+    """Dispatch `flag_gems::quant_gemm_w8a8` to the active vendor's INT8xINT8 GEMM backend."""
+    global _ACTIVE_W8A8_HANDLER
+    vendor = _active_vendor()
+    cached = _ACTIVE_W8A8_HANDLER
+    # Fast-path cached vendor handler lookup to avoid dict lookups per GEMM call.
+    if cached is not None and cached[0] == vendor:
+        fn = cached[1]
+    else:
+        fn = _resolve_gemm_handler(_QUANT_GEMM_W8A8_HANDLERS, "quant_gemm_w8a8", vendor)
+        _ACTIVE_W8A8_HANDLER = (vendor, fn)
+    return fn(x_q, x_scale, qweight_nk, w_scale, bias, int(out_dtype_code), int(epilogue_mode))
+
+
+@quant_gemm_w8a8.register_fake
+def _(
+    x_q: torch.Tensor, x_scale: torch.Tensor, qweight_nk: torch.Tensor, w_scale: torch.Tensor,
+    bias: torch.Tensor | None, out_dtype_code: int, epilogue_mode: int,
+) -> torch.Tensor:
+    """Meta/fake shape inference for `quant_gemm_w8a8` (`epilogue_mode == 2` halves `N` via SiLU*Mul)."""
+    n = qweight_nk.shape[0]
+    return x_q.new_empty((x_q.shape[0], (n // 2) if int(epilogue_mode) == 2 else n), dtype=code_to_dtype(int(out_dtype_code)))
+
+
+@torch.library.custom_op("flag_gems::quant_gemm_w8a16", mutates_args=())
+def quant_gemm_w8a16(x_2d: torch.Tensor, qweight_nk: torch.Tensor, w_scale: torch.Tensor, bias: torch.Tensor | None) -> torch.Tensor:
+    """Dispatch `flag_gems::quant_gemm_w8a16` to the active vendor's INT8-weight/FP16-act GEMM backend."""
+    global _ACTIVE_W8A16_HANDLER
+    vendor = _active_vendor()
+    cached = _ACTIVE_W8A16_HANDLER
+    if cached is not None and cached[0] == vendor:
+        fn = cached[1]
+    else:
+        fn = _resolve_gemm_handler(_QUANT_GEMM_W8A16_HANDLERS, "quant_gemm_w8a16", vendor)
+        _ACTIVE_W8A16_HANDLER = (vendor, fn)
+    return fn(x_2d, qweight_nk, w_scale, bias)
+
+
+@quant_gemm_w8a16.register_fake
+def _(x_2d: torch.Tensor, qweight_nk: torch.Tensor, w_scale: torch.Tensor, bias: torch.Tensor | None) -> torch.Tensor:
+    """Meta/fake shape inference for `quant_gemm_w8a16`, preserving input activation dtype."""
+    return x_2d.new_empty((x_2d.shape[0], qweight_nk.shape[0]), dtype=x_2d.dtype)
+
+
+__all__ = [
+    "DTYPE_BF16", "DTYPE_FP16", "GemmTuningConfig", "QuantLayerConfig", "QuantWeightTensor",
+    "code_to_dtype", "dispatch_quant_linear", "dtype_to_code", "quant_gemm_w8a16", "quant_gemm_w8a8",
+    "quantize_linear_weight", "register_quant_gemm_w8a16", "register_quant_gemm_w8a8",
+    "register_quant_layout_resolver", "register_quant_linear", "resolve_quant_weight_layout",
+]
