+            return torch.empty((min_elems,), dtype=torch.bfloat16, device=device)
+        alloc = max(min_elems, 2 * get_device_topology().l2_cache_bytes)
+        buf = torch.empty((alloc,), dtype=torch.bfloat16, device=device)
+        _SPLITK_BF16_WORKSPACE[dev_idx] = buf
+    return buf
+
+
+def _get_splitk_i32_workspace(device: torch.device, min_elems: int) -> torch.Tensor:
+    """Return L2-sized persistent INT32 partial-accumulator buffer for 1-kernel Split-K."""
+    dev_idx = device.index if device.index is not None else 0
+    buf = _SPLITK_I32_WORKSPACE.get(dev_idx)
+    if buf is None or buf.numel() < min_elems:
+        if torch.cuda.is_current_stream_capturing():
+            return torch.empty((min_elems,), dtype=torch.int32, device=device)
+        alloc = max(min_elems, get_device_topology().l2_cache_bytes // 2)
+        buf = torch.empty((alloc,), dtype=torch.int32, device=device)
+        _SPLITK_I32_WORKSPACE[dev_idx] = buf
+    return buf
+
+
+def _get_splitk_locks_workspace(device: torch.device, min_tiles: int) -> torch.Tensor:
+    """Return zero-initialized INT32 tile arrival-counter array for 1-kernel Split-K."""
+    dev_idx = device.index if device.index is not None else 0
+    buf = _SPLITK_LOCKS_WORKSPACE.get(dev_idx)
+    if buf is None or buf.numel() < min_tiles:
+        if torch.cuda.is_current_stream_capturing():
+            return torch.zeros((min_tiles,), dtype=torch.int32, device=device)
+        alloc = max(min_tiles, 4096)
+        buf = torch.zeros((alloc,), dtype=torch.int32, device=device)
+        _SPLITK_LOCKS_WORKSPACE[dev_idx] = buf
+    return buf
+
+
+@triton.jit
+def _swizzle_pid_2d(pid, grid_m, grid_n: tl.constexpr, GM: tl.constexpr):
+    """Group `GM` M-tiles along `grid_n` so concurrent CTAs share B-weight columns in the 8 MiB L2."""
+    if GM == 1:
+        return pid // grid_n, pid % grid_n
+    width: tl.constexpr = GM * grid_n
+    group_id = pid // width
+    first_m = group_id * GM
+    gsz = tl.minimum(grid_m - first_m, GM)
+    return first_m + (pid % gsz), (pid % width) // gsz
+
+
+@triton.jit
+def _w8a8_gemm_region_body(
+    A, B, SA, SB, BIAS, C, M, N: tl.constexpr, K: tl.constexpr,
+    pid_m, pid_n, COL_BASE: tl.constexpr,
+    BM: tl.constexpr, SUB_N0: tl.constexpr, SUB_N1: tl.constexpr, BK: tl.constexpr,
+    EVEN_M: tl.constexpr, EVEN_N: tl.constexpr, EVEN_K: tl.constexpr,
+    HAS_BIAS: tl.constexpr = False,
+):
+    """Compute one W8A8 output tile `[BM, SUB_N0 (+ SUB_N1)]` starting at column `COL_BASE`.
+
+    - Preserves `global_load_lds_dwordx4` Direct-Operand DMA by feeding `tl.load(a_ptrs)` and
+      `tl.load(b_ptrs)` directly into `tl.dot(..., out_dtype=tl.int32)` with zero VALU casts.
+    - When `SUB_N1 > 0` (non-power-of-two `BN = 192 = 128+64` or `160 = 128+32`), reuses the
+      loaded `A[BM, BK]` slice across two power-of-two MFMA accumulators (`acc0`, `acc1`).
+    """
+    rm = pid_m * BM + tl.arange(0, BM)
+    # Modulo-wrap out-of-bounds M indices (`rm % M`) with `tl.multiple_of` so SGPR base alignment
+    # stays uniform for `global_load_lds_dwordx4` even when `EVEN_M=False`.
+    ram = (
+        tl.max_contiguous(tl.multiple_of(rm, BM), BM)
+        if EVEN_M
+        else tl.max_contiguous(tl.multiple_of(rm % M, BM), BM)
+    )
+    rk = tl.max_contiguous(tl.multiple_of(tl.arange(0, BK), BK), BK)
+    a_ptrs = A + (ram[:, None] * K + rk[None, :])
+
+    if SUB_N1 == 0:
+        # Power-of-two N-tile (`BN in {64, 128, 256}`): single INT32 MFMA accumulator.
+        rn0 = COL_BASE + pid_n * SUB_N0 + tl.arange(0, SUB_N0)
+        if EVEN_N:
+            al_n: tl.constexpr = SUB_N0 if (COL_BASE % SUB_N0 == 0) else 64
+            rbn0 = tl.max_contiguous(tl.multiple_of(rn0, al_n), SUB_N0)
+        else:
+            al_rem: tl.constexpr = (
+                64
+                if (N % 64 == 0 and SUB_N0 >= 64)
+                else (32 if (N % 32 == 0 and SUB_N0 >= 32) else 16)
+            )
+            rbn0 = tl.max_contiguous(tl.multiple_of(rn0 % N, al_rem), al_rem)
+        b0_ptrs = B + (rk[:, None] + rbn0[None, :] * K)
+        acc0 = tl.zeros((BM, SUB_N0), dtype=tl.int32)
+        if EVEN_K:
+            for _ in range(0, K // BK):
+                acc0 = tl.dot(tl.load(a_ptrs), tl.load(b0_ptrs), acc0, out_dtype=tl.int32)
+                a_ptrs += BK
+                b0_ptrs += BK
+        else:
+            for k_step in range(0, (K + BK - 1) // BK):
+                km = rk < (K - k_step * BK)
+                acc0 = tl.dot(
+                    tl.load(a_ptrs, mask=km[None, :], other=0),
+                    tl.load(b0_ptrs, mask=km[:, None], other=0),
+                    acc0, out_dtype=tl.int32,
+                )
+                a_ptrs += BK
+                b0_ptrs += BK
+        # Epilogue-only FP32 dequantization (`acc * sa * sb (+ bias)`) keeps K-loop 100% homogeneous INT8->INT32.
+        sa = tl.load(SA + ram).to(tl.float32) if EVEN_M else tl.load(SA + rm, mask=rm < M, other=0.0).to(tl.float32)
+        sb0 = tl.load(SB + rbn0).to(tl.float32) if EVEN_N else tl.load(SB + rn0, mask=rn0 < N, other=0.0).to(tl.float32)
+        val0 = acc0.to(tl.float32) * sa[:, None] * sb0[None, :]
+        if HAS_BIAS:
+            bv0 = tl.load(BIAS + rbn0).to(tl.float32) if EVEN_N else tl.load(BIAS + rn0, mask=rn0 < N, other=0.0).to(tl.float32)
+            val0 += bv0[None, :]
+        res0 = val0.to(C.dtype.element_ty)
+        c0_ptrs = C + (rm[:, None] * N + rn0[None, :])
+        if EVEN_M and EVEN_N:
+            tl.store(c0_ptrs, res0)
+        elif EVEN_N:
+            tl.store(c0_ptrs, res0, mask=(rm < M)[:, None])
+        elif EVEN_M:
+            tl.store(c0_ptrs, res0, mask=(rn0 < N)[None, :])
+        else:
+            tl.store(c0_ptrs, res0, mask=(rm < M)[:, None] & (rn0 < N)[None, :])
+    else:
+        # Composite non-power-of-two N-tile (`BN = SUB_N0 + SUB_N1`, e.g. 192=128+64 or 160=128+32):
+        # shares `A[BM, BK]` in LDS/VGPRs across both sub-accumulators to stay <= 32 KiB LDS (2 CTAs/CU).
+        BN: tl.constexpr = SUB_N0 + SUB_N1
+        rn0 = COL_BASE + pid_n * BN + tl.arange(0, SUB_N0)
+        rn1 = COL_BASE + pid_n * BN + SUB_N0 + tl.arange(0, SUB_N1)
+        rbn0 = tl.max_contiguous(tl.multiple_of(rn0, SUB_N1), SUB_N0) if EVEN_N else tl.max_contiguous(tl.multiple_of(rn0 % N, 16), 16)
+        rbn1 = tl.max_contiguous(tl.multiple_of(rn1, SUB_N1), SUB_N1) if EVEN_N else tl.max_contiguous(tl.multiple_of(rn1 % N, 16), 16)
+        b0_ptrs = B + (rk[:, None] + rbn0[None, :] * K)
+        b1_ptrs = B + (rk[:, None] + rbn1[None, :] * K)
+        acc0 = tl.zeros((BM, SUB_N0), dtype=tl.int32)
+        acc1 = tl.zeros((BM, SUB_N1), dtype=tl.int32)
+        if EVEN_K:
+            for _ in range(0, K // BK):
+                a = tl.load(a_ptrs)
+                acc0 = tl.dot(a, tl.load(b0_ptrs), acc0, out_dtype=tl.int32)
+                acc1 = tl.dot(a, tl.load(b1_ptrs), acc1, out_dtype=tl.int32)
+                a_ptrs += BK
+                b0_ptrs += BK
+                b1_ptrs += BK
+        else:
+            for k_step in range(0, (K + BK - 1) // BK):
+                km = rk < (K - k_step * BK)
+                a = tl.load(a_ptrs, mask=km[None, :], other=0)
+                acc0 = tl.dot(a, tl.load(b0_ptrs, mask=km[:, None], other=0), acc0, out_dtype=tl.int32)
+                acc1 = tl.dot(a, tl.load(b1_ptrs, mask=km[:, None], other=0), acc1, out_dtype=tl.int32)
+                a_ptrs += BK
+                b0_ptrs += BK
+                b1_ptrs += BK
+        sa = tl.load(SA + ram).to(tl.float32) if EVEN_M else tl.load(SA + rm, mask=rm < M, other=0.0).to(tl.float32)
+        sb0 = tl.load(SB + rbn0).to(tl.float32) if EVEN_N else tl.load(SB + rn0, mask=rn0 < N, other=0.0).to(tl.float32)
+        sb1 = tl.load(SB + rbn1).to(tl.float32) if EVEN_N else tl.load(SB + rn1, mask=rn1 < N, other=0.0).to(tl.float32)
+        val0 = acc0.to(tl.float32) * sa[:, None] * sb0[None, :]
+        val1 = acc1.to(tl.float32) * sa[:, None] * sb1[None, :]
+        if HAS_BIAS:
+            bv0 = tl.load(BIAS + rbn0).to(tl.float32) if EVEN_N else tl.load(BIAS + rn0, mask=rn0 < N, other=0.0).to(tl.float32)
+            bv1 = tl.load(BIAS + rbn1).to(tl.float32) if EVEN_N else tl.load(BIAS + rn1, mask=rn1 < N, other=0.0).to(tl.float32)
+            val0 += bv0[None, :]
+            val1 += bv1[None, :]
+        res0 = val0.to(C.dtype.element_ty)
+        res1 = val1.to(C.dtype.element_ty)
+        c0_ptrs = C + (rm[:, None] * N + rn0[None, :])
+        c1_ptrs = C + (rm[:, None] * N + rn1[None, :])
+        if EVEN_M and EVEN_N:
+            tl.store(c0_ptrs, res0)
+            tl.store(c1_ptrs, res1)
+        elif EVEN_N:
+            tl.store(c0_ptrs, res0, mask=(rm < M)[:, None])
+            tl.store(c1_ptrs, res1, mask=(rm < M)[:, None])
+        else:
+            tl.store(c0_ptrs, res0, mask=(rm < M)[:, None] & (rn0 < N)[None, :])
+            tl.store(c1_ptrs, res1, mask=(rm < M)[:, None] & (rn1 < N)[None, :])
+
+
+@triton.jit(do_not_specialize=["M"])
+def _unified_w8a8_nt_kernel(
+    A, B, SA, SB, BIAS, C, M,
+    N: tl.constexpr, K: tl.constexpr,
+    BM: tl.constexpr,
+    SUB_N0_A: tl.constexpr, SUB_N1_A: tl.constexpr, R0: tl.constexpr,
+    SUB_N0_B: tl.constexpr, SUB_N1_B: tl.constexpr, R1: tl.constexpr,
+    BK: tl.constexpr, GM: tl.constexpr,
+    EVEN_M: tl.constexpr, EVEN_N: tl.constexpr, EVEN_K: tl.constexpr,
+    HAS_BIAS: tl.constexpr = False,
+):
+    """Single-launch 1D/2-region W8A8 NT GEMM (`C = dequant(A_i8 @ B_nk.T) (+ bias)`).
+
+    CTAs `[0, grid_m * R0)` compute primary region `R0` at column `0`; CTAs `[grid_m * R0, ...)`
+    compute secondary/tail region `R1` at `col_b = R0 * BN_A`, eliminating 104-CU wave quantization
+    without paying multi-kernel launch overhead. Branch ordering puts single-subtile regions on the
+    early-return path to minimize VGPR live-range union across regions.
+    """
+    pid = tl.program_id(0)
+    grid_m = tl.cdiv(M, BM)
+
+    if R1 == 0:
+        pid_m, pid_n = _swizzle_pid_2d(pid, grid_m, R0, GM)
+        _w8a8_gemm_region_body(
+            A, B, SA, SB, BIAS, C, M, N, K, pid_m, pid_n, 0,
+            BM, SUB_N0_A, SUB_N1_A, BK, EVEN_M, EVEN_N, EVEN_K, HAS_BIAS,
+        )
+    elif SUB_N1_A > 0 and SUB_N1_B == 0:
+        ctas_r0 = grid_m * R0
+        col_b: tl.constexpr = R0 * (SUB_N0_A + SUB_N1_A)
+        if pid >= ctas_r0:
+            pid_m1, pid_n1 = _swizzle_pid_2d(pid - ctas_r0, grid_m, R1, GM)
+            _w8a8_gemm_region_body(
+                A, B, SA, SB, BIAS, C, M, N, K, pid_m1, pid_n1, col_b,
+                BM, SUB_N0_B, 0, BK, EVEN_M, EVEN_N, EVEN_K, HAS_BIAS,
+            )
+            return
+        pid_m0, pid_n0 = _swizzle_pid_2d(pid, grid_m, R0, GM)
+        _w8a8_gemm_region_body(
+            A, B, SA, SB, BIAS, C, M, N, K, pid_m0, pid_n0, 0,
+            BM, SUB_N0_A, SUB_N1_A, BK, EVEN_M, EVEN_N, EVEN_K, HAS_BIAS,
+        )
+    else:
+        ctas_r0 = grid_m * R0
+        col_b: tl.constexpr = R0 * (SUB_N0_A + SUB_N1_A)
+        if pid < ctas_r0:
+            pid_m0, pid_n0 = _swizzle_pid_2d(pid, grid_m, R0, GM)
+            _w8a8_gemm_region_body(
+                A, B, SA, SB, BIAS, C, M, N, K, pid_m0, pid_n0, 0,
+                BM, SUB_N0_A, SUB_N1_A, BK, EVEN_M, EVEN_N, EVEN_K, HAS_BIAS,
+            )
+            return
+        pid_m1, pid_n1 = _swizzle_pid_2d(pid - ctas_r0, grid_m, R1, GM)
+        _w8a8_gemm_region_body(
+            A, B, SA, SB, BIAS, C, M, N, K, pid_m1, pid_n1, col_b,
+            BM, SUB_N0_B, SUB_N1_B, BK, EVEN_M, EVEN_N, EVEN_K, HAS_BIAS,
+        )
+
+
+@triton.jit
+def _accum_splitk_slice(
+    A, B, M, K: tl.constexpr, pid_m, pid_n, pid_k,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+    SPLIT_K: tl.constexpr, EVEN_M: tl.constexpr,
+):
+    """Accumulate `INT32` dot product over K-slice `pid_k` (`K // SPLIT_K` elements) via Direct-Operand DMA."""
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    ram = tl.max_contiguous(tl.multiple_of(rm, BM), BM) if EVEN_M else tl.max_contiguous(tl.multiple_of(rm % M, BM), BM)
+    rbn = tl.max_contiguous(tl.multiple_of(rn, BN), BN)
+    k_per_split: tl.constexpr = K // SPLIT_K
+    k_start = tl.multiple_of(pid_k * k_per_split, BK)
+    rk = tl.max_contiguous(tl.multiple_of(k_start + tl.arange(0, BK), BK), BK)
+    a_ptrs = A + (ram[:, None] * K + rk[None, :])
+    b_ptrs = B + (rk[:, None] + rbn[None, :] * K)
+    acc = tl.zeros((BM, BN), dtype=tl.int32)
+    for _ in range(0, k_per_split // BK):
+        acc = tl.dot(tl.load(a_ptrs), tl.load(b_ptrs), acc, out_dtype=tl.int32)
+        a_ptrs += BK
+        b_ptrs += BK
+    return acc, rm, rn, ram, rbn
+
+
+@triton.jit(do_not_specialize=["M"])
+def _unified_w8a8_1k_splitk_kernel(
+    A, B, SA, SB, BIAS, Partial_i32, Locks, C, M,
+    N: tl.constexpr, K: tl.constexpr,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+    EVEN_M: tl.constexpr, SPLIT_K: tl.constexpr,
+    HAS_BIAS: tl.constexpr = False,
+):
+    """Single-kernel L2-resident Split-K W8A8 GEMM using wait-free last-arriver atomic reduction.
+
+    Each `pid_k` CTA writes its `INT32` slice to `Partial_i32` and increments `Locks[pid]` with
+    `sem="acq_rel"` so prior `Partial_i32` stores are globally visible; only the last arriving CTA
+    (`old == SPLIT_K - 1`) sums all `SPLIT_K` slices, dequantizes, stores `C`, and resets `Locks[pid]`
+    to `0` (`sem="release"`) so `Locks` stays zero-initialized for subsequent CUDAGraph replays!
+    """
+    pid_all = tl.program_id(0)
+    pid, pid_k = pid_all // SPLIT_K, pid_all % SPLIT_K
+    grid_n: tl.constexpr = N // BN
+    acc, rm, rn, _, rbn = _accum_splitk_slice(A, B, M, K, pid // grid_n, pid % grid_n, pid_k, BM, BN, BK, SPLIT_K, EVEN_M)
+    sub_offs = tl.arange(0, BM)[:, None] * BN + tl.arange(0, BN)[None, :]
+    p_base = Partial_i32 + pid * (SPLIT_K * BM * BN)
+    tl.store(p_base + pid_k * (BM * BN) + sub_offs, acc)
+    tl.debug_barrier()
+    # `acq_rel` guarantees all warps' Partial_i32 stores commit to L2 before incrementing arrival count,
+    # and makes peer CTAs' Partial_i32 slices visible to the single winning last-arriver CTA.
+    if tl.atomic_add(Locks + pid, 1, sem="acq_rel") == (SPLIT_K - 1):
+        total = tl.zeros((BM, BN), dtype=tl.int32)
+        for sk in tl.static_range(0, SPLIT_K):
+            total += tl.load(p_base + sk * (BM * BN) + sub_offs)
+        sa = tl.load(SA + rm).to(tl.float32) if EVEN_M else tl.load(SA + rm, mask=rm < M, other=0.0).to(tl.float32)
+        sb = tl.load(SB + rbn).to(tl.float32)
+        val = total.to(tl.float32) * sa[:, None] * sb[None, :]
+        if HAS_BIAS:
+            val += tl.load(BIAS + rbn).to(tl.float32)[None, :]
+        res = val.to(C.dtype.element_ty)
+        c_ptrs = C + (rm[:, None] * N + rn[None, :])
+        if EVEN_M:
+            tl.store(c_ptrs, res)
+        else:
+            tl.store(c_ptrs, res, mask=(rm < M)[:, None])
+        tl.debug_barrier()
+        # Reset tile counter with `release` ordering so the lock array is clean for the next launch/graph replay.
+        tl.atomic_xchg(Locks + pid, 0, sem="release")
+
+
+@triton.jit(do_not_specialize=["M"])
+def _unified_w8a8_2s_splitk_kernel(
+    A, B, SA, SB, Partial, M,
+    N: tl.constexpr, K: tl.constexpr,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+    SPLIT_K: tl.constexpr, NUM_SA_GROUPS: tl.constexpr, EVEN_M: tl.constexpr,
+):
+    """Stage-1 of 2-stage Split-K W8A8: dequantize each K-slice (supporting `NUM_SA_GROUPS > 1`) into `Partial`.
+
+    Because `SPLIT_K` is chosen as a multiple of `NUM_SA_GROUPS`, each K-slice belongs to a single
+    activation scale group (`grp_off`), keeping the inner K-loop homogeneous `INT8 -> INT32` without
+    in-loop FP32 rescaling (`mxcc` NaN hazard `P4` & dual-layout spill avoided).
+    """
+    pid_all = tl.program_id(0)
+    pid, pid_k = pid_all // SPLIT_K, pid_all % SPLIT_K
+    grid_n: tl.constexpr = N // BN
+    acc, rm, rn, ram, rbn = _accum_splitk_slice(A, B, M, K, pid // grid_n, pid % grid_n, pid_k, BM, BN, BK, SPLIT_K, EVEN_M)
+    grp_off = ((pid_k // (SPLIT_K // NUM_SA_GROUPS)) * M) if NUM_SA_GROUPS > 1 else 0
+    sa = tl.load(SA + grp_off + ram).to(tl.float32) if EVEN_M else tl.load(SA + grp_off + rm, mask=rm < M, other=0.0).to(tl.float32)
+    sb = tl.load(SB + rbn).to(tl.float32)
+    res = (acc.to(tl.float32) * sa[:, None] * sb[None, :]).to(Partial.dtype.element_ty)
+    c_ptrs = Partial + pid_k * (M * N) + (rm[:, None] * N + rn[None, :])
+    if EVEN_M:
+        tl.store(c_ptrs, res)
+    else:
+        tl.store(c_ptrs, res, mask=(rm < M)[:, None])
+
+
+@triton.jit(do_not_specialize=["M", "total_elements"])
+def _w8a8_reduce_splitk_kernel(
+    Partial, BIAS, C, M, total_elements,
+    N_BIAS: tl.constexpr, SPLIT_K: tl.constexpr, BLOCK: tl.constexpr,
+    EVEN_TOTAL: tl.constexpr = False, HAS_BIAS: tl.constexpr = False,
+):
+    """Stage-2 of 2-stage Split-K W8A8: FP32-accurate flat reduction across `SPLIT_K` partial buffers."""
+    pid = tl.program_id(0)
+    offs_raw = pid * BLOCK + tl.arange(0, BLOCK)
+    if EVEN_TOTAL:
+        offs = tl.max_contiguous(tl.multiple_of(offs_raw, BLOCK), BLOCK)
+        s_sk = tl.multiple_of(total_elements, BLOCK)
+        acc = tl.zeros((BLOCK,), dtype=tl.float32)
+        for k in tl.static_range(0, SPLIT_K):
+            acc += tl.load(Partial + k * s_sk + offs).to(tl.float32)
+        if HAS_BIAS:
+            acc += tl.load(BIAS + (offs_raw % N_BIAS)).to(tl.float32)
+        tl.store(C + offs, acc.to(C.dtype.element_ty))
+    else:
+        mask = offs_raw < total_elements
+        acc = tl.zeros((BLOCK,), dtype=tl.float32)
+        for k in tl.static_range(0, SPLIT_K):
+            acc += tl.load(Partial + k * total_elements + offs_raw, mask=mask, other=0.0).to(tl.float32)
+        if HAS_BIAS:
+            acc += tl.load(BIAS + (offs_raw % N_BIAS), mask=mask, other=0.0).to(tl.float32)
+        tl.store(C + offs_raw, acc.to(C.dtype.element_ty), mask=mask)
+
+
+_MONOMORPHIC_PER_TOKEN_CACHE: dict[tuple[int, int, int], object] = {}
+
+
+def _resolve_b_nk(b_i8: torch.Tensor) -> tuple[torch.Tensor, int, int]:
+    """Normalize weight tensor `b_i8` to K-contiguous `[N, K]` layout (`stride(1) == 1`)."""
+    if b_i8.stride(1) == 1:
+        return b_i8, b_i8.shape[0], b_i8.shape[1]
+    if b_i8.stride(0) == 1:
+        b_nk = b_i8.t()
+        if b_nk.is_contiguous():
+            return b_nk, b_nk.shape[0], b_nk.shape[1]
+    b_nk = b_i8.t().contiguous() if b_i8.stride(0) == 1 else b_i8.contiguous()
+    return b_nk, b_nk.shape[0], b_nk.shape[1]
+
+
+def _build_per_token_launcher(N: int, K: int, in_nsg: int):
+    """Build a monomorphic per-`(N, K, in_nsg)` launcher with pre-bound `spec_key` tuples.
+
+    Pre-populates `spec_key_cache` across all `12` `(M - 1).bit_length()` buckets and `EVEN_M` flags
+    on device 0 BF16 so runtime dispatch (`_launch`) allocates zero key tuples and invokes compiled
+    C handles (`_fast_invoke_1d`) directly via raw CUDA/MACA stream pointers.
+    """
+    scale_group_size = (K // in_nsg) if in_nsg > 1 else 0
+    spec = LayerSpec.from_problem(N, K, carrier=False, scale_group_size=scale_group_size)
+    solve_w8a8_m_intervals(spec)
+    interval_lut = FastIntervalLauncher(spec)
+    table = interval_lut.table
+    spec_key_cache: dict[tuple[int, bool, bool, int, torch.dtype], Any] = {}
+
+    def _make_keys(b_idx: int, em: bool, hb: bool, dev: int, dt: torch.dtype):
+        """Construct and cache C-fast-launch specialization key(s) for `(b_idx, EVEN_M, HAS_BIAS, dev, dt)`.
+
+        Kernel type tags: `1` = 1D/2-region NT, `2` = 1-kernel atomic Split-K,
+        `3` = 2-stage Split-K stage-1, `4` = 2-stage Split-K FP32 reduction (`EVEN_TOTAL` True/False).
+        """
+        ts, s0a, s1a, s0b, s1b, even_n, even_k, m_even, m_odd = table[b_idx]
+        meta = m_even if em else m_odd
+        if ts.kind == "nt":
+            val = (dev, 1, N, K, ts.bm, s0a, s1a, ts.r0, s0b, s1b, ts.r1, ts.bk, ts.gm, em, even_n, even_k, hb, id(meta), dt)
+        elif ts.kind == "1k_splitk":
+            val = (dev, 2, N, K, ts.bm, ts.bn0, ts.bk, em, ts.split_k, hb, id(meta), dt)
+        else:
+            n_b = N if hb else 1
+            val = (
+                (dev, 3, N, K, ts.bm, ts.bn0, ts.bk, ts.split_k, ts.n_scale_groups, em, id(meta)),
+                (dev, 4, n_b, ts.split_k, True, hb, dt),
+                (dev, 4, n_b, ts.split_k, False, hb, dt),
+            )
+        spec_key_cache[(b_idx, em, hb, dev, dt)] = val
+        return val
+
+    # Pre-warm `spec_key_cache` for all 12 log2(M) buckets x {EVEN_M} x {HAS_BIAS} on dev=0 BF16
+    # to eliminate per-call tuple allocation on the steady-state serving path.
+    for _bi in range(12):
+        for _em in (False, True):
+            for _hb in (False, True):
+                _make_keys(_bi, _em, _hb, 0, torch.bfloat16)
+
+    def _fast_invoke_1d(key: Any, g0: int, dev: int, rt_args: tuple) -> bool:
+        """Invoke a cached 1D compiled kernel binary directly via raw stream pointer; return False on miss."""
+        # Bypass Triton Python wrapper when a compiled binary handle is cached and profiler is inactive.
+        if _GET_RAW_STREAM is None:
+            return False
+        h = get_fast_handle(key)
+        if h is None or not can_fast_launch(0, disallow_when_profiling=True):
+            return False
+        if _GET_DEVICE() == dev:
+            invoke_fast_handle(h, g0, 1, 1, _GET_RAW_STREAM(dev), rt_args)
+        else:
+            with torch_device_fn.device(dev):
+                invoke_fast_handle(h, g0, 1, 1, _GET_RAW_STREAM(dev), rt_args)
+        return True
+
+    def _launch(
+        a: torch.Tensor, b: torch.Tensor, x_scale: torch.Tensor, sb: torch.Tensor,
+        bias: torch.Tensor | None, out: torch.Tensor, M: int,
+    ):
+        """Dispatch W8A8 GEMM for runtime batch size `M` across NT, 1-kernel Split-K, or 2-stage Split-K."""
+        if a.stride(1) != 1:
+            a = a.contiguous()
+        hb = bias is not None
+        if hb:
+            if not bias.is_contiguous():
+                bias = bias.contiguous()
+            b_arg = bias
+        else:
+            b_arg = out
+        dev = out.device.index or 0
+        # O(1) bucket index via integer bit_length() matching FastIntervalLauncher.table[0..11].
+        idx = (M - 1).bit_length()
+        b_idx = 11 if idx > 11 else idx
+        ts, s0a, s1a, s0b, s1b, even_n, even_k, m_even, m_odd = table[b_idx]
+        sa = (x_scale if ts.n_scale_groups > 1 else x_scale[0]) if x_scale.ndim == 2 else x_scale
+        if not sa.is_contiguous():
+            sa = sa.contiguous()
+        # Fast 16-byte alignment check: base PyTorch allocations are >= 256B aligned when storage_offset == 0.
+        al = (
+            True
+            if (a.storage_offset() | b.storage_offset() | sa.storage_offset() | sb.storage_offset() | b_arg.storage_offset() | out.storage_offset()) == 0
+            else (((a.data_ptr() | b.data_ptr() | sa.data_ptr() | sb.data_ptr() | b_arg.data_ptr() | out.data_ptr()) & 15) == 0)
+        )
+        em = (M % ts.bm) == 0
+        dt = out.dtype
+        ck_key = (b_idx, em, hb, dev, dt)
+        keys = spec_key_cache.get(ck_key)
+        if keys is None:
+            keys = _make_keys(b_idx, em, hb, dev, dt)
+        gm_tiles = (M + ts.bm - 1) // ts.bm
+        if ts.kind == "nt":
+            g0 = gm_tiles * (ts.r0 + ts.r1)
+            rt_args = (a, b, sa, sb, b_arg, out, M)
+            if al and _fast_invoke_1d(keys, g0, dev, rt_args):
+                return out
+            meta = m_even if em else m_odd
+            launch_compiled_kernel(
+                keys, g0, dev, al, _unified_w8a8_nt_kernel,
+                rt_args,
+                (a, b, sa, sb, b_arg, out, M, N, K, ts.bm, s0a, s1a, ts.r0, s0b, s1b, ts.r1, ts.bk, ts.gm, em, even_n, even_k, hb),
+                meta, M < 16, disallow_when_profiling=True,
+            )
+            return out
+        meta = m_even if em else m_odd
+        aabs = M < 16
+        if ts.kind == "1k_splitk":
+            part = _get_splitk_i32_workspace(out.device, ts.split_k * gm_tiles * ts.bm * N)
+            locks = _get_splitk_locks_workspace(out.device, gm_tiles * ts.r0)
+            al_sk = al and (((part.data_ptr() | locks.data_ptr()) & 15) == 0 if (part.storage_offset() | locks.storage_offset()) else True)
+            g0 = gm_tiles * ts.r0 * ts.split_k
+            rt_args = (a, b, sa, sb, b_arg, part, locks, out, M)
+            if al_sk and _fast_invoke_1d(keys, g0, dev, rt_args):
+                return out
+            launch_compiled_kernel(
+                keys, g0, dev, al_sk, _unified_w8a8_1k_splitk_kernel,
+                rt_args,
+                (a, b, sa, sb, b_arg, part, locks, out, M, N, K, ts.bm, ts.bn0, ts.bk, em, ts.split_k, hb),
+                meta, aabs, disallow_when_profiling=True,
+            )
+            return out
+        total_e = M * N
+        part = _get_splitk_bf16_workspace(out.device, ts.split_k * total_e)
+        al_sk = al and (((part.data_ptr() & 15) == 0) if part.storage_offset() else True)
+        g1 = gm_tiles * ts.r0 * ts.split_k
+        key1, key_re, key_ro = keys
+        even_t = (total_e & 1023) == 0
+        key_r = key_re if even_t else key_ro
+        g_red = (total_e + 1023) // 1024
+        n_bias = N if hb else 1
+        rt1, rtr = (a, b, sa, sb, part, M), (part, b_arg, out, M, total_e)
+        if not (al_sk and _fast_invoke_1d(key1, g1, dev, rt1)):
+            launch_compiled_kernel(
+                key1, g1, dev, al_sk, _unified_w8a8_2s_splitk_kernel,
+                rt1,
+                (a, b, sa, sb, part, M, N, K, ts.bm, ts.bn0, ts.bk, ts.split_k, ts.n_scale_groups, em),
+                meta, aabs, disallow_when_profiling=True,
+            )
+        if not (al_sk and _fast_invoke_1d(key_r, g_red, dev, rtr)):
+            launch_compiled_kernel(
+                key_r, g_red, dev, al_sk,
+                _w8a8_reduce_splitk_kernel, rtr,
+                (part, b_arg, out, M, total_e, n_bias, ts.split_k, 1024, even_t, hb), _META_REDUCE_W4,
+                disallow_when_profiling=True,
+            )
+        return out
+
+    return _launch
+
+
+def w8a8_mm_per_token(
+    a_i8: torch.Tensor,
+    b_i8: torch.Tensor,
+    sa: torch.Tensor,
+    sb: torch.Tensor,
+    out: torch.Tensor | None = None,
+    out_dtype: torch.dtype = torch.bfloat16,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Compute dynamic per-token / per-channel W8A8 GEMM (`out = (a_i8 @ b_nk.T) * sa * sb (+ bias)`)."""
+    M, K_a = a_i8.shape
+    b_nk, N = (b_i8, b_i8.shape[0]) if (b_i8.stride(1) == 1 and b_i8.shape[1] == K_a) else _resolve_b_nk(b_i8)[:2]
+    if out is None:
+        out = torch.empty((M, N), device=a_i8.device, dtype=out_dtype)
+    if M == 0:
+        return out
+    in_nsg = sa.shape[0] if sa.ndim == 2 else 1
+    key = (N, K_a, in_nsg)
+    fn = _MONOMORPHIC_PER_TOKEN_CACHE.get(key)
+    if fn is None:
+        fn = _build_per_token_launcher(N, K_a, in_nsg)
+        _MONOMORPHIC_PER_TOKEN_CACHE[key] = fn
+    return fn(a_i8, b_nk, sa, sb, bias, out, M)
+
+
+@register_quant_layout_resolver("metax")
+def _metax_quant_weight_layout(
+    shape_n: int, shape_k: int, quant_mode: str, has_silu_mul_epilogue: bool = False
+) -> str:
+    """MetaX C500 `global_load_lds_dwordx4` DMA prefers row-major K-contiguous `[N, K]` INT8 weights."""
+    _ = shape_n, shape_k, quant_mode, has_silu_mul_epilogue
+    return "contiguous"
+
+
+@register_quant_gemm_w8a8("metax")
+def _metax_gemm_w8a8(
+    x_q: torch.Tensor,
+    x_scale: torch.Tensor,
+    qweight_nk: torch.Tensor,
+    w_scale: torch.Tensor,
+    bias: torch.Tensor | None,
+    out_dtype_code: int,
+    epilogue_mode: int,
+) -> torch.Tensor:
+    """FlagGems `quant_gemm_w8a8` backend entrypoint for MetaX C500."""
+    if epilogue_mode != 0:
+        raise NotImplementedError(f"Unsupported epilogue_mode={epilogue_mode} on MetaX")
+    out_dtype = code_to_dtype(out_dtype_code)
+    return w8a8_mm_per_token(
+        x_q, qweight_nk, x_scale, w_scale, out=None, out_dtype=out_dtype, bias=bias
+    )
+
+
+@register_quant_linear("metax")
+def metax_quant_linear(
+    x: torch.Tensor,
+    weight: QuantWeightTensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Execute quantized linear projection on MetaX C500 (`xcore1000`)."""
+    cfg = weight.cfg
+    if cfg.quant_mode != "w8a8":
+        raise ValueError(f"Unsupported QuantWeightTensor quant_mode on MetaX: {cfg.quant_mode!r}")
+    orig_shape = x.shape
+    single_1d = len(orig_shape) == 1
+    if single_1d:
+        x_2d = x.unsqueeze(0)
+    elif len(orig_shape) == 2:
+        x_2d = x
+    else:
+        x_2d = x.reshape(-1, orig_shape[-1])
+    if x_2d.stride(-1) != 1:
+        x_2d = x_2d.contiguous()
+    if x_2d.shape[0] == 0:
+        out_2d = x_2d.new_empty((0, cfg.shape_n))
+    else:
+        x_q, x_s = torch.ops.flag_gems.quant_input(x_2d, cfg.do_hadamard, cfg.num_scale_groups)
+        out_2d = torch.ops.flag_gems.quant_gemm_w8a8(
+            x_q, x_s, weight.qweight_nk, weight.w_scale, bias, dtype_to_code(x_2d.dtype), 0
+        )
+    if single_1d:
+        return out_2d.squeeze(0)
+    if len(orig_shape) == 2:
+        return out_2d
+    return out_2d.reshape(*orig_shape[:-1], cfg.shape_n)
+
+
+def prewarm_quant_layer(
+    cfg: QuantLayerConfig,
+    device: torch.device | str,
+    dtype: torch.dtype = torch.bfloat16,
+    m_buckets: tuple[int, ...] | None = None,
+    *,
+    max_decode_m: int = 64,
+    warm_norm: bool = False,
+) -> None:
+    """Analytically pre-compile quantized GEMM and fused activation quantizer kernels across `solve_w8a8_m_intervals`."""
+    dev = torch.device(device)
+    topo = get_device_topology()
+    scale_grp_sz = (cfg.shape_k // cfg.num_scale_groups) if cfg.num_scale_groups > 1 else 0
+    spec = LayerSpec.from_problem(cfg.shape_n, cfg.shape_k, scale_group_size=scale_grp_sz)
+    intervals = solve_w8a8_m_intervals(spec, topo)
+    full_max_m = 1 << (len(FastIntervalLauncher(spec, topo).table) - 1)
+    eff_max_m = max_decode_m if (cfg.shape_n * cfg.shape_k > 24 * topo.l2_cache_bytes) else full_max_m
+    if m_buckets is None:
+        # Sample both unaligned (`lo`, `9`) and `BM`-aligned (`ts.bm`, `m_al`) points per interval
+        # so both `EVEN_M=False` and `EVEN_M=True` specializations are compiled ahead of time.
+        pts: list[int] = []
+        for lo, hi, ts in intervals:
+            if lo > eff_max_m:
+                break
+            hi_c = min(hi, eff_max_m)
+            pts.append(lo)
+            if lo == 1 and hi_c >= 9:
+                pts.append(9)
+            if lo <= ts.bm <= hi_c:
+                pts.append(ts.bm)
+            m_al = (hi_c // ts.bm) * ts.bm
+            if m_al >= lo:
+                pts.append(m_al)
+        if spec.small_m_group_max_m <= eff_max_m:
+            pts.append(spec.small_m_group_max_m)
+        m_buckets = tuple(sorted(set(pts)))
+    if not m_buckets:
+        return
+    max_m_b = max(m_buckets)
+    qw = torch.zeros((cfg.shape_n, cfg.shape_k), dtype=torch.int8, device=dev)
+    ws = torch.ones((cfg.shape_n,), dtype=torch.float32, device=dev)
+    bias = torch.zeros((cfg.shape_n,), dtype=dtype, device=dev) if cfg.has_bias else None
+    x_buf = torch.zeros((max_m_b, cfg.shape_k), dtype=dtype, device=dev)
+    dt_code = dtype_to_code(dtype)
+    for m in m_buckets:
+        eff_nsg = cfg.num_scale_groups if (cfg.num_scale_groups > 1 and m <= spec.small_m_group_max_m) else 1
+        xq, xs = torch.ops.flag_gems.quant_input(x_buf[:m], cfg.do_hadamard, eff_nsg)
+        torch.ops.flag_gems.quant_gemm_w8a8(xq, xs, qw, ws, bias, dt_code, 0)
+    if (cfg.do_hadamard or cfg.num_scale_groups > 1) and (
+        cfg.shape_n * cfg.shape_k <= 24 * topo.l2_cache_bytes
+    ):
+        gu_buf = torch.zeros((max_m_b, 2 * cfg.shape_k), dtype=dtype, device=dev)
+        for m in m_buckets:
+            torch.ops.flag_gems.silu_mul_quant(gu_buf[:m], cfg.do_hadamard, cfg.num_scale_groups)
+    if warm_norm:
+        w_n = torch.ones((cfg.shape_k,), dtype=dtype, device=dev)
+        r_buf = torch.zeros((max_m_b, cfg.shape_k), dtype=dtype, device=dev)
+        for m in m_buckets:
+            torch.ops.flag_gems.rmsnorm_quant(x_buf[:m], w_n, 1e-6, cfg.do_hadamard, 1)
+            torch.ops.flag_gems.fused_add_rmsnorm_quant(
+                x_buf[:m], r_buf[:m], w_n, 1e-6, cfg.do_hadamard, 1
+            )
+
+
+__all__ = [
+    "DTYPE_BF16", "DTYPE_FP16", "_rint_f32", "code_to_dtype", "dtype_to_code",
+    "fused_add_rmsnorm_quant", "fwht_lastdim_fp32", "metax_quant_linear",
+    "prewarm_quant_layer", "quant_gemm_w8a8", "quant_input",
+    "quantize_linear_weight", "rmsnorm_quant", "silu_mul_quant",
+    "sw_mgoc_quantize_weight", "w8a8_mm_per_token",
+]
