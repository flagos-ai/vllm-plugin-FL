+    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    EVEN_K: tl.constexpr = (K % (BLOCK_K * SPLIT_K)) == 0
+    k_per_split: tl.constexpr = K // SPLIT_K
