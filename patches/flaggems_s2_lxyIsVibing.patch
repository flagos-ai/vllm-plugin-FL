+@triton.jit
+def _bf16_swizzle_pid_2d(pid, grid_m, grid_n: tl.constexpr, GM: tl.constexpr):
+    """Swizzle 1D `pid` into `(pid_m, pid_n)` in `GM`-row L2-reuse groups."""
+    if GM == 1:
+        return pid // grid_n, pid % grid_n
+    width: tl.constexpr = GM * grid_n
+    group_id = pid // width
+    first_m = group_id * GM
+    gsz = tl.minimum(grid_m - first_m, GM)
+    return first_m + (pid % gsz), (pid % width) // gsz
