@@ -0,0 +1,299 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Fused QK NeoX RoPE + Paged KV Scatter + Contiguous Prefix/Chunk KV Gather for MetaX C500.
+
+Why this fused design is tailored to MetaX C500 (`xcore1000`, `104` Active CUs, `warp_size=64`):
+1. **Hazard-Free Wave64 NeoX Half-Head Rotation (`head_dim=128` -> `64` pairs = `1` Wave64)**:
+   NeoX-style RoPE pairs lane `d in [0, 64)` with `d + 64`. By mapping the fast dimension
+   to `d = tl.arange(0, 64)` (exactly one 64-lane MACA wavefront per head) and loading both
+   halves (`q1/q2`, `k1/k2`) into VGPRs before issuing any `tl.store`, each wavefront rotates
+   a head in registers with zero shared memory and zero intra-CTA read-before-write hazards.
+2. **Decode CU Occupancy (`SPLIT_TOKEN=True` at `M <= 64`) vs. Prefill Multi-Head Tiling (`BLOCK_H`)**:
+   - At small batch sizes (`M <= 64`), `1` CTA/token under-utilizes `104` CUs. `SPLIT_TOKEN=True`
+     doubles grid parallelism (`2` CTAs/token): `half == 0` rotates Q heads `[0..7]` + all `2` KV
+     heads and scatters rotated K into paged cache; `half == 1` rotates Q heads `[8..15]` and
+     scatters V (`2 * 128 = 256` elements) into paged cache.
+   - At larger token counts, each token CTA tiles the `16` Q heads in `BLOCK_H`-sized groups
+     while reusing the token's `cos/sin` slice (`eviction_policy="evict_last"`) in registers.
+3. **Single-Launch Contiguous KV Gather (`GATHER_CONTIG_KV=True`, `~1.5 us` vs `~45 us` standalone)**:
+   For chunked/prefix prefill (`prefill_mode == 5`), launching `n_prefix_pages` extra CTAs in
+   the same grid gathers cached prefix KV pages (`[num_blocks, BLOCK_SIZE=16, 2, 128]`, `4096`
+   elems/page) into linear `k_contig/v_contig`, while token CTAs (`num_decode_tokens <= t < cont_end_tok`)
+   simultaneously tee newly computed K/V into both paged cache and the linear tail.
+"""
+
+import logging
+
+import torch
+import triton
+import triton.language as tl
+
+from flag_gems.runtime import torch_device_fn
+
+logger = logging.getLogger("flag_gems." + __name__)
+
+
+@triton.jit
+def _fused_qk_rope_and_cache_kv_kernel(
+    q_ptr,
+    k_ptr,
+    v_ptr,
+    q_out_ptr,
+    pos_ptr,
+    cos_sin_ptr,
+    slot_ptr,
+    k_cache_ptr,
+    v_cache_ptr,
+    stride_qt,
+    stride_kt,
+    stride_vt,
+    stride_cb,
+    stride_cs,
+    k_contig_ptr,
+    v_contig_ptr,
+    bt_ptr,
+    num_actual_tokens,
+    num_decode_tokens,
+    cont_end_tok,
+    prefix_len,
+    BLOCK_SIZE: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    WRITE_K_INPLACE: tl.constexpr,
+    GATHER_CONTIG_KV: tl.constexpr = False,
+    SPLIT_TOKEN: tl.constexpr = False,
+    NUM_Q_HEADS: tl.constexpr = 16,
+    NUM_KV_HEADS: tl.constexpr = 2,
+    HEAD_DIM: tl.constexpr = 128,
+):
+    """Apply NeoX RoPE to Q/K, scatter K/V into paged cache, and optionally gather linear KV."""
+    HALF_DIM: tl.constexpr = HEAD_DIM // 2
+    Q_DIM: tl.constexpr = NUM_Q_HEADS * HEAD_DIM
+    KV_DIM: tl.constexpr = NUM_KV_HEADS * HEAD_DIM
+    pid = tl.program_id(0).to(tl.int64)
+    if SPLIT_TOKEN:
+        # Small-M Decode fast path (M <= 64): 2 CTAs per token to double occupancy across CUs.
+        Q_HALF: tl.constexpr = NUM_Q_HEADS // 2
+        t = pid >> 1
+        half = pid & 1
+        pos = tl.load(pos_ptr + t).to(tl.int64)
+        # 16-elem aligned vector loads across half of HEAD_DIM.
+        d = tl.max_contiguous(tl.multiple_of(tl.arange(0, HALF_DIM), 16), 16)
+        cs_base = cos_sin_ptr + pos * HEAD_DIM
+        cos = tl.load(cs_base + d, eviction_policy="evict_last").to(tl.float32)[None, :]
+        sin = tl.load(cs_base + HALF_DIM + d, eviction_policy="evict_last").to(tl.float32)[None, :]
+
+        # Each half-CTA rotates Q_HALF of the NUM_Q_HEADS query heads.
+        h = tl.arange(0, Q_HALF)[:, None]
+        d_row = d[None, :]
+        h_off = (half * Q_HALF + h) * HEAD_DIM
+        q_in_base = q_ptr + t * tl.multiple_of(stride_qt, 16)
+        q_out_base = q_out_ptr + t * Q_DIM
+        # Load both NeoX halves into VGPRs prior to any store so q_out == q_in aliasing is hazard-free.
+        q1 = tl.load(q_in_base + h_off + d_row).to(tl.float32)
+        q2 = tl.load(q_in_base + h_off + HALF_DIM + d_row).to(tl.float32)
+        oq1 = (q1 * cos - q2 * sin).to(q_out_ptr.dtype.element_ty)
+        oq2 = (q2 * cos + q1 * sin).to(q_out_ptr.dtype.element_ty)
+        tl.store(q_out_base + h_off + d_row, oq1)
+        tl.store(q_out_base + h_off + HALF_DIM + d_row, oq2)
+
+        slot = tl.load(slot_ptr + t).to(tl.int64)
+        if half == 0:
+            # Half 0 rotates all NUM_KV_HEADS GQA K heads (HEAD_DIM) and scatters K to paged cache.
+            h_kv = tl.arange(0, NUM_KV_HEADS)[:, None]
+            k_base = k_ptr + t * tl.multiple_of(stride_kt, 16) + h_kv * HEAD_DIM
+            k1 = tl.load(k_base + d_row).to(tl.float32)
+            k2 = tl.load(k_base + HALF_DIM + d_row).to(tl.float32)
+            ok1 = (k1 * cos - k2 * sin).to(k_ptr.dtype.element_ty)
+            ok2 = (k2 * cos + k1 * sin).to(k_ptr.dtype.element_ty)
+            if WRITE_K_INPLACE:
+                tl.store(k_base + d_row, ok1)
+                tl.store(k_base + HALF_DIM + d_row, ok2)
+            if slot >= 0:
+                # Negative slots indicate padding tokens (e.g. CUDAGraph bucket padding); skip KV scatter.
+                b_idx = slot // BLOCK_SIZE
+                b_off = slot % BLOCK_SIZE
+                c_base = b_idx * tl.multiple_of(stride_cb, 16) + b_off * tl.multiple_of(
+                    stride_cs, 16
+                )
+                c_off = c_base + h_kv * HEAD_DIM
+                tl.store(k_cache_ptr + c_off + d_row, ok1)
+                tl.store(k_cache_ptr + c_off + HALF_DIM + d_row, ok2)
+        else:
+            # Half 1 copies unrotated V ([NUM_KV_HEADS, 128] = KV_DIM contiguous elems) into paged V cache.
+            if slot >= 0:
+                b_idx = slot // BLOCK_SIZE
+                b_off = slot % BLOCK_SIZE
+                c_base = b_idx * tl.multiple_of(stride_cb, 16) + b_off * tl.multiple_of(
+                    stride_cs, 16
+                )
+                offs_v = tl.max_contiguous(tl.multiple_of(tl.arange(0, KV_DIM), 16), 16)
+                v_val = tl.load(v_ptr + t * tl.multiple_of(stride_vt, 16) + offs_v)
+                tl.store(v_cache_ptr + c_base + offs_v, v_val)
+        return
+
+    # Single-launch prefix KV gather: extra CTAs (pid < n_prefix_pages) linearize cached
+    # KV pages (BLOCK_SIZE * NUM_KV_HEADS * 128 elems/page) into k_contig/v_contig.
+    if GATHER_CONTIG_KV:
+        PAGE_ELEMS: tl.constexpr = BLOCK_SIZE * KV_DIM
+        PAGE_CHUNKS: tl.constexpr = PAGE_ELEMS // 1024
+        n_prefix_pages = (prefix_len + BLOCK_SIZE - 1) // BLOCK_SIZE
+        if pid < n_prefix_pages:
+            page_idx = pid
+            b_idx = tl.load(bt_ptr + page_idx).to(tl.int64)
+            offs = tl.max_contiguous(tl.multiple_of(tl.arange(0, 1024), 16), 16)
+            src_base = b_idx * PAGE_ELEMS
+            dst_base = page_idx * PAGE_ELEMS
+            max_elem = prefix_len * KV_DIM - dst_base
+            if max_elem >= PAGE_ELEMS:
+                # Full KV page: unrolled PAGE_CHUNKS x 1024 coalesced streaming copy bypassing L2 pollution.
+                for i in tl.static_range(0, PAGE_CHUNKS):
+                    idx = i * 1024 + offs
+                    k_val = tl.load(
+                        k_cache_ptr + src_base + idx, eviction_policy="evict_first"
+                    )
+                    v_val = tl.load(
+                        v_cache_ptr + src_base + idx, eviction_policy="evict_first"
+                    )
+                    tl.store(k_contig_ptr + dst_base + idx, k_val)
+                    tl.store(v_contig_ptr + dst_base + idx, v_val)
+            else:
+                # Partial tail prefix page: mask out elements beyond prefix_len * KV_DIM.
+                for i in tl.static_range(0, PAGE_CHUNKS):
+                    idx = i * 1024 + offs
+                    m = idx < max_elem
+                    k_val = tl.load(k_cache_ptr + src_base + idx, mask=m)
+                    v_val = tl.load(v_cache_ptr + src_base + idx, mask=m)
+                    tl.store(k_contig_ptr + dst_base + idx, k_val, mask=m)
+                    tl.store(v_contig_ptr + dst_base + idx, v_val, mask=m)
+            return
+        t = pid - n_prefix_pages
+    else:
+        t = pid
+
+    # Standard 1-CTA-per-token path: load per-token RoPE cos/sin once and tile NUM_Q_HEADS by BLOCK_H.
+    pos = tl.load(pos_ptr + t).to(tl.int64)
+    slot = tl.load(slot_ptr + t).to(tl.int64)
+    d = tl.max_contiguous(tl.multiple_of(tl.arange(0, HALF_DIM), 16), 16)
+    cs_base = cos_sin_ptr + pos * HEAD_DIM
+    cos = tl.load(cs_base + d, eviction_policy="evict_last").to(tl.float32)[None, :]
+    sin = tl.load(cs_base + HALF_DIM + d, eviction_policy="evict_last").to(tl.float32)[None, :]
+
+    h = tl.arange(0, BLOCK_H)[:, None]
+    d_row = d[None, :]
+
+    # Rotate NUM_Q_HEADS in static BLOCK_H groups; evict streaming Q inputs first, keep Q outputs L2-warm.
+    q_in_base = q_ptr + t * tl.multiple_of(stride_qt, 16)
+    q_out_base = q_out_ptr + t * Q_DIM
+    for h_start in tl.static_range(0, NUM_Q_HEADS, BLOCK_H):
+        h_off = (h_start + h) * HEAD_DIM
+        if h_start + BLOCK_H <= NUM_Q_HEADS:
+            q1 = tl.load(
+                q_in_base + h_off + d_row, eviction_policy="evict_first"
+            ).to(tl.float32)
+            q2 = tl.load(
+                q_in_base + h_off + HALF_DIM + d_row, eviction_policy="evict_first"
+            ).to(tl.float32)
+            oq1 = (q1 * cos - q2 * sin).to(q_out_ptr.dtype.element_ty)
+            oq2 = (q2 * cos + q1 * sin).to(q_out_ptr.dtype.element_ty)
+            tl.store(q_out_base + h_off + d_row, oq1, eviction_policy="evict_last")
+            tl.store(q_out_base + h_off + HALF_DIM + d_row, oq2, eviction_policy="evict_last")
+        else:
+            m_q = (h_start + h) < NUM_Q_HEADS
+            q1 = tl.load(
+                q_in_base + h_off + d_row, mask=m_q, other=0.0, eviction_policy="evict_first"
+            ).to(tl.float32)
+            q2 = tl.load(
+                q_in_base + h_off + HALF_DIM + d_row, mask=m_q, other=0.0, eviction_policy="evict_first"
+            ).to(tl.float32)
+            oq1 = (q1 * cos - q2 * sin).to(q_out_ptr.dtype.element_ty)
+            oq2 = (q2 * cos + q1 * sin).to(q_out_ptr.dtype.element_ty)
+            tl.store(q_out_base + h_off + d_row, oq1, mask=m_q, eviction_policy="evict_last")
+            tl.store(q_out_base + h_off + HALF_DIM + d_row, oq2, mask=m_q, eviction_policy="evict_last")
+
+    # Rotate all NUM_KV_HEADS GQA K heads (HEAD_DIM) in VGPRs before any in-place/cache store.
+    h_kv = tl.arange(0, NUM_KV_HEADS)[:, None]
+    k_base = k_ptr + t * tl.multiple_of(stride_kt, 16) + h_kv * HEAD_DIM
+    k1 = tl.load(k_base + d_row, eviction_policy="evict_first").to(tl.float32)
+    k2 = tl.load(k_base + HALF_DIM + d_row, eviction_policy="evict_first").to(tl.float32)
+    ok1 = (k1 * cos - k2 * sin).to(k_ptr.dtype.element_ty)
+    ok2 = (k2 * cos + k1 * sin).to(k_ptr.dtype.element_ty)
+
+    if WRITE_K_INPLACE:
+        tl.store(k_base + d_row, ok1)
+        tl.store(k_base + HALF_DIM + d_row, ok2)
+
+    # Scatter rotated K and raw V into paged KV cache [num_blocks, BLOCK_SIZE, NUM_KV_HEADS, HEAD_DIM].
+    if slot >= 0:
+        b_idx = slot // BLOCK_SIZE
+        b_off = slot % BLOCK_SIZE
+        c_base = b_idx * tl.multiple_of(stride_cb, 16) + b_off * tl.multiple_of(
+            stride_cs, 16
+        )
+        c_off = c_base + h_kv * HEAD_DIM
+        tl.store(k_cache_ptr + c_off + d_row, ok1)
+        tl.store(k_cache_ptr + c_off + HALF_DIM + d_row, ok2)
+
+        offs_v = tl.max_contiguous(tl.multiple_of(tl.arange(0, KV_DIM), 16), 16)
+        v_val = tl.load(
+            v_ptr + t * tl.multiple_of(stride_vt, 16) + offs_v,
+            eviction_policy="evict_first",
+        )
+        tl.store(v_cache_ptr + c_base + offs_v, v_val)
+
+        # Append current prefill chunk tokens directly after gathered prefix KV in linear buffer.
+        if GATHER_CONTIG_KV:
+            if t >= num_decode_tokens and t < cont_end_tok:
+                ct_base = (prefix_len + (t - num_decode_tokens)) * KV_DIM
+                ct_off = ct_base + h_kv * HEAD_DIM
+                tl.store(k_contig_ptr + ct_off + d_row, ok1)
+                tl.store(k_contig_ptr + ct_off + HALF_DIM + d_row, ok2)
+                tl.store(v_contig_ptr + ct_base + offs_v, v_val)
+
+
+fused_qk_rope_and_cache_kv_kernel = _fused_qk_rope_and_cache_kv_kernel
+
+
+def fused_qk_rope_and_cache_kv(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    positions: torch.Tensor,
+    cos_sin_cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    *,
+    q_out: torch.Tensor | None = None,
+    num_actual_tokens: int | None = None,
+    write_k_inplace: bool = False,
+) -> torch.Tensor:
+    """Launch fused NeoX QK-RoPE + paged KV scatter for `[num_tokens, num_heads, head_dim]`."""
+    logger.debug("GEMS_METAX FUSED_QK_ROPE_AND_CACHE_KV")
+    n_tok = int(query.shape[0] if num_actual_tokens is None else num_actual_tokens)
+    out = query if q_out is None else q_out
+    if n_tok <= 0:
+        return out
+    h_q, d_h = int(query.shape[1]), int(query.shape[2])
+    h_kv = int(key.shape[1])
+    # Double CTA count (2 CTAs/token) for small-M decode when Q heads can be split evenly in half.
+    split_tok = n_tok <= 64 and h_q >= 2 and (h_q & (h_q - 1)) == 0
+    block_h = min(8, max(1, triton.next_power_of_2(h_q // 2 if split_tok else h_q)))
+    grid = (2 * n_tok,) if split_tok else (n_tok,)
+    with torch_device_fn.device(query.device):
+        _fused_qk_rope_and_cache_kv_kernel[grid](
+            query, key, value, out, positions, cos_sin_cache, slot_mapping, key_cache, value_cache,
+            query.stride(0), key.stride(0), value.stride(0), key_cache.stride(0), key_cache.stride(1),
+            query, query, slot_mapping, n_tok, 0, 0, 0,
+            BLOCK_SIZE=int(key_cache.shape[1]), BLOCK_H=block_h, WRITE_K_INPLACE=bool(write_k_inplace),
+            GATHER_CONTIG_KV=False, SPLIT_TOKEN=split_tok,
+            NUM_Q_HEADS=h_q, NUM_KV_HEADS=h_kv, HEAD_DIM=d_h,
+            num_warps=2 if h_kv <= 8 else 4,
+        )
+    return out
+
+
+__all__ = [
+    "_fused_qk_rope_and_cache_kv_kernel",
+    "fused_qk_rope_and_cache_kv",
+    "fused_qk_rope_and_cache_kv_kernel",
+]
