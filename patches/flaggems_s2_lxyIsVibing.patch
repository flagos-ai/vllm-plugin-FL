+def _get_splitk_bf16_workspace(device: torch.device, min_elems: int) -> torch.Tensor:
+    """Return persistent BF16 partial-sum buffer for 2-stage Split-K (stream-local during CUDAGraph capture)."""
+    dev_idx = device.index if device.index is not None else 0
+    buf = _SPLITK_BF16_WORKSPACE.get(dev_idx)
