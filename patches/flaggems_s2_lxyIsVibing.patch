+def _get_split_kv_scratch(
+    device: torch.device, num_heads: int, head_size: int, cap_needed: int, splits: int, kind: str, is_capturing: bool
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Return stream-local Split-KV partial buffers `(pa, pm, pl)` with geometric growth outside capture."""
+    dev_idx = device.index or 0
+    sid = _cuda_raw_stream(dev_idx) if _cuda_raw_stream is not None else torch.cuda.current_stream(device).cuda_stream
+    key = (dev_idx, sid, num_heads, head_size, splits, kind)
+    item = _SPLIT_KV_SCRATCH.get(key)
+    if item is None or item[0] < cap_needed:
+        if is_capturing:
+            pa = torch.empty((cap_needed * splits, num_heads, head_size), dtype=torch.float32, device=device)
+            pm = torch.empty((cap_needed * splits, num_heads), dtype=torch.float32, device=device)
+            return pa, pm, torch.empty_like(pm)
+        if item is not None:
+            # Keep replaced buffers alive so any captured CUDAGraph holding old pointers remains valid.
+            _SPLIT_KV_SCRATCH_RETIRED.append(item)
+        cap = max(cap_needed, item[0] * 2 if item else 64)
+        pa = torch.empty((cap * splits, num_heads, head_size), dtype=torch.float32, device=device)
+        pm = torch.empty((cap * splits, num_heads), dtype=torch.float32, device=device)
+        item = (cap, pa, pm, torch.empty_like(pm))
+        _SPLIT_KV_SCRATCH[key] = item
+    return item[1], item[2], item[3]
