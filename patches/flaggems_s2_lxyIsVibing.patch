+
+@triton.jit(do_not_specialize=["M", "total_elements"])
+def _reduce_splitk_kernel(
+    Partial,
+    C,
+    M,
+    total_elements,
+    SPLIT_K: tl.constexpr,
+    BLOCK: tl.constexpr,
+    EVEN_TOTAL: tl.constexpr = False,
+):
+    """Stage-2 FP32 reduction across `SPLIT_K` BF16 partial buffers (`BLOCK=1024` coalesced)."""
+    pid = tl.program_id(0)
+    offs = pid * BLOCK + tl.arange(0, BLOCK)
+    if EVEN_TOTAL:
+        offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)
+        s_sk = tl.multiple_of(total_elements, BLOCK)
+        acc = tl.zeros((BLOCK,), dtype=tl.float32)
+        for k in tl.static_range(0, SPLIT_K):
+            v = tl.load(Partial + k * s_sk + offs).to(tl.float32)
+            acc += v
+        tl.store(C + offs, acc.to(C.dtype.element_ty))
+    else:
+        mask = offs < total_elements
+        acc = tl.zeros((BLOCK,), dtype=tl.float32)
+        for k in tl.static_range(0, SPLIT_K):
+            v = tl.load(
+                Partial + k * total_elements + offs, mask=mask, other=0.0
+            ).to(tl.float32)
+            acc += v
+        tl.store(C + offs, acc.to(C.dtype.element_ty), mask=mask)
