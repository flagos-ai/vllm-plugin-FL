+        n_mask = cn < N
+        val = acc * tl.load(Bs + cn, mask=n_mask, other=0.0).to(tl.float32)[None, :]
+        if HAS_BIAS and SPLIT_K == 1:
+            val += tl.load(Bias + cn, mask=n_mask, other=0.0).to(tl.float32)[None, :]
+        mask = m_mask[:, None] & n_mask[None, :]
+        if SPLIT_K == 1:
+            tl.store(C + rm[:, None] * N + cn[None, :], val.to(C.dtype.element_ty), mask=mask)
+        else:
+            tl.store(C + iz * (M * N) + rm[:, None] * N + cn[None, :], val, mask=mask)
+
+
+# Deterministic second-stage reduction across `SPLIT_K` FP32 partial buffers `[SPLIT_K, M_LAUNCH, N]`.
+@triton.jit
+def quant_splitk_reduce_kernel(
+    Partials, Bias, Out, M, M_LAUNCH,
+    N: tl.constexpr, SPLIT_K: tl.constexpr, BLOCK: tl.constexpr, HAS_BIAS: tl.constexpr,
+):
+    """Sum `SPLIT_K` FP32 partial tiles `[SPLIT_K, M_LAUNCH, N]`, add optional bias, and store `Out`."""
+    idx = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask, sp = idx < (M * N), tl.arange(0, SPLIT_K)
+    acc = tl.sum(tl.load(Partials + sp[:, None] * (M_LAUNCH * N) + idx[None, :], mask=mask[None, :], other=0.0), axis=0)
+    if HAS_BIAS:
+        acc += tl.load(Bias + (idx % N), mask=mask, other=0.0).to(tl.float32)
+    tl.store(Out + idx, acc.to(Out.dtype.element_ty), mask=mask)
+
+
+def _launch_quant_gemm_impl(
+    a_tensor: torch.Tensor,
+    a_scale: torch.Tensor | None,
+    qweight_nk: torch.Tensor,
+    w_scale: torch.Tensor,
+    bias: torch.Tensor | None,
+    out_dtype: torch.dtype,
+    epilogue_mode: int,
+    is_w8a8: bool,
+    tuning: GemmTuningConfig,
+) -> torch.Tensor:
+    """Dispatch `quant_gemm_kernel` (and Split-K reduce when `split_k > 1`) via `FastKernelLauncher`."""
+    m_orig, (n, k), dev = a_tensor.shape[0], qweight_nk.shape, a_tensor.device
+    n_out = (n // 2) if epilogue_mode == 2 else n
+    if m_orig == 0:
+        return torch.empty((0, n_out), dtype=out_dtype, device=dev)
+    if a_tensor.stride(1) != 1 or not a_tensor.is_contiguous():
+        a_tensor = a_tensor.contiguous()
+    if a_scale is not None and a_scale.ndim == 2 and a_scale.shape[0] == 1:
+        a_scale = a_scale.squeeze(0)
+
+    # CoreX `ivcore11` Dual-SME (`use_sme=3`) requires 2D tiles with `M >= 2`.
+    # Reuse the 2-row physical backing storage from `_alloc_q_and_s` via zero-copy `as_strided`
+    # whenever available; fall back to stream-keyed `_get_m1_dual_sme_inputs` otherwise.
+    use_m1_pad = is_w8a8 and (m_orig == 1) and ((k & 63) == 0)
+    if use_m1_pad:
+        assert a_scale is not None
+        if (a_tensor.storage_offset() + 2 * k) <= a_tensor.untyped_storage().nbytes():
+            a_run, as_run, m_launch = torch.as_strided(a_tensor, (2, k), (k, 1)), a_scale, 2
+        else:
+            a_run, as_run, m_launch = *_get_m1_dual_sme_inputs(a_tensor, a_scale), 2
+    else:
+        a_run, as_run, m_launch = a_tensor, (a_scale if a_scale is not None else w_scale), m_orig
+
+    m_gt_1, has_bias = m_orig > 1, bias is not None
+    bias_buf, split_k = (bias if has_bias else w_scale), tuning.split_k
+    grid_x = triton.cdiv(m_launch, tuning.block_m) * triton.cdiv(n_out, tuning.block_n)
+    c_buf = torch.empty((m_launch if split_k == 1 else m_orig, n_out), dtype=out_dtype, device=dev)
+    target_c = c_buf if split_k == 1 else _get_splitk_workspace(dev, split_k, m_launch, n_out)
+
+    dev_idx = dev.index if dev.index is not None else _cuda_get_device()
+    g_key = (
+        dev_idx, a_run.dtype, target_c.dtype, n, k,
+        tuning.block_m, tuning.block_n, tuning.block_k, split_k,
+        tuning.group_m, tuning.num_warps, tuning.num_stages,
+        is_w8a8, epilogue_mode, has_bias, m_gt_1, int_align_spec(m_launch),
+    ) if all_ptrs_aligned_16(a_run, qweight_nk, as_run, w_scale, bias_buf, target_c) else None
+
+    if g_key is not None and (g_entry := _GEMM_LAUNCHER.get(g_key)) is not None:
+        g_entry(grid_x, split_k, 1, dev_idx, a_run, qweight_nk, as_run, w_scale, bias_buf, target_c, m_launch)
+    else:
+        ck = quant_gemm_kernel[(grid_x, split_k)](
+            a_run, qweight_nk, as_run, w_scale, bias_buf, target_c, m_launch,
+            N=n, K=k, BLOCK_M=tuning.block_m, BLOCK_N=tuning.block_n, BLOCK_K=tuning.block_k,
+            SPLIT_K=split_k, GROUP_M=tuning.group_m, IS_W8A8=is_w8a8, EPILOGUE_MODE=epilogue_mode,
+            HAS_BIAS=has_bias, M_GT_1=m_gt_1, num_warps=tuning.num_warps, num_stages=tuning.num_stages,
+        )
+        if g_key is not None:
+            _GEMM_LAUNCHER.bind(g_key, ck, quant_gemm_kernel)
+
+    if split_k > 1:
+        red_blk, red_warps = (512, 2) if (m_orig * n_out <= 131072) else (1024, 4)
+        grid_r = (m_orig * n_out + red_blk - 1) // red_blk
+        r_key = (
+            dev_idx, c_buf.dtype, n_out, split_k, red_blk, red_warps,
+            has_bias, int_align_spec(m_orig), int_align_spec(m_launch),
+        )
+        if all_ptrs_aligned_16(target_c, bias_buf, c_buf) and (r_entry := _REDUCE_LAUNCHER.get(r_key)) is not None:
+            r_entry(grid_r, 1, 1, dev_idx, target_c, bias_buf, c_buf, m_orig, m_launch)
+        else:
+            ck_r = quant_splitk_reduce_kernel[(grid_r,)](
+                target_c, bias_buf, c_buf, m_orig, m_launch,
+                N=n_out, SPLIT_K=split_k, BLOCK=red_blk, HAS_BIAS=has_bias, num_warps=red_warps, num_stages=1,
+            )
+            if all_ptrs_aligned_16(target_c, bias_buf, c_buf):
+                _REDUCE_LAUNCHER.bind(r_key, ck_r, quant_splitk_reduce_kernel)
+        return c_buf
+    return c_buf[:1] if use_m1_pad else c_buf
+
+
+@torch.no_grad()
+def prewarm_quant_layer(
+    cfg: QuantLayerConfig,
+    device: torch.device,
+    dtype: torch.dtype = torch.bfloat16,
+) -> None:
+    """Pre-compile and bind `LibFastEntry` handles across all M-intervals of `cfg`."""
+    qw = torch.zeros((cfg.shape_n, cfg.shape_k), dtype=torch.int8, device=device)
+    ws = torch.ones((cfg.shape_n,), dtype=torch.float32, device=device)
+    bias = torch.zeros((cfg.shape_n,), dtype=dtype, device=device) if cfg.has_bias else None
+    nw, dtype_code = torch.ones((cfg.shape_k,), dtype=dtype, device=device), dtype_to_code(dtype)
+    seen_m: set[int] = set()
+    do_had, nsg = cfg.do_hadamard, cfg.num_scale_groups
+
+    for ep in ((1, 2) if cfg.col_layout == "interleaved_64" else (0,)):
+        for m_lo, m_hi, _ in get_interval_table(cfg, ep):
+            for m_sample in (m_lo, min(m_hi, 2048)):
+                if m_sample > 2048:
+                    continue
+                x = torch.zeros((m_sample, cfg.shape_k), dtype=dtype, device=device)
+                if cfg.quant_mode == "w8a16":
+                    quant_gemm_w8a16(x, qw, ws, bias)
+                else:
+                    if m_sample not in seen_m:
+                        seen_m.add(m_sample)
+                        quant_input(x, do_had, nsg)
+                        if do_had:
+                            quant_input(x, False, nsg)
+                        rmsnorm_quant(x, nw, 1e-5, do_had, nsg)
+                        fused_add_rmsnorm_quant(x, torch.zeros_like(x), nw, 1e-5, do_had, nsg)
+                    quant_gemm_w8a8(
+                        torch.zeros((m_sample, cfg.shape_k), dtype=torch.int8, device=device),
+                        torch.ones((m_sample,), dtype=torch.float32, device=device),
+                        qw, ws, bias, dtype_code, ep,
+                    )
+
+
+@register_quant_layout_resolver("iluvatar")
+def _iluvatar_quant_weight_layout(
+    shape_n: int, shape_k: int, quant_mode: str, has_silu_mul_epilogue: bool = False
+) -> str:
+    """Select `interleaved_64` layout for aligned W8A8 Gate+Up projections, else `contiguous`."""
+    if (
+        has_silu_mul_epilogue
+        and quant_mode == "w8a8"
+        and shape_n >= 128
+        and (shape_n % 128 == 0)
+        and (shape_k % 64 == 0)
+    ):
+        return "interleaved_64"
+    return "contiguous"
+
+
+@register_quant_gemm_w8a8("iluvatar")
+def _iluvatar_gemm_w8a8(
+    x_q: torch.Tensor,
+    x_scale: torch.Tensor,
+    qweight_nk: torch.Tensor,
+    w_scale: torch.Tensor,
+    bias: torch.Tensor | None,
+    out_dtype_code: int,
+    epilogue_mode: int,
+) -> torch.Tensor:
+    """Execute W8A8 INT8 SME GEMM with analytical `lookup_gemm_tuning` tile selection."""
+    n, k = qweight_nk.shape
+    return _launch_quant_gemm_impl(
+        x_q, x_scale, qweight_nk, w_scale, bias,
+        code_to_dtype(out_dtype_code), epilogue_mode, True,
+        lookup_gemm_tuning(x_q.shape[0], n, k, "w8a8", epilogue_mode),
+    )
+
+
+@register_quant_gemm_w8a16("iluvatar")
+def _iluvatar_gemm_w8a16(
+    x_2d: torch.Tensor,
+    qweight_nk: torch.Tensor,
+    w_scale: torch.Tensor,
+    bias: torch.Tensor | None,
+) -> torch.Tensor:
+    """Execute W8A16 GEMM, dynamically promoting to W8A8 INT8 SME when `M >= 32`.
+
+    At small Decode batch sizes (`M < 32`), `LM-Head` is HBM weight-bandwidth-bound so
+    direct W8A16 avoids activation quantization launch overhead. Once `M >= 32` (Prefill,
+    Mixed Chunked-Prefill, or large-batch Decode), GEMM becomes compute-bound on `ivcore11`
+    and promoting to dynamic per-token W8A8 unlocks `240 INT8 TOPS` (2x BF16 `120 TFLOPS`).
+    """
+    m, k = x_2d.shape
+    n = qweight_nk.shape[0]
+    if m >= 32 and (k % 64 == 0):
+        out_q, out_s = torch.ops.flag_gems.quant_input(x_2d, False, 1)
+        return _launch_quant_gemm_impl(
+            out_q, out_s, qweight_nk, w_scale, bias, x_2d.dtype, 0, True,
+            lookup_gemm_tuning(m, n, k, "w8a8", 0),
+        )
+    return _launch_quant_gemm_impl(
+        x_2d, None, qweight_nk, w_scale, bias, x_2d.dtype, 0, False,
+        lookup_gemm_tuning(m, n, k, "w8a16", 0),
+    )
+
+
+@register_quant_linear("iluvatar")
+def iluvatar_quant_linear(
+    x: torch.Tensor,
+    weight: QuantWeightTensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Execute quantized linear projection on Iluvatar BI-V150 (`ivcore11`)."""
+    cfg = weight.cfg
+    orig_shape = x.shape
+    single_1d = len(orig_shape) == 1
+    if single_1d:
+        x_2d = x.unsqueeze(0)
+    elif len(orig_shape) == 2:
+        x_2d = x
+    else:
+        x_2d = x.reshape(-1, orig_shape[-1])
+    if x_2d.stride(-1) != 1:
+        x_2d = x_2d.contiguous()
+
+    if cfg.quant_mode == "w8a8":
+        ep_mode = 1 if cfg.col_layout == "interleaved_64" else 0
+        x_q, x_s = torch.ops.flag_gems.quant_input(x_2d, cfg.do_hadamard, 1)
+        out_2d = torch.ops.flag_gems.quant_gemm_w8a8(
+            x_q, x_s, weight.qweight_nk, weight.w_scale, bias, dtype_to_code(x_2d.dtype), ep_mode
+        )
+    elif cfg.quant_mode == "w8a16":
+        out_2d = torch.ops.flag_gems.quant_gemm_w8a16(x_2d, weight.qweight_nk, weight.w_scale, bias)
+    else:
+        raise ValueError(f"Unsupported QuantWeightTensor quant_mode: {cfg.quant_mode!r}")
+
+    if single_1d:
+        return out_2d.squeeze(0)
+    if len(orig_shape) == 2:
+        return out_2d
+    return out_2d.reshape(*orig_shape[:-1], out_2d.shape[-1])
+
+
+__all__ = [
+    "DTYPE_BF16",
+    "DTYPE_FP16",
+    "code_to_dtype",
+    "dtype_to_code",
+    "iluvatar_quant_linear",
+    "prewarm_quant_layer",
+    "quant_gemm_kernel",
+    "quant_gemm_w8a16",
+    "quant_gemm_w8a8",
+    "quant_splitk_reduce_kernel",
+    "quantize_linear_weight",
+]
