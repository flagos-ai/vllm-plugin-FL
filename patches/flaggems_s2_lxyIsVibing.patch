+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Composable pure-Triton quantized Linear SME GEMM kernels (`W8A8` & `W8A16`)
+for Iluvatar BI-V150 (`ivcore11`), registered with `flag_gems.utils.quant_config`.
+
+Microarchitectural Highlights (`ivcore11` Wave64 Dual-SME):
+  1. Zero-Copy `M=1 -> M=2` Dual-SME Promotion: `ivcore11` matrix instructions
+     (`use_sme=3`) require 2D tiles with `M >= 2`. When `M == 1` activations carry
+     2-row backing storage (allocated by `quant_precondition._alloc_q_and_s`),
+     `_launch_quant_gemm_impl` creates a zero-copy `as_strided((2, K))` view,
+     avoiding extra padding kernels on the single-request Decode critical path.
+  2. Single-Dot Wide `[BM, 256]` Interleaved SwiGLU + FWHT-64 Epilogue (`EPILOGUE_MODE=2`):
+     Exploits 128-column physical `[Gate, Up]` interleaving (`col_layout="interleaved_64"`)
+     to merge two `[BM, 128]` matrix multiplications into a single `[BM, 256]` (`W=16`)
+     SME `tl.dot`, dequantizes once, splits `(g, u)` in registers via `tl.split`,
+     applies `silu(g) * u`, and executes 6-stage intra-wavefront `_hadamard_64` before store.
+  3. Deterministic Two-Kernel Split-K: Writes FP32 partial tiles `[SPLIT_K, M_LAUNCH, N]`
+     followed by `quant_splitk_reduce_kernel`, avoiding non-deterministic BF16 global
+     `atomic_add` contention on the 16 MiB L2 cache.
+  4. Dynamic `W8A16 -> W8A8` Promotion: Automatically promotes `W8A16` layers (e.g.,
+     `LM-Head`) to `W8A8` INT8 SME (`240 TOPS` vs `120 TFLOPS`) once `M >= 32`.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from flag_gems.utils.quant_config import (
+    DTYPE_BF16,
+    DTYPE_FP16,
+    GemmTuningConfig,
+    QuantLayerConfig,
+    QuantWeightTensor,
+    code_to_dtype,
+    dtype_to_code,
+    quant_gemm_w8a16,
+    quant_gemm_w8a8,
+    quantize_linear_weight,
+    register_quant_gemm_w8a16,
+    register_quant_gemm_w8a8,
+    register_quant_layout_resolver,
+    register_quant_linear,
+)
+from flag_gems.utils.quant_precondition import (
+    fused_add_rmsnorm_quant,
+    quant_input,
+    rmsnorm_quant,
+)
+
+from .gemm_heuristic import (
+    FastKernelLauncher,
+    all_ptrs_aligned_16,
+    get_interval_table,
+    int_align_spec,
+    lookup_gemm_tuning,
+)
+
+_cuda_get_device = getattr(torch._C, "_cuda_getDevice", torch.cuda.current_device)
+_cuda_raw_stream = getattr(torch._C, "_cuda_getCurrentRawStream", None)
+_GEMM_LAUNCHER = FastKernelLauncher()
+_REDUCE_LAUNCHER = FastKernelLauncher()
+_M1_PAD_CACHE: dict[tuple[int, int, int], tuple[torch.Tensor, torch.Tensor]] = {}
+_SPLITK_WS_CACHE: dict[tuple[int, int], torch.Tensor] = {}
+
+
+def _stream_key(dev: torch.device) -> tuple[int, int]:
+    """Return `(device_index, raw_stream_handle)` used to isolate per-stream scratch caches."""
+    idx = dev.index if dev.index is not None else _cuda_get_device()
+    return idx, (_cuda_raw_stream(idx) if _cuda_raw_stream is not None else 0)
+
+
+def _get_m1_dual_sme_inputs(
+    x_q: torch.Tensor, x_scale: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Pad `M=1` to `M_launch=2` (`[:2]` slice of zeroed `(64, K)` buffer) for CoreX `use_sme=3`."""
+    k = x_q.shape[1]
+    key = (*_stream_key(x_q.device), k)
+    pair = _M1_PAD_CACHE.get(key)
+    if pair is None:
+        if torch.cuda.is_current_stream_capturing():
+            pa = torch.zeros((2, k), dtype=torch.int8, device=x_q.device)
+            ps = torch.zeros((2,), dtype=torch.float32, device=x_q.device)
+            pa[:1].copy_(x_q)
+            ps[:1].copy_(x_scale)
+            return pa, ps
+        pair = (
+            torch.zeros((64, k), dtype=torch.int8, device=x_q.device)[:2],
+            torch.zeros((64,), dtype=torch.float32, device=x_q.device)[:2],
+        )
+        _M1_PAD_CACHE[key] = pair
+    pa2, ps2 = pair
+    pa2[:1].copy_(x_q)
+    ps2[:1].copy_(x_scale)
+    return pa2, ps2
+
+
+def _get_splitk_workspace(
+    dev: torch.device, split_k: int, m_launch: int, n: int
+) -> torch.Tensor:
+    """Return a stream-local FP32 partial-sum buffer `[split_k, m_launch, n]` for Split-K GEMM."""
+    need, s_key = split_k * m_launch * n, _stream_key(dev)
+    ws = _SPLITK_WS_CACHE.get(s_key)
+    if ws is None or ws.numel() < need:
+        if torch.cuda.is_current_stream_capturing():
+            return torch.empty((split_k, m_launch, n), dtype=torch.float32, device=dev)
+        ws = torch.empty((max(need, 4 * 64 * 4096),), dtype=torch.float32, device=dev)
+        _SPLITK_WS_CACHE[s_key] = ws
+    return ws[:need].view(split_k, m_launch, n)
