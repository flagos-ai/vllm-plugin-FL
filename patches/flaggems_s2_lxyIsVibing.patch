+DEFAULT_DEVICE_PROPS = IluvatarDeviceProps()
+DEFAULT_DEVICE_TOPOLOGY = DeviceTopology(
+    num_sms=DEFAULT_DEVICE_PROPS.num_cus,
+    l2_cache_bytes=DEFAULT_DEVICE_PROPS.l2_bytes,
+    smem_capacity_bytes=DEFAULT_DEVICE_PROPS.lds_bytes_per_cu,
+    warp_size=DEFAULT_DEVICE_PROPS.warp_size,
+    max_warps_per_cta=16,
+    co_resident_smem_bytes=DEFAULT_DEVICE_PROPS.two_cta_lds_budget,
+)
