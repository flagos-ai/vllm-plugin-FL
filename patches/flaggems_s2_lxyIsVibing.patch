+        if WIDE_KV:
+            phys_page = phys_page.to(tl.int64)
+        k_raw = tl.load(K + phys_page[:, None] * K0 + slot[:, None] * K1 + kh * K2 + d[None, :] * K3, mask=p_valid[:, None], other=0)
