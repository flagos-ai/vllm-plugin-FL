+@triton.jit(do_not_specialize=["M"])
+def _mm_nt_2region_tail_strip_kernel(
+    A, B, C, M,
+    N: tl.constexpr, K: tl.constexpr,
+    BM: tl.constexpr, SUB_N0: tl.constexpr, SUB_N1: tl.constexpr, R0: tl.constexpr,
+    TAIL_BM: tl.constexpr, TAIL_BN: tl.constexpr, TAIL_BK: tl.constexpr,
