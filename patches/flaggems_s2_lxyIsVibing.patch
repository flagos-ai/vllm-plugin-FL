+    if IS_W8A8:
+        ram = tl.max_contiguous(tl.multiple_of(rm % M, BLOCK_M), BLOCK_M)
+        rk = (iz * k_per_split + tl.arange(0, BLOCK_K)) if EVEN_K else (iz * BLOCK_K + tl.arange(0, BLOCK_K))
