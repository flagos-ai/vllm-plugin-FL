+@register_act_quant_schedule("metax")
+def _metax_select_act_quant_schedule(
+    m: int, k: int, act_mode: int, do_hadamard: bool, eff_nsg: int
+) -> tuple[bool, int, int]:
+    """Select Wave64 activation-quantization `(use_vec4, BLOCK_K, num_warps)` schedule on MetaX C500.
+
+    Derives `vec_chunk = warp_size * 32` (`64 * 32 = 2048` on Wave64) so each of `4` Wave64 waves
+    (`256` threads) issues coalesced `dwordx4` (`16 B` = `8 x BF16`) vector loads per chunk while
+    preserving `2 CTAs/CU` co-residency, including single-pass masked-tail spans (`k_grp >= 1536`).
+    """
+    vec_chunk = get_device_topology().warp_size * 32
+    half_chunk = vec_chunk // 2
+    min_tail_grp = 3 * (vec_chunk // 4)
+    k_grp = k // eff_nsg
+    is_norm = act_mode in (ACT_RMS_NORM, ACT_FUSED_ADD_RMS_NORM)
+    k_span = k if (eff_nsg == 1 or is_norm) else k_grp
+    eff_groups = eff_nsg if (eff_nsg > 1 and is_norm) else 1
+    if (k_grp % vec_chunk == 0) and (k_span % vec_chunk == 0) and (k_span <= 8 * vec_chunk):
+        if act_mode == ACT_NONE and (not do_hadamard) and k_span == vec_chunk and m >= 512:
+            return True, vec_chunk, 2
+        if act_mode == ACT_SILU_AND_MUL and m >= 1024:
+            return True, vec_chunk, 2
+        return True, vec_chunk, 4
+    if (k_grp % half_chunk == 0) and (k_span % half_chunk == 0) and (k_span <= 8 * half_chunk):
+        return True, half_chunk, 4
+    if eff_groups == 1 and (k_grp % 64 == 0) and (k_span % 64 == 0) and k_grp >= min_tail_grp and k_span <= 8 * vec_chunk:
+        return True, vec_chunk, 4
+    return _select_act_quant_schedule(k, act_mode, do_hadamard, eff_nsg, m)
+
