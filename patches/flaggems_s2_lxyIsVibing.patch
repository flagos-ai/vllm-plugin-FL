+def mixed_compact_enabled(num_seqs: int, max_query_len: int, total_q: int | None = None) -> bool:
+    """Return True when a mixed prefill+decode batch should use compacted prefill+decode dispatch."""
+    if max_query_len <= 1:
+        return False
+    has_decode = total_q is not None and num_seqs >= 8 and (total_q - max_query_len) < 2 * (num_seqs - 1)
+    return num_seqs > 1 and (max_query_len >= 128 or has_decode)
+
+
+def select_decode_splits(num_seqs: int, int8_kv: bool = True, v_int4: bool = True, num_kv_heads: int = 2) -> tuple[int, int]:
+    """Capture-invariant Split-KV selector `(splits, block_n)` across 16 CUs (64 SIMDs).
+
+    With 1-warp Decode CTAs, BI-V150 provides `16 CUs * 4 SIMDs = 64` wave slots per wave.
+    For `base_ctas = num_seqs * num_kv_heads >= 96` (e.g., `64 * 2 = 128`), `splits = 4`
+    yields `512 CTAs = 8` exact full waves across 64 SIMDs while minimizing LSE merge cost.
+    """
+    if not int8_kv:
+        return (64, 32) if num_seqs < 8 else (32, 16)
+    if not v_int4:
+        return (64 if num_seqs < 8 else (32 if num_seqs < 16 else 16)), 32
+    base_ctas = num_seqs * max(1, num_kv_heads)
+    return (4 if base_ctas >= 96 else (8 if base_ctas >= 64 else (16 if base_ctas >= 16 else 32))), 32
+
+
+def select_mixed_decode_splits(
+    num_seqs: int, int8_kv: bool = True, v_int4: bool = True, num_kv_heads: int = 2,
+    num_decode_seqs: int | None = None, max_decode_seq_len: int | None = None,
+    mean_decode_seq_len: int | None = None,
+) -> tuple[int, int]:
+    """Zero-sync POD horizon Split-KV selector for Mixed Chunked-Prefill + Decode steps.
+
+    Uses host-side scalar POD metadata (`num_decode_seqs`, `max_decode_seq_len`,
+    `mean_decode_seq_len`) to balance Split-KV CTA waves and cap `splits` on short
+    contexts without incurring any device-to-host synchronization.
+    """
+    eff_seqs = num_seqs if num_decode_seqs is None else max(1, int(num_decode_seqs))
+    if not (int8_kv and v_int4) or max_decode_seq_len is None or max_decode_seq_len <= 0:
+        return select_decode_splits(eff_seqs, int8_kv, v_int4, num_kv_heads)
+    if (
+        max_decode_seq_len >= 8192
+        and num_kv_heads <= 4
+        and (
+            (32 <= eff_seqs <= 54)
+            or (
+                eff_seqs >= 48
+                and mean_decode_seq_len is not None
+                and mean_decode_seq_len > 0
+                and mean_decode_seq_len < int(0.82 * max_decode_seq_len)
+            )
+        )
+    ):
+        return 16, 32
+    base_ctas = eff_seqs * max(1, num_kv_heads)
+    if base_ctas >= 96:
+        s = 2 if max_decode_seq_len <= 1024 else 4
+    elif base_ctas >= 64:
+        s = 4 if max_decode_seq_len <= 1024 else 8
+    elif base_ctas >= 32:
+        s = 8 if max_decode_seq_len <= 2048 else 16
+    elif base_ctas >= 16:
+        s = 8 if max_decode_seq_len <= 1024 else (16 if max_decode_seq_len <= 6144 else 32)
+    else:
+        s = 8 if max_decode_seq_len <= 512 else (16 if max_decode_seq_len <= 2048 else 32)
+    return s, 32
+
+
+def select_decode_split_kv_config(num_seqs: int, int8_kv: bool = True, v_int4: bool = True, num_kv_heads: int = 2) -> dict[str, int]:
+    """Return full decode Split-KV kernel launch parameters (`block_m`, `block_n`, `warps`, `splits`)."""
+    splits, block_n = select_decode_splits(num_seqs, int8_kv, v_int4, num_kv_heads)
+    return {"block_m": 16, "block_n": block_n, "warps": 2 if (not int8_kv and num_seqs < 8) else 1, "splits": splits}
+
