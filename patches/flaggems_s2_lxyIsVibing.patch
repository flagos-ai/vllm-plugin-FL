+@triton.jit(do_not_specialize=["M"])
+def _fast_mm_nt_kernel(
+    A,
+    B,
+    C,
+    M,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+    GM: tl.constexpr,
+    EVEN_M: tl.constexpr,
+    EVEN_N: tl.constexpr,
+    USE_INT64: tl.constexpr = False,
+):
+    """Single-region BF16 NT GEMM (`C = A @ B.T`, `K % BK == 0`) with Direct-Operand `HBM -> LDS` DMA.
+
+    `A[M, K]` and `B[N, K]` (viewed as `[K, N]` with `stride_bk == 1`) both have unit inner stride
+    along `K`, satisfying `xcore1000` `global_load_lds_dwordx4` alignment when `BM/BN/BK` are
+    annotated via `tl.multiple_of` + `tl.max_contiguous`. Accumulates in FP32 MFMA registers (`allow_tf32=False`).
+    """
+    pid = tl.program_id(0)
+    grid_m = tl.cdiv(M, BM)
+    grid_n = tl.cdiv(N, BN)
+    if GM == 1:
+        pid_m = pid // grid_n
+        pid_n = pid % grid_n
+    elif GM == 2 and grid_m == 2:
+        pid_m = pid % 2
+        pid_n = pid // 2
+    else:
+        width = GM * grid_n
+        group_id = pid // width
+        first_m = group_id * GM
+        gsz = tl.minimum(grid_m - first_m, GM)
+        pid_m = first_m + (pid % gsz)
+        pid_n = (pid % width) // gsz
+
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    if EVEN_M:
+        ram = tl.max_contiguous(tl.multiple_of(rm, BM), BM)
+    else:
+        ram = tl.max_contiguous(tl.multiple_of(rm % M, BM), BM)
+    if EVEN_N:
+        rbn = tl.max_contiguous(tl.multiple_of(rn, BN), BN)
+    else:
+        al_n: tl.constexpr = (
+            64
+            if (N % 64 == 0 and BN >= 64)
+            else (32 if (N % 32 == 0 and BN >= 32) else 8)
+        )
+        rbn = tl.max_contiguous(tl.multiple_of(rn % N, al_n), al_n)
+    if USE_INT64:
+        ram = ram.to(tl.int64)
+        rbn = rbn.to(tl.int64)
+    rk = tl.max_contiguous(tl.multiple_of(tl.arange(0, BK), BK), BK)
+
+    a_ptrs = A + (ram[:, None] * K + rk[None, :])
+    b_ptrs = B + (rk[:, None] + rbn[None, :] * K)
+    # Direct homogeneous BF16 `tl.dot` loop anchors `acc` to MFMA register layout (0 BlockedLayout LDS spills).
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for _ in range(0, K // BK):
+        a = tl.load(a_ptrs)
+        b = tl.load(b_ptrs)
+        acc = tl.dot(a, b, acc, out_dtype=tl.float32, allow_tf32=False)
+        a_ptrs += BK
+        b_ptrs += BK
+    res = acc.to(C.dtype.element_ty)
+
+    if USE_INT64:
+        c_ptrs = C + (rm[:, None].to(tl.int64) * N + rn[None, :])
+    else:
+        c_ptrs = C + (rm[:, None] * N + rn[None, :])
+    if EVEN_M and EVEN_N:
+        tl.store(c_ptrs, res)
+    elif EVEN_N:
+        tl.store(c_ptrs, res, mask=(rm < M)[:, None])
+    elif EVEN_M:
+        tl.store(c_ptrs, res, mask=(rn < N)[None, :])
+    else:
+        tl.store(c_ptrs, res, mask=(rm < M)[:, None] & (rn < N)[None, :])
+
