+def prewarm_attention_scratch(device: torch.device, num_heads: int, head_size: int) -> None:
+    """Pre-allocate stream-shared Split-KV scratch buffers prior to CUDAGraph capture."""
+    if bool(_is_capturing_fn()):
+        return
+    dev_idx = device.index or 0
+    sid = _cuda_raw_stream(dev_idx) if _cuda_raw_stream is not None else torch.cuda.current_stream(device).cuda_stream
+    for kind, splits, cap in (
+        ("token", 4, 512),
+        ("token", 8, 512),
+        ("token", 16, 64),
+        ("token", 32, 16),
+        ("sequence", 4, 64),
+        ("sequence", 16, 64),
+    ):
+        key = (dev_idx, sid, int(num_heads), int(head_size), splits, kind)
+        if key not in _SPLIT_KV_SCRATCH or _SPLIT_KV_SCRATCH[key][0] < cap:
+            pa = torch.empty((cap * splits, num_heads, head_size), dtype=torch.float32, device=device)
+            pm = torch.empty((cap * splits, num_heads), dtype=torch.float32, device=device)
+            _SPLIT_KV_SCRATCH[key] = (cap, pa, pm, torch.empty_like(pm))
