+class FastIntervalLauncher:
+    """Pre-bound 12-entry `O(1)` `(M - 1).bit_length()` lookup table for a MetaX `LayerSpec`.
+
+    Pre-resolves subtile splits (`160 -> 128+32`, `192 -> 128+64`), alignment flags (`even_n`, `even_k`),
+    and deduplicated `EVEN_M` / `ODD_M` MACA compiler metadata dicts at layer build time so hot-path
+    per-step dispatch performs zero dict allocations and zero heuristic math.
+    """
+
+    __slots__ = ("spec", "table")
+
+    def __init__(self, spec: LayerSpec, topo: DeviceTopology | None = None):
+        """Pre-solve and cache the 12-entry `log2(M)` tuning and metadata lookup table."""
+        self.spec = spec
+        meta_cache: dict[tuple[Any, ...], dict[str, Any]] = {}
+
+        def _meta(ts: TuningSpec, sc: str) -> dict[str, Any]:
+            """Intern MACA compiler launch metadata dicts so `id(meta)` is stable in fast-launch keys."""
+            key = (ts.num_warps, ts.num_stages, ts.pln, sc)
+            m = meta_cache.get(key)
+            if m is None:
+                m = {
+                    "pipeline": "basic",
+                    "num_warps": ts.num_warps,
+                    "num_stages": ts.num_stages,
+                    "pipeline_load_num": ts.pln,
+                }
+                if sc:
+                    m["scenario"] = sc
+                meta_cache[key] = m
+            return m
+
+        # Index `idx = min((M - 1).bit_length(), 11)` maps M in [1..8]->0..3, [9..16]->4, ..., [1025..inf)->11.
+        bucket_reps = (8, 8, 8, 8, 16, 32, 64, 128, 256, 512, 1024, 2048)
+        rows = []
+        for m_rep in bucket_reps:
+            ts = solve_w8a8_tuning_for_bucket(spec, m_rep, topo)
+            s0a, s1a = split_subtile(ts.bn0)
+            s0b, s1b = split_subtile(ts.bn1)
+            even_n = (ts.r0 * ts.bn0 + ts.r1 * ts.bn1) == spec.N
+            even_k = (spec.K % ts.bk) == 0
+            rows.append((ts, s0a, s1a, s0b, s1b, even_n, even_k, _meta(ts, ts.even_sc), _meta(ts, ts.odd_sc)))
+        self.table = tuple(rows)
+
+    def lookup(self, M: int):
+        """Return pre-bound `(TuningSpec, subtiles, alignment, meta_even, meta_odd)` in O(1)."""
+        idx = (M - 1).bit_length()
+        return self.table[11 if idx > 11 else idx]
+
+
