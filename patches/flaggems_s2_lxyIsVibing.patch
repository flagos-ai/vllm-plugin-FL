+        k_scale = torch.as_strided(base_bf16, size=(num_blocks, block_size, nkv), stride=(tail_bytes // 2, nkv * 2, 2), storage_offset=data_bytes // 2)
+        v_scale = torch.as_strided(base_bf16, size=(num_blocks, block_size, nkv), stride=(tail_bytes // 2, nkv * 2, 2), storage_offset=data_bytes // 2 + 1)
+        return k_scale, v_scale, packed_i32
+    ks = torch.ones((num_blocks, block_size, nkv), dtype=torch.float32, device=kv_cache.device)
+    return ks, torch.ones_like(ks), None
