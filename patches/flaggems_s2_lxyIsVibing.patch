+@triton.jit
+def _bf16_gemm_region_body(
+    A, B, C, M, N: tl.constexpr, K: tl.constexpr,
+    pid_m, pid_n, COL_BASE: tl.constexpr,
+    BM: tl.constexpr, SUB_N0: tl.constexpr, SUB_N1: tl.constexpr, BK: tl.constexpr,
+    EVEN_M: tl.constexpr, EVEN_N: tl.constexpr,
+):
+    """Compute one BF16 NT tile `[BM, SUB_N0 (+ SUB_N1)]` with 2-CTA/CU LDS co-residency (`<= 32 KiB`).
+
+    When `SUB_N1 > 0` (`160 = 128 + 32` or `192 = 128 + 64`), `a = tl.load(a_ptrs)` (`256x32` BF16 = `16 KiB`)
+    is loaded once per K-step and shared across two power-of-two FP32 MFMA accumulators (`acc0`, `acc1`),
+    keeping total `1x`-buffer LDS at `(256 + 192) * 32 * 2 = 28 KiB <= 32 KiB` (`2 CTAs/CU`).
+    """
+    BN: tl.constexpr = SUB_N0 + SUB_N1
+    rm = pid_m * BM + tl.arange(0, BM)
+    ram = tl.max_contiguous(tl.multiple_of(rm, BM), BM) if EVEN_M else tl.max_contiguous(tl.multiple_of(rm % M, BM), BM)
+    rk = tl.max_contiguous(tl.multiple_of(tl.arange(0, BK), BK), BK)
+    a_ptrs = A + (ram[:, None] * K + rk[None, :])
+
+    if SUB_N1 == 0:
+        rn = COL_BASE + pid_n * SUB_N0 + tl.arange(0, SUB_N0)
+        rbn = tl.max_contiguous(tl.multiple_of(rn, SUB_N0), SUB_N0) if EVEN_N else tl.max_contiguous(tl.multiple_of(rn % N, 32), 32)
+        b_ptrs = B + (rk[:, None] + rbn[None, :] * K)
+        acc = tl.zeros((BM, SUB_N0), dtype=tl.float32)
+        for _ in range(0, K // BK):
+            acc = tl.dot(tl.load(a_ptrs), tl.load(b_ptrs), acc, out_dtype=tl.float32, allow_tf32=False)
+            a_ptrs += BK
+            b_ptrs += BK
+        res = acc.to(C.dtype.element_ty)
+        c_ptrs = C + (rm[:, None] * N + rn[None, :])
+        if EVEN_M and EVEN_N:
+            tl.store(c_ptrs, res)
+        elif EVEN_N:
+            tl.store(c_ptrs, res, mask=(rm < M)[:, None])
+        elif EVEN_M:
+            tl.store(c_ptrs, res, mask=(rn < N)[None, :])
+        else:
+            tl.store(c_ptrs, res, mask=(rm < M)[:, None] & (rn < N)[None, :])
+    else:
+        # Dual-accumulator sub-tile path: reuse `a` across `SUB_N0` (128) and `SUB_N1` (32 or 64).
+        align_n: tl.constexpr = 64 if (SUB_N1 == 64 and COL_BASE % 64 == 0) else 32
+        rn0 = COL_BASE + pid_n * BN + tl.arange(0, SUB_N0)
+        rn1 = COL_BASE + pid_n * BN + SUB_N0 + tl.arange(0, SUB_N1)
+        if EVEN_N:
+            rbn0 = tl.max_contiguous(tl.multiple_of(rn0, align_n), SUB_N0)
+            rbn1 = tl.max_contiguous(tl.multiple_of(rn1, align_n), SUB_N1)
+        elif ((N % 64) == 0 and (COL_BASE % 64) == 0) and (BN % 64) == 0:
+            rbn0 = tl.max_contiguous(tl.multiple_of(rn0 % N, 64), SUB_N0)
+            rbn1 = tl.max_contiguous(tl.multiple_of(rn1 % N, 64), SUB_N1)
+        else:
+            rbn0 = tl.max_contiguous(tl.multiple_of(rn0 % N, 32), 32)
+            rbn1 = tl.max_contiguous(tl.multiple_of(rn1 % N, 32), 32)
+        b0_ptrs = B + (rk[:, None] + rbn0[None, :] * K)
+        b1_ptrs = B + (rk[:, None] + rbn1[None, :] * K)
+        acc0 = tl.zeros((BM, SUB_N0), dtype=tl.float32)
+        acc1 = tl.zeros((BM, SUB_N1), dtype=tl.float32)
+        for _ in range(0, K // BK):
+            a = tl.load(a_ptrs)
+            acc0 = tl.dot(a, tl.load(b0_ptrs), acc0, out_dtype=tl.float32, allow_tf32=False)
+            acc1 = tl.dot(a, tl.load(b1_ptrs), acc1, out_dtype=tl.float32, allow_tf32=False)
+            a_ptrs += BK
+            b0_ptrs += BK
+            b1_ptrs += BK
+        res0 = acc0.to(C.dtype.element_ty)
+        res1 = acc1.to(C.dtype.element_ty)
+        c0_ptrs = C + (rm[:, None] * N + rn0[None, :])
+        c1_ptrs = C + (rm[:, None] * N + rn1[None, :])
+        if EVEN_M and EVEN_N:
+            tl.store(c0_ptrs, res0)
+            tl.store(c1_ptrs, res1)
+        elif EVEN_N:
+            tl.store(c0_ptrs, res0, mask=(rm < M)[:, None])
+            tl.store(c1_ptrs, res1, mask=(rm < M)[:, None])
+        elif EVEN_M:
+            tl.store(c0_ptrs, res0, mask=(rn0 < N)[None, :])
+            tl.store(c1_ptrs, res1, mask=(rn1 < N)[None, :])
+        else:
+            tl.store(c0_ptrs, res0, mask=(rm < M)[:, None] & (rn0 < N)[None, :])
+            tl.store(c1_ptrs, res1, mask=(rm < M)[:, None] & (rn1 < N)[None, :])
+
