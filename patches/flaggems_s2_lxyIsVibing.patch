+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Analytical hardware properties, M-interval GEMM tuning tables, and
+Split-KV / Two-Stage attention selectors for Iluvatar BI-V150 (`ivcore11`).
+
+Hardware Cost Model (`16 CUs`, `64 SIMDs`, `16 MiB L2`, `64 KiB LDS/CU`):
+  - Models Dual-SME compute throughput (`240 INT8 TOPS`), DMA/HBM bandwidth
+    (`409.6 GB/s`), L2 re-read bandwidth (`1310.7 GB/s`), and 2-CTA/CU LDS
+    co-residency (`<= 32 KiB` & `<= 4 warps`) to select tile shapes analytically
+    without runtime autotuning stalls.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import functools
+import math
+from typing import Any, Hashable
+
+import torch
+
+from flag_gems.runtime import torch_device_fn
+from flag_gems.utils.fast_launcher import (
+    can_fast_launch,
+    extract_fast_handle,
+    int_spec as int_align_spec,
+    invoke_fast_handle,
+)
+from flag_gems.utils.quant_config import GemmTuningConfig, QuantLayerConfig
+from flag_gems.utils.quant_precondition import (
+    ACT_FUSED_ADD_RMS_NORM,
+    ACT_NONE,
+    ACT_RMS_NORM,
+    _select_act_quant_schedule,
+    register_act_quant_alloc_rows,
+    register_act_quant_schedule,
+)
+from flag_gems.utils.tile_solver import DeviceTopology, grid_efficiency, merge_m_intervals
+
+register_act_quant_alloc_rows("iluvatar", 2)
+
+
+@register_act_quant_schedule("iluvatar")
+def _iluvatar_act_quant_schedule(
+    m: int, k: int, act_mode: int, do_hadamard: bool, num_scale_groups: int
+) -> tuple[bool, int, int]:
+    """Select Wave64 (`ivcore11`) single-pass register-resident activation-quantization schedule."""
+    k_grp = k // num_scale_groups
+    is_norm = act_mode in (ACT_RMS_NORM, ACT_FUSED_ADD_RMS_NORM)
+    k_span = k if (num_scale_groups == 1 or is_norm) else k_grp
+    # Small-to-medium hidden sizes (`<= 2048`) at `m > 512` favor `BLOCK_K=512, num_warps=4` for higher CTA concurrency.
+    if act_mode == ACT_RMS_NORM and do_hadamard and k_span <= 2048 and num_scale_groups == 1 and m > 512:
+        return True, 512, 4
+    if act_mode == ACT_NONE and not do_hadamard and num_scale_groups == 1:
+        # Pure INT8 identity quant (`M >= 512, K <= 2048`): `BLOCK_K=256, num_warps=1` avoids cross-warp barriers.
+        if k_span <= 2048 and (k_span % 256 == 0) and m >= 512:
+            return True, 256, 1
+        # Small-M wide-K identity quant (`M <= 64, 4096 <= K <= 8192`): single-step `BLOCK_K=2048, num_warps=8`.
+        if (k_grp % 2048 == 0) and (k_span % 2048 == 0) and 4096 <= k_span <= 8192 and m <= 64:
+            return True, 2048, 8
+    if (k_grp % 1024 == 0) and (k_span % 1024 == 0) and (k_span <= 8192):
+        return True, 1024, 8
+    return _select_act_quant_schedule(k, act_mode, do_hadamard, num_scale_groups, m)
+
+
+_POLICY_REGISTERED = False
+_INTERVAL_CACHE: dict[tuple[int, int, str, str, int], tuple[tuple[int, int, GemmTuningConfig], ...]] = {}
+_cuda_get_device = getattr(torch._C, "_cuda_getDevice", torch.cuda.current_device)
+_cuda_raw_stream = getattr(torch._C, "_cuda_getCurrentRawStream", None)
+
+
+def all_ptrs_aligned_16(*tensors: torch.Tensor | None) -> bool:
+    """Return True if all non-None tensor base pointers are 16-byte aligned."""
+    mask = 0
+    for t in tensors:
+        if t is not None:
+            mask |= t.data_ptr()
+    return (mask & 15) == 0
+
+
+def fast_launch_available() -> bool:
+    """Return True when the C-level fast kernel launcher is active and profiling is off."""
+    return can_fast_launch(0, disallow_when_profiling=True)
+
+
+def unwrap_jit_function(kernel_obj: Any) -> Any:
+    """Unwrap `@libentry`/`@libtuner`/`@triton.heuristics` decorators to the underlying JITFunction."""
+    cur, visited = kernel_obj, 0
+    while hasattr(cur, "fn") and not hasattr(cur, "params") and visited < 8:
+        cur, visited = cur.fn, visited + 1
+    return cur
+
+
+class LibFastEntry:
+    """Thin callable handle delegating directly to `flag_gems.utils.fast_launcher`."""
+
+    __slots__ = ("compiled_kernel", "handle")
+
+    def __init__(self, ck: Any, handle: tuple[Any, ...]) -> None:
+        """Bind a compiled Triton kernel and its extracted C-level launch handle."""
+        self.compiled_kernel, self.handle = ck, handle
+
+    def launch(self, gx: int, gy: int, gz: int, dev_idx: int, *runtime_args: Any) -> None:
+        """Invoke the compiled kernel on `(gx, gy, gz)` for `dev_idx`'s current stream."""
+        if _cuda_get_device() == dev_idx:
+            invoke_fast_handle(self.handle, gx, gy, gz, _cuda_raw_stream(dev_idx), runtime_args)
+        else:
+            with torch_device_fn.device(dev_idx):
+                invoke_fast_handle(self.handle, gx, gy, gz, _cuda_raw_stream(dev_idx), runtime_args)
+
+    __call__ = launch
+
+
+class FastKernelLauncher:
+    """Bounded `O(1)` specialization cache backed by `flag_gems.utils.fast_launcher`."""
+
+    __slots__ = ("jit_fn", "n_runtime_args", "max_entries", "_entries")
+
+    def __init__(self, jit_fn: Any = None, n_runtime_args: int | None = None, max_entries: int = 512) -> None:
+        """Initialize an empty specialization cache with FIFO eviction at `max_entries`."""
+        self.jit_fn, self.n_runtime_args, self.max_entries, self._entries = jit_fn, n_runtime_args, max_entries, {}
+
+    @staticmethod
+    def can_fast_launch(ptr_mask: int = 0) -> bool:
+        """Return True if fast C-level launch is permitted for `ptr_mask`."""
+        return can_fast_launch(ptr_mask, disallow_when_profiling=True)
+
+    @staticmethod
+    def launch(entry: LibFastEntry, gx: int, gy: int, gz: int, dev_idx: int, *runtime_args: Any) -> None:
+        """Forward a launch call directly to `entry.launch`."""
+        entry.launch(gx, gy, gz, dev_idx, *runtime_args)
+
+    def get(self, key: Hashable) -> LibFastEntry | None:
+        """Look up a cached `LibFastEntry` for `key`, or return None when unavailable."""
+        return self._entries.get(key) if can_fast_launch(0, disallow_when_profiling=True) else None
+
+    def bind(self, key: Hashable, ck: Any, jit_fn: Any = None) -> LibFastEntry | None:
+        """Extract and cache a `LibFastEntry` for compiled kernel `ck` under `key`."""
+        handle = extract_fast_handle(ck, jit_fn if jit_fn is not None else self.jit_fn)
+        if handle is None:
+            return None
+        if len(self._entries) >= self.max_entries:
+            self._entries.pop(next(iter(self._entries)))
+        entry = LibFastEntry(ck, handle)
+        self._entries[key] = entry
+        return entry
+
+    record = bind
+
