+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Analytical hardware grid-packing, co-residency, and Split-K/Split-N solvers.
+
+Provides vendor-neutral, zero-bias runtime topology probing (`DeviceTopology`)
+and closed-form analytical helpers for wave quantization efficiency, LDS/SMEM
+multi-CTA co-residency, piecewise-constant `M` interval compression, and
+occupancy-adaptive Split-N reductions.
+"""
+
+from dataclasses import dataclass
+import functools
+
+import triton
+
+from flag_gems.utils.device_info import get_device_properties, get_l2_cache_size, get_sm_count
+
+
+@dataclass(frozen=True)
+class DeviceTopology:
+    """Hardware multiprocessor and cache hierarchy descriptor."""
+
+    num_sms: int = 64
+    l2_cache_bytes: int = 4 * 1024 * 1024
+    smem_capacity_bytes: int = 65536
+    warp_size: int = 64
+    max_warps_per_cta: int = 8
+    co_resident_smem_bytes: int = 32768
+
+    @property
+    def num_cus(self) -> int:
+        """Alias for `num_sms` using compute-unit terminology."""
+        return self.num_sms
+
+    @property
+    def lds_capacity_bytes(self) -> int:
+        """Alias for `smem_capacity_bytes` using LDS terminology."""
+        return self.smem_capacity_bytes
+
+    @property
+    def co_resident_lds_bytes(self) -> int:
+        """Alias for `co_resident_smem_bytes` (per-CTA budget for 2 CTAs/CU)."""
+        return self.co_resident_smem_bytes
+
+
+@functools.lru_cache(maxsize=1)
+def get_device_topology() -> DeviceTopology:
+    """Query and cache active accelerator device topology.
+
+    Probes SM/CU count, L2 cache capacity, warp width, and per-CTA shared-memory
+    limits directly from runtime device properties without hardcoded chip-model tables,
+    normalizing Wave64 accelerators to their architectural 64 KiB LDS per-CU budget
+    (32 KiB per CTA when targeting 2 co-resident CTAs/CU).
+    """
+    props = get_device_properties()
+    num_sms = (
+        getattr(props, "multi_processor_count", None)
+        or getattr(props, "multiProcessorCount", None)
+        or get_sm_count()
+        or 64
+    )
+    l2_bytes = (
+        getattr(props, "L2_cache_size", None)
+        or getattr(props, "l2_cache_size", None)
+        or get_l2_cache_size()
+        or (4 * 1024 * 1024)
+    )
+    warp_sz = int(getattr(props, "warp_size", 64) or 64) if props is not None else 64
+    max_threads = (
+        int(getattr(props, "max_threads_per_block", 0) or 1024)
+        if props is not None
+        else 1024
+    )
+    max_warps = min(16, max(1, max_threads // max(1, warp_sz)))
+    raw_smem = (
+        int(
+            getattr(props, "shared_memory_per_block_optin", 0)
+            or getattr(props, "shared_memory_per_block", 0)
+            or 65536
+        )
+        if props is not None
+        else 65536
+    )
+    # Wave64 GPUs expose a 64 KiB physical LDS per CU; halve it for 2-CTA co-residency.
+    smem_cap = 65536 if warp_sz == 64 else raw_smem
+    return DeviceTopology(
+        int(num_sms), int(l2_bytes), smem_cap, warp_sz, max_warps, smem_cap // 2
+    )
+
+
+def merge_m_intervals(
+    selector_fn,
+    sample_points: tuple[int, ...] = (
+        8, 9, 16, 17, 31, 32, 64, 65, 128, 129, 256, 257, 16384
+    ),
+    max_m: int = 1 << 30,
+):
+    """Merge piecewise-constant `M` tuning selections into `(m_lo, m_hi, cfg)` intervals.
+
+    Evaluates `selector_fn(M)` across power-of-two tile/wave transition boundaries and
+    collapses adjacent identical `GemmTuningConfig` entries into contiguous `[m_lo, m_hi]`
+    ranges so hot-path GEMM dispatchers can resolve tuning configs via `O(1)` linear scan
+    of 3-5 intervals with zero per-call Python computation.
+    """
+    merged = []
+    cur_lo = 1
+    cur_cfg = selector_fn(1)
+    for m in sample_points:
+        nxt = selector_fn(m)
+        if nxt != cur_cfg:
+            merged.append((cur_lo, m - 1, cur_cfg))
+            cur_lo, cur_cfg = m, nxt
+    merged.append((cur_lo, max_m, cur_cfg))
+    return tuple(merged)
+
+
+def verify_lds_co_residency(
+    bm: int, bn: int, bk: int, stages: int, elem_bytes: int = 2, target_ctas_per_cu: int = 2, pipeline: str = "basic"
+) -> bool:
+    """Verify whether a `(bm, bn, bk)` pipelined tile satisfies per-SM shared-memory budget.
+
+    Under Triton's `"basic"` software pipeline, `max(1, stages - 1)` stage buffers reside
+    simultaneously in LDS while one stage is consumed in registers; checking against
+    `smem_limit // target_ctas_per_cu` guarantees that `target_ctas_per_cu` CTAs can co-reside
+    on a single CU without LDS capacity serialization.
+    """
+    if target_ctas_per_cu <= 0:
+        return False
+    smem_limit = get_device_topology().smem_capacity_bytes
+    smem_stages = max(1, stages - 1) if pipeline == "basic" else max(1, stages)
+    return (bm + bn) * bk * elem_bytes * smem_stages <= (smem_limit // target_ctas_per_cu)
+
+
+def split_subtile(bn: int) -> tuple[int, int]:
+    """Decompose `bn` into power-of-two sub-accumulators `(SUB_N0, SUB_N1)`."""
+    if bn <= 0:
+        return (0, 0)
+    # Largest power of two <= bn; remainder forms the secondary sub-tile (e.g., 160 -> 128 + 32).
+    sub0 = 1 << (bn.bit_length() - 1)
+    return (sub0, bn - sub0)
+
+
+def grid_efficiency(total_ctas: int, num_sms: int | None = None) -> float:
+    """Compute fractional SM utilization `total_ctas / (ceil(total_ctas / C) * C)`.
+
+    Measures wave-quantization efficiency across `C` compute units (`1.0` means every
+    wave is completely full; values near `0.5` indicate a half-empty tail wave).
+    """
+    if total_ctas <= 0:
+        return 0.0
+    c = num_sms or get_device_topology().num_sms
+    return 0.0 if c <= 0 else float(total_ctas) / float(triton.cdiv(total_ctas, c) * c)
+
+
+@functools.lru_cache(maxsize=512)
+def solve_occupancy_adaptive_split_n(M: int, N: int, num_cus: int | None = None, min_tile_n: int = 4096) -> int:
+    """Solve for `SPLIT_N in {1, 4, 8, 16}` in 2-stage wide-column row reductions.
+
+    When batch size `M < num_cus` and column width `N > 32768` (e.g., vocabulary `argmax`
+    in Decode), a 1-CTA-per-row launch leaves most CUs idle. Splitting `N` into `4/8/16`
+    parallel chunks multiplies CTA count to saturate all CUs while guarding `M * N < 2^31`
+    for 32-bit offset safety.
+    """
+    if num_cus is None:
+        num_cus = get_device_topology().num_sms
+    if M <= 0 or N <= 32768 or M >= num_cus or (M * N) >= (1 << 31):
+        return 1
+    # Pick the largest split factor (16/8/4) that saturates CUs without shrinking tiles below min_tile_n/2.
+    target_split = 16 if M <= (num_cus // 3) else 8
+    max_splits = max(1, N // max(1, min_tile_n // 2))
+    for candidate in (16, 8, 4):
+        if candidate <= target_split and candidate <= max_splits:
+            return candidate
+    return 1
+
+
+__all__ = [
+    "DeviceTopology",
+    "get_device_topology",
+    "grid_efficiency",
+    "merge_m_intervals",
+    "solve_occupancy_adaptive_split_n",
+    "split_subtile",
+    "verify_lds_co_residency",
+]
