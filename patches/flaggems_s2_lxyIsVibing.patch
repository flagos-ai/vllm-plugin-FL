+def launch_compiled_kernel(
+    spec_key: tuple,
+    grid_0: int,
+    dev_idx: int,
+    aligned_16: bool,
+    jit_fn: Any,
+    rt_args: tuple,
+    full_args: tuple,
+    meta_kwargs: dict,
+    disable_aabs: bool = False,
+    *,
+    disallow_when_profiling: bool = False,
+) -> None:
+    """Launch a pre-cached C-level fast kernel handle, falling back to Triton JIT on first miss.
+
+    `disable_aabs=True` suppresses MACA Triton's `auto_adjust_block_size` pass at `M < 16` so
+    explicit `num_warps` / `BLOCK_M=16` choices are not rewritten by compiler heuristics.
+    """
+    if _fast_launch_compiled_kernel(
+        spec_key,
+        grid_0,
+        dev_idx,
+        aligned_16,
+        jit_fn,
+        rt_args,
+        full_args,
+        meta_kwargs,
+        disable_aabs,
+        disallow_when_profiling=disallow_when_profiling,
+    ):
+        return
+    if disable_aabs:
+        with DisableAdjustBlockSize(True):
+            jit_fn[(grid_0,)](*full_args, **meta_kwargs)
+    else:
+        jit_fn[(grid_0,)](*full_args, **meta_kwargs)
+
