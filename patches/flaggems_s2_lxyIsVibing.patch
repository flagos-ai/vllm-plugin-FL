+def select_bf16_mm_config(configs: list[Any], args: dict[str, Any]) -> Any:
+    """Analytically pick the lowest-latency BF16 `mm` config on BI-V150's 16 CUs without benchmarking."""
+    m, n, k = int(args.get("M", 64)), int(args.get("N", 2048)), int(args.get("K", 2048))
+    best_cfg, best_us = configs[0], float("inf")
+    for cfg in configs:
+        kw = cfg.kwargs
+        bm, bn, sk = int(kw.get("BLOCK_M", 64)), int(kw.get("BLOCK_N", 64)), int(kw.get("SPLIT_K", 1))
+        # Model 16-CU wave quantization, 120 TFLOPS BF16 SME compute, and 409.6 GB/s HBM traffic.
+        rounds = math.ceil((((max(m, 1) + bm - 1) // bm) * ((n + bn - 1) // bn) * sk) / 16)
+        comp = (rounds * 16 * 2.0 * bm * bn * math.ceil(k / sk)) / (120.0 * 1e6 * 0.72)
+        mem = (2.0 * (m * k + k * n + m * n * sk)) / (409.6 * 1e3 * 0.75)
+        est = max(comp, mem) + 2.8 + (5.0 if sk > 1 else 0.0)
+        if est < best_us:
+            best_us, best_cfg = est, cfg
+    return best_cfg
+
