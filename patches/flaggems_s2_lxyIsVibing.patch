+def register_iluvatar_gemm_policy() -> str:
+    """Register the zero-benchmark `ivcore11` analytical cost-model policy with `LibTuner`."""
+    global _POLICY_REGISTERED
+    policy_name = "iluvatar_ivcore11_cost_model"
+    if not _POLICY_REGISTERED:
+        from flag_gems.utils.libentry import LibTuner
+
+        @LibTuner.register_policy(policy_name)
+        def _iluvatar_policy(tuner_self, bench_fn, configs, args, kwargs):
+            """Select the best BF16 `mm` config analytically without running GPU autotune trials."""
+            best = select_bf16_mm_config(list(configs), getattr(tuner_self, "nargs", {}))
+            return best, {best: [0.01, 0.01, 0.01]}
+
+        _POLICY_REGISTERED = True
+    return policy_name
