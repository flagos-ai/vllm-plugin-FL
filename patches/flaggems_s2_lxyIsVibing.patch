+
+# Intra-wavefront 6-stage Sylvester Fast Walsh-Hadamard Transform (`H_64 / 8`):
+# Reshapes `(OUTER, 64)` into `(OUTER, 32, 2)` and iterates 6 butterfly stages of
+# `tl.split` -> `(a + b, a - b)` -> `tl.join` -> `tl.permute((0, 2, 1))`, executing
+# entirely inside Wave64 VGPRs/lane-shuffles without shared memory or barriers.
+@triton.jit
+def _hadamard_64(x, OUTER: tl.constexpr):
+    """Exact 6-stage intra-wavefront Sylvester Walsh-Hadamard `H_64 = (1/8) H_2^{x6}`."""
+    v = tl.reshape(x, (OUTER, 32, 2))
+    for _ in tl.static_range(6):
+        a, b = tl.split(v)
+        v = tl.reshape(tl.permute(tl.join(a + b, a - b), (0, 2, 1)), (OUTER, 32, 2))
+    return tl.reshape(v, x.shape) * 0.125
+
+
