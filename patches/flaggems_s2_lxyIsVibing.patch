+@functools.lru_cache(maxsize=256)
+def solve_w8a8_m_intervals(spec: LayerSpec, topo: DeviceTopology | None = None) -> tuple[tuple[int, int, TuningSpec], ...]:
+    """Compress power-of-two `M` buckets into merged `(m_min, m_max, TuningSpec)` intervals.
+
+    Adjacent `log2(M)` buckets that map to identical `TuningSpec` values are coalesced so callers
+    inspecting interval tables see the minimal piecewise-constant schedule across `[1, 2^30]`.
+    """
+    bounds = ((1, 8, 8), (9, 16, 16), (17, 32, 32), (33, 64, 64), (65, 128, 128), (129, 256, 256), (257, 512, 512), (513, 1024, 1024), (1025, 1 << 30, 2048))
+    merged: list[tuple[int, int, TuningSpec]] = []
+    for lo, hi, m_rep in bounds:
+        ts = solve_w8a8_tuning_for_bucket(spec, m_rep, topo)
+        if merged and merged[-1][2] == ts:
+            merged[-1] = (merged[-1][0], hi, ts)
+        else:
+            merged.append((lo, hi, ts))
+    return tuple(merged)
+
+
+@functools.lru_cache(maxsize=512)
+def _solve_diophantine_tile_pack_cached(M: int, N: int, K: int, num_sms: int):
+    """Solve 104-CU wave-aligned BF16 `BM=256, BK=32` 2-region composite N-packing for large `M`.
+
+    For `ref_gm = 8` (`m_full = 2048`) on `num_sms = 104`, `t_unit = 104 // gcd(8, 104) = 13` column
+    tiles form an exact `1.00`-wave (`104`-CTA) unit:
+    - `N = 2048` (`o_proj` / `down_proj`): `12 * 160 + 1 * 128 = 2048` -> `8 * 13 = 104` CTAs (`1.00` wave).
+    - `N = 2560` (`qkv_proj`): `13 * 192 = 2496` (`104` CTAs = `1.00` wave) + fused `32x64` residual tail strip.
+    - `N = 12288` (`gate_up_proj`): `36 * 256 + 16 * 192 = 12288` -> `8 * 52 = 416` CTAs (`4.00` waves).
+    `scenario="storeCoalesce"` is strictly gated on `even_m` and zero column waste (`P4` guardrail).
+    """
+    if M <= 256 or K < 64 or (K % 32) != 0 or (N % 32) != 0:
+        return None
+    topo, ref_gm, m_full = get_device_topology(), 8, 8 * 256
+    t_unit = max(1, num_sms // math.gcd(ref_gm, num_sms))
+    g_m, even_m = triton.cdiv(M, 256), (M % 256) == 0
+
+    # 1-wave primary grid + fused 64-col tail strip in one kernel launch (e.g. N - bn_ts * t_unit == 64).
+    if K <= 2 * N and (g_m == ref_gm or (M > m_full and (M % m_full) == 0)):
+        for bn_ts in (192, 160, 128):
+            if N - bn_ts * t_unit == 64:
+                return ("2region_tail_strip", (g_m * t_unit + triton.cdiv(M, 32),), 32, 1, even_m, t_unit, bn_ts, 32, 64, {"scenario": "storeCoalesce"} if even_m else {})
+
+    # Analytical 1-wave and multi-wave 2-region Diophantine partition.
+    if N >= 128 * t_unit and K <= 4 * N:
+        dio = _solve_2region_diophantine(N, 256, m_full, 32, 2, topo)
+        if dio is not None:
+            r0, bn0, r1, bn1, gm_swz = dio
+            exact_n = (r0 * bn0 + r1 * bn1) == N
+            in_m = (
+                (((m_full - 384) <= M <= m_full) if (r0 + r1 == t_unit and K <= 2 * N) else ((m_full - 512) < M <= m_full))
+                or (M > m_full and (M % m_full) == 0)
+            )
+            if in_m and (exact_n or K <= 2 * m_full) and (g_m == ref_gm or (M > m_full and (M % m_full) == 0) or (r0 + r1) >= 2 * t_unit or exact_n):
+                gm = 8 if (r0 + r1) >= 4 * t_unit else gm_swz
+                extra = {"scenario": "storeCoalesce"} if (even_m and exact_n) else {}
+                return ("2region", (g_m * (r0 + r1),), 32, gm, even_m, r0, bn0, r1, bn1, extra)
+
+    # Sub-full-wave M buckets (`g_m in {6, 7}`) fitting within a single 104-CU wave at BN=192/160.
+    if K <= 2 * N:
+        if g_m == ref_gm - 1 and N <= 192 * (t_unit + 1):
+            gn192 = triton.cdiv(N, 192)
+            if g_m * gn192 <= num_sms:
+                return ("2region", (g_m * gn192,), 32, 1, even_m, gn192, 192, 0, 0, {"scenario": "dot_operands_out_loop"} if even_m else {})
+        if g_m == ref_gm - 2 and (N % 160) == 0 and g_m * (N // 160) <= num_sms:
+            gn160 = N // 160
+            return ("2region", (g_m * gn160,), 32, 1, even_m, gn160, 160, 0, 0, {"scenario": "dot_operands_out_loop"} if even_m else {})
+    return None
+
+
+def solve_diophantine_tile_pack(M: int, N: int, K: int, num_cus: int | None = None):
+    """Return 2-region BF16 wave-packing plan for `(M, N, K)` on `num_cus` CUs, or `None`."""
+    return _solve_diophantine_tile_pack_cached(M, N, K, get_device_topology().num_sms if num_cus is None else num_cus)
+
+
+solve_diophantine_wave_pack = solve_diophantine_tile_pack
+
