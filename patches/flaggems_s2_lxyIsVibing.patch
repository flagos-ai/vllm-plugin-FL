+class _WeakBenchmarkTensor:
+    """Weak tensor reference with geometry fallback so LibTuner never leaks VRAM.
+
+    `LibTuner` instances are module-level singletons that outlive individual model
+    forward passes and weight-loading phases. Retaining strong `torch.Tensor`
+    references in `_last_benchmark_args` would permanently pin transient BF16/FP32
+    weight or large prefill activation tensors (often several GiB) in device memory.
+
+    `_WeakBenchmarkTensor` holds only a `weakref.ref` to the original tensor plus its
+    lightweight `(shape, stride, dtype, device)` layout metadata:
+      - If `benchmark_config()` runs while the caller's tensor is still alive,
+        `resolve()` returns the exact live tensor.
+      - Once garbage-collected, `resolve()` allocates a fresh `torch.empty_strided`
+        buffer with identical memory geometry so offline config re-benchmarking
+        still reproduces exact coalescing and stride behavior without leaking VRAM.
+    """
+
+    __slots__ = ("ref", "shape", "stride", "dtype", "device")
+
+    def __init__(self, tensor: Any) -> None:
+        """Record a weak reference and memory geometry metadata for `tensor`."""
+        self.ref = weakref.ref(tensor)
+        self.shape = tuple(tensor.shape)
+        self.stride = tuple(tensor.stride())
+        self.dtype = tensor.dtype
+        self.device = tensor.device
+
+    def resolve(self) -> Any:
+        """Return the live tensor if still resident, or allocate a geometry-matched scratch tensor."""
+        live = self.ref()
+        if live is not None:
+            return live
+        import torch
+
+        return torch.empty_strided(
+            self.shape, self.stride, dtype=self.dtype, device=self.device
+        )
+
+
+def _capture_benchmark_arg(arg: Any) -> Any:
+    """Convert `torch.Tensor` or `StridedBuffer`-like wrappers into weak descriptors."""
+    if hasattr(arg, "data_ptr") and hasattr(arg, "stride") and hasattr(arg, "device"):
+        if type(arg).__module__.startswith("torch"):
+            try:
+                return _WeakBenchmarkTensor(arg)
+            except TypeError:
+                return arg
+        # Handle FlagGems `StridedBuffer` / view wrappers backed by a `torch.Tensor` `_base`.
+        base = getattr(arg, "_base", None)
+        if base is not None and type(base).__module__.startswith("torch"):
+            return (
+                type(arg),
+                _WeakBenchmarkTensor(base),
+                getattr(arg, "shape", None),
+                getattr(arg, "_strides", None),
+                getattr(arg, "dtype", None),
+                getattr(arg, "offset", 0),
+            )
+    return arg
+
+
+def _restore_benchmark_arg(arg: Any) -> Any:
+    """Materialize a captured weak tensor/wrapper descriptor back into a runnable argument."""
+    if isinstance(arg, _WeakBenchmarkTensor):
+        return arg.resolve()
+    # Reconstruct `StridedBuffer`-like wrapper objects around their resolved base tensor.
+    if (
+        isinstance(arg, tuple)
+        and len(arg) == 6
+        and isinstance(arg[0], type)
+        and isinstance(arg[1], _WeakBenchmarkTensor)
+    ):
+        cls, base_spec, shape, strides, dtype, offset = arg
+        return cls(base_spec.resolve(), shape=shape, strides=strides, dtype=dtype, offset=offset)
+    return arg
+
 _FLAGTUNE_PROPOSER_POOL: Dict[Any, Any] = {}
 _FLAGTUNE_VARIANT_INFO_POOL: Dict[Any, Any] = {}
 _FLAGTUNE_AVAILABILITY: Optional[Tuple[bool, Optional[BaseException]]] = None
