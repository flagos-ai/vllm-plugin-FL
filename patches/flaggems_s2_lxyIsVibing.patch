+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Pure Triton + FlagTree 0.7.0 TLE Top-P, Gumbel-Max, and Greedy sampler for Iluvatar CoreX.
+
+Algorithmic & Microarchitectural Design (`ivcore11`, `16 MiB L2`):
+  1. Markov Inequality Overflow-Free Single-Pass Filter (`sum_all / (SMEM_CAND_CAP - 4)`):
+     For non-negative unnormalized probabilities summing to `sum_all`, Markov's inequality
+     guarantees that strictly fewer than `SMEM_CAND_CAP - 4` tokens can exceed weight
+     `w_thr = sum_all / (SMEM_CAND_CAP - 4)`. Whenever the Top-P nucleus contains at most
+     `SMEM_CAND_CAP - 4` (`2044`) tokens (>99.9% of LLM steps), a single pass into TLE
+     shared memory (`SMEM_CAND_CAP = 2048`) captures the entire nucleus without overflowing;
+     high-entropy flat distributions fall back to a 2-pass 512-bin `tle.cumsum` histogram refiner.
+  2. L2 Cache Residency (`8.35-8.97 MB < 16 MB L2`, `CACHE_MOD=""`):
+     For typical LLM batch sizes (`B <= 64`, `vocab_size ~ 73K-136K` in BF16, ~8.35-9.0 MiB),
+     the entire logits matrix fits inside BI-V150's 16 MiB L2 cache (`1.31 TB/s`). Omitting
+     `.cv` cache-bypass modifiers on multi-pass Top-P (`vocab_size <= 262144`) keeps Pass-1
+     logits hot in L2 for Pass-2 candidate extraction instead of re-reading `409.6 GB/s` HBM.
+  3. Pure-Register Binary-Search Nucleus Cutoff + Gumbel-Max Sampling:
+     Loads the compacted `<= 2048` shared-memory candidates into VGPRs (`y0, i0`), finds the
+     exact Top-P threshold and tie-breaking token index via 24-iteration register binary search
+     (zero sorting networks), and samples in one pass via the Gumbel-Max trick
+     `argmax_i (y_i - log2(-log2(u_i)))`.
+"""
+
+from __future__ import annotations
+from typing import Any
+import torch
+import triton
+import triton.experimental.tle.language as tle
+import triton.language as tl
+from flag_gems.runtime import torch_device_fn
+from flag_gems.runtime.backend._iluvatar.ops.gemm_heuristic import FastKernelLauncher, fast_launch_available, int_align_spec
+
+# fmt: off
+_SAMPLING_EPS, _Q_RING_SIZE, _Q_RING_MASK = 1e-5, 2, 1
+_Q_NOISE_CACHE: dict[tuple[torch.device, int], torch.Tensor] = {}
+_SPLITV_WS_CACHE: dict[torch.device, dict[str, torch.Tensor]] = {}
+_GRAPH_SEED_CACHE: dict[torch.device, torch.Tensor] = {}
+_SV_TRIPLE_CACHE: dict[tuple[Any, ...], tuple[Any, Any, Any]] = {}
+_FP1_PAIR_CACHE: dict[tuple[Any, ...], tuple[Any, Any]] = {}
+_HOST_STEP_COUNTER: int = 1000003
+
+
+def _get_q_noise_buf(device: torch.device, batch_size: int, generators: dict[int, torch.Generator] | None = None) -> tuple[torch.Tensor, int]:
+    """Return a cached per-row 2-word uniform noise buffer `(buf, _Q_RING_MASK)` for seeded Philox XOR."""
+    cap = max(64, triton.next_power_of_2(max(batch_size, 1)))
+    buf = _Q_NOISE_CACHE.get((device, cap))
+    capturing = torch.cuda.is_current_stream_capturing()
+    if buf is None:
+        buf = torch.empty((cap, _Q_RING_SIZE), dtype=torch.float32, device=device).uniform_(1e-6, 1.0)
+        _Q_NOISE_CACHE[(device, cap)] = buf
+    elif not capturing and (not generators or len(generators) != batch_size):
+        buf[:batch_size, :2].uniform_(1e-6, 1.0)
+    if generators and not capturing:
+        for i, gen in generators.items():
+            if i < batch_size:
+                buf[i, :2].uniform_(1e-6, 1.0, generator=gen)
+    return buf, _Q_RING_MASK
+
+
+def _get_splitv_ws(device: torch.device) -> dict[str, torch.Tensor]:
+    """Return lazily allocated Split-V scratch tensors (`pmax`, `psum`, `pamax`, candidate arrays)."""
+    if (ws := _SPLITV_WS_CACHE.get(device)) is None:
+        n_sv, n_cand = 256, 256 * 512
+        ws = {
+            "pmax": torch.empty((n_sv,), dtype=torch.float32, device=device), "psum": torch.empty((n_sv,), dtype=torch.float32, device=device),
+            "pamax": torch.empty((n_sv,), dtype=torch.int32, device=device), "cy": torch.empty((n_cand,), dtype=torch.float32, device=device),
+            "ci": torch.empty((n_cand,), dtype=torch.int32, device=device), "cnt": torch.empty((n_sv,), dtype=torch.int32, device=device),
+            "mass": torch.empty((n_sv,), dtype=torch.float32, device=device),
+        }
+        _SPLITV_WS_CACHE[device] = ws
+    return ws
+
+
+def _get_graph_seed_buf(device: torch.device) -> torch.Tensor:
+    """Return the device-resident int64 step seed mutated in-place during CUDAGraph replay."""
+    if (buf := _GRAPH_SEED_CACHE.get(device)) is None:
+        buf = _GRAPH_SEED_CACHE.setdefault(device, torch.tensor([1000003], dtype=torch.int64, device=device))
+    return buf
+
+
+def fl_apply_temperature(logits: torch.Tensor, temp: torch.Tensor, all_random: bool) -> torch.Tensor:
+    """Scale `logits` in-place by per-row `temp`, clamping greedy rows (`temp < 1e-5`) to 1.0."""
+    if logits.shape[0] == 0:
+        return logits
+    return logits.div_((temp if all_random else torch.where(temp < _SAMPLING_EPS, 1.0, temp)).unsqueeze(dim=1))
+
+
+@triton.jit
+def _gumbel_score_vec(y_rel, keep, idx, q_row_ptr, row_seed, USE_Q_BUF: tl.constexpr, Q_MASK: tl.constexpr):
+    """Compute base-2 Gumbel-Max score `y_rel - log2(-log2(u))` (or exponential noise from `q_row_ptr`)."""
+    if USE_Q_BUF and (Q_MASK == 0):
+        return tl.where(keep, y_rel - tl.log2(tl.maximum(tl.load(q_row_ptr + idx, mask=keep, other=1.0).to(tl.float32), 1e-30)), -float("inf"))
+    u = tl.maximum(tl.rand(row_seed, idx.to(tl.uint32), n_rounds=7), 1e-30)
+    return tl.where(keep, y_rel - tl.log2(-tl.log2(u)), -float("inf"))
+
+
+@triton.jit
+def _fl_greedy_or_gumbel_kernel(
+    LOGITS_PTR, STRIDE_B, Q_PTR, STRIDE_QB, TEMP_PTR, PART_SC_PTR, PART_ID_PTR, OUT_TOKENS_PTR, PHILOX_SEED, PHILOX_SEED_PTR,
+    VOCAB_SIZE: tl.constexpr, SPLIT_V: tl.constexpr, BLOCK_SIZE: tl.constexpr, MODE: tl.constexpr,
+    HAS_TEMP: tl.constexpr, PURE_GREEDY: tl.constexpr, USE_Q_BUF: tl.constexpr, Q_MASK: tl.constexpr, HAS_SEED_PTR: tl.constexpr, CACHE_MOD: tl.constexpr,
+):
+    """Fused greedy argmax / Gumbel-Max kernel (`MODE=0`: 1D, `MODE=1`: Split-V partial, `MODE=2`: Split-V reduce)."""
+    row_idx = tl.program_id(0)
+    if MODE == 2:
+        # Stage-2 reduction across `SPLIT_V` partial winners with smallest-index tie-breaking.
+        sv_offs = tl.arange(0, SPLIT_V)
+        part_sc, sv_idx = tl.load(PART_SC_PTR + row_idx * SPLIT_V + sv_offs), tl.load(PART_ID_PTR + row_idx * SPLIT_V + sv_offs)
+        max_sc = tl.max(part_sc, axis=0)
+        win = tl.min(tl.where(part_sc == max_sc, sv_idx, VOCAB_SIZE), axis=0)
+        tl.store(OUT_TOKENS_PTR + row_idx, tl.where(max_sc == -float("inf"), 0, win).to(OUT_TOKENS_PTR.dtype.element_ty))
+    else:
+        LOG2E: tl.constexpr = 1.4426950408889634
+        if MODE == 1:
+            sv, chunk_v = tl.program_id(1), tl.cdiv(VOCAB_SIZE, SPLIT_V)
+            start_v, end_v, n_tiles = sv * chunk_v, tl.minimum((sv + 1) * chunk_v, VOCAB_SIZE), tl.cdiv(chunk_v, BLOCK_SIZE)
+        else:
+            sv, start_v, end_v, n_tiles = 0, 0, VOCAB_SIZE, tl.cdiv(VOCAB_SIZE, BLOCK_SIZE)
+        if PURE_GREEDY:
+            is_greedy, inv_t_log2e = True, LOG2E
+        elif HAS_TEMP:
+            t_val = tl.load(TEMP_PTR + row_idx).to(tl.float32)
+            is_greedy = t_val < 1e-5
+            inv_t_log2e = tl.where(is_greedy, LOG2E, LOG2E / t_val)
+        else:
+            is_greedy, inv_t_log2e = False, LOG2E
+
+        row_ptr, offs = LOGITS_PTR + row_idx * STRIDE_B, tl.arange(0, BLOCK_SIZE)
+        v_best_sc, v_best_id = tl.full((BLOCK_SIZE,), -float("inf"), tl.float32), tl.full((BLOCK_SIZE,), VOCAB_SIZE, tl.int32)
+        if is_greedy:
+            for t in range(n_tiles):
+                idx = start_v + t * BLOCK_SIZE + offs
+                x = tl.load(row_ptr + idx, mask=idx < end_v, other=-float("inf"), cache_modifier=CACHE_MOD).to(tl.float32)
+                better = x > v_best_sc
+                v_best_sc, v_best_id = tl.where(better, x, v_best_sc), tl.where(better, idx, v_best_id)
+        else:
+            q_row_ptr = Q_PTR + row_idx * STRIDE_QB if USE_Q_BUF else LOGITS_PTR
+            base_seed = tl.load(PHILOX_SEED_PTR).to(tl.uint64) if HAS_SEED_PTR else PHILOX_SEED.to(tl.uint64)
+            if USE_Q_BUF and (Q_MASK > 0):
+                s0, s1 = tl.load(q_row_ptr).to(tl.uint32, bitcast=True).to(tl.uint64), tl.load(q_row_ptr + 1).to(tl.uint32, bitcast=True).to(tl.uint64)
+                base_seed = base_seed ^ (s0 | (s1 << 32))
+            row_seed = base_seed + row_idx.to(tl.uint64) * 0x9E3779B97F4A7C15
+            for t in range(n_tiles):
+                idx = start_v + t * BLOCK_SIZE + offs
+                y = tl.load(row_ptr + idx, mask=idx < end_v, other=-float("inf"), cache_modifier=CACHE_MOD).to(tl.float32) * inv_t_log2e
+                sc = _gumbel_score_vec(y, y > -float("inf"), idx, q_row_ptr, row_seed, USE_Q_BUF, Q_MASK)
+                better = sc > v_best_sc
+                v_best_sc, v_best_id = tl.where(better, sc, v_best_sc), tl.where(better, idx, v_best_id)
+        max_sc = tl.max(v_best_sc, axis=0)
+        win = tl.min(tl.where(v_best_sc == max_sc, v_best_id, VOCAB_SIZE), axis=0)
+        if MODE == 1:
+            tl.store(PART_SC_PTR + row_idx * SPLIT_V + sv, max_sc)
+            tl.store(PART_ID_PTR + row_idx * SPLIT_V + sv, win)
+        else:
+            tl.store(OUT_TOKENS_PTR + row_idx, tl.where(max_sc == -float("inf"), 0, win).to(OUT_TOKENS_PTR.dtype.element_ty))
+
+
+@triton.jit
+def _tle_splitv_topp_part_kernel(
+    LOGITS_PTR, STRIDE_B, Q_PTR, STRIDE_QB, P_PTR, TEMP_PTR, PART_MAX_PTR, PART_SUM_PTR, PART_AMAX_PTR,
+    G_CAND_Y_PTR, G_CAND_IDX_PTR, G_SV_CNT_PTR, G_SV_MASS_PTR, PHILOX_SEED, PHILOX_SEED_PTR,
+    VOCAB_SIZE: tl.constexpr, SPLIT_V: tl.constexpr, SV_CAND_CAP: tl.constexpr, BLOCK_SIZE: tl.constexpr,
+    STAGE: tl.constexpr, HAS_P: tl.constexpr, HAS_TEMP: tl.constexpr, USE_Q_BUF: tl.constexpr, Q_MASK: tl.constexpr, HAS_SEED_PTR: tl.constexpr,
+):
+    """Split-V Top-P partition kernel (`STAGE=1`: partial max/sum/argmax, `STAGE=2`: candidate extraction)."""
+    LOG2E: tl.constexpr = 1.4426950408889634
+    row_idx, sv, chunk_v = tl.program_id(0), tl.program_id(1), tl.cdiv(VOCAB_SIZE, SPLIT_V)
+    start_v, end_v = sv * chunk_v, tl.minimum((sv + 1) * chunk_v, VOCAB_SIZE)
+    offs, n_tiles, row_ptr = tl.arange(0, BLOCK_SIZE), tl.cdiv(chunk_v, BLOCK_SIZE), LOGITS_PTR + row_idx * STRIDE_B
+    if HAS_TEMP:
+        t_val = tl.load(TEMP_PTR + row_idx).to(tl.float32)
+        is_greedy = t_val < 1e-5
+        inv_t_log2e = tl.where(is_greedy, 1.0, LOG2E / t_val)
+    else:
+        is_greedy, inv_t_log2e = False, LOG2E
+
+    if STAGE == 1:
+        v_max, v_sum, v_idx = tl.full((BLOCK_SIZE,), -float("inf"), tl.float32), tl.zeros((BLOCK_SIZE,), tl.float32), tl.full((BLOCK_SIZE,), VOCAB_SIZE, tl.int32)
+        for t in range(n_tiles):
+            idx = start_v + t * BLOCK_SIZE + offs
+            y = tl.load(row_ptr + idx, mask=idx < end_v, other=-float("inf")).to(tl.float32) * inv_t_log2e
+            better = y > v_max
+            v_idx, new_max = tl.where(better, idx, v_idx), tl.where(better, y, v_max)
+            safe_new = tl.where(new_max == -float("inf"), 0.0, new_max)
+            v_sum = v_sum * tl.exp2(v_max - safe_new) + tl.where((y > -float("inf")) & (not is_greedy), tl.exp2(y - safe_new), 0.0)
+            v_max = new_max
+        pmax = tl.max(v_max, axis=0)
+        psum = tl.where((pmax == -float("inf")) | is_greedy, 0.0, tl.sum(tl.where(v_max > -float("inf"), v_sum * tl.exp2(v_max - pmax), 0.0), axis=0))
+        slot = row_idx * SPLIT_V + sv
+        tl.store(PART_MAX_PTR + slot, pmax)
+        tl.store(PART_SUM_PTR + slot, psum)
+        tl.store(PART_AMAX_PTR + slot, tl.min(tl.where(v_max == pmax, v_idx, VOCAB_SIZE), axis=0))
+    else:
+        sv_offs = tl.arange(0, SPLIT_V)
+        pmax_v, psum_v = tl.load(PART_MAX_PTR + row_idx * SPLIT_V + sv_offs), tl.load(PART_SUM_PTR + row_idx * SPLIT_V + sv_offs)
+        row_max_y = tl.max(pmax_v, axis=0)
+        if (row_max_y == -float("inf")) | is_greedy:
+            tl.store(G_SV_CNT_PTR + row_idx * SPLIT_V + sv, 0)
+            tl.store(G_SV_MASS_PTR + row_idx * SPLIT_V + sv, 0.0)
+            return
+        p_val = tl.load(P_PTR + row_idx).to(tl.float32) if HAS_P else 1.0
+        sum_all = tl.sum(tl.where(pmax_v > -float("inf"), psum_v * tl.exp2(pmax_v - row_max_y), 0.0), axis=0)
+        if p_val * sum_all <= 0.99995:
+            tl.store(G_SV_CNT_PTR + row_idx * SPLIT_V + sv, 0)
+            tl.store(G_SV_MASS_PTR + row_idx * SPLIT_V + sv, 0.0)
+            return
+
+        s_cnt = tle.gpu.alloc([1], dtype=tl.int32, layout=None, scope=tle.gpu.smem, nv_mma_shared_layout=False)
+        cnt_ptr = tle.gpu.local_ptr(s_cnt, (0,))
+        tl.store(cnt_ptr + offs, 0, mask=offs < 1)
+        tl.debug_barrier()
+        w_thr = tl.minimum(tl.maximum(sum_all - 1.0, 1e-6) * (1.0 / 4096.0), tl.maximum((1.0 - p_val) * sum_all, 1e-6) * (1.0 / 2048.0))
+        theta_try, cand_base = row_max_y + tl.log2(tl.maximum(w_thr, 1e-30)), (row_idx * SPLIT_V + sv) * SV_CAND_CAP
+        v_sv_mass, cnt_ptrs, ones_i32 = tl.zeros((BLOCK_SIZE,), tl.float32), cnt_ptr + tl.zeros((BLOCK_SIZE,), tl.int32), tl.full((BLOCK_SIZE,), 1, tl.int32)
+        for t in range(n_tiles):
+            idx = start_v + t * BLOCK_SIZE + offs
+            mask = idx < end_v
+            y = tl.load(row_ptr + idx, mask=mask, other=-float("inf")).to(tl.float32) * inv_t_log2e
+            take_fast = (y > theta_try) & mask
+            pos_sv = tl.atomic_add(cnt_ptrs, ones_i32, mask=take_fast, sem="relaxed", scope="cta")
+            sv_store = take_fast & (pos_sv < SV_CAND_CAP)
+            tl.store(G_CAND_Y_PTR + cand_base + pos_sv, y, mask=sv_store)
+            tl.store(G_CAND_IDX_PTR + cand_base + pos_sv, idx, mask=sv_store)
+            v_sv_mass += tl.where(sv_store, tl.exp2(y - row_max_y), 0.0)
+        tl.debug_barrier()
+        raw_sv_cnt = tl.load(cnt_ptr)
+        tl.store(G_SV_CNT_PTR + row_idx * SPLIT_V + sv, tl.where(raw_sv_cnt > SV_CAND_CAP, -1, raw_sv_cnt))
+        tl.store(G_SV_MASS_PTR + row_idx * SPLIT_V + sv, tl.sum(v_sv_mass, axis=0))
+
+
+@triton.jit
+def _tle_topp_gumbel_kernel(
+    LOGITS_PTR, STRIDE_B, Q_PTR, STRIDE_QB, P_PTR, TEMP_PTR, PART_MAX_PTR, PART_SUM_PTR, PART_AMAX_PTR,
+    G_CAND_Y_PTR, G_CAND_IDX_PTR, G_SV_CNT_PTR, G_SV_MASS_PTR, OUT_TOKENS_PTR, PHILOX_SEED, PHILOX_SEED_PTR,
+    VOCAB_SIZE: tl.constexpr, SPLIT_V: tl.constexpr, SV_CAND_CAP: tl.constexpr, SCAN_BS: tl.constexpr, EP_BS: tl.constexpr,
+    SMEM_CAND_CAP: tl.constexpr, IS_SPLITV_STAGE3: tl.constexpr, HAS_P: tl.constexpr, HAS_TEMP: tl.constexpr,
