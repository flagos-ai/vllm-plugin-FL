+def _next_pow2(x: int) -> int:
+    """Return the smallest power of two >= `x` (minimum 1)."""
+    return 1 if x <= 1 else 1 << (x - 1).bit_length()
+
+
+def compute_bf16x2_page_tail_bytes(block_size: int, num_kv_heads: int) -> int:
+    """Compute the 128-byte aligned per-page tail size for packed `BF16x2` `(k_scale, v_scale)` words."""
+    return ((int(block_size) * int(num_kv_heads) * 4 + 127) // 128) * 128
+
+
+def compute_k8v4_page_bytes(block_size: int, num_kv_heads: int, head_dim: int) -> int:
+    """Compute total bytes per physical `DG-R2-K8V4` page (INT8 K + packed INT4 V + BF16x2 scale tail)."""
+    return 3 * int(block_size) * int(num_kv_heads) * (int(head_dim) // 2) + compute_bf16x2_page_tail_bytes(block_size, num_kv_heads)
+
