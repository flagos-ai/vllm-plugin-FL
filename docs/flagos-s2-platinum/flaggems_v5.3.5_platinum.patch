+def topk_topp_random_sample(
+    logits: torch.Tensor,
+    k: Optional[torch.Tensor] = None,
+    p: Optional[torch.Tensor] = None,
+    generator: Optional[torch.Generator] = None,
+) -> torch.Tensor:
+    """Fused exact Top-K + Top-P + Gumbel-Max token sampling without HBM logit writeback."""
+    logger.debug("GEMS TOPK_TOPP_RANDOM_SAMPLE")
+    assert logits.ndim == 2, f"Expected 2D logits, got shape {logits.shape}"
+    batch_size, vocab_size = logits.shape
+    out = torch.empty((batch_size,), dtype=torch.int64, device=logits.device)
+    if batch_size == 0 or vocab_size == 0:
+        return out
+
+    if logits.stride(1) != 1:
+        logits = logits.contiguous()
+    has_k = k is not None
+    has_p = p is not None
+    if has_k and not k.is_contiguous():
+        k = k.contiguous()
+    if has_p and not p.is_contiguous():
+        p = p.contiguous()
+
+    k_ptr = k if has_k else logits
+    p_ptr = p if has_p else logits
+
+    block_v = 1024 if vocab_size >= 1024 else max(64, triton.next_power_of_2(vocab_size))
+    num_warps = 8 if block_v >= 1024 else 4
+
+    with torch_device_fn.device(logits.device):
+        philox_seed, philox_offset = philox_backend_seed_offset(
+            batch_size * vocab_size, generator=generator
+        )
+        _topk_topp_sample_kernel[(batch_size,)](
+            logits,
+            k_ptr,
+            p_ptr,
+            out,
+            batch_size,
+            vocab_size,
+            logits.stride(0),
+            philox_seed,
+            philox_offset,
+            HAS_K=has_k,
+            HAS_P=has_p,
+            BLOCK_V=block_v,
+            num_warps=num_warps,
+        )
+    return out
+
+
+def apply_top_k_top_p(
+    logits: torch.Tensor,
+    k: Optional[torch.Tensor] = None,
+    p: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """Exact in-place Top-K and Top-P logit masking using multi-pivot threshold search."""
+    logger.debug("GEMS APPLY_TOP_K_TOP_P")
+    if k is None and p is None:
+        return logits
+    assert logits.ndim == 2, f"Expected 2D logits, got shape {logits.shape}"
+    batch_size, vocab_size = logits.shape
+    if batch_size == 0 or vocab_size == 0:
+        return logits
+
+    need_copy_back = logits.stride(1) != 1
+    work = logits.contiguous() if need_copy_back else logits
+
+    has_k = k is not None
+    has_p = p is not None
+    if has_k and not k.is_contiguous():
+        k = k.contiguous()
+    if has_p and not p.is_contiguous():
+        p = p.contiguous()
+
+    k_ptr = k if has_k else work
+    p_ptr = p if has_p else work
+
+    block_v = 1024 if vocab_size >= 1024 else max(64, triton.next_power_of_2(vocab_size))
+    num_warps = 8 if block_v >= 1024 else 4
+
+    with torch_device_fn.device(work.device):
+        _topk_topp_mask_kernel[(batch_size,)](
+            work,
+            k_ptr,
+            p_ptr,
+            batch_size,
+            vocab_size,
+            work.stride(0),
+            HAS_K=has_k,
+            HAS_P=has_p,
+            BLOCK_V=block_v,
+            num_warps=num_warps,
+        )
+
+    if need_copy_back:
+        logits.copy_(work)
+    return logits
