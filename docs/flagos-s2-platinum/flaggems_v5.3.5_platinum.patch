+    EVEN_N: tl.constexpr,
+    EVEN_K: tl.constexpr,
+    UPGRADE_A: tl.constexpr,
+    UPGRADE_W: tl.constexpr,
+    UPGRADE_C: tl.constexpr,
+    pipeline: tl.constexpr,
+    scenario: tl.constexpr,
