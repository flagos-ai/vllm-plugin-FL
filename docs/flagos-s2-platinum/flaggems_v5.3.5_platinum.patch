+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Sort-free, exact top-p (nucleus) sampling fused into one Triton kernel.
+
+Algorithm ("candidate-first nucleus sampling")
+----------------------------------------------
+Let w_i = exp(l_i - m), z = sum_i w_i.  The nucleus is
+    K = { i : mass(l > l_i) < p * z }          (*)
+i.e. a token is kept iff the probability mass of tokens with a strictly
+larger logit is still below p (the top token is always kept; ties at the
+boundary follow stable ascending sort order).  Sampling from softmax(l)
+renormalised on K is equivalent to the Gumbel-max race restricted to K:
+    i* = argmax_{i in K} (l_i + g_i),   g_i = -log(-log(1 - u_i)), u_i ~ U[0,1).
+
+One program handles one row and executes:
+  pass 1  row max m  +  global top-4 of the race scores l_i + g_i over the
+          whole vocabulary (running insertion sort in registers).
+  pass 2  z = sum_i w_i and, for each of the 4 candidates c, A_c =
+          mass(l > l_c) + w_c * #{j : l_j == l_c, j > c}.  Candidate c is in K
+          iff A_c < p * z (or p >= 1.0).  The first kept candidate in race
+          order is i*.  The probability that none of the 4 best scores lies in
+          K is at most (1 - p)^4 (~6.25e-6 for p = 0.95).
+  fallback (only when no candidate is kept): exact boundary bisection with
+          minimum-element-above-pivot tracking, followed by restricted argmax
+          using the identical Philox counter stream as pass 1.
+"""
+
+import logging
+
+import torch
+import triton
+import triton.language as tl
+
+from flag_gems.runtime import torch_device_fn
+from flag_gems.utils import libentry
+from flag_gems.utils.random_utils import philox_backend_seed_offset, uniform
+
+logger = logging.getLogger(__name__)
+
+
+@triton.jit
+def _gumbel(philox_seed, philox_offset, counter):
+    u0, u1, u2, u3 = uniform(philox_seed, philox_offset, counter)
+    e = tl.maximum(-tl.log(1.0 - u0), 1e-30)
+    return -tl.log(e)
+
+
+@libentry()
+@triton.jit(do_not_specialize=["philox_seed", "philox_offset"])
+def _top_p_sampling_kernel(
+    logits_ptr,
+    stride_row,
+    p_ptr,
+    out_ptr,
+    philox_seed,
+    philox_offset,
+    V: tl.constexpr,
+    BLOCK: tl.constexpr,
+    NUM_TILES: tl.constexpr,
+    N_ITERS: tl.constexpr,
+):
+    row = tl.program_id(0)
+    base = logits_ptr + row.to(tl.int64) * stride_row
+    offs0 = tl.arange(0, BLOCK)
+    neg_inf = float("-inf")
+    pos_inf = float("inf")
+    cbase = row * V
+
+    # ---- pass 1: row max + global top-4 of the Gumbel race ----------------
+    m = neg_inf
+    c0 = neg_inf
+    c1 = neg_inf
+    c2 = neg_inf
+    c3 = neg_inf
+    i0 = 0
+    i1 = 0
+    i2 = 0
+    i3 = 0
+    for t in range(0, NUM_TILES):
+        offs = t * BLOCK + offs0
+        valid = offs < V
+        x = tl.load(base + offs, mask=valid, other=neg_inf)
+        m = tl.maximum(m, tl.max(x, 0))
+        g = _gumbel(philox_seed, philox_offset, cbase + offs)
+        s = tl.where(valid & (x > neg_inf), x + g, neg_inf)
+        for r in range(0, 4):
+            v = tl.max(s, 0)
+            j = tl.argmax(s, 0)
+            idx = t * BLOCK + j
+            s = tl.where(offs0 == j, neg_inf, s)
+            gt0 = v > c0
+            gt1 = v > c1
+            gt2 = v > c2
+            gt3 = v > c3
+            c3 = tl.where(gt3, tl.where(gt2, c2, v), c3)
+            i3 = tl.where(gt3, tl.where(gt2, i2, idx), i3)
+            c2 = tl.where(gt2, tl.where(gt1, c1, v), c2)
+            i2 = tl.where(gt2, tl.where(gt1, i1, idx), i2)
+            c1 = tl.where(gt1, tl.where(gt0, c0, v), c1)
+            i1 = tl.where(gt1, tl.where(gt0, i0, idx), i1)
+            c0 = tl.where(gt0, v, c0)
+            i0 = tl.where(gt0, idx, i0)
+
+    if m == neg_inf:
+        tl.store(out_ptr + row, tl.zeros((), dtype=tl.int64))
+        return
+
+    p = tl.load(p_ptr + row)
+    if p >= 1.0:
+        tl.store(out_ptr + row, i0.to(tl.int64))
+        return
+
+    l0 = tl.load(base + i0)
+    l1 = tl.load(base + i1)
+    l2 = tl.load(base + i2)
+    l3 = tl.load(base + i3)
+
+    # ---- pass 2: partition function + mass ahead of each candidate --------
+    z = 0.0
+    a0 = 0.0
+    a1 = 0.0
+    a2 = 0.0
+    a3 = 0.0
+    lo = pos_inf
+    for t in range(0, NUM_TILES):
+        offs = t * BLOCK + offs0
+        x = tl.load(base + offs, mask=offs < V, other=neg_inf)
+        finite = x > neg_inf
+        e = tl.where(finite, tl.exp(x - m), 0.0)
+        z += tl.sum(e, 0)
+        a0 += tl.sum(tl.where((x > l0) | ((x == l0) & (offs > i0)), e, 0.0), 0)
+        a1 += tl.sum(tl.where((x > l1) | ((x == l1) & (offs > i1)), e, 0.0), 0)
+        a2 += tl.sum(tl.where((x > l2) | ((x == l2) & (offs > i2)), e, 0.0), 0)
+        a3 += tl.sum(tl.where((x > l3) | ((x == l3) & (offs > i3)), e, 0.0), 0)
+        lo = tl.minimum(lo, tl.min(tl.where(finite, x, pos_inf), 0))
+
+    target = p * z
+    k0 = a0 < target
+    k1 = a1 < target
+    k2 = a2 < target
+    k3 = a3 < target
+    chosen = tl.where(k0, i0, tl.where(k1, i1, tl.where(k2, i2, tl.where(k3, i3, -1))))
+    need_fallback = chosen < 0
+
+    # ---- fallback: exact boundary by bisection, then restricted argmax ----
+    n_iters = tl.where(need_fallback, N_ITERS, 0)
+    lo_b = lo - 1.0
+    hi_b = m
+    thr = m
+    found = 0
+    for it in range(0, n_iters):
+        piv = 0.5 * (lo_b + hi_b)
+        S = 0.0
+        ml = pos_inf
+        cnt = 0.0
+        for t in range(0, NUM_TILES):
+            offs = t * BLOCK + offs0
+            x = tl.load(base + offs, mask=offs < V, other=neg_inf)
+            above = x > piv
+            S += tl.sum(tl.where(above, tl.exp(x - m), 0.0), 0)
+            tmin = tl.min(tl.where(above, x, pos_inf), 0)
+            tcnt = tl.sum(tl.where(above & (x == tmin), 1.0, 0.0), 0)
+            cnt = tl.where(tmin < ml, tcnt, tl.where(tmin == ml, cnt + tcnt, cnt))
+            ml = tl.minimum(ml, tmin)
+        mass_above_ml = S - tl.exp(ml - m) * cnt
+        ok = (found == 0) & (S >= target) & (mass_above_ml < target)
+        thr = tl.where(ok, ml, thr)
+        found = tl.where(ok, 1, found)
+        go_down = (found == 0) & (S < target)
+        go_up = (found == 0) & (S >= target)
+        hi_b = tl.where(go_down, piv, hi_b)
+        lo_b = tl.where(go_up, piv, lo_b)
+    thr = tl.where(found == 1, thr, lo_b)
+
+    n_tiles_fb = tl.where(need_fallback, NUM_TILES, 0)
+    best = neg_inf
+    best_idx = 0
+    for t in range(0, n_tiles_fb):
+        offs = t * BLOCK + offs0
+        x = tl.load(base + offs, mask=offs < V, other=neg_inf)
+        kept = (offs < V) & (x >= thr) & (x > lo_b)
+        g = _gumbel(philox_seed, philox_offset, cbase + offs)
+        s = tl.where(kept, x + g, neg_inf)
+        tmax = tl.max(s, 0)
+        tidx = t * BLOCK + tl.argmax(s, 0)
+        best_idx = tl.where(tmax > best, tidx, best_idx)
+        best = tl.maximum(best, tmax)
+    chosen = tl.where(need_fallback, best_idx, chosen)
+    tl.store(out_ptr + row, chosen.to(tl.int64))
+
+
+def top_p_sampling_from_logits(
+    logits: torch.Tensor,
+    top_p: torch.Tensor,
+    *,
+    generator=None,
+    n_iters: int = 30,
+) -> torch.Tensor:
+    """Sample one token id per row from the exact top-p nucleus of ``logits``."""
+    logger.debug("GEMS TOP_P_SAMPLING_FROM_LOGITS")
+    assert logits.dim() == 2
+    if logits.dtype != torch.float32:
+        logits = logits.float()
+    if logits.stride(1) != 1:
+        logits = logits.contiguous()
+    B, V = logits.shape
+    out = torch.empty((B,), dtype=torch.int64, device=logits.device)
+    if B == 0:
+        return out
+    if top_p.dtype != torch.float32 or not top_p.is_contiguous():
+        top_p = top_p.to(dtype=torch.float32).contiguous()
+    BLOCK = 4096 if V >= 4096 else triton.next_power_of_2(V)
+    NUM_TILES = triton.cdiv(V, BLOCK)
+    philox_seed, philox_offset = philox_backend_seed_offset(B * V, generator=generator)
+    with torch_device_fn.device(logits.device):
+        _top_p_sampling_kernel[(B,)](
+            logits,
+            logits.stride(0),
+            top_p,
+            out,
+            philox_seed,
+            philox_offset,
+            V=V,
+            BLOCK=BLOCK,
+            NUM_TILES=NUM_TILES,
+            N_ITERS=n_iters,
+            num_warps=8,
+        )
+    return out
