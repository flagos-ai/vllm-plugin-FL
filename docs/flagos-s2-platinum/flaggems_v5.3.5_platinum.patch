+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import logging
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+from flag_gems.runtime import torch_device_fn
+from flag_gems.utils.random_utils import (
+    philox_backend_seed_offset,
+    uint_to_uniform_float,
+)
+
+logger = logging.getLogger(__name__)
+
+
+@triton.jit
+def _next_up_f32(x):
+    """Smallest normal IEEE-754 float32 strictly greater than finite x (FTZ-safe)."""
+    x = (x + 0.0).to(tl.float32)
+    bits = x.to(tl.int32, bitcast=True)
+    next_bits = tl.where(x >= 0.0, bits + 1, bits - 1)
+    cand = next_bits.to(tl.float32, bitcast=True)
+    fallback = tl.where(
+        x == 0.0,
+        tl.full((), 1.17549435e-38, tl.float32),
+        x + tl.abs(x) * 1.1920929e-7 + 1.17549435e-38,
+    )
+    return tl.where(cand > x, cand, fallback).to(tl.float32)
+
+
+@triton.jit
+def _argmax_combine(v1, i1, v2, i2):
+    gt = (v1 > v2) | ((v1 == v2) & (i1 < i2))
+    return tl.where(gt, v1, v2), tl.where(gt, i1, i2)
+
+
+@triton.jit
+def _row_stats_pass(row_ptr, vocab_size, floor_val, BLOCK_V: tl.constexpr):
+    """Single register-accumulated pass computing (max_val, min_valid, sum_exp, count_valid)."""
+    neg_inf = tl.full((), -float("inf"), tl.float32)
+    pos_inf = tl.full((), float("inf"), tl.float32)
+
+    m_vec = tl.full((BLOCK_V,), -float("inf"), tl.float32)
+    s_vec = tl.zeros((BLOCK_V,), dtype=tl.float32)
+    min_vec = tl.full((BLOCK_V,), float("inf"), tl.float32)
+    cnt_vec = tl.zeros((BLOCK_V,), dtype=tl.int32)
+
+    for start in range(0, vocab_size, BLOCK_V):
+        cols = start + tl.arange(0, BLOCK_V)
+        mask = cols < vocab_size
+        z = tl.load(row_ptr + cols, mask=mask, other=neg_inf).to(tl.float32)
+        valid = mask & (z > neg_inf) & (z >= floor_val)
+        zv = tl.where(valid, z, neg_inf)
+
+        new_m = tl.maximum(m_vec, zv)
+        scale_old = tl.where(new_m > neg_inf, tl.exp(m_vec - new_m), 0.0)
+        add_new = tl.where(valid, tl.exp(zv - new_m), 0.0)
+        s_vec = s_vec * scale_old + add_new
+        m_vec = new_m
+
+        min_vec = tl.minimum(min_vec, tl.where(valid, z, pos_inf))
+        cnt_vec += valid.to(tl.int32)
+
+    max_val = tl.max(m_vec, axis=0)
+    min_valid = tl.min(min_vec, axis=0)
+    count_valid = tl.sum(cnt_vec, axis=0)
+    sum_exp = tl.sum(
+        tl.where(m_vec > neg_inf, s_vec * tl.exp(m_vec - max_val), 0.0), axis=0
+    )
+    return max_val, min_valid, sum_exp, count_valid
+
+
+@triton.jit
+def _find_topk_cutoff(
+    row_ptr, vocab_size, k_val, min_finite, max_val, BLOCK_V: tl.constexpr
+):
+    """Exact multi-pivot IEEE-754 search with hoisted cross-warp reductions."""
+    neg_inf = tl.full((), -float("inf"), tl.float32)
+    pos_inf = tl.full((), float("inf"), tl.float32)
+
+    cnt_max_vec = tl.zeros((BLOCK_V,), dtype=tl.int32)
+    for start in range(0, vocab_size, BLOCK_V):
+        cols = start + tl.arange(0, BLOCK_V)
+        mask = cols < vocab_size
+        z = tl.load(row_ptr + cols, mask=mask, other=neg_inf).to(tl.float32)
+        cnt_max_vec += (mask & (z >= max_val)).to(tl.int32)
+    cnt_max = tl.sum(cnt_max_vec, axis=0)
+
+    low = min_finite.to(tl.float32)
+    high = max_val.to(tl.float32)
+    v_res = max_val.to(tl.float32)
+    done = tl.where(cnt_max >= k_val, 1, 0).to(tl.int32)
+    it = tl.full((), 0, tl.int32)
+    piv_idx = (tl.arange(0, 8) + 1).to(tl.float32)
+
+    while (it < 8) & (done == 0):
+        step = (high - low) * (1.0 / 9.0)
+        pivs = low + piv_idx * step
+        cnt_acc = tl.zeros((BLOCK_V, 8), dtype=tl.int32)
+        b_min_vec = tl.full((BLOCK_V,), float("inf"), tl.float32)
+        b_max_vec = tl.full((BLOCK_V,), -float("inf"), tl.float32)
+
+        for start in range(0, vocab_size, BLOCK_V):
+            cols = start + tl.arange(0, BLOCK_V)
+            mask = cols < vocab_size
+            z = tl.load(row_ptr + cols, mask=mask, other=neg_inf).to(tl.float32)
+            in_band = mask & (z >= low) & (z < high)
+            b_min_vec = tl.minimum(b_min_vec, tl.where(in_band, z, pos_inf))
+            b_max_vec = tl.maximum(b_max_vec, tl.where(in_band, z, neg_inf))
+            ge = mask[:, None] & (z[:, None] >= pivs[None, :])
+            cnt_acc += ge.to(tl.int32)
+
+        b_min = tl.min(b_min_vec, axis=0)
+        b_max = tl.max(b_max_vec, axis=0)
+        cnt_ge = tl.sum(cnt_acc, axis=0)
+
+        single_val = b_min >= b_max
+        ok = cnt_ge >= k_val
+        cand_low = tl.max(tl.where(ok, pivs, low), axis=0)
+        cand_high = tl.min(tl.where(ok, high, pivs), axis=0)
+        cand_low = tl.maximum(cand_low, b_min)
+        hi_cap = _next_up_f32(tl.minimum(b_max, high))
+        cand_high = tl.minimum(cand_high, hi_cap)
+
+        converged = single_val | (cand_high <= cand_low)
+        v_res = tl.where(
+            single_val, tl.where(b_min <= b_max, b_min, low), cand_low
+        ).to(tl.float32)
+        low = cand_low.to(tl.float32)
+        high = cand_high.to(tl.float32)
+        done = tl.where(converged, 1, 0).to(tl.int32)
+        it += 1
+
+    return tl.where(done != 0, v_res, low).to(tl.float32)
+
+
+@triton.jit
+def _find_topp_cutoff(
+    row_ptr,
+    vocab_size,
+    p_eff,
+    floor_val,
+    min_valid,
+    max_val,
+    sum_exp,
+    BLOCK_V: tl.constexpr,
+):
+    """Exact multi-pivot IEEE-754 search for Top-P with hoisted register reductions."""
+    neg_inf = tl.full((), -float("inf"), tl.float32)
+    pos_inf = tl.full((), float("inf"), tl.float32)
+    target_mass = (p_eff * sum_exp).to(tl.float32)
+
+    cnt_max_vec = tl.zeros((BLOCK_V,), dtype=tl.int32)
+    for start in range(0, vocab_size, BLOCK_V):
+        cols = start + tl.arange(0, BLOCK_V)
+        mask = cols < vocab_size
+        z = tl.load(row_ptr + cols, mask=mask, other=neg_inf).to(tl.float32)
+        cnt_max_vec += (mask & (z >= max_val)).to(tl.int32)
+    mass_at_max = tl.sum(cnt_max_vec, axis=0).to(tl.float32)
+
+    rem_mass = tl.maximum((1.0 - p_eff) * sum_exp, 1e-7 * sum_exp)
+    analytic_low = max_val + tl.log(rem_mass / vocab_size.to(tl.float32)) - 0.05
+    low = tl.maximum(min_valid, analytic_low).to(tl.float32)
+    low = tl.where(low < max_val, low, min_valid).to(tl.float32)
+    high = max_val.to(tl.float32)
+    v_res = max_val.to(tl.float32)
+    done = tl.where((mass_at_max >= target_mass) | (p_eff <= 0.0), 1, 0).to(tl.int32)
+    it = tl.full((), 0, tl.int32)
+    piv_idx = (tl.arange(0, 8) + 1).to(tl.float32)
+
+    while (it < 8) & (done == 0):
+        step = (high - low) * (1.0 / 9.0)
+        pivs = low + piv_idx * step
+        piv0 = tl.min(pivs, axis=0)
+        mass_acc = tl.zeros((BLOCK_V, 8), dtype=tl.float32)
+        b_min_vec = tl.full((BLOCK_V,), float("inf"), tl.float32)
+        b_max_vec = tl.full((BLOCK_V,), -float("inf"), tl.float32)
+
+        for start in range(0, vocab_size, BLOCK_V):
+            cols = start + tl.arange(0, BLOCK_V)
+            mask = cols < vocab_size
+            z = tl.load(row_ptr + cols, mask=mask, other=neg_inf).to(tl.float32)
+            valid = mask & (z >= floor_val) & (z > neg_inf)
+            in_band = valid & (z >= low) & (z < high)
+            b_min_vec = tl.minimum(b_min_vec, tl.where(in_band, z, pos_inf))
+            b_max_vec = tl.maximum(b_max_vec, tl.where(in_band, z, neg_inf))
+            ez = tl.where(valid & (z >= piv0), tl.exp(z - max_val), 0.0)
+            mass_acc += tl.where(z[:, None] >= pivs[None, :], ez[:, None], 0.0)
+
+        b_min = tl.min(b_min_vec, axis=0)
+        b_max = tl.max(b_max_vec, axis=0)
+        mass_ge = tl.sum(mass_acc, axis=0)
+
+        single_val = b_min >= b_max
+        ok = mass_ge >= target_mass
+        cand_low = tl.max(tl.where(ok, pivs, low), axis=0)
+        cand_high = tl.min(tl.where(ok, high, pivs), axis=0)
+        cand_low = tl.maximum(cand_low, b_min)
+        hi_cap = _next_up_f32(tl.minimum(b_max, high))
+        cand_high = tl.minimum(cand_high, hi_cap)
+
+        converged = single_val | (cand_high <= cand_low)
+        v_res = tl.where(
+            single_val, tl.where(b_min <= b_max, b_min, low), cand_low
+        ).to(tl.float32)
+        low = cand_low.to(tl.float32)
+        high = cand_high.to(tl.float32)
+        done = tl.where(converged, 1, 0).to(tl.int32)
+        it += 1
+
+    v_p = tl.where(done != 0, v_res, low).to(tl.float32)
+
+    # Exact tie count at z == v_p with hoisted register reductions
+    mass_gt_vec = tl.zeros((BLOCK_V,), dtype=tl.float32)
+    mass_lt_vec = tl.zeros((BLOCK_V,), dtype=tl.float32)
+    cnt_gt_vec = tl.zeros((BLOCK_V,), dtype=tl.int32)
+    cnt_eq_vec = tl.zeros((BLOCK_V,), dtype=tl.int32)
+    for start in range(0, vocab_size, BLOCK_V):
+        cols = start + tl.arange(0, BLOCK_V)
+        mask = cols < vocab_size
+        z = tl.load(row_ptr + cols, mask=mask, other=neg_inf).to(tl.float32)
+        valid = mask & (z >= floor_val) & (z > neg_inf)
+        is_gt = valid & (z > v_p)
+        is_eq = valid & (z == v_p)
+        is_lt = valid & (z < v_p)
+        ez = tl.where(valid & (z != v_p), tl.exp(z - max_val), 0.0)
+        mass_gt_vec += tl.where(is_gt, ez, 0.0)
+        mass_lt_vec += tl.where(is_lt, ez, 0.0)
+        cnt_gt_vec += is_gt.to(tl.int32)
+        cnt_eq_vec += is_eq.to(tl.int32)
+
+    mass_gt = tl.sum(mass_gt_vec, axis=0)
+    mass_lt = tl.sum(mass_lt_vec, axis=0)
+    cnt_gt = tl.sum(cnt_gt_vec, axis=0)
+    cnt_eq = tl.sum(cnt_eq_vec, axis=0)
+
+    exp_vp = tl.exp(v_p - max_val)
+    total_mass = mass_lt + cnt_eq.to(tl.float32) * exp_vp + mass_gt
+    thresh_drop = (1.0 - p_eff) * total_mass
+    can_drop = (cnt_eq > 1) & (exp_vp > 0.0) & (thresh_drop >= mass_lt)
+    raw_drop = tl.where(
+        can_drop,
+        tl.math.floor(
+            (thresh_drop - mass_lt)
+            / tl.maximum(exp_vp, tl.full((), 1.17549435e-38, tl.float32))
+        ).to(tl.int32),
+        0,
+    )
+    m_drop = tl.minimum(cnt_eq, tl.maximum(raw_drop, 0))
+    m_keep = cnt_eq - m_drop
+    m_keep = tl.where((cnt_gt == 0) & (m_keep <= 0), 1, m_keep)
+    return v_p, m_keep, cnt_eq
+
+
+@triton.jit(
+    do_not_specialize=[
+        "batch_size",
+        "vocab_size",
+        "logits_stride",
+        "philox_seed",
+        "philox_offset",
+    ]
+)
+def _topk_topp_sample_kernel(
+    LOGITS_PTR,
+    K_PTR,
+    P_PTR,
+    OUT_PTR,
+    batch_size,
+    vocab_size,
+    logits_stride,
+    philox_seed,
+    philox_offset,
+    HAS_K: tl.constexpr,
+    HAS_P: tl.constexpr,
+    BLOCK_V: tl.constexpr,
+):
+    row_id = tl.program_id(0)
+    if row_id >= batch_size:
+        return
+
+    row_ptr = LOGITS_PTR + row_id.to(tl.int64) * logits_stride.to(tl.int64)
+    neg_inf = tl.full((), -float("inf"), tl.float32)
+
+    if HAS_K:
+        k_raw = tl.load(K_PTR + row_id).to(tl.int32)
+        active_k = (k_raw > 0) & (k_raw < vocab_size)
+        k_val = tl.where(active_k, k_raw, vocab_size)
+    else:
+        active_k = tl.full((), 0, tl.int1)
+        k_val = vocab_size
+
+    if HAS_P:
+        p_raw = tl.load(P_PTR + row_id).to(tl.float32)
+        active_p = p_raw < 1.0
+        p_eff = tl.maximum(p_raw, 0.0)
+    else:
+        active_p = tl.full((), 0, tl.int1)
+        p_eff = tl.full((), 1.0, tl.float32)
+
+    v_cut = neg_inf
+    m_keep = vocab_size
+    cnt_eq = tl.full((), 0, tl.int32)
+
+    if active_k:
+        max_val, min_valid, sum_exp, cnt_valid = _row_stats_pass(
+            row_ptr, vocab_size, neg_inf, BLOCK_V
+        )
+        if cnt_valid == 0:
+            tl.store(OUT_PTR + row_id, tl.full((), 0, tl.int64))
+            return
+        if cnt_valid > k_val:
+            v_k = _find_topk_cutoff(
+                row_ptr, vocab_size, k_val, min_valid, max_val, BLOCK_V
+            )
+        else:
+            v_k = neg_inf
+        if active_p:
+            max_k, min_k, sum_exp_k, _ = _row_stats_pass(
+                row_ptr, vocab_size, v_k, BLOCK_V
+            )
+            v_cut, m_keep, cnt_eq = _find_topp_cutoff(
+                row_ptr, vocab_size, p_eff, v_k, min_k, max_k, sum_exp_k, BLOCK_V
+            )
+        else:
+            v_cut = v_k
+    elif active_p:
+        max_val, min_valid, sum_exp, cnt_valid = _row_stats_pass(
+            row_ptr, vocab_size, neg_inf, BLOCK_V
+        )
+        if cnt_valid == 0:
+            tl.store(OUT_PTR + row_id, tl.full((), 0, tl.int64))
+            return
+        v_cut, m_keep, cnt_eq = _find_topp_cutoff(
+            row_ptr, vocab_size, p_eff, neg_inf, min_valid, max_val, sum_exp, BLOCK_V
+        )
+
+    # Final single fused Gumbel-Max sampling pass (log-space: argmax(z - log(-log(u))))
+    seed64 = philox_seed.to(tl.int64)
+    row_rng_base = philox_offset.to(tl.int64) + row_id.to(tl.int64) * vocab_size.to(
+        tl.int64
+    )
+    c0_base = (row_rng_base & 0xFFFFFFFF).to(tl.uint32)
+    c1_base = ((row_rng_base >> 32) & 0xFFFFFFFF).to(tl.uint32)
+
+    best_scores = tl.full((BLOCK_V,), -float("inf"), tl.float32)
+    best_indices = tl.zeros((BLOCK_V,), dtype=tl.int32)
+    ties_seen = tl.full((), 0, tl.int32)
+    partial_ties = m_keep < cnt_eq
+
+    for start in range(0, vocab_size, BLOCK_V):
+        cols = start + tl.arange(0, BLOCK_V)
+        mask = cols < vocab_size
+        z = tl.load(row_ptr + cols, mask=mask, other=neg_inf).to(tl.float32)
+        finite = mask & (z > neg_inf)
+
+        if partial_ties:
+            is_gt = finite & (z > v_cut)
+            is_eq = finite & (z == v_cut)
+            eq_f32 = is_eq.to(tl.float32)
+            eq_rank = ties_seen + tl.cumsum(eq_f32, axis=0).to(tl.int32)
+            ties_seen += tl.sum(eq_f32, axis=0).to(tl.int32)
+            keep = is_gt | (is_eq & (eq_rank <= m_keep))
+        else:
+            keep = finite & (z >= v_cut)
+
+        u_cols = cols.to(tl.uint32)
+        c0 = c0_base + u_cols
+        c1 = c1_base + (c0 < c0_base).to(tl.uint32)
+        zeros_u32 = u_cols * 0
+        r0, _, _, _ = tl.philox(seed64, c0, c1, zeros_u32, zeros_u32)
+        u = uint_to_uniform_float(r0).to(tl.float32)
+        u_min = tl.full((), 1.17549435e-38, tl.float32)
+        u_max = tl.full((), 0.99999994, tl.float32)
+        u_safe = tl.minimum(tl.maximum(u, u_min), u_max)
+        gumbel = (-tl.log(-tl.log(u_safe))).to(tl.float32)
+        score = tl.where(keep, z + gumbel, neg_inf).to(tl.float32)
+
+        better = score > best_scores
+        best_scores = tl.where(better, score, best_scores)
+        best_indices = tl.where(better, cols, best_indices)
+
+    _, sampled_idx = tl.reduce((best_scores, best_indices), 0, _argmax_combine)
+    tl.store(OUT_PTR + row_id, sampled_idx.to(tl.int64))
+
+
+@triton.jit(do_not_specialize=["batch_size", "vocab_size", "logits_stride"])
+def _topk_topp_mask_kernel(
+    LOGITS_PTR,
+    K_PTR,
+    P_PTR,
+    batch_size,
+    vocab_size,
+    logits_stride,
+    HAS_K: tl.constexpr,
+    HAS_P: tl.constexpr,
+    BLOCK_V: tl.constexpr,
+):
+    row_id = tl.program_id(0)
+    if row_id >= batch_size:
+        return
+
+    row_ptr = LOGITS_PTR + row_id.to(tl.int64) * logits_stride.to(tl.int64)
+    neg_inf = tl.full((), -float("inf"), tl.float32)
+
+    if HAS_K:
+        k_raw = tl.load(K_PTR + row_id).to(tl.int32)
+        active_k = (k_raw > 0) & (k_raw < vocab_size)
+        k_val = tl.where(active_k, k_raw, vocab_size)
+    else:
+        active_k = tl.full((), 0, tl.int1)
+        k_val = vocab_size
+
+    if HAS_P:
+        p_raw = tl.load(P_PTR + row_id).to(tl.float32)
+        active_p = p_raw < 1.0
+        p_eff = tl.maximum(p_raw, 0.0)
+    else:
+        active_p = tl.full((), 0, tl.int1)
+        p_eff = tl.full((), 1.0, tl.float32)
+
+    if (not active_k) & (not active_p):
+        return
+
+    v_cut = neg_inf
+    m_keep = vocab_size
+    cnt_eq = tl.full((), 0, tl.int32)
+
+    if active_k:
+        max_val, min_valid, sum_exp, cnt_valid = _row_stats_pass(
+            row_ptr, vocab_size, neg_inf, BLOCK_V
+        )
+        if cnt_valid == 0:
+            return
+        if cnt_valid > k_val:
+            v_k = _find_topk_cutoff(
+                row_ptr, vocab_size, k_val, min_valid, max_val, BLOCK_V
+            )
+        else:
+            v_k = neg_inf
+        if active_p:
+            max_k, min_k, sum_exp_k, _ = _row_stats_pass(
+                row_ptr, vocab_size, v_k, BLOCK_V
+            )
+            v_cut, m_keep, cnt_eq = _find_topp_cutoff(
+                row_ptr, vocab_size, p_eff, v_k, min_k, max_k, sum_exp_k, BLOCK_V
+            )
+        else:
+            v_cut = v_k
+    else:
+        max_val, min_valid, sum_exp, cnt_valid = _row_stats_pass(
+            row_ptr, vocab_size, neg_inf, BLOCK_V
+        )
+        if cnt_valid == 0:
+            return
+        v_cut, m_keep, cnt_eq = _find_topp_cutoff(
+            row_ptr, vocab_size, p_eff, neg_inf, min_valid, max_val, sum_exp, BLOCK_V
+        )
+
+    ties_seen = tl.full((), 0, tl.int32)
+    partial_ties = m_keep < cnt_eq
+
+    for start in range(0, vocab_size, BLOCK_V):
+        cols = start + tl.arange(0, BLOCK_V)
+        mask = cols < vocab_size
+        z = tl.load(row_ptr + cols, mask=mask, other=neg_inf).to(tl.float32)
+        if partial_ties:
+            is_gt = mask & (z > v_cut)
+            is_eq = mask & (z == v_cut)
+            eq_f32 = is_eq.to(tl.float32)
+            eq_rank = ties_seen + tl.cumsum(eq_f32, axis=0).to(tl.int32)
+            ties_seen += tl.sum(eq_f32, axis=0).to(tl.int32)
+            keep = is_gt | (is_eq & (eq_rank <= m_keep))
+        else:
+            keep = mask & (z >= v_cut)
+        out_z = tl.where(keep, z, neg_inf).to(LOGITS_PTR.dtype.element_ty)
