+        if M > 0 and d > 0 and (A.ndim <= 2 or (A.stride(-2) == B.stride(-2))):
+            stride_am = A.stride(-2) if A.ndim >= 2 else d
+            stride_bm = B.stride(-2) if B.ndim >= 2 else d
+            if A.ndim <= 2:
+                out = torch.empty_like(A, memory_format=torch.contiguous_format)
+                block_n = 1024 if d >= 1024 else max(64, triton.next_power_of_2(d))
+                num_warps = 4 if block_n <= 1024 else 8
+                grid = (M, triton.cdiv(d, block_n))
+                if torch.cuda.current_device() != A.device.index:
+                    with torch_device_fn.device(A.device):
+                        _silu_and_mul_2d_kernel[grid](
+                            A,
+                            B,
+                            out,
+                            M,
+                            d,
+                            stride_am,
+                            stride_bm,
+                            d,
+                            BLOCK_N=block_n,
+                            EVEN_N=(d % block_n == 0),
+                            num_warps=num_warps,
+                        )
+                else:
+                    _silu_and_mul_2d_kernel[grid](
+                        A,
+                        B,
+                        out,
+                        M,
+                        d,
+                        stride_am,
+                        stride_bm,
+                        d,
+                        BLOCK_N=block_n,
+                        EVEN_N=(d % block_n == 0),
+                        num_warps=num_warps,
+                    )
