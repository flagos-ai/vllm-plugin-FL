EOF
RUN python -m pip install --no-cache-dir --no-deps \
        --index-url https://pypi.org/simple \
        --requirement /opt/ci/requirements-public.lock

# Build a non-editable vLLM 0.28.0 empty wheel, reusing the MACA torch ABI.
RUN git init /workspace/vllm \
    && git -C /workspace/vllm remote add origin https://github.com/vllm-project/vllm.git \
    && git -C /workspace/vllm fetch --depth 1 origin "${VLLM_COMMIT}" \
    && git -C /workspace/vllm checkout --detach FETCH_HEAD \
    && git -C /workspace/vllm fetch --depth 1 origin refs/tags/v0.28.0:refs/tags/v0.28.0 \
    && test "$(git -C /workspace/vllm rev-parse 'v0.28.0^{commit}')" = "${VLLM_COMMIT}" \
    && mkdir -p /opt/ci/wheelhouse \
    && VLLM_TARGET_DEVICE=empty python -m pip wheel \
        --no-build-isolation --no-deps --wheel-dir /opt/ci/wheelhouse /workspace/vllm \
    && python -m pip install --no-cache-dir --no-deps --force-reinstall \
        /opt/ci/wheelhouse/vllm-0.28.0+empty-*.whl

# Install ordinary wheels so workspace mounts cannot hide runtime packages.
# The installer pins FlagGems-vllm to f775b37f3066e2935742d26c7592a5dd55499159.
RUN git init /workspace/vllm-plugin-FL \
    && git -C /workspace/vllm-plugin-FL remote add origin "${PLUGIN_REPOSITORY}" \
    && git -C /workspace/vllm-plugin-FL fetch --depth 1 origin "${PLUGIN_COMMIT}" \
    && git -C /workspace/vllm-plugin-FL checkout --detach FETCH_HEAD \
    && python -m pip wheel --no-build-isolation --no-deps \
        --wheel-dir /opt/ci/wheelhouse /workspace/vllm-plugin-FL \
    && python -m pip install --no-cache-dir --no-deps --force-reinstall \
        /opt/ci/wheelhouse/vllm_plugin_fl-*.whl \
    && python /workspace/vllm-plugin-FL/.github/scripts/install_flaggems_vllm.py

# mcoplib's vendor Triton 3.0 distribution is retained for package metadata;
# FlagTree 0.7.0+metax3.6 supplies the effective Triton 3.6 compiler via PYTHONPATH.
RUN python -m pip check \
    && python - <<'PY'
from importlib.metadata import version
import numpy
import torch
import triton

assert version("vllm") == "0.28.0+empty"
assert version("torch") == "2.8.0+metax3.7.2.0"
assert version("numpy") == "1.26.4"
assert version("flagtree") == "0.7.0+metax3.6"
assert version("flag-gems") == "5.4.0"
assert version("mcoplib") == "0.4.5+maca3.7.0.37.torch2.8"
assert version("pycountry") == "26.2.16"
assert triton.__version__ == "3.6.0" and triton.__file__.startswith("/opt/flagtree/")
assert torch.from_numpy(numpy.ones(1)).numpy()[0] == 1
PY

# Validated on C550: UT 1876+2 passed; FT 32 passed, 68 platform skips;
# PR E2E: four TP4 inference and four text/image serving scenarios passed.
# Run hardware tests after building with /dev/dri, /dev/mxcd and model mounts:
# python tests/run.py --platform metax --device c550 --scope unit,functional
# python tests/run.py --platform metax --device c550 --scope e2e --stage pr
WORKDIR /workspace
CMD ["/bin/bash"]
