# Build from the repository root (Harbor authentication may be required):
# docker build -f docker/metax/Dockerfile.v0.28.0 \
#   -t harbor.baai.ac.cn/flagos-dev/vllm-plugin-fl:v0.28.0-metax-ci .
# Validated image: sha256:a85622770c3138bdc961a165da55b2bdda84a770a3bb46cf09b3079dcdc4ed55
# This recipe records the runtime, vendor packages and Python dependency pins
# used for that image. Rebuilding produces a new digest.

ARG BASE_IMAGE=harbor.baai.ac.cn/flagos-runtime/flagos-runtime-metax-maca3.7.2.1@sha256:d8e84de725d32dabb471b29715f80018ce17077f9a1694aa72c79198fde9ed43
ARG VENDOR_PACKAGES_IMAGE=harbor.baai.ac.cn/flagos-app/vllm0.24.0-metax-maca3.7.2.1@sha256:667e3746065f2b5b6f98328d752c62f856f92245f7576116130a9499be872df6
ARG MACA_KERNELS_IMAGE=harbor.baai.ac.cn/flagos-dev/vllm-plugin-fl@sha256:972dde2df5e3bbe0a7fd1e187abf4543d0c7c5825d21be86b506e813dbc8bed4

# Preserve vendor builds compatible with PyTorch 2.8 and NumPy 1.26.
FROM ${VENDOR_PACKAGES_IMAGE} AS vendor-packages
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN mkdir -p /vendor-packages \
    && cd /flagos/lib/python3.12/site-packages \
    && cp -a flag_gems flag_gems-*.dist-info \
        compressed_tensors compressed_tensors-*.dist-info \
        xgrammar xgrammar-*.dist-info \
        cv2 opencv_python_headless.libs opencv_python_headless-*.dist-info \
        /vendor-packages/

# mcoplib supplies torch.ops._C; never copy vLLM's compiled CUDA extensions.
FROM ${MACA_KERNELS_IMAGE} AS maca-kernels
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN mkdir -p /maca-kernels \
    && cd /opt/conda/lib/python3.12/site-packages \
    && cp -a mcoplib mcoplib-*.dist-info \
        flashinfer flashinfer-*.dist-info triton triton-*.dist-info \
        /maca-kernels/

FROM ${BASE_IMAGE} AS ci
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

ARG VLLM_COMMIT=2cf0a6915ce544dc493a0990f2ea38d81601128a
ARG PLUGIN_REPOSITORY=https://github.com/BrianPei/vllm-plugin-FL.git
ARG PLUGIN_COMMIT=452c5fe505a0fef63d46b52b6e6a7ef6b103fe1b

# Keep the runtime's MACA PyTorch and /opt/flagtree Triton compiler.
ENV UV_PYTHON=/flagos/bin/python \
    PYTHONPATH=/opt/flagtree \
    GEMS_VENDOR=metax \
    VLLM_PLUGINS=fl \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# PNG/JPEG libraries are needed by torchvision's image extension and VLM E2E.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential \
        libpng16-16t64=1.6.43-5ubuntu0.7 libjpeg-turbo8=2.1.5-2ubuntu2 \
    && rm -rf /var/lib/apt/lists/*

# Remove conflicting distributions before copying the validated vendor builds.
RUN python -m pip uninstall -y \
        compressed-tensors xgrammar opencv-python-headless \
        mcoplib flashinfer triton flag-gems
COPY --from=vendor-packages /vendor-packages/ /flagos/lib/python3.12/site-packages/
COPY --from=maca-kernels /maca-kernels/ /flagos/lib/python3.12/site-packages/

# Complete public-PyPI snapshot from the validated image. Install without
# dependency resolution to avoid replacing vendor torch, NumPy or Triton.
# Vendor packages above: FlagGems 5.4.0, compressed-tensors 0.17.0+flagos,
# xgrammar 0.2.3+flagos, OpenCV 5.0.0.93+flagos,
# mcoplib 0.4.5+maca3.7.0.37.torch2.8 and
# flashinfer 0.2.6+metax3.7.0.7torch2.8.
COPY <<EOF /opt/ci/requirements-public.lock
aiohappyeyeballs==2.7.1
