# MUSA v0.28.0 image definition.
#
# The immutable runtime supplies MUSA SDK, TorchMUSA, vLLM 0.28.0 and the
# validated FlagGems/FlagTree stack. CI installs the checked-out plugin and
# test-only dependencies in the container layer.
ARG MUSA_BASE_IMAGE=harbor.baai.ac.cn/flagos-dev/vllm-plugin-fl:v0.28.0-musa-ci
FROM ${MUSA_BASE_IMAGE} AS base

ENV VLLM_PLUGINS=fl \
    GEMS_VENDOR=mthreads \
    VLLM_VENDOR=musa

RUN python -c 'from importlib.metadata import version; \
assert version("vllm").startswith("0.28.0"); \
assert version("torch").split("+")[0] == "2.9.0"; \
assert version("torch-musa").split("+")[0] == "2.9.0"'

WORKDIR /workspace
ENTRYPOINT []
CMD ["python", "-I", "-B", "-m", "vllm.entrypoints.openai.api_server"]

FROM base AS dev
FROM base AS ci
FROM base AS release
