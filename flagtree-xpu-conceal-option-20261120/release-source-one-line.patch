From 49ce384960a4f716a82445ff49b42549f4d15b23 Mon Sep 17 00:00:00 2001
From: Physics <3150105638@zju.edu.cn>
Date: Fri, 20 Nov 2026 15:49:21 +0800
Subject: [PATCH] Fix XPU conceal option for Python module target

---
 cmake/FlagTreeOptions.cmake | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cmake/FlagTreeOptions.cmake b/cmake/FlagTreeOptions.cmake
index f102e66..9aa9236 100644
--- a/cmake/FlagTreeOptions.cmake
+++ b/cmake/FlagTreeOptions.cmake
@@ -826,7 +826,7 @@ endmacro()
 # linked against TRITON_LIBRARIES: the conceal-IR definition, the GCC 11 static
 # libstdc++ archive, and the repeated public-LLVM archives.
 macro(flagtree_configure_backend_triton_target target)
-  if(FLAGTREE_BACKEND STREQUAL "xpu")
+  if(FLAGTREE_BACKEND STREQUAL "xpu" AND TRITON_XPU_CONCEAL_IR)
     target_compile_definitions(${target} PRIVATE TRITON_CONCEAL_IR=1)
   endif()
   # Link the GCC 11 static libstdc++ archive after all LLVM archives.
